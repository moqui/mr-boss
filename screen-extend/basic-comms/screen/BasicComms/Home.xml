<!-- IronStone's boxes on the BasicComms Home (plans/Comms-Framework.md D-A4): the follow-ups due and the meetings with Join
    before the chat rooms; their lists come from IronStone's get#CommsHome, which its inbox-source provider answers. The mailboxes
    with unread are its home-source box (CommsHomeServices.get#HomeSource), which BasicComms Home shows. Needs reply is the framework's box, which shows IronStone's list (mail and
    internal messages) from the same answer. -->
<screen-extend xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <widgets-extend name="HomeRooms" where="before">
        <container-box><box-header title="Follow-ups due"/><box-toolbar>
            <link url="/qapps/Commons/Tasks" url-type="plain" link-type="anchor" text="Tasks"/>
        </box-toolbar><box-body-nopad>
            <form-list name="FollowUps" list="followUpList" skip-form="true" skip-header="true" paginate="false">
                <field name="title"><default-field><link url="${link}" url-type="plain" text="${title}"/></default-field></field>
                <field name="kindLabel"><default-field><display style="text-caption"/></default-field></field>
                <field name="dueText" align="right"><conditional-field condition="overdue"><label text="${dueText}" style="text-warning text-no-wrap"/></conditional-field>
                    <default-field><label text="${dueText}" style="text-no-wrap"/></default-field></field>
                <columns type="mobile">
                    <column><field-ref name="title"/><field-ref name="kindLabel"/></column>
                    <column><field-ref name="dueText"/></column>
                </columns>
            </form-list>
            <section name="NoFollowUps" condition="!followUpList.length"><widgets>
                <label type="p" text="No calls or emails to follow up this week" style="m-muted q-pa-sm q-mb-none"/>
            </widgets></section>
        </box-body-nopad></container-box>

        <container-box><box-header title="Upcoming meetings"/><box-toolbar>
            <link url="/qapps/Commons/Calendar" url-type="plain" link-type="anchor" text="Calendar"/>
        </box-toolbar><box-body-nopad>
            <form-list name="Meetings" list="meetingList" skip-form="true" skip-header="true" paginate="false">
                <field name="title"><default-field><link url="${link}" url-type="plain" text="${title}"/></default-field></field>
                <field name="whenText"><default-field><display style="${isNow ? 'text-caption text-positive text-weight-medium' : 'text-caption'}"/></default-field></field>
                <field name="join" align="right"><conditional-field condition="joinUrl">
                    <link url="${joinUrl}" url-type="plain" text="Join" icon="sym_o_videocam" link-type="anchor-button" target-window="_blank"/></conditional-field>
                    <default-field><display text=""/></default-field></field>
                <columns type="mobile">
                    <column><field-ref name="title"/><field-ref name="whenText"/></column>
                    <column><field-ref name="join"/></column>
                </columns>
            </form-list>
            <section name="NoMeetings" condition="!meetingList.length"><widgets>
                <label type="p" text="No meetings today or in the next two days" style="m-muted q-pa-sm q-mb-none"/>
            </widgets></section>
        </box-body-nopad></container-box>
    </widgets-extend>
</screen-extend>
