<!-- IronStone's actions on a call in the BasicComms Calls (Sales P5, design-sales §1.4 Comms hooks): Log call on opportunity, Sales'
    LogCall dialog mounted here for a Sales user (BOSS_SAL_LOG_CALL), in the call's call-actions slot (the item: callSessionId). -->
<screen-extend xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <subscreens>
        <subscreens-item name="SalesLogCall" location="component://mr-boss/screen/Sales/Pipeline/LogCall.xml" menu-include="false"/>
    </subscreens>
    <ext-action name="sales.logCall" slot="call-actions" sequence="50" label="Log call on opportunity" icon="sym_o_call_log" screen="SalesLogCall">
        <parameter name="callSessionId"/>
    </ext-action>
</screen-extend>
