<!-- IronStone's mail action in the BasicComms MessageDetail (Customer Service P6, CS-STACK L8; design-customer-service §1 Stack
    contributions): Create a case from a received mail beside Link to a record, for a user with SUPPORT_CASE_EDIT
    (ironstone.customerservice.ChannelServices.create#CaseFromMessage: a case for the customer who sent it, the mail on it,
    timed by its received date), then CaseDetail. The Inbox has no message-actions slot yet (F-P6-2), so this is MessageDetail's;
    mail to a queue's address is the Comms rule's createRequest action (ChannelRouting). -->
<screen-extend xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <transition name="createCase">
        <actions>
            <service-call name="ironstone.customerservice.ChannelServices.create#CaseFromMessage" out-map="caseMade"
                    in-map="{appRoot:'CustomerService', kind:'email', emailMessageId:emailMessageId}"/>
            <set field="caseMadeUrl" from="caseMade?.url"/>
            <message type="success">${caseMade?.message || ''}</message>
        </actions>
        <default-response url="${caseMadeUrl}" url-type="plain"/>
        <error-response url="."/>
    </transition>
    <!-- Maintenance P19 (the user's call of Nov 12): Report a problem prefilled from a received mail (Commons' ReportProblem mounted
        here, for a holder of MAINTENANCE_REQUEST; Mantle reads the mail as the user may and files it on the request) -->
    <subscreens>
        <subscreens-item name="ReportProblem" location="component://mr-boss/screen/Commons/ReportProblem.xml" menu-include="false"/>
    </subscreens>
    <widgets-extend name="LinkRecordDialog" where="after">
        <link url="createCase" text="Create a case" icon="sym_o_support_agent" parameter-map="{emailMessageId:detail.emailMessageId}"
                condition="detail?.kind == 'email' &amp;&amp; detail?.emailMessageId &amp;&amp; ec.user.hasPermission('SUPPORT_CASE_EDIT')"
                confirmation="Make a case of this message for the customer who sent it?"/>
        <dynamic-dialog id="ReportProblemDialog" button-text="Report a problem" transition="ReportProblem" width="640"
                parameter-map="{emailMessageId:detail.emailMessageId}"
                condition="detail?.kind == 'email' &amp;&amp; detail?.emailMessageId &amp;&amp; ec.user.hasPermission('MAINTENANCE_REQUEST')"/>
    </widgets-extend>
</screen-extend>
