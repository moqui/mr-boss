<!-- IronStone's message actions in the BasicComms Chat (plans/archive/Comms-Framework.md §3.3): a task, a request, an event, (Customer
    Service) a case, (People P15) a line of the user's own expense claim (People P16) a job application made from a message, (Maintenance) a problem reported from it, or (Sales P5) a lead, through Chat's createFrom transition and the create-from provider boss.records (Comms.xml), which files the
    message on the new record. -->
<screen-extend xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <!-- Maintenance P19: Commons' Report a problem mounted here, so its action below is a dialog of this screen -->
    <subscreens>
        <subscreens-item name="ReportProblem" location="component://mr-boss/screen/Commons/ReportProblem.xml" menu-include="false"/>
    </subscreens>
    <ext-action name="boss.createTask" slot="chat-message-actions" sequence="10" label="Create a task" icon="sym_o_task_alt" transition="createFrom" hook="create-from">
        <parameter name="chatRoomId"/><parameter name="eventSeq"/><parameter name="kind" value="task"/>
    </ext-action>
    <ext-action name="boss.createRequest" slot="chat-message-actions" sequence="20" label="Create a request" icon="sym_o_support" transition="createFrom" hook="create-from">
        <parameter name="chatRoomId"/><parameter name="eventSeq"/><parameter name="kind" value="request"/>
    </ext-action>
    <ext-action name="boss.createEvent" slot="chat-message-actions" sequence="30" label="Create an event" icon="sym_o_event" transition="createFrom" hook="create-from">
        <parameter name="chatRoomId"/><parameter name="eventSeq"/><parameter name="kind" value="event"/>
    </ext-action>
    <!-- Customer Service P6: a case for the customer who sent the message (ChatServices.create#FromChat's kind case); refused
        for a user without Customer Service and for a sender who is no customer the user serves -->
    <ext-action name="boss.createCase" slot="chat-message-actions" sequence="40" label="Create a case" icon="sym_o_support_agent" transition="createFrom" hook="create-from">
        <parameter name="chatRoomId"/><parameter name="eventSeq"/><parameter name="kind" value="case"/>
    </ext-action>
    <!-- People P15: "Add to my claim", a receipt photo the user sent added to their expense claim as a draft line to review
        (ChatServices.create#FromChat's kind claimLine); refused for another's message and for a user with no employment -->
    <ext-action name="boss.addToClaim" slot="chat-message-actions" sequence="50" label="Add to my claim" icon="sym_o_receipt_long" transition="createFrom" hook="create-from">
        <parameter name="chatRoomId"/><parameter name="eventSeq"/><parameter name="kind" value="claimLine"/>
    </ext-action>
    <!-- People P16: "Create application", the sender's application to the room's opening or the opening whose plus tag the message
        names (ChatServices.create#FromChat's kind application, mantle.humanres.RecruitingServices.create#ApplicationFromChat);
        refused for a user who does not change recruiting and for the user's own message -->
    <ext-action name="boss.createApplication" slot="chat-message-actions" sequence="60" label="Create application" icon="sym_o_person_search" transition="createFrom" hook="create-from">
        <parameter name="chatRoomId"/><parameter name="eventSeq"/><parameter name="kind" value="application"/>
    </ext-action>
    <!-- Maintenance P19 (the user's call of Nov 12): Report a problem prefilled from the message, Commons' ReportProblem mounted here
        so the action is a dialog of the Chat; shown to a user who may report (its BOSS_MNT_REPORT_PROBLEM grant); Mantle reads the
        message under the room check and files it on the request -->
    <ext-action name="maintenance.reportProblem" slot="chat-message-actions" sequence="70" label="Report a problem" icon="sym_o_report_problem" screen="ReportProblem">
        <parameter name="chatRoomId"/><parameter name="eventSeq"/>
    </ext-action>
    <!-- Sales P5 (design-sales §1.4, §3 Leads): "Create lead", the sender's inquiry as a lead of the user's (ChatServices.create#FromChat's
        kind lead, ironstone.sales.ContextServices.create#LeadFromMessage), the message filed on it; refused for a user without Sales -->
    <ext-action name="sales.createLead" slot="chat-message-actions" sequence="80" label="Create lead" icon="sym_o_person_add" transition="createFrom" hook="create-from">
        <parameter name="chatRoomId"/><parameter name="eventSeq"/><parameter name="kind" value="lead"/>
    </ext-action>
</screen-extend>
