<!-- IronStone's message actions in the BasicComms Chat (plans/Comms-Framework.md §3.3): a task, a request or an event made from
    a message, through Chat's createFrom transition and the create-from provider boss.records (Comms.xml), which files the
    message on the new record. -->
<screen-extend xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <ext-action name="boss.createTask" slot="chat-message-actions" sequence="10" label="Create a task" icon="sym_o_task_alt" transition="createFrom" hook="create-from">
        <parameter name="chatRoomId"/><parameter name="eventSeq"/><parameter name="kind" value="task"/>
    </ext-action>
    <ext-action name="boss.createRequest" slot="chat-message-actions" sequence="20" label="Create a request" icon="sym_o_support" transition="createFrom" hook="create-from">
        <parameter name="chatRoomId"/><parameter name="eventSeq"/><parameter name="kind" value="request"/>
    </ext-action>
    <ext-action name="boss.createEvent" slot="chat-message-actions" sequence="30" label="Create an event" icon="sym_o_event" transition="createFrom" hook="create-from">
        <parameter name="chatRoomId"/><parameter name="eventSeq"/><parameter name="kind" value="event"/>
    </ext-action>
</screen-extend>
