<!-- IronStone's cards on the Comms settings index: Calls, and the reading defaults and keys in Commons Preferences. -->
<screen-extend xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <widgets-extend name="SettingsCards" where="append">
        <row-col md="4" sm="6"><container-box><box-header title="Calls"/><box-body>
            <label type="p" text="Camera, microphone and ringtone: coming with calls." style="m-muted"/>
            <link url="../Calls" text="Calls" icon="sym_o_call"/>
        </box-body></container-box></row-col>
        <row-col md="4" sm="6"><container-box><box-header title="Reading and keys"/><box-body>
            <label type="p" text="Where the reading pane goes, marking mail read, undo send, pictures in mail, and the keyboard shortcuts are in Commons Preferences." style="m-muted"/>
            <container style="row q-gutter-sm">
                <render-mode><text type="qvt"><![CDATA[<m-link href="/qapps/Commons/Settings/Preferences"><q-btn dense unelevated no-caps class="m-btn-tonal" icon="sym_o_tune">]]></text><text type="tui" template="false">[]</text></render-mode>
                <label type="span" text="Preferences" style="q-ml-sm"/>
                <render-mode><text type="qvt"><![CDATA[</q-btn></m-link><m-link href="/qapps/Commons/Settings/Notifications"><q-btn dense unelevated no-caps class="m-btn-tonal" icon="sym_o_notifications">]]></text><text type="tui" template="false">[]</text></render-mode>
                <label type="span" text="Notifications" style="q-ml-sm"/>
                <render-mode><text type="qvt"><![CDATA[</q-btn></m-link>]]></text><text type="tui" template="false">[]</text></render-mode>
            </container>
        </box-body></container-box></row-col>
    </widgets-extend>
</screen-extend>
