{
  "id": "insights-suite-orders",
  "type": "panel",
  "title": "Orders by currency",
  "body": {
    "title": "Orders by currency",
    "visualization": "table",
    "queries": [
      {
        "datasetId": "mantle-sales-orders",
        "ignoreVariables": [
          "organizationPartyId"
        ],
        "aggregations": [
          {
            "id": "currency",
            "type": "terms",
            "role": "split-rows",
            "params": {
              "field": "currencyUomId",
              "size": 20
            }
          },
          {
            "id": "orders",
            "type": "cardinality",
            "role": "metric",
            "params": {
              "field": "orderId"
            }
          }
        ],
        "transformations": [
          {
            "type": "organize",
            "hide": [
              "count"
            ]
          }
        ],
        "filters": [
          {
            "query": {
              "field": {
                "name": "orderPurposeEnumId",
                "op": "eq",
                "value": "OrpRecurringTemplate"
              }
            },
            "negated": true,
            "label": "Not a recurring base order"
          }
        ]
      }
    ],
    "description": "Placed sales orders in the range, each currency apart; recurring base orders are left out.",
    "business": {
      "metricId": "Sales.Orders",
      "metricVersion": 1
    }
  }
}
