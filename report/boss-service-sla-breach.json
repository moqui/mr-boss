{
  "id": "boss-service-sla-breach",
  "type": "alert",
  "title": "Service level breaches",
  "body": {
    "description": "Fires when cases breached their service level in the last hour, by queue, among the organizations its owner reads. A template: copy it in Insights › Business alerts, set the threshold and the audience, then activate it.",
    "query": {
      "datasetId": "boss-service-breaches",
      "from": "now-1h",
      "thru": "now",
      "aggregations": [
        {
          "id": "queue",
          "type": "terms",
          "role": "split-rows",
          "params": {
            "field": "requestCategoryId",
            "size": 50
          }
        },
        {
          "id": "cases",
          "type": "cardinality",
          "role": "metric",
          "params": {
            "field": "requestId"
          }
        }
      ],
      "transformations": [
        {
          "type": "organize",
          "hide": [
            "count"
          ]
        }
      ]
    },
    "field": "cases",
    "reduce": "last",
    "condition": {
      "type": "above",
      "threshold": 0
    },
    "intervalSeconds": 300,
    "pendingSeconds": 0,
    "keepFiringSeconds": 0,
    "labels": {
      "team": "customer-service",
      "severity": "warning"
    }
  }
}
