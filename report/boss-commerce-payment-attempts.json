{
  "id": "boss-commerce-payment-attempts",
  "type": "dataset",
  "title": "Store payment attempts",
  "body": {
    "documentType": "BossStorePaymentAttempt",
    "timeField": "createdDate",
    "signal": "business",
    "rowFilterService": "mantle.party.PartyServices.get#OrganizationRowFilter",
    "rowFilterParameters": {
      "organizationField": "organizationPartyId"
    },
    "fieldDefaults": {
      "productStoreId": {
        "lookup": {
          "entityName": "mantle.product.store.ProductStore",
          "keyField": "productStoreId",
          "displayField": "storeName"
        }
      },
      "purposeEnumId": {
        "enumTypeId": "PaymentAttemptPurpose"
      },
      "organizationPartyId": {
        "lookup": {
          "entityName": "mantle.party.Organization",
          "keyField": "partyId",
          "displayField": "organizationName"
        }
      }
    }
  }
}
