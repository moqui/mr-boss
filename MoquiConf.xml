<?xml version="1.0" encoding="UTF-8" ?>
<!-- No copyright or license for configuration file, details here are not considered a creative work. -->
<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd">
    <!-- links to the Comms screens in notifications, mail and push go to BOSS's Comms, which mounts the BasicComms screens -->
    <default-property name="comms_app_root" value="/qapps/Comms"/>
    <!-- the public page of a file or folder shared by link (design-drawers-commons.md §9 PublicShare; impl R16): /s/<token> in
        the public shell, after the token check; screen/PublicShare.xml checks the token again in every call. The unsubscribe
        page of a list email (§16 Unsubscribe): /u/<token>, the List-Unsubscribe URL too: the RFC 8058 one-click POST to it runs
        the screen's oneClick transition (post-transition, after the token check), as a POST to /u/<token>/oneClick does (the
        List-Unsubscribe of the emails sent before); screen/Unsubscribe.xml calls only Mantle's token-checked consent services.
        A published calendar (§7, §8): /cal/<token>, screen/PublishedCalendar.xml, after check#PublishedCalendarToken; the
        page asks for the password when the link has one and then reads get#PublishedCalendar. No CalDAV. -->
    <webapp-list>
        <webapp name="webroot">
            <token-route name="s" screen-location="component://mr-boss/screen/PublicShare.xml"
                    token-service="org.moqui.impl.FileServices.check#PublicShareToken" title="Shared files"/>
            <token-route name="u" screen-location="component://mr-boss/screen/Unsubscribe.xml"
                    token-service="mantle.party.ConsentServices.check#UnsubscribeToken" title="Email preferences" post-transition="oneClick"/>
            <token-route name="cal" screen-location="component://mr-boss/screen/PublishedCalendar.xml"
                    token-service="ironstone.commons.CalendarServices.check#PublishedCalendarToken" title="Calendar"/>
            <!-- a project's public request form (design-projects.md §6 RequestIntake; impl-projects.md P5) -->
            <token-route name="r" screen-location="component://mr-boss/screen/RequestIntake.xml"
                    token-service="mantle.request.RequestServices.check#IntakeToken" title="Send a request"/>
            <!-- the public request form takes a few posts a minute from a client (on when the per-client web protection is) -->
            <web-protection>
                <rate-limit name="request-form" path="/r/*/submit" methods="POST" requests="5" seconds="60" burst="5"/>
            </web-protection>
        </webapp>
    </webapp-list>
    <screen-facade>
        <!-- the IronStone apps, each a root under the apps screen mounted by its own name, so a design path such as
            Commons/Tasks is the URL /qapps/Commons/Tasks -->
        <screen location="component://webroot/screen/webroot/apps.xml">
            <subscreens-item name="Commons" menu-title="Commons" menu-index="20" location="component://mr-boss/screen/Commons.xml"/>
            <subscreens-item name="Comms" menu-title="Comms" menu-index="21" location="component://mr-boss/screen/Comms.xml"/>
            <subscreens-item name="Sales" menu-title="Sales" menu-index="30" location="component://mr-boss/screen/Sales.xml"/>
            <subscreens-item name="Marketing" menu-title="Marketing" menu-index="31" location="component://mr-boss/screen/Marketing.xml"/>
            <subscreens-item name="CustomerService" menu-title="Customer Service" menu-index="32" location="component://mr-boss/screen/CustomerService.xml"/>
            <subscreens-item name="Commerce" menu-title="Commerce" menu-index="33" location="component://mr-boss/screen/Commerce.xml"/>
            <subscreens-item name="Products" menu-title="Products" menu-index="40" location="component://mr-boss/screen/Products.xml"/>
            <subscreens-item name="Purchasing" menu-title="Purchasing" menu-index="41" location="component://mr-boss/screen/Purchasing.xml"/>
            <subscreens-item name="Warehouse" menu-title="Warehouse" menu-index="42" location="component://mr-boss/screen/Warehouse.xml"/>
            <subscreens-item name="Manufacturing" menu-title="Manufacturing" menu-index="43" location="component://mr-boss/screen/Manufacturing.xml"/>
            <subscreens-item name="Maintenance" menu-title="Maintenance" menu-index="44" location="component://mr-boss/screen/Maintenance.xml"/>
            <subscreens-item name="Accounting" menu-title="Accounting" menu-index="50" location="component://mr-boss/screen/Accounting.xml"/>
            <subscreens-item name="People" menu-title="People" menu-index="51" location="component://mr-boss/screen/People.xml"/>
            <subscreens-item name="Projects" menu-title="Projects" menu-index="52" location="component://mr-boss/screen/Projects.xml"/>
            <subscreens-item name="Insights" menu-title="Insights" menu-index="60" location="component://mr-boss/screen/Insights.xml"/>
            <subscreens-item name="Admin" menu-title="Admin" menu-index="61" location="component://mr-boss/screen/Admin.xml"/>
            <!-- one Comms in the launcher: BOSS's, which mounts and extends the BasicComms screens; /qapps/BasicComms still
                works (plans/Comms-Framework.md §3.4) -->
            <subscreens-item name="BasicComms" menu-include="false"/>
        </screen>
    </screen-facade>
</moqui-conf>
