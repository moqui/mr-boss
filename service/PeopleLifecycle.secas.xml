<!-- People's access requests reach Admin after People's change commits (design-admin §4.1 Provisioning from People, design-people
    §4; impl-people P7, owner contract, F15): a hire HR asked an account for requests its provisioning, and a separation, once
    applied (at once, or by the last approval: apply#, decide# and approve#EmploymentChange), its access end, each through
    ironstone.admin.LifecycleServices (Provisioning.js), keyed by the change so a retry answers the first operation. The rules
    live here so Mantle does not depend on BOSS; they run as the caller, on a service worker, once the transaction commits, and a
    failure is noted on the change, never undoing it. -->
<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <seca id="PeopleHireProvisioning" service="mantle.humanres.PeopleServices.hire#Employee" when="tx-commit">
        <condition><expression>employmentChangeId &amp;&amp; accessRequested &amp;&amp; !repeated</expression></condition>
        <actions><service-call name="ironstone.admin.LifecycleServices.request#Provisioning" in-map="{employmentChangeId:employmentChangeId}"/></actions>
    </seca>
    <seca id="PeopleChangeAccessEnd" service="mantle.humanres.PeopleServices.apply#EmploymentChange" when="tx-commit">
        <condition><expression>employmentChangeId &amp;&amp; applied &amp;&amp; !repeated</expression></condition>
        <actions><service-call name="ironstone.admin.LifecycleServices.request#AccessEnd" in-map="{employmentChangeId:employmentChangeId}"/></actions>
    </seca>
    <seca id="PeopleDecisionAccessEnd" service="mantle.humanres.PeopleServices.decide#EmploymentChange" when="tx-commit">
        <condition><expression>employmentChangeId &amp;&amp; applied &amp;&amp; !repeated</expression></condition>
        <actions><service-call name="ironstone.admin.LifecycleServices.request#AccessEnd" in-map="{employmentChangeId:employmentChangeId}"/></actions>
    </seca>
    <seca id="PeopleNoticeAccessEnd" service="mantle.humanres.PeopleServices.approve#EmploymentChange" when="tx-commit">
        <condition><expression>employmentChangeId &amp;&amp; applied &amp;&amp; !repeated</expression></condition>
        <actions><service-call name="ironstone.admin.LifecycleServices.request#AccessEnd" in-map="{employmentChangeId:employmentChangeId}"/></actions>
    </seca>
</secas>
