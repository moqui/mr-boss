<!-- Purchasing Home (design-purchasing §3 Home): the buyer's counters and work. Each count comes from the phase that builds
    its records (P3 drafts and approved orders not sent, P9 unacknowledged, P4 approvals, P5 late receipts, P6 held bills,
    P10 unsourced requests, P11 RFQs
    due and quotes expiring, P14 shortfall suggestions with the plan's freshness); until then it is null, which Home shows as
    unavailable, never as zero. BuyerWork's sources come the same way. Each phase appends its block. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="get" noun="Home" allow-remote="false">
        <description>The buyer's counters, each null where it is not counted yet: unsourced requests, RFQs due, quotes to
            compare, quotes expiring, shortfall suggestions (with the plan's run date), approvals waiting, unacknowledged
            orders, late receipts and held bills. Refuses a user without Purchasing.</description>
        <implements service="ironstone.purchasing.AccessServices.define#Parameters"/>
        <out-parameters>
            <parameter name="counters" type="Map"><description>unsourcedCount, quoteDueCount, quoteCompareCount,
                quoteExpiringCount, shortfallCount, approvalCount, unacknowledgedCount, lateCount, heldCount, draftCount and
                unsentCount, each null where not counted.</description></parameter>
            <parameter name="planRunText"><description>The run date of the supply plan the shortfall counts, when there is
                one.</description></parameter>
        </out-parameters>
        <actions>
            <service-call name="ironstone.purchasing.AccessServices.get#SharedContext" in-map="{appRoot:appRoot}"
                    out-map="shared"/>
            <set field="can" from="shared.capabilities"/>
            <set field="counters" from="{unsourcedCount: null, quoteDueCount: null, quoteCompareCount: null,
                    quoteExpiringCount: null, shortfallCount: null, approvalCount: null, unacknowledgedCount: null,
                    lateCount: null, heldCount: null}"/>
            <set field="planRunText" from="null"/>
            <!-- later phases: each counts its records here, by the capability that reads them -->
            <!-- P14a: the open buy suggestions of the current plans, with the latest plan's date, for Replenishment's groups -->
            <set field="shortfall" from="ec.resource.script('component://mr-boss/service/ironstone/purchasing/Replenishment.js')
                    .shortfalls(ec.resource.script('component://mr-boss/service/ironstone/purchasing/Purchasing.js').scope())"/>
            <set field="counters" from="Object.assign({}, counters, {shortfallCount: shortfall.shortfallCount})"/>
            <set field="planRunText" from="shortfall.planRunText"/>
            <!-- P3: the draft purchase orders and the approved ones not sent, for the buying lists' groups -->
            <set field="orderCounts" from="ec.resource.script('component://mr-boss/service/ironstone/purchasing/Orders.js')
                    .homeCounts(ec.resource.script('component://mr-boss/service/ironstone/purchasing/Purchasing.js').scope())"/>
            <set field="counters" from="Object.assign({}, counters, orderCounts)"/>
            <!-- P6: the supplier bills with an open hold, for the buying lists' groups -->
            <set field="billCounts" from="ec.resource.script('component://mr-boss/service/ironstone/purchasing/Bills.js')
                    .homeCounts(ec.resource.script('component://mr-boss/service/ironstone/purchasing/Purchasing.js').scope())"/>
            <set field="counters" from="Object.assign({}, counters, billCounts)"/>
        </actions>
    </service>
    <service verb="find" noun="BuyerWork" allow-remote="false">
        <description>The buyer's assigned demand and follow-ups, by due date: each row's document, supplier, owner, due
            date, amount and next action, from the sources the phases add (none yet). Refuses a user without
            Purchasing.</description>
        <implements service="ironstone.purchasing.AccessServices.define#Parameters"/>
        <in-parameters>
            <parameter name="limit" type="Integer" default="20"/>
        </in-parameters>
        <out-parameters>
            <parameter name="workRows" type="List"><description>Each row's documentText, url, supplierName, ownerName,
                dueText, amountText and nextAction.</description></parameter>
        </out-parameters>
        <actions>
            <service-call name="ironstone.purchasing.AccessServices.get#SharedContext" in-map="{appRoot:appRoot}"
                    out-map="shared"/>
            <set field="workRows" from="[]"/>
            <!-- P3: the approved purchase orders to send, for a buyer; later phases: P10 requests to source, P11 quotes due -->
            <set field="workRows" from="ec.resource.script('component://mr-boss/service/ironstone/purchasing/Orders.js')
                    .workRows(ec.resource.script('component://mr-boss/service/ironstone/purchasing/Purchasing.js').scope(), limit)"/>
        </actions>
    </service>
</services>
