<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="load" noun="SupplierPortalDemo" authenticate="anonymous-all" allow-remote="false">
        <description>Idempotent Supplier app demo for ORG_ZIZI_RETAIL (impl-purchasing P16): an RFQ quote of ZiddlemanInc
            with its QuoteResponse link, and the portal demo order's OrderAcknowledgement link, with fixed tokens, on
            Accounting's ZIZI_PORTAL site. Only data loading or a system administrator may run it.</description>
        <out-parameters><parameter name="complete" type="Boolean"/></out-parameters>
        <actions>
            <set field="complete" from="ec.resource.script('component://mr-boss/service/ironstone/purchasing/SupplierPortalDemo.js')
                .execute('load').complete"/>
        </actions>
    </service>
</services>
