<!-- The Manufacturing app's access (impl-manufacturing §2, §4, P1; Manufacturing.js): the user's organizations, plants and
    capabilities, and the record check every Manufacturing screen, mount and shared mount calls before the Mantle
    production, method or quality verb. A user may open Manufacturing through an authorization of their groups on its root
    (BOSS_MANUFACTURING, the root user group, or BOSS_MANUFACTURING_ADMIN); the Facility filter of that authorization's
    filter sets (MANTLE_USER_ORG's ownerPartyId in filterOrgIds) limits their plants and records, and an authorization with
    none (MANTLE_ACTIVE_ORG) leaves every plant of every organization. Capabilities are the Mantle permissions the
    services check. Disabled artifact authorization widens nothing here. No entity filter covers WorkEffort (F3), so a
    run, operation or routing is checked by its owner and facility here, and by the Mantle verb again. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="define" noun="Parameters" type="interface">
        <description>The in-parameters the Manufacturing app services share; each service declares what it returns.</description>
        <in-parameters>
            <parameter name="appRoot" type="String"/>
            <parameter name="plantId" type="String"/>
        </in-parameters>
    </service>
    <service verb="get" noun="SharedContext" allow-remote="false">
        <description>Check that the user may open Manufacturing and resolve their scope and the app's routes: capabilities,
            the organizations, whether they work in every plant, how many plants they have, and the selected plant (the
            given one, else the user's preference when it is in scope, else their only plant). Refuses a user without
            Manufacturing (MANUFACTURING_UNAVAILABLE), another app root (MANUFACTURING_CONTEXT), and a plant outside the
            scope (PLANT_UNAVAILABLE).</description>
        <implements service="ironstone.manufacturing.AccessServices.define#Parameters"/>
        <out-parameters>
            <parameter name="capabilities" type="Map"/>
            <parameter name="organizationPartyIds" type="List"/>
            <parameter name="activeOrganizationPartyId" type="String"/>
            <parameter name="defaultOrganizationPartyId" type="String"><description>A new record's organization when none is
                chosen: the active one, the only one, or the user's own (FacilityScope.js defaultOrganization)</description></parameter>
            <parameter name="allPlants" type="Boolean"/>
            <parameter name="plantCount" type="Long"/>
            <parameter name="plantId" type="String"/>
            <parameter name="plantName" type="String"/>
            <parameter name="appRoot" type="String"/>
            <parameter name="sharedLinks" type="Map"/>
            <parameter name="linkBase" type="String"/>
            <parameter name="webBase" type="String"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/manufacturing/Manufacturing.js"/>
            <set field="shared" from="ec.resource.script(module).execute('sharedContext', context)"/>
            <set field="capabilities" from="shared.capabilities"/>
            <set field="organizationPartyIds" from="shared.organizationPartyIds"/>
            <set field="activeOrganizationPartyId" from="shared.activeOrganizationPartyId"/>
            <set field="defaultOrganizationPartyId" from="shared.defaultOrganizationPartyId"/>
            <set field="allPlants" from="shared.allPlants"/>
            <set field="plantCount" from="shared.plantCount"/>
            <set field="plantId" from="shared.plantId"/>
            <set field="plantName" from="shared.plantName"/>
            <set field="appRoot" from="shared.appRoot"/>
            <set field="sharedLinks" from="shared.sharedLinks"/>
            <set field="linkBase" from="shared.linkBase"/>
            <set field="webBase" from="shared.webBase"/>
        </actions>
    </service>
    <service verb="check" noun="Record" allow-remote="false" read-only="true">
        <description>A record a Manufacturing screen or mount was given: a run, an operation, a method (BOM), a routing, a
            work center, an asset or a facility. Answers its kind's name, its facility in the user's scope, a label and a
            short detail. Refuses a record that does not exist and one outside the scope alike (RECORD_UNAVAILABLE): a run
            whose owner or facility is not the user's organizations', an operation of such a run, a method or routing of
            another organization, a work center, asset or facility of another organization's. With a capability named
            (plan, operate, supervise, ...), refuses a user without its permission (PERMISSION_DENIED).</description>
        <implements service="ironstone.manufacturing.AccessServices.define#Parameters"/>
        <in-parameters>
            <parameter name="recordType" required="true"><description>run, operation, method, routing, workCenter, asset or
                facility; later phases add theirs (Manufacturing.js recordKinds)</description></parameter>
            <parameter name="recordId" required="true"/>
            <parameter name="capability"/>
        </in-parameters>
        <out-parameters>
            <parameter name="recordType"/>
            <parameter name="recordId"/>
            <parameter name="kindName"/>
            <parameter name="facilityId"/>
            <parameter name="facilityName"/>
            <parameter name="label"/>
            <parameter name="detail"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/manufacturing/Manufacturing.js"/>
            <set field="record" from="ec.resource.script(module).execute('checkRecord', context)"/>
            <set field="recordType" from="record.recordType"/>
            <set field="recordId" from="record.recordId"/>
            <set field="kindName" from="record.kindName"/>
            <set field="facilityId" from="record.facilityId"/>
            <set field="facilityName" from="record.facilityName"/>
            <set field="label" from="record.label"/>
            <set field="detail" from="record.detail"/>
        </actions>
    </service>
    <service verb="select" noun="Plant" allow-remote="false">
        <description>Keep a plant of the user's as their selected one (the ManufacturingPlantActive preference), or clear it
            with none. The preference never widens the scope: a plant outside it is refused (PLANT_UNAVAILABLE), and one
            that leaves the scope later is ignored where it is read.</description>
        <implements service="ironstone.manufacturing.AccessServices.define#Parameters"/>
        <out-parameters>
            <parameter name="plantId"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/manufacturing/Manufacturing.js"/>
            <set field="selected" from="ec.resource.script(module).execute('selectPlant', context)"/>
            <set field="plantId" from="selected.plantId"/>
        </actions>
    </service>
    <service verb="get" noun="Choices" allow-remote="false">
        <description>The options of a Manufacturing drop-down the user may choose, searched by term in the query, with the
            selected value's label: plants (the user's) and workCenters (the user's, under plantId when given); P2's products (not
            pick kits), operationSources (templates and other routings' operations, not archived) and inspectionTemplates
            (production). Refuses an unknown choice.</description>
        <implements service="ironstone.manufacturing.AccessServices.define#Parameters"/>
        <in-parameters>
            <parameter name="choice" required="true"/>
            <parameter name="term"/>
            <parameter name="selected"/>
            <parameter name="workEffortId"><description>operationSources: the routing whose own operations are left out</description></parameter>
            <parameter name="productId"><description>releasedBoms: the product whose released BOMs are offered</description></parameter>
            <parameter name="facilityId"><description>downtimeReasons and equipment (P11): the work center whose organization's
                reasons and whose equipment are offered</description></parameter>
            <parameter name="supplierPartyId"><description>vendorFacilities (P14): the supplier whose custody facilities are
                offered</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="options" type="List"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/manufacturing/Manufacturing.js"/>
            <set field="found" from="ec.resource.script(module).execute('choices', context)"/>
            <set field="options" from="found.options"/>
        </actions>
    </service>
    <service verb="search" noun="Records" allow-remote="false">
        <description>The palette's Manufacturing records: the user's runs, methods (by their id, name, code or product),
            routings, work centers and equipment whose id or name has the text, ignoring case, each limited to their
            organizations in the query and checked again, with its Manufacturing link. No rows for a user without
            Manufacturing.</description>
        <in-parameters>
            <parameter name="text"/>
            <parameter name="limit" type="Integer"/>
            <parameter name="docTypes" type="List"/>
            <parameter name="idMatch" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="rows" type="List"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/manufacturing/Manufacturing.js"/>
            <set field="found" from="ec.resource.script(module).execute('search', context)"/>
            <set field="rows" from="found.rows"/>
        </actions>
    </service>
</services>
