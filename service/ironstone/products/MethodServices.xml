    <!-- Manufacturing P2: copy operations into the routing, and the engineer's release requests (Mantle checks METHOD_EDIT and
        sends the approvers' BomRelease and RoutingRelease notices) -->
    <service verb="copy" noun="RoutingOperations" allow-remote="false">
        <implements service="ironstone.products.MethodServices.define#MethodParameters"/>
        <actions>
            <set field="result" from="ec.resource.script('component://mr-boss/service/ironstone/products/Methods.js').execute('copyOperations', context)"/>
            <set field="copiedOperationIds" from="result.copiedOperationIds"/>
            <set field="operationRows" from="result.operationRows"/>
            <set field="expectedRevision" from="result.expectedRevision"/>
            <set field="workEffortId" from="result.workEffortId"/>
        </actions>
    </service>
    <service verb="request" noun="BomRelease" allow-remote="false">
        <implements service="ironstone.products.MethodServices.define#MethodParameters"/>
        <actions>
            <set field="result" from="ec.resource.script('component://mr-boss/service/ironstone/products/Methods.js').execute('requestRelease', context)"/>
            <set field="valid" from="result.valid"/>
            <set field="findings" from="result.findings"/>
            <set field="notified" from="result.notified"/>
            <set field="message" from="result.message"/>
            <set field="productBomId" from="result.productBomId"/>
        </actions>
    </service>
    <service verb="request" noun="RoutingRelease" allow-remote="false">
        <implements service="ironstone.products.MethodServices.define#MethodParameters"/>
        <actions>
            <set field="result" from="ec.resource.script('component://mr-boss/service/ironstone/products/Methods.js').execute('requestRoutingRelease', context)"/>
            <set field="valid" from="result.valid"/>
            <set field="findings" from="result.findings"/>
            <set field="notified" from="result.notified"/>
            <set field="message" from="result.message"/>
            <set field="workEffortId" from="result.workEffortId"/>
        </actions>
