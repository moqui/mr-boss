<!-- Products owner/capability boundary. Check the real user's groups and organizations even when a caller has disabled
     artifact authorization. Never trust a capability or organization list supplied by a screen, import or client. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="get" noun="SharedContext" allow-remote="false">
        <description>Trusted app routing, tabs and launcher capabilities for shared catalog mounts. New apps extend the policy in SharedContext.js.</description>
        <in-parameters>
            <parameter name="appRoot"/>
            <parameter name="includeConnections" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="appRoot"/>
            <parameter name="linkBase"/>
            <parameter name="webBase"/>
            <parameter name="printBase"/>
            <parameter name="sharedLinks" type="Map"/>
            <parameter name="productTabs" type="List"/>
            <parameter name="connectionTypes" type="List"/>
            <parameter name="capabilities" type="Map"/>
            <parameter name="ownerPartyIds" type="List"/>
            <parameter name="organizationPartyIds" type="List"/>
            <parameter name="activeOrganizationPartyId"/>
            <parameter name="facilityIds" type="List"><description>Warehouse's mounts: the facilities whose stock the user
                reads (null for every facility); not set for Products</description></parameter>
            <parameter name="storeIds" type="List"><description>Commerce's mounts: the stores the user works, which the store
                choices of prices and categories are narrowed to (impl-commerce F47); not set elsewhere</description></parameter>
        </out-parameters>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-boss/service/ironstone/products/SharedContext.js').execute('context',context))</script>
        </actions>
    </service>
    <service verb="get" noun="CatalogAccess" allow-remote="false">
        <out-parameters>
            <parameter name="capabilities" type="Map"/>
            <parameter name="ownerPartyIds" type="List"/>
            <parameter name="organizationPartyIds" type="List"/>
            <parameter name="activeOrganizationPartyId"/>
        </out-parameters>
        <actions>
            <script><![CDATA[
            // Every capability comes from the Moqui permissions Mantle checks (granted to the BOSS groups in BossSetupData),
            // so a screen offers exactly what the Mantle services will allow.
            const domain = ec.resource.script('component://mr-mantle/service/mantle/product/ProductAccess.js')
            const cost = ec.resource.script('component://mr-mantle/service/mantle/product/CostPolicy.js').capabilities()
            const methods = ec.resource.script('component://mr-mantle/service/mantle/product/MethodPolicy.js').capabilities()
            const catalogAdmin = domain.has('PRODUCT_CATALOG_ADMIN')
            const catalogEdit = catalogAdmin || domain.has('PRODUCT_CATALOG_EDIT')
            capabilities = {
                systemAdmin: domain.systemAdmin(),
                read: catalogEdit || domain.has('PRODUCT_CATALOG_VIEW'),
                catalogEdit, catalogAdmin,
                priceRead: domain.has('PRICE_VIEW') || domain.has('PRICE_EDIT'), priceEdit: domain.has('PRICE_EDIT'),
                supplierPriceRead: cost.supplierRead, supplierPriceEdit: domain.has('SUPPLIER_PRICE_EDIT'),
                costRead: cost.read, costEstimate: cost.edit, costApprove: cost.approve,
                stockPlan: domain.has('STOCK_POLICY_PLAN') || domain.has('STOCK_POLICY_MANAGE'), stockManage: domain.has('STOCK_POLICY_MANAGE'),
                methodRead: methods.read, methodEdit: methods.edit, methodApprove: methods.approve, methodAdmin: methods.resources,
                glPost: cost.glPost
            }
            capabilities.marginRead = capabilities.priceRead && capabilities.costRead
            const scope = ec.service.sync().name('mantle.product.ProductServices.get#CatalogOwnerScope').disableAuthz().call() || {}
            organizationPartyIds = scope.organizationPartyIds || []
            activeOrganizationPartyId = scope.activeOrganizationPartyId || null
            ownerPartyIds = scope.ownerPartyIds || ['_NA_']
        ]]></script>
        </actions>
    </service>
    <service verb="get" noun="CatalogRecord" allow-remote="false">
        <in-parameters>
            <parameter name="appRoot"/>
            <parameter name="recordEntityName" default-value="mantle.product.Product"/>
            <parameter name="recordId" required="true"/>
            <parameter name="need" default-value="read"/>
            <parameter name="checkOnly" type="Boolean" default="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="record" type="Map"/>
            <parameter name="canRead" type="Boolean"/>
            <parameter name="canWrite" type="Boolean"/>
            <parameter name="capabilities" type="Map"/>
        </out-parameters>
        <actions>
            <script><![CDATA[
            record = null; canRead = false; canWrite = false
            const access = ec.service.sync().name('ironstone.products.CatalogServices.get#SharedContext').parameters({appRoot:appRoot}).call() || {}
            capabilities = access.capabilities || {}
            const keys = {'mantle.product.Product': 'productId', 'mantle.product.category.ProductCategory': 'productCategoryId',
                'mantle.product.feature.ProductFeature': 'productFeatureId', 'mantle.product.feature.ProductFeatureGroup': 'productFeatureGroupId'}
            const key = Object.prototype.hasOwnProperty.call(keys,recordEntityName) ? keys[recordEntityName] : null
            // The entity allowlist is security-critical: this is never a general-purpose entity reader.
            const validNeed = ['read', 'catalogEdit', 'catalogAdmin', 'priceRead', 'priceEdit', 'supplierPriceRead',
                'supplierPriceEdit', 'costRead', 'costEstimate', 'costApprove', 'stockPlan', 'stockManage',
                'methodRead', 'methodEdit', 'methodApprove', 'methodAdmin', 'glPost'].includes(need)
            if (key && validNeed && capabilities.read) {
                const row = ec.entity.find(recordEntityName).condition(key, recordId).disableAuthz().one()
                const rowOwner = row?.ownerPartyId || (recordEntityName === 'mantle.product.feature.ProductFeatureGroup' ? '_NA_' : null)
                if (row && (capabilities.systemAdmin || Array.from(access.ownerPartyIds || []).includes(rowOwner))) {
                    canRead = true
                    canWrite = !!capabilities[need === 'read' ? 'catalogEdit' : need] && !String(need).endsWith('Read')
                        && (rowOwner !== '_NA_' || capabilities.systemAdmin)
                    const allowed = need === 'read' || String(need).endsWith('Read') ? !!capabilities[need] : canWrite
                    if (allowed) record = Object.assign({},row.getMap(),{ownerPartyId:rowOwner})
                }
            }
            if (!checkOnly && !record) ec.message.addError('Catalog record is not available for this action')
        ]]></script>
        </actions>
    </service>
