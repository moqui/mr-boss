<!-- The People app's context (impl-people §2, P1; design-people §1.1, §1.2; People.js): who may open People, their capabilities
    and scope, and the record check every People screen, mount and shared mount calls before the Mantle service. A user may open
    People through an authorization of their groups on its root (BOSS_PEOPLE, the root user group, or BOSS_PEOPLE_ADMIN); the
    capabilities and the employers, units, own employments and live reports are Mantle's (mantle.humanres.PeopleServices
    .get#Scope, from the People permissions), and the menu areas' authorizations add theirs. Disabled artifact authorization
    widens nothing here; each Mantle service checks again. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="define" noun="Parameters" type="interface">
        <description>The in-parameters the People app services share; each service declares what it returns.</description>
        <in-parameters>
            <parameter name="appRoot" type="String"/>
        </in-parameters>
    </service>
    <service verb="get" noun="SharedContext" allow-remote="false">
        <description>Check that the user may open People and resolve their scope and the app's routes: capabilities (the People
            and payroll permissions, and the areas), the employers a staff reader sees as options and whether they are every
            one, the units under them, the user's own party and current employments, and the links. Refuses a user without
            People (PEOPLE_UNAVAILABLE), a Projects client contact, a PASS public account and a self-service employee among
            them, and another app root (PEOPLE_CONTEXT). Pay values are never part of it.</description>
        <implements service="ironstone.people.ContextServices.define#Parameters"/>
        <out-parameters>
            <parameter name="capabilities" type="Map"/>
            <parameter name="organizationPartyIds" type="List"/>
            <parameter name="activeOrganizationPartyId" type="String"/>
            <parameter name="allOrganizations" type="Boolean"/>
            <parameter name="organizationOptions" type="List"><description>The employers as {value, label}, by name, at most
                100</description></parameter>
            <parameter name="unitPartyIds" type="List"/>
            <parameter name="partyId" type="String"/>
            <parameter name="employments" type="List"/>
            <parameter name="appRoot" type="String"/>
            <parameter name="sharedLinks" type="Map"/>
            <parameter name="linkBase" type="String"/>
            <parameter name="webBase" type="String"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/people/People.js"/>
            <set field="shared" from="ec.resource.script(module).execute('sharedContext', context)"/>
            <set field="capabilities" from="shared.capabilities"/>
            <set field="organizationPartyIds" from="shared.organizationPartyIds"/>
            <set field="activeOrganizationPartyId" from="shared.activeOrganizationPartyId"/>
            <set field="allOrganizations" from="shared.allOrganizations"/>
            <set field="organizationOptions" from="shared.organizationOptions"/>
            <set field="unitPartyIds" from="shared.unitPartyIds"/>
            <set field="partyId" from="shared.partyId"/>
            <set field="employments" from="shared.employments"/>
            <set field="appRoot" from="shared.appRoot"/>
            <set field="sharedLinks" from="shared.sharedLinks"/>
            <set field="linkBase" from="shared.linkBase"/>
            <set field="webBase" from="shared.webBase"/>
        </actions>
    </service>
    <service verb="check" noun="Record" allow-remote="false">
        <description>A record a People screen or mount was given: an employer or a person (People.js recordKinds; later phases
            add theirs). Answers its kind's name, a label and a short detail (a person's employers in the user's scope). Refuses
            a record that does not exist and one outside the scope alike (RECORD_UNAVAILABLE): an organization that is not an
            employer the user sees, a person neither self, a live report nor employed by such an employer. With a capability
            named (hrView, configure, ...), refuses a user without it (PERMISSION_DENIED).</description>
        <implements service="ironstone.people.ContextServices.define#Parameters"/>
        <in-parameters>
            <parameter name="recordType" required="true"><description>organization or person</description></parameter>
            <parameter name="recordId" required="true"/>
            <parameter name="capability"/>
        </in-parameters>
        <out-parameters>
            <parameter name="recordType"/>
            <parameter name="recordId"/>
            <parameter name="kindName"/>
            <parameter name="label"/>
            <parameter name="detail"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/people/People.js"/>
            <set field="record" from="ec.resource.script(module).execute('checkRecord', context)"/>
            <set field="recordType" from="record.recordType"/>
            <set field="recordId" from="record.recordId"/>
            <set field="kindName" from="record.kindName"/>
            <set field="label" from="record.label"/>
            <set field="detail" from="record.detail"/>
        </actions>
    </service>
    <service verb="get" noun="Choices" allow-remote="false">
        <description>The options of a People drop-down the user may choose, searched by term in the query ignoring case, with
            the selected value's label: employers (those a staff reader sees), units (the employers and the departments and
            teams under them) and people (the current employees of those employers, the user's live reports and the user with
            self-service). Refuses a user without People and an unknown choice.</description>
        <implements service="ironstone.people.ContextServices.define#Parameters"/>
        <in-parameters>
            <parameter name="choice" required="true"/>
            <parameter name="term"/>
            <parameter name="selected"/>
        </in-parameters>
        <out-parameters>
            <parameter name="options" type="List"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/people/People.js"/>
            <set field="found" from="ec.resource.script(module).execute('choices', context)"/>
            <set field="options" from="found.options"/>
        </actions>
    </service>
    <service verb="search" noun="Records" allow-remote="false">
        <description>The palette's People records, each opening its People screen, checked again row by row: none yet (P2 adds
            the directory's work identity, with recordEntity and recordId). No rows for a user without People.</description>
        <in-parameters>
            <parameter name="text"/>
            <parameter name="limit" type="Integer"/>
            <parameter name="docTypes" type="List"/>
            <parameter name="idMatch" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="rows" type="List"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/people/People.js"/>
            <set field="found" from="ec.resource.script(module).execute('search', context)"/>
            <set field="rows" from="found.rows"/>
        </actions>
    </service>
</services>
