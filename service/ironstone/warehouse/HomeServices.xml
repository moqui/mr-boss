<!-- Warehouse Home (design-warehouse §3). Each operation queue is counted by the phase that builds its task list; until
    then its counts are null, which Home shows as unavailable, never as zero. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="get" noun="Home" allow-remote="false">
        <description>The operation queues of the user's selected facility that their capabilities reach, each with its
            ready, waiting, late and backorder counts (null where the queue is not counted), the work assigned to them (the
            Today source's items, Today.js: their open counts and inspections and their loads open from an earlier day), and
            the quantity indicators of the facility (products in stock, stock lines on hold and quarantined; never a sum of
            quantities across units). Refuses a user without Warehouse and a facility outside the scope.</description>
        <implements service="ironstone.warehouse.AccessServices.define#Parameters"/>
        <out-parameters>
            <parameter name="facilityId"/>
            <parameter name="facilityName"/>
            <parameter name="queueRows" type="List"><description>Each queue's operation, title, readyCount, waitingCount,
                lateCount and backorderCount.</description></parameter>
            <parameter name="workRows" type="List"><description>Each row's title, url, step, dueText and
                exceptionText.</description></parameter>
            <parameter name="indicators" type="Map"><description>productCount, onHoldCount and quarantineCount of the
                selected facility; empty with no facility.</description></parameter>
        </out-parameters>
        <actions>
            <service-call name="ironstone.warehouse.AccessServices.get#SharedContext"
                    in-map="{appRoot:appRoot, facilityId:facilityId}"
                    out-map="shared"/>
            <set field="facilityId" from="shared.facilityId"/>
            <set field="facilityName" from="shared.facilityName"/>
            <set field="can" from="shared.capabilities"/>
            <!-- operation, title and who sees it (design §3 OperationQueues, design §1's capabilities) -->
            <set field="queues"
                    from="[['receiving', 'Receiving', true], ['putaway', 'Putaway', can.move],
                        ['inspection', 'Inspection', can.inspect || can.qualityVerify || can.qualityDispose],
                        ['picking', 'Picking', can.pick || can.loadEdit], ['packing', 'Packing', can.pack],
                        ['shipping', 'Shipping', true], ['returns', 'Returns', true], ['transfers', 'Transfers', true],
                        ['counts', 'Counts', can.count || can.countReview || can.adjust]]"/>
            <set field="queueRows"
                    from="queues.filter(queue =&gt; queue[2]).map(queue =&gt; ({operation: queue[0], title: queue[1],
                        readyCount: null, waitingCount: null, lateCount: null, backorderCount: null}))"/>
            <!-- P7: the receiving queue, the facility's open purchase receipts: waiting (expected) and late (overdue) -->
            <if condition="facilityId">
                <service-call name="ironstone.warehouse.ReceiptServices.get#Receipts" out-map="openReceipts"
                        in-map="{facilityId:facilityId, sourceType:'purchase', pageSize:1}" transaction="force-new"
                        ignore-error="true"/>
                <service-call name="ironstone.warehouse.ReceiptServices.get#Receipts" out-map="lateReceipts"
                        in-map="{facilityId:facilityId, sourceType:'purchase', overdue:'Y', pageSize:1}"
                        transaction="force-new" ignore-error="true"/>
                <if condition="openReceipts?.receiptRowsCount != null &amp;&amp; lateReceipts?.receiptRowsCount != null">
                    <set field="queueRows" from="queueRows.map(row =&gt; row.operation === 'receiving'
                            ? Object.assign({}, row, {lateCount: lateReceipts.receiptRowsCount,
                                waitingCount: openReceipts.receiptRowsCount - lateReceipts.receiptRowsCount}) : row)"/>
                </if>
            </if>
            <!-- P9: the putaway queue, the facility's stock waiting in receiving and staging: ready, and late (received
                before today) -->
            <if condition="facilityId &amp;&amp; can.move">
                <service-call name="ironstone.warehouse.PutawayServices.get#PutawayQueueCounts" out-map="putawayCounts"
                        in-map="{facilityId:facilityId}" transaction="force-new" ignore-error="true"/>
                <if condition="putawayCounts?.readyCount != null">
                    <set field="queueRows" from="queueRows.map(row =&gt; row.operation === 'putaway'
                            ? Object.assign({}, row, {readyCount: putawayCounts.readyCount,
                                lateCount: putawayCounts.lateCount}) : row)"/>
                </if>
            </if>
            <!-- the returns queue (P14): approved returns to receive or send (ready), created or requested ones (waiting) -->
            <if condition="facilityId">
                <service-call name="ironstone.warehouse.ReturnServices.get#ReturnQueue" out-map="returnQueue"
                        in-map="{facilityId:facilityId}" transaction="force-new" ignore-error="true"/>
                <set field="queueRows" from="queueRows.map(row =&gt; row.operation === 'returns' &amp;&amp;
                        returnQueue?.readyCount != null ? Object.assign({}, row, {readyCount: returnQueue.readyCount,
                            waitingCount: returnQueue.waitingCount}) : row)"/>
            </if>
            <!-- the transfers queue (P15): to send from the facility (ready), in transit to it (waiting), and of those due
                before today (late) -->
            <if condition="facilityId">
                <service-call name="ironstone.warehouse.TransferServices.get#TransferQueue" out-map="transferQueue"
                        in-map="{facilityId:facilityId}" transaction="force-new" ignore-error="true"/>
                <set field="queueRows" from="queueRows.map(row =&gt; row.operation === 'transfers' &amp;&amp;
                        transferQueue?.readyCount != null ? Object.assign({}, row, {readyCount: transferQueue.readyCount,
                            waitingCount: transferQueue.waitingCount, lateCount: transferQueue.lateCount}) : row)"/>
            </if>
            <!-- the picking queue (P11): open loads, unpicked shipments on no load, loads from an earlier day -->
            <if condition="facilityId &amp;&amp; (can.pick || can.loadEdit)">
                <service-call name="ironstone.warehouse.PickingServices.get#PickingQueue" out-map="pickQueue"
                        in-map="{facilityId:facilityId}" transaction="force-new" ignore-error="true"/>
                <set field="queueRows" from="queueRows.map(row =&gt; row.operation === 'picking' &amp;&amp;
                        pickQueue?.readyCount != null ? Object.assign({}, row, {readyCount: pickQueue.readyCount,
                            waitingCount: pickQueue.waitingCount, lateCount: pickQueue.lateCount}) : row)"/>
            </if>
            <!-- the packing queue (P12): picked shipments to pack, scheduled ones still to pick, picked ones due before today -->
            <if condition="facilityId &amp;&amp; can.pack">
                <service-call name="ironstone.warehouse.PackingServices.get#PackingQueue" out-map="packQueue"
                        in-map="{facilityId:facilityId}" transaction="force-new" ignore-error="true"/>
                <set field="queueRows" from="queueRows.map(row =&gt; row.operation === 'packing' &amp;&amp;
                        packQueue?.readyCount != null ? Object.assign({}, row, {readyCount: packQueue.readyCount,
                            waitingCount: packQueue.waitingCount, lateCount: packQueue.lateCount}) : row)"/>
            </if>
            <!-- the shipping queue (P13): packed shipments to ship, shipped ones in transit, packed ones due before today -->
            <if condition="facilityId">
                <service-call name="ironstone.warehouse.ShippingServices.get#ShippingQueue" out-map="shipQueue"
                        in-map="{facilityId:facilityId}" transaction="force-new" ignore-error="true"/>
                <set field="queueRows" from="queueRows.map(row =&gt; row.operation === 'shipping' &amp;&amp;
                        shipQueue?.readyCount != null ? Object.assign({}, row, {readyCount: shipQueue.readyCount,
                            waitingCount: shipQueue.waitingCount, lateCount: shipQueue.lateCount}) : row)"/>
            </if>
            <!-- the count queue and the counts assigned to the user (P10) -->
            <if condition="can.count || can.countReview || can.adjust">
                <service-call name="ironstone.warehouse.CountServices.get#CountWork" out-map="countWork"
                        in-map="{facilityId:facilityId}" transaction="force-new" ignore-error="true"/>
                <set field="queueRows" from="queueRows.map(row =&gt; row.operation === 'counts' &amp;&amp; countWork?.queue
                        ? Object.assign({}, row, countWork.queue) : row)"/>
            </if>
            <!-- the inspection queue and the inspections assigned to the user (P8) -->
            <service-call name="ironstone.warehouse.InspectionServices.get#InspectionWork" out-map="inspectionWork"
                    in-map="{facilityId:facilityId}" transaction="force-new" ignore-error="true"/>
            <set field="queueRows" from="queueRows.map(row =&gt; row.operation === 'inspection' &amp;&amp; inspectionWork?.queue
                    ? Object.assign({}, row, inspectionWork.queue) : row)"/>
            <!-- P17: Your work is the Today source's items (Today.js), so each phase's source shows here too -->
            <set field="workRows" from="ec.resource.script('component://mr-boss/service/ironstone/warehouse/Today.js')
                    .execute('workRows', {})"/>
            <!-- P17: the quantity indicators of the facility (design §3's KPI strip) -->
            <set field="indicators" from="{}"/>
            <if condition="facilityId">
                <set field="indicators" from="ec.resource.script('component://mr-boss/service/ironstone/warehouse/Reports.js')
                        .execute('homeIndicators', {facilityId:facilityId})"/>
            </if>
        </actions>
    </service>
    <service verb="get" noun="TodayItems" allow-remote="false">
        <description>The Warehouse today-source (Warehouse.xml shell-providers; get#UserTodayItems calls it): the work
            assigned to the user in their facilities (Today.js), now the open counts whose assignee they are (F42). P10 built
            it; P8 adds the inspections whose inspector the user is and P11 the loads still open from an earlier day, each a
            source of Today.js. A user without Warehouse gets none.</description>
        <in-parameters>
            <parameter name="userId"/>
            <parameter name="partyId"/>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="thruDate" type="Timestamp"/>
        </in-parameters>
        <out-parameters>
            <parameter name="items" type="List"/>
            <parameter name="label"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/warehouse/Today.js"/>
            <set field="today" from="ec.resource.script(module).execute('todayItems', context)"/>
            <set field="items" from="today.items"/>
            <set field="label" from="today.label"/>
        </actions>
    </service>
</services>
