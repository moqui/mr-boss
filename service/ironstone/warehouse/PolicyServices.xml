<!-- The reads and shapes of the Warehouse settings screens (impl-warehouse P3; Policies.js): each checks Warehouse access
    (get#SharedContext with the facility) and reads through Mantle's WarehousePolicyServices and AssetPoolServices, which
    check the organization and the policy permissions again. Changes go from the screens to the Mantle services directly
    (template/WarehousePolicyParts.xml), after check#Record of the facility with the policyManage capability. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="get" noun="PolicyContext" allow-remote="false">
        <description>The effective warehouse policy at a facility (or, with none, an organization of the user's), with each
            value's label, text and source (the trace), warnings, and for each family of policyTypes (operation,
            reservation, tracking; all by default) the form values of the row in effect at that exact scope and its
            history; with a store, its own reservation settings. Answers available false for a user in no organization.
            Refuses a facility outside the user's scope (FACILITY_UNAVAILABLE) and an organization not theirs.</description>
        <implements service="ironstone.warehouse.AccessServices.define#Parameters"/>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="productId"/>
            <parameter name="productStoreId"/>
            <parameter name="asOfDate" type="Timestamp"/>
            <parameter name="policyTypes"/>
        </in-parameters>
        <out-parameters>
            <parameter name="policy" type="Map"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/warehouse/Policies.js"/>
            <set field="policy" from="ec.resource.script(module).execute('context', context)"/>
        </actions>
    </service>
    <service verb="get" noun="TrackingExceptions" allow-remote="false">
        <description>The product tracking exceptions in effect for the organization (with a facility, those at it and those
            for every facility), the records Product360's Stock tab shows, each with its values for the edit form.</description>
        <implements service="ironstone.warehouse.AccessServices.define#Parameters"/>
        <in-parameters>
            <parameter name="organizationPartyId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="exceptionRows" type="List"/>
            <parameter name="canPlan" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/warehouse/Policies.js"/>
            <script>ec.context.putAll(ec.resource.script(module).execute('exceptions', context))</script>
        </actions>
    </service>
    <service verb="get" noun="ReservationCheck" allow-remote="false">
        <description>The reservations at the facility that a repair would change (Mantle's preview#FacilityReservations),
            named by reason. Reads only. Without a facility, needsFacility.</description>
        <implements service="ironstone.warehouse.AccessServices.define#Parameters"/>
        <in-parameters>
            <parameter name="productId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="findingRows" type="List"/>
            <parameter name="checkedCount" type="Integer"/>
            <parameter name="truncated" type="Boolean"/>
            <parameter name="needsFacility" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/warehouse/Policies.js"/>
            <script>ec.context.putAll(ec.resource.script(module).execute('reservationCheck', context))</script>
        </actions>
    </service>
    <service verb="get" noun="Pools" allow-remote="false">
        <description>The asset pools of the user's organizations, searched by ID or description, with owner names and member
            counts.</description>
        <implements service="ironstone.warehouse.AccessServices.define#Parameters"/>
        <in-parameters>
            <parameter name="term"/>
        </in-parameters>
        <out-parameters>
            <parameter name="poolRows" type="List"/>
            <parameter name="truncated" type="Boolean"/>
            <parameter name="canManage" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/warehouse/Policies.js"/>
            <script>ec.context.putAll(ec.resource.script(module).execute('pools', context))</script>
        </actions>
    </service>
    <service verb="get" noun="PoolDetail" allow-remote="false">
        <description>A pool with its parties and stores (names, roles, dates, state) and the open reservations on its stock,
            each with whether its order still qualifies. Refuses another organization's pool like a missing one.</description>
        <implements service="ironstone.warehouse.AccessServices.define#Parameters"/>
        <in-parameters>
            <parameter name="assetPoolId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="pool" type="Map"/>
            <parameter name="partyRows" type="List"/>
            <parameter name="storeRows" type="List"/>
            <parameter name="reservationRows" type="List"/>
            <parameter name="unqualifiedCount" type="Integer"/>
            <parameter name="truncated" type="Boolean"/>
            <parameter name="canManage" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/warehouse/Policies.js"/>
            <script>ec.context.putAll(ec.resource.script(module).execute('poolDetail', context))</script>
        </actions>
    </service>
    <service verb="get" noun="SettingsIndex" allow-remote="false">
        <description>The Warehouse settings sections with the effective value of each at the selected facility, else the
            user's organization, and who changes it.</description>
        <implements service="ironstone.warehouse.AccessServices.define#Parameters"/>
        <out-parameters>
            <parameter name="indexRows" type="List"/>
            <parameter name="scopeText"/>
            <parameter name="message"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/warehouse/Policies.js"/>
            <script>ec.context.putAll(ec.resource.script(module).execute('settingsIndex', context))</script>
        </actions>
    </service>
    <service verb="get" noun="PolicyChoices" allow-remote="false">
        <description>The settings screens' server-search drop-downs: organizations (the user's), stores and stockable
            products (of the user's organizations) and parties (customers, vendors and suppliers, never a private
            contact), each searched ignoring case and answering a selected value outside the page. An unknown choice
            throws.</description>
        <implements service="ironstone.warehouse.AccessServices.define#Parameters"/>
        <in-parameters>
            <parameter name="choice" required="true"/>
            <parameter name="term"/>
            <parameter name="selected"/>
        </in-parameters>
        <out-parameters>
            <parameter name="options" type="List"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/warehouse/Policies.js"/>
            <set field="options" from="ec.resource.script(module).execute('choices', context).options"/>
        </actions>
    </service>
</services>
