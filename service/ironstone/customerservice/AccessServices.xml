<!-- The Customer Service app's access (impl-customer-service §2, §4, P1; CustomerService.js): the user's service
    organizations, capabilities (own and borrowed), queues and teams, and customer scope, and the record check every Customer
    Service screen, mount and shared mount calls before the Mantle service. A user may open Customer Service through an
    authorization of their groups on its root (BOSS_CUSTOMER_SERVICE, the root user group, or BOSS_CUSTOMER_SERVICE_ADMIN);
    MANTLE_USER_ORG's organizations limit their records, and MANTLE_ACTIVE_ORG (the administrator's) leaves the active
    organization, or every one with none active. Capabilities are the Mantle permissions the services check, and the menu
    areas' authorizations. Disabled artifact authorization widens nothing here. No entity filter covers OrderHeader or Request
    (F2), so a sales order (and from P2 a case) is checked by its organization and customer here, and by the Mantle service
    again. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="define" noun="Parameters" type="interface">
        <description>The in-parameters the Customer Service app services share; each service declares what it
            returns.</description>
        <in-parameters>
            <parameter name="appRoot" type="String"/>
        </in-parameters>
    </service>
    <service verb="get" noun="SharedContext" allow-remote="false">
        <description>Check that the user may open Customer Service and resolve their scope and the app's routes:
            capabilities (the permissions, own and borrowed, and the areas), the organizations and whether they work in every
            one, and the queues and teams they work (P2). Refuses a user without Customer Service
            (CUSTOMER_SERVICE_UNAVAILABLE), a Projects client contact among them, and another app root
            (CUSTOMER_SERVICE_CONTEXT).</description>
        <implements service="ironstone.customerservice.AccessServices.define#Parameters"/>
        <out-parameters>
            <parameter name="capabilities" type="Map"/>
            <parameter name="organizationPartyIds" type="List"/>
            <parameter name="activeOrganizationPartyId" type="String"/>
            <parameter name="allOrganizations" type="Boolean"/>
            <parameter name="queueIds" type="List"/>
            <parameter name="teamIds" type="List"/>
            <parameter name="managedTeamIds" type="List"/>
            <parameter name="appRoot" type="String"/>
            <parameter name="sharedLinks" type="Map"/>
            <parameter name="linkBase" type="String"/>
            <parameter name="webBase" type="String"/>
            <parameter name="approvalTopics" type="List"><description>P9: the decision topics Approvals lists</description></parameter>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/customerservice/CustomerService.js"/>
            <set field="shared" from="ec.resource.script(module).execute('sharedContext', context)"/>
            <set field="capabilities" from="shared.capabilities"/>
            <set field="organizationPartyIds" from="shared.organizationPartyIds"/>
            <set field="activeOrganizationPartyId" from="shared.activeOrganizationPartyId"/>
            <set field="allOrganizations" from="shared.allOrganizations"/>
            <set field="queueIds" from="shared.queueIds"/>
            <set field="teamIds" from="shared.teamIds"/>
            <set field="managedTeamIds" from="shared.managedTeamIds"/>
            <set field="appRoot" from="shared.appRoot"/>
            <set field="sharedLinks" from="shared.sharedLinks"/>
            <set field="linkBase" from="shared.linkBase"/>
            <set field="webBase" from="shared.webBase"/>
            <set field="approvalTopics" from="shared.approvalTopics"/>
        </actions>
    </service>
    <service verb="check" noun="Record" allow-remote="false">
        <description>A record a Customer Service screen or mount was given: a sales order or a customer (cases, returns and
            warranty claims as their phases build them). Answers its kind's name, a label and a short detail. Refuses a
            record that does not exist and one outside the scope alike (RECORD_UNAVAILABLE): an order whose selling
            organization is not one of the user's or whose customer they do not serve, another organization's customer, an
            unowned party. With a capability named (caseEdit, returnAuthorize, ...), refuses a user without its permission
            (PERMISSION_DENIED).</description>
        <implements service="ironstone.customerservice.AccessServices.define#Parameters"/>
        <in-parameters>
            <parameter name="recordType" required="true"><description>order, customer or case (CustomerService.js
                recordKinds)</description></parameter>
            <parameter name="recordId" required="true"/>
            <parameter name="capability"/>
        </in-parameters>
        <out-parameters>
            <parameter name="recordType"/>
            <parameter name="recordId"/>
            <parameter name="kindName"/>
            <parameter name="label"/>
            <parameter name="detail"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/customerservice/CustomerService.js"/>
            <set field="record" from="ec.resource.script(module).execute('checkRecord', context)"/>
            <set field="recordType" from="record.recordType"/>
            <set field="recordId" from="record.recordId"/>
            <set field="kindName" from="record.kindName"/>
            <set field="label" from="record.label"/>
            <set field="detail" from="record.detail"/>
        </actions>
    </service>
    <service verb="get" noun="Choices" allow-remote="false">
        <description>The options of a Customer Service drop-down the user may choose, searched by term in the query, with
            the selected value's label: customers (the user's organizations' and the shared ones), organizations (the
            user's service organizations), and from P2 queues (the user's), teams, agents (of a queue's team, else of the
            user's teams), caseTypes (the organization's service-enabled types, by customer label), tags and contacts (of a
            customer). Refuses an unknown choice.</description>
        <implements service="ironstone.customerservice.AccessServices.define#Parameters"/>
        <in-parameters>
            <parameter name="choice" required="true"/>
            <parameter name="term"/>
            <parameter name="selected"/>
            <!-- P2: the record a choice is narrowed to: a queue's agents, a customer's contacts, an organization's queues and
                types -->
            <parameter name="queueId"/>
            <parameter name="customerPartyId"/>
            <parameter name="organizationPartyId"/>
            <!-- P10: an order's lines, short picks and a line's substitutes (customerOrders, orderLines, shortPicks,
                substitutes) -->
            <parameter name="orderId"/>
            <parameter name="orderItemSeqId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="options" type="List"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/customerservice/CustomerService.js"/>
            <set field="found" from="ec.resource.script(module).execute('choices', context)"/>
            <set field="options" from="found.options"/>
        </actions>
    </service>
    <service verb="search" noun="Records" allow-remote="false">
        <description>The palette's Customer Service records: the sales orders of the user's organizations (by id, name or
            reference) and the customers they serve (by id or name), ignoring case, limited in the query and checked again,
            with their Customer Service links. No rows for a user without Customer Service.</description>
        <in-parameters>
            <parameter name="text"/>
            <parameter name="limit" type="Integer"/>
            <parameter name="docTypes" type="List"/>
            <parameter name="idMatch" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="rows" type="List"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/customerservice/CustomerService.js"/>
            <set field="found" from="ec.resource.script(module).execute('search', context)"/>
            <set field="rows" from="found.rows"/>
        </actions>
    </service>
</services>
