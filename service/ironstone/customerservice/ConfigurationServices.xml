<!-- Customer Service settings reads (impl-customer-service P2, CS-SETTINGS; Configuration.js): what the Settings forms show
    for one of the user's organizations. The saves are Mantle's mantle.request.SupportCaseServices (save#ServiceQueue,
    save#ServiceRequestType, save#CaseStatusMapping, save#CaseWorkflow, save#ServiceDefaults, save#ServiceTeam,
    save#ServiceTeamMember), which check SUPPORT_POLICY_EDIT or SUPPORT_CASE_MANAGE and the organization themselves. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="define" noun="SettingsParameters" type="interface">
        <description>The organization a settings read is of (one of the user's; the active one, else their first, when
            empty).</description>
        <in-parameters>
            <parameter name="appRoot" type="String"/>
            <parameter name="organizationPartyId"/>
        </in-parameters>
    </service>
    <service verb="find" noun="ServiceQueues" allow-remote="false">
        <description>The organization's queues as a tree (design Queues QueueList): each category with its current service
            row (visibility, team, offered types, fallback assignee, since when), whether it is a service queue now, and its
            draft rows. Refuses an organization not the user's (RECORD_UNAVAILABLE).</description>
        <implements service="ironstone.customerservice.ConfigurationServices.define#SettingsParameters"/>
        <out-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="organizations" type="List"/>
            <parameter name="queues" type="List"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/customerservice/Configuration.js').execute('serviceQueues', context)"/>
            <set field="organizationPartyId" from="found.organizationPartyId"/>
            <set field="organizations" from="found.organizations"/>
            <set field="queues" from="found.queues"/>
        </actions>
    </service>
    <service verb="get" noun="ServiceTeam" allow-remote="false">
        <description>The organization's service teams (design AgentTeams TeamMembers), each with its current members (agent
            or manager, since when, open assigned cases) and whether the user may change it (the administrator, or a
            manager of the team); with teamPartyId, that team only.</description>
        <implements service="ironstone.customerservice.ConfigurationServices.define#SettingsParameters"/>
        <in-parameters><parameter name="teamPartyId"/></in-parameters>
        <out-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="organizations" type="List"/>
            <parameter name="teams" type="List"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/customerservice/Configuration.js').execute('serviceTeam', context)"/>
            <set field="organizationPartyId" from="found.organizationPartyId"/>
            <set field="organizations" from="found.organizations"/>
            <set field="teams" from="found.teams"/>
        </actions>
    </service>
    <service verb="get" noun="ServiceSettings" allow-remote="false">
        <description>The organization's case types (each request type with its current service row), its workflow's status
            mappings and moves, its service policy and the settings' readiness (design Settings SettingLinks, CaseTypes,
            StatusCategories, ServiceDefaults).</description>
        <implements service="ironstone.customerservice.ConfigurationServices.define#SettingsParameters"/>
        <in-parameters><parameter name="caseWorkflowId"/></in-parameters>
        <out-parameters><parameter name="settings" type="Map"/></out-parameters>
        <actions>
            <set field="settings" from="ec.resource.script('component://mr-boss/service/ironstone/customerservice/Configuration.js').execute('serviceSettings', context)"/>
        </actions>
    </service>
</services>
