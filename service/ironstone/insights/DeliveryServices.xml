<!-- Insights' scheduled delivery and management digests (design-insights §7; impl-insights P7, INS-06, INS-11; Delivery.js):
    Insights' permissions, cap, names and words over the report engine's owner-equivalent delivery
    (org.moqui.report.ReportServices check#ReportAudience, store#Schedule, find#ReportOccurrences, get#ReportOccurrence,
    get#RecipientReport, retry#ReportRecipients). Every write answers a refusal as applied false with reasonCode and reason. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="find" noun="Schedules" allow-remote="false">
        <description>ScheduledReports' lists for an Insights reader (INSIGHTS_VIEW_REQUIRED otherwise). view mine: the caller's personal
            schedules, the screen schedules they set up for themselves among them (legacy); shared: the group schedules a
            distributor owns; received: the deliveries to the caller, a page of them, whatever they may schedule. mine and
            shared need INSIGHTS_SCHEDULE (INSIGHTS_SCHEDULE_REQUIRED). Each row is display text: the report, the timing, the
            mode, the audience, the state and the last run; never a recipient's content. With the choices of a new schedule
            (the dashboards and digests the caller reads, formats, timings).</description>
        <in-parameters>
            <parameter name="view"/>
            <parameter name="definitionId"/>
            <parameter name="state"/>
            <parameter name="pageIndex" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="view"/>
            <parameter name="schedules" type="List"/>
            <parameter name="received" type="List"/>
            <parameter name="receivedCount" type="Integer"/>
            <parameter name="receivedPageIndex" type="Integer"/>
            <parameter name="receivedPageSize" type="Integer"/>
            <parameter name="receivedPageMaxIndex" type="Integer"/>
            <parameter name="receivedPageRangeLow" type="Integer"/>
            <parameter name="receivedPageRangeHigh" type="Integer"/>
            <parameter name="canSchedule" type="Boolean"/>
            <parameter name="canDistribute" type="Boolean"/>
            <parameter name="definitionOptions" type="List"/>
            <parameter name="formatOptions" type="List"/>
            <parameter name="cronOptions" type="List"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('findSchedules', context)"/>
            <set field="view" from="found.view"/>
            <set field="schedules" from="found.schedules"/>
            <set field="received" from="found.received"/>
            <set field="receivedCount" from="found.receivedCount"/>
            <set field="receivedPageIndex" from="found.receivedPageIndex"/>
            <set field="receivedPageSize" from="found.receivedPageSize"/>
            <set field="receivedPageMaxIndex" from="found.receivedPageMaxIndex"/>
            <set field="receivedPageRangeLow" from="found.receivedPageRangeLow"/>
            <set field="receivedPageRangeHigh" from="found.receivedPageRangeHigh"/>
            <set field="canSchedule" from="found.canSchedule"/>
            <set field="canDistribute" from="found.canDistribute"/>
            <set field="definitionOptions" from="found.definitionOptions"/>
            <set field="formatOptions" from="found.formatOptions"/>
            <set field="cronOptions" from="found.cronOptions"/>
        </actions>
    </service>
    <service verb="get" noun="Schedule" allow-remote="false">
        <description>One schedule the caller owns (SCHEDULE_UNAVAILABLE for another's or none; INSIGHTS_SCHEDULE_REQUIRED): its timing and
            output, its recipients by name, each recipient's result from the engine's audience check for a distributor
            (eligible or a reason in words, never the other person's grants), its runs with their safe counters, and the
            sections of the caller's own preview. A screen schedule of the caller's own answers its timing, format and subject
            only (legacy true).</description>
        <in-parameters>
            <parameter name="screenScheduledId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="schedule" type="Map"/>
            <parameter name="options" type="Map"/>
            <parameter name="recipients" type="List"/>
            <parameter name="audience" type="List"/>
            <parameter name="audienceNote"/>
            <parameter name="runs" type="List"/>
            <parameter name="sections" type="List"/>
            <parameter name="canDistribute" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('getSchedule', context)"/>
            <set field="schedule" from="found.schedule"/>
            <set field="options" from="found.options"/>
            <set field="recipients" from="found.recipients"/>
            <set field="audience" from="found.audience"/>
            <set field="audienceNote" from="found.audienceNote"/>
            <set field="runs" from="found.runs"/>
            <set field="sections" from="found.sections"/>
            <set field="canDistribute" from="found.canDistribute"/>
        </actions>
    </service>
    <service verb="store" noun="Schedule" allow-remote="false">
        <description>Create or change a schedule of the caller's own (INSIGHTS_SCHEDULE_REQUIRED): the report (a dashboard or digest they
            read), the timing (cronSelected, one of the offered timings, over cronExpression), the format, the active interval,
            skipping an empty report, the subject, and with recipientUserIds or recipientGroupIds (or recipientsGiven Y, to name
            nobody but the caller) its recipients; with timingGiven Y an empty subject or date is cleared. Other people
            need INSIGHTS_DISTRIBUTE (INSIGHTS_DISTRIBUTE_REQUIRED), a person must be an Insights reader
            (RECIPIENT_UNAVAILABLE) and a group one the caller belongs to (RECIPIENT_GROUP_UNAVAILABLE). The report engine sets the mode (personal or group), keeps the cap of 50 under the
            instance ceiling (RECIPIENT_CAP), refuses a recipient whose scope differs from the caller's (RECIPIENT_REFUSED, naming
            each with its reason code) and a stale revision (STALE_REVISION). A screen schedule of the caller's own changes its
            timing, format and subject only and takes no other recipient (LEGACY_PERSONAL). A refusal is the answer (applied
            false, reasonCode, reason), not an error.</description>
        <in-parameters>
            <parameter name="screenScheduledId"/>
            <parameter name="definitionId"/>
            <parameter name="cronSelected"/>
            <parameter name="cronExpression"/>
            <parameter name="renderMode"/>
            <parameter name="noResultsAbort"/>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="thruDate" type="Timestamp"/>
            <parameter name="emailSubject"/>
            <parameter name="recipientUserIds" type="List"/>
            <parameter name="recipientGroupIds" type="List"/>
            <parameter name="recipientsGiven"/>
            <parameter name="timingGiven"/>
            <parameter name="paused"/>
            <parameter name="expectedRevision"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="screenScheduledId"/>
            <parameter name="deliveryMode"/>
            <parameter name="revision" type="Long"/>
            <parameter name="recipientCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('storeSchedule', context)"/>
            <set field="applied" from="found.applied"/>
            <set field="reasonCode" from="found.reasonCode"/>
            <set field="reason" from="found.reason"/>
            <set field="screenScheduledId" from="found.screenScheduledId"/>
            <set field="deliveryMode" from="found.deliveryMode"/>
            <set field="revision" from="found.revision"/>
            <set field="recipientCount" from="found.recipientCount"/>
        </actions>
    </service>
    <service verb="pause" noun="Schedules" allow-remote="false">
        <description>Pause (or with paused false, resume) the caller's schedules named in screenScheduledIds, each with its own result
            (results: screenScheduledId, applied, reasonCode, reason); a resume the engine refuses, a group schedule with a
            recipient whose scope differs or one waiting for its new owner's check, says why and the others go on.</description>
        <in-parameters>
            <parameter name="screenScheduledIds" type="List"/>
            <parameter name="paused"/>
        </in-parameters>
        <out-parameters>
            <parameter name="results" type="List"/>
            <parameter name="appliedCount" type="Integer"/>
            <parameter name="paused" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('pauseSchedules', context)"/>
            <set field="results" from="found.results"/>
            <set field="appliedCount" from="found.appliedCount"/>
            <set field="paused" from="found.paused"/>
        </actions>
    </service>
    <service verb="send" noun="Schedule" allow-remote="false" transaction="ignore">
        <description>Send now: a new occurrence of the caller's schedule, each recipient checked as at any run and sent their own message;
            never a replay of an earlier occurrence. skipped with skippedReason when nothing was sent (an empty report, a run
            under way).</description>
        <in-parameters>
            <parameter name="screenScheduledId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="sent" type="Boolean"/>
            <parameter name="skipped" type="Boolean"/>
            <parameter name="skippedReason"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('sendSchedule', context)"/>
            <set field="applied" from="found.applied"/>
            <set field="reasonCode" from="found.reasonCode"/>
            <set field="reason" from="found.reason"/>
            <set field="sent" from="found.sent"/>
            <set field="skipped" from="found.skipped"/>
            <set field="skippedReason" from="found.skippedReason"/>
        </actions>
    </service>
    <service verb="check" noun="Audience" allow-remote="false">
        <description>Each proposed recipient's result for a distributor (INSIGHTS_DISTRIBUTE_REQUIRED) before saving: the engine's audience
            check of a dashboard or digest the caller reads, as rows of names with eligible, blocking and the reason in words; the
            counts, the cap and whether the audience is over it.</description>
        <in-parameters>
            <parameter name="definitionId"/>
            <parameter name="recipientUserIds" type="List"/>
            <parameter name="recipientGroupIds" type="List"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="recipients" type="List"/>
            <parameter name="recipientCount" type="Integer"/>
            <parameter name="eligibleCount" type="Integer"/>
            <parameter name="refusedCount" type="Integer"/>
            <parameter name="recipientCap" type="Integer"/>
            <parameter name="overCap" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('checkAudience', context)"/>
            <set field="applied" from="found.applied"/>
            <set field="reasonCode" from="found.reasonCode"/>
            <set field="reason" from="found.reason"/>
            <set field="recipients" from="found.recipients"/>
            <set field="recipientCount" from="found.recipientCount"/>
            <set field="eligibleCount" from="found.eligibleCount"/>
            <set field="refusedCount" from="found.refusedCount"/>
            <set field="recipientCap" from="found.recipientCap"/>
            <set field="overCap" from="found.overCap"/>
        </actions>
    </service>
    <service verb="find" noun="RecipientChoices" allow-remote="false">
        <description>The internal people a distributor may propose as recipients (INSIGHTS_DISTRIBUTE_REQUIRED): active holders of
            INSIGHTS_VIEW, searched by name in the query, twenty a page, with the selected ones read on their own. Choosing one
            grants nothing: the audience check decides.</description>
        <in-parameters>
            <parameter name="term"/>
            <parameter name="selected" type="List"/>
        </in-parameters>
        <out-parameters>
            <parameter name="options" type="List"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('recipientChoices', context)"/>
            <set field="options" from="found.options"/>
        </actions>
    </service>
    <service verb="get" noun="Delivery" allow-remote="false">
        <description>ReportDelivery's occurrence (DELIVERY_UNAVAILABLE for one that is missing or not the caller's to see): for its
            schedule's owner what ran (the schedule's revision, the report's version, the counters) and each recipient's outcome
            (name, state, safe reason, attempt time, whether it may be retried); for a recipient who administers nothing, their
            own delivery alone. No frame, file or query of anyone's.</description>
        <in-parameters>
            <parameter name="occurrenceId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="occurrence" type="Map"/>
            <parameter name="deliveries" type="List"/>
            <parameter name="ownDelivery" type="Map"/>
            <parameter name="administers" type="Boolean"/>
            <parameter name="canRetry" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('getDelivery', context)"/>
            <set field="occurrence" from="found.occurrence"/>
            <set field="deliveries" from="found.deliveries"/>
            <set field="ownDelivery" from="found.ownDelivery"/>
            <set field="administers" from="found.administers"/>
            <set field="canRetry" from="found.canRetry"/>
        </actions>
    </service>
    <service verb="export" noun="DeliveryAudit" allow-remote="false">
        <description>One run's delivery status as CSV (design §14 Delivery audit; P12), for whom get#Delivery answers it
            (DELIVERY_UNAVAILABLE otherwise): its schedule's owner gets the run and each recipient's result with its safe reason
            and attempts, a recipient their own delivery alone. No report content, address or another recipient's report; the
            export is audited (the report engine's audit#Export, kind delivery-audit).</description>
        <in-parameters>
            <parameter name="occurrenceId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="csvText"/>
            <parameter name="fileName"/>
            <parameter name="rowCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('deliveryAudit', context)"/>
            <set field="csvText" from="found.csvText"/>
            <set field="fileName" from="found.fileName"/>
            <set field="rowCount" from="found.rowCount"/>
        </actions>
    </service>
    <service verb="retry" noun="Recipients" allow-remote="false" transaction="ignore">
        <description>Send again to the failed recipients chosen (deliveryIds) of an occurrence of the caller's schedule, at the revision read
            (expectedRevision): the engine retries only failed deliveries, checks each recipient again and never replays a sent
            one; an uncertain one waits for reconcile#Recipient. results names each delivery's outcome.</description>
        <in-parameters>
            <parameter name="occurrenceId"/>
            <parameter name="deliveryIds" type="List"/>
            <parameter name="expectedRevision"/>
            <parameter name="reason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="sentCount" type="Integer"/>
            <parameter name="notSentCount" type="Integer"/>
            <parameter name="results" type="List"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('retryRecipients', context)"/>
            <set field="applied" from="found.applied"/>
            <set field="reasonCode" from="found.reasonCode"/>
            <set field="reason" from="found.reason"/>
            <set field="sentCount" from="found.sentCount"/>
            <set field="notSentCount" from="found.notSentCount"/>
            <set field="results" from="found.results"/>
        </actions>
    </service>
    <service verb="reconcile" noun="Recipient" allow-remote="false">
        <description>Settle an uncertain delivery of the caller's schedule: outcome sent (it did arrive) or failed (it did not, so it may be
            retried), with the reason, which the engine keeps in its audit log.</description>
        <in-parameters>
            <parameter name="deliveryId"/>
            <parameter name="outcome"/>
            <parameter name="reason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="statusId"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('reconcileRecipient', context)"/>
            <set field="applied" from="found.applied"/>
            <set field="reasonCode" from="found.reasonCode"/>
            <set field="reason" from="found.reason"/>
            <set field="statusId" from="found.statusId"/>
        </actions>
    </service>
    <service verb="get" noun="OwnReport" allow-remote="false" transaction="ignore">
        <description>The caller's own delivered report (DELIVERY_UNAVAILABLE for another's delivery or one not sent): the engine renders it
            again as the caller, since nothing sent is stored, and releases nothing when their scope changed since the delivery
            (available false with the reason).</description>
        <in-parameters>
            <parameter name="deliveryId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="available" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="contentBase64"/>
            <parameter name="contentType"/>
            <parameter name="filename"/>
            <parameter name="title"/>
            <parameter name="generatedText"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('ownReport', context)"/>
            <set field="available" from="found.available"/>
            <set field="reasonCode" from="found.reasonCode"/>
            <set field="reason" from="found.reason"/>
            <set field="contentBase64" from="found.contentBase64"/>
            <set field="contentType" from="found.contentType"/>
            <set field="filename" from="found.filename"/>
            <set field="title" from="found.title"/>
            <set field="generatedText" from="found.generatedText"/>
        </actions>
    </service>
    <service verb="preview" noun="Report" allow-remote="false" transaction="ignore">
        <description>The caller's own render of a dashboard or digest they read, as a file (renderMode pdf, xlsx, csv or png), for
            OwnPreview and DigestPreview: the engine's preview#Report as the viewer.</description>
        <in-parameters>
            <parameter name="definitionId"/>
            <parameter name="renderMode"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="contentBase64"/>
            <parameter name="contentType"/>
            <parameter name="filename"/>
            <parameter name="empty" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('previewReport', context)"/>
            <set field="applied" from="found.applied"/>
            <set field="reasonCode" from="found.reasonCode"/>
            <set field="reason" from="found.reason"/>
            <set field="contentBase64" from="found.contentBase64"/>
            <set field="contentType" from="found.contentType"/>
            <set field="filename" from="found.filename"/>
            <set field="empty" from="found.empty"/>
        </actions>
    </service>
    <service verb="get" noun="Digest" allow-remote="false">
        <description>ManagementDigest for an Insights reader: the digests they read, the one chosen (DIGEST_UNAVAILABLE otherwise) with its
            dashboards, period and commentary, the sections of the caller's own preview of it (a dashboard the caller may not
            read is counted in missingCount, never named), which digest Home previews, and for a composer (INSIGHTS_AUTHOR or
            INSIGHTS_DISTRIBUTE) the dashboards, periods and own groups to choose from.</description>
        <in-parameters>
            <parameter name="definitionId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="canCompose" type="Boolean"/>
            <parameter name="canSchedule" type="Boolean"/>
            <parameter name="defaultDigestId"/>
            <parameter name="digests" type="List"/>
            <parameter name="digest" type="Map"/>
            <parameter name="sections" type="List"/>
            <parameter name="missingCount" type="Integer"/>
            <parameter name="options" type="Map"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('getDigest', context)"/>
            <set field="canCompose" from="found.canCompose"/>
            <set field="canSchedule" from="found.canSchedule"/>
            <set field="defaultDigestId" from="found.defaultDigestId"/>
            <set field="digests" from="found.digests"/>
            <set field="digest" from="found.digest"/>
            <set field="sections" from="found.sections"/>
            <set field="missingCount" from="found.missingCount"/>
            <set field="options" from="found.options"/>
        </actions>
    </service>
    <service verb="store" noun="Digest" allow-remote="false">
        <description>Compose or change a digest (INSIGHTS_DIGEST_REQUIRED without authoring or distribution): a report definition of kind
            digest the caller owns (DIGEST_NOT_OWNED for another's) over one to six dashboards they read (DASHBOARD_UNAVAILABLE),
            in order, with one period and a commentary of at most 2000 characters, private or shared with one of the caller's
            own groups (SHARE_GROUP_UNAVAILABLE). Sharing shares the definition, never data: each reader's panels run as
            themselves, and its schedule is checked recipient by recipient.</description>
        <in-parameters>
            <parameter name="definitionId"/>
            <parameter name="title"/>
            <parameter name="dashboardIds" type="List"/>
            <parameter name="period"/>
            <parameter name="commentary"/>
            <parameter name="userGroupId"/>
            <parameter name="expectedVersion"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="definitionId"/>
            <parameter name="version" type="Long"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('storeDigest', context)"/>
            <set field="applied" from="found.applied"/>
            <set field="reasonCode" from="found.reasonCode"/>
            <set field="reason" from="found.reason"/>
            <set field="definitionId" from="found.definitionId"/>
            <set field="version" from="found.version"/>
        </actions>
    </service>
    <service verb="store" noun="DefaultDigest" allow-remote="false">
        <description>The digest Home previews for the caller, one they read (DIGEST_UNAVAILABLE otherwise), or none: a preference of the
            caller's, which grants nothing.</description>
        <in-parameters>
            <parameter name="definitionId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="definitionId"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('storeDefaultDigest', context)"/>
            <set field="applied" from="found.applied"/>
            <set field="reasonCode" from="found.reasonCode"/>
            <set field="reason" from="found.reason"/>
            <set field="definitionId" from="found.definitionId"/>
        </actions>
    </service>
    <service verb="get" noun="DigestPreview" allow-remote="false">
        <description>Home's DigestPreview: the caller's default digest with the sections of their own preview (two panels a section), or
            no digest when none is set or it is no longer theirs to read.</description>
        <out-parameters>
            <parameter name="digest" type="Map"/>
            <parameter name="sections" type="List"/>
            <parameter name="missingCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('digestPreview', context)"/>
            <set field="digest" from="found.digest"/>
            <set field="sections" from="found.sections"/>
            <set field="missingCount" from="found.missingCount"/>
        </actions>
    </service>
</services>
