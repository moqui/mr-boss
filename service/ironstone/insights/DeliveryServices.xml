<!-- Insights' management digests (design-insights §7.3; impl-insights P7, INS-11; Delivery.js), the caller's own preview of a
    digest or dashboard as a file, and the recipient choices of an alert rule. Scheduled delivery itself is the framework's:
    Scheduled reports mounts the framework's Dashboards screens, which read and write through
    org.moqui.report.ReportServices (mr-moqui plans/Admin-Screens-Down.md, Track I). Every write answers a refusal as applied
    false with reasonCode and reason. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="find" noun="RecipientChoices" allow-remote="false">
        <description>The internal people a distributor may propose as recipients (INSIGHTS_DISTRIBUTE_REQUIRED): active holders of
            INSIGHTS_VIEW, searched by name in the query, twenty a page, with the selected ones read on their own. Choosing one
            grants nothing: the audience check decides.</description>
        <in-parameters>
            <parameter name="term"/>
            <parameter name="selected" type="List"/>
        </in-parameters>
        <out-parameters>
            <parameter name="options" type="List"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('recipientChoices', context)"/>
            <set field="options" from="found.options"/>
        </actions>
    </service>
    <service verb="preview" noun="Report" allow-remote="false" transaction="ignore">
        <description>The caller's own render of a dashboard or digest they read, as a file (renderMode pdf, xlsx, csv or png), for
            OwnPreview and DigestPreview: the engine's preview#Report as the viewer.</description>
        <in-parameters>
            <parameter name="definitionId"/>
            <parameter name="renderMode"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="contentBase64"/>
            <parameter name="contentType"/>
            <parameter name="filename"/>
            <parameter name="empty" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('previewReport', context)"/>
            <set field="applied" from="found.applied"/>
            <set field="reasonCode" from="found.reasonCode"/>
            <set field="reason" from="found.reason"/>
            <set field="contentBase64" from="found.contentBase64"/>
            <set field="contentType" from="found.contentType"/>
            <set field="filename" from="found.filename"/>
            <set field="empty" from="found.empty"/>
        </actions>
    </service>
    <service verb="get" noun="Digest" allow-remote="false">
        <description>ManagementDigest for an Insights reader: the digests they read, the one chosen (DIGEST_UNAVAILABLE otherwise) with its
            dashboards, period and commentary, the sections of the caller's own preview of it (a dashboard the caller may not
            read is counted in missingCount, never named), which digest Home previews, and for a composer (INSIGHTS_AUTHOR or
            INSIGHTS_DISTRIBUTE) the dashboards, periods and own groups to choose from.</description>
        <in-parameters>
            <parameter name="definitionId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="canCompose" type="Boolean"/>
            <parameter name="canSchedule" type="Boolean"/>
            <parameter name="defaultDigestId"/>
            <parameter name="digests" type="List"/>
            <parameter name="digest" type="Map"/>
            <parameter name="sections" type="List"/>
            <parameter name="missingCount" type="Integer"/>
            <parameter name="options" type="Map"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('getDigest', context)"/>
            <set field="canCompose" from="found.canCompose"/>
            <set field="canSchedule" from="found.canSchedule"/>
            <set field="defaultDigestId" from="found.defaultDigestId"/>
            <set field="digests" from="found.digests"/>
            <set field="digest" from="found.digest"/>
            <set field="sections" from="found.sections"/>
            <set field="missingCount" from="found.missingCount"/>
            <set field="options" from="found.options"/>
        </actions>
    </service>
    <service verb="store" noun="Digest" allow-remote="false">
        <description>Compose or change a digest (INSIGHTS_DIGEST_REQUIRED without authoring or distribution): a report definition of kind
            digest the caller owns (DIGEST_NOT_OWNED for another's) over one to six dashboards they read (DASHBOARD_UNAVAILABLE),
            in order, with one period and a commentary of at most 2000 characters, private or shared with one of the caller's
            own groups (SHARE_GROUP_UNAVAILABLE). Sharing shares the definition, never data: each reader's panels run as
            themselves, and its schedule is checked recipient by recipient.</description>
        <in-parameters>
            <parameter name="definitionId"/>
            <parameter name="title"/>
            <parameter name="dashboardIds" type="List"/>
            <parameter name="period"/>
            <parameter name="commentary"/>
            <parameter name="userGroupId"/>
            <parameter name="expectedVersion"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="definitionId"/>
            <parameter name="version" type="Long"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('storeDigest', context)"/>
            <set field="applied" from="found.applied"/>
            <set field="reasonCode" from="found.reasonCode"/>
            <set field="reason" from="found.reason"/>
            <set field="definitionId" from="found.definitionId"/>
            <set field="version" from="found.version"/>
        </actions>
    </service>
    <service verb="store" noun="DefaultDigest" allow-remote="false">
        <description>The digest Home previews for the caller, one they read (DIGEST_UNAVAILABLE otherwise), or none: a preference of the
            caller's, which grants nothing.</description>
        <in-parameters>
            <parameter name="definitionId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="definitionId"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('storeDefaultDigest', context)"/>
            <set field="applied" from="found.applied"/>
            <set field="reasonCode" from="found.reasonCode"/>
            <set field="reason" from="found.reason"/>
            <set field="definitionId" from="found.definitionId"/>
        </actions>
    </service>
    <service verb="get" noun="DigestPreview" allow-remote="false">
        <description>Home's DigestPreview: the caller's default digest with the sections of their own preview (two panels a section), or
            no digest when none is set or it is no longer theirs to read.</description>
        <out-parameters>
            <parameter name="digest" type="Map"/>
            <parameter name="sections" type="List"/>
            <parameter name="missingCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Delivery.js').execute('digestPreview', context)"/>
            <set field="digest" from="found.digest"/>
            <set field="sections" from="found.sections"/>
            <set field="missingCount" from="found.missingCount"/>
        </actions>
    </service>
</services>
