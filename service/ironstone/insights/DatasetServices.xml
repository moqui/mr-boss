<!-- Insights' business datasets in the framework's readiness and refresh registries (design-insights §5, §11; impl-insights P3; impl-admin F50, F53;
    Datasets.js): each dataset's readiness provider and index refresh. Each calls the framework's business dataset services as
    the viewer, so the engine checks the dataset's own artifact. The report builder's dataset screens are the framework's
    Dashboards screens under Insights' mount and read through org.moqui.report.ReportServices (mr-moqui
    plans/Admin-Screens-Down.md, Track I). -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="check" noun="DatasetReadiness" allow-remote="false">
        <description>The readiness contract of a dataset's provider (moqui.server.ReadinessProvider insights.dataset.(id)): admitted with
            its checks passing is ready, waiting for review or retired a warning naming what fails, a missing source unavailable;
            the watermark is the index's last build. A dataset the viewer neither reads nor stewards is refused
            (RECORD_UNAVAILABLE), so the registry leaves it out.</description>
        <in-parameters><parameter name="providerKey" required="true"/></in-parameters>
        <out-parameters><parameter name="checks" type="List"/></out-parameters>
        <actions>
            <set field="checks" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Datasets.js').execute('readiness', context).checks"/>
        </actions>
    </service>
    <service verb="refresh" noun="DatasetIndex" allow-remote="false">
        <description>A dataset's index rebuild requested through the framework's request#Refresh (moqui.server.RefreshOperation insights.dataset.(id).index):
            the dataset is the registration's source, never a name from the request, and index#BusinessDataset runs as the viewer, so
            the dataset's own update artifact guards it. Refuses an unknown or another app's registration (REFRESH_UNAVAILABLE).</description>
        <in-parameters>
            <parameter name="refreshKey" required="true"/><parameter name="operationKey"/><parameter name="reason"/>
        </in-parameters>
        <out-parameters><parameter name="documentsIndexed" type="Long"/></out-parameters>
        <actions>
            <set field="documentsIndexed" from="ec.resource.script('component://mr-boss/service/ironstone/insights/Datasets.js').execute('refresh', context).documentsIndexed"/>
        </actions>
    </service>
</services>
