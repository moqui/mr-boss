<!-- Admin's access evidence (design-admin §12 AccessLog, §16 "Audit evidence"; impl-admin P17; admin/Audit.js): what
    Admin › Audit's AccessLog shows, prints and writes as CSV. Change evidence, the area's other screen, is the
    framework's (System › Audit's AuditChanges mounted by location, over org.moqui.admin.AuditServices.find#Changes:
    registered projections only; a record of an organization found by its owner within the user's scope; a secret never
    a value; mr-moqui plans/Admin-Screens-Down.md) and has no service here. Access evidence is the report engine's own
    read (org.moqui.report.ReportServices.query#Documents) of the shipped dataset admin-access-log, which is granted to no
    group: get#AccessLog checks the permission and reads it past its artifact, under the dataset's row filters; this
    answers of each line only the fields named here, never its other attributes. It checks ADMIN_AUDIT_VIEW under
    Admin. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="get" noun="AccessLog" allow-remote="false">
        <description>Admin's AccessLog: the lines of the dataset admin-access-log (the report engine's and monitoring's
            audit lines, read by ReportServices.query#Documents after this service's own check), newest first, each as its safe fields only:
            when, the source (reports or monitoring), what was done (the line's own fixed text), who (the line's user
            or the signed-in user it was written under), what it was about (a definition, schedule, occurrence, rule,
            incident, decision, action or setting, by id), the kind and format, counts (rows, recipients as a number,
            never addresses), the outcome, the reason given and the trace it belongs to (correlation). A line's other
            attributes (a setting's value, a list of addresses) are never answered. Narrowed by source, actorUserId,
            subject (an id, whole), correlation and dates, each a structured filter, never a query text. The instance
            keeps these lines as long as it keeps its logs. forExport answers one bounded page. Needs ADMIN_AUDIT_VIEW
            under Admin.</description>
        <in-parameters>
            <parameter name="source"/>
            <parameter name="actorUserId"/>
            <parameter name="subject"/>
            <parameter name="correlation"/>
            <parameter name="fromDate"/>
            <parameter name="thruDate"/>
            <parameter name="pageIndex" type="Integer"/>
            <parameter name="forExport" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="accessList" type="List"/>
            <parameter name="accessListCount" type="Integer"/>
            <parameter name="accessListPageIndex" type="Integer"/>
            <parameter name="accessListPageSize" type="Integer"/>
            <parameter name="accessListPageMaxIndex" type="Integer"/>
            <parameter name="accessListPageRangeLow" type="Integer"/>
            <parameter name="accessListPageRangeHigh" type="Integer"/>
            <parameter name="truncated" type="Boolean"/>
            <parameter name="unavailable"/>
            <parameter name="sourceOptions" type="List"/>
            <parameter name="exportRows" type="Integer"/>
            <parameter name="scopeText"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-boss/service/ironstone/admin/Audit.js').execute('accessLog', context))</script></actions>
    </service>
    <service verb="get" noun="AccessLogRowFilter" allow-remote="false">
        <description>The report engine's row filter of the dataset admin-access-log (its rowFilterService), beside the
            dataset's own fixed filter of the two audit targets: a reader who administers every organization reads every
            line; any other reader the lines written under a user who works for an organization they administer (the
            line's user.id), so one organization's audit reader does not read what another's people exported; a viewer
            without ADMIN_AUDIT_VIEW under Admin, or with more accounts in scope than maxUsers (5,000), matches nothing
            (get#AccessLog says so in unavailable). The
            engine calls it with the signed-in viewer: another userId is refused.</description>
        <in-parameters>
            <parameter name="userId"/>
            <parameter name="datasetId"/>
            <parameter name="rowFilterParameters" type="Map"/>
        </in-parameters>
        <out-parameters><parameter name="filter" type="Map"/></out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-boss/service/ironstone/admin/Audit.js').execute('accessLogRowFilter', context))</script></actions>
    </service>
</services>
