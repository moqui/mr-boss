<!-- Admin's export projections (design-admin §11 Exports and DataExport; impl-admin P16; admin/Data.js): what Admin ›
    Data's Exports and DataExport show and post. The work is the framework's org.moqui.admin.DataTransferServices, which
    exports only a registered target, calls its owner as the user and leaves out a field the user may not read; these
    services call it with authorization as it is and add no field, option or right. They add BOSS's own: an owner's place
    as a route (a registration names a key, never a URL) and the wizard's form values. No group is authorized to call them
    but through the screens that do; each asks the user's own transfer capability. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="find" noun="ExportRuns" allow-remote="false">
        <description>Admin's Exports: the exports made here that the user may read and, for a holder of
            ADMIN_TRANSFER_VIEW, the deliveries of scheduled reports and business alerts as status (find#Transfers with
            direction export: never a title, a recipient, a value or content, and nothing to open), with the registered
            export targets (targetList), each with its owner's place (ownerUrl). Needs ADMIN_TRANSFER_VIEW or
            ADMIN_TRANSFER_RUN.</description>
        <in-parameters>
            <parameter name="kind"/>
            <parameter name="targetId"/>
            <parameter name="state"/>
            <parameter name="fromDate"/>
            <parameter name="thruDate"/>
            <parameter name="pageIndex" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="transferList" type="List"/>
            <parameter name="transferCount" type="Integer"/>
            <parameter name="pageIndex" type="Integer"/>
            <parameter name="pageSize" type="Integer"/>
            <parameter name="unansweredTargetList" type="List"/>
            <parameter name="stateList" type="List"/>
            <parameter name="kindList" type="List"/>
            <parameter name="targetList" type="List"/>
            <parameter name="canRun" type="Boolean"/>
            <parameter name="defaultDays" type="Integer"/>
            <parameter name="rangeDays" type="Integer"/>
            <parameter name="timeZone"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-boss/service/ironstone/admin/Data.js').execute('runs', context))</script></actions>
    </service>
    <service verb="define" noun="ExportRequest" type="interface">
        <description>A request of the export wizard: the target, the scope, the values of the target's registered options
            in their order (option1 to option3) and the names of the fields chosen (fields: a list, or names with commas).</description>
        <in-parameters>
            <parameter name="targetId"/>
            <parameter name="scopeKey"/>
            <parameter name="option1"/>
            <parameter name="option2"/>
            <parameter name="option3"/>
            <parameter name="fields" type="Object"/>
        </in-parameters>
    </service>
    <service verb="get" noun="ExportContext" allow-remote="false">
        <description>The export wizard's state: the targets exported here (targetOptions) and those exported in their
            owner's own place (elsewhereList, with ownerUrl); for the target named, as the framework's get#ExportFields
            answers it for this user, its scopes, its options with their values (slotList), the fields the user may
            choose (fieldOptions, selectedFields) and the names of those left out because the user may not read them
            (deniedFieldText); with review, the framework's preview#Export of the request (preview: the fields, the
            count) or why it was refused (previewRefusal), and an operation key for the export of that review. Needs
            ADMIN_TRANSFER_VIEW or ADMIN_TRANSFER_RUN.</description>
        <implements service="ironstone.admin.DataServices.define#ExportRequest"/>
        <in-parameters><parameter name="review" type="Boolean"/></in-parameters>
        <out-parameters>
            <parameter name="canRun" type="Boolean"/>
            <parameter name="targetOptions" type="List"/>
            <parameter name="elsewhereList" type="List"/>
            <parameter name="hasTarget" type="Boolean"/>
            <parameter name="exportTarget" type="Map"/>
            <parameter name="scopeOptions" type="List"/>
            <parameter name="slotList" type="List"/>
            <parameter name="fieldOptions" type="List"/>
            <parameter name="deniedFieldText"/>
            <parameter name="selectedFields" type="List"/>
            <parameter name="preview" type="Map"/>
            <parameter name="previewRefusal"/>
            <parameter name="operationKey"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-boss/service/ironstone/admin/Data.js').execute('context', context))</script></actions>
    </service>
    <service verb="run" noun="AdminExport" allow-remote="false" transaction-timeout="600">
        <description>The export of a wizard's request through the framework's run#Export: the file for this user
            (fileText, filename, contentType) with what was left out, or the reason it was refused. Under Admin an export
            is run with ADMIN_TRANSFER_RUN, besides what the target's registration and its owner ask. The file goes to
            the caller's response and nowhere else.</description>
        <implements service="ironstone.admin.DataServices.define#ExportRequest"/>
        <in-parameters><parameter name="operationKey"/></in-parameters>
        <out-parameters>
            <parameter name="exported" type="Boolean"/>
            <parameter name="repeated" type="Boolean"/>
            <parameter name="transferId"/>
            <parameter name="rowCount" type="Integer"/>
            <parameter name="fieldList" type="List"/>
            <parameter name="omittedFieldList" type="List"/>
            <parameter name="fileText" allow-html="any"/>
            <parameter name="filename"/>
            <parameter name="contentType"/>
            <parameter name="refused" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-boss/service/ironstone/admin/Data.js').execute('exportFile', context))</script></actions>
    </service>
</services>
