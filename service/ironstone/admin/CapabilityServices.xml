<!-- The access review of the Admin app (impl-admin P9; design-admin §16; Capabilities.js). The framework's
    org.moqui.admin.AccessServices holds the registry, the projections and every rule; this builds the review's list over
    get#GrantReview with the members of the organizations the user administers. It refuses a user without Admin and
    without ADMIN_ACCESS_VIEW; the framework service checks again. The Capabilities matrix (get#MatrixContext,
    apply#MatrixChanges) is the framework's, org.moqui.admin.AccessServices (mr-moqui plans/archive/Admin-Screens-Down.md). -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="get" noun="AccessReview" allow-remote="false">
        <description>The access and grant review as one list for print and CSV, over
            org.moqui.admin.AccessServices.get#GrantReview: for each group reviewed (those named, or an app's registered bundles) as
            of a date and time, its permission grants, its app gates with their row rules, and its members who work for an
            organization the user administers; members outside it are counted per group, never named, and sealed grants are
            left out and counted. More than 60 groups is answered as failure, the reason. Needs ADMIN_ACCESS_VIEW.</description>
        <implements service="ironstone.admin.ContextServices.define#Parameters"/>
        <in-parameters>
            <parameter name="groups"/>
            <parameter name="appName"/>
            <parameter name="asOfDate" type="Timestamp"/>
        </in-parameters>
        <out-parameters>
            <parameter name="failure"/>
            <parameter name="reviewRows" type="List"/>
            <parameter name="groupRows" type="List"/>
            <parameter name="asOfText"/>
            <parameter name="groups"/>
            <parameter name="sealedOmittedCount" type="Integer"/>
            <parameter name="outsideCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/admin/Capabilities.js"/>
            <set field="found" from="ec.resource.script(module).execute('accessReview', context)"/>
            <set field="failure" from="found.failure"/>
            <set field="reviewRows" from="found.reviewRows"/>
            <set field="groupRows" from="found.groupRows"/>
            <set field="asOfText" from="found.asOfText"/>
            <set field="groups" from="found.groups"/>
            <set field="sealedOmittedCount" from="found.sealedOmittedCount"/>
            <set field="outsideCount" from="found.outsideCount"/>
        </actions>
    </service>
</services>
