<!-- The Admin app's context (impl-admin §2, P1; design-admin §1.1, §17.2; Admin.js): the organizations the user administers, the
    capabilities from the ADMIN_* permissions and the menu areas, and the record check every Admin screen, mount and shared mount
    calls before the framework or Mantle service. A user may open Admin through an authorization of their groups on its root
    (BOSS_ADMIN, the root user group, or BOSS_ADMIN_ADMIN); the root grant opens navigation only and each read checks its own
    permission. MANTLE_USER_ORG's organizations limit what they administer; MANTLE_ACTIVE_ORG (the administrator's) leaves the
    active organization, or every one with none active. UserAccount and UserGroup carry no organization, so an identity is in
    scope through its party's organization relationships. Disabled artifact authorization widens nothing here. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="define" noun="Parameters" type="interface">
        <description>The in-parameters the Admin app services share; each service declares what it returns.</description>
        <in-parameters>
            <parameter name="appRoot" type="String"/>
        </in-parameters>
    </service>
    <service verb="get" noun="SharedContext" allow-remote="false">
        <description>Check that the user may open Admin and resolve their scope and the app's routes: capabilities (the
            ADMIN_* permissions, AgentAdmin, the areas and whether Admin › System opens), the organizations they administer and
            whether that is every one. Refuses a user without Admin (ADMIN_UNAVAILABLE), a Projects client contact and a PASS
            public account among them, and another app root (ADMIN_CONTEXT).</description>
        <implements service="ironstone.admin.ContextServices.define#Parameters"/>
        <out-parameters>
            <parameter name="capabilities" type="Map"/>
            <parameter name="organizationPartyIds" type="List"/>
            <parameter name="activeOrganizationPartyId" type="String"/>
            <parameter name="allOrganizations" type="Boolean"/>
            <parameter name="appRoot" type="String"/>
            <parameter name="sharedLinks" type="Map"/>
            <parameter name="linkBase" type="String"/>
            <parameter name="webBase" type="String"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/admin/Admin.js"/>
            <set field="shared" from="ec.resource.script(module).execute('sharedContext', context)"/>
            <set field="capabilities" from="shared.capabilities"/>
            <set field="organizationPartyIds" from="shared.organizationPartyIds"/>
            <set field="activeOrganizationPartyId" from="shared.activeOrganizationPartyId"/>
            <set field="allOrganizations" from="shared.allOrganizations"/>
            <set field="appRoot" from="shared.appRoot"/>
            <set field="sharedLinks" from="shared.sharedLinks"/>
            <set field="linkBase" from="shared.linkBase"/>
            <set field="webBase" from="shared.webBase"/>
        </actions>
    </service>
    <service verb="check" noun="Record" allow-remote="false">
        <description>A record an Admin screen or mount was given: an internal organization or a user account. Answers its kind's
            name, a label, a short detail naming only the organizations in the user's scope, those organizations, and whether the
            identity also works for an organization outside it. Refuses a record that does not exist and one outside the scope
            alike (RECORD_UNAVAILABLE): another organization, an account whose party works for none of the user's organizations.
            Refuses a user without the kind's read permission (a user account needs ADMIN_IDENTITY_VIEW) or, with a capability
            named (identityManage, accessManage, ...), without its permission (PERMISSION_DENIED).</description>
        <implements service="ironstone.admin.ContextServices.define#Parameters"/>
        <in-parameters>
            <parameter name="recordType" required="true"><description>organization, user, group or member (Admin.js
                recordKinds; a group is instance-wide and needs ADMIN_ACCESS_VIEW, a member is a user an access administrator
                reads, in the organizations they administer)</description></parameter>
            <parameter name="recordId" required="true"/>
            <parameter name="capability"/>
        </in-parameters>
        <out-parameters>
            <parameter name="recordType"/>
            <parameter name="recordId"/>
            <parameter name="kindName"/>
            <parameter name="label"/>
            <parameter name="detail"/>
            <parameter name="organizationPartyIds" type="List"/>
            <parameter name="sharedBeyondScope" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/admin/Admin.js"/>
            <set field="record" from="ec.resource.script(module).execute('checkRecord', context)"/>
            <set field="recordType" from="record.recordType"/>
            <set field="recordId" from="record.recordId"/>
            <set field="kindName" from="record.kindName"/>
            <set field="label" from="record.label"/>
            <set field="detail" from="record.detail"/>
            <set field="organizationPartyIds" from="record.organizationPartyIds"/>
            <set field="sharedBeyondScope" from="record.sharedBeyondScope"/>
        </actions>
    </service>
    <service verb="get" noun="Choices" allow-remote="false">
        <description>The options of an Admin drop-down the user may choose, searched by term, with the selected value's label:
            organizations (the internal organizations the user administers) and members (the staff accounts of those
            organizations, for an ADMIN_ACCESS_VIEW holder adding a group member). Refuses an unknown choice and a user without
            Admin.</description>
        <implements service="ironstone.admin.ContextServices.define#Parameters"/>
        <in-parameters>
            <parameter name="choice" required="true"/>
            <parameter name="term"/>
            <parameter name="selected"/>
        </in-parameters>
        <out-parameters>
            <parameter name="options" type="List"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/admin/Admin.js"/>
            <set field="found" from="ec.resource.script(module).execute('choices', context)"/>
            <set field="options" from="found.options"/>
        </actions>
    </service>
    <service verb="search" noun="Records" allow-remote="false">
        <description>The palette's Admin records: groups (P3, for an ADMIN_ACCESS_VIEW holder), opening GroupDetail; users,
            connections and jobs with their phases (design §1.2), each limited in the query to the user's scope and checked
            again. No rows for a user without Admin.</description>
        <in-parameters>
            <parameter name="text"/>
            <parameter name="limit" type="Integer"/>
            <parameter name="docTypes" type="List"/>
            <parameter name="idMatch" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="rows" type="List"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/admin/Admin.js"/>
            <set field="found" from="ec.resource.script(module).execute('search', context)"/>
            <set field="rows" from="found.rows"/>
        </actions>
    </service>
    <service verb="get" noun="AppAccess" allow-remote="false">
        <description>Which framework apps the user's own groups open (system, tools, monitor, dashboards), by each app's own
            grant: an Admin grant opens none of them. For the Monitoring and Agents landings' links. Refuses a user without
            Admin.</description>
        <implements service="ironstone.admin.ContextServices.define#Parameters"/>
        <out-parameters>
            <parameter name="apps" type="Map"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/admin/Admin.js"/>
            <set field="apps" from="ec.resource.script(module).execute('appAccess', context)"/>
        </actions>
    </service>
    <service verb="get" noun="MemberScope" allow-remote="false">
        <description>Which of a group's members (userIds) the user may change: the accounts whose party works for an
            organization the user administers (every one for the administrator), and how many are outside, counted and never
            named (design §1.1: authority over one organization's memberships does not show another's). Needs
            ADMIN_ACCESS_VIEW; refuses a user without Admin.</description>
        <implements service="ironstone.admin.ContextServices.define#Parameters"/>
        <in-parameters>
            <parameter name="userIds" type="List"/>
        </in-parameters>
        <out-parameters>
            <parameter name="inScopeUserIds" type="List"/>
            <parameter name="outsideCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/admin/Admin.js"/>
            <set field="found" from="ec.resource.script(module).execute('memberScope', context)"/>
            <set field="inScopeUserIds" from="found.inScopeUserIds"/>
            <set field="outsideCount" from="found.outsideCount"/>
        </actions>
    </service>
</services>
