<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="load" noun="AccountingDemo" authenticate="anonymous-all" allow-remote="false">
        <description>Idempotent fixed-ID finance fixtures. Only data loading or a system administrator may run it.</description>
        <out-parameters>
            <parameter name="complete" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/accounting/Demo.js"/>
            <set field="demoResult" from="ec.resource.script(module).execute('load', context)"/>
            <set field="complete" from="demoResult.complete"/>
        </actions>
    </service>
    <service verb="load" noun="PortalDemo" authenticate="anonymous-all" allow-remote="false">
        <description>Idempotent PASS Billing and Supplier demo for ORG_ZIZI_RETAIL: the site, its gateway, a pay link and
            a bill link with fixed tokens, and an invited contact of each. Only data loading or a system administrator may
            run it.</description>
        <out-parameters>
            <parameter name="complete" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/accounting/Demo.js"/>
            <set field="complete" from="ec.resource.script(module).execute('loadPortal', context).complete"/>
        </actions>
    </service>
    <service verb="load" noun="SetupDemo" transaction="ignore" authenticate="anonymous-all" allow-remote="false">
        <description>Idempotent accounting setup demo for BOSS_ACCT_NEWCO: a setup run from the chart template with its
            trial balance and one open invoice, not activated. The run commits before the open item, which is made in a
            transaction of its own. Only data loading or a system administrator may run it.</description>
        <out-parameters>
            <parameter name="complete" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/accounting/Demo.js"/>
            <set field="complete" from="ec.resource.script(module).execute('loadSetup', context).complete"/>
        </actions>
    </service>
    <service verb="load" noun="AccountingGatewayDemo" transaction="ignore" authenticate="anonymous-all" allow-remote="false">
        <description>After the primary demonstration commits, provision its reviewed gateway drafts with independent named row results.</description>
        <out-parameters>
            <parameter name="complete" type="Boolean"/>
            <parameter name="errors" type="List"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/accounting/Demo.js"/>
            <set field="demoResult" from="ec.resource.script(module).execute('loadGateway', context)"/>
            <set field="complete" from="demoResult.complete"/>
            <set field="errors" from="demoResult.errors"/>
        </actions>
    </service>
    <service verb="load" noun="AccountingGatewaySetup" transaction="force-new" allow-remote="false">
        <description>Commit the administrator-only gateway demonstration configuration and methods before independent draft creation.</description>
        <out-parameters><parameter name="complete" type="Boolean"/></out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/accounting/Demo.js"/>
            <set field="demoResult" from="ec.resource.script(module).execute('loadGatewaySetup', context)"/>
            <set field="complete" from="demoResult.complete"/>
        </actions>
    </service>
    <service verb="load" noun="AccountingGatewayDraft" transaction="force-new" allow-remote="false">
        <description>Administrator-only atomic fixed-ID demonstration draft, adopted through native payment services after its shared methods commit.</description>
        <in-parameters>
            <parameter name="paymentId" required="true"/>
            <parameter name="currencyUomId" required="true"/>
        </in-parameters>
        <out-parameters><parameter name="complete" type="Boolean"/></out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/accounting/Demo.js"/>
            <set field="demoResult" from="ec.resource.script(module).execute('loadGatewayDraft', context)"/>
            <set field="complete" from="demoResult.complete"/>
        </actions>
    </service>
</services>
