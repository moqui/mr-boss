<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="find" noun="BillExceptions" allow-remote="false">
        <description>The open holds of the organization's bills, oldest first, a page at a time: each with its bill, supplier,
            reason, who placed it and when, and a release asked for; private suppliers of other users are left out. Refuses a
            user without the payables view permission and an organization the user may not work in.</description>
        <implements service="ironstone.accounting.AccessServices.define#Parameters"/>
        <in-parameters>
            <parameter name="invoiceId" type="String"/>
            <parameter name="text" type="String"/>
            <parameter name="pageIndex" type="Integer"/>
            <parameter name="pageSize" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="exceptions" type="List"/>
            <parameter name="exceptionsCount" type="Integer"/>
            <parameter name="exceptionsPageIndex" type="Integer"/>
            <parameter name="exceptionsPageSize" type="Integer"/>
            <parameter name="exceptionsPageMaxIndex" type="Integer"/>
            <parameter name="exceptionsPageRangeLow" type="Integer"/>
            <parameter name="exceptionsPageRangeHigh" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/accounting/Payables.js"/>
            <set field="screenContext" from="ec.resource.script(module).execute('exceptions', context)"/>
            <set field="exceptions" from="screenContext.exceptions"/>
            <set field="exceptionsCount" from="screenContext.exceptionsCount"/>
            <set field="exceptionsPageIndex" from="screenContext.exceptionsPageIndex"/>
            <set field="exceptionsPageSize" from="screenContext.exceptionsPageSize"/>
            <set field="exceptionsPageMaxIndex" from="screenContext.exceptionsPageMaxIndex"/>
            <set field="exceptionsPageRangeLow" from="screenContext.exceptionsPageRangeLow"/>
            <set field="exceptionsPageRangeHigh" from="screenContext.exceptionsPageRangeHigh"/>
        </actions>
    </service>
</services>
