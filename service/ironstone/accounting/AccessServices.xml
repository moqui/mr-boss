<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="define" noun="Parameters" type="interface">
        <description>The in-parameters the Accounting app services share; each service declares what it returns.</description>
        <in-parameters>
            <parameter name="appRoot" type="String"/>
            <parameter name="organizationPartyId" type="String"/>
        </in-parameters>
    </service>
    <service verb="get" noun="SharedContext" allow-remote="false">
        <description>Check the Accounting capability and organization and resolve the app's routes. Refuses a user with no
            finance read permission, and an organization the user does not work in.</description>
        <implements service="ironstone.accounting.AccessServices.define#Parameters"/>
        <out-parameters>
            <parameter name="capabilities" type="Map"/>
            <parameter name="organizationPartyIds" type="List"/>
            <parameter name="allowedOrganizationPartyIds" type="List"/>
            <parameter name="activeOrganizationPartyId" type="String"/>
            <parameter name="organizationPartyId" type="String"/>
            <parameter name="appRoot" type="String"/>
            <parameter name="sharedLinks" type="Map"/>
            <parameter name="linkBase" type="String"/>
            <parameter name="webBase" type="String"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/accounting/Accounting.js"/>
            <set field="screenContext" from="ec.resource.script(module).execute('access', context)"/>
            <set field="capabilities" from="screenContext.capabilities"/>
            <set field="organizationPartyIds" from="screenContext.organizationPartyIds"/>
            <set field="allowedOrganizationPartyIds" from="screenContext.allowedOrganizationPartyIds"/>
            <set field="activeOrganizationPartyId" from="screenContext.activeOrganizationPartyId"/>
            <set field="organizationPartyId" from="screenContext.organizationPartyId"/>
            <set field="appRoot" from="screenContext.appRoot"/>
            <set field="sharedLinks" from="screenContext.sharedLinks"/>
            <set field="linkBase" from="screenContext.linkBase"/>
            <set field="webBase" from="screenContext.webBase"/>
        </actions>
    </service>
    <service verb="search" noun="Records" allow-remote="false">
        <description>Search the finance records the user may read, for the palette, with their Accounting destinations.</description>
        <implements service="ironstone.accounting.AccessServices.define#Parameters"/>
        <in-parameters>
            <parameter name="text" type="String"/>
            <parameter name="limit" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="rows" type="List"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/accounting/Accounting.js"/>
            <set field="screenContext" from="ec.resource.script(module).execute('search', context)"/>
            <set field="rows" from="screenContext.rows"/>
        </actions>
    </service>
    <service verb="get" noun="Choices" allow-remote="false">
        <description>The options of an Accounting drop-down that the user may choose, searched by term, with the selected
            value's label. Refuses an unknown choice.</description>
        <implements service="ironstone.accounting.AccessServices.define#Parameters"/>
        <in-parameters>
            <parameter name="choice" type="String" required="true"/>
            <parameter name="action" type="String"/>
            <parameter name="term" type="String"/>
            <parameter name="selected" type="String"/>
            <parameter name="invoiceId" type="String"/>
            <parameter name="paymentId" type="String"/>
            <parameter name="cashDirection" type="String"/>
            <parameter name="partyId" type="String"/>
            <parameter name="direction" type="String"/>
            <parameter name="currencyUomId" type="String"/>
            <parameter name="asOfDate" type="String"/>
            <parameter name="effectiveDate" type="String"/>
            <parameter name="kind" type="String"/>
            <parameter name="paymentMethodId" type="String"/>
            <parameter name="fitId" type="String"/>
        </in-parameters>
        <out-parameters>
            <parameter name="options" type="List"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/accounting/Accounting.js"/>
            <set field="screenContext" from="ec.resource.script(module).execute('choices', context)"/>
            <set field="options" from="screenContext.options"/>
        </actions>
    </service>
    <service verb="select" noun="Organization" allow-remote="false">
        <description>Make an organization the user works in the active one, or clear it. Refuses any other organization.</description>
        <implements service="ironstone.accounting.AccessServices.define#Parameters"/>
        <out-parameters>
            <parameter name="organizationPartyId" type="String"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/accounting/Accounting.js"/>
            <set field="screenContext" from="ec.resource.script(module).execute('selectOrganization', context)"/>
            <set field="organizationPartyId" from="screenContext.organizationPartyId"/>
        </actions>
    </service>
</services>
