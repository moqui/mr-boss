<!-- Maintenance's reports catalogue (impl-maintenance P17; Reports.js): for Insights' catalog and the Reports landing. The reports'
    figures are Mantle's mantle.work.MaintenanceReportServices. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="get" noun="ReportCatalogue" allow-remote="false" read-only="true">
        <description>The reports Maintenance owns that the user may read (design §8 Reports), each in Insights' catalog contract
            (entryId, ownerApp, title, description, path, url, exports): work status and PM compliance for a maintenance reader
            (MAINTENANCE_VIEW). Refuses a user who reads no maintenance work (PERMISSION_DENIED) and another app root.</description>
        <in-parameters><parameter name="appRoot"/></in-parameters>
        <out-parameters><parameter name="reports" type="List"/></out-parameters>
        <actions>
            <set field="out" from="ec.resource.script('component://mr-boss/service/ironstone/maintenance/Reports.js').execute('catalogue', context)"/>
            <set field="reports" from="out.reports"/>
        </actions>
    </service>
</services>
