<!-- Maintenance's shell contributions (impl-maintenance P3; design-maintenance §1.2): the Today source (WorkOrders.js). -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="get" noun="TodayItems" allow-remote="false">
        <description>The Maintenance today-source (get#UserTodayItems calls it): the user's open work orders (Mantle's
            find#MaintenanceWorkOrders, mine) due by thruDate, by their planned finish or else start, each opening WorkOrderDetail
            with the work order as the record and no Mark done (canUpdate false; Mantle's Today leaves managed work out of its own
            tasks). Another user's Today, and a user who reads no maintenance work, get none.</description>
        <in-parameters>
            <parameter name="userId"/>
            <parameter name="partyId"/>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="thruDate" type="Timestamp"/>
        </in-parameters>
        <out-parameters>
            <parameter name="items" type="List"/>
            <parameter name="label"/>
        </out-parameters>
        <actions>
            <set field="today" from="ec.resource.script('component://mr-boss/service/ironstone/maintenance/WorkOrders.js').execute('today', context)"/>
            <set field="items" from="today.items"/>
            <set field="label" from="today.label"/>
        </actions>
    </service>
</services>
