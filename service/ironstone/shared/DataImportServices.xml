<!-- The import wizard's projections (design-admin §11.1, DataImport; impl-admin P15, F12): what Shared/DataImport shows
    and posts, and Admin's ImportDetail reads, for any registered import target, generalized from Products' catalog
    import (shared/DataImport.js). Admin's Imports list is the framework's (org.moqui.admin.DataTransferServices.find#ImportRuns;
    mr-moqui plans/archive/Admin-Screens-Down.md A5). The work is the framework's org.moqui.admin.DataTransferServices, which dispatches by the
    target's registration and calls its owner as the user; these services call it with authorization as it is and add no
    right. The mount is the app root the wizard is opened under: a catalog app's is the catalog target only; Admin's the
    target named, for a holder of ADMIN_TRANSFER_RUN. No group is authorized to call them but through the screens that do. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="define" noun="ImportParameters" type="interface">
        <in-parameters>
            <parameter name="appRoot"/>
            <parameter name="targetId"/>
            <parameter name="operationKey"/>
            <parameter name="kindId"/>
            <parameter name="organizationPartyId"/>
            <parameter name="pageIndex" type="Integer"/>
            <parameter name="errorsOnly" type="Boolean"/>
            <parameter name="mappingAction"/>
            <parameter name="mappingRevision"/>
            <parameter name="sourceColumn"/>
            <parameter name="targetField"/>
            <parameter name="defaultValue"/>
            <parameter name="sourceValue"/>
            <parameter name="targetValue"/>
            <parameter name="removeValue" type="Boolean"/>
            <parameter name="updateMode"/>
            <parameter name="dateFormat"/>
            <parameter name="decimalSeparator"/>
            <parameter name="groupSeparator"/>
            <parameter name="clearFields" type="List"/>
            <parameter name="optionName"/>
            <parameter name="optionValue"/>
        </in-parameters>
        <out-parameters>
            <parameter name="appRoot"/>
            <parameter name="targetId"/>
            <parameter name="importMount" type="Map"/>
            <parameter name="importTarget" type="Map"/>
            <parameter name="features" type="Map"/>
            <parameter name="hasTarget" type="Boolean"/>
            <parameter name="wizardElsewhere" type="Boolean"/>
            <parameter name="ownerUrl"/>
            <parameter name="ownerPath"/>
            <parameter name="operationKey"/>
            <parameter name="kindId"/>
            <parameter name="kindDescription"/>
            <parameter name="organizationPartyId"/>
            <parameter name="organizationName"/>
            <parameter name="state"/>
            <parameter name="lastError"/>
            <parameter name="filename"/>
            <parameter name="fileHash"/>
            <parameter name="mappingRevision"/>
            <parameter name="inputFingerprint"/>
            <parameter name="updateMode"/>
            <parameter name="dateFormat"/>
            <parameter name="kindOptions" type="List"/>
            <parameter name="ownerOptions" type="List"/>
            <parameter name="headers" type="List"/>
            <parameter name="columns" type="List"/>
            <parameter name="mappingRows" type="List"/>
            <parameter name="targetOptions" type="List"/>
            <parameter name="clearOptions" type="List"/>
            <parameter name="optionRows" type="List"/>
            <parameter name="importRows" type="List"/>
            <parameter name="previewRows" type="List"/>
            <parameter name="valueMappingRows" type="List"/>
            <parameter name="defaultRows" type="List"/>
            <parameter name="clearFields" type="List"/>
            <parameter name="mapping" type="Map"/>
            <parameter name="defaults" type="Map"/>
            <parameter name="valueMappings" type="Map"/>
            <parameter name="batchOptions" type="Map"/>
            <parameter name="numberFormat" type="Map"/>
            <parameter name="uploadForm" type="Map"/>
            <parameter name="formatForm" type="Map"/>
            <parameter name="rowCount" type="Integer"/>
            <parameter name="validCount" type="Integer"/>
            <parameter name="appliedCount" type="Integer"/>
            <parameter name="errorCount" type="Integer"/>
            <parameter name="failedCount" type="Integer"/>
            <parameter name="skippedCount" type="Integer"/>
            <parameter name="shownCount" type="Integer"/>
            <parameter name="pageIndex" type="Integer"/>
            <parameter name="pageSize" type="Integer"/>
            <parameter name="maxKiB" type="Integer"/>
            <parameter name="maxRows" type="Integer"/>
            <parameter name="fieldNames"/>
            <parameter name="canStage" type="Boolean"/>
            <parameter name="hasImport" type="Boolean"/>
            <parameter name="canEdit" type="Boolean"/>
            <parameter name="purged" type="Boolean"/>
            <parameter name="stagedDate" type="Long"/>
            <parameter name="appliedDate" type="Long"/>
            <parameter name="completedDate" type="Long"/>
            <parameter name="userName"/>
            <parameter name="timeZone"/>
            <parameter name="refused" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
        </out-parameters>
    </service>
    <service verb="get" noun="ImportMount" allow-remote="false">
        <description>The mount the wizard is opened under (importMount): its target (the catalog under a catalog app,
            whatever is asked; the target named under Admin), whether the user may run an import there, and its links.
            Refuses a root that mounts no wizard and a user the root's own context refuses.</description>
        <in-parameters>
            <parameter name="appRoot"/>
            <parameter name="targetId"/>
        </in-parameters>
        <out-parameters><parameter name="importMount" type="Map"/></out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-boss/service/ironstone/shared/DataImport.js').execute('mount', context))</script></actions>
    </service>
    <service verb="get" noun="ImportContext" allow-remote="false">
        <implements service="ironstone.shared.DataImportServices.define#ImportParameters"/>
        <description>What the wizard shows for its mount's target: the target's words, bounds and fields, what its
            wizard offers, the organizations and kinds the user may choose and, for an import (operationKey), its state,
            counts, mapping rows, defaults, value mappings, batch options and a page of its rows as text.</description>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-boss/service/ironstone/shared/DataImport.js').execute('context', context))</script></actions>
    </service>
    <service verb="map" noun="Import" allow-remote="false">
        <implements service="ironstone.shared.DataImportServices.define#ImportParameters"/>
        <description>One change of the mapping form (mappingAction column, default, value, formats or option), saved
            through configure#Import at the mappingRevision the form read.</description>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-boss/service/ironstone/shared/DataImport.js').execute('mapping', context))</script></actions>
    </service>
</services>
