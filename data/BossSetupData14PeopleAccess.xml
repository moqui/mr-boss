    <moqui.security.CapabilityBundle userGroupId="BOSS_PEOPLE_ADMIN" delegablePermissionId="ADMIN_ACCESS_MANAGE" appName="People" description="People administrator" scopeDependency="organization, employment" sequenceNum="1100"/>
