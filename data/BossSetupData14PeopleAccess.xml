    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_PEOPLE_ADMIN" userPermissionId="PAYROLL_VIEW" capabilityKindEnumId="CpkSensitive"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_PEOPLE_ADMIN" userPermissionId="PAYROLL_EDIT" capabilityKindEnumId="CpkSensitive"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_PEOPLE_ADMIN" userPermissionId="PAYROLL_CONFIGURE" capabilityKindEnumId="CpkSensitive"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_PEOPLE_ADMIN" userPermissionId="PEOPLE_ALL_ORGANIZATIONS" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundle userGroupId="BOSS_PEOPLE" appName="People" description="People app users (the launcher)" scopeDependency="organization, employment" sequenceNum="1110"/>
    <moqui.security.CapabilityBundleArtifact userGroupId="BOSS_PEOPLE" artifactGroupId="BOSS_PEOPLE" description="People launcher and services" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL" entityFilterSetIds="MANTLE_USER_ORG,MANTLE_PRIVATE_CONTACT"/>
    <moqui.security.CapabilityBundle userGroupId="BOSS_PEOPLE_READ" appName="People" description="People directory reader" scopeDependency="organization, employment" sequenceNum="1120"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_PEOPLE_READ" userPermissionId="PEOPLE_DIRECTORY_VIEW" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundle userGroupId="BOSS_PEOPLE_SELF" appName="People" description="Employee self-service" scopeDependency="own party and employments" sequenceNum="1130"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_PEOPLE_SELF" userPermissionId="PEOPLE_SELF_SERVICE" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundle userGroupId="BOSS_PEOPLE_MANAGER" appName="People" description="People manager" scopeDependency="live reporting lines, assigned approval steps" sequenceNum="1140"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_PEOPLE_MANAGER" userPermissionId="PEOPLE_TEAM_VIEW" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_PEOPLE_MANAGER" userPermissionId="PEOPLE_REQUEST_APPROVE" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_PEOPLE_MANAGER" userPermissionId="PEOPLE_ROSTER_EDIT" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundle userGroupId="BOSS_PEOPLE_HR" appName="People" description="HR officer" scopeDependency="organization, employment" sequenceNum="1150"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_PEOPLE_HR" userPermissionId="PEOPLE_HR_VIEW" capabilityKindEnumId="CpkSensitive"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_PEOPLE_HR" userPermissionId="PEOPLE_HR_EDIT" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_PEOPLE_HR" userPermissionId="PEOPLE_IMPORT" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_PEOPLE_HR" userPermissionId="PEOPLE_REQUEST_APPROVE" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_PEOPLE_HR" userPermissionId="PEOPLE_ROSTER_EDIT" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundle userGroupId="BOSS_PEOPLE_RECRUIT" appName="People" description="Recruiter" scopeDependency="organization, assigned openings" sequenceNum="1160"/>
