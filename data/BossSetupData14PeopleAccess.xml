<entity-facade-xml type="seed-initial">
    <!-- People P1 (impl-people P1, F1, F2, F26, F27, F58; design-people §1.1, design-crosscut §1.4): the root user group and the
        capability groups; the administrator group BOSS_PEOPLE_ADMIN is above, with its ALWAYS on the root (F1), and keeps its payroll
        grants. Groups are not nested: a People user is in BOSS_USERS, BOSS_PEOPLE and a capability group, the administrator in
        BOSS_USERS and BOSS_PEOPLE_ADMIN. BOSS_PEOPLE_SELF gets no grant on the root: an employee's self-service routes are
        Commons' (P8). -->
    <moqui.security.UserGroup userGroupId="BOSS_PEOPLE" description="People app users (the launcher)"/>
    <moqui.security.UserGroup userGroupId="BOSS_PEOPLE_READ" description="People directory reader"/>
    <moqui.security.UserGroup userGroupId="BOSS_PEOPLE_SELF" description="Employee self-service"/>
    <moqui.security.UserGroup userGroupId="BOSS_PEOPLE_MANAGER" description="People manager"/>
    <moqui.security.UserGroup userGroupId="BOSS_PEOPLE_HR" description="HR officer"/>
    <moqui.security.UserGroup userGroupId="BOSS_PEOPLE_RECRUIT" description="Recruiter"/>
    <moqui.security.UserGroup userGroupId="BOSS_PEOPLE_PAYROLL" description="Payroll operator"/>
    <moqui.security.UserGroup userGroupId="BOSS_PEOPLE_PAYROLL_APPROVE" description="Payroll approver"/>
    <moqui.security.UserGroup userGroupId="BOSS_PEOPLE_DEVELOP" description="Learning and review administrator"/>
    <moqui.security.UserGroup userGroupId="BOSS_PEOPLE_CASE" description="Confidential case handler"/>
    <!-- the root user group's authorization on the People root and the app's services (ironstone.people: its context, choices
        and palette), beside the administrators' rows of the BOSS_PEOPLE artifact group above. The root grant opens navigation
        only; each Mantle service (mantle.humanres.PeopleServices) checks the People permissions and scope itself, and no
        mantle.humanres entity or REST path is granted (PE-01). -->
    <artifactGroups artifactGroupId="BOSS_PEOPLE" description="IronStone People App (via root screen)">
        <artifacts artifactName="ironstone\.people\..*" artifactTypeEnumId="AT_SERVICE" nameIsPattern="Y" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_PEOPLE_ROOT" userGroupId="BOSS_PEOPLE" authzTypeEnumId="AUTHZT_ALLOW"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- the Settings area (design §12), the People administrator's: denied to the root user group, as impl-commerce F45's areas;
        BOSS_PEOPLE_ADMIN and ADMIN open it through their ALWAYS on the root. A later phase that puts another group's editor
        under Settings allows that group here. -->
    <artifactGroups artifactGroupId="BOSS_PPL_SETTINGS" description="People settings">
        <artifacts artifactName="component://mr-boss/screen/People/Settings.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_PPL_SETTINGS_DENY" userGroupId="BOSS_PEOPLE" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- design §1.1's table (Mantle seeds the permissions, each granted to ADMIN, §4): the directory reader PEOPLE_DIRECTORY_VIEW;
        the employee PEOPLE_SELF_SERVICE; the manager PEOPLE_TEAM_VIEW and PEOPLE_REQUEST_APPROVE; the HR officer PEOPLE_HR_VIEW,
        PEOPLE_HR_EDIT and PEOPLE_IMPORT, People's own import permission, which its import targets name (P7, P13), and
        PEOPLE_REQUEST_APPROVE, which every People approval step needs, HR-routed ones too (the user's call, impl-people §4,
        Nov 11, 2026); the recruiter
        PEOPLE_RECRUIT_VIEW and _EDIT; the payroll operator PAYROLL_VIEW and PAYROLL_EDIT; the payroll approver PAYROLL_VIEW and
        PAYROLL_APPROVE; the learning and review administrator PEOPLE_DEVELOP_VIEW and _EDIT; the case handler PEOPLE_CASE_HANDLE;
        the People administrator PEOPLE_CONFIGURE beside its payroll grants, and PEOPLE_ALL_ORGANIZATIONS, with which Mantle's
        People scope is every internal organization (or the active one), as BOSS_COMMERCE_ADMIN's COMMERCE_ALL_ORGANIZATIONS (the
        user's call, impl-people §4, Nov 11, 2026). P14: PEOPLE_ROSTER_EDIT, saving and publishing shifts, to the manager and the HR
        officer, each in their own scope (the user's call, impl-people §4, Nov 12, 2026). P22 review: PAYROLL_CONFIGURE, changing
        payroll configuration (pay components, structures, groups and localizations) in place of PEOPLE_CONFIGURE there, to the payroll
        operator and the People administrator (the user's call, impl-people §4, Nov 12, 2026). P31: PAYROLL_VIEW is no People read by
        itself, so the payroll operator and approver hold PEOPLE_DIRECTORY_VIEW for the employees they pay (the lead's call,
        impl-people §4, Nov 13, 2026). -->
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_READ" userPermissionId="PEOPLE_DIRECTORY_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_SELF" userPermissionId="PEOPLE_SELF_SERVICE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_MANAGER" userPermissionId="PEOPLE_TEAM_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_MANAGER" userPermissionId="PEOPLE_REQUEST_APPROVE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_MANAGER" userPermissionId="PEOPLE_ROSTER_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_HR" userPermissionId="PEOPLE_HR_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_HR" userPermissionId="PEOPLE_HR_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_HR" userPermissionId="PEOPLE_IMPORT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_HR" userPermissionId="PEOPLE_REQUEST_APPROVE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_HR" userPermissionId="PEOPLE_ROSTER_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_RECRUIT" userPermissionId="PEOPLE_RECRUIT_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_RECRUIT" userPermissionId="PEOPLE_RECRUIT_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_PAYROLL" userPermissionId="PEOPLE_DIRECTORY_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_PAYROLL" userPermissionId="PAYROLL_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_PAYROLL" userPermissionId="PAYROLL_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_PAYROLL" userPermissionId="PAYROLL_CONFIGURE" fromDate="0"/>
    <!-- P28: the payroll operator imports payroll history and a processor's results (the payroll exchange), People's import permission -->
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_PAYROLL" userPermissionId="PEOPLE_IMPORT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_PAYROLL_APPROVE" userPermissionId="PEOPLE_DIRECTORY_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_PAYROLL_APPROVE" userPermissionId="PAYROLL_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_PAYROLL_APPROVE" userPermissionId="PAYROLL_APPROVE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_DEVELOP" userPermissionId="PEOPLE_DEVELOP_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_DEVELOP" userPermissionId="PEOPLE_DEVELOP_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_CASE" userPermissionId="PEOPLE_CASE_HANDLE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_ADMIN" userPermissionId="PEOPLE_CONFIGURE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_ADMIN" userPermissionId="PAYROLL_CONFIGURE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PEOPLE_ADMIN" userPermissionId="PEOPLE_ALL_ORGANIZATIONS" fromDate="0"/>
    <!-- People's capability bundles in Admin's registry (owner contract, impl-people F27; design-crosscut §1.4's rows, as the
