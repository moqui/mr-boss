    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_PEOPLE_CASE" userPermissionId="PEOPLE_CASE_HANDLE" capabilityKindEnumId="CpkSensitive"/>
    <!-- People's row in Admin's settings index and its readiness provider (owner contract, impl-people F27, F58; design-admin
        §14.2): the setup checks of each employer for the People administrator, called as the viewer, organization by
        organization. get#Readiness answers the registry's contract with no adapter, refusing an organization outside the
        viewer's scope by reason code. -->
    <moqui.server.ReadinessProvider providerKey="people.setup" version="1" ownerApp="People" title="People setup"
            healthGroupEnumId="AdmHgBusiness" scopeEnumId="AdmScOrganization"
            serviceName="mantle.humanres.PeopleServices.get#Readiness" scopeParameters="organizationPartyId"
            requiredPermission="PEOPLE_CONFIGURE" fixRoute="peopleSettings" sequenceNum="150"/>
    <moqui.server.SettingsEntry settingsKey="people.settings" version="1" ownerApp="People" title="People settings"
            description="Each employer's setup checks: departments, a manager for every employee, and payroll setup"
            settingsGroupEnumId="AdmSgApplications" scopeEnumId="AdmScOrganization" destinationRoute="peopleSettings"
            screenLocation="component://mr-boss/screen/People/Settings.xml" viewPermission="PEOPLE_CONFIGURE"
            configuredBy="People administrator" providerKey="people.setup" sequenceNum="85"/>
    <!-- The provider's service for Admin's users, as a direct call (the framework's registry calls a registered service as
        the viewer, and its own grant is not inheritable: mr-moqui plans/archive/Admin-Screens-Down.md A6): Mantle's get#Readiness
        checks PEOPLE_CONFIGURE and the employer's scope itself. Under People its screens' grant covers it. -->
    <artifactGroups artifactGroupId="BOSS_ADMIN" description="IronStone Admin App (via root screen)">
        <artifacts artifactName="mantle.humanres.PeopleServices.get#Readiness" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"/>
    </artifactGroups>
    <!-- impl-people P5: a position's activation to approve (Mantle's PeoplePositionApproval topic, 15-seed-initial/People.xml) opens
        the position under People, decided there, from People's Approvals or from the notification tray -->
    <moqui.security.user.NotificationTopic topic="PeoplePositionApproval"
            linkTemplate="/qapps/People/Staffing/PositionDetail?emplPositionId=${emplPositionId}"/>
    <!-- impl-people P5 (owner contract, design-admin §14; impl-people §4): People's lifecycle participant, the waiting People
        decisions and the approval rules that name the user, through Mantle's own services (the owned-resource contract). A
        rule is handed to a new approver who works for its employer; a waiting request follows its route and is not transferred.
        The services check PEOPLE_APPROVAL_OWNER_CHANGE for another user's; the identity operator and the administrator, who
        offboard, hold it. Openings and review steps join the same lookup with their phases: P16's review adds the draft and open
        openings the user is the recruiting owner of, handed to a new owner who works for the employer. -->
    <ironstone.admin.LifecycleParticipant participantKey="people.approvals" version="1" ownerApp="People" title="People approvals"
            description="The People approval rules that name the user to decide, handed to a new approver, the openings they own, handed to a new recruiting owner, the requests waiting for their decision, the open confidential cases they handle (by name alone; each goes back to the employer's case intake handlers when they leave), and the open reviews they review and the feedback asked of them (by the person's name; a review goes to the person's manager and the feedback is withdrawn when they leave)."
            resourceKind="approval" lookupService="mantle.humanres.PeopleApprovalServices.find#OwnedApprovals"
            transferService="mantle.humanres.PeopleApprovalServices.transfer#ApprovalOwner" resourceParameter="approvalResourceId"
            requiredPermission="PEOPLE_APPROVAL_OWNER_CHANGE" sequenceNum="70"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_ADMIN_IDENTITY" userPermissionId="PEOPLE_APPROVAL_OWNER_CHANGE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_ADMIN_ADMIN" userPermissionId="PEOPLE_APPROVAL_OWNER_CHANGE" fromDate="0"/>
    <!-- impl-people P6: an employment change to approve (Mantle's PeopleEmploymentChangeApproval topic, a transfer or a separation)
        opens the person's record under People, whose changes waiting show the route and the decision to the approver; decided there,
        from People's Approvals or from the notification tray -->
    <moqui.security.user.NotificationTopic topic="PeopleEmploymentChangeApproval"
            linkTemplate="/qapps/People/Employees/Employee360?partyId=${partyId}"/>
    <!-- impl-people P7 review (the user's call, Nov 11): a People hire's provisioning or a separation's access end waiting for an
        identity operator (Mantle's IdentityOperatorRequest topic, sent to the employer's operators) opens the operation in Admin's
        LifecycleDetail, where the operator runs its steps under Admin's delegation rules -->
    <moqui.security.user.NotificationTopic topic="IdentityOperatorRequest"
            linkTemplate="/qapps/Admin/Users/LifecycleDetail?operationId=${operationId}"/>
    <!-- impl-people P6 (design-people §4 HireEmployee and EmploymentChange, §1.4's quick create "Hire employee for HR"): the hire and
        employment change wizards are HR's: denied to the root user group, opened to the HR officers (ALWAYS, as the Products
        price areas are) and to the People administrator and ADMIN through their ALWAYS on the root. Mantle's PeopleServices check
        PEOPLE_HR_VIEW and PEOPLE_HR_EDIT and the employer again. -->
    <artifactGroups artifactGroupId="BOSS_PPL_EMPLOYMENT" description="People hire and employment change">
        <artifacts artifactName="component://mr-boss/screen/People/Employees/HireEmployee.xml" artifactTypeEnumId="AT_XML_SCREEN"
                inheritAuthz="Y"/>
        <artifacts artifactName="component://mr-boss/screen/People/Employees/EmploymentChange.xml" artifactTypeEnumId="AT_XML_SCREEN"
                inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_PPL_EMPLOYMENT_HR" userGroupId="BOSS_PEOPLE_HR" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/>
        </authz>
        <authz artifactAuthzId="BOSS_PPL_EMPLOYMENT_DENY" userGroupId="BOSS_PEOPLE" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- impl-people P7 (design-people §12 ChecklistTemplates and EmployeeImport, §4 provisioning; design-admin §4.1): HR's own
        editors, Checklists and Employee import, files under Employees/ (the user's call, Nov 11: Settings stays the People
        administrator's): denied to the root user group, opened to the HR officers (ALWAYS, as the wizards above) and to the People
        administrator and ADMIN through their ALWAYS on the root; Mantle checks PEOPLE_HR_VIEW, PEOPLE_HR_EDIT, PEOPLE_IMPORT and the
        employer again. And People's access requests to Admin's lifecycle, which the tx-commit rules of
        service/PeopleLifecycle.secas.xml call as the hire's HR officer or the approver whose decision applied a separation: any user
        may call them (as Mantle's identity services), Mantle admitting only the change's requester, an HR editor of its employer,
        the one whose decision applied it or an identity operator, with the caller's organizations as the identity scope. -->
    <artifactGroups artifactGroupId="BOSS_PPL_HR_AREA" description="People HR editors under Employees">
        <artifacts artifactName="component://mr-boss/screen/People/Employees/(ChecklistTemplates|EmployeeImport)\.xml"
                artifactTypeEnumId="AT_XML_SCREEN" nameIsPattern="Y" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_PPL_HR_AREA_HR" userGroupId="BOSS_PEOPLE_HR" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/>
        </authz>
        <authz artifactAuthzId="BOSS_PPL_HR_AREA_DENY" userGroupId="BOSS_PEOPLE" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_PPL_ACCESS_REQUEST" description="People access requests to Admin's lifecycle">
        <artifacts artifactName="ironstone\.admin\.LifecycleServices\.request#(Provisioning|AccessEnd)" artifactTypeEnumId="AT_SERVICE"
                nameIsPattern="Y" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_PPL_ACCESS_REQUEST_ALL" userGroupId="ALL_USERS" authzTypeEnumId="AUTHZT_ALLOW"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/><filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- impl-people P8 (design-people §1.1, §3 SelfService; F28): a self-service employee opens their own self-service without the
        People launcher, as every BOSS user opens Admin's settings index: a non-inheritable ALLOW on the shared self-service screen
        (one location for both mounts, People/SelfService and Commons/People/SelfService), its emergency contact transition, the
        People root's context (which answers such a user their own employments and the self-service link, and nothing else) and the
        Mantle services the screen calls, each checking PEOPLE_SELF_SERVICE and the caller's own party itself. The People root and
        every other People screen and service still refuse them (an inheritable grant here would open what is below it). -->
    <artifactGroups artifactGroupId="BOSS_PPL_SELF" description="People self-service for employees without the launcher">
        <artifacts artifactName="component://mr-boss/screen/Shared/PeopleSelfService.xml" artifactTypeEnumId="AT_XML_SCREEN"
                inheritAuthz="N"/>
        <artifacts artifactName="component://mr-boss/screen/Shared/PeopleSelfService.xml/storeEmergencyContact"
                artifactTypeEnumId="AT_XML_SCREEN_TRANS" inheritAuthz="N"/>
        <!-- P17 review (the user's call of Nov 12, 2026): My letters, the user's own issued lifecycle letters (find#MyLetters and
            get#MyLetter take the caller's own party alone) -->
        <artifacts artifactName="component://mr-boss/screen/Shared/PeopleSelfService.xml/myLetter"
                artifactTypeEnumId="AT_XML_SCREEN_TRANS" inheritAuthz="N"/>
        <artifacts artifactName="ironstone\.people\.ContextServices\.get#(SharedContext|SelfServiceContext)" artifactTypeEnumId="AT_SERVICE"
                nameIsPattern="Y" inheritAuthz="N"/>
        <artifacts artifactName="mantle\.humanres\.PeopleServices\.(get#SelfService|find#MyRequests|find#DueWork|store#EmergencyContact|find#MyLetters|get#MyLetter)"
                artifactTypeEnumId="AT_SERVICE" nameIsPattern="Y" inheritAuthz="N"/>
        <authz artifactAuthzId="BOSS_PPL_SELF_EMPLOYEE" userGroupId="BOSS_PEOPLE_SELF" authzTypeEnumId="AUTHZT_ALLOW"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- impl-people P16 review (the user's call of Nov 12, 2026; F28): an interview panel member with self-service only answers their
        scorecard from SelfService: a non-inheritable ALLOW on the shared MyInterview screen (one location for both mounts,
        People/MyInterview and Commons/People/MyInterview), its two transitions, and the Mantle services it and SelfService's My
        interviews call, each of which admits the caller's own panel alone (find#MyInterviews and get#MyInterview take no party;
        submit#Scorecard the caller's own assignment; get#ApplicationFile a file a recruiter shared with the panel). Nothing else of
        recruiting opens to them. -->
    <artifactGroups artifactGroupId="BOSS_PPL_INTERVIEW_SELF" description="People own interviews for panel members without the launcher">
        <artifacts artifactName="component://mr-boss/screen/Shared/PeopleMyInterview.xml" artifactTypeEnumId="AT_XML_SCREEN"
                inheritAuthz="N"/>
        <artifacts artifactName="component://mr-boss/screen/Shared/PeopleMyInterview.xml/submitScorecard"
                artifactTypeEnumId="AT_XML_SCREEN_TRANS" inheritAuthz="N"/>
        <artifacts artifactName="component://mr-boss/screen/Shared/PeopleMyInterview.xml/sharedFile"
                artifactTypeEnumId="AT_XML_SCREEN_TRANS" inheritAuthz="N"/>
        <artifacts artifactName="mantle\.humanres\.RecruitingServices\.(find#MyInterviews|get#MyInterview|submit#Scorecard|get#ApplicationFile)"
                artifactTypeEnumId="AT_SERVICE" nameIsPattern="Y" inheritAuthz="N"/>
        <authz artifactAuthzId="BOSS_PPL_INTERVIEW_SELF_EMPLOYEE" userGroupId="BOSS_PEOPLE_SELF" authzTypeEnumId="AUTHZT_ALLOW"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- impl-people P8 (design-people §3 MyTeam, §1.2: a section with no capability is omitted): My team is the managers': denied
        to the root user group, opened to BOSS_PEOPLE_MANAGER (ALWAYS, as the HR officers' wizards) and to the People administrator
        and ADMIN through their ALWAYS on the root. Mantle's get#Team checks PEOPLE_TEAM_VIEW and the caller's own lines again. -->
    <artifactGroups artifactGroupId="BOSS_PPL_TEAM" description="People my team">
        <artifacts artifactName="component://mr-boss/screen/People/MyTeam.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_PPL_TEAM_MANAGER" userGroupId="BOSS_PEOPLE_MANAGER" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/>
        </authz>
        <authz artifactAuthzId="BOSS_PPL_TEAM_DENY" userGroupId="BOSS_PEOPLE" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- impl-people P8: a People task assigned (Mantle's PeopleTaskAssigned topic, a checklist step or an equipment return, its title
        naming nothing private) opens the task in Commons, which every BOSS user opens and which shows a protected task to its
        assignees alone; a People user reaches its People box from there -->
    <moqui.security.user.NotificationTopic topic="PeopleTaskAssigned"
            linkTemplate="/qapps/Commons/Tasks/TaskDetail?workEffortId=${workEffortId}"/>
    <!-- impl-people P9 and P10 (design-people §1.2: a section with no capability is omitted; §6 WorkingSchedules and
        WorkingScheduleDetail, §7 HolidayCalendars; §13 MyTime, Timesheets, TimesheetDetail, TimeEntries and Rates; F17, F57). Time &
        leave (People/Time) holds P10's time screens (Projects' mounted: Timesheets, My time, Time entries and what they open), P9's
        working schedules and P9's Holidays, each part open to its own users:
        - the area and its time screens: every People user's through the root, and a self-service employee without the launcher
          opens them by this inheritable ALLOW on the area (as their own self-service); its screens and services show and change only
          the user's own weeks and those they approve (mantle.work.TimesheetServices: the week's person, its approvers by the
          organization's policy, ADMIN), so the grant opens nothing else; the rest of People stays refused to them (BOSS_PPL_TIME);
        - the working schedules: HR's and the managers' (a manager's read of the schedules their reports follow): denied to the root
          user group and to self-service, opened to BOSS_PEOPLE_HR and BOSS_PEOPLE_MANAGER (ALWAYS, as My team) and to the People
          administrator and ADMIN through their ALWAYS on the root (BOSS_PPL_SCHEDULES);
        - Holidays, HR's own editor (the user's call of Nov 11 put HR's editors out of Settings): denied to the root user group and to
          self-service, opened to the HR officers (BOSS_PPL_HOLIDAYS).
        Mantle's ScheduleServices check PEOPLE_HR_VIEW, PEOPLE_HR_EDIT, PEOPLE_TEAM_VIEW and the employer again. Payroll is the payroll
        groups' (denied to the root user group, ALWAYS for the payroll operator and approver, and the People administrator and ADMIN
        through the root's ALWAYS); Rates' services check PAYROLL_VIEW and PAYROLL_EDIT for an employee's pay rate again. -->
    <artifactGroups artifactGroupId="BOSS_PPL_TIME" description="People time and leave, for self-service employees too">
        <artifacts artifactName="component://mr-boss/screen/People/Time.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_PPL_TIME_SELF" userGroupId="BOSS_PEOPLE_SELF" authzTypeEnumId="AUTHZT_ALLOW"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_PPL_SCHEDULES" description="People working schedules">
        <!-- P14: the shift roster, its terminal twin and its print, HR's and the managers' as the working schedules -->
        <artifacts artifactName="component://mr-boss/screen/People/Time/(WorkingSchedules|WorkingScheduleDetail|ShiftRoster|ShiftRosterTui|ShiftRosterPrint)\.xml"
                artifactTypeEnumId="AT_XML_SCREEN" nameIsPattern="Y" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_PPL_SCHEDULES_HR" userGroupId="BOSS_PEOPLE_HR" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/>
        </authz>
        <authz artifactAuthzId="BOSS_PPL_SCHEDULES_MANAGER" userGroupId="BOSS_PEOPLE_MANAGER" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/>
        </authz>
        <authz artifactAuthzId="BOSS_PPL_SCHEDULES_DENY" userGroupId="BOSS_PEOPLE" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_PPL_SCHEDULES_SELF" userGroupId="BOSS_PEOPLE_SELF" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_PPL_HOLIDAYS" description="People holiday calendars">
        <artifacts artifactName="component://mr-boss/screen/People/Time/HolidayCalendars.xml" artifactTypeEnumId="AT_XML_SCREEN"
                inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_PPL_HOLIDAYS_HR" userGroupId="BOSS_PEOPLE_HR" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/>
        </authz>
        <authz artifactAuthzId="BOSS_PPL_HOLIDAYS_DENY" userGroupId="BOSS_PEOPLE" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_PPL_HOLIDAYS_SELF" userGroupId="BOSS_PEOPLE_SELF" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_PPL_PAYROLL" description="People payroll">
        <artifacts artifactName="component://mr-boss/screen/People/Payroll.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_PPL_PAYROLL_OPERATOR" userGroupId="BOSS_PEOPLE_PAYROLL" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/>
        </authz>
        <authz artifactAuthzId="BOSS_PPL_PAYROLL_APPROVER" userGroupId="BOSS_PEOPLE_PAYROLL_APPROVE" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/>
        </authz>
        <authz artifactAuthzId="BOSS_PPL_PAYROLL_DENY" userGroupId="BOSS_PEOPLE" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
</entity-facade-xml>
