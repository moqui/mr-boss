    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_PEOPLE_PAYROLL_APPROVE" userPermissionId="PAYROLL_VIEW" capabilityKindEnumId="CpkSensitive"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_PEOPLE_PAYROLL_APPROVE" userPermissionId="PAYROLL_APPROVE" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundle userGroupId="BOSS_PEOPLE_DEVELOP" appName="People" description="Learning and review administrator" scopeDependency="organization, review participation" sequenceNum="1190"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_PEOPLE_DEVELOP" userPermissionId="PEOPLE_DEVELOP_VIEW" capabilityKindEnumId="CpkView"/>
