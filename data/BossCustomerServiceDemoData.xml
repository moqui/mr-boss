<entity-facade-xml type="demo">
    <!-- Customer Service (impl-customer-service P1; design-customer-service §1): ORG_ZIZI_RETAIL is the service
        organization, with POPC_DEFAULT's store and the ZIRET_WH warehouse, serving Mantle's customers Joe Q Public
        (CustJqp) and Joe's Distributing (JoeDist), both owned by Retail. ORG_ACME's owner is the Party default, shared
        (_NA_), so it is every organization's customer (F-P1-1). The demo products are the app's own, so their stock
        changes no other product's availability: a serialized thermostat under a 12-month warranty (two serial numbers)
        and a stocked air filter, both Retail's. The orders are made by load#CustomerServiceDemo through Mantle's services
        (BossZCustomerServiceDemoData.xml, loaded after this file commits) (Mantle seeds no sales orders, F34): a
        delivered order to Joe Q Public, paid and invoiced, with one thermostat; an order awaiting pick and a packed order
        of Joe's Distributing. Ziziwork Services' customer and open order are another organization's records, which
        Retail's agents never reach. Queues, teams, cases, returns and contacts are added as the phases need them. -->
    <mantle.product.feature.ProductFeature productFeatureId="BOSS_CS_WARRANTY_12" productFeatureTypeEnumId="PftWarranty"
            description="12-month warranty" numberSpecified="12" numberUomId="TF_mon" abbrev="12M"/>
    <mantle.product.Product productId="BOSS_CS_THERMOSTAT" pseudoId="CS-THERMO" productTypeEnumId="PtAsset"
            assetTypeEnumId="AstTpInventory" assetClassEnumId="AsClsInventoryFin" productName="Service demo smart thermostat"
            ownerPartyId="ORG_ZIZI_RETAIL">
        <prices productPriceId="BOSS_CS_THERMOSTAT_LIST" pricePurposeEnumId="PppPurchase" priceTypeEnumId="PptList"
                fromDate="2026-01-01 00:00:00" minQuantity="1" price="120.00" priceUomId="USD" vendorPartyId="ORG_ZIZI_RETAIL"/>
    </mantle.product.Product>
    <mantle.product.feature.ProductFeatureAppl productId="BOSS_CS_THERMOSTAT" productFeatureId="BOSS_CS_WARRANTY_12"
            applTypeEnumId="PfatStandard" fromDate="2026-01-01 00:00:00"/>
    <mantle.product.asset.Asset assetId="BOSS_CS_THERMO_1" productId="BOSS_CS_THERMOSTAT" assetTypeEnumId="AstTpInventory"
            classEnumId="AsClsInventoryFin" serialNumber="CS-THERMO-1001" statusId="AstAvailable" facilityId="ZIRET_WH"
            ownerPartyId="ORG_ZIZI_RETAIL" acquireCost="70.00" acquireCostUomId="USD" receivedDate="2026-09-01 00:00:00">
        <mantle.product.asset.AssetDetail assetDetailId="BOSS_CS_THERMO_1" effectiveDate="2026-09-01 00:00:00"
                quantityOnHandDiff="1" availableToPromiseDiff="1"/>
    </mantle.product.asset.Asset>
    <mantle.product.asset.Asset assetId="BOSS_CS_THERMO_2" productId="BOSS_CS_THERMOSTAT" assetTypeEnumId="AstTpInventory"
            classEnumId="AsClsInventoryFin" serialNumber="CS-THERMO-1002" statusId="AstAvailable" facilityId="ZIRET_WH"
            ownerPartyId="ORG_ZIZI_RETAIL" acquireCost="70.00" acquireCostUomId="USD" receivedDate="2026-09-02 00:00:00">
        <mantle.product.asset.AssetDetail assetDetailId="BOSS_CS_THERMO_2" effectiveDate="2026-09-02 00:00:00"
                quantityOnHandDiff="1" availableToPromiseDiff="1"/>
    </mantle.product.asset.Asset>
    <mantle.product.Product productId="BOSS_CS_FILTER" pseudoId="CS-FILTER" productTypeEnumId="PtAsset"
            assetTypeEnumId="AstTpInventory" assetClassEnumId="AsClsInventoryFin" productName="Service demo air filter"
            ownerPartyId="ORG_ZIZI_RETAIL">
        <prices productPriceId="BOSS_CS_FILTER_LIST" pricePurposeEnumId="PppPurchase" priceTypeEnumId="PptList"
                fromDate="2026-01-01 00:00:00" minQuantity="1" price="15.00" priceUomId="USD" vendorPartyId="ORG_ZIZI_RETAIL"/>
    </mantle.product.Product>
    <mantle.product.asset.Asset assetId="BOSS_CS_FILTER_A" productId="BOSS_CS_FILTER" assetTypeEnumId="AstTpInventory"
            classEnumId="AsClsInventoryFin" statusId="AstAvailable" facilityId="ZIRET_WH" ownerPartyId="ORG_ZIZI_RETAIL"
            acquireCost="6.00" acquireCostUomId="USD" receivedDate="2026-09-01 00:00:00">
        <mantle.product.asset.AssetDetail assetDetailId="BOSS_CS_FILTER_A" effectiveDate="2026-09-01 00:00:00"
                quantityOnHandDiff="40" availableToPromiseDiff="40"/>
    </mantle.product.asset.Asset>
    <!-- another organization's: Ziziwork Services' customer and its open order -->
    <mantle.party.Party partyId="BOSS_CS_CUST_OTHER" pseudoId="CS-OTHER" partyTypeEnumId="PtyOrganization"
            ownerPartyId="ORG_ZIZI_SERVICES"/>
    <mantle.party.Organization partyId="BOSS_CS_CUST_OTHER" organizationName="Services Office Customer"/>
    <mantle.party.PartyRole partyId="BOSS_CS_CUST_OTHER" roleTypeId="Customer"/>
    <mantle.order.OrderHeader orderId="BOSS_CS_SO_OTHER" orderName="Services office supplies" statusId="OrderOpen"
            currencyUomId="USD" entryDate="2026-10-30 00:00:00"/>
    <mantle.order.OrderPart orderId="BOSS_CS_SO_OTHER" orderPartSeqId="01" statusId="OrderOpen"
            vendorPartyId="ORG_ZIZI_SERVICES" customerPartyId="BOSS_CS_CUST_OTHER"/>
    <mantle.order.OrderItem orderId="BOSS_CS_SO_OTHER" orderItemSeqId="01" orderPartSeqId="01" itemTypeEnumId="ItemProduct"
            productId="BOSS_CS_FILTER" itemDescription="Service demo air filter" quantity="1" unitAmount="15"/>
    <!-- P2: cases and queues. Ziziwork Retail's service: the Support team (customerservice.agent and .agentwh, with
        customerservice.manager its manager; their membership is BossYCustomerServiceCasesDemoData.xml's, after the users) works the Support queue, seen by its team and the managers; the Privacy team
        (customerservice.admin; the interim privacy cases of design §8, F-P2-2) works the restricted Privacy queue, the only
        one offering RqtPrivacy; the service policy (CwfDefault, 14-day reopen) turns the case rules on, and RqtSupport is
        service-enabled into Support. Ziziwork Services has its own queue and policy, for its agent customerservice.services, and
        service-enables no type: only a request filed into its queue is its case, so the requests Mantle's specs file as
        john.doe (its agent) for shared customers stay requests (F-P2-4).
        The cases are requests (fixed ids, in BossYCustomerServiceCasesDemoData.xml, after the users) that
        BossZCustomerServiceDemoData.xml makes cases through
        mantle.request.SupportCaseServices.ensure#CaseProfile once this file is committed (F76): Joe Q Public's two open
        cases (NewCase's duplicate warning shows them), one assigned and linked to his delivered order; Joe's Distributing's
        case, waiting for the customer; Joe's privacy request; and Services' case of its customer. -->
    <mantle.party.Party partyId="BOSS_CS_TEAM_SUPPORT" partyTypeEnumId="PtyOrganization" ownerPartyId="ORG_ZIZI_RETAIL"/>
    <mantle.party.Organization partyId="BOSS_CS_TEAM_SUPPORT" organizationName="Retail support team"/>
    <mantle.party.PartyRole partyId="BOSS_CS_TEAM_SUPPORT" roleTypeId="OrgTeam"/>
    <mantle.party.Party partyId="BOSS_CS_TEAM_PRIVACY" partyTypeEnumId="PtyOrganization" ownerPartyId="ORG_ZIZI_RETAIL"/>
    <mantle.party.Organization partyId="BOSS_CS_TEAM_PRIVACY" organizationName="Retail privacy team"/>
    <mantle.party.PartyRole partyId="BOSS_CS_TEAM_PRIVACY" roleTypeId="OrgTeam"/>
    <mantle.party.Party partyId="BOSS_CS_TEAM_SERVICES" partyTypeEnumId="PtyOrganization" ownerPartyId="ORG_ZIZI_SERVICES"/>
    <mantle.party.Organization partyId="BOSS_CS_TEAM_SERVICES" organizationName="Services support team"/>
    <mantle.party.PartyRole partyId="BOSS_CS_TEAM_SERVICES" roleTypeId="OrgTeam"/>
    <mantle.request.RequestCategory requestCategoryId="BOSS_CS_Q_SUPPORT" description="Support" ownerPartyId="ORG_ZIZI_RETAIL"/>
    <mantle.request.RequestCategory requestCategoryId="BOSS_CS_Q_PRIVACY" description="Privacy" ownerPartyId="ORG_ZIZI_RETAIL"/>
    <mantle.request.RequestCategory requestCategoryId="BOSS_CS_Q_SERVICES" description="Services support" ownerPartyId="ORG_ZIZI_SERVICES"/>
    <mantle.request.support.ServiceQueue serviceQueueId="BOSS_CS_SQ_SUPPORT" requestCategoryId="BOSS_CS_Q_SUPPORT"
            visibilityEnumId="SqvTeam" responsibleTeamPartyId="BOSS_CS_TEAM_SUPPORT" fromDate="0"/>
    <mantle.request.support.ServiceQueue serviceQueueId="BOSS_CS_SQ_PRIVACY" requestCategoryId="BOSS_CS_Q_PRIVACY"
            offeredTypeEnumIds="RqtPrivacy" visibilityEnumId="SqvRestricted" responsibleTeamPartyId="BOSS_CS_TEAM_PRIVACY" fromDate="0"/>
    <mantle.request.support.ServiceQueue serviceQueueId="BOSS_CS_SQ_SERVICES" requestCategoryId="BOSS_CS_Q_SERVICES"
            visibilityEnumId="SqvTeam" responsibleTeamPartyId="BOSS_CS_TEAM_SERVICES" fromDate="0"/>
    <mantle.request.support.ServicePolicy servicePolicyId="BOSS_CS_POLICY_RETAIL" organizationPartyId="ORG_ZIZI_RETAIL"
            defaultCategoryId="BOSS_CS_Q_SUPPORT" caseWorkflowId="CwfDefault" unknownSenderEnumId="SusReview" reopenWindowDays="14"
            resolutionRequired="Y" customerImmediateCancel="N" fromDate="0"/>
    <mantle.request.support.ServicePolicy servicePolicyId="BOSS_CS_POLICY_SERVICES" organizationPartyId="ORG_ZIZI_SERVICES"
            defaultCategoryId="BOSS_CS_Q_SERVICES" caseWorkflowId="CwfDefault" unknownSenderEnumId="SusReview" reopenWindowDays="14"
            resolutionRequired="Y" customerImmediateCancel="N" fromDate="0"/>
    <mantle.request.support.ServiceRequestType serviceRequestTypeId="BOSS_CS_ST_SUPPORT" organizationPartyId="ORG_ZIZI_RETAIL"
            requestTypeEnumId="RqtSupport" serviceEnabled="Y" customerLabel="Help with a product or order"
            defaultCategoryId="BOSS_CS_Q_SUPPORT" defaultPriority="5" publicAvailable="Y" fromDate="0"/>
    <mantle.request.support.ServiceRequestType serviceRequestTypeId="BOSS_CS_ST_PRIVACY" organizationPartyId="ORG_ZIZI_RETAIL"
            requestTypeEnumId="RqtPrivacy" serviceEnabled="Y" customerLabel="A privacy request about my data"
            defaultCategoryId="BOSS_CS_Q_PRIVACY" defaultPriority="3" publicAvailable="N" fromDate="0"/>
    <!-- P4: Ziziwork Retail's service levels (F82: Retail only). The default policy counts on the Support team's working hours
        (Monday to Friday 9:00-17:00 in Chicago, stored through store#WorkingHours by BossXCustomerServiceHoursDemoData.xml
        before the demo requests become cases, so their clocks start on them); the Privacy queue's policy is more specific (a queue condition) and
        counts around the clock, as a privacy request's deadline is in calendar days. -->
    <mantle.request.support.ServiceLevelPolicy serviceLevelPolicyId="BOSS_CS_SLA_RETAIL" organizationPartyId="ORG_ZIZI_RETAIL"
            policyName="Retail standard" holdPauses="N" maxPauseMinutes="4800" reopenEnumId="SrpNewEpisode" fromDate="0"/>
    <mantle.request.support.ServiceLevelTarget serviceLevelTargetId="BOSS_CS_SLT_RETAIL_U" serviceLevelPolicyId="BOSS_CS_SLA_RETAIL"
            priorityBandEnumId="CpbUrgent" firstResponseMinutes="60" resolutionMinutes="480" warningMinutes="15" fromDate="0"/>
    <mantle.request.support.ServiceLevelTarget serviceLevelTargetId="BOSS_CS_SLT_RETAIL_H" serviceLevelPolicyId="BOSS_CS_SLA_RETAIL"
            priorityBandEnumId="CpbHigh" firstResponseMinutes="120" resolutionMinutes="960" warningMinutes="30" fromDate="0"/>
    <mantle.request.support.ServiceLevelTarget serviceLevelTargetId="BOSS_CS_SLT_RETAIL_N" serviceLevelPolicyId="BOSS_CS_SLA_RETAIL"
            priorityBandEnumId="CpbNormal" firstResponseMinutes="240" resolutionMinutes="1440" warningMinutes="60" fromDate="0"/>
    <mantle.request.support.ServiceLevelTarget serviceLevelTargetId="BOSS_CS_SLT_RETAIL_L" serviceLevelPolicyId="BOSS_CS_SLA_RETAIL"
            priorityBandEnumId="CpbLow" firstResponseMinutes="480" resolutionMinutes="2400" warningMinutes="120" fromDate="0"/>
    <mantle.request.support.ServiceLevelPolicy serviceLevelPolicyId="BOSS_CS_SLA_PRIVACY" organizationPartyId="ORG_ZIZI_RETAIL"
            policyName="Privacy requests" requestCategoryId="BOSS_CS_Q_PRIVACY" timeZone="America/Chicago" holdPauses="N"
            reopenEnumId="SrpNewEpisode" fromDate="0"/>
    <mantle.request.support.ServiceLevelTarget serviceLevelTargetId="BOSS_CS_SLT_PRIVACY_H" serviceLevelPolicyId="BOSS_CS_SLA_PRIVACY"
            priorityBandEnumId="CpbHigh" firstResponseMinutes="1440" resolutionMinutes="43200" warningMinutes="240" fromDate="0"/>
    <mantle.request.support.ServiceLevelTarget serviceLevelTargetId="BOSS_CS_SLT_PRIVACY_N" serviceLevelPolicyId="BOSS_CS_SLA_PRIVACY"
            priorityBandEnumId="CpbNormal" firstResponseMinutes="1440" resolutionMinutes="43200" warningMinutes="240" fromDate="0"/>

    <!-- P7: Ziziwork Retail's "Defective product" case template on the Support queue (impl-customer-service P7, CS-TEMPLATES): a
        dated DbForm whose serial number shows and is required when the product is equipment (the demo thermostat), with the
        agent's internal assessment, which the customer never sees. Published from the start; the queue row takes it. -->
    <moqui.screen.form.DbForm formId="BOSS_CS_TPL_DEFECTIVE" purposeEnumId="DbfpCaseTemplate" isDated="Y" ownerPartyId="ORG_ZIZI_RETAIL"
            description="Defective product" comments="A product that does not work: what it is, its serial and when it started."/>
    <moqui.screen.form.DbFormField formId="BOSS_CS_TPL_DEFECTIVE" fieldName="productKind" title="What kind of product is it?"
            fieldTypeEnumId="DBFFT_radio" layoutSequenceNum="10" audienceEnumId="CfaCustomer" fromDate="0"/>
    <moqui.screen.form.DbFormFieldOption formId="BOSS_CS_TPL_DEFECTIVE" fieldName="productKind" sequenceNum="1" keyValue="equipment"
            text="Equipment (a thermostat or controller)" fromDate="0"/>
    <moqui.screen.form.DbFormFieldOption formId="BOSS_CS_TPL_DEFECTIVE" fieldName="productKind" sequenceNum="2" keyValue="supply"
            text="A filter or supply" fromDate="0"/>
    <moqui.screen.form.DbFormFieldOption formId="BOSS_CS_TPL_DEFECTIVE" fieldName="productKind" sequenceNum="3" keyValue="other"
            text="Something else" fromDate="0"/>
    <moqui.screen.form.DbFormField formId="BOSS_CS_TPL_DEFECTIVE" fieldName="serialNumber" title="Serial number"
            tooltip="On the label under the device" fieldTypeEnumId="DBFFT_text-line" layoutSequenceNum="20" audienceEnumId="CfaCustomer"
            fromDate="0"/>
    <moqui.screen.form.DbFormField formId="BOSS_CS_TPL_DEFECTIVE" fieldName="problemStarted" title="When did the problem start?"
            fieldTypeEnumId="DBFFT_date-time" layoutSequenceNum="30" audienceEnumId="CfaCustomer" fromDate="0"/>
    <moqui.screen.form.DbFormFieldAttribute formId="BOSS_CS_TPL_DEFECTIVE" fieldName="problemStarted" attributeName="type" value="date"/>
    <moqui.screen.form.DbFormField formId="BOSS_CS_TPL_DEFECTIVE" fieldName="agentAssessment" title="First assessment"
            tooltip="For the service team only" fieldTypeEnumId="DBFFT_text-area" layoutSequenceNum="40" audienceEnumId="CfaInternal"
            fromDate="0"/>
    <moqui.screen.form.DbFormFieldDependency formId="BOSS_CS_TPL_DEFECTIVE" dependencySeqId="00001" sourceFieldName="productKind"
            operator="equals" value="equipment" targetFieldName="serialNumber" effect="show" fromDate="0"/>
    <moqui.screen.form.DbFormFieldDependency formId="BOSS_CS_TPL_DEFECTIVE" dependencySeqId="00002" sourceFieldName="productKind"
            operator="equals" value="equipment" targetFieldName="serialNumber" effect="require" fromDate="0"/>
    <mantle.request.support.ServiceQueue serviceQueueId="BOSS_CS_SQ_SUPPORT" templateFormId="BOSS_CS_TPL_DEFECTIVE"/>

    <!-- P5 (CS-ASSIGNMENT): the Support queue's assignment rule, manual (an agent takes each case), so the demo's cases and
        other specs' cases keep who they were given; AssignmentRules shows it and its preview, and a manager turns it to round
        robin from a date. The team's user groups (its saved replies' audience, F3) are in BossYCustomerServiceCasesDemoData.xml. -->
    <mantle.request.support.ServiceAssignmentRule assignmentRuleId="BOSS_CS_RULE_SUPPORT" rootRuleId="BOSS_CS_RULE_SUPPORT"
            organizationPartyId="ORG_ZIZI_RETAIL" requestCategoryId="BOSS_CS_Q_SUPPORT" ruleName="Support: agents take cases" sequenceNum="10"
            distributionEnumId="AdManual" respectSchedule="Y" fromDate="0"/>
    <mantle.request.support.ServiceAssignmentCursor rootRuleId="BOSS_CS_RULE_SUPPORT" assignedCount="0"/>
    <!-- Customer Service P10 (F33): the filter's equivalent, stocked and priced, the substitute a short pick of the filter takes -->
    <mantle.product.Product productId="BOSS_CS_FILTER_PLUS" pseudoId="CS-FILTER-PLUS" productTypeEnumId="PtAsset"
            assetTypeEnumId="AstTpInventory" assetClassEnumId="AsClsInventoryFin" productName="Service demo air filter plus"
            ownerPartyId="ORG_ZIZI_RETAIL">
        <prices productPriceId="BOSS_CS_FILTER_PLUS_LIST" pricePurposeEnumId="PppPurchase" priceTypeEnumId="PptList"
                fromDate="2026-01-01 00:00:00" minQuantity="1" price="16.00" priceUomId="USD" vendorPartyId="ORG_ZIZI_RETAIL"/>
    </mantle.product.Product>
    <mantle.product.ProductAssoc productId="BOSS_CS_FILTER" toProductId="BOSS_CS_FILTER_PLUS"
            productAssocTypeEnumId="PatEquivalent" fromDate="2026-01-01 00:00:00"/>
    <mantle.product.asset.Asset assetId="BOSS_CS_FILTER_PLUS_A" productId="BOSS_CS_FILTER_PLUS" assetTypeEnumId="AstTpInventory"
            classEnumId="AsClsInventoryFin" statusId="AstAvailable" facilityId="ZIRET_WH" ownerPartyId="ORG_ZIZI_RETAIL"
            acquireCost="6.50" acquireCostUomId="USD" receivedDate="2026-09-01 00:00:00">
        <mantle.product.asset.AssetDetail assetDetailId="BOSS_CS_FILTER_PLUS_A" effectiveDate="2026-09-01 00:00:00"
                quantityOnHandDiff="20" availableToPromiseDiff="20"/>
    </mantle.product.asset.Asset>
    <!-- Customer Service P10 (F55): Ziziwork's sales orders (Retail's among them, which inherit the company's preference) count
        commercial changes only in their revision, so an order change proposal stays bound to the order it saw while a
        confirmation is stored or the order is held -->
    <mantle.ledger.config.PartyAcctgPreference organizationPartyId="ORG_ZIZI_CORP" salesCommercialRevisionOnly="Y"/>
    <!-- P9 (CS-RETURN-POLICY): Retail's default return policy, a year from delivery (so the demo's orders stay within it
        however old the database is), an authorization valid 14 days, the goods back to ZIRET_WH, a defect, damage or wrong
        item returned for a credit, refund or replacement, no restocking fee; and its reason rows (the customer's labels; a
        defect needs evidence). Another reason (did not want it) needs a manager's exception. Mantle's own return flows read no
        policy, so Mantle's specs are unchanged (F82). -->
    <mantle.order.return.ReturnPolicy returnPolicyId="BOSS_CS_RPOL_RETAIL" organizationPartyId="ORG_ZIZI_RETAIL"
            policyName="Retail returns" windowDays="365" windowFromEnumId="RpwDelivered" authorizationDays="14"
            selfServiceEnabled="Y" allowedReasonEnumIds="RrsnDefective,RrsnDamagedShip,RrsnMisShip"
            allowedResponseEnumIds="RrspCredit,RrspRefund,RrspReplace" proofRequired="N" destinationFacilityId="ZIRET_WH"
            receiptlessEligible="N" advanceReplacement="N" instantCredit="N"
            instructions="Pack the item with its accessories, write the RMA number on the box and attach the return label."
            fromDate="2026-01-01 00:00:00"/>
    <mantle.order.return.ReturnReasonPolicy returnReasonPolicyId="BOSS_CS_RRSN_DEFECT" organizationPartyId="ORG_ZIZI_RETAIL"
            returnReasonEnumId="RrsnDefective" customerLabel="It does not work" customerVisible="Y" evidenceRequired="Y"
            suggestedResponseEnumId="RrspReplace" inspectionRequired="Y" fromDate="2026-01-01 00:00:00"/>
    <mantle.order.return.ReturnReasonPolicy returnReasonPolicyId="BOSS_CS_RRSN_DAMAGED" organizationPartyId="ORG_ZIZI_RETAIL"
            returnReasonEnumId="RrsnDamagedShip" customerLabel="It arrived damaged" customerVisible="Y" evidenceRequired="Y"
            suggestedResponseEnumId="RrspReplace" inspectionRequired="Y" fromDate="2026-01-01 00:00:00"/>
    <!-- P11 (CS-WARRANTY): Retail's warranty claims, RqtWarranty cases in the Support queue, with their own template (a type's
        template, ServiceRequestType.templateFormId, which NewCase takes before the queue's): the serial number (empty when the
        claim comes from Customer360's Delivered items, which names the serial), what is wrong with it and how it was used,
        customer-visible, and the condition on inspection, internal. The thermostat's 12-month warranty (BOSS_CS_WARRANTY_12)
        covers the delivered order's serial from its ship date. No demo claim: the walks make their own. -->
    <moqui.screen.form.DbForm formId="BOSS_CS_TPL_WARRANTY" purposeEnumId="DbfpCaseTemplate" isDated="Y" ownerPartyId="ORG_ZIZI_RETAIL"
            description="Warranty claim" comments="A product under warranty that does not work: its serial, the fault and how it was used."/>
    <moqui.screen.form.DbFormField formId="BOSS_CS_TPL_WARRANTY" fieldName="serialNumber" title="Serial number"
            tooltip="On the label under the device" fieldTypeEnumId="DBFFT_text-line" layoutSequenceNum="10" audienceEnumId="CfaCustomer"
            fromDate="0"/>
    <moqui.screen.form.DbFormField formId="BOSS_CS_TPL_WARRANTY" fieldName="faultDetail" title="What is wrong with it?"
            fieldTypeEnumId="DBFFT_text-area" layoutSequenceNum="20" audienceEnumId="CfaCustomer" fromDate="0"/>
    <moqui.screen.form.DbFormField formId="BOSS_CS_TPL_WARRANTY" fieldName="usageCondition" title="How was it used?"
            fieldTypeEnumId="DBFFT_radio" layoutSequenceNum="30" audienceEnumId="CfaCustomer" fromDate="0"/>
    <moqui.screen.form.DbFormFieldOption formId="BOSS_CS_TPL_WARRANTY" fieldName="usageCondition" sequenceNum="1" keyValue="normal"
            text="Installed and used as the instructions say" fromDate="0"/>
    <moqui.screen.form.DbFormFieldOption formId="BOSS_CS_TPL_WARRANTY" fieldName="usageCondition" sequenceNum="2" keyValue="damaged"
            text="Dropped, wet or damaged" fromDate="0"/>
    <moqui.screen.form.DbFormFieldOption formId="BOSS_CS_TPL_WARRANTY" fieldName="usageCondition" sequenceNum="3" keyValue="modified"
            text="Repaired or changed elsewhere" fromDate="0"/>
    <moqui.screen.form.DbFormField formId="BOSS_CS_TPL_WARRANTY" fieldName="inspectionNote" title="Condition on inspection"
            tooltip="For the service team only" fieldTypeEnumId="DBFFT_text-area" layoutSequenceNum="40" audienceEnumId="CfaInternal"
            fromDate="0"/>
    <mantle.request.support.ServiceRequestType serviceRequestTypeId="BOSS_CS_ST_WARRANTY" organizationPartyId="ORG_ZIZI_RETAIL"
            requestTypeEnumId="RqtWarranty" serviceEnabled="Y" customerLabel="A warranty claim for a product I bought"
            defaultCategoryId="BOSS_CS_Q_SUPPORT" defaultPriority="4" templateFormId="BOSS_CS_TPL_WARRANTY" publicAvailable="Y"
            fromDate="0"/>
</entity-facade-xml>
