<!-- Customer Service's demo teams' members and cases (impl-customer-service P2): rows that name the demo users of
    BossUsersDemoData.xml, so they load after it; the teams, queues and policies are BossCustomerServiceDemoData.xml's. The
    requests become cases through Mantle's case rule (ensure#CaseProfile, which BossZCustomerServiceDemoData.xml runs once this
    file is committed, F76): Joe Q Public's two open cases (the thermostat one assigned to the agent, on his delivered order;
    NewCase's duplicate warning shows both), Joe's Distributing's case waiting for the customer, Joe's privacy request in the
    restricted Privacy queue, and Ziziwork Services' case of its customer. -->
<entity-facade-xml type="demo">
    <mantle.party.PartyRole partyId="BOSS_CS_AGENT" roleTypeId="Agent"/>
    <mantle.party.PartyRole partyId="BOSS_CS_AGENT_WH" roleTypeId="Agent"/>
    <mantle.party.PartyRole partyId="BOSS_CS_MANAGER" roleTypeId="Manager"/>
    <mantle.party.PartyRole partyId="BOSS_CS_ADMIN" roleTypeId="Agent"/>
    <mantle.party.PartyRole partyId="BOSS_CS_SERVICES" roleTypeId="Agent"/>
    <mantle.party.PartyRelationship partyRelationshipId="BOSS_CS_TM_AGENT" relationshipTypeEnumId="PrtServiceTeam"
            fromPartyId="BOSS_CS_AGENT" fromRoleTypeId="Agent" toPartyId="BOSS_CS_TEAM_SUPPORT" toRoleTypeId="OrgTeam" fromDate="0"/>
    <mantle.party.PartyRelationship partyRelationshipId="BOSS_CS_TM_AGENT_WH" relationshipTypeEnumId="PrtServiceTeam"
            fromPartyId="BOSS_CS_AGENT_WH" fromRoleTypeId="Agent" toPartyId="BOSS_CS_TEAM_SUPPORT" toRoleTypeId="OrgTeam" fromDate="0"/>
    <mantle.party.PartyRelationship partyRelationshipId="BOSS_CS_TM_MANAGER" relationshipTypeEnumId="PrtServiceTeam"
            fromPartyId="BOSS_CS_MANAGER" fromRoleTypeId="Manager" toPartyId="BOSS_CS_TEAM_SUPPORT" toRoleTypeId="OrgTeam" fromDate="0"/>
    <mantle.party.PartyRelationship partyRelationshipId="BOSS_CS_TM_PRIVACY" relationshipTypeEnumId="PrtServiceTeam"
            fromPartyId="BOSS_CS_ADMIN" fromRoleTypeId="Agent" toPartyId="BOSS_CS_TEAM_PRIVACY" toRoleTypeId="OrgTeam" fromDate="0"/>
    <mantle.party.PartyRelationship partyRelationshipId="BOSS_CS_TM_SERVICES" relationshipTypeEnumId="PrtServiceTeam"
            fromPartyId="BOSS_CS_SERVICES" fromRoleTypeId="Agent" toPartyId="BOSS_CS_TEAM_SERVICES" toRoleTypeId="OrgTeam" fromDate="0"/>
    <mantle.request.Request requestId="BOSS_CS_CASE_THERMO" requestName="Thermostat shows the wrong temperature"
            requestTypeEnumId="RqtSupport" requestCategoryId="BOSS_CS_Q_SUPPORT" statusId="ReqSubmitted" priority="3"
            salesChannelEnumId="ScPhone" requestDate="2026-11-02 09:30:00" requestResolutionEnumId="RrUnresolved"
            filedByPartyId="BOSS_CS_AGENT"
            description="Joe says the thermostat he received reads three degrees high since it was installed."/>
    <mantle.request.RequestParty requestId="BOSS_CS_CASE_THERMO" partyId="CustJqp" roleTypeId="Customer" fromDate="2026-11-02 09:30:00"/>
    <mantle.request.RequestParty requestId="BOSS_CS_CASE_THERMO" partyId="BOSS_CS_AGENT" roleTypeId="Assignee" fromDate="2026-11-02 09:30:00"/>
    <mantle.request.RequestParty requestId="BOSS_CS_CASE_THERMO" partyId="BOSS_CS_AGENT" roleTypeId="Reporter" fromDate="2026-11-02 09:30:00"/>
    <mantle.request.RequestRecord requestId="BOSS_CS_CASE_THERMO" recordEntityName="mantle.order.OrderHeader" recordId="BOSS_CS_SO_DELIVERED"
            linkedByUserId="BOSS_CS_AGENT" linkedDate="2026-11-02 09:31:00"/>
    <mantle.request.RequestTag requestId="BOSS_CS_CASE_THERMO" tagEnumId="RtgProduct" fromDate="2026-11-02 09:31:00"/>
    <mantle.request.Request requestId="BOSS_CS_CASE_FILTERS" requestName="When do the replacement filters ship?"
            requestTypeEnumId="RqtSupport" requestCategoryId="BOSS_CS_Q_SUPPORT" statusId="ReqSubmitted" priority="5"
            salesChannelEnumId="ScEmail" requestDate="2026-11-04 14:10:00" requestResolutionEnumId="RrUnresolved"
            filedByPartyId="CustJqp" description="Joe asks when the filters he wants to order will be in stock."/>
    <mantle.request.RequestParty requestId="BOSS_CS_CASE_FILTERS" partyId="CustJqp" roleTypeId="Customer" fromDate="2026-11-04 14:10:00"/>
    <mantle.request.RequestParty requestId="BOSS_CS_CASE_FILTERS" partyId="CustJqp" roleTypeId="Reporter" fromDate="2026-11-04 14:10:00"/>
    <mantle.request.Request requestId="BOSS_CS_CASE_PICK" requestName="Status of order awaiting pick"
            requestTypeEnumId="RqtSupport" requestCategoryId="BOSS_CS_Q_SUPPORT" statusId="ReqWaitingCustomer" priority="6"
            salesChannelEnumId="ScPhone" requestDate="2026-11-03 11:00:00" requestResolutionEnumId="RrUnresolved"
            filedByPartyId="BOSS_CS_AGENT_WH" description="Joe's Distributing asked whether the four filters can ship sooner; we asked for their dock hours."/>
    <mantle.request.RequestParty requestId="BOSS_CS_CASE_PICK" partyId="JoeDist" roleTypeId="Customer" fromDate="2026-11-03 11:00:00"/>
    <mantle.request.RequestParty requestId="BOSS_CS_CASE_PICK" partyId="BOSS_CS_AGENT_WH" roleTypeId="Assignee" fromDate="2026-11-03 11:00:00"/>
    <mantle.request.RequestRecord requestId="BOSS_CS_CASE_PICK" recordEntityName="mantle.order.OrderHeader" recordId="BOSS_CS_SO_PICK"
            linkedByUserId="BOSS_CS_AGENT_WH" linkedDate="2026-11-03 11:01:00"/>
    <mantle.request.Request requestId="BOSS_CS_CASE_PRIVACY" requestName="Please delete my account data"
            requestTypeEnumId="RqtPrivacy" requestCategoryId="BOSS_CS_Q_PRIVACY" statusId="ReqSubmitted" priority="3"
            salesChannelEnumId="ScEmail" requestDate="2026-11-04 08:00:00" requestResolutionEnumId="RrUnresolved"
            filedByPartyId="CustJqp" description="Joe asks that the data we hold on him be deleted."/>
    <mantle.request.RequestParty requestId="BOSS_CS_CASE_PRIVACY" partyId="CustJqp" roleTypeId="Customer" fromDate="2026-11-04 08:00:00"/>
    <mantle.request.Request requestId="BOSS_CS_CASE_OTHER" requestName="Office supplies invoice question"
            requestTypeEnumId="RqtSupport" requestCategoryId="BOSS_CS_Q_SERVICES" statusId="ReqSubmitted" priority="5"
            salesChannelEnumId="ScPhone" requestDate="2026-11-04 10:00:00" requestResolutionEnumId="RrUnresolved"
            filedByPartyId="BOSS_CS_SERVICES" description="The Services customer asks about its invoice."/>
    <mantle.request.RequestParty requestId="BOSS_CS_CASE_OTHER" partyId="BOSS_CS_CUST_OTHER" roleTypeId="Customer" fromDate="2026-11-04 10:00:00"/>
    <!-- P12: the knowledge author works in the Support team (so sees its cases, for CaseToArticle), and Joe's thermostat case
        has the agent's reply (an outward email, with his name, address and order to take out of an article) and an internal
        note (never put in an article) -->
    <mantle.party.PartyRole partyId="BOSS_CS_KNOWLEDGE" roleTypeId="Agent"/>
    <mantle.party.PartyRelationship partyRelationshipId="BOSS_CS_TM_KNOWLEDGE" relationshipTypeEnumId="PrtServiceTeam"
            fromPartyId="BOSS_CS_KNOWLEDGE" fromRoleTypeId="Agent" toPartyId="BOSS_CS_TEAM_SUPPORT" toRoleTypeId="OrgTeam" fromDate="0"/>
    <mantle.party.communication.CommunicationEvent communicationEventId="BOSS_CS_CE_THERMO_REPLY" communicationEventTypeId="Email"
            contactMechTypeEnumId="CmtEmailAddress" statusId="CeSent" fromPartyId="BOSS_CS_AGENT" toPartyId="CustJqp"
            entryDate="2026-11-02 10:15:00" subject="Your thermostat reading" contentType="text/html"
            body="&lt;p&gt;Hello Joe Public,&lt;/p&gt;&lt;p&gt;A new thermostat can read up to three degrees high on its first day. If it still does, open Settings, choose Calibrate and enter the temperature of a room thermometer.&lt;/p&gt;&lt;p&gt;We can also replace it under order BOSS_CS_SO_DELIVERED.&lt;/p&gt;"/>
    <mantle.request.RequestCommEvent requestId="BOSS_CS_CASE_THERMO" communicationEventId="BOSS_CS_CE_THERMO_REPLY"/>
    <mantle.party.communication.CommunicationEvent communicationEventId="BOSS_CS_CE_THERMO_NOTE" communicationEventTypeId="Comment"
            fromPartyId="BOSS_CS_AGENT" entryDate="2026-11-02 10:20:00" contentType="text/html"
            body="&lt;p&gt;Internal: this is the October batch; if calibrating does not help, replace it.&lt;/p&gt;"/>
    <mantle.request.RequestCommEvent requestId="BOSS_CS_CASE_THERMO" communicationEventId="BOSS_CS_CE_THERMO_NOTE"/>
    <!-- P5 (CS-REPLIES, D24, F3): the Support team's user group (Mantle's sync#ServiceTeamGroup, from
        BossZCustomerServiceDemoData.xml, puts its members in it) and Retail's saved replies, Comms text blocks: the team's "Need
        more details" (tag Follow up, then wait for the customer), the service-wide "Filters ship soon" (assign it to me), both
        the manager's, and the agent's personal "Thanks for your patience". -->
    <moqui.security.UserGroup userGroupId="SVT_BOSS_CS_TEAM_SUPPORT" description="Service team Retail support team" groupTypeEnumId="UgtServiceTeam"/>
    <moqui.basic.email.EmailTextBlock emailTextBlockId="BOSS_CS_REPLY_DETAILS" ownerUserId="BOSS_CS_MANAGER" userGroupId="SVT_BOSS_CS_TEAM_SUPPORT"
            title="Need more details" shortcut="details"
            bodyHtml="&lt;p&gt;Hello {{contactName}},&lt;/p&gt;&lt;p&gt;Thank you for contacting {{organizationName}} about case {{caseId}}. So we can help, please send us a photo of the display and what a room thermometer reads.&lt;/p&gt;&lt;p&gt;{{agentName}}&lt;/p&gt;"/>
    <mantle.request.support.SavedReply emailTextBlockId="BOSS_CS_REPLY_DETAILS" organizationPartyId="ORG_ZIZI_RETAIL" localeId="en"
            variableNames="contactName,organizationName,caseId,agentName" disabled="N"/>
    <mantle.request.support.SavedReplyAction savedReplyActionId="BOSS_CS_RA_DETAILS_1" emailTextBlockId="BOSS_CS_REPLY_DETAILS" sequenceNum="1"
            actionEnumId="SraAddTag" tagEnumId="RtgFollowUp"/>
    <mantle.request.support.SavedReplyAction savedReplyActionId="BOSS_CS_RA_DETAILS_2" emailTextBlockId="BOSS_CS_REPLY_DETAILS" sequenceNum="2"
            actionEnumId="SraSetStatus" statusId="ReqWaitingCustomer"/>
    <moqui.basic.email.EmailTextBlock emailTextBlockId="BOSS_CS_REPLY_FILTERS" ownerUserId="BOSS_CS_MANAGER" userGroupId="BOSS_CUSTOMER_SERVICE"
            title="Filters ship soon" shortcut="filters"
            bodyHtml="&lt;p&gt;Hello {{contactName}},&lt;/p&gt;&lt;p&gt;Replacement filters ship within two working days when they are in stock; we will write again when yours ship.&lt;/p&gt;&lt;p&gt;{{agentName}}, {{organizationName}}&lt;/p&gt;"/>
    <mantle.request.support.SavedReply emailTextBlockId="BOSS_CS_REPLY_FILTERS" organizationPartyId="ORG_ZIZI_RETAIL" localeId="en"
            variableNames="contactName,agentName,organizationName" disabled="N"/>
    <mantle.request.support.SavedReplyAction savedReplyActionId="BOSS_CS_RA_FILTERS_1" emailTextBlockId="BOSS_CS_REPLY_FILTERS" sequenceNum="1"
            actionEnumId="SraAssignSelf"/>
    <moqui.basic.email.EmailTextBlock emailTextBlockId="BOSS_CS_REPLY_PATIENCE" ownerUserId="BOSS_CS_AGENT"
            title="Thanks for your patience" shortcut="patience"
            bodyHtml="&lt;p&gt;Hello {{contactName}},&lt;/p&gt;&lt;p&gt;Thanks for your patience while we look into case {{caseId}}.&lt;/p&gt;"/>
    <mantle.request.support.SavedReply emailTextBlockId="BOSS_CS_REPLY_PATIENCE" organizationPartyId="ORG_ZIZI_RETAIL" localeId="en"
            variableNames="contactName,caseId" disabled="N"/>
</entity-facade-xml>
