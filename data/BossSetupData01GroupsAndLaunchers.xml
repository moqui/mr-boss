    <!-- Commons and Comms are opened by the BOSS users group (every internal user), not ALL_USERS. Ordinary users carry
        MANTLE_USER_ORG and private-contact filters. App administrators and framework ADMIN carry MANTLE_ACTIVE_ORG and
        private-contact filters. Every service still verifies its own owner, organization and action capability. -->
    <artifactGroups artifactGroupId="BOSS_COMMONS" description="IronStone Commons App (via root screen)">
        <artifacts artifactName="component://mr-boss/screen/Commons.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_COMMONS_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_COMMONS_USERS" userGroupId="BOSS_USERS" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_COMMONS_APPADMIN" userGroupId="BOSS_COMMONS_ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/><filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_COMMS" description="IronStone Comms App (via root screen)">
