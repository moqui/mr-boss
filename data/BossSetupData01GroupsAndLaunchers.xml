            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/><filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>

    <!-- App administrators have root access; business capabilities are still checked by domain services. Sales' root user group,
        its ironstone.sales service pattern and its areas are in data/BossSetupSalesData.xml (impl-sales P1). -->
    <artifactGroups artifactGroupId="BOSS_SALES" description="IronStone Sales App (via root screen)">
        <artifacts artifactName="component://mr-boss/screen/Sales.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_SALES_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
