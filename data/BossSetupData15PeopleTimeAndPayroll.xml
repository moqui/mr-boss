        <artifacts artifactName="mantle\.humanres\.PayrollResultServices\.(find#Payslips|get#MyPayslip|get#MyPayslipStatement)" artifactTypeEnumId="AT_SERVICE"
                nameIsPattern="Y" inheritAuthz="N"/>
        <authz artifactAuthzId="BOSS_PPL_PAYSLIP_SELF_EMPLOYEE" userGroupId="BOSS_PEOPLE_SELF" authzTypeEnumId="AUTHZT_ALLOW"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
