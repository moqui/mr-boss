    <!-- ===== Sales P3: accounts and contacts (impl-sales P3; design-sales §4) ===== -->
    <!-- MergeAccounts and its Compare (design §2: M, S): denied to the root user group, ALWAYS for the manager with the root's filter
        sets; the administrator and ADMIN open them through their ALWAYS on the root. The screens also ask the capability
        mergeAccounts (SALES_ACCOUNT_EDIT with SALES_TEAM_MANAGE or SALES_CONFIGURE), and Mantle's merge guards decide each merge
        (mantle/party/PartyMerge.js), so a custom group this deny does not reach is shown no merge Mantle refuses. Accounts,
        Contacts, Customer360 and ContactDetail are every Sales reader's, under the root's grant; no new permission. -->
    <artifactGroups artifactGroupId="BOSS_SAL_MERGE" description="Sales account merge">
        <artifacts artifactName="component://mr-boss/screen/Sales/Accounts/MergeAccounts.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <artifacts artifactName="component://mr-boss/screen/Sales/Accounts/MergeCompare.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_SAL_MERGE_DENY" userGroupId="BOSS_SALES" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_SAL_MERGE_MANAGER" userGroupId="BOSS_SALES_MANAGER" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- ===== end Sales P3 ===== -->

    <!-- ===== Sales P2: pipeline setup (impl-sales P2, F53; design-sales §9, §1.1) ===== -->
    <!-- Settings (design §9): the administrator's (SALES_CONFIGURE; through its ALWAYS on the root, as ADMIN's) and, for Teams alone,
        the manager's (SALES_TEAM_MANAGE); denied to the root user group. The screens gate each tab by permission, as the menu
        does, so a custom group given Sales in Admin, which this deny does not reach, opens only what its permissions give
        (impl-maintenance F346's lesson); Mantle's setup services check the permission and the organization again. -->
    <artifactGroups artifactGroupId="BOSS_SAL_SETTINGS" description="Sales settings">
        <artifacts artifactName="component://mr-boss/screen/Sales/Settings.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_SAL_SETTINGS_DENY" userGroupId="BOSS_SALES" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_SAL_SETTINGS_MANAGER" userGroupId="BOSS_SALES_MANAGER" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- People's PEOPLE_DIRECTORY_VIEW for the manager and the administrator (F53, the user's call of Nov 13): TeamMembers' lookup
        labels the organization's employees with their work identity (mantle.humanres.PeopleServices.find#Employees answers only a
        People reader), and a member's Employee360 link opens for them, as Maintenance's planners hold it. In their bundles. -->
    <moqui.security.UserGroupPermission userGroupId="BOSS_SALES_MANAGER" userPermissionId="PEOPLE_DIRECTORY_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_SALES_ADMIN" userPermissionId="PEOPLE_DIRECTORY_VIEW" fromDate="0"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_SALES_MANAGER" userPermissionId="PEOPLE_DIRECTORY_VIEW" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_SALES_ADMIN" userPermissionId="PEOPLE_DIRECTORY_VIEW" capabilityKindEnumId="CpkView"/>
    <!-- Sales' registrations with Admin (owner contract, impl-sales P2; design-admin §14's Sales row): the setup readiness, called
        as the viewer (Mantle's get#SalesReadiness checks SALES_CONFIGURE and the organization; every user may call it,
        mr-mantle data/SalesCrmSeedData.xml), and the settings landing. Their places are keys of Admin's mount (Admin.js
        mountRoutes: salesSettings, salesStages, salesTeams, salesLeadSources). -->
    <moqui.server.ReadinessProvider providerKey="sales.readiness" version="1" ownerApp="Sales" title="Sales setup"
            healthGroupEnumId="AdmHgBusiness" scopeEnumId="AdmScOrganization"
            serviceName="mantle.sales.SalesWorkspaceServices.get#SalesReadiness" scopeParameters="organizationPartyId"
            requiredPermission="SALES_CONFIGURE" fixRoute="salesSettings" sequenceNum="170"/>
    <moqui.server.SettingsEntry settingsKey="sales.settings" version="1" ownerApp="Sales" title="Sales settings"
            description="Pipelines and stages, sales teams, lead sources, and types and reasons" settingsGroupEnumId="AdmSgApplications"
            scopeEnumId="AdmScOrganization" destinationRoute="salesSettings"
            screenLocation="component://mr-boss/screen/Sales/Settings.xml" viewPermission="SALES_CONFIGURE"
            configuredBy="Sales administrator" providerKey="sales.readiness" sequenceNum="80"/>
    <!-- ===== end of Sales P2 ===== -->

    <!-- ===== Sales P5: Comms hooks (impl-sales P5, F64; design-sales §1.4) ===== -->
    <!-- Log call on opportunity, mounted under Comms' Calls/Call and Calls/Voicemail (screen-extend/basic-comms): denied to BOSS_USERS,
        so Comms offers it to no one else, always for the Sales root user group and the administrator. Its services
        (ironstone.sales.ContextServices get#DealOptions and log#Call) are BOSS_SALES' already, and Mantle's log#OpportunityCall
        checks SALES_OPPORTUNITY_EDIT and the deal again. Create lead needs no screen: its services are BOSS_SALES' alone, so Comms'
        create-from provider refuses it to any other user. -->
    <artifactGroups artifactGroupId="BOSS_SAL_LOG_CALL" description="Sales: log a call on a deal (Comms)">
        <artifacts artifactName="component://mr-boss/screen/Sales/Pipeline/LogCall.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_SAL_LOG_CALL_DENY" userGroupId="BOSS_USERS" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_SAL_LOG_CALL_SALES" userGroupId="BOSS_SALES" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_SAL_LOG_CALL_ADMIN" userGroupId="BOSS_SALES_ADMIN" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- ===== end of Sales P5 ===== -->

    <!-- ===== Sales P6: Home, shell, Assist and the pipeline dataset (impl-sales P6, F54, F65, F66; design-sales §3, §1.4, §12.2) ===== -->
    <!-- SALES_OWNER_CHANGE for Admin's administrator too, beside the identity operator (the user's call of Nov 13, F80), as every other
        owner change is; in its bundle -->
    <moqui.security.UserGroupPermission userGroupId="BOSS_ADMIN_ADMIN" userPermissionId="SALES_OWNER_CHANGE" fromDate="0"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_ADMIN_ADMIN" userPermissionId="SALES_OWNER_CHANGE" capabilityKindEnumId="CpkEdit"/>
    <!-- Sales' lifecycle participant (owner contract, design-admin §14; F54): the open leads and opportunities a departing user owns and
        the accounts they manage (quotes join in P7), through Mantle's own services on the owned-resource contract
        (SalesWorkspaceServices find#OwnedSalesAssignments, transfer#SalesAssignment; every user may call them, mr-mantle
        data/SalesWorkspaceData.xml), which check SALES_OWNER_CHANGE for another user's and that the new owner works for the record's
        organization. Admin's disable or removal of the user lists and moves them; People's access-end request calls no participant. -->
    <ironstone.admin.LifecycleParticipant participantKey="sales.assignments" version="1" ownerApp="Sales" title="Sales assignments"
            description="The open leads and opportunities the user owns and the accounts they manage, handed to a new owner who works for the record's organization."
            resourceKind="assignment" lookupService="mantle.sales.SalesWorkspaceServices.find#OwnedSalesAssignments"
            transferService="mantle.sales.SalesWorkspaceServices.transfer#SalesAssignment" resourceParameter="salesResourceId"
            requiredPermission="SALES_OWNER_CHANGE" sequenceNum="80"/>
    <!-- The pipeline dataset (mr-mantle report/mantle-sales-pipeline.json and data/SalesPipelineReportData.xml, F66): read by every Sales
        user, whose rows are their own sales scope (the ReportScopePolicy MantleSalesScope: the organization, then the assignment or
        team), so Home's funnel shows each viewer their own pipeline; and by the Insights groups as the other business datasets are (the
        steward updates and refreshes it). Admitted by setup as BOSS's own datasets are, operations data. -->
    <artifactGroups artifactGroupId="BOSS_SAL_DATASETS" description="Sales: the pipeline dataset">
        <artifacts artifactName="org.moqui.report.dataset.mantle-sales-pipeline" artifactTypeEnumId="AT_SERVICE"/>
        <authz artifactAuthzId="BOSS_SAL_DATASETS_SALES" userGroupId="BOSS_SALES" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_VIEW"/>
        <authz artifactAuthzId="BOSS_SAL_DATASETS_SALES_ADMIN" userGroupId="BOSS_SALES_ADMIN" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_VIEW"/>
        <authz artifactAuthzId="BOSS_SAL_DATASETS_INSIGHTS_READ" userGroupId="BOSS_INSIGHTS_READ" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_VIEW"/>
        <authz artifactAuthzId="BOSS_SAL_DATASETS_INSIGHTS_AUTHOR" userGroupId="BOSS_INSIGHTS_AUTHOR" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_VIEW"/>
        <authz artifactAuthzId="BOSS_SAL_DATASETS_INSIGHTS_DISTRIBUTE" userGroupId="BOSS_INSIGHTS_DISTRIBUTE" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_VIEW"/>
        <authz artifactAuthzId="BOSS_SAL_DATASETS_INSIGHTS_FLOW" userGroupId="BOSS_INSIGHTS_FLOW" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_VIEW"/>
        <authz artifactAuthzId="BOSS_SAL_DATASETS_INSIGHTS_DATA" userGroupId="BOSS_INSIGHTS_DATA" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <moqui.entity.document.DataDocumentUserGroup dataDocumentId="MantleSalesOpportunity" userGroupId="BOSS_SALES"/>
    <moqui.entity.document.DataDocumentUserGroup dataDocumentId="MantleSalesOpportunity" userGroupId="BOSS_SALES_ADMIN"/>
    <moqui.entity.document.DataDocumentUserGroup dataDocumentId="MantleSalesOpportunity" userGroupId="BOSS_INSIGHTS_READ"/>
    <moqui.entity.document.DataDocumentUserGroup dataDocumentId="MantleSalesOpportunity" userGroupId="BOSS_INSIGHTS_AUTHOR"/>
    <moqui.entity.document.DataDocumentUserGroup dataDocumentId="MantleSalesOpportunity" userGroupId="BOSS_INSIGHTS_DISTRIBUTE"/>
    <moqui.entity.document.DataDocumentUserGroup dataDocumentId="MantleSalesOpportunity" userGroupId="BOSS_INSIGHTS_FLOW"/>
    <moqui.entity.document.DataDocumentUserGroup dataDocumentId="MantleSalesOpportunity" userGroupId="BOSS_INSIGHTS_DATA"/>
    <moqui.report.BusinessDataset datasetId="mantle-sales-pipeline" admittedDate="2026-11-13 00:00:00" versionNumber="1"/>
    <ironstone.insights.DatasetClass datasetId="mantle-sales-pipeline" version="1" domainOwner="Sales" classEnumId="InsDcOperations"/>
    <moqui.server.ReadinessProvider providerKey="insights.dataset.mantle-sales-pipeline" version="1" ownerApp="Insights"
            title="Sales pipeline index" description="The sales pipeline dataset's admission and its index's last build"
            healthGroupEnumId="AdmHgObservability" scopeEnumId="AdmScInstance"
            serviceName="ironstone.insights.DatasetServices.check#DatasetReadiness" requiredPermission="INSIGHTS_VIEW"
            fixRoute="insightsDataset" fixId="mantle-sales-pipeline" expectedFrequencyMinutes="1440" sequenceNum="70"/>
    <moqui.server.RefreshOperation refreshKey="insights.dataset.mantle-sales-pipeline.index" version="1" ownerApp="Insights"
            title="Rebuild the sales pipeline index" serviceName="ironstone.insights.DatasetServices.refresh#DatasetIndex"
            sourceKindEnumId="AdmRsIndex" sourceName="mantle-sales-pipeline" requiredPermission="INSIGHTS_DATASET_EDIT"
            providerKey="insights.dataset.mantle-sales-pipeline"/>
    <!-- The pipeline exports Sales makes in its own lists (CSV and XLSX of the filtered result, the columns shown, design §16), listed in
        Admin's Exports as wizard export targets with their owner route (Admin.js mountRoutes salesOpportunities, salesLeads), nothing
        dispatched, as Projects' work item list is; the import's owner route is salesOpportunityImport (mr-mantle
        data/SalesWorkspaceData.xml's target `opportunities`). -->
    <moqui.server.TransferTarget targetId="salesOpportunityList" direction="export" targetMode="wizard" title="Sales opportunities"
            description="The opportunities of a list as CSV or XLSX, from Opportunities in Sales"
            ownerApp="Sales" targetVersion="1" ownerRoute="salesOpportunities" sequenceNum="69"/>
    <moqui.server.TransferTarget targetId="salesLeadList" direction="export" targetMode="wizard" title="Sales leads"
            description="The leads of a list as CSV or XLSX, from Leads in Sales"
            ownerApp="Sales" targetVersion="1" ownerRoute="salesLeads" sequenceNum="70"/>
    <!-- Assist's tools (design §1.4 CX-ASSIST; Admin's rows, BossSetupData AgentToolExposure): find#Opportunities for the Assistant and
        MCP (a read, the user's own sales scope), and create#, move# and close#Opportunity for the Assistant alone, each a write the
        user approves before it runs (AgclWrite), none on MCP. A tool runs as the user outside Sales' screens, so the Sales groups are
        granted these four services (each checks its permission, the organization and the assignment itself); Mantle's facts say which
        organization is active, and each tool still takes and checks its organization (F65). -->
    <artifactGroups artifactGroupId="BOSS_SAL_ASSIST_TOOLS" description="Sales: the opportunity services Assist's tools call">
        <artifacts artifactName="mantle\.sales\.OpportunityServices\.(find|create|move|close)#Opportunit(y|ies)" artifactTypeEnumId="AT_SERVICE"
                nameIsPattern="Y" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_SAL_ASSIST_TOOLS_SALES" userGroupId="BOSS_SALES" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_SAL_ASSIST_TOOLS_ADMIN" userGroupId="BOSS_SALES_ADMIN" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <moqui.agent.AgentToolExposure toolName="sales_find_opportunities" serviceName="mantle.sales.OpportunityServices.find#Opportunities"
            title="Sales leads and opportunities"
            description="find#Opportunities: the leads (typeEnumId SotLead) and opportunities (SotOpportunity) the user may see in Sales (their own and their teams', or their organizations' for a manager), narrowed by text, organizationPartyId, mine (Y), ownerPartyId, teamPartyId, salesPipelineId, opportunityStageId, statusId (SalesOppOpen, SalesOppWon, SalesOppLost or closed), closeFrom and closeThru (yyyy-MM-dd), accountPartyId and dataSourceId, paged; each with its account, stage, amount, probability, expected close, owner, team and next activity, and the totals by currency."
            classificationEnumId="AgclRead" exposeAssistant="Y" exposeMcp="Y" previewMode="none" lockVersion="1"/>
    <moqui.agent.AgentToolExposure toolName="sales_create_opportunity" serviceName="mantle.sales.OpportunityServices.create#Opportunity"
            title="New lead or opportunity"
            description="create#Opportunity: a lead (typeEnumId SotLead: no account or stage needed) or an opportunity (SotOpportunity, the default) of an organization of the user's sales scope (organizationPartyId; ask which when none is active), with its name, account, contact, pipeline and stage, owner or team, amount and currency and expected close. The user approves it first."
            classificationEnumId="AgclWrite" exposeAssistant="Y" exposeMcp="N" previewMode="none" lockVersion="1"/>
    <moqui.agent.AgentToolExposure toolName="sales_move_opportunity" serviceName="mantle.sales.OpportunityServices.move#Opportunity"
            title="Move an opportunity to a stage"
            description="move#Opportunity: an open deal to a current stage of its pipeline (opportunityStageId), at the revision read with find#Opportunities (expectedRevision); a stage move is not a closure. The user approves it first."
            classificationEnumId="AgclWrite" exposeAssistant="Y" exposeMcp="N" previewMode="none" lockVersion="1"/>
    <moqui.agent.AgentToolExposure toolName="sales_close_opportunity" serviceName="mantle.sales.OpportunityServices.close#Opportunity"
            title="Close a lead or opportunity"
            description="close#Opportunity: an open deal closed Won or Lost (Lost needs a current lost reason), at the revision read (expectedRevision); a lead closed Lost is disqualified. The user approves it first."
            classificationEnumId="AgclWrite" exposeAssistant="Y" exposeMcp="N" previewMode="none" lockVersion="1"/>
    <!-- ===== end of Sales P6 ===== -->
</entity-facade-xml>
