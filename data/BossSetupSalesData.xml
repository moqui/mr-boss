<entity-facade-xml type="seed-initial">
    <!-- Sales' setup (impl-sales P1 onward), kept apart from BossSetupData.xml as Maintenance's is (impl-sales F55), so that its
        appends and Marketing's do not meet at the end of one file; named to load after BossSetupData (the administrator group
        BOSS_SALES_ADMIN, its and ADMIN's ALWAYS on the root in the BOSS_SALES artifact group, the BOSS_USERS group and the
        identity group BOSS_ADMIN_IDENTITY are there) and after mr-mantle's MantleSetupData (the SALES_* permissions). The client
        deny pattern rows that name `sales` stay in BossSetupData beside the other apps'. -->
    <!-- Sales P1 (impl-sales P1, F1, F43, F55; design-sales §1.1, design-crosscut §1.4): the root user group and the capability
        groups; the administrator group BOSS_SALES_ADMIN is in BossSetupData, with its ALWAYS on the root (F1). Groups are not
        nested: a Sales user is in BOSS_USERS, BOSS_SALES and a capability group, the administrator in BOSS_USERS and
        BOSS_SALES_ADMIN. -->
    <moqui.security.UserGroup userGroupId="BOSS_SALES" description="Sales app users (the launcher)"/>
    <moqui.security.UserGroup userGroupId="BOSS_SALES_REP" description="Sales representative"/>
    <moqui.security.UserGroup userGroupId="BOSS_SALES_MANAGER" description="Sales manager"/>
    <moqui.security.UserGroup userGroupId="BOSS_SALES_APPROVE" description="Sales approver"/>
    <moqui.security.UserGroup userGroupId="BOSS_SALES_CHANGE" description="Commercial change operator"/>
    <moqui.security.UserGroup userGroupId="BOSS_SALES_AGREEMENT" description="Sales agreement keeper"/>
    <moqui.security.UserGroup userGroupId="BOSS_SALES_READ" description="Sales reader"/>
    <!-- the root user group's authorization on the Sales root and the app's services (ironstone.sales: its context, record check,
        choices and palette), beside the administrators' rows of the BOSS_SALES artifact group in BossSetupData. The root grant opens
        navigation only; each Mantle sales service checks the SALES_* permissions and the organization itself
        (mantle/sales/SalesAccess.js), and no raw entity write or /mantle REST path of an opportunity, order or agreement is
        granted (impl-sales §2). -->
    <artifactGroups artifactGroupId="BOSS_SALES" description="IronStone Sales App (via root screen)">
        <artifacts artifactName="ironstone\.sales\..*" artifactTypeEnumId="AT_SERVICE" nameIsPattern="Y" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_SALES_ROOT" userGroupId="BOSS_SALES" authzTypeEnumId="AUTHZT_ALLOW"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- Sales areas for their capability groups only (impl-sales §2, P1; impl-commerce F45's pattern): each denies the root user
        group BOSS_SALES and allows its groups, with the root's filter sets; the administrator and ADMIN open every area through
        their ALWAYS on the root. The phase that builds an area adds its group here (Settings P2, below; Approvals P9, Changes
        P14, Agreements P15). P1: Reports (design §8), the manager's and the reader's, who hold SALES_REPORT_VIEW; the root's menu
        shows it to a holder of that permission only, so a custom group given Sales in Admin, which this deny does not reach, is
        shown no report area its services refuse (impl-maintenance F346's lesson). -->
    <artifactGroups artifactGroupId="BOSS_SAL_REPORTS" description="Sales reports">
        <artifacts artifactName="component://mr-boss/screen/Sales/Reports.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_SAL_REPORTS_DENY" userGroupId="BOSS_SALES" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_SAL_REPORTS_MANAGER" userGroupId="BOSS_SALES_MANAGER" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_SAL_REPORTS_READ" userGroupId="BOSS_SALES_READ" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- design §1.1's table (Mantle seeds the permissions, each granted to ADMIN, data/MantleSetupData.xml): the root user group
        SALES_VIEW; the representative the opportunity, account, quote, send and order edits; the manager those with
        SALES_TEAM_VIEW, SALES_TEAM_MANAGE, SALES_FORECAST_EDIT, SALES_REPORT_VIEW, SALES_CUSTOMER_INVITE and SALES_IMPORT (the
        opportunity import, §4); the approver SALES_ORDER_APPROVE; the agreement keeper SALES_AGREEMENT_EDIT and
        SALES_RECURRENCE_MANAGE; the reader SALES_VIEW, SALES_TEAM_VIEW and SALES_REPORT_VIEW; the administrator SALES_CONFIGURE
        with the views and edits of the manager and the agreement keeper. The four a built Mantle service already checks are
        granted by the phase that builds their Sales screens (F43, §4): SALES_APPROVE to the approver in P9, ORDER_APPROVE in P11,
        SALES_ORDER_CHANGE and ORDER_CHANGE_HOLD_RELEASE to the commercial change operator in P14, so the operator holds only the
        root group's view until then. No Sales group holds an approval and the administrator neither, nor a price, cost, credit,
