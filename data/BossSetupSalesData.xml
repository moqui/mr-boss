    <!-- ===== Sales P3: accounts and contacts (impl-sales P3; design-sales §4) ===== -->
    <!-- MergeAccounts and its Compare (design §2: M, S): denied to the root user group, ALWAYS for the manager with the root's filter
        sets; the administrator and ADMIN open them through their ALWAYS on the root. The screens also ask the capability
        mergeAccounts (SALES_ACCOUNT_EDIT with SALES_TEAM_MANAGE or SALES_CONFIGURE), and Mantle's merge guards decide each merge
        (mantle/party/PartyMerge.js), so a custom group this deny does not reach is shown no merge Mantle refuses. Accounts,
        Contacts, Customer360 and ContactDetail are every Sales reader's, under the root's grant; no new permission. -->
    <artifactGroups artifactGroupId="BOSS_SAL_MERGE" description="Sales account merge">
        <artifacts artifactName="component://mr-boss/screen/Sales/Accounts/MergeAccounts.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <artifacts artifactName="component://mr-boss/screen/Sales/Accounts/MergeCompare.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_SAL_MERGE_DENY" userGroupId="BOSS_SALES" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_SAL_MERGE_MANAGER" userGroupId="BOSS_SALES_MANAGER" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- ===== end Sales P3 ===== -->

    <!-- ===== Sales P2: pipeline setup (impl-sales P2, F53; design-sales §9, §1.1) ===== -->
    <!-- Settings (design §9): the administrator's (SALES_CONFIGURE; through its ALWAYS on the root, as ADMIN's) and, for Teams alone,
        the manager's (SALES_TEAM_MANAGE); denied to the root user group. The screens gate each tab by permission, as the menu
        does, so a custom group given Sales in Admin, which this deny does not reach, opens only what its permissions give
        (impl-maintenance F346's lesson); Mantle's setup services check the permission and the organization again. -->
    <artifactGroups artifactGroupId="BOSS_SAL_SETTINGS" description="Sales settings">
        <artifacts artifactName="component://mr-boss/screen/Sales/Settings.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_SAL_SETTINGS_DENY" userGroupId="BOSS_SALES" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_SAL_SETTINGS_MANAGER" userGroupId="BOSS_SALES_MANAGER" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- People's PEOPLE_DIRECTORY_VIEW for the manager and the administrator (F53, the user's call of Nov 13): TeamMembers' lookup
        labels the organization's employees with their work identity (mantle.humanres.PeopleServices.find#Employees answers only a
        People reader), and a member's Employee360 link opens for them, as Maintenance's planners hold it. In their bundles. -->
    <moqui.security.UserGroupPermission userGroupId="BOSS_SALES_MANAGER" userPermissionId="PEOPLE_DIRECTORY_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_SALES_ADMIN" userPermissionId="PEOPLE_DIRECTORY_VIEW" fromDate="0"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_SALES_MANAGER" userPermissionId="PEOPLE_DIRECTORY_VIEW" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_SALES_ADMIN" userPermissionId="PEOPLE_DIRECTORY_VIEW" capabilityKindEnumId="CpkView"/>
    <!-- Sales' registrations with Admin (owner contract, impl-sales P2; design-admin §14's Sales row): the setup readiness, called
        as the viewer (Mantle's get#SalesReadiness checks SALES_CONFIGURE and the organization; every user may call it,
        mr-mantle data/SalesCrmSeedData.xml), and the settings landing. Their places are keys of Admin's mount (Admin.js
        mountRoutes: salesSettings, salesStages, salesTeams, salesLeadSources). -->
    <moqui.server.ReadinessProvider providerKey="sales.readiness" version="1" ownerApp="Sales" title="Sales setup"
            healthGroupEnumId="AdmHgBusiness" scopeEnumId="AdmScOrganization"
            serviceName="mantle.sales.SalesWorkspaceServices.get#SalesReadiness" scopeParameters="organizationPartyId"
            requiredPermission="SALES_CONFIGURE" fixRoute="salesSettings" sequenceNum="170"/>
    <moqui.server.SettingsEntry settingsKey="sales.settings" version="1" ownerApp="Sales" title="Sales settings"
            description="Pipelines and stages, sales teams, lead sources, and types and reasons" settingsGroupEnumId="AdmSgApplications"
            scopeEnumId="AdmScOrganization" destinationRoute="salesSettings"
            screenLocation="component://mr-boss/screen/Sales/Settings.xml" viewPermission="SALES_CONFIGURE"
            configuredBy="Sales administrator" providerKey="sales.readiness" sequenceNum="80"/>
    <!-- ===== end of Sales P2 ===== -->

    <!-- ===== Sales P5: Comms hooks (impl-sales P5, F64; design-sales §1.4) ===== -->
    <!-- Log call on opportunity, mounted under Comms' Calls/Call and Calls/Voicemail (screen-extend/basic-comms): denied to BOSS_USERS,
        so Comms offers it to no one else, always for the Sales root user group and the administrator. Its services
        (ironstone.sales.ContextServices get#DealOptions and log#Call) are BOSS_SALES' already, and Mantle's log#OpportunityCall
        checks SALES_OPPORTUNITY_EDIT and the deal again. Create lead needs no screen: its services are BOSS_SALES' alone, so Comms'
        create-from provider refuses it to any other user. -->
    <artifactGroups artifactGroupId="BOSS_SAL_LOG_CALL" description="Sales: log a call on a deal (Comms)">
        <artifacts artifactName="component://mr-boss/screen/Sales/Pipeline/LogCall.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_SAL_LOG_CALL_DENY" userGroupId="BOSS_USERS" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_SAL_LOG_CALL_SALES" userGroupId="BOSS_SALES" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_SAL_LOG_CALL_ADMIN" userGroupId="BOSS_SALES_ADMIN" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- ===== end of Sales P5 ===== -->
</entity-facade-xml>
