<entity-facade-xml type="seed-initial">
    <!-- Insights P7 (impl-insights P7; design-insights §7.1, §7.3, §1.1; INS-06, INS-11): scheduled delivery and digests.
        The copied ScheduledReports (BOSS_INS_LEGACY, impl-insights F20) is replaced by Insights' own list, every Insights user's to
        open (Received is every reader's): the group's last pattern row is reloaded as a plain name, which no screen location
        equals, so it denies nothing (as F65's rows), on a fresh load and an existing instance alike. No screen grant is added:
        the root's ALLOW opens Scheduled reports and Management digest. Scheduled reports' three screens are the framework's
        Dashboards screens, mounted by location (mr-moqui plans/archive/Admin-Screens-Down.md, Track I): no row names them or a
        transition of theirs, each transition reaches the report engine's operations as the viewer, and those stay denied
        (BOSS_INS_REPORT_ENGINE) but for the grants below, which are therefore who may schedule, deliver to others and read
        deliveries. Management digest's transitions reach ironstone.insights DeliveryServices, which checks the INSIGHTS_*
        permissions itself. -->
    <artifactGroups artifactGroupId="BOSS_INS_LEGACY">
        <artifacts artifactName="component://mr-boss/screen/Insights/ScheduledReports\.xml"
                artifactTypeEnumId="AT_XML_SCREEN" nameIsPattern="N" inheritAuthz="Y"/>
    </artifactGroups>
    <!-- Personal scheduling is every reading group's (design §1.1: INSIGHTS_SCHEDULE added to the reader's grants); the
        administrator, who reads no business data, schedules nothing. Distribution stays the distributor's. -->
    <moqui.security.UserGroupPermission userGroupId="BOSS_INSIGHTS_READ" userPermissionId="INSIGHTS_SCHEDULE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_INSIGHTS_AUTHOR" userPermissionId="INSIGHTS_SCHEDULE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_INSIGHTS_DATA" userPermissionId="INSIGHTS_SCHEDULE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_INSIGHTS_FLOW" userPermissionId="INSIGHTS_SCHEDULE" fromDate="0"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_INSIGHTS_READ" userPermissionId="INSIGHTS_SCHEDULE" capabilityKindEnumId="CpkExport"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_INSIGHTS_AUTHOR" userPermissionId="INSIGHTS_SCHEDULE" capabilityKindEnumId="CpkExport"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_INSIGHTS_DATA" userPermissionId="INSIGHTS_SCHEDULE" capabilityKindEnumId="CpkExport"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_INSIGHTS_FLOW" userPermissionId="INSIGHTS_SCHEDULE" capabilityKindEnumId="CpkExport"/>
    <!-- Scheduling for oneself, the five reading groups': the engine's store#Schedule (which sets the mode and checks every
        recipient; a recipient other than the owner also needs the group delivery artifact below), the owner's list, pause,
        Send now, retry and reconciliation. P1's BOSS_INS_REPORT_SCHEDULE keeps the distributor's create#Schedule (owner mode),
        which no Insights screen calls; a schedule it makes over a business dataset is held to the same recipient check at
        each run (mr-moqui crates/moqui-report/src/delivery.rs). And what the framework's schedule screens read and write
        beside the engine's own: the screen schedules a user set up for themselves (the copied scheduled finds, listed under
        Mine and changed in their timing: find#ScreenSchedules, store#ScreenSchedule, each the caller's own rows alone), and
        find#ReportRecipients, which the list asks at every render and which answers an account or a group only to a caller
        who holds the group delivery artifact below (the distributor), and then only Insights' readers (the root's
        reportPolicy names INSIGHTS_VIEW). -->
    <artifactGroups artifactGroupId="BOSS_INS_REPORT_OWN" description="Insights: scheduling reports for oneself">
        <artifacts artifactName="org.moqui.report.ReportServices.store#Schedule" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.list#Schedules" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.pause#Schedule" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.send#Report" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.retry#ReportRecipients" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.reconcile#ReportRecipient" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.find#ScreenSchedules" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.store#ScreenSchedule" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.find#ReportRecipients" artifactTypeEnumId="AT_SERVICE"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_OWN_READ" userGroupId="BOSS_INSIGHTS_READ"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_OWN_AUTHOR" userGroupId="BOSS_INSIGHTS_AUTHOR"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_OWN_DATA" userGroupId="BOSS_INSIGHTS_DATA"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_OWN_DISTRIBUTE" userGroupId="BOSS_INSIGHTS_DISTRIBUTE"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_OWN_FLOW" userGroupId="BOSS_INSIGHTS_FLOW"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- Reading deliveries: one's own occurrences and received deliveries, and one's own report rendered again as oneself; the
        engine answers a recipient their own delivery alone. The administrator reads a delivery to them as anyone does. -->
    <artifactGroups artifactGroupId="BOSS_INS_REPORT_DELIVERY" description="Insights: reading report deliveries">
        <artifacts artifactName="org.moqui.report.ReportServices.find#ReportOccurrences" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.get#ReportOccurrence" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.get#RecipientReport" artifactTypeEnumId="AT_SERVICE"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_DELIVERY_READ" userGroupId="BOSS_INSIGHTS_READ"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_DELIVERY_AUTHOR" userGroupId="BOSS_INSIGHTS_AUTHOR"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_DELIVERY_DATA" userGroupId="BOSS_INSIGHTS_DATA"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_DELIVERY_DISTRIBUTE" userGroupId="BOSS_INSIGHTS_DISTRIBUTE"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_DELIVERY_FLOW" userGroupId="BOSS_INSIGHTS_FLOW"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_DELIVERY_ADMIN" userGroupId="BOSS_INSIGHTS_ADMIN"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- Group delivery, the distributor's: the audience check, and the engine's own artifact for delivering to anyone but
        oneself (org.moqui.report.delivery.group, checked by its own rows whatever screen asks). A recipient is still sent the
        result only when their scope fingerprint equals the owner's. The distributor also saves a digest (store#Digest validates
        it: a report definition of kind digest over dashboards they read), so the engine's save is theirs; the editors stay
        the author's (BOSS_INS_AUTHORING). -->
    <artifactGroups artifactGroupId="BOSS_INS_REPORT_DISTRIBUTE" description="Insights: delivering reports to groups">
        <artifacts artifactName="org.moqui.report.ReportServices.check#ReportAudience" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.save#Definition" artifactTypeEnumId="AT_SERVICE"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_DISTRIBUTE_DISTRIBUTE" userGroupId="BOSS_INSIGHTS_DISTRIBUTE"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_INS_GROUP_DELIVERY" description="Insights: the engine's group delivery artifact">
        <artifacts artifactName="org.moqui.report.delivery.group" artifactTypeEnumId="AT_SERVICE"/>
        <authz artifactAuthzId="BOSS_INS_GROUP_DELIVERY_DISTRIBUTE" userGroupId="BOSS_INSIGHTS_DISTRIBUTE"
                authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- The message of a delivered report or digest: the body links to Insights' Dashboard, not Tools' -->
    <moqui.basic.email.EmailTemplate emailTemplateId="BOSS_INSIGHTS_REPORT" description="Insights report or digest" emailServerId="SYSTEM"
            emailTypeEnumId="EMT_SCREEN_RENDER" bodyScreenLocation="component://mr-boss/template/InsightsReportEmail.xml"
            webappName="webroot" fromAddress="" fromName="" subject="${title}" sendPartial="Y"/>
    <!-- Admin's lifecycle (impl-admin P6; design-admin §14 Lifecycle participant, design-insights §7.1 Ownership): Insights'
        report schedules, through the report engine's own services (the owned-resource contract). Offboarding pauses what the
        user owns and hands each schedule, with the definitions it needs that they own, to a new owner, who must be able to
        schedule, read its sources and, for a group schedule, deliver to a group; the schedule stays paused until that owner
        resumes it, which checks every recipient against the new owner's scope. The services check REPORT_OWNER_CHANGE for
        another user's schedules; the identity operator and the administrator hold it and the three operations (ALWAYS, past
        BOSS_INS_REPORT_ENGINE's deny for one who is also in Insights). The caller gains no report data. -->
    <ironstone.admin.LifecycleParticipant participantKey="insights.schedules" version="1" ownerApp="Insights" title="Report schedules"
            description="The scheduled reports and digests the user owns, paused when access ends and handed to a new owner who passes the same recipient check."
            resourceKind="schedule" lookupService="org.moqui.report.ReportServices.find#OwnedSchedules"
            transferService="org.moqui.report.ReportServices.transfer#DefinitionOwner" resourceParameter="screenScheduledId"
            pauseService="org.moqui.report.ReportServices.pause#OwnedSchedules" requiredPermission="REPORT_OWNER_CHANGE" sequenceNum="60"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_ADMIN_IDENTITY" userPermissionId="REPORT_OWNER_CHANGE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_ADMIN_ADMIN" userPermissionId="REPORT_OWNER_CHANGE" fromDate="0"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_ADMIN_IDENTITY" userPermissionId="REPORT_OWNER_CHANGE" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_ADMIN_ADMIN" userPermissionId="REPORT_OWNER_CHANGE" capabilityKindEnumId="CpkEdit"/>
    <artifactGroups artifactGroupId="BOSS_INS_LIFECYCLE" description="Insights: the lifecycle participant's report schedule operations">
        <artifacts artifactName="org.moqui.report.ReportServices.find#OwnedSchedules" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.pause#OwnedSchedules" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.transfer#DefinitionOwner" artifactTypeEnumId="AT_SERVICE"/>
        <authz artifactAuthzId="BOSS_INS_LIFECYCLE_IDENTITY" userGroupId="BOSS_ADMIN_IDENTITY"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_LIFECYCLE_ADMIN" userGroupId="BOSS_ADMIN_ADMIN"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>

    <!-- Admin P11 (design-admin §8 Connections and ConnectionDetail, §9 MailRelays and MailRelayDetail; impl-admin P11): the
        Integrations area (Connections, ConnectionDetail) and the Mail and protocols area (MailRelays, MailRelayDetail), the
        integration administrator's and the administrator's, denied to the root group as the other areas. The grants open
        navigation and lend the organization filters a payment gateway's organizations are read and permitted under; a
        connection is read with ADMIN_CONNECTION_VIEW and changed or tested with ADMIN_CONNECTION_MANAGE, checked by
        org.moqui.admin.ConfigurationServices and mantle.account.GatewayConnectionServices whatever opens the screens. -->
    <artifactGroups artifactGroupId="BOSS_ADM_INTEGRATIONS" description="Admin connections">
        <artifacts artifactName="component://mr-boss/screen/Admin/Integrations.xml" artifactTypeEnumId="AT_XML_SCREEN"
                inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_ADM_INTEGRATIONS_DENY" userGroupId="BOSS_ADMIN"
                authzTypeEnumId="AUTHZT_DENY" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_ADM_INTEGRATIONS_INTEG" userGroupId="BOSS_ADMIN_INTEGRATIONS"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_ADM_INTEGRATIONS_ADMIN" userGroupId="BOSS_ADMIN_ADMIN"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_ADM_PROTOCOLS" description="Admin mail relays and protocols">
        <artifacts artifactName="component://mr-boss/screen/Admin/Protocols.xml" artifactTypeEnumId="AT_XML_SCREEN"
                inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_ADM_PROTOCOLS_DENY" userGroupId="BOSS_ADMIN"
                authzTypeEnumId="AUTHZT_DENY" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_ADM_PROTOCOLS_INTEG" userGroupId="BOSS_ADMIN_INTEGRATIONS"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_ADM_PROTOCOLS_ADMIN" userGroupId="BOSS_ADMIN_ADMIN"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- Admin's settings index entries of P11 (design §14.2), each shown to a user its screen opens to -->
    <moqui.server.SettingsEntry settingsKey="admin.connections" version="1" ownerApp="Admin" title="Connections"
            description="The payment, shipping and tax gateways, remote systems, mail sign-in providers and printers this instance reaches, with their addresses and credentials, and the organizations a payment gateway is permitted for"
            settingsGroupEnumId="AdmSgInstance" scopeEnumId="AdmScInstance"
            destinationRoute="adminConnection" screenLocation="component://mr-boss/screen/Admin/Integrations/Connections.xml"
            viewPermission="ADMIN_CONNECTION_VIEW" configuredBy="Integration administrator" sequenceNum="111"/>
    <moqui.server.SettingsEntry settingsKey="admin.mailRelays" version="1" ownerApp="Admin" title="Mail relays"
            description="The outgoing mail servers the instance sends its own mail through" settingsGroupEnumId="AdmSgInstance"
            scopeEnumId="AdmScInstance" destinationRoute="adminMailRelay" screenLocation="component://mr-boss/screen/Admin/Protocols/MailRelays.xml"
            viewPermission="ADMIN_CONNECTION_VIEW" configuredBy="Integration administrator" sequenceNum="112"/>
    <!-- Insights P8 (impl-insights P8; design-insights §8, §1.1; INS-07): business alerts. No screen grant is added: the root's
        ALLOW opens Business alerts (the list and AlertDetail, the framework's alert screens included at Insights' own
        locations: mr-moqui plans/archive/Admin-Screens-Down.md, Track I), each transition they take in is refused unless Insights'
        policy lets the caller set an alert (INSIGHTS_AUTHOR or INSIGHTS_DISTRIBUTE; reading one's own state and deliveries
        is every reader's), and the report engine's operations stay denied (BOSS_INS_REPORT_ENGINE) but for the grants below.
        A rule is saved through the engine's save#Definition, the author's (BOSS_INS_REPORT_AUTHOR) and the distributor's
        (BOSS_INS_REPORT_DISTRIBUTE): the engine holds a rule over business data to an audience in place of contact points and
        checks every recipient (mr-moqui crates/moqui-report/src/alert_delivery.rs); telling anyone but oneself needs the
        engine's group delivery artifact, the distributor's (BOSS_INS_GROUP_DELIVERY). Alert evaluation stays the engine's job
        (BOSS_INS_REPORT_TOOLS). -->
    <!-- The business-alert topic (design §8.1): private, in Notifications, where someone is expected to act; its message is
        the rule and series ids, the state and the recipient's own permitted value, sent to one user at a time. The engine's
        ReportAlert topic (Updates) stays Tools' technical alerts'. reportAlertTopic="Y" marks it a topic a business rule may
        send to (SEC-TLS-106): without it a rule is refused at save (ALERT_TOPIC_UNAVAILABLE) and in-app recipients skipped. -->
    <moqui.security.user.NotificationTopic topic="InsightsBusinessAlert" inboxEnumId="NinNotifications" description="Business alerts"
            linkTemplate="/qapps/Insights/Alerts/AlertDetail?definitionId=${ruleId}" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" emailNotifications="N" isPrivate="Y" typeString="warning" reportAlertTopic="Y"/>
    <!-- The message of an alert sent to a recipient's own account address: the state, the series and a link to AlertDetail -->
    <moqui.basic.email.EmailTemplate emailTemplateId="BOSS_INSIGHTS_ALERT" description="Insights business alert" emailServerId="SYSTEM"
            emailTypeEnumId="EMT_SCREEN_RENDER" bodyScreenLocation="component://mr-boss/template/InsightsAlertEmail.xml"
            webappName="webroot" fromAddress="" fromName="" subject="Alert: ${title}" sendPartial="Y"/>
    <!-- Reading an alert's state and deliveries, every reading group's and the administrator's: the engine answers a state to
        the rule's owner and to a recipient whose scope is the owner's, a delivery to its owner or its recipient, and the
        administrative counters to a holder of ADMIN_TRANSFER_VIEW. -->
    <artifactGroups artifactGroupId="BOSS_INS_ALERT_READ" description="Insights: reading alert states and deliveries">
        <artifacts artifactName="org.moqui.report.ReportServices.get#AlertState" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.find#AlertDeliveries" artifactTypeEnumId="AT_SERVICE"/>
        <authz artifactAuthzId="BOSS_INS_ALERT_READ_READ" userGroupId="BOSS_INSIGHTS_READ"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_ALERT_READ_AUTHOR" userGroupId="BOSS_INSIGHTS_AUTHOR"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_ALERT_READ_DATA" userGroupId="BOSS_INSIGHTS_DATA"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_ALERT_READ_DISTRIBUTE" userGroupId="BOSS_INSIGHTS_DISTRIBUTE"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_ALERT_READ_FLOW" userGroupId="BOSS_INSIGHTS_FLOW"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_ALERT_READ_ADMIN" userGroupId="BOSS_INSIGHTS_ADMIN"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- The distributor deletes a rule (or a digest) of their own: the engine deletes only the owner's definition -->
    <artifactGroups artifactGroupId="BOSS_INS_ALERT_DISTRIBUTE" description="Insights: a distributor's own alert rules">
        <artifacts artifactName="org.moqui.report.ReportServices.delete#Definition" artifactTypeEnumId="AT_SERVICE"/>
        <authz artifactAuthzId="BOSS_INS_ALERT_DISTRIBUTE_DISTRIBUTE" userGroupId="BOSS_INSIGHTS_DISTRIBUTE"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- Admin's lifecycle (impl-admin P6; design-admin §14 Lifecycle participant, design-insights §7.1 Ownership): the alert
        rules a user owns, beside their schedules (insights.schedules). Offboarding pauses them and hands each to a new owner,
        who must be able to save rules, read its sources and, for a group audience, deliver to a group; the rule stays paused
        until that owner activates it, which checks every recipient against the new owner's scope. The services check
        REPORT_OWNER_CHANGE for another user's rules. The caller gains no state and no value. -->
    <ironstone.admin.LifecycleParticipant participantKey="insights.alerts" version="1" ownerApp="Insights" title="Business alerts"
            description="The alert rules the user owns, paused when access ends and handed to a new owner who passes the same recipient check."
            resourceKind="alert" lookupService="org.moqui.report.ReportServices.find#OwnedAlertRules"
            transferService="org.moqui.report.ReportServices.transfer#AlertRuleOwner" resourceParameter="definitionId"
            pauseService="org.moqui.report.ReportServices.pause#OwnedAlertRules" requiredPermission="REPORT_OWNER_CHANGE" sequenceNum="61"/>
    <artifactGroups artifactGroupId="BOSS_INS_ALERT_LIFECYCLE" description="Insights: the lifecycle participant's alert rule operations">
        <artifacts artifactName="org.moqui.report.ReportServices.find#OwnedAlertRules" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.pause#OwnedAlertRules" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.transfer#AlertRuleOwner" artifactTypeEnumId="AT_SERVICE"/>
        <authz artifactAuthzId="BOSS_INS_ALERT_LIFECYCLE_IDENTITY" userGroupId="BOSS_ADMIN_IDENTITY"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_ALERT_LIFECYCLE_ADMIN" userGroupId="BOSS_ADMIN_ADMIN"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- Insights P9 (impl-insights P9, §4; design-insights §9; INS-08): business flow maps. No screen grant is added: the root's
        ALLOW opens Business flows (FlowMap, FlowMaps and the hidden FlowMapEditor and ProcessStory), each transition reaches an
        ironstone.insights FlowMapServices operation that checks INSIGHTS_VIEW or INSIGHTS_FLOW_EDIT and the map's organization
        and owner itself, and ProcessStory serves Commons Knowledge only to a user whose own grants open it. A flow map is a
        report engine definition (type report, kind flowmap): reading one is every reading group's (BOSS_INS_REPORT_READ).
        The flow editor holds no engine authoring operation (the P9 review; design §1.1: maps, not playlists, searches or
        dashboards): the engine's save, restore and delete stay denied to them (BOSS_INS_REPORT_ENGINE) wherever an Insights
        screen calls one. The grant is on FlowMapServices' six writing operations instead, an inheritable ALWAYS, so the
        engine call each makes after its own checks (INSIGHTS_FLOW_EDIT, a flow map, its organization, its owner, the version
        read, the body validated) passes the deny, and the engine still holds the save to the definition's owner. Nothing
        else those operations call is denied to the group (the engine's reads are its own, the wiki decides a page by its
        rows), and a reader who calls one is refused by the operation itself. -->
    <artifactGroups artifactGroupId="BOSS_INS_REPORT_FLOW" description="Insights: a flow editor's own flow maps">
        <artifacts artifactName="ironstone.insights.FlowMapServices.copy#Map" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"/>
        <artifacts artifactName="ironstone.insights.FlowMapServices.store#Map" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"/>
        <artifacts artifactName="ironstone.insights.FlowMapServices.store#MapLane" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"/>
        <artifacts artifactName="ironstone.insights.FlowMapServices.store#MapStep" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"/>
        <artifacts artifactName="ironstone.insights.FlowMapServices.restore#Map" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"/>
        <artifacts artifactName="ironstone.insights.FlowMapServices.delete#Map" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_FLOW_FLOW" userGroupId="BOSS_INSIGHTS_FLOW"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/><filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- The flow targets (ironstone.insights.FlowTarget): the built apps' worklist routes a map's step may open, each with the
        parameters it takes (owner contracts, each in its owner's design; a registration grants nothing, the link is answered
        only to a viewer whose own groups open the route). A choice parameter takes one of its listed values; an organization
        parameter is the organization in the map's scope, set when the map is read. Sales, Marketing, People and Maintenance
        register theirs when they are built; until then their steps are information. -->
    <!-- Commerce (owner contract, design-commerce §3): the store work lists -->
    <ironstone.insights.FlowTarget targetId="Commerce.Orders" version="1" ownerApp="Commerce" title="Store orders"
