<entity-facade-xml type="demo">
    <!-- The Purchasing demo (impl-purchasing P1) over Mantle's ZiddlemanInc supplier, ORG_ZIZI_RETAIL as the buyer, ZIRET_WH
        (owned by Retail) and the DEMO_* purchase offers of ZcaProductDemoData.xml, and the Warehouse demo's approved
        purchase order BOSS_WH_PO (Retail from Ziddleman, BossWarehouseDemoData.xml). Suppliers by owner (§4): Ziddleman and
        Common Fasteners are shared (_NA_), the others Retail's, and a supplier of Ziziwork Services that Retail's users never
        reach (isolation). The buyers' PartyRelationship rows and the demo users are in BossUsersDemoData.xml. Later phases
        give the suppliers what their walks need, each in a block named for its phase: P2 Retail's buying policy, the supplier
        categories and the approval and block states of the awaiting-approval and blocked suppliers (SupplierProfile), P7
        the drop-ship supplier and its facility. -->

    <!-- P1: Ziddleman, which Mantle's demo leaves unowned (no organization filter passes it, F43), as a shared supplier, with
        an order email (EmailOrder, the address a purchase order is sent to, P3) -->
    <mantle.party.Party partyId="ZiddlemanInc" ownerPartyId="_NA_"/>
    <mantle.party.contact.ContactMech contactMechId="ZiddlemanIncOrderEmail" contactMechTypeEnumId="CmtEmailAddress"
            infoString="orders@ziddleman.example.com"/>
    <mantle.party.contact.PartyContactMech partyId="ZiddlemanInc" contactMechId="ZiddlemanIncOrderEmail"
            contactMechPurposeId="EmailOrder" fromDate="1265184000000"/>

    <!-- P1: Retail's second supplier, a shared third, a service supplier, one awaiting approval and one blocked (P2 sets
        their states), and the other organization's supplier -->
    <mantle.party.Party partyId="BOSS_PUR_SUP_B" pseudoId="BRIGHTLINE" partyTypeEnumId="PtyOrganization"
            ownerPartyId="ORG_ZIZI_RETAIL"/>
    <mantle.party.Organization partyId="BOSS_PUR_SUP_B" organizationName="Brightline Components"/>
    <mantle.party.PartyRole partyId="BOSS_PUR_SUP_B" roleTypeId="Supplier"/>
    <mantle.party.contact.ContactMech contactMechId="BOSS_PUR_SUP_B_EMAIL" contactMechTypeEnumId="CmtEmailAddress"
            infoString="orders@brightline.example.com"/>
    <mantle.party.contact.PartyContactMech partyId="BOSS_PUR_SUP_B" contactMechId="BOSS_PUR_SUP_B_EMAIL"
            contactMechPurposeId="EmailOrder" fromDate="1265184000000"/>
    <mantle.party.Party partyId="BOSS_PUR_SUP_C" pseudoId="COMMONFAST" partyTypeEnumId="PtyOrganization" ownerPartyId="_NA_"/>
    <mantle.party.Organization partyId="BOSS_PUR_SUP_C" organizationName="Common Fasteners Co"/>
    <mantle.party.PartyRole partyId="BOSS_PUR_SUP_C" roleTypeId="Supplier"/>
    <mantle.party.Party partyId="BOSS_PUR_SUP_SERVICE" pseudoId="PRECISECAL" partyTypeEnumId="PtyOrganization"
            ownerPartyId="ORG_ZIZI_RETAIL"/>
    <mantle.party.Organization partyId="BOSS_PUR_SUP_SERVICE" organizationName="Precision Calibration Services"/>
    <mantle.party.PartyRole partyId="BOSS_PUR_SUP_SERVICE" roleTypeId="Supplier"/>
    <mantle.party.Party partyId="BOSS_PUR_SUP_PENDING" pseudoId="NORTHWIND" partyTypeEnumId="PtyOrganization"
            ownerPartyId="ORG_ZIZI_RETAIL"/>
    <mantle.party.Organization partyId="BOSS_PUR_SUP_PENDING" organizationName="Northwind Packaging"/>
    <mantle.party.PartyRole partyId="BOSS_PUR_SUP_PENDING" roleTypeId="Supplier"/>
    <mantle.party.Party partyId="BOSS_PUR_SUP_BLOCKED" pseudoId="HALVORSEN" partyTypeEnumId="PtyOrganization"
            ownerPartyId="ORG_ZIZI_RETAIL"/>
    <mantle.party.Organization partyId="BOSS_PUR_SUP_BLOCKED" organizationName="Halvorsen Metals"/>
    <mantle.party.PartyRole partyId="BOSS_PUR_SUP_BLOCKED" roleTypeId="Supplier"/>
    <mantle.party.Party partyId="BOSS_PUR_SUP_SVC_ORG" pseudoId="SVCSUPPLY" partyTypeEnumId="PtyOrganization"
            ownerPartyId="ORG_ZIZI_SERVICES"/>
    <mantle.party.Organization partyId="BOSS_PUR_SUP_SVC_ORG" organizationName="Services Office Supply"/>
    <mantle.party.PartyRole partyId="BOSS_PUR_SUP_SVC_ORG" roleTypeId="Supplier"/>

    <!-- P1: a draft purchase order of Retail's from Brightline for ZIRET_WH, and one of Ziziwork Services' from its own
        supplier, which Retail's users never reach -->
    <mantle.order.OrderHeader orderId="BOSS_PUR_PO_A" orderName="Brightline restock" statusId="OrderOpen"
            entryDate="2026-11-02 00:00:00" currencyUomId="USD" grandTotal="250"/>
    <mantle.order.OrderPart orderId="BOSS_PUR_PO_A" orderPartSeqId="01" statusId="OrderOpen" vendorPartyId="BOSS_PUR_SUP_B"
            customerPartyId="ORG_ZIZI_RETAIL" facilityId="ZIRET_WH" partTotal="250"/>
    <mantle.order.OrderItem orderId="BOSS_PUR_PO_A" orderItemSeqId="01" orderPartSeqId="01" itemTypeEnumId="ItemInventory"
            productId="DEMO_1_1" itemDescription="Demo product one-one" quantity="25" unitAmount="10"/>
    <mantle.order.OrderHeader orderId="BOSS_PUR_PO_SVC" orderName="Services office restock" statusId="OrderOpen"
            entryDate="2026-11-02 00:00:00" currencyUomId="USD" grandTotal="40"/>
    <mantle.order.OrderPart orderId="BOSS_PUR_PO_SVC" orderPartSeqId="01" statusId="OrderOpen"
            vendorPartyId="BOSS_PUR_SUP_SVC_ORG" customerPartyId="ORG_ZIZI_SERVICES" partTotal="40"/>
    <mantle.order.OrderItem orderId="BOSS_PUR_PO_SVC" orderItemSeqId="01" orderPartSeqId="01" itemTypeEnumId="ItemExpense"
            itemDescription="Printer paper" quantity="4" unitAmount="10"/>

    <!-- P2: Retail's buying policy (approval gate off, F34: the Accounting demo and OrderProcureToPayBasicFlow place and approve
        Retail's purchase orders directly; supplier approval required, an unapproved supplier warned; P3: revisions count
        commercial changes only, so a sent order's revision stays the one approved and sent), the supplier
        categories, the buying profiles (Ziddleman approved, Brightline approved in USD, Northwind awaiting approval,
        Halvorsen blocked from Nov 1, 2026 with its reason) and each supplier's category. Demo.js of Accounting keeps its own
        supplier's profile. -->
    <mantle.order.purchase.PurchasePolicy organizationPartyId="ORG_ZIZI_RETAIL" fromDate="1265184000000" currencyUomId="USD"
            facilityId="ZIRET_WH" incotermEnumId="TtFOB" rfqResponseDays="5" quoteExpiryWarnDays="7" reminderDays="3"
            supplierApprovalRequired="Y" unapprovedSupplierEnumId="PusWarn" approvalGateEnabled="N" selfApprovalAllowed="N"
            commercialRevisionOnly="Y" changeReason="Purchasing demo: Retail's buying policy"/>
    <mantle.party.PartyClassification partyClassificationId="BOSS_PUR_CAT_COMPONENTS" classificationTypeEnumId="PcltSupplierCategory"
            description="Components"/>
    <mantle.party.PartyClassification partyClassificationId="BOSS_PUR_CAT_PACKAGING" classificationTypeEnumId="PcltSupplierCategory"
            description="Packaging"/>
    <mantle.party.PartyClassification partyClassificationId="BOSS_PUR_CAT_METALS" classificationTypeEnumId="PcltSupplierCategory"
            description="Raw metals"/>
    <mantle.party.PartyClassification partyClassificationId="BOSS_PUR_CAT_SERVICES" classificationTypeEnumId="PcltSupplierCategory"
            description="Services"/>
    <mantle.party.PartyClassificationAppl partyId="ZiddlemanInc" partyClassificationId="BOSS_PUR_CAT_COMPONENTS"
            fromDate="1265184000000"/>
    <mantle.party.PartyClassificationAppl partyId="BOSS_PUR_SUP_B" partyClassificationId="BOSS_PUR_CAT_COMPONENTS"
            fromDate="1265184000000"/>
    <mantle.party.PartyClassificationAppl partyId="BOSS_PUR_SUP_PENDING" partyClassificationId="BOSS_PUR_CAT_PACKAGING"
            fromDate="1265184000000"/>
    <mantle.party.PartyClassificationAppl partyId="BOSS_PUR_SUP_BLOCKED" partyClassificationId="BOSS_PUR_CAT_METALS"
            fromDate="1265184000000"/>
    <mantle.party.PartyClassificationAppl partyId="BOSS_PUR_SUP_SERVICE" partyClassificationId="BOSS_PUR_CAT_SERVICES"
            fromDate="1265184000000"/>
    <mantle.party.supplier.SupplierProfile supplierProfileId="BOSS_PUR_PROF_ZIDDLEMAN" organizationPartyId="ORG_ZIZI_RETAIL"
            supplierPartyId="ZiddlemanInc" fromDate="1265184000000" currencyUomId="USD" incotermEnumId="TtFOB"
            approvalStatusId="SupaApproved" selfBillingIndicator="N" changeReason="Purchasing demo: approved supplier"/>
    <mantle.party.supplier.SupplierProfile supplierProfileId="BOSS_PUR_PROF_B" organizationPartyId="ORG_ZIZI_RETAIL"
            supplierPartyId="BOSS_PUR_SUP_B" fromDate="1265184000000" currencyUomId="USD" incotermEnumId="TtEXW"
            approvalStatusId="SupaApproved" selfBillingIndicator="N" changeReason="Purchasing demo: approved supplier"/>
    <mantle.party.supplier.SupplierProfile supplierProfileId="BOSS_PUR_PROF_PENDING" organizationPartyId="ORG_ZIZI_RETAIL"
            supplierPartyId="BOSS_PUR_SUP_PENDING" fromDate="1265184000000" currencyUomId="USD"
            approvalStatusId="SupaPending" selfBillingIndicator="N" changeReason="Purchasing demo: new supplier"/>
    <mantle.party.supplier.SupplierProfile supplierProfileId="BOSS_PUR_PROF_BLOCKED" organizationPartyId="ORG_ZIZI_RETAIL"
            supplierPartyId="BOSS_PUR_SUP_BLOCKED" fromDate="1265184000000" currencyUomId="USD"
            approvalStatusId="SupaApproved" purchaseBlockFromDate="2026-11-01 00:00:00"
            purchaseBlockReason="Quality hold: failed incoming inspection" selfBillingIndicator="N"
            changeReason="Purchasing demo: blocked supplier"/>

    <!-- P3: purchase orders sent from the demo go to a local sink (send#PurchaseOrder's template on a server of its own, as
        Accounting's demo delivery); a deployment sets MANTLE_PURCHASE_ORDER_EMAIL's server -->
    <moqui.basic.email.EmailServer emailServerId="BOSS_PURCHASING_DEMO" smtpHost="127.0.0.1" smtpPort="9" smtpStartTls="N"
            smtpSsl="N"/>
    <moqui.basic.email.EmailTemplate emailTemplateId="MANTLE_PURCHASE_ORDER_EMAIL" emailServerId="BOSS_PURCHASING_DEMO"/>
    <!-- P9: the reminders to acknowledge an order (send#PurchaseReminder) go to the same sink -->
    <moqui.basic.email.EmailTemplate emailTemplateId="MANTLE_PURCHASE_REMINDER" emailServerId="BOSS_PURCHASING_DEMO"/>
    <!-- P4: Retail's purchase order approval policy (design §18, impl-purchasing §4: a buyer and manager split): up to $5,000
        one purchase approver decides; from $5,000 a member of the purchase approver group and then the purchasing administrator,
        who may not have taken the first step. Suppliers have no policy rows, so one purchase approver decides them. -->
    <mantle.order.purchase.PurchaseApprovalPolicy purchaseApprovalPolicyId="BOSS_PUR_APR_SMALL"
            organizationPartyId="ORG_ZIZI_RETAIL" sourceTypeEnumId="PasOrder" fromAmount="0" thruAmount="5000"
            currencyUomId="USD" sequenceNum="1" quorum="1" fromDate="1265184000000" description="Up to $5,000: a purchase approver"
            changeReason="Demo"/>
    <mantle.order.purchase.PurchaseApprovalPolicy purchaseApprovalPolicyId="BOSS_PUR_APR_LARGE_1"
            organizationPartyId="ORG_ZIZI_RETAIL" sourceTypeEnumId="PasOrder" fromAmount="5000" currencyUomId="USD"
            sequenceNum="1" quorum="1" approverUserGroupId="BOSS_PURCHASING_APPROVE" fromDate="1265184000000"
            description="From $5,000: a purchase approver"
            changeReason="Demo"/>
    <mantle.order.purchase.PurchaseApprovalPolicy purchaseApprovalPolicyId="BOSS_PUR_APR_LARGE_2"
            organizationPartyId="ORG_ZIZI_RETAIL" sourceTypeEnumId="PasOrder" fromAmount="5000" currencyUomId="USD"
            sequenceNum="2" quorum="1" approverUserId="BOSS_PUR_ADMIN" separateApprover="Y" fromDate="1265184000000"
            description="From $5,000: then the purchasing administrator" changeReason="Demo"/>
    <!-- P5: an approved purchase order of Retail's from Ziddleman, ten of DEMO_1_1 required by Oct 25, 2026, with its expected
        receipt (ASN) at ZIRET_WH due the same day and nothing received: Receipts' late line, Home's late count and the
        receipt the shared ShipmentDetail shows; the receiving walks make their own orders -->
    <mantle.order.OrderHeader orderId="BOSS_PUR_PO_RCV" orderName="Late restock" statusId="OrderApproved"
            entryDate="2026-10-15 00:00:00" placedDate="2026-10-15 00:00:00" currencyUomId="USD" grandTotal="90"/>
    <mantle.order.OrderPart orderId="BOSS_PUR_PO_RCV" orderPartSeqId="01" statusId="OrderApproved"
            vendorPartyId="ZiddlemanInc" customerPartyId="ORG_ZIZI_RETAIL" facilityId="ZIRET_WH" partTotal="90"/>
    <mantle.order.OrderItem orderId="BOSS_PUR_PO_RCV" orderItemSeqId="01" orderPartSeqId="01" itemTypeEnumId="ItemInventory"
            productId="DEMO_1_1" itemDescription="Demo product one-one" quantity="10" unitAmount="9"
            requiredByDate="2026-10-25 00:00:00"/>
    <mantle.shipment.Shipment shipmentId="BOSS_PUR_RCV_SHIP" shipmentTypeEnumId="ShpTpPurchase" statusId="ShipScheduled"
            fromPartyId="ZiddlemanInc" toPartyId="ORG_ZIZI_RETAIL" estimatedArrivalDate="2026-10-25 00:00:00"/>
    <mantle.shipment.ShipmentRouteSegment shipmentId="BOSS_PUR_RCV_SHIP" shipmentRouteSegmentSeqId="01"
            destinationFacilityId="ZIRET_WH"/>
    <mantle.shipment.ShipmentItem shipmentId="BOSS_PUR_RCV_SHIP" productId="DEMO_1_1" quantity="10"/>
    <mantle.shipment.ShipmentItemSource shipmentItemSourceId="BOSS_PUR_RCV_SRC" shipmentId="BOSS_PUR_RCV_SHIP"
            productId="DEMO_1_1" orderId="BOSS_PUR_PO_RCV" orderItemSeqId="01" quantity="10" quantityNotHandled="10"
            statusId="SisPending"/>
    <!-- P7: Ziddleman's drop-ship facility (Mantle's model, F21: owned by the supplier, its stock or Mantle's shell asset
        reserved for a customer line, the shell issued to the customer), with no integration so its orders are emailed; and
        Ziddleman's price of DEMO_3_1 marked for drop-ship, so "Drop-ship from supplier" offers it on a customer line -->
    <mantle.facility.Facility facilityId="BOSS_PUR_DROPSHIP" facilityTypeEnumId="FcTpDropShip" ownerPartyId="ZiddlemanInc"
            facilityName="Ziddleman direct (drop-ship)" assetAllowOtherOwner="Y" assetAllowIssueOverQoh="Y"/>
    <mantle.product.ProductPrice productPriceId="DEMO_3_1_CS" canDropShip="Y"/>

    <!-- P9: Retail's order from Brightline, sent and not acknowledged yet (Acknowledgements' Unacknowledged view, Home's
        Unacknowledged orders) -->
    <mantle.order.OrderHeader orderId="BOSS_PUR_PO_ACK" orderName="Fastener restock" statusId="OrderSent"
            entryDate="2026-10-28 00:00:00" placedDate="2026-10-28 00:00:00" approvedDate="2026-10-29 00:00:00"
            currencyUomId="USD" grandTotal="200" orderRevision="1"/>
    <mantle.order.OrderPart orderId="BOSS_PUR_PO_ACK" orderPartSeqId="01" statusId="OrderSent" vendorPartyId="BOSS_PUR_SUP_B"
            customerPartyId="ORG_ZIZI_RETAIL" facilityId="ZIRET_WH" partTotal="200"/>
    <mantle.order.OrderItem orderId="BOSS_PUR_PO_ACK" orderItemSeqId="01" orderPartSeqId="01" itemTypeEnumId="ItemInventory"
            productId="DEMO_1_1" itemDescription="Demo product one-one" quantity="20" unitAmount="10"
            requiredByDate="2026-11-20 00:00:00"/>

    <!-- P13: Retail's blanket agreement with Ziddleman for DEMO_1_1 (100 units, $1,000.00, 5% tolerance, $9.00 a unit),
        active at its approved revision 1, so AgreementDetail releases from it; a sourcing template of Retail's; and Ziziwork
        Services' draft agreement with its own supplier (another organization's, for the access checks) -->
    <mantle.party.agreement.Agreement agreementId="BOSS_PUR_AGR_A" agreementTypeEnumId="AgrPurchase" statusId="AgmStActive"
            organizationPartyId="ORG_ZIZI_RETAIL" organizationRoleTypeId="OrgInternal" otherPartyId="ZiddlemanInc"
            otherRoleTypeId="Supplier" agreementDate="2026-10-01 00:00:00" fromDate="2026-10-01 00:00:00"
            thruDate="2027-10-01 00:00:00" currencyUomId="USD" description="Widget blanket 2026-27" isTemplate="N"
            agreementRevision="1" revisionDate="2026-10-01 00:00:00" approvedRevision="1" approvedDate="2026-10-01 00:00:00"/>
    <mantle.party.agreement.AgreementItem agreementId="BOSS_PUR_AGR_A" agreementItemSeqId="01" agreementItemTypeEnumId="AitPurchase"
            productId="DEMO_1_1" quantity="100" quantityUomId="OTH_ea" amountCap="1000" releaseTolerancePercent="5"
            fromDate="2026-10-01 00:00:00"/>
    <mantle.product.ProductPrice productPriceId="BOSS_PUR_AGR_A_01" productId="DEMO_1_1" vendorPartyId="ZiddlemanInc"
            customerPartyId="ORG_ZIZI_RETAIL" pricePurposeEnumId="PppPurchase" priceTypeEnumId="PptCurrent" priceUomId="USD"
            quantityUomId="OTH_ea" minQuantity="0" price="9" agreementId="BOSS_PUR_AGR_A" agreementItemSeqId="01"
            fromDate="2026-10-01 00:00:00"/>
    <mantle.party.agreement.AgreementTerm agreementTermId="BOSS_PUR_AGR_A_T1" agreementId="BOSS_PUR_AGR_A"
            termTypeEnumId="TtFinPaymentDays" termNumber="30" termText="Net 30 on each release" fromDate="2026-10-01 00:00:00"/>
    <mantle.party.agreement.Agreement agreementId="BOSS_PUR_AGR_TPL" agreementTypeEnumId="AgrPurchase" statusId="AgmStDraft"
            organizationPartyId="ORG_ZIZI_RETAIL" organizationRoleTypeId="OrgInternal" otherPartyId="ZiddlemanInc"
            otherRoleTypeId="Supplier" agreementDate="2026-10-01 00:00:00" currencyUomId="USD"
            description="Standard widget terms (template)" isTemplate="Y" agreementRevision="1" revisionDate="2026-10-01 00:00:00"/>
    <mantle.party.agreement.AgreementItem agreementId="BOSS_PUR_AGR_TPL" agreementItemSeqId="01" agreementItemTypeEnumId="AitPurchase"
            productId="DEMO_1_1" quantity="50" quantityUomId="OTH_ea" releaseTolerancePercent="5"/>
    <mantle.party.agreement.Agreement agreementId="BOSS_PUR_AGR_SVC" agreementTypeEnumId="AgrPurchase" statusId="AgmStDraft"
            organizationPartyId="ORG_ZIZI_SERVICES" organizationRoleTypeId="OrgInternal" otherPartyId="BOSS_PUR_SUP_SVC_ORG"
            otherRoleTypeId="Supplier" agreementDate="2026-10-01 00:00:00" fromDate="2026-10-01 00:00:00" currencyUomId="USD"
            description="Services paper supply" isTemplate="N" agreementRevision="1" revisionDate="2026-10-01 00:00:00"/>
</entity-facade-xml>
