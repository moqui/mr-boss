<entity-facade-xml type="seed-initial">
    <!-- Insights P1 (impl-insights P1, F1, F2, F4; design-insights §1.1): the root user group and the capability groups; the
        administrator group BOSS_INSIGHTS_ADMIN is above. Groups are not nested: an Insights user is in BOSS_USERS, BOSS_INSIGHTS and
        a capability group, the administrator in BOSS_USERS and BOSS_INSIGHTS_ADMIN. -->
    <moqui.security.UserGroup userGroupId="BOSS_INSIGHTS" description="Insights app users (the launcher)"/>
    <moqui.security.UserGroup userGroupId="BOSS_INSIGHTS_READ" description="Insights reader"/>
    <moqui.security.UserGroup userGroupId="BOSS_INSIGHTS_AUTHOR" description="Insights author"/>
    <moqui.security.UserGroup userGroupId="BOSS_INSIGHTS_DATA" description="Insights dataset steward"/>
    <moqui.security.UserGroup userGroupId="BOSS_INSIGHTS_DISTRIBUTE" description="Insights distributor"/>
    <moqui.security.UserGroup userGroupId="BOSS_INSIGHTS_FLOW" description="Insights flow editor"/>
    <!-- the root user group's authorization on the Insights root and the app's services (ironstone.insights: its context and, in
        later phases, the registries and flow maps), beside the administrators' rows of the BOSS_INSIGHTS artifact group above. The
        root grant opens navigation only; each screen and service checks its own permission, and the report engine its own
        artifacts (below). -->
    <artifactGroups artifactGroupId="BOSS_INSIGHTS" description="IronStone Insights App (via root screen)">
        <artifacts artifactName="ironstone\.insights\..*" artifactTypeEnumId="AT_SERVICE" nameIsPattern="Y" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_INSIGHTS_ROOT" userGroupId="BOSS_INSIGHTS" authzTypeEnumId="AUTHZT_ALLOW"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- The copied report screens (impl-insights F20; design §13.2): ScheduledReports (the copied personal scheduled finds) stays
        the Insights administrator's and ADMIN's until P7 replaces it: the root user group is denied it, as impl-commerce F45's
        areas. P2 replaced the copied Dashboards and Dashboard (F35), P3 the copied report builder's Datasets, DatasetDetail and
        DatasetView with their raw DataDocument transitions (BOSS_INS_DATASET_SCREENS below), P4 the legacy saved-report picker
        (Reports) with the report catalog and SavedReports, every Insights user's (an existing instance deletes the earlier
        pattern rows of this group, which named those screens). Insights.js reads this as the legacy capability. The administrator's grant is ALLOW, as on the root: an inheritable ALWAYS here would pass the engine's denies
        below (BOSS_INS_REPORT_ENGINE) from these screens. -->
    <artifactGroups artifactGroupId="BOSS_INS_LEGACY">
        <artifacts artifactName="component://mr-boss/screen/Insights/ScheduledReports\.xml"
                artifactTypeEnumId="AT_XML_SCREEN" nameIsPattern="Y" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_INS_LEGACY_DENY" userGroupId="BOSS_INSIGHTS"
                authzTypeEnumId="AUTHZT_DENY" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_LEGACY_ADMIN" userGroupId="BOSS_INSIGHTS_ADMIN"
                authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- Insights P1 (impl-insights §4; design-insights §1.1's table): the INSIGHTS_* permissions, BOSS's own, checked by the
        ironstone.insights services and screens (never by the framework), each granted to ADMIN, and the groups' grants. Every group
        reads; the administrator holds the settings, not authoring, datasets, delivery or flow maps (business data, costs and
        account administration stay separate grants). Personal scheduling for readers adds INSIGHTS_SCHEDULE when P7 builds it. -->
    <moqui.security.UserPermission userPermissionId="INSIGHTS_VIEW" description="Insights: read permitted dashboards, catalog entries and scoped results"/>
    <moqui.security.UserPermission userPermissionId="INSIGHTS_AUTHOR" description="Insights: create own analyses, panels and dashboards from admitted sources and share them"/>
    <moqui.security.UserPermission userPermissionId="INSIGHTS_DATASET_VIEW" description="Insights: see business datasets and their documented scope"/>
    <moqui.security.UserPermission userPermissionId="INSIGHTS_DATASET_EDIT" description="Insights: manage admitted business datasets, their scope and index"/>
    <moqui.security.UserPermission userPermissionId="INSIGHTS_SCHEDULE" description="Insights: schedule reports and digests"/>
    <moqui.security.UserPermission userPermissionId="INSIGHTS_DISTRIBUTE" description="Insights: deliver schedules to approved internal recipients and see their outcomes"/>
    <moqui.security.UserPermission userPermissionId="INSIGHTS_FLOW_EDIT" description="Insights: copy and maintain business flow maps"/>
    <moqui.security.UserPermission userPermissionId="INSIGHTS_SETTINGS_VIEW" description="Insights: see the organization's analytics settings"/>
    <moqui.security.UserPermission userPermissionId="INSIGHTS_SETTINGS_EDIT" description="Insights: change the organization's analytics settings"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="INSIGHTS_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="INSIGHTS_AUTHOR" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="INSIGHTS_DATASET_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="INSIGHTS_DATASET_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="INSIGHTS_SCHEDULE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="INSIGHTS_DISTRIBUTE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="INSIGHTS_FLOW_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="INSIGHTS_SETTINGS_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="INSIGHTS_SETTINGS_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_INSIGHTS_READ" userPermissionId="INSIGHTS_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_INSIGHTS_AUTHOR" userPermissionId="INSIGHTS_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_INSIGHTS_AUTHOR" userPermissionId="INSIGHTS_AUTHOR" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_INSIGHTS_DATA" userPermissionId="INSIGHTS_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_INSIGHTS_DATA" userPermissionId="INSIGHTS_DATASET_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_INSIGHTS_DATA" userPermissionId="INSIGHTS_DATASET_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_INSIGHTS_DISTRIBUTE" userPermissionId="INSIGHTS_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_INSIGHTS_DISTRIBUTE" userPermissionId="INSIGHTS_SCHEDULE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_INSIGHTS_DISTRIBUTE" userPermissionId="INSIGHTS_DISTRIBUTE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_INSIGHTS_FLOW" userPermissionId="INSIGHTS_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_INSIGHTS_FLOW" userPermissionId="INSIGHTS_FLOW_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_INSIGHTS_ADMIN" userPermissionId="INSIGHTS_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_INSIGHTS_ADMIN" userPermissionId="INSIGHTS_SETTINGS_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_INSIGHTS_ADMIN" userPermissionId="INSIGHTS_SETTINGS_EDIT" fromDate="0"/>
    <!-- The report engine's own artifacts by capability (impl-insights F2, F4, §4): never DASHBOARDS_APP, REPORT_DATASETS_ADMIN, the
        Tools Dashboards screens, the telemetry datasets (org.moqui.report.dataset.otel_*) or git sync. Reading (every Insights
        group): the /moqui/reports REST path the browser panels post to, and the query, document, dataset, dashboard, definition,
        version, use, diff, preview, definition export and export-audit operations, ALWAYS so they pass BOSS_INS_REPORT_ENGINE's deny
        (below); each dataset's own org.moqui.report.dataset.<id> artifact and its documents' DataDocumentUserGroup rows are granted
        by P3's admission, so a definition or a share grants no data. -->
    <artifactGroups artifactGroupId="BOSS_INS_REPORT_READ" description="Insights: reading report definitions and results">
        <artifacts artifactName="/moqui/reports" artifactTypeEnumId="AT_REST_PATH" inheritAuthz="Y"/>
        <artifacts artifactName="org.moqui.report.ReportServices.query#Documents" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.run#Query" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.list#Datasets" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.get#Dataset" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.render#Dashboard" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.get#Definition" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.list#Definitions" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.versions#Definition" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.find#DefinitionUses" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.get#DefinitionDiff" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.preview#Report" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.audit#Export" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.export#Definitions" artifactTypeEnumId="AT_SERVICE"/>
        <!-- whether the caller may still read a definition (its owner, group and read-only flag, nothing of its body): CalcGrid
            asks it of a saved document on each call, its screen's and the dataset calcgrid's get#CalcFrame (mr-moqui
            crates/moqui-calc/src/service.rs may_still_read), so without it every saved CalcGrid document under Insights, and
            every panel over one, was refused by BOSS_INS_REPORT_ENGINE (mr-moqui plans/IronCalc-DB2.md CG1.1) -->
        <artifacts artifactName="org.moqui.report.ReportServices.check#DefinitionRead" artifactTypeEnumId="AT_SERVICE"/>
        <!-- which rows of a search dataset the reader reads, as a fingerprint: CalcGrid asks it for a data sheet over a dataset,
            whose scope decides the room (mr-moqui crates/moqui-report/src/dataset_scope.rs, plans/IronCalc-DB2.md CG5.5); it
            answers nothing of the filter, and the dataset's own grant still decides whether it reads -->
        <artifacts artifactName="org.moqui.report.ReportServices.get#DatasetScope" artifactTypeEnumId="AT_SERVICE"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_READ_READ" userGroupId="BOSS_INSIGHTS_READ"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_READ_AUTHOR" userGroupId="BOSS_INSIGHTS_AUTHOR"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_READ_DATA" userGroupId="BOSS_INSIGHTS_DATA"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_READ_DISTRIBUTE" userGroupId="BOSS_INSIGHTS_DISTRIBUTE"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_READ_FLOW" userGroupId="BOSS_INSIGHTS_FLOW"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_READ_ADMIN" userGroupId="BOSS_INSIGHTS_ADMIN"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- Authoring (the author and the dataset steward): saving, copying, restoring and deleting definitions, each the owner's in the
        engine. BOSS_INS_REPORT_ENGINE denies every ReportServices operation to the root user group and the administrator, so the
        root's inheritable ALLOW does not open them to a reader from an Insights screen (impl-admin F35); the authors' ALWAYS passes
        the deny, as an area's. -->
    <artifactGroups artifactGroupId="BOSS_INS_REPORT_AUTHOR" description="Insights: authoring report definitions">
        <artifacts artifactName="org.moqui.report.ReportServices.save#Definition" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.copy#Definition" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.restore#Definition" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.delete#Definition" artifactTypeEnumId="AT_SERVICE"/>
        <!-- the groups a saver may share a definition with, by name (their own, and those their own grant lets them name):
            what the framework's share dialogs ask (mr-moqui plans/archive/Admin-Screens-Down.md, Track I, I4) -->
        <artifacts artifactName="org.moqui.report.ReportServices.find#ShareGroups" artifactTypeEnumId="AT_SERVICE"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_AUTHOR_AUTHOR" userGroupId="BOSS_INSIGHTS_AUTHOR"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_AUTHOR_DATA" userGroupId="BOSS_INSIGHTS_DATA"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- Sharing with the wall displays (the author): the engine's save takes a group the saver is not in only from one whose own
        grant holds that group's share artifact (org.moqui.report.share.<userGroupId>, definitions.rs, checked by its own rows
        whatever screen asks). No person is in BOSS_INSIGHTS_DISPLAY, so the author, who shares a dashboard or a playlist with
        the wall displays (the root's reportPolicy offers the group, features.share is the author's), holds its artifact; a
        steward and a distributor, who also hold the engine's save, do not, and no Insights group holds any other group's. -->
    <artifactGroups artifactGroupId="BOSS_INS_SHARE_DISPLAY" description="Insights: sharing a definition with the wall displays">
        <artifacts artifactName="org.moqui.report.share.BOSS_INSIGHTS_DISPLAY" artifactTypeEnumId="AT_SERVICE"/>
        <authz artifactAuthzId="BOSS_INS_SHARE_DISPLAY_AUTHOR" userGroupId="BOSS_INSIGHTS_AUTHOR"
                authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- Adding fields to a document's readers (the steward): the engine widens a document only for a group whose own grant holds
        that group's widen artifact (org.moqui.report.widen.<userGroupId>, SEC-TLS-92), never by its share grant. The steward
        holds the four Insights groups' alone, so it adds fields to the documents only Insights groups read (MantleInventoryAsset,
        MantleSalesOrderItem, MantleSalesOrderPart); a document an app's group also reads stays closed to it, by the owner's
        decision, and is widened by that app's administrator. -->
    <artifactGroups artifactGroupId="BOSS_INS_DATASET_WIDEN" description="Insights: adding fields to the documents the Insights groups read">
        <artifacts artifactName="org.moqui.report.widen.BOSS_INSIGHTS_READ" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.widen.BOSS_INSIGHTS_AUTHOR" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.widen.BOSS_INSIGHTS_DISTRIBUTE" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.widen.BOSS_INSIGHTS_FLOW" artifactTypeEnumId="AT_SERVICE"/>
        <authz artifactAuthzId="BOSS_INS_DATASET_WIDEN_DATA" userGroupId="BOSS_INSIGHTS_DATA"
                authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- Saving a dataset definition (the steward): the engine's own check (definitions.rs, org.moqui.report.dataset update), which
        reads no dataset; P3 guards index#BusinessDataset by the dataset's update artifact. -->
    <artifactGroups artifactGroupId="BOSS_INS_DATASET_EDIT" description="Insights: saving business dataset definitions">
        <artifacts artifactName="org.moqui.report.dataset" artifactTypeEnumId="AT_SERVICE"/>
        <authz artifactAuthzId="BOSS_INS_DATASET_EDIT_DATA" userGroupId="BOSS_INSIGHTS_DATA"
                authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- Scheduling (the distributor): the framework's schedule operations, owner-mode until P7's owner-equivalence check, denied to
        the root user group and the administrator by BOSS_INS_REPORT_ENGINE as authoring is. -->
    <artifactGroups artifactGroupId="BOSS_INS_REPORT_SCHEDULE" description="Insights: scheduling reports">
        <artifacts artifactName="org.moqui.report.ReportServices.create#Schedule" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.list#Schedules" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.pause#Schedule" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.send#Report" artifactTypeEnumId="AT_SERVICE"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_SCHEDULE_DISTRIBUTE" userGroupId="BOSS_INSIGHTS_DISTRIBUTE"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- Tools' report administration, no Insights group's: definition import (P12's admitted bundles), annotations (P6's business
        source), alert evaluation and git sync, denied to the root user group and the administrator so the root's inheritable
        ALLOW opens none of them from an Insights screen; each but pull#DefinitionGitSyncs (the repository pull, allow-remote
        false, with no check of its own) also keeps its own check in the engine. -->
    <artifactGroups artifactGroupId="BOSS_INS_REPORT_TOOLS" description="Insights: Tools report administration, refused">
        <artifacts artifactName="org.moqui.report.ReportServices.import#Definitions" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.create#Annotation" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.evaluate#Alerts" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.store#DefinitionGitSync" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.list#DefinitionGitSyncs" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.push#DefinitionGitSync" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.pull#DefinitionGitSync" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.ReportServices.pull#DefinitionGitSyncs" artifactTypeEnumId="AT_SERVICE"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_TOOLS_ROOTDENY" userGroupId="BOSS_INSIGHTS"
                authzTypeEnumId="AUTHZT_DENY" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_TOOLS_ADMINDENY" userGroupId="BOSS_INSIGHTS_ADMIN"
                authzTypeEnumId="AUTHZT_DENY" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- Admin P2 (impl-admin P2, §4, F9, F16, F21, F22, F44, F46; design-admin §3, §7, §10, §14, §14.2): the registries are the
        framework's (moqui.server ReadinessProvider, RefreshOperation and SettingsEntry, read by
        org.moqui.admin.ReadinessServices; mr-moqui plans/archive/Admin-Screens-Down.md A6), which seeds their kinds, the instance's
        own checks (mail, backup, report delivery, administrator factors, job runs, cluster, telemetry, protocols, the
        instance's Constitution) and the settings entries of its System screens. Here: the scopes and the settings group that
        are BOSS's, the settings index's grant to every BOSS user and the readiness exposure. Each owner's registrations
        follow in a block of its own; a place is a key Admin's mount resolves (Admin.js mountRoutes). -->
    <moqui.basic.Enumeration enumId="AdmScOrganization" enumTypeId="AdminRegistryScope" description="Organization" sequenceNum="2"/>
    <moqui.basic.Enumeration enumId="AdmScStore" enumTypeId="AdminRegistryScope" description="Store" sequenceNum="3"/>
    <moqui.basic.Enumeration enumId="AdmScFacility" enumTypeId="AdminRegistryScope" description="Facility" sequenceNum="4"/>
    <moqui.basic.Enumeration enumId="AdmSgCompany" enumTypeId="AdminSettingsGroup" description="Company" sequenceNum="1"/>
    <!-- The Constitution of each organization (impl-admin P2): Mantle's document, read as the viewer by Admin's contract
        service (check#OwnerReadiness, which answers the readiness contract over each owner's own service for the
        organizations the viewer administers); the instance's is the framework's own provider -->
    <moqui.server.ReadinessProvider providerKey="constitution.organization" version="1" ownerApp="Admin"
            title="Organization Constitution" healthGroupEnumId="AdmHgBusiness" scopeEnumId="AdmScOrganization"
            serviceName="ironstone.admin.RegistryServices.check#OwnerReadiness" scopeParameters="organizationPartyId"
            requiredPermission="ADMIN_OVERVIEW_VIEW" sequenceNum="150"/>
    <!-- The settings index alone for every BOSS user (impl-admin F46; design §7, §13): a non-inheritable ALLOW on SettingsHome
        and the root's context (which answers such a user the index's link, the settings' routes and nothing else). The
        index itself is the framework's org.moqui.admin.ReadinessServices.find#Settings, any signed-in user's, which lists
        only the entries whose screen the user's own groups open. The Admin root and every other Admin screen and service
        still refuse them (impl-admin F34: an inheritable grant here would open what is below it). -->
    <artifactGroups artifactGroupId="BOSS_ADM_SETTINGS_INDEX" description="Admin settings index for BOSS users">
        <artifacts artifactName="component://mr-boss/screen/Admin/Settings/SettingsHome.xml" artifactTypeEnumId="AT_XML_SCREEN"
                inheritAuthz="N"/>
        <artifacts artifactName="ironstone.admin.ContextServices.get#SharedContext" artifactTypeEnumId="AT_SERVICE" inheritAuthz="N"/>
        <authz artifactAuthzId="BOSS_ADM_SETTINGS_INDEX_USERS" userGroupId="BOSS_USERS" authzTypeEnumId="AUTHZT_ALLOW"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- Assist (design §1.2, §14): the readiness checks as a read tool for the Assistant and MCP, run with the user's own
        permissions; Health's "What is failing?" prompt is in the Admin root's shell-providers -->
    <moqui.agent.AgentToolExposure toolName="admin_get_readiness" serviceName="org.moqui.admin.ReadinessServices.get#Readiness"
            title="Setup and health readiness"
            description="get#Readiness: the setup and health checks the user may read (mail, backup, report delivery, administrator factors, job runs, cluster, telemetry, accounting setup, catalog quality, store readiness, the Constitution), each with its state (ready, warning, failed, unavailable), message, the organization or store it is for (subject) and the key of the owner's fix place; narrow by providerKey, ownerApp, state, or an organization as scopeParameters {organizationPartyId}. A provider that could not be checked is named in failedProviders."
            classificationEnumId="AgclRead" exposeAssistant="Y" exposeMcp="Y" previewMode="none" lockVersion="1"/>
    <!-- Accounting's registrations (owner contract, impl-admin F16; design-accounting): its setup readiness for finance readers,
        called as the viewer, and its settings landing -->
    <moqui.server.ReadinessProvider providerKey="accounting.setup" version="1" ownerApp="Accounting" title="Accounting setup"
            healthGroupEnumId="AdmHgBusiness" scopeEnumId="AdmScOrganization"
            serviceName="ironstone.admin.RegistryServices.check#OwnerReadiness" scopeParameters="organizationPartyId"
            fixRoute="accountingSetup" sequenceNum="110"/>
    <moqui.server.SettingsEntry settingsKey="accounting.settings" version="1" ownerApp="Accounting" title="Accounting settings"
            description="Preferences, posting defaults, payment terms, currencies, payment methods, collection, documents and matching"
            settingsGroupEnumId="AdmSgCompany" scopeEnumId="AdmScOrganization" destinationRoute="accountingSettings"
            screenLocation="component://mr-boss/screen/Accounting/Settings/Settings.xml" configuredBy="Finance administrator"
            providerKey="accounting.setup" sequenceNum="10"/>
    <!-- Products' registrations (owner contract, impl-admin F16; design-products): catalog quality (CatalogChecks) for catalog
        readers, and its settings landing -->
    <moqui.server.ReadinessProvider providerKey="products.catalogChecks" version="1" ownerApp="Products" title="Catalog quality"
            healthGroupEnumId="AdmHgBusiness" scopeEnumId="AdmScOrganization"
            serviceName="ironstone.admin.RegistryServices.check#OwnerReadiness" scopeParameters="organizationPartyId"
            fixRoute="productsCatalogChecks" sequenceNum="120"/>
    <moqui.server.SettingsEntry settingsKey="products.settings" version="1" ownerApp="Products" title="Catalog settings"
            description="Variants, pricing and identification types" settingsGroupEnumId="AdmSgApplications"
            scopeEnumId="AdmScOrganization" destinationRoute="productsSettings"
            screenLocation="component://mr-boss/screen/Products/Settings/Index.xml" configuredBy="Catalog administrator"
            providerKey="products.catalogChecks" sequenceNum="40"/>
    <!-- Commerce's registrations (owner contract, impl-commerce §7, impl-admin F27; design-commerce): store readiness, its
        findings for a Commerce reader and its summary for an administrative reader, and its checkout settings -->
    <moqui.server.ReadinessProvider providerKey="commerce.storeReadiness" version="1" ownerApp="Commerce"
            title="Store readiness" healthGroupEnumId="AdmHgBusiness" scopeEnumId="AdmScStore"
            serviceName="ironstone.admin.RegistryServices.check#OwnerReadiness" scopeParameters="organizationPartyId"
            requiredPermission="ADMIN_OVERVIEW_VIEW" sequenceNum="130"/>
    <moqui.server.SettingsEntry settingsKey="commerce.checkout" version="1" ownerApp="Commerce" title="Checkout settings"
            description="Checkout, carriers, payment methods and tax authorities of the stores"
            settingsGroupEnumId="AdmSgApplications" scopeEnumId="AdmScStore" destinationRoute="commerceCheckoutSettings"
            screenLocation="component://mr-boss/screen/Commerce/Settings/CheckoutSettings.xml" configuredBy="Store manager"
            providerKey="commerce.storeReadiness" sequenceNum="30"/>
    <!-- Customer Service's settings landing (owner contract; design-customer-service) -->
    <moqui.server.SettingsEntry settingsKey="customerService.settings" version="1" ownerApp="Customer Service"
            title="Customer service settings"
            description="Queues, teams, assignment rules, service levels, case types and templates, saved replies, channel routing, return policies and knowledge sources"
            settingsGroupEnumId="AdmSgApplications" scopeEnumId="AdmScOrganization" destinationRoute="customerServiceSettings"
            screenLocation="component://mr-boss/screen/CustomerService/Settings/SettingsHome.xml"
            configuredBy="Customer service administrator or manager" sequenceNum="20"/>
    <!-- Purchasing's settings landing (owner contract; design-purchasing) -->
    <moqui.server.SettingsEntry settingsKey="purchasing.settings" version="1" ownerApp="Purchasing" title="Purchasing settings"
            description="Purchase policy, approval policies and supplier scorecards" settingsGroupEnumId="AdmSgApplications"
            scopeEnumId="AdmScOrganization" destinationRoute="purchasingSettings"
            screenLocation="component://mr-boss/screen/Purchasing/Settings/SettingsHome.xml"
            configuredBy="Purchase administrator" sequenceNum="50"/>
    <!-- Warehouse's settings landing (owner contract; design-warehouse) -->
    <moqui.server.SettingsEntry settingsKey="warehouse.settings" version="1" ownerApp="Warehouse" title="Warehouse settings"
            description="Stock policies, reservation policies and asset pools" settingsGroupEnumId="AdmSgApplications"
            scopeEnumId="AdmScFacility" destinationRoute="warehouseSettings"
            screenLocation="component://mr-boss/screen/Warehouse/Settings/Index.xml" configuredBy="Warehouse manager"
            sequenceNum="60"/>
    <!-- Manufacturing's settings landing (owner contract, impl-admin F21: its ProductionSettings; design-manufacturing) -->
    <moqui.server.SettingsEntry settingsKey="manufacturing.settings" version="1" ownerApp="Manufacturing"
            title="Production settings" description="Production settings and reason codes"
            settingsGroupEnumId="AdmSgApplications" scopeEnumId="AdmScOrganization" destinationRoute="manufacturingSettings"
            screenLocation="component://mr-boss/screen/Manufacturing/Settings/ProductionSettings.xml"
            configuredBy="Production or resource administrator" sequenceNum="70"/>
    <!-- Projects' settings landing (owner contract; design-projects) -->
    <moqui.server.SettingsEntry settingsKey="projects.settings" version="1" ownerApp="Projects" title="Projects settings"
            description="Work item types, workflows, labels, templates, time, billing, code and intake"
            settingsGroupEnumId="AdmSgApplications" scopeEnumId="AdmScOrganization" destinationRoute="projectsSettings"
            screenLocation="component://mr-boss/screen/Projects/Settings/Index.xml" configuredBy="Projects managers"
            sequenceNum="80"/>
    <!-- Comms' entry (owner contract, impl-admin F44): Consent, for contact admins; Comms' own Settings are personal, and its
        shared templates, sending profiles and suppressions are its later work -->
    <moqui.server.SettingsEntry settingsKey="comms.consent" version="1" ownerApp="Comms" title="Consent and subscriptions"
            description="Whether contacts may be solicited, their list subscriptions and the history behind them"
            settingsGroupEnumId="AdmSgApplications" scopeEnumId="AdmScInstance" destinationRoute="commsConsent"
            screenLocation="component://mr-boss/screen/Comms/Consent/List.xml" viewPermission="CONTACT_ADMIN"
            configuredBy="Contact admins" sequenceNum="90"/>
    <!-- Voice (BasicComms System › Voice, VoiceAdmin): the phone system, in the Tools System app -->
    <moqui.server.SettingsEntry settingsKey="voice.system" version="1" ownerApp="Voice" title="Voice"
            description="Trunks, numbers, caller IDs, ring groups, IVR menus and queues" settingsGroupEnumId="AdmSgInstance"
            scopeEnumId="AdmScInstance" destinationRoute="voice" screenLocation="component://tools/screen/System.xml"
            viewPermission="VoiceAdmin" configuredBy="Phone system administrator" sequenceNum="100"/>
    <!-- Insights P2 (impl-insights P2, F32; the P1 review's "For the lead"): every ReportServices operation is denied to the root
        user group and the administrator, so an operation the framework adds is refused from any Insights screen until a capability
        group is granted it (fail closed); the reading (BOSS_INS_REPORT_READ), authoring, scheduling and dataset grants above are
        ALWAYS and pass the deny. run#ScheduledReport is anonymous-all, outside authorization. -->
    <artifactGroups artifactGroupId="BOSS_INS_REPORT_ENGINE" description="Insights: report engine operations, refused unless granted">
        <artifacts artifactName="org\.moqui\.report\.ReportServices\..*" artifactTypeEnumId="AT_SERVICE" nameIsPattern="Y"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_ENGINE_ROOTDENY" userGroupId="BOSS_INSIGHTS"
                authzTypeEnumId="AUTHZT_DENY" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_REPORT_ENGINE_ADMINDENY" userGroupId="BOSS_INSIGHTS_ADMIN"
                authzTypeEnumId="AUTHZT_DENY" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- Insights P2 (design-insights §1.1, §4): the definition editors, DashboardEditor and PanelDetail (mounts of the framework
        Definition screen), are the author's and the dataset steward's: the root user group and the administrator are denied them
        and the authors' ALWAYS passes the deny, as an area's (impl-commerce F45). The ALWAYS is not inheritable (an inheritable
        one would pass every deny below it, the engine's included; the P2 review, R3): it opens the screens and their authoring
        transitions by name (save, copy, restore, delete, export, reference, dashboard), a transition not named is refused, and
        each engine operation under them is checked by its own grant above. Every other Insights mount (Dashboards, Dashboard,
        Library panels, Wall display, Explore, Compare) is open to every Insights user by the root's ALLOW, with the engine's
        operations as granted above. -->
    <artifactGroups artifactGroupId="BOSS_INS_AUTHORING" description="Insights: the dashboard and panel editors">
        <artifacts artifactName="component://mr-boss/screen/Insights/(DashboardEditor|PanelDetail)\.xml" artifactTypeEnumId="AT_XML_SCREEN"
                nameIsPattern="Y" inheritAuthz="N"/>
        <artifacts artifactName="component://mr-boss/screen/Insights/(DashboardEditor|PanelDetail)\.xml/(save|copy|restore|delete|export|reference|dashboard)"
                artifactTypeEnumId="AT_XML_SCREEN_TRANS" nameIsPattern="Y" inheritAuthz="N"/>
        <authz artifactAuthzId="BOSS_INS_AUTHORING_ROOTDENY" userGroupId="BOSS_INSIGHTS"
                authzTypeEnumId="AUTHZT_DENY" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_AUTHORING_ADMINDENY" userGroupId="BOSS_INSIGHTS_ADMIN"
                authzTypeEnumId="AUTHZT_DENY" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_INS_AUTHORING_AUTHOR" userGroupId="BOSS_INSIGHTS_AUTHOR"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_INS_AUTHORING_DATA" userGroupId="BOSS_INSIGHTS_DATA"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- Admin P3 (impl-admin P3; design-admin §5, §1.1, §1.2): the Access area (Groups, GroupDetail) for the access administrator
        and the administrator, denying the root user group as the other areas do; the framework's AccessServices check
        ADMIN_ACCESS_VIEW and ADMIN_ACCESS_MANAGE and the delegation rules whatever opens the screens. -->
    <artifactGroups artifactGroupId="BOSS_ADM_ACCESS">
        <artifacts artifactName="component://mr-boss/screen/Admin/Access.xml" artifactTypeEnumId="AT_XML_SCREEN"
                inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_ADM_ACCESS_DENY" userGroupId="BOSS_ADMIN"
                authzTypeEnumId="AUTHZT_DENY" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_ADM_ACCESS_ACCESS" userGroupId="BOSS_ADMIN_ACCESS"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_ADM_ACCESS_ADMIN" userGroupId="BOSS_ADMIN_ADMIN"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
</entity-facade-xml>
