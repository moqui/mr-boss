    <!-- the record links of the palette, Today and notifications for Manufacturing users (runs, operations, methods, routings
        and work centers route through ironstone.manufacturing's scope) -->
    <artifactGroups artifactGroupId="BOSS_MFG_RECORD_LINK">
        <artifacts artifactName="ironstone.commons.PaletteServices.get#RecordLink" artifactTypeEnumId="AT_SERVICE"
                inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_MFG_RECORD_LINK" userGroupId="BOSS_MANUFACTURING" authzTypeEnumId="AUTHZT_ALLOW"
                authzActionEnumId="AUTHZA_VIEW">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_MFG_RECORD_LINK_ADMIN" userGroupId="BOSS_MANUFACTURING_ADMIN"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_VIEW">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- P11: quick create's downtime report (Manufacturing/ReportDowntime) for the operators and supervisors, so the + menu
        offers it to them only; Downtime itself is under Work centers, open to every Manufacturing user to read -->
    <artifactGroups artifactGroupId="BOSS_MFG_REPORT_DOWNTIME">
        <artifacts artifactName="component://mr-boss/screen/Manufacturing/ReportDowntime.xml" artifactTypeEnumId="AT_XML_SCREEN"
                inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_MFG_ReportDowntime_DENY" userGroupId="BOSS_MANUFACTURING" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_MFG_ReportDowntime_OPERATE" userGroupId="BOSS_MANUFACTURING_OPERATE"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_MFG_ReportDowntime_SUPERVISE" userGroupId="BOSS_MANUFACTURING_SUPERVISE"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_MFG_ReportDowntime_ADMIN" userGroupId="BOSS_MANUFACTURING_ADMIN"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- an inspection's decision (Mantle's QualityInspectionDecision, impl-warehouse P8) opens the inspection: a production
        inspection in Manufacturing's Quality (impl-manufacturing P8, F-P8-2), any other in Warehouse -->
    <moqui.security.user.NotificationTopic topic="QualityInspectionDecision"
            linkTemplate="/qapps/${inspectionContextEnumId == 'QicProduction' ? 'Manufacturing/Quality' : 'Warehouse'}/QualityInspection?qualityInspectionId=${qualityInspectionId}"/>
    <!-- due counts (Mantle's notify#DueCounts, impl-warehouse P10) open the Due saved find of the facility -->
    <moqui.security.user.NotificationTopic topic="WarehouseCountsDue"
            linkTemplate="/qapps/Warehouse/Counts/Counts?view=due&amp;facilityId=${facilityId}"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PRODUCTS" userPermissionId="PRODUCT_CATALOG_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PRODUCTS_CATALOG_EDIT" userPermissionId="PRODUCT_CATALOG_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PRODUCTS_CATALOG_EDIT" userPermissionId="PRODUCT_CATALOG_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PRODUCTS_ADMIN" userPermissionId="PRODUCT_CATALOG_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PRODUCTS_ADMIN" userPermissionId="PRODUCT_CATALOG_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_ACCOUNTING_ADMIN" userPermissionId="ACCOUNTING_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_ACCOUNTING_ADMIN" userPermissionId="ACCOUNTING_GL_POST" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_ACCOUNTING_ADMIN" userPermissionId="PRODUCT_COST_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PURCHASING_ADMIN" userPermissionId="STOCK_POLICY_PLAN" fromDate="0"/>
    <moqui.security.user.NotificationTopic topic="CatalogImportResult" inboxEnumId="NinUpdates" description="Catalog import results" titleTemplate="${title}" showAlert="N" persistOnSend="Y" receiveNotifications="Y" emailNotifications="N" isPrivate="Y" typeString="info"/>
    <!-- Manufacturing P2: the method release requests (mr-mantle 15-seed-initial/Accounting.xml) open the method in Manufacturing -->
    <moqui.security.user.NotificationTopic topic="BomRelease"
            linkTemplate="/qapps/Manufacturing/BillsOfMaterials/BillOfMaterialsDetail?productBomId=${productBomId}"/>
    <moqui.security.user.NotificationTopic topic="RoutingRelease"
            linkTemplate="/qapps/Manufacturing/Routings/RoutingDetail?workEffortId=${workEffortId}"/>
    <!-- Manufacturing P5a: the release notice and the staged release requests open the work order -->
    <moqui.security.user.NotificationTopic topic="ProductionRelease"
            linkTemplate="/qapps/Manufacturing/WorkOrders/WorkOrderDetail?workEffortId=${workEffortId}"/>
    <moqui.security.user.NotificationTopic topic="ProductionStagedRelease"
            linkTemplate="/qapps/Manufacturing/WorkOrders/WorkOrderDetail?workEffortId=${workEffortId}"/>
    <!-- Manufacturing P5b: the shortage notice opens the work order's Components -->
    <moqui.security.user.NotificationTopic topic="ProductionShortage"
            linkTemplate="/qapps/Manufacturing/WorkOrders/WorkOrderDetail/Components?workEffortId=${workEffortId}"/>
    <!-- Manufacturing P7: a loss above its reason's threshold and output beyond the overproduction tolerance, decided on the
        work order's Quantities tab -->
    <moqui.security.user.NotificationTopic topic="ProductionLossApproval"
            linkTemplate="/qapps/Manufacturing/WorkOrders/WorkOrderDetail/Quantities?workEffortId=${workEffortId}"/>
    <moqui.security.user.NotificationTopic topic="ProductionOverproduction"
            linkTemplate="/qapps/Manufacturing/WorkOrders/WorkOrderDetail/Quantities?workEffortId=${workEffortId}"/>
    <!-- Manufacturing P8: the quality-block notice (a production inspection verified with a rejection) opens the work order's
        Quality tab -->
    <moqui.security.user.NotificationTopic topic="ProductionQualityBlock"
            linkTemplate="/qapps/Manufacturing/WorkOrders/WorkOrderDetail/Quality?workEffortId=${workEffortId}"/>
    <!-- Manufacturing P9: a substitute decided on the work order's Components, an amendment reviewed on its Changes tab -->
    <moqui.security.user.NotificationTopic topic="ProductionSubstitution"
            linkTemplate="/qapps/Manufacturing/WorkOrders/WorkOrderDetail/Components?workEffortId=${workEffortId}"/>
    <moqui.security.user.NotificationTopic topic="ProductionAmendment"
            linkTemplate="/qapps/Manufacturing/WorkOrders/WorkOrderDetail/Changes?workEffortId=${workEffortId}"/>

    <!-- Manufacturing P14 (impl-manufacturing §4): the buyer's permissions, which Purchasing's buyer group holds when
        Purchasing is built (its P1 adds SUPPLIER_SCORECARD_EDIT): the purchase order edit that converts outside processing to
        a draft service line, bill import, the buyer fields of a supplier profile and the return authorization; all four to
        the Purchasing administrator. Both also read supplier prices (SUPPLIER_PRICE_VIEW), which pricing a converted line
        through the shared resolver needs, so the buyer group converts on its own (P14 review). -->
    <moqui.security.UserGroupPermission userGroupId="BOSS_PURCHASING_BUYER" userPermissionId="SUPPLIER_PRICE_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PURCHASING_ADMIN" userPermissionId="SUPPLIER_PRICE_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PURCHASING_BUYER" userPermissionId="PURCHASE_ORDER_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PURCHASING_BUYER" userPermissionId="PAYABLE_IMPORT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PURCHASING_BUYER" userPermissionId="SUPPLIER_PROFILE_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PURCHASING_BUYER" userPermissionId="RETURN_AUTHORIZE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PURCHASING_ADMIN" userPermissionId="PURCHASE_ORDER_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PURCHASING_ADMIN" userPermissionId="PAYABLE_IMPORT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PURCHASING_ADMIN" userPermissionId="SUPPLIER_PROFILE_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PURCHASING_ADMIN" userPermissionId="RETURN_AUTHORIZE" fromDate="0"/>

    <!-- Manufacturing P12: an override request opens the schedule on it; a schedule change the operation in its work order -->
    <moqui.security.user.NotificationTopic topic="ProductionScheduleOverride"
            linkTemplate="/qapps/Manufacturing/Planning/ProductionSchedule?scheduleChangeId=${scheduleChangeId}"/>
    <moqui.security.user.NotificationTopic topic="ProductionScheduleChange"
            linkTemplate="/qapps/Manufacturing/WorkOrders/WorkOrderDetail/Operations?workEffortId=${workEffortId}&amp;selectedOperationId=${operationWorkEffortId}"/>
</entity-facade-xml>
