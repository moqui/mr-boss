            fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MANUFACTURING_METHOD_APPROVE"
            userPermissionId="PRODUCT_CATALOG_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MANUFACTURING_OPERATE" userPermissionId="PRODUCT_CATALOG_VIEW"
            fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MANUFACTURING_SUPERVISE" userPermissionId="PRODUCT_CATALOG_VIEW"
            fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MANUFACTURING_QUALITY_INSPECT"
