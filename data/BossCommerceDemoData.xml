<entity-facade-xml type="demo">
    <!-- Commerce's demo stores (impl-commerce P1, F17; §4): POPC_DEFAULT, Mantle's store of Ziziwork Retail (ZcaProductDemoData.xml),
        completed as the demo store, and BOSS_COM_DIGITAL, Ziziwork Services' store of digital items and subscriptions (P6, P12),
        the other organization's store for isolation. The store-limited staff member's StoreStaff row and the two PASS sites
        are in BossZCommerceDemoData.xml, after the users. Published products arrive with P3. -->

    <!-- POPC_DEFAULT: its warehouse as a dated store facility (the store's inventoryFacilityId already names ZIRET_WH), the
        ship options of its local gateway's carrier (every method _NA_ offers, so the store's options are as before), the
        shipping-label settings, and email bindings for the automatic types, sent from a demo mailbox on a local sink -->
    <mantle.product.store.ProductStoreFacility productStoreId="POPC_DEFAULT" facilityId="ZIRET_WH" fromDate="1265184000000"
            sequenceNum="1"/>
    <mantle.product.store.ProductStoreShipOption productStoreId="POPC_DEFAULT" carrierPartyId="_NA_" shipmentMethodEnumId="ShMthPickUp"
            sequenceNum="0"/>
    <mantle.product.store.ProductStoreShipOption productStoreId="POPC_DEFAULT" carrierPartyId="_NA_" shipmentMethodEnumId="ShMthGround"
            sequenceNum="1"/>
    <mantle.product.store.ProductStoreShipOption productStoreId="POPC_DEFAULT" carrierPartyId="_NA_" shipmentMethodEnumId="ShMthNextDay"
            sequenceNum="2"/>
    <mantle.product.store.ProductStoreSetting productStoreId="POPC_DEFAULT" settingTypeEnumId="PsstShipLabelCompany"
            fromDate="1265184000000" settingValue="Ziziwork Retail"/>
    <mantle.product.store.ProductStoreSetting productStoreId="POPC_DEFAULT" settingTypeEnumId="PsstShipLabelName"
            fromDate="1265184000000" settingValue="Ziziwork Retail Store"/>
    <moqui.basic.email.EmailServer emailServerId="BOSS_COM_DEMO_MAIL" smtpHost="127.0.0.1" smtpPort="9" smtpStartTls="N" smtpSsl="N"/>
    <moqui.basic.email.EmailTemplate emailTemplateId="BOSS_COM_STORE_NOTICE" description="Ziziwork Retail Store notice"
            emailServerId="BOSS_COM_DEMO_MAIL" fromAddress="store@retail.example" subject="Your Ziziwork Retail Store order"
            bodyScreenLocation="component://framework/screen/ScreenRenderEmail.xml"/>
    <mantle.product.store.ProductStoreEmail productStoreId="POPC_DEFAULT" emailTypeEnumId="PsetOrderPlaced" fromDate="1265184000000"
            emailTemplateId="BOSS_COM_STORE_NOTICE"/>
    <mantle.product.store.ProductStoreEmail productStoreId="POPC_DEFAULT" emailTypeEnumId="PsetOrderApproved" fromDate="1265184000000"
            emailTemplateId="BOSS_COM_STORE_NOTICE"/>
    <mantle.product.store.ProductStoreEmail productStoreId="POPC_DEFAULT" emailTypeEnumId="PsetShipmentShipped" fromDate="1265184000000"
            emailTemplateId="BOSS_COM_STORE_NOTICE"/>
    <mantle.product.store.ProductStoreEmail productStoreId="POPC_DEFAULT" emailTypeEnumId="PsetShipmentDelivered" fromDate="1265184000000"
            emailTemplateId="BOSS_COM_STORE_NOTICE"/>
    <mantle.product.store.ProductStoreEmail productStoreId="POPC_DEFAULT" emailTypeEnumId="PsetInvoiceFinalized" fromDate="1265184000000"
            emailTemplateId="BOSS_COM_STORE_NOTICE"/>

    <!-- BOSS_COM_DIGITAL: Ziziwork Services' digital store, no warehouse (it requires no inventory) and no ship options; its
        checkout and recurring offers arrive with P6 and P12 -->
    <mantle.product.store.ProductStore productStoreId="BOSS_COM_DIGITAL" storeName="Ziziwork Digital Store"
            organizationPartyId="ORG_ZIZI_SERVICES" defaultLocale="en_US" defaultCurrencyUomId="USD" requireInventory="N"
            reservationOrderEnumId="AsResOrdNoRes"/>

    <!-- P3: POPC_DEFAULT's published assortment, dated rows of ProductStoreProduct (impl-commerce §4): the demo's stocked
        products; Demo with Variants (DEMO_VAR) is left for a publisher to publish with its variants -->
    <mantle.product.store.ProductStoreProduct productStoreId="POPC_DEFAULT" productId="DEMO_1_1" fromDate="1265184000000"
            publicationKindEnumId="PspkPublished" changeReason="Demo assortment" featuredRank="1"/>
    <mantle.product.store.ProductStoreProduct productStoreId="POPC_DEFAULT" productId="DEMO_1_2" fromDate="1265184000000"
            publicationKindEnumId="PspkPublished" changeReason="Demo assortment"/>
    <mantle.product.store.ProductStoreProduct productStoreId="POPC_DEFAULT" productId="DEMO_2_1" fromDate="1265184000000"
            publicationKindEnumId="PspkPublished" changeReason="Demo assortment"/>
    <mantle.product.store.ProductStoreProduct productStoreId="POPC_DEFAULT" productId="DEMO_3_1" fromDate="1265184000000"
            publicationKindEnumId="PspkPublished" changeReason="Demo assortment"/>
    <mantle.product.store.ProductStoreProduct productStoreId="POPC_DEFAULT" productId="DEMO_UNIT" fromDate="1265184000000"
            publicationKindEnumId="PspkPublished" changeReason="Demo assortment" badgeText="Best seller" featuredRank="2"/>

    <!-- P6: POPC_DEFAULT's checkout. Its card gateway TEST_APPROVE enabled for Ziziwork Retail (PaymentGatewayOrganization, Z4),
        and TEST_DECLINE bound to the organization but disabled, the gateway a store may not take; the support queue its
        customers' requests go to (Customer Service's Support queue, one Retail offers, F37). Its local rates are the walk's:
        Mantle's specs place POPC_DEFAULT orders on the local gateway's default (zero). -->
    <mantle.account.method.PaymentGatewayOrganization organizationPartyId="ORG_ZIZI_RETAIL" paymentGatewayConfigId="TEST_APPROVE"
            fromDate="1265184000000" isEnabled="Y"/>
    <mantle.account.method.PaymentGatewayOrganization organizationPartyId="ORG_ZIZI_RETAIL" paymentGatewayConfigId="TEST_DECLINE"
            fromDate="1265184000000" isEnabled="N"/>
    <mantle.product.store.ProductStoreSetting productStoreId="POPC_DEFAULT" settingTypeEnumId="PsstCheckoutSupportQueue"
            fromDate="1265184000000" settingValue="BOSS_CS_Q_SUPPORT" changeReason="Demo checkout"/>
    <!-- Shop P5 review (F-SP5-4): POPC_DEFAULT's card payments through a test gateway with a hosted page, so the demo's Shop
        checks out (the payer returns from its page; its lookup approves), enabled for Ziziwork Retail. A payment with a
        payment method (Mantle's and Accounting's orders of the store) is approved at once, as TEST_APPROVE did. -->
    <mantle.account.method.PaymentGatewayConfig paymentGatewayConfigId="BOSS_COM_HOSTED" paymentGatewayTypeEnumId="PgtTest"
            description="Local Test: hosted page for Shop, approves a payment with a method"
            authorizeServiceName="mantle.account.PaymentTestServices.hostedPendingOrApprove#PaymentAuthorization"
            captureServiceName="mantle.account.PaymentTestServices.alwaysApprove#PaymentCapture"
            releaseServiceName="mantle.account.PaymentTestServices.alwaysApprove#PaymentRelease"
            refundServiceName="mantle.account.PaymentTestServices.alwaysApprove#PaymentRefund"
            detailsServiceName="mantle.account.PaymentTestServices.hostedOnlyApprove#PaymentDetails"/>
    <mantle.account.method.PaymentGatewayOrganization organizationPartyId="ORG_ZIZI_RETAIL" paymentGatewayConfigId="BOSS_COM_HOSTED"
            fromDate="1265184000000" isEnabled="Y"/>
    <mantle.product.store.ProductStorePaymentGateway productStoreId="POPC_DEFAULT" paymentInstrumentEnumId="PiCreditCard"
            paymentGatewayConfigId="BOSS_COM_HOSTED"/>
</entity-facade-xml>
