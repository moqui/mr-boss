        <artifacts artifactName="org\.moqui\.report\.dataset\.insights-.*" artifactTypeEnumId="AT_SERVICE" nameIsPattern="Y"/>
        <authz artifactAuthzId="BOSS_INS_DATASETS_READ" userGroupId="BOSS_INSIGHTS_READ"
                authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_VIEW"/>
        <authz artifactAuthzId="BOSS_INS_DATASETS_AUTHOR" userGroupId="BOSS_INSIGHTS_AUTHOR"
                authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_VIEW"/>
