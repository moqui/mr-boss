        <authz artifactAuthzId="BOSS_INS_DATASETS_DATA" userGroupId="BOSS_INSIGHTS_DATA"
                authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>
