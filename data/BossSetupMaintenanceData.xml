    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_RESOURCE_ADMIN" userPermissionId="RESOURCE_POLICY_VIEW" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_RESOURCE_ADMIN" userPermissionId="RESOURCE_POLICY_EDIT" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_RESOURCE_ADMIN" userPermissionId="PEOPLE_DIRECTORY_VIEW" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundle userGroupId="BOSS_MAINTENANCE_COST" appName="Maintenance" description="Maintenance cost reader" scopeDependency="organization" sequenceNum="1410"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_COST" userPermissionId="MAINTENANCE_VIEW" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_COST" userPermissionId="MAINTENANCE_COST_VIEW" capabilityKindEnumId="CpkSensitive"/>
    <!-- every group's bundle carries MAINTENANCE_REQUEST and _VIEW_OWN (the user's call, Nov 12, P4 review); Report a problem's screen is in each
        bundle at the end, after its artifact group -->
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_READ" userPermissionId="MAINTENANCE_REQUEST" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_READ" userPermissionId="MAINTENANCE_REQUEST_VIEW_OWN" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_PLAN" userPermissionId="MAINTENANCE_REQUEST" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_PLAN" userPermissionId="MAINTENANCE_REQUEST_VIEW_OWN" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_EXECUTE" userPermissionId="MAINTENANCE_REQUEST" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_EXECUTE" userPermissionId="MAINTENANCE_REQUEST_VIEW_OWN" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_SUPERVISE" userPermissionId="MAINTENANCE_REQUEST" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_SUPERVISE" userPermissionId="MAINTENANCE_REQUEST_VIEW_OWN" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_PROCEDURE" userPermissionId="MAINTENANCE_REQUEST" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_PROCEDURE" userPermissionId="MAINTENANCE_REQUEST_VIEW_OWN" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_PROCEDURE_APPROVE" userPermissionId="MAINTENANCE_REQUEST" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_PROCEDURE_APPROVE" userPermissionId="MAINTENANCE_REQUEST_VIEW_OWN" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_BOOKING_APPROVE" userPermissionId="MAINTENANCE_REQUEST" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_BOOKING_APPROVE" userPermissionId="MAINTENANCE_REQUEST_VIEW_OWN" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_RESOURCE_ADMIN" userPermissionId="MAINTENANCE_REQUEST" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_RESOURCE_ADMIN" userPermissionId="MAINTENANCE_REQUEST_VIEW_OWN" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_COST" userPermissionId="MAINTENANCE_REQUEST" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_COST" userPermissionId="MAINTENANCE_REQUEST_VIEW_OWN" capabilityKindEnumId="CpkView"/>
    <!-- impl-maintenance P15 (design §7.1): the override of a managed resource's soft conflict (where its policy allows, with a reason),
        the resource administrator's and the Maintenance administrator's, in their bundles -->
    <moqui.security.UserGroupPermission userGroupId="BOSS_MAINTENANCE_RESOURCE_ADMIN" userPermissionId="RESOURCE_BOOKING_OVERRIDE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MAINTENANCE_ADMIN" userPermissionId="RESOURCE_BOOKING_OVERRIDE" fromDate="0"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_RESOURCE_ADMIN" userPermissionId="RESOURCE_BOOKING_OVERRIDE" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MAINTENANCE_ADMIN" userPermissionId="RESOURCE_BOOKING_OVERRIDE" capabilityKindEnumId="CpkEdit"/>
    <!-- Maintenance's row in Admin's settings index (owner contract, impl-admin §7, impl-maintenance P1): the Maintenance
        administrator's settings of each organization; its readiness provider (check#MaintenanceReadiness) is set in P18. -->
    <moqui.server.SettingsEntry settingsKey="maintenance.settings" version="1" ownerApp="Maintenance" title="Maintenance settings"
            description="Work policy, teams, lookups and setup readiness" settingsGroupEnumId="AdmSgApplications"
            scopeEnumId="AdmScOrganization" destinationRoute="maintenanceSettings"
            screenLocation="component://mr-boss/screen/Maintenance/Settings.xml" viewPermission="MAINTENANCE_SETTINGS_EDIT"
            configuredBy="Maintenance administrator" sequenceNum="75"/>
    <!-- impl-maintenance P3: the MaintenanceWork topic opens the work order (Mantle seeds the topic and its registration) -->
    <moqui.security.user.NotificationTopic topic="MaintenanceWork" linkTemplate="/qapps/Maintenance/WorkOrders/WorkOrderDetail?workEffortId=${workEffortId}"/>
    <!-- impl-maintenance P3 (owner contract, design-admin §14; F56): Maintenance's lifecycle participant, a leaver's open work order
        assignments and the equipment they hold, read as Projects' are (ADMIN_IDENTITY_VIEW, counts only) and moved through Mantle's
        schedule#MaintenanceWorkOrder and change#MaintenanceCustody, which check the caller's maintenance permissions and the new
        person themselves; Projects' participant leaves managed work out (Lifecycle.js). -->
    <ironstone.admin.LifecycleParticipant participantKey="maintenance.assignments" version="1" ownerApp="Maintenance" title="Maintenance work and equipment"
            description="The open maintenance work orders assigned to the user and the equipment they hold, moved through Maintenance's own services."
            resourceKind="assignment" lookupService="ironstone.maintenance.LifecycleServices.find#Assignments"
            transferService="ironstone.maintenance.LifecycleServices.transfer#Assignments" resourceParameter="assignmentKind"
            requiredPermission="ADMIN_IDENTITY_VIEW" sequenceNum="60"/>
    <!-- Maintenance P4 (impl-maintenance P4, F78; design-maintenance §3 Requests): Report a problem, Commons' quick create of a
        maintenance problem (Commons/ReportProblem), for every Maintenance group (the requesters, the administrator and, by the user's
        call of Nov 12, every capability group): denied to BOSS_USERS, so the + menu offers it to no one else (as Manufacturing's ReportDowntime); Mantle's report#MaintenanceProblem checks
        MAINTENANCE_REQUEST again. The requester follows their reports in Commons' RequestDetail (its Maintenance summary). The
        maintenance planners' triage notice opens Maintenance's RequestDetail (the RequestTriage topic's link above). -->
    <artifactGroups artifactGroupId="BOSS_MNT_REPORT_PROBLEM" description="Maintenance: report a problem (Commons)">
        <artifacts artifactName="component://mr-boss/screen/Commons/ReportProblem.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_MNT_ReportProblem_DENY" userGroupId="BOSS_USERS" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_MNT_ReportProblem_REQUEST" userGroupId="BOSS_MAINTENANCE_REQUEST"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_MNT_ReportProblem_ADMIN" userGroupId="BOSS_MAINTENANCE_ADMIN"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_MNT_ReportProblem_READ" userGroupId="BOSS_MAINTENANCE_READ"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_MNT_ReportProblem_PLAN" userGroupId="BOSS_MAINTENANCE_PLAN"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_MNT_ReportProblem_EXECUTE" userGroupId="BOSS_MAINTENANCE_EXECUTE"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_MNT_ReportProblem_SUPERVISE" userGroupId="BOSS_MAINTENANCE_SUPERVISE"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_MNT_ReportProblem_PROCEDURE" userGroupId="BOSS_MAINTENANCE_PROCEDURE"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_MNT_ReportProblem_PROCEDURE_APPROVE" userGroupId="BOSS_MAINTENANCE_PROCEDURE_APPROVE"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_MNT_ReportProblem_BOOKING_APPROVE" userGroupId="BOSS_MAINTENANCE_BOOKING_APPROVE"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_MNT_ReportProblem_RESOURCE_ADMIN" userGroupId="BOSS_MAINTENANCE_RESOURCE_ADMIN"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_MNT_ReportProblem_COST" userGroupId="BOSS_MAINTENANCE_COST"
                authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- the Requests area (design §3 Requests; impl-maintenance P4 review), the planners' and supervisors', who triage: denied to the
        root user group, as Manufacturing's areas are, and always for the planner and supervisor groups; BOSS_MAINTENANCE_ADMIN and
        ADMIN open it through their ALWAYS on the root. Mantle's find#MaintenanceRequests and triage#MaintenanceRequest check
        MAINTENANCE_PLAN or MAINTENANCE_SUPERVISE again; a requester follows their own reports in Commons. -->
    <artifactGroups artifactGroupId="BOSS_MNT_REQUESTS" description="Maintenance requests">
        <artifacts artifactName="component://mr-boss/screen/Maintenance/Requests.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_MNT_REQUESTS_DENY" userGroupId="BOSS_MAINTENANCE" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_MNT_REQUESTS_PLAN" userGroupId="BOSS_MAINTENANCE_PLAN" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_MNT_REQUESTS_SUPERVISE" userGroupId="BOSS_MAINTENANCE_SUPERVISE" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- Report a problem in every Maintenance bundle (the user's call, Nov 12, P4 review), so a group given a bundle in Admin has it -->
    <moqui.security.CapabilityBundleArtifact userGroupId="BOSS_MAINTENANCE_READ" artifactGroupId="BOSS_MNT_REPORT_PROBLEM" description="Report a problem (Commons)" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL" entityFilterSetIds="MANTLE_USER_ORG,MANTLE_PRIVATE_CONTACT"/>
    <moqui.security.CapabilityBundleArtifact userGroupId="BOSS_MAINTENANCE_REQUEST" artifactGroupId="BOSS_MNT_REPORT_PROBLEM" description="Report a problem (Commons)" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL" entityFilterSetIds="MANTLE_USER_ORG,MANTLE_PRIVATE_CONTACT"/>
    <moqui.security.CapabilityBundleArtifact userGroupId="BOSS_MAINTENANCE_PLAN" artifactGroupId="BOSS_MNT_REPORT_PROBLEM" description="Report a problem (Commons)" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL" entityFilterSetIds="MANTLE_USER_ORG,MANTLE_PRIVATE_CONTACT"/>
    <moqui.security.CapabilityBundleArtifact userGroupId="BOSS_MAINTENANCE_EXECUTE" artifactGroupId="BOSS_MNT_REPORT_PROBLEM" description="Report a problem (Commons)" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL" entityFilterSetIds="MANTLE_USER_ORG,MANTLE_PRIVATE_CONTACT"/>
    <moqui.security.CapabilityBundleArtifact userGroupId="BOSS_MAINTENANCE_SUPERVISE" artifactGroupId="BOSS_MNT_REPORT_PROBLEM" description="Report a problem (Commons)" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL" entityFilterSetIds="MANTLE_USER_ORG,MANTLE_PRIVATE_CONTACT"/>
    <moqui.security.CapabilityBundleArtifact userGroupId="BOSS_MAINTENANCE_PROCEDURE" artifactGroupId="BOSS_MNT_REPORT_PROBLEM" description="Report a problem (Commons)" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL" entityFilterSetIds="MANTLE_USER_ORG,MANTLE_PRIVATE_CONTACT"/>
    <moqui.security.CapabilityBundleArtifact userGroupId="BOSS_MAINTENANCE_PROCEDURE_APPROVE" artifactGroupId="BOSS_MNT_REPORT_PROBLEM" description="Report a problem (Commons)" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL" entityFilterSetIds="MANTLE_USER_ORG,MANTLE_PRIVATE_CONTACT"/>
    <moqui.security.CapabilityBundleArtifact userGroupId="BOSS_MAINTENANCE_BOOKING_APPROVE" artifactGroupId="BOSS_MNT_REPORT_PROBLEM" description="Report a problem (Commons)" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL" entityFilterSetIds="MANTLE_USER_ORG,MANTLE_PRIVATE_CONTACT"/>
    <moqui.security.CapabilityBundleArtifact userGroupId="BOSS_MAINTENANCE_RESOURCE_ADMIN" artifactGroupId="BOSS_MNT_REPORT_PROBLEM" description="Report a problem (Commons)" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL" entityFilterSetIds="MANTLE_USER_ORG,MANTLE_PRIVATE_CONTACT"/>
    <moqui.security.CapabilityBundleArtifact userGroupId="BOSS_MAINTENANCE_COST" artifactGroupId="BOSS_MNT_REPORT_PROBLEM" description="Report a problem (Commons)" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL" entityFilterSetIds="MANTLE_USER_ORG,MANTLE_PRIVATE_CONTACT"/>
    <moqui.security.CapabilityBundleArtifact userGroupId="BOSS_MAINTENANCE_ADMIN" artifactGroupId="BOSS_MNT_REPORT_PROBLEM" description="Report a problem (Commons)" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL" entityFilterSetIds="MANTLE_ACTIVE_ORG,MANTLE_PRIVATE_CONTACT"/>
    <!-- impl-maintenance P6: a procedure waiting for approval (Mantle's WorkProcessApproval topic and its registration) opens
        ProcedureDetail under Maintenance; it is approved or refused from Commons' approvals inbox (approve#WorkProcess and
        refuse#WorkProcess, as the user deciding) or from ProcedureDetail -->
    <moqui.security.user.NotificationTopic topic="WorkProcessApproval"
            linkTemplate="/qapps/Maintenance/Procedures/ProcedureDetail?workEffortId=${workEffortId}"/>
    <!-- impl-maintenance P16: a booking waiting for approval (Mantle's ResourceBooking topic and its registration) opens BookingRequests
        for its resource; it is approved or denied from Commons' approvals inbox (approve#ResourceBooking and refuse#ResourceBooking, as
        the user deciding) or from BookingRequests. What became of a booking (ResourceBookingNotice) opens its event in Commons. -->
    <moqui.security.user.NotificationTopic topic="ResourceBooking"
            linkTemplate="/qapps/Maintenance/Scheduling/BookingRequests?${facilityId ? 'facilityId=' + facilityId : 'assetId=' + assetId}"/>
    <moqui.security.user.NotificationTopic topic="ResourceBookingNotice"
            linkTemplate="/qapps/Commons/Calendar/EventDetail?workEffortId=${workEffortId}"/>
    <!-- impl-maintenance P11: the cost screens (WorkOrderDetail's Costs tab and MaintenanceCostReport), the cost reader's: denied to the
        root user group, as Requests are, and always for the cost reader group, so the tab and the report are in no other user's menu;
        BOSS_MAINTENANCE_ADMIN and ADMIN open them through their ALWAYS on the root. Mantle's get#MaintenanceCosts checks
        MAINTENANCE_COST_VIEW again. The cost reader's bundle carries the grant, so a group given it in Admin opens them. -->
    <artifactGroups artifactGroupId="BOSS_MNT_COSTS" description="Maintenance costs">
        <artifacts artifactName="component://mr-boss/screen/Maintenance/WorkOrders/WorkOrderDetail/Costs.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <artifacts artifactName="component://mr-boss/screen/Maintenance/WorkOrders/MaintenanceCostReport.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_MNT_COSTS_DENY" userGroupId="BOSS_MAINTENANCE" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_MNT_COSTS_COST" userGroupId="BOSS_MAINTENANCE_COST" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <moqui.security.CapabilityBundleArtifact userGroupId="BOSS_MAINTENANCE_COST" artifactGroupId="BOSS_MNT_COSTS" description="Maintenance costs (the Costs tab and the cost report)" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL" entityFilterSetIds="MANTLE_USER_ORG,MANTLE_PRIVATE_CONTACT"/>
</entity-facade-xml>
