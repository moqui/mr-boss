<entity-facade-xml type="seed-initial">
    <!-- Maintenance's setup (impl-maintenance P1 onward), kept apart from BossSetupData.xml so that its appends and People's
        do not meet at the end of one file; named to load after BossSetupData (its groups' ADMIN rows, the BOSS_USERS group and
        the settings group and scope enumerations are there) and after mr-mantle's MaintenanceSetupData (the permissions). The
        client deny pattern rows that name `maintenance` stay in BossSetupData beside the other apps'. -->
    <!-- Maintenance P1 (impl-maintenance P1, F1, F35, F50; design-maintenance §1.1, design-crosscut §1.4): the root user group and
        the capability groups; the administrator group BOSS_MAINTENANCE_ADMIN is above, with its ALWAYS on the root (F1). Groups are
        not nested: a Maintenance user is in BOSS_USERS, BOSS_MAINTENANCE and a capability group, the administrator in BOSS_USERS
        and BOSS_MAINTENANCE_ADMIN. BOSS_MAINTENANCE_REQUEST gets no grant on the root: a requester reports a problem from Commons'
        intake (P4) and has no Maintenance launcher. -->
    <moqui.security.UserGroup userGroupId="BOSS_MAINTENANCE" description="Maintenance app users (the launcher)"/>
    <moqui.security.UserGroup userGroupId="BOSS_MAINTENANCE_READ" description="Maintenance reader"/>
    <moqui.security.UserGroup userGroupId="BOSS_MAINTENANCE_REQUEST" description="Maintenance requester"/>
    <moqui.security.UserGroup userGroupId="BOSS_MAINTENANCE_PLAN" description="Maintenance planner"/>
    <moqui.security.UserGroup userGroupId="BOSS_MAINTENANCE_EXECUTE" description="Maintenance technician"/>
    <moqui.security.UserGroup userGroupId="BOSS_MAINTENANCE_SUPERVISE" description="Maintenance supervisor"/>
    <moqui.security.UserGroup userGroupId="BOSS_MAINTENANCE_PROCEDURE" description="Procedure author"/>
    <moqui.security.UserGroup userGroupId="BOSS_MAINTENANCE_PROCEDURE_APPROVE" description="Procedure approver"/>
    <moqui.security.UserGroup userGroupId="BOSS_MAINTENANCE_BOOKING_APPROVE" description="Resource approver"/>
    <moqui.security.UserGroup userGroupId="BOSS_MAINTENANCE_RESOURCE_ADMIN" description="Resource administrator"/>
    <moqui.security.UserGroup userGroupId="BOSS_MAINTENANCE_COST" description="Maintenance cost reader"/>
    <!-- the root user group's authorization on the Maintenance root and the app's services (ironstone.maintenance: its access,
        context, choices and palette), beside the administrators' rows of the BOSS_MAINTENANCE artifact group above. The root grant
        opens navigation only; each Mantle maintenance service checks the maintenance permissions and scope itself
        (mantle/work/MaintenanceAccess.js), and no raw update#WorkEffort, update#AssetMaintenance or /mantle work or asset REST path
        is granted (impl-maintenance §2). -->
    <artifactGroups artifactGroupId="BOSS_MAINTENANCE" description="IronStone Maintenance App (via root screen)">
        <artifacts artifactName="ironstone\.maintenance\..*" artifactTypeEnumId="AT_SERVICE" nameIsPattern="Y" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_MAINTENANCE_ROOT" userGroupId="BOSS_MAINTENANCE" authzTypeEnumId="AUTHZT_ALLOW"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- the Settings area (design §9), the Maintenance administrator's: denied to the root user group, as People's; BOSS_MAINTENANCE_ADMIN
        and ADMIN open it through their ALWAYS on the root. A later phase that puts another group's editor under Settings allows
        that group here. -->
    <artifactGroups artifactGroupId="BOSS_MNT_SETTINGS" description="Maintenance settings">
        <artifacts artifactName="component://mr-boss/screen/Maintenance/Settings.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_MNT_SETTINGS_DENY" userGroupId="BOSS_MAINTENANCE" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- design §1.1's table (Mantle seeds the permissions, each granted to ADMIN, data/MaintenanceSetupData.xml): the reader
        MAINTENANCE_VIEW and WORK_PROCESS_VIEW; the requester MAINTENANCE_REQUEST and _REQUEST_VIEW_OWN; the planner MAINTENANCE_PLAN
        with the views; the technician MAINTENANCE_ASSIGNED_VIEW and _EXECUTE; the supervisor MAINTENANCE_SUPERVISE with the views;
        the procedure author WORK_PROCESS_EDIT, the approver WORK_PROCESS_APPROVE, each with WORK_PROCESS_VIEW; the resource approver
        RESOURCE_BOOKING_VIEW_ASSIGNED and _APPROVE (with a current BookingApprover assignment, P16); the resource administrator
        FACILITY_EDIT for facility writes, MAINTENANCE_RESOURCE_VIEW and _EDIT, MAINTENANCE_IMPORT for the equipment import (§4) and
        RESOURCE_POLICY_VIEW and _EDIT; the cost reader MAINTENANCE_VIEW and MAINTENANCE_COST_VIEW; the Maintenance administrator
        every MAINTENANCE_*, WORK_PROCESS_* and RESOURCE_* permission, MAINTENANCE_ALL_ORGANIZATIONS (every organization) among
        them, and no stock, facility, payroll or finance authority (the user's calls, impl-maintenance P1 review). The planner, supervisor and resource administrator also hold People's
        PEOPLE_DIRECTORY_VIEW, so Employee360's public work card of a custodian opens for them under Maintenance (impl-maintenance
        F62, P2). -->
