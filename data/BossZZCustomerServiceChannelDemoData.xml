<!-- IronStone Customer Service's channel demo (impl-customer-service P6): in a file of its own, after
    BossZCustomerServiceDemoData.xml (its service mailbox) and BossSetupData.xml (the root user group the text block is shared
    with), so its rows are committed before, and never held against, that file's demo orders (each in a transaction of its own,
    F76). -->
<entity-facade-xml type="demo">
    <!-- Retail's channel routes into the Support queue (Mantle's ServiceRoute; F82: none for Ziziwork Services): mail to the
        service mailbox whose Comms rule names the queue, a new case acknowledged with the service desk's text block (shared with
        every Customer Service user), and the public form with its hourly limit and a 90-day link -->
    <moqui.basic.email.EmailTextBlock emailTextBlockId="BOSS_CS_ACK_SUPPORT" userGroupId="BOSS_CUSTOMER_SERVICE" title="Support acknowledgement"
            bodyHtml="&lt;p&gt;Thank you for writing to Ziziwork Retail. Your case ${requestId}, ${requestName}, is open in our ${queueName} queue; we will answer within one business day.&lt;/p&gt;&lt;p&gt;To add to it, reply to this mail.&lt;/p&gt;"/>
    <mantle.request.support.ServiceRoute serviceRouteId="BOSS_CS_ROUTE_MAIL" organizationPartyId="ORG_ZIZI_RETAIL" channelEnumId="SrcEmail"
            requestCategoryId="BOSS_CS_Q_SUPPORT" emailAccountId="BOSS_CS_SERVICE_MAIL" requestTypeEnumId="RqtSupport" autoGeneratedEnumId="SagAttach" acknowledge="Y"
            ackTextBlockId="BOSS_CS_ACK_SUPPORT" fromDate="0"/>
    <mantle.request.support.ServiceRoute serviceRouteId="BOSS_CS_ROUTE_FORM" organizationPartyId="ORG_ZIZI_RETAIL" channelEnumId="SrcWebForm"
            requestCategoryId="BOSS_CS_Q_SUPPORT" requestTypeEnumId="RqtSupport" autoGeneratedEnumId="SagAttach" acknowledge="N"
            rateLimitPerHour="20" tokenValidDays="90" fromDate="0"/>
</entity-facade-xml>
