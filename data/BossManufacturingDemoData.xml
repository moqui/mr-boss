<entity-facade-xml type="demo">
    <!-- The Manufacturing demo (impl-manufacturing P1) over Mantle's ZIRET_WH (owned by ORG_ZIZI_RETAIL) and its EQUIP_AB4
        assembly robots (F19): two production lines under ZIRET_WH with their WorkCenter rows, so a run on a line nets
        against the warehouse (F16) and ZIRET_WH is Retail's plant; a draft run on a line owned by the organization (F14);
        the skill types (F18; the operator's PartySkill rows are with the users); and a second organization's plant, line
        and run (ORG_ZIZI_SERVICES), which Retail's Manufacturing users never reach. The Warehouse demo's BOSS_WH_RUN (with
        its operation BOSS_WH_RUN_OP, BossWarehouseDemoData.xml) is Retail's released run. The demo users are in
        BossUsersDemoData.xml. Later phases add what their walks need, each in a block named for its phase: P3 line A's
        calendar, capacities, alternate and rate. -->

    <!-- P3: line A's calendar, before the line that names it -->
    <mantle.work.calendar.Calendar calendarId="BOSS_MFG_CAL_LINE_A" ownerPartyId="ORG_ZIZI_RETAIL" calendarName="Line A shifts"
            calendarKindEnumId="CalkResource" color="#2e7d32"/>

    <!-- P1: Retail's lines, under its warehouse -->
    <mantle.facility.Facility facilityId="BOSS_MFG_LINE_A" facilityTypeEnumId="FcTpLine" parentFacilityId="ZIRET_WH"
            ownerPartyId="ORG_ZIZI_RETAIL" facilityName="Assembly line A"/>
    <mantle.work.production.WorkCenter facilityId="BOSS_MFG_LINE_A" plantFacilityId="ZIRET_WH" efficiencyPercent="100"
            oeeTargetPercent="85" schedulingPolicyEnumId="WcspForward" calendarId="BOSS_MFG_CAL_LINE_A" changeReason="Demo line"/>
    <mantle.facility.Facility facilityId="BOSS_MFG_LINE_B" facilityTypeEnumId="FcTpLine" parentFacilityId="ZIRET_WH"
            ownerPartyId="ORG_ZIZI_RETAIL" facilityName="Assembly line B"/>
    <mantle.work.production.WorkCenter facilityId="BOSS_MFG_LINE_B" plantFacilityId="ZIRET_WH" efficiencyPercent="90"
            oeeTargetPercent="80" schedulingPolicyEnumId="WcspForward" changeReason="Demo line"/>
    <!-- P3: line A's calendar (its weekday day shift, a recurring WetAvailable work effort, and a shutdown day), its two
        parallel slots and its rate of 30 DEMO_1_1 an hour, line B as its alternate, and its approved machine rate (which
        only a reader of costs sees) -->
    <mantle.work.effort.WorkEffort workEffortId="BOSS_MFG_LINE_A_SHIFT" workEffortTypeEnumId="WetAvailable" statusId="WeApproved"
            workEffortName="Day shift" visibilityEnumId="WevRestricted" estimatedStartDate="2026-11-02 06:00:00"
            estimatedCompletionDate="2026-11-02 14:00:00" timeUomId="TF_hr" estimatedWorkDuration="8"/>
    <mantle.work.effort.WorkEffortRecurrence workEffortId="BOSS_MFG_LINE_A_SHIFT" rrule="FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR"/>
    <mantle.work.calendar.CalendarWorkEffort calendarId="BOSS_MFG_CAL_LINE_A" workEffortId="BOSS_MFG_LINE_A_SHIFT"/>
    <mantle.work.effort.WorkEffort workEffortId="BOSS_MFG_LINE_A_SHUTDOWN" workEffortTypeEnumId="WetEvent" purposeEnumId="WepHoliday"
            statusId="WeApproved" workEffortName="Line A maintenance shutdown" visibilityEnumId="WevRestricted"
            allDayStart="2026-11-27"/>
    <mantle.work.calendar.CalendarWorkEffort calendarId="BOSS_MFG_CAL_LINE_A" workEffortId="BOSS_MFG_LINE_A_SHUTDOWN"/>
    <mantle.work.production.WorkCenterCapacity workCenterCapacityId="BOSS_MFG_LINE_A_SLOTS" facilityId="BOSS_MFG_LINE_A"
            capacityBasisEnumId="WccbSlots" parallelSlots="2" fromDate="2026-11-01 00:00:00" changeReason="Demo line"/>
    <mantle.work.production.WorkCenterCapacity workCenterCapacityId="BOSS_MFG_LINE_A_RATE" facilityId="BOSS_MFG_LINE_A"
            capacityBasisEnumId="WccbRate" productId="DEMO_1_1" quantity="30" quantityUomId="OTH_ea" perDuration="1"
            durationUomId="TF_hr" fromDate="2026-11-01 00:00:00" changeReason="Demo line"/>
    <mantle.work.production.WorkCenterAlternate workCenterAlternateId="BOSS_MFG_LINE_A_ALT_B" facilityId="BOSS_MFG_LINE_A"
            alternateFacilityId="BOSS_MFG_LINE_B" sequenceNum="1" qualification="Same assembly fixtures"
            fromDate="2026-11-01 00:00:00" changeReason="Demo line"/>
    <mantle.work.production.WorkCenterRate workCenterRateId="BOSS_MFG_LINE_A_MACHINE" facilityId="BOSS_MFG_LINE_A"
            componentTypeEnumId="PccMachine" rateAmount="40" priceUomId="USD" fromDate="2026-11-01 00:00:00" state="approved"
            approvedDate="2026-11-01 00:00:00" changeReason="Demo line"/>

    <!-- P1: a draft run of Retail's on line A, with no lines yet (create#ProductionOrder makes a run's lines) -->
    <mantle.work.effort.WorkEffort workEffortId="BOSS_MFG_RUN_A" workEffortTypeEnumId="WetEvent" purposeEnumId="WepProductionRun"
            statusId="WeInPlanning" facilityId="BOSS_MFG_LINE_A" workEffortName="Demo assemblies"
            ownerPartyId="ORG_ZIZI_RETAIL" estimatedStartDate="2026-11-10 08:00:00"
            estimatedCompletionDate="2026-11-12 17:00:00"/>

    <!-- P1: the skill types of the operators and, from P2, the operation templates' skill standards (F18) -->
    <moqui.basic.Enumeration enumId="BOSS_MFG_SKILL_ASSEMBLY" enumTypeId="SkillType" description="Assembly"/>
    <moqui.basic.Enumeration enumId="BOSS_MFG_SKILL_COATING" enumTypeId="SkillType" description="Coating"/>
    <moqui.basic.Enumeration enumId="BOSS_MFG_SKILL_INSPECTION" enumTypeId="SkillType" description="Production inspection"/>

    <!-- P1: another organization's plant, line and run, for isolation -->
    <mantle.facility.Facility facilityId="BOSS_MFG_SVC_PLANT" facilityTypeEnumId="FcTpPlant" ownerPartyId="ORG_ZIZI_SERVICES"
            facilityName="Services assembly plant"/>
    <mantle.facility.Facility facilityId="BOSS_MFG_SVC_LINE" facilityTypeEnumId="FcTpLine" parentFacilityId="BOSS_MFG_SVC_PLANT"
            ownerPartyId="ORG_ZIZI_SERVICES" facilityName="Services kit line"/>
    <mantle.work.production.WorkCenter facilityId="BOSS_MFG_SVC_LINE" efficiencyPercent="100" changeReason="Demo line"/>
    <mantle.work.effort.WorkEffort workEffortId="BOSS_MFG_SVC_RUN" workEffortTypeEnumId="WetEvent"
            purposeEnumId="WepProductionRun" statusId="WeInPlanning" facilityId="BOSS_MFG_SVC_LINE"
            workEffortName="Services kits" ownerPartyId="ORG_ZIZI_SERVICES" estimatedStartDate="2026-11-11 08:00:00"
            estimatedCompletionDate="2026-11-11 17:00:00"/>

    <!-- P4: Retail's production reason codes (ReasonCodes); no ProductionPolicy row, so every policy value is the built-in
        default and the demo runs keep Mantle's issue guard -->
    <mantle.work.production.ProductionReason organizationPartyId="ORG_ZIZI_RETAIL" reasonCode="SCRAP_DAMAGE"
            fromDate="2026-01-01 00:00:00" reasonName="Damaged in handling" reasonCategoryEnumId="PrcScrap"
            equipmentFault="N" plannedStop="N" approvalThreshold="5" sequenceNum="10" changeReason="Demo reasons"/>
    <mantle.work.production.ProductionReason organizationPartyId="ORG_ZIZI_RETAIL" reasonCode="PROCESS_LOSS"
            fromDate="2026-01-01 00:00:00" reasonName="Normal process loss" reasonCategoryEnumId="PrcProcessLoss"
            equipmentFault="N" plannedStop="N" sequenceNum="20" changeReason="Demo reasons"/>
    <mantle.work.production.ProductionReason organizationPartyId="ORG_ZIZI_RETAIL" reasonCode="ROBOT_FAULT"
            fromDate="2026-01-01 00:00:00" reasonName="Assembly robot fault" reasonCategoryEnumId="PrcDowntime"
            equipmentFault="Y" plannedStop="N" approvalThreshold="60" sequenceNum="30" changeReason="Demo reasons"/>
    <mantle.work.production.ProductionReason organizationPartyId="ORG_ZIZI_RETAIL" reasonCode="CHANGEOVER"
            fromDate="2026-01-01 00:00:00" reasonName="Changeover" reasonCategoryEnumId="PrcDowntime"
            equipmentFault="N" plannedStop="Y" sequenceNum="40" changeReason="Demo reasons"/>
    <mantle.work.production.ProductionReason organizationPartyId="ORG_ZIZI_RETAIL" reasonCode="MATERIAL_HOLD"
            fromDate="2026-01-01 00:00:00" reasonName="Waiting for material" reasonCategoryEnumId="PrcHold"
            equipmentFault="N" plannedStop="N" sequenceNum="50" changeReason="Demo reasons"/>
    <mantle.work.production.ProductionReason organizationPartyId="ORG_ZIZI_RETAIL" reasonCode="METHOD_CHANGE"
            fromDate="2026-01-01 00:00:00" reasonName="Method change" reasonCategoryEnumId="PrcAmendment"
            equipmentFault="N" plannedStop="N" sequenceNum="60" changeReason="Demo reasons"/>
</entity-facade-xml>
