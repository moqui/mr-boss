<entity-facade-xml type="seed-initial">
    <!-- Marketing's setup (impl-marketing P1 onward), kept apart from BossSetupData.xml as Sales' and Maintenance's are
        (impl-marketing F69, §4), so that its appends and Sales' do not meet at the end of one file; named to load after
        BossSetupData (the administrator group BOSS_MARKETING_ADMIN, its and ADMIN's ALWAYS on the root in the BOSS_MARKETING
        artifact group, the BOSS_USERS group) and after mr-mantle's MantleSetupData (the MARKETING_* and MESSAGE_* permissions). The
        client deny pattern rows that name `marketing` stay in BossSetupData beside the other apps'. -->

    <!-- ===== Marketing P1: foundation (impl-marketing P1, F1, F58, F59, F69; design-marketing §1.1, design-crosscut §1.4) ===== -->
    <!-- The root user group and the capability groups (design §1.1); the administrator group BOSS_MARKETING_ADMIN is in
        BossSetupData, with its ALWAYS on the root (F1). Groups are not nested: a Marketing user is in BOSS_USERS, BOSS_MARKETING and
        a capability group, the administrator in BOSS_USERS and BOSS_MARKETING_ADMIN. -->
    <moqui.security.UserGroup userGroupId="BOSS_MARKETING" description="Marketing app users (the launcher)"/>
    <moqui.security.UserGroup userGroupId="BOSS_MARKETING_AUTHOR" description="Marketing author"/>
    <moqui.security.UserGroup userGroupId="BOSS_MARKETING_AUDIENCE" description="Marketing audience manager"/>
    <moqui.security.UserGroup userGroupId="BOSS_MARKETING_APPROVER" description="Marketing approver"/>
    <moqui.security.UserGroup userGroupId="BOSS_MARKETING_DISPATCH" description="Marketing dispatcher"/>
    <moqui.security.UserGroup userGroupId="BOSS_MARKETING_EVENTS" description="Marketing events manager"/>
    <moqui.security.UserGroup userGroupId="BOSS_MARKETING_ANALYST" description="Marketing analyst"/>
    <moqui.security.UserGroup userGroupId="BOSS_MARKETING_READ" description="Marketing reader"/>
    <!-- the root user group's authorization on the Marketing root and the app's services (ironstone.marketing: its context, record
        check, choices and palette), beside the administrators' rows of the BOSS_MARKETING artifact group in BossSetupData. The root
        grant opens navigation only; each Mantle marketing service checks the MARKETING_* permissions and the organization itself
        (mantle/marketing/MarketingAccess.js), and no raw entity write or /mantle REST path of a campaign, list, segment or consent
        is granted (impl-marketing §2). -->
    <artifactGroups artifactGroupId="BOSS_MARKETING" description="IronStone Marketing App (via root screen)">
        <artifacts artifactName="ironstone\.marketing\..*" artifactTypeEnumId="AT_SERVICE" nameIsPattern="Y" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_MARKETING_ROOT" userGroupId="BOSS_MARKETING" authzTypeEnumId="AUTHZT_ALLOW"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- Marketing areas for their capability groups only (impl-marketing §1 P1; impl-commerce F45's pattern): each denies the root
        user group BOSS_MARKETING and allows its groups, with the root's filter sets; the administrator and ADMIN open every area
        through their ALWAYS on the root. The phase that builds an area adds its group here. P1: Settings (design §12), the
        administrator's alone (MARKETING_CONFIGURE); the root's menu shows it to a holder of that permission only, so a custom group
        given Marketing in Admin, which this deny does not reach, is shown no settings its services refuse (impl-maintenance F346's
        lesson). -->
    <artifactGroups artifactGroupId="BOSS_MKT_SETTINGS" description="Marketing settings">
        <artifacts artifactName="component://mr-boss/screen/Marketing/Settings.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_MKT_SETTINGS_DENY" userGroupId="BOSS_MARKETING" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- design §1.1's table (Mantle seeds the permissions, each granted to ADMIN, data/MantleSetupData.xml): the root user group
        MARKETING_VIEW; the author the campaign, send and content edits with Comms' MESSAGE_TEMPLATE_VIEW (authors read templates);
        the audience manager the audience view, edit, import (the audience import target's permission, §4) and export with
        MARKETING_CONSENT_EDIT; the approver MARKETING_APPROVE; the dispatcher MARKETING_DISPATCH (approval and dispatch apart: no
        group holds both but a one-person team under the policy flag of §4, P2 and P9); the events manager MARKETING_EVENT_MANAGE;
        the analyst MARKETING_REPORT_VIEW; the reader MARKETING_VIEW and MARKETING_REPORT_VIEW; the administrator MARKETING_CONFIGURE
        with explicit view and edit grants and MARKETING_ALL_ORGANIZATIONS, and no approval, dispatch, template edit, sending
        configuration or suppression review (design §1.1: "no implicit approval, dispatch, finance or infrastructure authority").
        Comms' MESSAGE_TEMPLATE_EDIT, MESSAGE_SENDING_CONFIGURE and MESSAGE_SUPPRESSION_REVIEW are explicit grants Comms owns: no
        Marketing group holds them (ADMIN does). -->
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING" userPermissionId="MARKETING_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_AUTHOR" userPermissionId="MARKETING_CAMPAIGN_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_AUTHOR" userPermissionId="MARKETING_SEND_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_AUTHOR" userPermissionId="MARKETING_CONTENT_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_AUTHOR" userPermissionId="MESSAGE_TEMPLATE_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_AUDIENCE" userPermissionId="MARKETING_AUDIENCE_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_AUDIENCE" userPermissionId="MARKETING_AUDIENCE_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_AUDIENCE" userPermissionId="MARKETING_AUDIENCE_IMPORT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_AUDIENCE" userPermissionId="MARKETING_AUDIENCE_EXPORT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_AUDIENCE" userPermissionId="MARKETING_CONSENT_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_APPROVER" userPermissionId="MARKETING_APPROVE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_DISPATCH" userPermissionId="MARKETING_DISPATCH" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_EVENTS" userPermissionId="MARKETING_EVENT_MANAGE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_ANALYST" userPermissionId="MARKETING_REPORT_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_READ" userPermissionId="MARKETING_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_READ" userPermissionId="MARKETING_REPORT_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_CAMPAIGN_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_SEND_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_CONTENT_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_AUDIENCE_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_AUDIENCE_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_AUDIENCE_IMPORT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_AUDIENCE_EXPORT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_CONSENT_EDIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_EVENT_MANAGE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_REPORT_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_CONFIGURE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MESSAGE_TEMPLATE_VIEW" fromDate="0"/>
    <!-- MARKETING_ALL_ORGANIZATIONS (as SALES_ALL_ORGANIZATIONS, PEOPLE_ALL_ORGANIZATIONS and MAINTENANCE_ALL_ORGANIZATIONS, the user's
        calls for those apps): the administrator's Marketing scope is every internal organization, as its root's MANTLE_ACTIVE_ORG
        is while none is active; no other group holds it. In its bundle alone. -->
    <moqui.security.UserGroupPermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_ALL_ORGANIZATIONS" fromDate="0"/>
    <!-- Marketing's capability bundles in Admin's registry (owner contract, impl-marketing P1; design-crosscut §1.4's rows, which
        Admin P3 left out as unbuilt): each group with the permissions it carries (view, edit or export) and the root user group's
        launcher with the root's filter sets; MARKETING_AUDIENCE_IMPORT in the audience manager's and the administrator's bundles
        (§4). A phase that grants a group a permission adds it to the group's bundle. -->
    <moqui.security.CapabilityBundle userGroupId="BOSS_MARKETING_ADMIN" appName="Marketing" description="Marketing administrator" scopeDependency="organization" sequenceNum="1600"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_VIEW" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_CAMPAIGN_EDIT" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_SEND_EDIT" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_CONTENT_EDIT" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_AUDIENCE_VIEW" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_AUDIENCE_EDIT" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_AUDIENCE_IMPORT" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_AUDIENCE_EXPORT" capabilityKindEnumId="CpkExport"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_CONSENT_EDIT" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_EVENT_MANAGE" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_REPORT_VIEW" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_CONFIGURE" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MESSAGE_TEMPLATE_VIEW" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_ADMIN" userPermissionId="MARKETING_ALL_ORGANIZATIONS" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundle userGroupId="BOSS_MARKETING" appName="Marketing" description="Marketing app users (the launcher)" scopeDependency="organization" sequenceNum="1610"/>
    <moqui.security.CapabilityBundleArtifact userGroupId="BOSS_MARKETING" artifactGroupId="BOSS_MARKETING" description="Marketing launcher and services" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL" entityFilterSetIds="MANTLE_USER_ORG,MANTLE_PRIVATE_CONTACT"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING" userPermissionId="MARKETING_VIEW" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundle userGroupId="BOSS_MARKETING_AUTHOR" appName="Marketing" description="Marketing author" scopeDependency="organization" sequenceNum="1620"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_AUTHOR" userPermissionId="MARKETING_CAMPAIGN_EDIT" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_AUTHOR" userPermissionId="MARKETING_SEND_EDIT" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_AUTHOR" userPermissionId="MARKETING_CONTENT_EDIT" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_AUTHOR" userPermissionId="MESSAGE_TEMPLATE_VIEW" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundle userGroupId="BOSS_MARKETING_AUDIENCE" appName="Marketing" description="Marketing audience manager" scopeDependency="organization" sequenceNum="1630"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_AUDIENCE" userPermissionId="MARKETING_AUDIENCE_VIEW" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_AUDIENCE" userPermissionId="MARKETING_AUDIENCE_EDIT" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_AUDIENCE" userPermissionId="MARKETING_AUDIENCE_IMPORT" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_AUDIENCE" userPermissionId="MARKETING_AUDIENCE_EXPORT" capabilityKindEnumId="CpkExport"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_AUDIENCE" userPermissionId="MARKETING_CONSENT_EDIT" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundle userGroupId="BOSS_MARKETING_APPROVER" appName="Marketing" description="Marketing approver" scopeDependency="organization" sequenceNum="1640"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_APPROVER" userPermissionId="MARKETING_APPROVE" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundle userGroupId="BOSS_MARKETING_DISPATCH" appName="Marketing" description="Marketing dispatcher" scopeDependency="organization" sequenceNum="1650"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_DISPATCH" userPermissionId="MARKETING_DISPATCH" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundle userGroupId="BOSS_MARKETING_EVENTS" appName="Marketing" description="Marketing events manager" scopeDependency="organization" sequenceNum="1660"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_EVENTS" userPermissionId="MARKETING_EVENT_MANAGE" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.CapabilityBundle userGroupId="BOSS_MARKETING_ANALYST" appName="Marketing" description="Marketing analyst" scopeDependency="organization" sequenceNum="1670"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_ANALYST" userPermissionId="MARKETING_REPORT_VIEW" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundle userGroupId="BOSS_MARKETING_READ" appName="Marketing" description="Marketing reader" scopeDependency="organization" sequenceNum="1680"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_READ" userPermissionId="MARKETING_VIEW" capabilityKindEnumId="CpkView"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_MARKETING_READ" userPermissionId="MARKETING_REPORT_VIEW" capabilityKindEnumId="CpkView"/>
    <!-- Marketing's registrations with Admin (owner contract, impl-marketing P1, §4, F59; design-admin §14.2's Marketing row): the setup
        readiness marketing.setup, called as the viewer (Mantle's get#Readiness checks MARKETING_CONFIGURE and the organization; every
        user may call it, mr-mantle data/MarketingSeedData.xml), and the settings landing. Their places are keys of Admin's mount
        (Admin.js settingsRoutes: marketingSettings, marketingAdoption). -->
    <moqui.server.ReadinessProvider providerKey="marketing.setup" version="1" ownerApp="Marketing" title="Marketing setup"
            healthGroupEnumId="AdmHgBusiness" scopeEnumId="AdmScOrganization"
            serviceName="mantle.marketing.MarketingWorkspaceServices.get#Readiness" scopeParameters="organizationPartyId"
            requiredPermission="MARKETING_CONFIGURE" fixRoute="marketingSettings" sequenceNum="180"/>
    <moqui.server.SettingsEntry settingsKey="marketing.settings" version="1" ownerApp="Marketing" title="Marketing settings"
            description="Adoption of existing campaigns, lists and segments; campaign defaults, vocabularies and sending as they are built"
            settingsGroupEnumId="AdmSgApplications" scopeEnumId="AdmScOrganization" destinationRoute="marketingSettings"
            screenLocation="component://mr-boss/screen/Marketing/Settings.xml" viewPermission="MARKETING_CONFIGURE"
            configuredBy="Marketing administrator" providerKey="marketing.setup" sequenceNum="90"/>
    <!-- ===== end of Marketing P1 ===== -->

    <!-- ===== Marketing P2: campaigns and approvals (impl-marketing P2, F42, F59; design-marketing §3, §14.3) ===== -->
    <!-- Approvals (design §3 Approvals) for the approvers only: the area denies the root user group and allows the approver group with
        the root's filter sets; the administrator and ADMIN open it through their ALWAYS on the root, and its own check asks
        MARKETING_APPROVE (an administrator holds none, so is refused there: approval stays with its group, the user's call of Nov 13) -->
    <artifactGroups artifactGroupId="BOSS_MKT_APPROVALS" description="Marketing approvals">
        <artifacts artifactName="component://mr-boss/screen/Marketing/Campaigns/Approvals.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_MKT_APPROVALS_DENY" userGroupId="BOSS_MARKETING" authzTypeEnumId="AUTHZT_DENY"
                authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="BOSS_MKT_APPROVALS_APPROVER" userGroupId="BOSS_MARKETING_APPROVER" authzTypeEnumId="AUTHZT_ALWAYS"
                authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_USER_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- the approval topics' links (Mantle seeds the topics with their decision services, data/MarketingSeedData.xml): a campaign's
        notice opens its CampaignDetail; a send's (P8) and an automation's (P11) links join with their screens -->
    <moqui.security.user.NotificationTopic topic="MarketingCampaignApproval"
            linkTemplate="/qapps/Marketing/Campaigns/CampaignDetail?marketingCampaignId=${marketingCampaignId}"/>
    <!-- MARKETING_OWNER_CHANGE (as SALES_OWNER_CHANGE, the user's call of Nov 13 for Sales): the transfer of a departing user's campaign
        manager and contributor rows by Marketing's lifecycle participant, held by Admin's identity operator and its administrator; no
        Marketing group holds it. In those groups' bundles. -->
    <moqui.security.UserGroupPermission userGroupId="BOSS_ADMIN_IDENTITY" userPermissionId="MARKETING_OWNER_CHANGE" fromDate="0"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_ADMIN_IDENTITY" userPermissionId="MARKETING_OWNER_CHANGE" capabilityKindEnumId="CpkEdit"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_ADMIN_ADMIN" userPermissionId="MARKETING_OWNER_CHANGE" fromDate="0"/>
    <moqui.security.CapabilityBundlePermission userGroupId="BOSS_ADMIN_ADMIN" userPermissionId="MARKETING_OWNER_CHANGE" capabilityKindEnumId="CpkEdit"/>
    <!-- Marketing's lifecycle participant (owner contract, design-admin §14; §4, F59): a departing user's manager and contributor rows on
        campaigns not completed or cancelled, through Mantle's own services on the owned-resource contract (CampaignServices
        find#OwnedCampaignRoles, transfer#CampaignRole; every user may call them, mr-mantle data/MarketingSeedData.xml), which check
        MARKETING_OWNER_CHANGE and that the successor works for the campaign's organization. Approvals go to the holders of
        MARKETING_APPROVE, not a person, and a scheduled send keeps its own approval: neither is moved. -->
    <ironstone.admin.LifecycleParticipant participantKey="marketing.campaigns" version="1" ownerApp="Marketing" title="Marketing campaigns"
            description="The user's manager and contributor roles on open campaigns, handed to a successor who works for the campaign's organization."
            resourceKind="assignment" lookupService="mantle.marketing.CampaignServices.find#OwnedCampaignRoles"
            transferService="mantle.marketing.CampaignServices.transfer#CampaignRole" resourceParameter="campaignResourceId"
            requiredPermission="MARKETING_OWNER_CHANGE" sequenceNum="85"/>
    <!-- ===== end of Marketing P2 ===== -->
</entity-facade-xml>
