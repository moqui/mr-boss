<!-- Marketing › Leads › LeadRules (design-marketing §10 LeadRules: LeadRuleList; style-guide §3.2 List; impl-marketing P13): the lead
    rules of the user's organizations (mantle.marketing.MarketingFormServices.find#LeadRules: a content author's or the administrator's),
    current ones by default: each lead form with its campaign, the sales team whose queue it fills, the Sales source, the mapping and its
    handoffs (handed off, failed, waiting). New lead rule (a content author's) picks a lead form without one and opens LeadRuleDetail;
    each row opens its rule. P18: New lead rule also routes an event's registrations or attendances (an offer of one occurrence and its
    trigger), whose leads take the attendee's own name and address. Marketing's own context (`marketing`): the Leads area's `sharedLinks` are Sales'. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Lead rules" default-menu-index="3">
    <parameter name="organizationPartyId"/>
    <parameter name="includeEnded"/>
    <transition-include name="choices" location="component://mr-boss/template/MarketingParts.xml"/>
    <!-- New lead rule: the chosen lead form's rule opened (a link: LeadRuleDetail with the publication) -->
    <transition name="newLeadRule">
        <default-response url="../LeadRuleDetail"><parameter name="publicationId"/></default-response>
    </transition>
    <!-- P18: an event offer's rule opened (LeadRuleDetail with the offer and its trigger) -->
    <transition name="newEventLeadRule">
        <default-response url="../LeadRuleDetail"><parameter name="registrationPolicyId"/><parameter name="triggerEnumId"/></default-response>
    </transition>
    <actions>
        <set field="can" from="marketing.capabilities"/>
        <if condition="can.leadRuleRead">
            <service-call name="mantle.marketing.MarketingFormServices.find#LeadRules" out-map="found" transaction="force-new" ignore-error="true"
                    in-map="{organizationPartyId:(organizationPartyId || null), includeEnded:(includeEnded || null)}"/>
            <script>ec.message.clearErrors()</script>
            <service-call name="mantle.marketing.MarketingFormServices.get#LeadRule" out-map="offered" transaction="force-new" ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="ruleList" from="found?.ruleList || []"/>
        <set field="publicationOptions" from="offered?.publicationOptions || []"/>
        <set field="offerOptions" from="offered?.offerOptions || []"/>
        <set field="canEdit" from="!!can.contentEdit"/>
        <set field="detailPath" from="marketing.sharedLinks['Leads/LeadRuleDetail'] || null"/>
        <set field="distributionPath" from="marketing.sharedLinks['Surveys/SurveyDistribution'] || null"/>
        <set field="filtered" from="!!(organizationPartyId || includeEnded)"/>
        <set field="emptyText" from="filtered ? 'No lead rule matches these filters.' : 'No lead form hands its answers to Sales yet'
                + (canEdit ? ' · Route one with New lead rule.' : '.')"/>
    </actions>
    <widgets>
        <label text="Lead rules are the content authors'." type="p" style="m-muted" condition="!can.leadRuleRead"/>
        <section name="LeadRulesRegister" condition="can.leadRuleRead">
            <widgets>
                <container style="row items-center q-col-gutter-sm q-mb-sm">
                    <container style="col">
                        <label text="Lead rules" type="h5"/>
                        <label text="How each lead form's answers become leads in a sales team's queue." type="p" style="text-caption m-muted q-mb-none"/>
                    </container>
                    <container style="col-auto row items-center q-gutter-xs">
                        <container-dialog id="NewLeadRuleDialog" button-text="New lead rule" title="New lead rule" icon="sym_o_alt_route" width="560"
                                type="primary" disable-condition="!canEdit"
                                disable-message="Needs content editing access, which an administrator can grant.">
                            <label text="Publish a lead form from Surveys first; each lead form takes one rule." type="p" style="m-muted"
                                    condition="!publicationOptions.length"/>
                            <section name="NewLeadRuleSection" condition="publicationOptions.length">
                                <widgets>
                                    <form-single name="NewLeadRule" transition="newLeadRule">
                                        <field name="publicationId">
                                            <default-field title="Lead form">
                                                <drop-down allow-empty="false">
                                                    <list-options list="publicationOptions" key="${value}" text="${label}"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="submitButton"><default-field title=""><submit text="Route its answers"/></default-field></field>
                                    </form-single>
                                </widgets>
                            </section>
                            <label text="Or route an event's attendees" type="p" style="text-weight-medium q-mt-md" condition="offerOptions.length"/>
                            <section name="NewEventLeadRuleSection" condition="offerOptions.length">
                                <widgets>
                                    <form-single name="NewEventLeadRule" transition="newEventLeadRule">
                                        <field name="registrationPolicyId">
                                            <default-field title="Event">
                                                <drop-down allow-empty="false"><list-options list="offerOptions" key="${value}" text="${label}"/></drop-down>
                                            </default-field>
                                        </field>
                                        <field name="triggerEnumId">
                                            <default-field title="When">
                                                <radio no-current-selected-key="MltRegistered">
                                                    <option key="MltRegistered" text="They register"/>
                                                    <option key="MltAttended" text="They attend"/>
                                                </radio>
                                            </default-field>
                                        </field>
                                        <field name="submitButton"><default-field title=""><submit text="Route its attendees"/></default-field></field>
                                    </form-single>
                                </widgets>
                            </section>
                        </container-dialog>
                        <link url="." text="Ended too" link-type="anchor-button" icon="sym_o_history" parameter-map="{includeEnded:'Y'}"/>
                    </container>
                </container>
                <container-box>
                    <box-body-nopad>
                        <form-list name="LeadRuleList" list="ruleList" skip-form="true" paginate="false" header-dialog="true">
                            <field name="leadRuleId"><default-field><hidden/></default-field></field>
                            <field name="organizationPartyId">
                                <header-field title="Organization">
                                    <drop-down allow-empty="true">
                                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                                parameter-map="{choice:'organizations', selected:organizationPartyId}"/>
                                    </drop-down>
                                </header-field>
                            </field>
                            <field name="includeEnded">
                                <header-field title="Ended"><check><option key="Y" text="Ended rules too"/></check></header-field>
                            </field>
                            <field name="publicationText">
                                <conditional-field title="Lead form or event" condition="detailPath">
                                    <link url="${detailPath}" text="${publicationText}" link-type="anchor" parameter-map="{leadRuleId:leadRuleId}"/>
                                </conditional-field>
                                <default-field title="Lead form or event"><display/></default-field>
                            </field>
                            <field name="campaignName"><default-field title="Campaign"><display/></default-field></field>
                            <field name="teamName"><default-field title="Sales team"><display/></default-field></field>
                            <field name="sourceText"><default-field title="Source"><display/></default-field></field>
                            <field name="mappingText"><default-field title="Answers to the lead"><display/></default-field></field>
                            <field name="state">
                                <default-field title="State">
                                    <render-mode>
                                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${WebUtilities.encodeHtml(stateText)}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: String(stateText ?? "")})}]]></text>
                                        <text type="html">${stateText}</text>
                                    </render-mode>
                                </default-field>
                            </field>
                            <field name="fromText"><default-field title="From"><display/></default-field></field>
                            <field name="handedOffCount" align="right"><default-field title="Handed off"><display format="#,##0"/></default-field></field>
                            <field name="failedCount" align="right"><default-field title="Failed"><display format="#,##0"/></default-field></field>
                            <field name="pendingCount" align="right"><default-field title="Waiting"><display format="#,##0"/></default-field></field>
                            <columns>
                                <column><field-ref name="publicationText"/><field-ref name="campaignName"/></column>
                                <column><field-ref name="teamName"/><field-ref name="sourceText"/></column>
                                <column><field-ref name="mappingText"/></column>
                                <column><field-ref name="state"/><field-ref name="fromText"/></column>
                                <column><field-ref name="handedOffCount"/></column>
                                <column><field-ref name="failedCount"/></column>
                                <column><field-ref name="pendingCount"/></column>
                            </columns>
                            <columns type="mobile">
                                <column><field-ref name="publicationText"/><field-ref name="teamName"/></column>
                                <column><field-ref name="state"/><field-ref name="failedCount"/></column>
                            </columns>
                        </form-list>
                        <section name="NoLeadRules" condition="!ruleList.length">
                            <widgets>
                                <container style="q-pa-sm">
                                    <label text="${emptyText}" type="p" style="m-muted q-mb-xs"/>
                                    <link url="." text="Clear filters" link-type="anchor" condition="filtered"/>
                                </container>
                            </widgets>
                        </section>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
