<!-- The Surveys area of IronStone Marketing (design-marketing §10, §1.2 "Surveys and leads"; impl-marketing P12): Surveys and SurveyDetail
    (the survey builder's shared Shared/SurveyForms and SurveyFormDetail), SurveyDistribution (Marketing's publications of a form:
    FormPublication, FormSharing, PublishForm, Invitations), Responses and ResponseDetail (the shared Shared/SurveyResponses and
    SurveyResponseDetail with publication scope). The shared screens read Marketing's registration (service/ironstone/shared/SurveyApps.js:
    the survey, lead form and registration purposes, the edit capability contentEdit of Marketing's context, the routes and words). For
    the authors, audience managers, analysts and the administrator (BOSS_MKT_SURVEYS denies the root user group); the area's check asks
    the capability too (surveys). Every read and write is mantle.party.FormDefinitionServices or mantle.marketing.MarketingFormServices,
    which check the purposes' permissions and the organization again. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Surveys" default-menu-index="8" menu-image="sym_o_quiz" menu-image-type="icon">
    <always-actions>
        <script>if(!marketing.capabilities.surveys)throw new Error('PERMISSION_DENIED: Surveys are for the Marketing authors, audience managers and analysts')</script>
    </always-actions>
    <subscreens default-item="Surveys" always-use-full-path="true">
        <subscreens-item name="Surveys" location="component://mr-boss/screen/Shared/SurveyForms.xml" menu-title="Surveys" menu-index="1"/>
        <subscreens-item name="SurveyDetail" location="component://mr-boss/screen/Shared/SurveyFormDetail.xml" menu-include="false"/>
        <subscreens-item name="SurveyDistribution" location="component://mr-boss/screen/Marketing/Surveys/SurveyDistribution.xml" menu-include="false"/>
        <subscreens-item name="Responses" location="component://mr-boss/screen/Shared/SurveyResponses.xml" menu-title="Responses" menu-index="2"/>
        <subscreens-item name="ResponseDetail" location="component://mr-boss/screen/Shared/SurveyResponseDetail.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="MarketingSurveysPanel" type="tab"/>
    </widgets>
</screen>
