<!-- Quick create › Event (design-marketing §14.3 QuickEvent; impl-marketing P16): NewEvent, the Events screen's form, for a holder of
    MARKETING_EVENT_MANAGE: a calendar event the user organizes, with its organization and campaign; it opens the event's
    RegistrationSetup. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="New event" default-menu-include="false">
    <transition-include name="choices" location="component://mr-boss/template/MarketingParts.xml"/>
    <transition-include name="createEvent" location="component://mr-boss/template/MarketingEvents.xml"/>
    <actions>
        <set field="newEventValues" from="{organizationPartyId: marketing.activeOrganizationPartyId || (marketing.organizationPartyIds.length == 1 ? marketing.organizationPartyIds[0] : null), campaignFixed:false}"/>
    </actions>
    <widgets>
        <label text="New event" type="h6"/>
        <label text="You do not create events in Marketing." type="p" style="m-muted" condition="!marketing.capabilities.eventManage"/>
        <section name="NewEventFormShown" condition="marketing.capabilities.eventManage">
            <widgets><section-include name="NewEventForm" location="component://mr-boss/template/MarketingEvents.xml"/></widgets>
        </section>
    </widgets>
</screen>
