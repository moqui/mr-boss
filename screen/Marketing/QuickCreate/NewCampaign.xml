<!-- Quick create › Campaign (design-marketing §14.3 QuickCampaign): NewCampaign, the Campaigns list's form, for a holder of
    MARKETING_CAMPAIGN_EDIT; it opens the new campaign's CampaignDetail. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="New campaign" default-menu-include="false">
    <transition-include name="choices" location="component://mr-boss/template/MarketingParts.xml"/>
    <transition-include name="createCampaign" location="component://mr-boss/template/MarketingCampaigns.xml"/>
    <actions>
        <set field="newDefaults" from="{organizationPartyId: marketing.activeOrganizationPartyId || (marketing.organizationPartyIds.length == 1 ? marketing.organizationPartyIds[0] : null)}"/>
    </actions>
    <widgets>
        <label text="New campaign" type="h6"/>
        <label text="You do not create campaigns in Marketing." type="p" style="m-muted" condition="!marketing.capabilities.campaignEdit"/>
        <section name="NewCampaignFormShown" condition="marketing.capabilities.campaignEdit">
            <widgets><section-include name="NewCampaignForm" location="component://mr-boss/template/MarketingCampaigns.xml"/></widgets>
        </section>
    </widgets>
</screen>
