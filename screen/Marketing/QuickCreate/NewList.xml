<!-- Quick create › List (design-marketing §14.3 QuickList): NewList, the Lists screen's form, for a holder of MARKETING_AUDIENCE_EDIT;
    it opens the new list's ListDetail. The list has no members until requests are filed. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="New list" default-menu-include="false">
    <transition-include name="choices" location="component://mr-boss/template/MarketingParts.xml"/>
    <transition-include name="createList" location="component://mr-boss/template/MarketingAudiences.xml"/>
    <actions>
        <set field="newDefaults" from="{organizationPartyId: marketing.activeOrganizationPartyId || (marketing.organizationPartyIds.length == 1 ? marketing.organizationPartyIds[0] : null)}"/>
    </actions>
    <widgets>
        <label text="New list" type="h6"/>
        <label text="You do not create lists in Marketing." type="p" style="m-muted" condition="!marketing.capabilities.audienceEdit"/>
        <section name="NewListFormShown" condition="marketing.capabilities.audienceEdit">
            <widgets><section-include name="NewListForm" location="component://mr-boss/template/MarketingAudiences.xml"/></widgets>
        </section>
    </widgets>
</screen>
