<!-- The Customers area of IronStone Marketing (design-marketing §10 Customer360 and ContactDetail; impl-marketing P19): the shared
    Customer360 in Marketing's context, hidden from the menu (a lead's account under Leads, an engagement row and the palette open it):
    one page of the contact's engagement with the user's organizations (template/MarketingCustomer360.xml over
    mantle.marketing.MarketingWorkspaceServices.get#Engagement, each source answered with its own permission). The audience readers'
    (design §2: U); the record check is Marketing's (check#Record contact). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Customers" default-menu-include="false" menu-image="sym_o_person_search" menu-image-type="icon">
    <always-actions>
        <script>if(!marketing.capabilities.customerRead)throw new Error('PERMISSION_DENIED: Customers are for Marketing audience readers')</script>
    </always-actions>
    <subscreens default-item="Customer360" always-use-full-path="true">
        <subscreens-item name="Customer360" location="component://mr-boss/screen/Shared/Customer360.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
