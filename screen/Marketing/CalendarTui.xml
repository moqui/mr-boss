<!-- The terminal twin of the campaign calendar (Calendar.xml's tui text is a dynamic container of this screen; design-marketing §3
    Calendar: "the terminal counterpart is the dated agenda"; impl-marketing P21): the four weeks from date (today by default) of
    mantle.marketing.MarketingWorkspaceServices.get#CalendarItems, each item opening its record (a send SendDetail, an event
    EventDetail); Earlier, Today and Later open the calendar four weeks before, today and four weeks after. Read only; a source that
    could not be read is named. Hidden from the menu. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Campaign calendar" default-menu-include="false">
    <parameter name="date"/>
    <actions>
        <set field="firstDay" from="/^\d{4}-\d{2}-\d{2}$/.test(String(date || '')) ? String(date)
                : ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')"/>
        <set field="lastDay" from="new Date(Date.parse(firstDay + 'T12:00:00Z') + 27 * 86400000).toISOString().substring(0, 10)"/>
        <set field="earlierDay" from="new Date(Date.parse(firstDay + 'T12:00:00Z') - 28 * 86400000).toISOString().substring(0, 10)"/>
        <set field="laterDay" from="new Date(Date.parse(firstDay + 'T12:00:00Z') + 28 * 86400000).toISOString().substring(0, 10)"/>
        <if condition="marketing.capabilities.anyRead">
            <service-call name="mantle.marketing.MarketingWorkspaceServices.get#CalendarItems" in-map="{start:firstDay, end:lastDay}"
                    out-map="agenda" transaction="force-new" ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <!-- follow-up 9: a send's link only for who may open SendDetail -->
        <set field="links" from="ec.resource.script('component://mr-boss/service/ironstone/marketing/Marketing.js')"/>
        <set field="agendaRows" from="Array.from(agenda?.items || []).map((item) =&gt; ({when: item.allDay ? item.startDay
                + (item.endDay &amp;&amp; item.endDay &gt; item.startDay ? ' to ' + item.endDay : '') : item.startText,
                title: item.title, state: item.stateText || '', itemUrl: links.placeOf(appRoot, item.route, item.recordParameter, item.recordId, marketing.capabilities) || ''}))"/>
        <set field="failedText" from="Array.from(agenda?.failedSources || []).join(', ')"/>
    </actions>
    <widgets>
        <container style="row items-center q-gutter-sm">
            <label text="Campaign calendar: ${firstDay} to ${lastDay}" type="h6" style="q-my-none"/>
            <link url="../Calendar" link-type="anchor" text="Earlier" parameter-map="{date:earlierDay}"/>
            <link url="../Calendar" link-type="anchor" text="Today"/>
            <link url="../Calendar" link-type="anchor" text="Later" parameter-map="{date:laterDay}"/>
        </container>
        <label text="You read nothing of Marketing's schedule." type="p" style="m-muted" condition="!marketing.capabilities.anyRead"/>
        <label text="The calendar could not be read just now." type="p" style="text-negative" condition="marketing.capabilities.anyRead &amp;&amp; !agenda?.items"/>
        <label text="Could not be read just now: ${failedText}. The rest is shown." type="p" style="text-warning" condition="failedText"/>
        <section name="CampaignAgendaSection" condition="agendaRows.length">
            <widgets>
                <form-list name="CampaignAgenda" list="agendaRows" skip-form="true" paginate="false">
                    <field name="when"><default-field title="When"><display/></default-field></field>
                    <field name="title">
                        <default-field title="What">
                            <link url="${itemUrl}" url-type="plain" text="${title}" link-type="anchor" condition="itemUrl"/>
                            <label text="${title}" condition="!itemUrl"/>
                        </default-field>
                    </field>
                    <field name="state"><default-field title="State"><display/></default-field></field>
                    <columns type="mobile">
                        <column><field-ref name="title"/><field-ref name="when"/></column>
                        <column><field-ref name="state"/></column>
                    </columns>
                </form-list>
            </widgets>
        </section>
        <label text="Nothing is planned in these four weeks." type="p" style="m-muted"
                condition="marketing.capabilities.anyRead &amp;&amp; agenda?.items &amp;&amp; !agendaRows.length"/>
    </widgets>
</screen>
