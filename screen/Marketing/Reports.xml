<!-- The Reports area of IronStone Marketing (design-marketing §11, §1.2; impl-marketing P20): All reports (Catalog, the default, over
    Mantle's get#ReportCatalog, the catalogue Insights' catalog reads for Marketing's entries), CampaignPerformance, DeliveryAnalysis,
    AudienceGrowth and Attribution, each with its CSV and print from the same query. For the report readers (MARKETING_REPORT_VIEW: the
    analysts, the readers and the administrator): BOSS_MKT_REPORTS denies the root user group and gives the analyst and reader groups an
    ALWAYS (data/BossSetupMarketingData.xml); the root's menu shows it to a holder of MARKETING_REPORT_VIEW and the area's check asks the
    capability (reports), so a custom group given Marketing is shown no area its services refuse. Every figure is Mantle's
    mantle.marketing.MarketingReportServices, which checks the permission and the organization again. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Reports" default-menu-index="11" menu-image="sym_o_table_chart" menu-image-type="icon">
    <always-actions>
        <script>if(!marketing.capabilities.reports)throw new Error('PERMISSION_DENIED: Marketing reports are for the report readers')</script>
    </always-actions>
    <subscreens default-item="Catalog" always-use-full-path="true">
        <subscreens-item name="Catalog" location="component://mr-boss/screen/Marketing/Reports/Catalog.xml" menu-index="0"/>
        <subscreens-item name="CampaignPerformance" location="component://mr-boss/screen/Marketing/Reports/CampaignPerformance.xml" menu-index="1"/>
        <subscreens-item name="DeliveryAnalysis" location="component://mr-boss/screen/Marketing/Reports/DeliveryAnalysis.xml" menu-index="2"/>
        <subscreens-item name="AudienceGrowth" location="component://mr-boss/screen/Marketing/Reports/AudienceGrowth.xml" menu-index="3"/>
        <subscreens-item name="Attribution" location="component://mr-boss/screen/Marketing/Reports/Attribution.xml" menu-index="4"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="MarketingReportsPanel" type="tab"/>
    </widgets>
</screen>
