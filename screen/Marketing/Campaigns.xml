<!-- The Campaigns area of IronStone Marketing (design-marketing §3 Campaigns, CampaignDetail, Approvals, §1.2; impl-marketing P2):
    Campaigns (the list and the board by status over one scoped query) and Approvals (Commons' Notifications with Marketing's
    approval topics, the approvers', BOSS_MKT_APPROVALS), in the menu; CampaignDetail and its plan print (CampaignPlan), hidden. Shown
    to a user who reads Marketing (the root's menu condition); every read is Mantle's scoped find and every write Mantle's guarded
    campaign service. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Campaigns" default-menu-index="2" menu-image="sym_o_campaign" menu-image-type="icon">
    <subscreens default-item="Campaigns" always-use-full-path="true">
        <!-- the approvers' (the menu for a holder of MARKETING_APPROVE; the area's deny for the root user group) -->
        <subscreens-item name="Approvals" location="component://mr-boss/screen/Marketing/Campaigns/Approvals.xml" menu-index="2"
                menu-include="ec.user.hasPermission('MARKETING_APPROVE')"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="MarketingCampaignsPanel" type="tab"/>
    </widgets>
</screen>
