<!-- Marketing › Content › BlogPostDetail (design-marketing §8 BlogPostDetail: BlogPost, BlogPostBody, AddCategory, Categories,
    CampaignUse; §18 the blog post; style-guide §3.3 Detail; impl-marketing P14): one blog post the wiki lets the user view (else "Not
    available", linking back). The record header: its title, publish date, author and space, its publication as a chip, the public link
    when the space's blog shows it; Link to campaign the primary action for an author. Post (the metadata, saved through store#BlogPost
    over update#WikiBlog: an author with the wiki's write right to the space), Body (the page's published and current versions and
    its latest review; written, co-edited, reviewed and published in Commons Knowledge, mounted at Content/Knowledge, so the page's
    published version is what a public blog shows), Categories (add and remove, each checking the space's write right before the
    write; the legacy sent date shown, never this app's record of a send) and Campaign use (its links to campaigns, each with its
    sends; a link's ContentDetail drafts a newsletter). A campaign send never sets the publish date or the page's published version. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Blog post" default-menu-include="false">
    <parameter name="wikiBlogId" required="true"/>
    <transition-include name="choices" location="component://mr-boss/template/MarketingParts.xml"/>
    <transition-include name="storeBlogPost" location="component://mr-boss/template/MarketingContent.xml"/>
    <transition-include name="addBlogCategory" location="component://mr-boss/template/MarketingContent.xml"/>
    <transition-include name="removeBlogCategory" location="component://mr-boss/template/MarketingContent.xml"/>
    <transition-include name="storeContent" location="component://mr-boss/template/MarketingContent.xml"/>
    <transition name="blogPosts"><default-response url="../BlogPosts"/></transition>
    <actions>
        <service-call name="mantle.marketing.MarketingContentServices.get#BlogPost" out-map="detail" transaction="force-new" ignore-error="true"
                in-map="{wikiBlogId:wikiBlogId}"/>
        <script>ec.message.clearErrors()</script>
        <set field="recordFound" from="!!detail?.post"/>
        <set field="post" from="detail?.post || {}"/>
        <set field="categories" from="detail?.categories || []"/>
        <set field="campaignUses" from="detail?.campaignUses || []"/>
        <set field="canEdit" from="!!post.canEdit"/>
        <set field="canLink" from="!!marketing.capabilities.contentEdit"/>
        <set field="captionText" from="[post.publishDateText ? 'publishes ' + post.publishDateText : null, post.author ? 'by ' + post.author : null,
                post.spaceName, post.spaceRestricted ? 'private space' : null].filter(Boolean).join(' · ')"/>
        <set field="knowledgePath" from="sharedLinks['Content/Knowledge']"/>
        <set field="contentDetailPath" from="sharedLinks['Content/ContentDetail']"/>
        <set field="postValues" from="{wikiBlogId:wikiBlogId, title:post.title, author:post.author, summary:post.summary, metaKeywords:post.metaKeywords,
                metaDescription:post.metaDescription, expectedLastUpdatedStamp:post.lastUpdatedStamp,
                publishDate:post.publishDate ? ec.l10n.format(post.publishDate, 'yyyy-MM-dd HH:mm') : null}"/>
        <set field="linkContentValues" from="{contentKindEnumId:'CckBlogPost', sourceId:wikiBlogId, kindFixed:true, sourceFixed:true, campaignFixed:false}"/>
        <set field="bodyText" from="(post.publishedVersionName ? 'Published version ' + post.publishedVersionName.substring(0, 10) : 'No published version yet')
                + (post.currentVersionName &amp;&amp; post.currentVersionName != post.publishedVersionName ? '; newest version ' + post.currentVersionName.substring(0, 10) : '')
                + (post.reviewText ? '; review ' + post.reviewText.toLowerCase() : '')"/>
    </actions>
    <widgets>
        <section name="PostNotFound" condition="!recordFound"><widgets>
            <container-box type="warning"><box-header title="Not available"/><box-body>
                <label type="p" text="Blog post ${wikiBlogId} is not available: it does not exist or its page is not one you may read."/>
                <link url="blogPosts" text="Back to blog posts" link-type="anchor"/>
            </box-body></container-box>
        </widgets></section>
        <section name="PostFound" condition="recordFound"><widgets>
            <context record-entity="moqui.resource.wiki.WikiBlog" record-id="${wikiBlogId}" title="${post.title}"/>
            <container style="m-record-header">
                <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                    <container style="col-12 col-md m-record-title">
                        <container style="row items-center no-wrap">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none q-mr-sm text-mono">${WebUtilities.encodeHtml(wikiBlogId)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", id: "PostId", style: "strong", text: wikiBlogId})}]]></text>
                            </render-mode>
                            <label text="${post.title}" type="h5"/>
                        </container>
                        <label text="${captionText}" type="p" style="text-caption m-muted q-mb-none"/>
                    </container>
                    <container style="col-12 col-md-auto m-record-status">
                        <render-mode>
                            <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${post.stateColor}">${WebUtilities.encodeHtml(post.stateText)}</q-chip>]]></text>
                            <text type="tui"><![CDATA[${JSON.stringify({t: "text", id: "PostState", text: post.stateText})}]]></text>
                            <text type="html">${post.stateText}</text>
                        </render-mode>
                    </container>
                </container>
                <container style="row items-center q-col-gutter-x-md q-col-gutter-y-sm m-record-foot">
                    <container style="col-12 col-md">
                        <label text="${post.publicText}" type="span" style="text-caption m-muted"/>
                    </container>
                    <container style="col-12 col-md-auto row items-center q-gutter-xs m-record-actions">
                        <container-dialog id="LinkPostDialog" button-text="Link to campaign" icon="sym_o_add_link" type="primary" width="640"
                                title="Link ${post.title} to a campaign" condition="canLink">
                            <section-include name="LinkContentForm" location="component://mr-boss/template/MarketingContent.xml"/>
                        </container-dialog>
                        <link url="${post.publicUrl}" url-type="plain" text="View the public post" icon="sym_o_open_in_new" link-type="anchor"
                                target-window="_blank" condition="post.publicUrl"/>
                    </container>
                </container>
            </container>

            <container-box>
                <box-header title="Post"/>
                <box-body>
                    <form-single name="BlogPost" transition="storeBlogPost" map="postValues">
                        <field name="wikiBlogId"><default-field><hidden/></default-field></field>
                        <field name="expectedLastUpdatedStamp"><default-field><hidden/></default-field></field>
                        <field name="title">
                            <conditional-field condition="canEdit" title="Title" tooltip="Letters, digits and . , ' - _ : ( ) ! ? only"><text-line size="60"/></conditional-field>
                            <default-field title="Title"><display/></default-field>
                        </field>
                        <field name="author">
                            <conditional-field condition="canEdit" title="Author"><text-line size="30"/></conditional-field>
                            <default-field title="Author"><display/></default-field>
                        </field>
                        <field name="publishDate">
                            <conditional-field condition="canEdit" title="Publish date" tooltip="A public blog shows it from this date"><date-time type="timestamp"/></conditional-field>
                            <default-field title="Publish date"><display text="${post.publishDateText}"/></default-field>
                        </field>
                        <field name="summary">
                            <conditional-field condition="canEdit" title="Summary"><text-area rows="2" cols="60"/></conditional-field>
                            <default-field title="Summary"><display/></default-field>
                        </field>
                        <field name="metaKeywords">
                            <conditional-field condition="canEdit" title="Meta keywords"><text-line size="60"/></conditional-field>
                            <default-field title="Meta keywords"><display/></default-field>
                        </field>
                        <field name="metaDescription">
                            <conditional-field condition="canEdit" title="Meta description" tooltip="At most 160 characters"><text-area rows="2" cols="60" maxlength="160"/></conditional-field>
                            <default-field title="Meta description"><display/></default-field>
                        </field>
                        <field name="submitButton">
                            <conditional-field condition="canEdit" title="Save"><submit/></conditional-field>
                            <default-field><ignored/></default-field>
                        </field>
                        <field-layout>
                            <field-row><field-ref name="title"/><field-ref name="author"/></field-row>
                            <field-ref name="publishDate"/>
                            <field-ref name="summary"/>
                            <field-row><field-ref name="metaKeywords"/><field-ref name="metaDescription"/></field-row>
                            <field-ref name="submitButton"/>
                        </field-layout>
                    </form-single>
                </box-body>
            </container-box>

            <container-box>
                <box-header title="Body"/>
                <box-toolbar>
                    <link url="${knowledgePath}" text="Write in Knowledge" link-type="anchor-button" icon="sym_o_edit_document"
                            parameter-map="{wikiPageId:post.wikiPageId}"/>
                </box-toolbar>
                <box-body>
                    <label type="p" text="${bodyText}"/>
                    <label type="p" style="text-caption m-muted"
                            text="The body is the wiki page ${post.pagePath}: write it, ask for its review and publish a version in Knowledge. A public blog shows the published version from the publish date."/>
                </box-body>
            </container-box>

            <container-box>
                <box-header title="Categories"/>
                <box-toolbar>
                    <container-dialog id="AddCategory" button-text="Add to category" icon="sym_o_add" width="480" title="Put ${post.title} in a category"
                            condition="canEdit">
                        <form-single name="AddCategoryForm" transition="addBlogCategory" map="{wikiBlogId:wikiBlogId}">
                            <field name="wikiBlogId"><default-field><hidden/></default-field></field>
                            <field name="wikiPageCategoryId">
                                <default-field title="Category">
                                    <drop-down allow-empty="false">
                                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                                parameter-map="{choice:'blogCategories', selected:wikiPageCategoryId}"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="submitButton"><default-field title="Add to category"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </box-toolbar>
                <box-body>
                    <label text="In no category. A newsletter takes the approved posts of a category." type="p" style="m-muted" condition="!categories.length"/>
                    <form-list name="Categories" list="categories" skip-form="true" paginate="false" condition="categories.length">
                        <field name="categoryName"><default-field title="Category"><display/></default-field></field>
                        <field name="sentDateText"><default-field title="Sent (legacy)" tooltip="The baseline's mark; a campaign send's recipients are its record"><display/></default-field></field>
                        <field name="remove">
                            <conditional-field condition="canEdit" title="">
                                <link url="removeBlogCategory" text="Remove" icon="sym_o_remove" link-type="hidden-form-link" btn-type="danger"
                                        confirmation="Take ${post.title} out of ${categoryName}?"
                                        parameter-map="{wikiBlogId:wikiBlogId, wikiPageCategoryId:wikiPageCategoryId}"/>
                            </conditional-field>
                            <default-field><display text=""/></default-field>
                        </field>
                        <columns type="mobile">
                            <column><field-ref name="categoryName"/></column>
                            <column><field-ref name="sentDateText"/><field-ref name="remove"/></column>
                        </columns>
                    </form-list>
                </box-body>
            </container-box>

            <container-box>
                <box-header title="Campaign use"/>
                <box-body>
                    <label text="No campaign uses this post." type="p" style="m-muted" condition="!campaignUses.length"/>
                    <form-list name="CampaignUse" list="campaignUses" skip-form="true" paginate="false" condition="campaignUses.length">
                        <field name="campaignName">
                            <default-field title="Campaign">
                                <link url="${contentDetailPath}" text="${campaignName}" link-type="anchor" parameter-map="{campaignContentId:campaignContentId}"/>
                            </default-field>
                        </field>
                        <field name="useText"><default-field title="Use"><display/></default-field></field>
                        <field name="intendedDateText"><default-field title="Intended"><display/></default-field></field>
                        <field name="sendsText"><default-field title="Sends"><display text="${distribution.map((send) =&gt; send.sendName + ' (' + send.statusText + ')').join(', ')}"/></default-field></field>
                        <columns type="mobile">
                            <column><field-ref name="campaignName"/><field-ref name="useText"/></column>
                            <column><field-ref name="intendedDateText"/><field-ref name="sendsText"/></column>
                        </columns>
                    </form-list>
                </box-body>
            </container-box>
        </widgets></section>
    </widgets>
</screen>
