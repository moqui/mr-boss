<!-- IronStone Marketing (design-marketing §1): the root of the app for authors, audience managers, approvers, dispatchers, events
    managers, analysts, readers and administrators. The root user group BOSS_MARKETING and the administrator group
    BOSS_MARKETING_ADMIN open it (data/BossSetupMarketingData.xml, data/BossSetupData.xml), as ADMIN does (impl-marketing F1: the
    grant was live for ADMIN and BOSS_MARKETING_ADMIN before P1, whatever this comment said). The root grant opens navigation only:
    ironstone.marketing.ContextServices.get#SharedContext checks the user and resolves their capabilities, organizations and links
    for every subscreen, and each Mantle marketing service checks the permissions and the organization again
    (mantle/marketing/MarketingAccess.js). The menu of design §1.2 grows by phase and shows built areas only: P1 builds Home (every
    Marketing user's), P2 Campaigns (with Approvals, the approvers'), P3 Audiences (the audience managers') and Leads (Sales' Leads and
    Accounts with the bulk action, a Sales reader's) and Settings (the administrator's, MARKETING_CONFIGURE, BOSS_MKT_SETTINGS); Segments and Newsletters stay as
    redirects of their old links (F2), to Audiences and Sends (P5, P8); Sends gains the sends, SendDetail and Compose (P8); P11 builds
    Automations (the drip sequences, AutomationDetail and EnrollmentDetail; BOSS_MKT_AUTOMATIONS); P12 Surveys (the shared survey builder
    and responses with Marketing's registration, and SurveyDistribution; BOSS_MKT_SURVEYS); P13 LeadRules under Leads (the lead forms'
    routing to Sales and their handoffs, the authors'; BOSS_MKT_LEAD_RULES) and Sales' LeadSources in Settings. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Marketing" menu-image="sym_o_campaign" menu-image-type="icon">

    <always-actions>
        <set field="appRoot" value="Marketing"/>

        <service-call name="mantle.party.PartyServices.setup#UserOrganizationInfo" out-map="context"/>
        <service-call name="ironstone.marketing.ContextServices.get#SharedContext" in-map="{appRoot:appRoot}" out-map="marketing"/>
        <!-- the record panels serve Marketing's own record hosts only (the People P2, Insights P12, Maintenance P1 and Sales P1 mount
            lesson): this root's inheritable grant would otherwise open the notes and files of any record get#RecordLinkInfo admits to
            a user given Marketing without Commons. P2: the campaign, checked by check#Record (a Marketing reader of its
            organization); P8: the send, by check#Record the same way; the event registration (P17) joins with its check (design §14.3). Any other record is
            refused; a panel request with no record (a person search, an avatar) names none. -->
        <script><![CDATA[
            const pathNames = Array.from(sri.getScreenUrlInfo().fullPathNameList || []).map(String)
            const panelName = pathNames[pathNames.indexOf('Marketing') + 1]
            panelRecordType = null
            if ((panelName === 'Chatter' || panelName === 'RecordFiles') && ec.context.recordEntity) {
                const panelHosts = {'mantle.marketing.campaign.MarketingCampaign': 'campaign', 'mantle.marketing.campaign.CampaignSend': 'send'}
                const entityName = String(ec.context.recordEntity)
                if (!Object.hasOwn(panelHosts, entityName))
                    throw new Error('RECORD_PANEL_UNAVAILABLE: Notes and files of this record are kept in the app that owns it')
                panelRecordType = panelHosts[entityName]
            }
        ]]></script>
        <if condition="panelRecordType">
            <service-call name="ironstone.marketing.ContextServices.check#Record" out-map="panelRecord" ignore-error="true"
                    in-map="{appRoot:'Marketing', recordType:panelRecordType, recordId:ec.context.recordId || ''}"/>
            <script>ec.message.clearErrors(); if (!panelRecord?.recordId) throw new Error('RECORD_PANEL_UNAVAILABLE: This record is not available')</script>
        </if>
        <set field="sharedLinks" from="marketing.sharedLinks"/>
    </always-actions>

    <subscreens default-item="Home" always-use-full-path="true">
        <!-- the record panels the chatter and record-files elements load under this app root, hidden from the menu
            (the theme values STRT_CHATTER_SCREEN and STRT_RECORD_FILES_SCREEN; impl-drawers-commons.md R5) -->
        <subscreens-item name="Chatter" location="component://mr-boss/screen/Shared/Chatter.xml" menu-include="false"/>
        <subscreens-item name="RecordFiles" location="component://mr-boss/screen/Shared/RecordFiles.xml" menu-include="false"/>
        <!-- P2: Campaigns (design §3): the campaigns list and board, CampaignDetail, its plan print and Approvals (the approvers',
            BOSS_MKT_APPROVALS), for a user who reads Marketing; Mantle's campaign services scope every read to the organizations -->
        <subscreens-item name="Campaigns" location="component://mr-boss/screen/Marketing/Campaigns.xml" menu-index="2"
                menu-include="ec.user.hasPermission('MARKETING_VIEW') || ec.user.hasPermission('MARKETING_AUDIENCE_VIEW') || ec.user.hasPermission('MARKETING_REPORT_VIEW')"/>
        <!-- P3: Audiences (design §4): lists, members, Comms' Consent and the shared Suppressions, for the audience managers and the
            administrator (BOSS_MKT_AUDIENCES denies the root user group); Mantle's audience, consent and suppression services check the
            permissions and the organization again -->
        <subscreens-item name="Audiences" location="component://mr-boss/screen/Marketing/Audiences.xml" menu-index="3"
                menu-include="ec.user.hasPermission('MARKETING_AUDIENCE_VIEW')"/>
        <!-- P6, P8: Sends (design §5): the sends, SendDetail and Compose, Comms' shared MessageTemplates and MessageTemplateDetail, for
            the authors, approvers, dispatchers and the administrator (BOSS_MKT_SENDS denies the root user group); Mantle's send and
            template services check the permissions and the organization again -->
        <subscreens-item name="Sends" location="component://mr-boss/screen/Marketing/Sends.xml" menu-index="4"
                menu-include="ec.user.hasPermission('MESSAGE_TEMPLATE_VIEW') || ec.user.hasPermission('MESSAGE_TEMPLATE_EDIT') || ec.user.hasPermission('MARKETING_SEND_EDIT') || ec.user.hasPermission('MARKETING_APPROVE') || ec.user.hasPermission('MARKETING_DISPATCH')"/>
        <!-- P11: Automations (design §6): the drip sequences, AutomationDetail and EnrollmentDetail, for the authors, approvers,
            dispatchers, audience managers and the administrator (BOSS_MKT_AUTOMATIONS denies the root user group); Mantle's
            AutomationServices check the permissions and the organization again -->
        <subscreens-item name="Automations" location="component://mr-boss/screen/Marketing/Automations.xml" menu-index="5"
                menu-include="ec.user.hasPermission('MARKETING_SEND_EDIT') || ec.user.hasPermission('MARKETING_APPROVE') || ec.user.hasPermission('MARKETING_DISPATCH') || ec.user.hasPermission('MARKETING_AUDIENCE_VIEW')"/>
        <!-- P12: Surveys (design §10): the survey builder's shared screens with Marketing's registration (SurveyApps.js), SurveyDistribution
            and the responses, for the authors, audience managers, analysts and the administrator (BOSS_MKT_SURVEYS denies the root user
            group); the builder's and Marketing's form services check the purposes' permissions and the organization again -->
        <subscreens-item name="Surveys" location="component://mr-boss/screen/Marketing/Surveys.xml" menu-index="7"
                menu-include="ec.user.hasPermission('MARKETING_CONTENT_EDIT') || ec.user.hasPermission('MARKETING_AUDIENCE_VIEW') || ec.user.hasPermission('MARKETING_REPORT_VIEW')"/>
        <!-- P3: Leads (design §10, F64): Sales' Leads and Accounts in Sales' context for this root, with the bulk "Add to list
            (evidenced)", for a user who reads Sales; Sales' own services decide what they read. P13: and LeadRules, the lead forms'
            routing to Sales, for a content author or the administrator -->
        <subscreens-item name="Leads" location="component://mr-boss/screen/Marketing/Leads.xml" menu-index="8"
                menu-include="ec.user.hasPermission('SALES_VIEW') || ec.user.hasPermission('SALES_TEAM_VIEW') || ec.user.hasPermission('SALES_REPORT_VIEW') || ec.user.hasPermission('MARKETING_CONTENT_EDIT') || ec.user.hasPermission('MARKETING_CONFIGURE')"/>
        <!-- P2: quick create's campaign form (QuickCampaign), hidden from the menu -->
        <subscreens-item name="QuickCreate" location="component://mr-boss/screen/Marketing/QuickCreate.xml" menu-include="false"/>
        <!-- P1: Settings (design §12), the administrator's (MARKETING_CONFIGURE); BOSS_MKT_SETTINGS denies the root user group, and
            Mantle's settings and adoption services check the permission again -->
        <subscreens-item name="Settings" location="component://mr-boss/screen/Marketing/Settings.xml" menu-index="10"
                menu-include="ec.user.hasPermission('MARKETING_CONFIGURE')"/>
        <!-- the old placeholders' links (F2, design §1.2), hidden from the menu: Segments to Audiences › Segments (P5), Newsletters to
            Sends (P8) -->
        <subscreens-item name="Segments" location="component://mr-boss/screen/Marketing/Segments.xml" menu-include="false"/>
        <subscreens-item name="Newsletters" location="component://mr-boss/screen/Marketing/Newsletters.xml" menu-include="false"/>
    </subscreens>

    <!-- P1: the marketing keymap (design §1.2). P2: the palette's campaigns, QuickCampaign, the approval topics and CampaignDetail's
        Assist chip. Quick create's list and event (P3, P16), Today (P8), the Comms providers (record-lookup and call-context, P8,
        P17) and Assist's answer actions (P21) arrive with their records. -->
    <shell-providers>
        <!-- P2: the palette's Marketing records, the campaigns of the user's organizations (ironstone.marketing.ContextServices.search#Records) -->
        <palette-source group="Marketing" label="Marketing records" icon="sym_o_campaign"
                service="ironstone.marketing.ContextServices.search#Records" sequence="52"/>
        <!-- P2 (design §14.3 QuickCreate): QuickCampaign, the Campaigns list's NewCampaign; a user without campaign edit is told so -->
        <quick-create kind="marketingCampaign" label="Campaign" icon="sym_o_campaign" screen="Marketing/QuickCreate/NewCampaign"
                sequence="92"/>
        <!-- P3 (design §14.3 QuickList): the Lists screen's NewList; a user without audience edit is told so -->
        <quick-create kind="marketingList" label="Distribution list" icon="sym_o_contact_mail" screen="Marketing/QuickCreate/NewList"
                sequence="93"/>
        <!-- P2: the approval topics (Mantle's MarketingSeedData; their links BossSetupMarketingData); sends' and automations' are sent
            from P8 and P11 -->
        <notification-topic topic="MarketingCampaignApproval"/>
        <notification-topic topic="MarketingSendApproval"/>
        <notification-topic topic="MarketingAutomationApproval"/>
        <!-- P5 (design §1.3 CX-ASSIST): SegmentDetail's chip, skill/marketing-audience-check.md -->
        <assist-prompt label="Explain this segment" text="Explain this segment: who it finds and by which rule, who it leaves out and why, and what a send to it would still need"
                screen="Marketing/Audiences/SegmentDetail" entity="mantle.marketing.segment.MarketSegment" sequence="65"/>
        <!-- P8 (design §1.3 CX-ASSIST): SendDetail's chip, skill/marketing-prepare-send.md -->
        <assist-prompt label="Why were recipients excluded?" text="Why were recipients of this send excluded? Explain its audience's buckets and what the send still needs before approval"
                screen="Marketing/Sends/SendDetail" entity="mantle.marketing.campaign.CampaignSend" sequence="66"/>
        <!-- P2 (design §1.3 CX-ASSIST): CampaignDetail's chip; its results arrive with the reports (P20) -->
        <assist-prompt label="Summarize this campaign's results" text="Summarize this campaign's results: its plan, budget and actual cost, approvals and what is next"
                screen="Marketing/Campaigns/CampaignDetail" entity="mantle.marketing.campaign.MarketingCampaign" sequence="64"/>
        <keymap scope="marketing">
            <key keys="g m" label="Marketing home" screen="Marketing/Home"/>
            <!-- P2 -->
            <key keys="g c" label="Campaigns" screen="Marketing/Campaigns/Campaigns"/>
            <!-- P3 -->
            <key keys="g l" label="Lists" screen="Marketing/Audiences/Lists"/>
            <!-- P5 -->
            <key keys="g s" label="Segments" screen="Marketing/Audiences/Segments"/>
            <!-- P6 -->
            <key keys="g t" label="Message templates" screen="Marketing/Sends/MessageTemplates"/>
            <!-- P8 -->
            <key keys="g n" label="Sends" screen="Marketing/Sends/Sends"/>
            <!-- P11 -->
            <key keys="g a" label="Automations" screen="Marketing/Automations/Automations"/>
            <!-- P12 -->
            <key keys="g v" label="Surveys" screen="Marketing/Surveys/Surveys"/>
        </keymap>
    </shell-providers>

    <widgets><subscreens-panel id="marketing-panel" type="popup"/></widgets>
</screen>
