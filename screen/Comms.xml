<!-- IronStone Comms, the channels people talk through: root of the app (design-drawers-commons.md §2.2), opening on the
    Inbox. Authorized for ALL_USERS by BOSS_COMMS in data/BossSetupData.xml. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Comms" menu-image="sym_o_forum" menu-image-type="icon">

    <always-actions>
        <set field="appRoot" value="Comms"/>

        <service-call name="mantle.party.PartyServices.setup#UserOrganizationInfo" out-map="context"/>
    </always-actions>

    <subscreens default-item="Inbox" always-use-full-path="true">
        <!-- the record panels the chatter and record-files elements load under this app root, hidden from the menu
            (the theme values STRT_CHATTER_SCREEN and STRT_RECORD_FILES_SCREEN; impl-drawers-commons.md R5) -->
        <subscreens-item name="Chatter" location="component://mr-boss/screen/Shared/Chatter.xml" menu-include="false"/>
        <subscreens-item name="RecordFiles" location="component://mr-boss/screen/Shared/RecordFiles.xml" menu-include="false"/>
        <!-- the screens of the framework's BasicComms, mounted here and extended from screen-extend/basic-comms
            (plans/Comms-Framework.md §3.4) -->
        <subscreens-item name="Home" location="component://basic-comms/screen/BasicComms/Home.xml" menu-title="Home" menu-index="1"/>
        <subscreens-item name="Inbox" location="component://basic-comms/screen/BasicComms/Inbox.xml" menu-title="Inbox" menu-index="2"/>
        <subscreens-item name="Chat" location="component://basic-comms/screen/BasicComms/Chat.xml" menu-title="Chat" menu-index="3"/>
        <subscreens-item name="ChatTui" location="component://basic-comms/screen/BasicComms/ChatTui.xml" menu-include="false"/>
        <subscreens-item name="Calls" location="component://basic-comms/screen/BasicComms/Calls.xml" menu-title="Calls" menu-index="4"/>
        <subscreens-item name="Panel" location="component://basic-comms/screen/BasicComms/Panel.xml" menu-include="false"/>
        <subscreens-item name="Settings" location="component://basic-comms/screen/BasicComms/Settings.xml" menu-title="Settings" menu-index="6"/>
    </subscreens>

    <!-- What Comms offers the suite shell (design-drawers-commons.md §1.5, §1.7): an email and a chat message in the + menu,
        the Messages and rooms group of the palette (mail, internal messages and mailboxes) and its Chat rooms (the # prefix), the
        Inbox go-to key and the notification topics of chat and mail. -->
    <shell-providers>
        <quick-create kind="email" label="Email" icon="sym_o_mail" screen="Comms/Inbox/Compose" sequence="60"/>
        <quick-create kind="chatMessage" label="Chat message" icon="sym_o_chat" screen="Comms/Panel/Chat" sequence="70"/>
        <palette-source group="Messages" label="Messages and rooms" icon="sym_o_forum" service="ironstone.comms.InboxServices.search#Messages" sequence="30"/>
        <palette-source group="Rooms" label="Chat rooms" icon="sym_o_chat" prefix="#" service="org.moqui.comms.ChatScreenServices.search#PaletteRooms" sequence="31"/>
        <notification-topic topic="ChatMention"/>
        <notification-topic topic="NewMail"/>
        <keymap><key keys="g i" label="Inbox" screen="Comms/Inbox"/></keymap>
        <!-- the Internal account and mailboxes in the BasicComms screens (plans/Comms-Framework.md §3.3) -->
        <inbox-source name="boss.internal" service="ironstone.comms.InboxServices.get#InboxSource"/>
        <!-- the records of chat rooms and messages: their cards, filing a message on a record, a task, request or event from it -->
        <record-lookup name="boss.records" service="ironstone.comms.ChatServices.get#RecordLookup"/>
        <record-link name="boss.records" service="ironstone.comms.ChatServices.file#OnRecord"/>
        <create-from name="boss.records" service="ironstone.comms.ChatServices.create#FromChat"/>
        <!-- the user's calendar meetings, for the Calls screen's Meetings (plans/Comms-Framework.md W3) -->
        <meetings-source name="boss.calendar" service="ironstone.comms.CommsHomeServices.get#MeetingsSource"/>
    </shell-providers>

    <widgets><subscreens-panel id="comms-panel" type="popup"/></widgets>
</screen>
