<!-- Sales Home (design-sales §3 Home, §1.2; style-guide §3.1 Landing; impl-sales P1, P6): HomeFilters (the organization, from those of
    the user's sales scope, checked by ironstone.sales.ContextServices.check#Record and shown "not available" when refused); SalesWork,
    the counter strip of mantle.sales.SalesWorkspaceServices.get#SalesHome, each card the count of the scoped list it opens with that
    list's own filters (the leads to work, the user's open opportunities, those past their expected close), a failed one
    "Unavailable", never zero; P8 the requests for quote awaiting a response, P11 the quotes to send, the quotes expiring and the orders
    blocked (awaiting approval or held);
    AssignedWork, the user's own open leads and opportunities with their next activity; MyPipeline, the user's open opportunities
    (Mantle's find#Opportunities, the same query as Opportunities) by stage; PipelineFunnel, the funnel panel of the shipped dashboard
    report/boss-sales-pipeline.json over the pipeline dataset, whose row filter is Sales' scope, through report-embed (rendered for
    the viewer, so Home declares no server-static template: impl-sales F66), a table in html and print and text bars in the
    terminal. New opportunity is the primary action; New lead, Schedule activity and Import (a manager's) beside it. A Sales user who
    reads nothing of Sales (an edit permission alone) is told what Home holds; a report reader gets the Sales summary shortcut. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Home" default-menu-index="1" menu-image="sym_o_dashboard" menu-image-type="icon">
    <parameter name="organizationPartyId"/>
    <transition-include name="choices" location="component://mr-boss/template/SalesParts.xml"/>
    <actions>
        <set field="can" from="sales.capabilities"/>
        <if condition="can.anyRead &amp;&amp; organizationPartyId">
            <service-call name="ironstone.sales.ContextServices.check#Record" out-map="organizationRecord" transaction="force-new"
                    ignore-error="true" in-map="{appRoot:appRoot, recordType:'organization', recordId:organizationPartyId}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="organizationRefused" from="!!organizationPartyId &amp;&amp; !organizationRecord?.recordId"/>
        <set field="scope" from="{organizationPartyId: organizationPartyId || null}"/>
        <set field="scopeText" from="organizationRecord?.label || (sales.allOrganizations ? 'Every organization' : 'Your organizations')"/>
        <set field="shownOrganizationId" from="organizationRefused ? null : (organizationPartyId || null)"/>
        <if condition="can.anyRead &amp;&amp; !organizationRefused">
            <service-call name="mantle.sales.SalesWorkspaceServices.get#SalesHome" out-map="home" transaction="force-new"
                    ignore-error="true" in-map="{organizationPartyId:shownOrganizationId}"/>
            <script>ec.message.clearErrors()</script>
            <service-call name="mantle.sales.OpportunityServices.find#Opportunities" out-map="pipeline" transaction="force-new"
                    ignore-error="true" in-map="{typeEnumId:'SotOpportunity', mine:'Y', statusId:'SalesOppOpen', organizationPartyId:shownOrganizationId,
                        orderByField:'estimatedCloseDate', pageSize:10}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <!-- each counter's card: its count (Unavailable or Not configured otherwise) and the link to its list with the list's filters -->
        <set field="counterOf" from="Object.fromEntries(Array.from(home?.counters || []).map(counter =&gt; [counter.counterKey, Object.assign({}, counter, {
                link: counter.state == 'ready' &amp;&amp; counter.listPath &amp;&amp; sharedLinks[counter.listPath] ? sharedLinks[counter.listPath] +
                    (Object.keys(counter.parameters || {}).length ? '?' + Object.entries(counter.parameters).map(([key, value]) =&gt; key + '=' + encodeURIComponent(value)).join('&amp;') : '') : ''})]))"/>
        <set field="unavailable" from="{stateText: 'Unavailable', link: ''}"/>
        <set field="leadsCard" from="counterOf.leads || unavailable"/>
        <set field="mineCard" from="counterOf.myOpportunities || unavailable"/>
        <set field="lateCard" from="counterOf.pastClose || unavailable"/>
        <!-- P8: the requests for quote awaiting a response -->
        <set field="rfqCard" from="counterOf.quoteRequests || unavailable"/>
        <!-- P11: the quotes to send, the quotes expiring and the orders blocked (awaiting approval or held) -->
        <set field="toSendCard" from="counterOf.quotesToSend || unavailable"/>
        <set field="expiringCard" from="counterOf.quotesExpiring || unavailable"/>
        <set field="blockedCard" from="counterOf.ordersBlocked || unavailable"/>
        <set field="assignedList" from="Array.from(home?.assignedWork || [])"/>
        <set field="assignedUnavailable" from="!home || home.assignedState == 'unavailable'"/>
        <set field="pipelineList" from="Array.from(pipeline?.opportunityList || [])"/>
        <set field="pipelineCount" from="pipeline?.opportunityListCount ?? null"/>
        <set field="totalsText" from="(pipeline?.totals || []).map(total =&gt; total.amountText + ' (' + total.count + ')').join(' · ')"/>
        <set field="detailPath" from="sharedLinks['Pipeline/OpportunityDetail'] || null"/>
        <set field="canEdit" from="!!can.opportunityEdit"/>
        <set field="canImport" from="!!(can.teamRead &amp;&amp; can.import)"/>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col"><label text="Sales" type="h5"/></container>
            <section name="HomeActions" condition="can.anyRead &amp;&amp; canEdit">
                <widgets>
                    <container style="col-auto row items-center q-gutter-xs">
                        <link url="${sharedLinks['Pipeline/Opportunities']}" text="New opportunity" link-type="anchor-button" btn-type="primary" icon="sym_o_add"
                                parameter-map="{_openDialog:'NewOpportunityDialog'}"/>
                        <link url="${sharedLinks['Pipeline/Leads']}" text="New lead" link-type="anchor-button" icon="sym_o_person_add"
                                parameter-map="{_openDialog:'NewLeadDialog'}"/>
                        <link url="${sharedLinks['QuickCreate']}/NewActivity" text="Schedule activity" link-type="anchor-button" icon="sym_o_event"/>
                        <link url="${sharedLinks['Pipeline/OpportunityImport']}" text="Import" link-type="anchor-button" icon="sym_o_upload"
                                condition="canImport"/>
                    </container>
                </widgets>
            </section>
        </container>
        <section name="NoRead" condition="!can.anyRead">
            <widgets>
                <label text="Home summarizes the sales work, pipeline and orders of your organizations. Nothing of it is open to you."
                        type="p" style="m-muted"/>
            </widgets>
        </section>
        <section name="ReaderHome" condition="can.anyRead">
            <widgets>
                <form-single name="HomeFilters" transition="." map="scope">
                    <field name="organizationPartyId">
                        <default-field title="Organization">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'organizations', selected:scope.organizationPartyId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="submitButton"><default-field title="Show"><submit/></default-field></field>
                    <field-layout>
                        <field-row><field-ref name="organizationPartyId"/><field-ref name="submitButton"/></field-row>
                    </field-layout>
                </form-single>
                <label text="This organization is not available to you." type="p" style="text-negative" condition="organizationRefused"/>
                <label text="${scopeText}" type="p" style="text-caption m-muted" condition="!organizationRefused"/>
                <container-box>
                    <box-header title="Sales work"/>
                    <box-body>
                        <dashboard min-width="160">
                            <number-card title="Leads to work" value="${leadsCard.stateText}" icon="sym_o_person_search" size="sm"
                                    link="${leadsCard.link}"/>
                            <number-card title="My open opportunities" value="${mineCard.stateText}" icon="sym_o_trending_up" size="sm"
                                    link="${mineCard.link}"/>
                            <number-card title="Past their expected close" value="${lateCard.stateText}" icon="sym_o_event_busy" size="sm"
                                    link="${lateCard.link}"/>
                            <number-card title="RFQs awaiting response" value="${rfqCard.stateText}" icon="sym_o_request_quote" size="sm"
                                    link="${rfqCard.link}"/>
                            <number-card title="Quotes to send" value="${toSendCard.stateText}" icon="sym_o_send" size="sm" link="${toSendCard.link}"/>
                            <number-card title="Quotes expiring" value="${expiringCard.stateText}" icon="sym_o_hourglass_bottom" size="sm"
                                    link="${expiringCard.link}"/>
                            <number-card title="Orders blocked" value="${blockedCard.stateText}" icon="sym_o_block" size="sm" link="${blockedCard.link}"/>
                        </dashboard>
                    </box-body>
                </container-box>
                <container-box>
                    <box-header title="Assigned to me"/>
                    <box-body>
                        <label text="Your assigned work is unavailable right now." type="p" style="text-negative" condition="assignedUnavailable"/>
                        <label text="Nothing is assigned to you. New leads and opportunities you own show here, the soonest to close first."
                                type="p" style="m-muted" condition="!assignedUnavailable &amp;&amp; !assignedList.length"/>
                        <section name="AssignedShown" condition="assignedList.length">
                            <widgets>
                                <form-list name="AssignedWork" list="assignedList" skip-form="true" paginate="false">
                                    <field name="opportunityName">
                                        <conditional-field title="Deal" condition="detailPath">
                                            <link url="${detailPath}" text="${opportunityName}" link-type="anchor"
                                                    parameter-map="{salesOpportunityId:salesOpportunityId}"/>
                                        </conditional-field>
                                        <default-field title="Deal"><display/></default-field>
                                    </field>
                                    <field name="typeText"><default-field title="Kind"><display/></default-field></field>
                                    <field name="accountName"><default-field title="Account"><display/></default-field></field>
                                    <field name="stageText"><default-field title="Stage"><display/></default-field></field>
                                    <field name="amountText" align="right"><default-field title="Amount"><display/></default-field></field>
                                    <field name="closeText"><default-field title="Expected close"><display/></default-field></field>
                                    <field name="nextActivityText"><default-field title="Next activity"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="opportunityName"/><field-ref name="accountName"/></column>
                                        <column><field-ref name="amountText"/><field-ref name="closeText"/></column>
                                    </columns>
                                </form-list>
                                <label text="${home.assignedCount} assigned in all; the soonest ten are shown." type="p" style="text-caption m-muted"
                                        condition="home.assignedCount &gt; assignedList.length"/>
                            </widgets>
                        </section>
                    </box-body>
                </container-box>
                <container-box>
                    <box-header title="My pipeline"/>
                    <box-toolbar>
                        <link url="${sharedLinks['Pipeline/Opportunities']}" text="Open the board" link-type="anchor" parameter-map="{mine:'Y'}"/>
                    </box-toolbar>
                    <box-body>
                        <label text="Total ${totalsText}" type="p" style="text-caption m-muted" condition="totalsText"/>
                        <section name="EmptyPipeline" condition="pipelineCount === 0">
                            <widgets>
                                <label text="You have no open opportunities." type="p" style="m-muted"/>
                                <section name="EmptyPipelineActions" condition="canEdit">
                                    <widgets>
                                        <container style="row q-gutter-xs">
                                            <link url="${sharedLinks['Pipeline/Leads']}" text="New lead" link-type="anchor-button" icon="sym_o_person_add"
                                                    parameter-map="{_openDialog:'NewLeadDialog'}"/>
                                            <link url="${sharedLinks['Pipeline/Opportunities']}" text="New opportunity" link-type="anchor-button" icon="sym_o_add"
                                                    parameter-map="{_openDialog:'NewOpportunityDialog'}"/>
                                        </container>
                                    </widgets>
                                </section>
                            </widgets>
                        </section>
                        <label text="Your pipeline is unavailable right now." type="p" style="text-negative" condition="pipelineCount == null"/>
                        <section name="PipelineShown" condition="pipelineList.length">
                            <widgets>
                                <form-list name="MyPipeline" list="pipelineList" skip-form="true" paginate="false">
                                    <field name="opportunityName">
                                        <conditional-field title="Opportunity" condition="detailPath">
                                            <link url="${detailPath}" text="${opportunityName}" link-type="anchor"
                                                    parameter-map="{salesOpportunityId:salesOpportunityId}"/>
                                        </conditional-field>
                                        <default-field title="Opportunity"><display/></default-field>
                                    </field>
                                    <field name="accountName"><default-field title="Account"><display/></default-field></field>
                                    <field name="amountText" align="right"><default-field title="Amount"><display/></default-field></field>
                                    <field name="stageText"><default-field title="Stage"><display/></default-field></field>
                                    <field name="nextActivityText"><default-field title="Next activity"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="opportunityName"/><field-ref name="stageText"/></column>
                                        <column><field-ref name="amountText"/><field-ref name="nextActivityText"/></column>
                                    </columns>
                                </form-list>
                            </widgets>
                        </section>
                    </box-body>
                </container-box>
                <container-box>
                    <box-header title="Pipeline by stage"/>
                    <box-body>
                        <label text="Open opportunities of your pipeline by stage, as you may read them." type="p" style="text-caption m-muted"/>
                        <report-embed definition-id="boss-sales-pipeline" panel-id="funnel" from="now-3y" thru="now"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="Shortcuts" condition="can.reports">
            <widgets>
                <container-box>
                    <box-header title="Shortcuts"/>
                    <box-body>
                        <label text="Read the sales of your organizations: orders, invoices, top products and customer classes." type="p"/>
                        <link url="${sharedLinks['Reports/SalesSummary']}" text="Sales summary" link-type="anchor-button"
                                icon="sym_o_table_chart"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
