<!-- Sales › Agreements › Price lists (design-sales §7 PriceLists and PriceListDetail; impl-sales P15; crosscut §3.21): Products'
    Shared/PriceLists and Shared/PriceListDetail in Products' Sales context, for a price reader (PRICE_VIEW); list edits need
    PRICE_EDIT, checked again in Mantle (Commerce's pattern). A list naming an agreement applies only while the agreement is active
    and dated (the price resolver's guard). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Price lists" default-menu-index="3">
    <subscreens default-item="List">
        <subscreens-item name="List" location="component://mr-boss/screen/Shared/PriceLists.xml"/>
        <subscreens-item name="PriceListDetail" location="component://mr-boss/screen/Shared/PriceListDetail.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
