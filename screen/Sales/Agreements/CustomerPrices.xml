<!-- Sales › Agreements › Customer prices (design-sales §7 CustomerPrices; impl-sales P15; crosscut §3.21): Products' Shared/Prices in
    Products' Sales context (ironstone.products.CatalogServices.get#SharedContext salesContext): the sales price rows, a customer's
    and an agreement's among them, read by PRICE_VIEW or PRICE_EDIT and edited by PRICE_EDIT, each checked again in Mantle; no cost,
    margin or supplier price. An agreement's negotiated prices are kept on the agreement (AgreementDetail's Items), and the price
    resolver applies them only while the agreement is active and dated. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Customer prices" default-menu-index="2">
    <subscreens default-item="List">
        <subscreens-item name="List" location="component://mr-boss/screen/Shared/Prices.xml"/>
    </subscreens>
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
