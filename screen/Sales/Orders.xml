<!-- The Orders area of IronStone Sales (design-sales §6, §1.2): P7 builds its one OrderDetail route (Shared/OrderDetail in Sales'
    quote context, template/SalesOrderDetail.xml); P11 shows the area in the menu with Orders (OrderFind, OrderList with its saved
    lists, Awaiting approval, NewSalesOrder, OrderBatch) and gives OrderDetail its sales-order context; P14 adds Changes (OrderChanges) and mounts the shared OrderChangeDetail,
    ShipmentDetail and InvoiceDetail in Sales' context. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Orders" default-menu-index="5" menu-image="sym_o_receipt_long" menu-image-type="icon">
    <subscreens default-item="Orders" always-use-full-path="true">
        <!-- P11: the order list, a Sales reader's; Mantle's find#SalesOrders scopes it -->
        <subscreens-item name="Orders" location="component://mr-boss/screen/Sales/Orders/Orders.xml" menu-index="1"/>
        <subscreens-item name="OrderDetail" location="component://mr-boss/screen/Shared/OrderDetail.xml" menu-include="false"/>
        <!-- P14: Changes (the commercial proposals, a tab) and the shared change, shipment and invoice details, hidden from the menu -->
        <subscreens-item name="OrderChanges" location="component://mr-boss/screen/Sales/Orders/OrderChanges.xml" menu-index="2"/>
        <subscreens-item name="OrderChangeDetail" location="component://mr-boss/screen/Shared/OrderChangeDetail.xml" menu-include="false"/>
        <subscreens-item name="ShipmentDetail" location="component://mr-boss/screen/Shared/ShipmentDetail.xml" menu-include="false"/>
        <subscreens-item name="InvoiceDetail" location="component://mr-boss/screen/Shared/InvoiceDetail.xml" menu-include="false"/>
        <!-- P10: a quote's send, opened in a dialog from OrderDetail -->
        <subscreens-item name="QuoteSend" location="component://mr-boss/screen/Sales/Orders/QuoteSend.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="SalesOrdersPanel" type="tab"/>
    </widgets>
</screen>
