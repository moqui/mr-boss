<!-- The Orders area of IronStone Sales (design-sales §6, §1.2): P7 builds its one OrderDetail route (Shared/OrderDetail in Sales'
    quote context, template/SalesOrderDetail.xml), hidden from the menu with the area until P11 adds Orders, the order context and
    the Changes list (P14). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Orders" default-menu-index="5" menu-image="sym_o_receipt_long" menu-image-type="icon">
    <subscreens default-item="OrderDetail" always-use-full-path="true">
        <subscreens-item name="OrderDetail" location="component://mr-boss/screen/Shared/OrderDetail.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
