<!-- Sales' quick create (design-sales §12.2 QuickCreate, §1.3; impl-sales P6): the shell's + menu opens these in its quick-create
    frame, one screen a kind (Sales.xml's quick-create entries): Lead, Opportunity, Account, Contact, Activity and (P7) Quote,
    each the host list's own form (template/SalesOpportunityForms.xml, template/SalesAccountForms.xml, template/SalesQuoteForms.xml) or OpportunityDetail's
    activity on a deal the user chooses, posting to the same guarded transition. A user without the capability a kind needs is told
    so; Mantle refuses them anyway. Hidden from the menu. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Create" default-menu-include="false">
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
