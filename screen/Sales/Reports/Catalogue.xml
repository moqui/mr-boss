<!-- Sales › Reports › All reports (design-sales §8 Reports SalesReportCatalogue; style-guide §3.1; impl-sales P19): the Sales reports
    the user may read, from Mantle's mantle.sales.SalesWorkspaceServices.get#SalesReports (the same catalogue Insights' catalog reads
    for Sales' entries), each with what it answers and a link that opens it for the organization. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="All reports" default-menu-index="0" menu-image="sym_o_list" menu-image-type="icon">
    <parameter name="organizationPartyId"/>
    <actions>
        <set field="organizationPartyId" from="organizationPartyId || sales.defaultOrganizationPartyId || null"/>
        <!-- in a transaction of its own, its refusal left for the lines below to read (ignore-error clears it) -->
        <script>{
            const probed = ec.service.sync().name('mantle.sales.SalesWorkspaceServices.get#SalesReports').requireNewTransaction(true)
                    .parameters({appRoot:'Sales'}).call()
            if (probed != null) catalog = Object.assign({}, catalog || {}, probed)
        }</script>
        <set field="catalogRefused" from="ec.message.hasError()"/>
        <script>ec.message.clearErrors()</script>
        <set field="reportRows" from="Array.from(catalog?.reports || []).map(row =&gt; Object.assign({}, row,
                {reportPath: sharedLinks[row.path] || null, linkParameters: organizationPartyId ? {organizationPartyId} : {}}))"/>
    </actions>
    <widgets>
        <label text="Sales reports" type="h5"/>
        <label text="Open a report for your organization; each states what its figures rest on." type="p" style="text-caption m-muted"/>
        <label text="No reports are available to you." type="p" condition="catalogRefused || !reportRows.length"/>
        <form-list name="SalesReportCatalogue" list="reportRows" skip-form="true" paginate="false">
            <field name="title">
                <conditional-field title="Report" condition="reportPath">
                    <link url="${reportPath}" text="${title}" link-type="anchor" parameter-map="linkParameters"/>
                </conditional-field>
                <default-field title="Report"><display/></default-field>
            </field>
            <field name="description"><default-field title="What it shows"><display/></default-field></field>
            <field name="parameters"><default-field title="Options"><display/></default-field></field>
            <columns type="mobile">
                <column><field-ref name="title"/></column>
                <column><field-ref name="description"/></column>
            </columns>
        </form-list>
    </widgets>
</screen>
