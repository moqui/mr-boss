<!-- Sales › Pipeline › Opportunity import (design-sales §3 OpportunityImport, §16; impl-sales P6, F24, F44): the shared import wizard
    (Shared/DataImport.xml) mounted for the `opportunities` target, as Maintenance's EquipmentImport mounts it for equipment, opened
    from Leads and Opportunities and hidden from the menu. The mount (DataImport.js, appRoot Sales) asks SALES_TEAM_VIEW to read and
    SALES_IMPORT with SALES_OPPORTUNITY_EDIT and SALES_TEAM_MANAGE to run; each row is Mantle's validate# and
    apply#OpportunityImportRow, through Sales' own opportunity services with their permission, organization and assignment checks.
    Upload, map and preview (an unknown stage, currency, organization or party named on its row), choose whether a deal already here
    is skipped or updated, apply, and the results with the refused rows downloadable. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Import leads and opportunities" default-menu-include="false">
    <subscreens default-item="Index">
        <subscreens-item name="Index" location="component://mr-boss/screen/Shared/DataImport.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
