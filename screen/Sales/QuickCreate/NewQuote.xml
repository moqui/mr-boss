<!-- Quick create › Quote (design-sales §12.2): NewQuote, the Quotes list's form, for a holder of SALES_QUOTE_EDIT; it opens the new
    quote's OrderDetail. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="New quote" default-menu-include="false">
    <transition-include name="choices" location="component://mr-boss/template/SalesParts.xml"/>
    <transition-include name="createQuote" location="component://mr-boss/template/SalesQuotes.xml"/>
    <actions>
        <set field="newQuoteDefaults" from="{organizationPartyId: sales.defaultOrganizationPartyId}"/>
    </actions>
    <widgets>
        <label text="New quote" type="h6"/>
        <label text="You do not create quotes in Sales." type="p" style="m-muted" condition="!sales.capabilities.quoteEdit"/>
        <section name="NewQuoteFormShown" condition="sales.capabilities.quoteEdit">
            <widgets><section-include name="NewQuoteForm" location="component://mr-boss/template/SalesQuoteForms.xml"/></widgets>
        </section>
    </widgets>
</screen>
