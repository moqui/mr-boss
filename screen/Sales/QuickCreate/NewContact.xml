<!-- Quick create › Contact (design-sales §12.2): NewContact, the Contacts list's form (a new person as a contact of an account of
    the user's scope), for a holder of SALES_ACCOUNT_EDIT. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="New contact" default-menu-include="false">
    <parameter name="accountPartyId"/>
    <transition-include name="choices" location="component://mr-boss/template/SalesParts.xml"/>
    <transition-include name="createContact" location="component://mr-boss/template/SalesAccounts.xml"/>
    <actions>
        <set field="newContactDefaults" from="{accountPartyId: accountPartyId || null}"/>
    </actions>
    <widgets>
        <label text="New contact" type="h6"/>
        <label text="You do not add contacts in Sales." type="p" style="m-muted" condition="!sales.capabilities.accountEdit"/>
        <section name="NewContactFormShown" condition="sales.capabilities.accountEdit">
            <widgets><section-include name="NewContactForm" location="component://mr-boss/template/SalesAccountForms.xml"/></widgets>
        </section>
    </widgets>
</screen>
