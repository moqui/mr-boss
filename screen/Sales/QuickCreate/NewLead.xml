<!-- Quick create › Lead (design-sales §12.2): NewLead, the Leads list's form (a lead with no account needed), for a holder of
    SALES_OPPORTUNITY_EDIT; it opens the new lead's OpportunityDetail. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="New lead" default-menu-include="false">
    <transition-include name="choices" location="component://mr-boss/template/SalesParts.xml"/>
    <transition-include name="createOpportunity" location="component://mr-boss/template/SalesOpportunities.xml"/>
    <actions>
        <set field="newLeadDefaults" from="{organizationPartyId: sales.defaultOrganizationPartyId}"/>
    </actions>
    <widgets>
        <label text="New lead" type="h6"/>
        <label text="You do not create leads in Sales." type="p" style="m-muted" condition="!sales.capabilities.opportunityEdit"/>
        <section name="NewLeadFormShown" condition="sales.capabilities.opportunityEdit">
            <widgets><section-include name="NewLeadForm" location="component://mr-boss/template/SalesOpportunityForms.xml"/></widgets>
        </section>
    </widgets>
</screen>
