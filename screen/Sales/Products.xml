<!-- Products' screens in Sales' context (design-sales §5 Product360 and InventoryAvailability, §7 PriceExplain; crosscut §3.5, §3.7,
    §3.21; impl-sales P7, F67), reached from a quote's lines and hidden from the menu: the shared Product360 (read only: the product,
    its variants, identifiers, documents, stock and, for a price reader, prices), InventoryAvailability (read only, the selling
    organizations' facilities) and PriceExplain (a quote line's safe explanation; the trace for a price reader), each in Products'
    Sales context (ironstone.products.CatalogServices.get#SharedContext salesContext: no cost, supplier price or edit). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Products" default-menu-index="9" menu-image="sym_o_inventory_2" menu-image-type="icon">
    <subscreens default-item="Product360" always-use-full-path="true">
        <subscreens-item name="Product360" location="component://mr-boss/screen/Shared/Product360.xml" menu-include="false"/>
        <subscreens-item name="InventoryAvailability" location="component://mr-boss/screen/Shared/InventoryAvailability.xml"
                menu-include="false"/>
        <subscreens-item name="PriceExplain" location="component://mr-boss/screen/Shared/PriceExplain.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
