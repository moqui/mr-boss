<!-- Compare and merge two accounts or contacts in Sales (design-sales §4 MergeAccounts: "Sales adds to the Compare dialog a
    read-only count of the opportunities, quotes, orders and agreements each party carries"; impl-sales P3, F45): Commons' compare
    (ironstone.commons.ContactServices.get#ComparePair, which offers the merge Mantle's guards admit the user for, and names the
    guard that refuses one) side by side, with the Sales documents each party carries in the user's organizations
    (mantle.sales.SalesWorkspaceServices.get#AccountDocumentCounts; quotes count with P7), the one to keep, then Merge through
    Commons' merge#Contacts and Mantle's merge#Parties, whose guards decide again; or Not a duplicate. Opened in a dialog from
    MergeAccounts, for the same managers and administrators (BOSS_SAL_MERGE). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Compare" default-menu-include="false">
    <parameter name="partyId" required="true"/>
    <parameter name="otherPartyId" required="true"/>
    <transition name="mergeAccounts">
        <actions>
            <script><![CDATA[
                const other = keepPartyId === partyId ? otherPartyId : partyId
                ec.service.sync().name('ironstone.commons.ContactServices.merge#Contacts').parameters({keepPartyId: keepPartyId, otherPartyId: other}).call()
                if (!ec.message.hasError()) ec.message.addMessage(ec.l10n.localize('Merged'), 'success')
            ]]></script>
        </actions>
        <default-response url="../MergeAccounts"/>
        <error-response url="../MergeAccounts"/>
    </transition>
    <transition name="notDuplicate">
        <actions>
            <service-call name="ironstone.commons.ContactServices.mark#NotDuplicate" in-map="{partyId:partyId, otherPartyId:otherPartyId}"/>
            <if condition="!ec.message.hasError()"><message type="success">Marked as not duplicates</message></if>
        </actions>
        <default-response url="../MergeAccounts"/>
        <error-response url="../MergeAccounts"/>
    </transition>
    <actions>
        <set field="can" from="sales.capabilities"/>
        <if condition="can.mergeAccounts">
            <service-call name="ironstone.commons.ContactServices.get#ComparePair" in-map="{partyId:partyId, otherPartyId:otherPartyId}"
                    out-map="pair" transaction="force-new" ignore-error="true"/>
            <service-call name="mantle.sales.SalesWorkspaceServices.get#AccountDocumentCounts" out-map="countsOut"
                    in-map="{partyIdList:[partyId, otherPartyId]}" transaction="force-new" ignore-error="true"/>
        </if>
        <script><![CDATA[
            pairFound = !!can.mergeAccounts && !ec.message.hasError() && pair?.left != null && pair?.right != null
            compareError = pairFound ? '' : (ec.message.getErrorsString() || ec.l10n.localize('These accounts are not available'))
            ec.message.clearErrors()
            if (!pairFound) return
            left = pair.left
            right = pair.right
            keepOptions = Array.from(pair.keepOptions || [])
            keepPartyId = keepOptions.length ? keepOptions[0].key : null
            canMerge = !!pair.canMerge
            reason = pair.reason || ''
            // the Sales documents of each side, as rows of the side by side
            const counts = {}
            for (const row of Array.from(countsOut?.counts || [])) counts[row.partyId] = row
            const countRow = (label, field) => ({label: ec.l10n.localize(label), left: String(counts[left.partyId]?.[field] ?? ''),
                right: String(counts[right.partyId]?.[field] ?? ''), differs: false})
            compareRows = [{label: ec.l10n.localize('Name'), left: left.name, right: right.name, differs: left.name !== right.name},
                {label: ec.l10n.localize('Id'), left: left.pseudoId, right: right.pseudoId, differs: true}]
                .concat(Array.from(pair.fieldList || []).map((field) => ({label: field.label, left: field.left, right: field.right, differs: field.differs})))
                .concat([countRow('Opportunities', 'opportunityCount'), countRow('Orders', 'orderCount'), countRow('Agreements', 'agreementCount')])
        ]]></script>
    </actions>
    <widgets>
        <section name="MergeCompareMissing" condition="!pairFound">
            <widgets>
                <container-box type="warning">
                    <box-header title="Not available"/>
                    <box-body>
                        <label type="p" text="${compareError}"/>
                        <link url="../MergeAccounts" link-type="anchor" text="Back to duplicates"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="MergeCompareFound" condition="pairFound">
            <widgets>
                <container-box>
                    <box-header title="Side by side"/>
                    <box-body-nopad>
                        <form-list name="MergeCompareRows" list="compareRows" skip-form="true" paginate="false">
                            <field name="label">
                                <default-field title="">
                                    <display style="${differs ? 'text-weight-medium' : 'm-muted'}"/>
                                </default-field>
                            </field>
                            <field name="left">
                                <default-field title="${left.name}">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="right">
                                <default-field title="${right.name}">
                                    <display/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="label"/><field-ref name="left"/><field-ref name="right"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
                <section name="MergeCompareAllowed" condition="canMerge">
                    <widgets>
                        <container-box>
                            <box-header title="Merge"/>
                            <box-body>
                                <label type="p" style="m-muted" text="The one kept gets the other's contact details, contacts, relationships, opportunities, orders, agreements, files and history; the other is disabled. The one kept keeps its own name."/>
                                <form-single name="MergeAccountsForm" transition="mergeAccounts">
                                    <field name="partyId"><default-field><hidden/></default-field></field>
                                    <field name="otherPartyId"><default-field><hidden/></default-field></field>
                                    <field name="keepPartyId">
                                        <default-field title="Keep">
                                            <radio>
                                                <list-options list="keepOptions" key="${key}" text="${text}"/>
                                            </radio>
                                        </default-field>
                                    </field>
                                    <field name="submitButton">
                                        <default-field title="Merge">
                                            <submit confirmation="Merge ${left.name} and ${right.name} into one? This cannot be undone."/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </box-body>
                        </container-box>
                    </widgets>
                    <fail-widgets>
                        <container-box type="warning">
                            <box-body>
                                <label type="p" text="${reason}"/>
                            </box-body>
                        </container-box>
                    </fail-widgets>
                </section>
                <container style="q-mt-sm">
                    <link url="notDuplicate" link-type="hidden-form-link" text="Not a duplicate" icon="sym_o_do_not_disturb_on"
                            parameter-map="{partyId:partyId, otherPartyId:otherPartyId}"/>
                </container>
            </widgets>
        </section>
    </widgets>
</screen>
