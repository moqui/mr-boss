<!-- Sales › Settings › ApprovalPolicies (design-sales §9 ApprovalPolicies: ApprovalRules, ApprovalPreview; style-guide §3.9 Settings;
    impl-sales P9): an organization's approval rules (mantle.order.SalesApprovalServices.find#SalesApprovalPolicies), each of one
    purpose (a quote's exception, decided before it is proposed; a sales order's approval) and one bounded type (an amount at or
    above a threshold in a currency, a discount at or beyond a percent of the calculated price, a price under its floor of the
    product's cost and a margin, a free or zero-price line), with its approvers' group and whether its author may approve. New rule,
    Edit (a dated next version) and End, each with its reason (store#SalesApprovalPolicy). Without a quote rule a manual price needs
    an approver other than its author, which the page says. The approval preview of a quote (preview#Quote) shows here when a quote
    is named (orderId, from OrderDetail's Approval box), with each rule's inputs and the approver it needs; a floor's cost is never
    shown. SALES_CONFIGURE, which Mantle checks with the organization. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Approval rules" default-menu-index="8"
        default-menu-include="ec.user.hasPermission('SALES_CONFIGURE')">
    <parameter name="organizationPartyId"/>
    <parameter name="includeEnded"/>
    <parameter name="orderId"/>
    <transition-include name="choices" location="component://mr-boss/template/SalesParts.xml"/>
    <transition name="storeRule">
        <actions>
            <service-call name="mantle.order.SalesApprovalServices.store#SalesApprovalPolicy"
                    in-map="{salesApprovalPolicyId:(salesApprovalPolicyId || null), revision:(revision || null),
                        organizationPartyId:(organizationPartyId || null), purposeEnumId:(purposeEnumId || null),
                        ruleTypeEnumId:(ruleTypeEnumId || null), thresholdAmount:(thresholdAmount ?? null), currencyUomId:(currencyUomId ?? null),
                        discountPercent:(discountPercent ?? null), floorMarginPercent:(floorMarginPercent ?? null),
                        approverUserGroupId:(approverUserGroupId ?? null), selfApprovalAllowed:(selfApprovalAllowed == 'Y' ? 'Y' : 'N'),
                        description:(description ?? null), fromDate:(fromDate || null), endPolicy:(endPolicy == 'Y' ? 'Y' : null),
                        changeReason:(changeReason || null)}"/>
            <if condition="!ec.message.hasError()"><message type="success">${endPolicy == 'Y' ? 'Rule ended' : 'Rule saved'}</message></if>
        </actions>
        <default-response url="."><parameter name="organizationPartyId"/><parameter name="includeEnded"/></default-response>
        <error-response url="."><parameter name="organizationPartyId"/><parameter name="includeEnded"/></error-response>
    </transition>
    <always-actions>
        <script>if(!(sales.capabilities.configure))throw new Error('PERMISSION_DENIED: Sales settings are the Sales administrator\'s')</script>
    </always-actions>
    <actions>
        <set field="organizationPartyId" from="organizationPartyId || sales.defaultOrganizationPartyId || (sales.organizationPartyIds || [])[0] || null"/>
        <if condition="organizationPartyId">
            <service-call name="mantle.order.SalesApprovalServices.find#SalesApprovalPolicies" out-map="found" transaction="force-new"
                    ignore-error="true" in-map="{organizationPartyId:organizationPartyId, includeEnded:(includeEnded == 'Y' ? 'Y' : null)}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="rulesFound" from="!!found?.organizationPartyId"/>
        <set field="ruleList" from="found?.ruleList || []"/>
        <if condition="orderId">
            <service-call name="mantle.order.SalesApprovalServices.preview#Quote" out-map="previewOut" transaction="force-new"
                    ignore-error="true" in-map="{orderId:orderId}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="preview" from="previewOut?.approval || null"/>
        <set field="previewRows" from="preview?.requirements || []"/>
        <set field="findValues" from="{organizationPartyId: organizationPartyId, includeEnded: includeEnded || null}"/>
        <set field="newRule" from="{organizationPartyId: organizationPartyId, purposeEnumId: 'SapQuote', ruleTypeEnumId: 'SarDiscount', selfApprovalAllowed: 'N'}"/>
        <set field="purposeOptions" from="[{key: 'SapQuote', text: ec.l10n.localize('Quote exception (before it is proposed)')},
                {key: 'SapOrder', text: ec.l10n.localize('Sales order approval')}]"/>
        <set field="typeOptions" from="[{key: 'SarDiscount', text: ec.l10n.localize('Discount at or beyond a percent')},
                {key: 'SarAmount', text: ec.l10n.localize('Total at or above an amount')},
                {key: 'SarPriceFloor', text: ec.l10n.localize('Price under its floor (cost and margin)')},
                {key: 'SarFreeLine', text: ec.l10n.localize('Free or zero-price line')}]"/>
    </actions>
    <widgets>
        <container style="m-record-header">
            <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                <container style="col-12 col-md m-record-title">
                    <label text="Approval rules" type="h5"/>
                    <label text="${found?.organizationName || ''}" type="span" style="text-caption m-muted" condition="rulesFound"/>
                </container>
            </container>
            <container style="row items-center q-gutter-xs m-record-actions">
                <container-dialog id="NewRuleDialog" button-text="New rule" icon="sym_o_add" type="primary" width="640" title="New approval rule"
                        condition="rulesFound &amp;&amp; found.canConfigure">
                    <form-single name="NewRule" transition="storeRule" map="newRule">
                        <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                        <field name="purposeEnumId">
                            <default-field title="Purpose"><drop-down allow-empty="false"><list-options list="purposeOptions" key="${key}" text="${text}"/></drop-down></default-field>
                        </field>
                        <field name="ruleTypeEnumId">
                            <default-field title="Needs approval when"><drop-down allow-empty="false"><list-options list="typeOptions" key="${key}" text="${text}"/></drop-down></default-field>
                        </field>
                        <field name="discountPercent"><default-field title="Discount %" tooltip="For a discount rule"><text-line size="6"/></default-field></field>
                        <field name="thresholdAmount"><default-field title="Amount" tooltip="For an amount rule"><text-line size="10"/></default-field></field>
                        <field name="currencyUomId">
                            <default-field title="Currency" tooltip="For an amount rule">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'currencies', selected:currencyUomId}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="floorMarginPercent"><default-field title="Margin over cost %" tooltip="For a price floor rule; empty is the cost itself"><text-line size="6"/></default-field></field>
                        <field name="approverUserGroupId">
                            <default-field title="Approvers" tooltip="Empty: any sales approver of the organization">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'approverGroups', selected:approverUserGroupId}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="selfApprovalAllowed">
                            <default-field title=" "><check><option key="Y" text="The quote's author may approve it"/></check></default-field>
                        </field>
                        <field name="description"><default-field title="Description"><text-line size="40"/></default-field></field>
                        <field name="fromDate"><default-field title="From" tooltip="Empty: now"><date-time type="timestamp"/></default-field></field>
                        <field name="changeReason"><default-field title="Reason"><text-line size="40"/></default-field></field>
                        <field name="submitButton"><default-field title="Create rule"><submit/></default-field></field>
                        <field-layout>
                            <field-row><field-ref name="purposeEnumId"/><field-ref name="ruleTypeEnumId"/></field-row>
                            <field-row><field-ref name="discountPercent"/><field-ref name="floorMarginPercent"/></field-row>
                            <field-row><field-ref name="thresholdAmount"/><field-ref name="currencyUomId"/></field-row>
                            <field-row><field-ref name="approverUserGroupId"/><field-ref name="selfApprovalAllowed"/></field-row>
                            <field-row><field-ref name="description"/><field-ref name="fromDate"/></field-row>
                            <field-ref name="changeReason"/>
                            <field-ref name="submitButton"/>
                        </field-layout>
                    </form-single>
                </container-dialog>
            </container>
        </container>
        <form-single name="RulesFind" transition="." map="findValues">
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="false">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'organizations', selected:findValues.organizationPartyId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="includeEnded"><default-field title=" "><check><option key="Y" text="Include ended rules"/></check></default-field></field>
            <field name="submitButton"><default-field title="Show"><submit/></default-field></field>
            <field-layout><field-row-big><field-ref name="organizationPartyId"/><field-ref name="includeEnded"/><field-ref name="submitButton"/></field-row-big></field-layout>
        </form-single>
        <label type="p" style="text-negative" condition="!rulesFound" text="Sales' approval rules cannot be read for this organization just now."/>
        <container-box condition="preview">
            <box-header title="Approval of quote ${orderId} · revision ${preview?.orderRevision}"/>
            <box-body-nopad>
                <form-list name="ApprovalPreview" list="previewRows" skip-form="true" paginate="false">
                    <field name="ruleText"><default-field title="Rule"><display/></default-field></field>
                    <field name="inputsText"><default-field title="What meets it"><display/></default-field></field>
                    <field name="approverText"><default-field title="Approver"><display/></default-field></field>
                    <field name="stateText">
                        <default-field title="State">
                            <label text="${stateText}" type="span"/>
                            <label text="${[decidedByName, decidedText, reason].filter(Boolean).join(' · ')}" type="div" style="text-caption m-muted" condition="decidedByName"/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column><field-ref name="ruleText"/><field-ref name="inputsText"/></column>
                        <column><field-ref name="stateText"/></column>
                    </columns>
                </form-list>
                <label type="p" style="m-muted q-pa-sm q-mb-none" condition="!previewRows.length" text="This quote needs no approval at its current revision."/>
            </box-body-nopad>
        </container-box>
        <container-box condition="rulesFound">
            <box-header title="Rules · ${ruleList.length}"/>
            <box-body-nopad>
                <label type="p" style="text-caption m-muted q-px-sm" condition="!found.configured"
                        text="No quote rule is in effect: a manual price on a quote needs an approver other than the one who entered it."/>
                <form-list name="ApprovalRules" list="ruleList" skip-form="true" paginate="false">
                    <field name="ruleText">
                        <default-field title="Rule">
                            <label text="${ruleText}" type="span"/>
                            <label text="${description}" type="div" style="text-caption m-muted" condition="description"/>
                        </default-field>
                    </field>
                    <field name="purposeText"><default-field title="Purpose"><display/></default-field></field>
                    <field name="approverText">
                        <default-field title="Approvers">
                            <label text="${approverText}" type="span"/>
                            <label text="The author may approve" type="div" style="text-caption m-muted" condition="selfApprovalAllowed == 'Y'"/>
                        </default-field>
                    </field>
                    <field name="stateText"><default-field title="State"><display/></default-field></field>
                    <field name="actions">
                        <default-field title="">
                            <container-dialog id="EditRule_${salesApprovalPolicyId}" button-text="Edit" icon="sym_o_edit" type="default" width="560"
                                    title="Change ${ruleText}" condition="!ended &amp;&amp; found.canConfigure">
                                <form-single name="EditRule" transition="storeRule"
                                        map="{salesApprovalPolicyId:salesApprovalPolicyId, revision:revision, organizationPartyId:organizationPartyId,
                                            discountPercent:discountPercent, thresholdAmount:thresholdAmount, currencyUomId:currencyUomId,
                                            floorMarginPercent:floorMarginPercent, approverUserGroupId:approverUserGroupId,
                                            selfApprovalAllowed:selfApprovalAllowed, description:description}">
                                    <field name="salesApprovalPolicyId"><default-field><hidden/></default-field></field>
                                    <field name="revision"><default-field><hidden/></default-field></field>
                                    <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                                    <field name="discountPercent">
                                        <conditional-field title="Discount %" condition="ruleTypeEnumId == 'SarDiscount'"><text-line size="6"/></conditional-field>
                                        <default-field><ignored/></default-field>
                                    </field>
                                    <field name="thresholdAmount">
                                        <conditional-field title="Amount" condition="ruleTypeEnumId == 'SarAmount'"><text-line size="10"/></conditional-field>
                                        <default-field><ignored/></default-field>
                                    </field>
                                    <field name="currencyUomId">
                                        <conditional-field title="Currency" condition="ruleTypeEnumId == 'SarAmount'">
                                            <drop-down allow-empty="false">
                                                <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'currencies', selected:currencyUomId}"/>
                                            </drop-down>
                                        </conditional-field>
                                        <default-field><ignored/></default-field>
                                    </field>
                                    <field name="floorMarginPercent">
                                        <conditional-field title="Margin over cost %" condition="ruleTypeEnumId == 'SarPriceFloor'"><text-line size="6"/></conditional-field>
                                        <default-field><ignored/></default-field>
                                    </field>
                                    <field name="approverUserGroupId">
                                        <default-field title="Approvers" tooltip="Empty: any sales approver of the organization">
                                            <drop-down allow-empty="true">
                                                <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'approverGroups', selected:approverUserGroupId}"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="selfApprovalAllowed">
                                        <default-field title=" "><check><option key="Y" text="The quote's author may approve it"/></check></default-field>
                                    </field>
                                    <field name="description"><default-field title="Description"><text-line size="40"/></default-field></field>
                                    <field name="fromDate"><default-field title="From" tooltip="Empty: now"><date-time type="timestamp"/></default-field></field>
                                    <field name="changeReason"><default-field title="Reason"><text-line size="40"/></default-field></field>
                                    <field name="submitButton"><default-field title="Save as the next version"><submit/></default-field></field>
                                </form-single>
                            </container-dialog>
                            <container-dialog id="EndRule_${salesApprovalPolicyId}" button-text="End" icon="sym_o_event_busy" type="danger" width="480"
                                    title="End ${ruleText}" condition="!ended &amp;&amp; found.canConfigure">
                                <form-single name="EndRule" transition="storeRule"
                                        map="{salesApprovalPolicyId:salesApprovalPolicyId, revision:revision, endPolicy:'Y'}">
                                    <field name="salesApprovalPolicyId"><default-field><hidden/></default-field></field>
                                    <field name="revision"><default-field><hidden/></default-field></field>
                                    <field name="endPolicy"><default-field><hidden/></default-field></field>
                                    <field name="changeReason"><default-field title="Reason"><text-line size="40"/></default-field></field>
                                    <field name="submitButton"><default-field title="End rule"><submit confirmation="End ${ruleText}? Decisions made under it keep it."/></default-field></field>
                                </form-single>
                            </container-dialog>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column><field-ref name="ruleText"/><field-ref name="purposeText"/></column>
                        <column><field-ref name="stateText"/><field-ref name="actions"/></column>
                    </columns>
                </form-list>
                <label type="p" style="m-muted q-pa-sm q-mb-none" condition="!ruleList.length" text="No approval rule yet: add the first with New rule."/>
            </box-body-nopad>
        </container-box>
    </widgets>
</screen>
