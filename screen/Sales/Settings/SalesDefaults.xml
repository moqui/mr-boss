<!-- Sales › Settings › SalesDefaults (design-sales §9 SalesDefaults; style-guide §3.9 Settings; impl-sales P9): an organization's
    Sales defaults in effect (mantle.order.SalesApprovalServices.get#SalesPolicy), published as a dated successor with its reason
    (store#SalesPolicy; Preview answers the changes and saves nothing), the scheduled and earlier versions, and the commercial
    revision a quote's issue binds (store#SalesCommercialRevision, X2, F9). The defaults shown are those Sales reads today: a new
    quote's validity and default team, and the unverified intake retention; P10 adds whether an acceptance needs the customer's
    purchase order and the reminder days (the daily reminder job sends none while they are empty); the templates and the stored
    text locations are set through store#SalesPolicy; P13 adds the acceptance threshold of a currency (above it a customer's
    quote link alone cannot accept: PASS sign-in as an invited contact; empty: none), the other currencies' kept; P20's review adds
    whether a request for quote made from mail is acknowledged to its sender (off by default); follow-up 5 adds the facility a new
    quote's or order's part ships from (a warehouse, store or plant of the organization; changeable on the order); the approval
    setting and the net-terms option join this form with the phase that reads them.
    SALES_CONFIGURE, which Mantle checks with the organization. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Defaults" default-menu-index="7"
        default-menu-include="ec.user.hasPermission('SALES_CONFIGURE')">
    <parameter name="organizationPartyId"/>
    <transition-include name="choices" location="component://mr-boss/template/SalesParts.xml"/>
    <transition name="publishDefaults">
        <actions>
            <!-- P13: one currency's acceptance threshold replaced (empty: removed), the policy's other currencies' kept -->
            <if condition="thresholdCurrencyUomId">
                <service-call name="mantle.order.SalesApprovalServices.get#SalesPolicy" out-map="current"
                        in-map="{organizationPartyId:organizationPartyId}"/>
                <set field="acceptanceThresholds" from="(current?.policy?.thresholds || [])
                        .filter(t =&gt; t.currencyUomId != thresholdCurrencyUomId)
                        .map(t =&gt; ({currencyUomId: t.currencyUomId, thresholdAmount: t.thresholdAmount}))
                        .concat(thresholdAmount ? [{currencyUomId: thresholdCurrencyUomId, thresholdAmount: thresholdAmount}] : [])"/>
            </if>
            <service-call name="mantle.order.SalesApprovalServices.store#SalesPolicy" out-map="stored"
                    in-map="{organizationPartyId:organizationPartyId, revision:(revision || null), fromDate:(fromDate || null),
                        defaultTeamPartyId:(defaultTeamPartyId ?? ''), defaultFacilityId:(defaultFacilityId ?? ''), quoteValidityDays:(quoteValidityDays ?? ''),
                        intakeRetentionDays:(intakeRetentionDays ?? ''), responsePoRequired:(responsePoRequired ?? ''),
                        reminderDays:(reminderDays ?? ''), rfqAcknowledge:(rfqAcknowledge ?? ''), acceptanceThresholds:(acceptanceThresholds ?? null),
                        changeReason:(changeReason || null), previewOnly:(previewOnly == 'Y' ? 'Y' : null)}"/>
            <if condition="!ec.message.hasError()">
                <set field="changeText" from="(stored.changes || []).map(change =&gt; ec.l10n.localize(change.field) + ': '
                        + (change.beforeText || '—') + ' → ' + (change.afterText || '—')).join('; ')"/>
                <if condition="stored.published"><then>
                    <message type="success">Defaults published${changeText ? ': ' + changeText : ''}</message>
                </then><else>
                    <message type="info">${changeText ? 'Publishing would change ' + changeText : 'Publishing would change nothing'}</message>
                </else></if>
            </if>
        </actions>
        <default-response url="."><parameter name="organizationPartyId"/></default-response>
        <error-response url="."><parameter name="organizationPartyId"/></error-response>
    </transition>
    <transition name="setCommercialRevision">
        <actions>
            <service-call name="mantle.order.SalesApprovalServices.store#SalesCommercialRevision"
                    in-map="{organizationPartyId:organizationPartyId, commercialRevisionOnly:commercialRevisionOnly,
                        changeReason:(changeReason || null)}"/>
            <if condition="!ec.message.hasError()"><message type="success">Commercial revision saved</message></if>
        </actions>
        <default-response url="."><parameter name="organizationPartyId"/></default-response>
        <error-response url="."><parameter name="organizationPartyId"/></error-response>
    </transition>
    <always-actions>
        <script>if(!(sales.capabilities.configure))throw new Error('PERMISSION_DENIED: Sales settings are the Sales administrator\'s')</script>
    </always-actions>
    <actions>
        <set field="organizationPartyId" from="organizationPartyId || sales.defaultOrganizationPartyId || (sales.organizationPartyIds || [])[0] || null"/>
        <if condition="organizationPartyId">
            <service-call name="mantle.order.SalesApprovalServices.get#SalesPolicy" out-map="found" transaction="force-new"
                    ignore-error="true" in-map="{organizationPartyId:organizationPartyId}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="policyFound" from="!!found?.organizationPartyId"/>
        <set field="policy" from="found?.policy || null"/>
        <set field="findValues" from="{organizationPartyId: organizationPartyId}"/>
        <set field="publishValues" from="{organizationPartyId: organizationPartyId, revision: policy?.revision || null,
                defaultTeamPartyId: policy?.defaultTeamPartyId || null, defaultFacilityId: policy?.defaultFacilityId || null, quoteValidityDays: policy?.quoteValidityDays ?? null,
                intakeRetentionDays: policy?.intakeRetentionDays ?? null, responsePoRequired: policy?.responsePoRequired || 'N',
                reminderDays: policy?.reminderDays ?? null, rfqAcknowledge: policy?.rfqAcknowledge || 'N', thresholdCurrencyUomId: policy?.thresholds?.[0]?.currencyUomId || 'USD',
                thresholdAmount: policy?.thresholds?.[0]?.thresholdAmount ?? null}"/>
        <set field="revisionValues" from="{organizationPartyId: organizationPartyId, commercialRevisionOnly: found?.commercialRevisionOnly ? 'N' : 'Y'}"/>
        <set field="policyRows" from="policy ? [['Default team', policy.teamName || 'None: the author\'s only team, else none'],
                ['Orders ship from', policy.facilityName || 'None: a quote or order names no facility until one is chosen on it'],
                ['Quote validity', policy.quoteValidityDays ? policy.quoteValidityDays + ' days' : 'No end set'],
                ['Unverified intakes kept', (policy.intakeRetentionDays || 30) + ' days'],
                ['Acceptance needs the customer\'s PO', policy.responsePoRequired == 'Y' ? 'Yes' : 'No'],
                ['Quote reminder', policy.reminderDays ? policy.reminderDays + ' days after it is sent' : 'None'],
                ['Requests for quote by mail', policy.rfqAcknowledge == 'Y' ? 'Acknowledged to the sender' : 'Not acknowledged'],
                ['Online acceptance needs sign-in above', (policy.thresholds || []).map(t =&gt; t.thresholdText).join(', ') || 'None: a quote link accepts any amount'],
                ['In effect', policy.fromText + (policy.thruText ? ' until ' + policy.thruText : '')],
                ['Published by', [policy.changedByName, policy.changeReason].filter(Boolean).join(' · ')]]
                .filter(pair =&gt; pair[1]).map(pair =&gt; ({label: ec.l10n.localize(pair[0]), value: pair[1]})) : []"/>
        <set field="versionRows" from="(found?.scheduled || []).map(row =&gt; Object.assign({}, row, {stateText: ec.l10n.localize('Scheduled')}))
                .concat((found?.earlier || []).map(row =&gt; Object.assign({}, row, {stateText: ec.l10n.localize('Ended')})))"/>
    </actions>
    <widgets>
        <container style="m-record-header">
            <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                <container style="col-12 col-md m-record-title">
                    <label text="Sales defaults" type="h5"/>
                    <label text="${found?.organizationName || ''}" type="span" style="text-caption m-muted" condition="policyFound"/>
                </container>
            </container>
            <container style="row items-center q-gutter-xs m-record-actions">
                <container-dialog id="PublishDefaultsDialog" button-text="Publish new defaults" icon="sym_o_publish" type="primary" width="640"
                        title="Publish new Sales defaults" condition="policyFound">
                    <form-single name="PublishDefaults" transition="publishDefaults" map="publishValues">
                        <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                        <field name="revision"><default-field><hidden/></default-field></field>
                        <field name="defaultTeamPartyId">
                            <default-field title="Default team" tooltip="A new quote's team when its opportunity has none and its author is in no single team">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0"
                                            parameter-map="{choice:'teams', organizationPartyId:organizationPartyId, selected:defaultTeamPartyId}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <!-- follow-up 5: the facility a new quote's or order's part ships from -->
                        <field name="defaultFacilityId">
                            <default-field title="Orders ship from" tooltip="The warehouse, store or plant of the organization a new quote or order ships from; it can be changed on the order">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0"
                                            parameter-map="{choice:'facilities', organizationPartyId:organizationPartyId, selected:defaultFacilityId}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="quoteValidityDays">
                            <default-field title="Quote validity in days" tooltip="Empty: a new quote's end is left open"><text-line size="6" input-type="number"/></default-field>
                        </field>
                        <field name="intakeRetentionDays">
                            <default-field title="Keep unverified inquiries for days" tooltip="Empty: 30 days"><text-line size="6" input-type="number"/></default-field>
                        </field>
                        <!-- P10: what an issued quote's response and reminder read -->
                        <field name="responsePoRequired">
                            <default-field title="An acceptance needs the customer's purchase order">
                                <drop-down allow-empty="false"><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                            </default-field>
                        </field>
                        <field name="reminderDays">
                            <default-field title="Remind the customer days after a quote is sent" tooltip="Empty: no reminder"><text-line size="6" input-type="number"/></default-field>
                        </field>
                        <!-- P20 review: the acknowledgement of a request for quote made from mail (design-sales §16; off by default) -->
                        <field name="rfqAcknowledge">
                            <default-field title="Acknowledge a request for quote by mail" tooltip="Yes: a request made from mail is answered once, to the address it came from, with its reference, when the sender is a contact or account of yours">
                                <drop-down allow-empty="false"><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down>
                            </default-field>
                        </field>
                        <!-- P13: the high-value acceptance threshold of one currency (impl-sales §4) -->
                        <field name="thresholdAmount">
                            <default-field title="Online acceptance needs sign-in above" tooltip="Above it, a customer's quote link alone cannot accept: they sign in as a contact you invited. Empty: none">
                                <text-line size="10" input-type="number"/></default-field>
                        </field>
                        <field name="thresholdCurrencyUomId">
                            <default-field title="In currency"><text-line size="4"/></default-field>
                        </field>
                        <field name="fromDate"><default-field title="From" tooltip="Empty: now"><date-time type="timestamp"/></default-field></field>
                        <field name="changeReason"><default-field title="Reason"><text-line size="50"/></default-field></field>
                        <field name="previewOnly">
                            <default-field title=" "><check><option key="Y" text="Preview the changes; publish nothing"/></check></default-field>
                        </field>
                        <field name="submitButton"><default-field title="Publish"><submit/></default-field></field>
                        <field-layout>
                            <field-row><field-ref name="defaultTeamPartyId"/><field-ref name="quoteValidityDays"/></field-row>
                            <field-row><field-ref name="intakeRetentionDays"/><field-ref name="fromDate"/></field-row>
                            <field-ref name="defaultFacilityId"/>
                            <!-- P13: P10's two fields were in no row, so the dialog did not show them; the threshold beside them -->
                            <field-row><field-ref name="responsePoRequired"/><field-ref name="reminderDays"/></field-row>
                            <field-row><field-ref name="thresholdAmount"/><field-ref name="thresholdCurrencyUomId"/></field-row>
                            <field-ref name="rfqAcknowledge"/>
                            <field-ref name="changeReason"/>
                            <field-ref name="previewOnly"/>
                            <field-ref name="submitButton"/>
                        </field-layout>
                    </form-single>
                </container-dialog>
            </container>
        </container>
        <form-single name="DefaultsFind" transition="." map="findValues">
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="false">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'organizations', selected:findValues.organizationPartyId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="submitButton"><default-field title="Show"><submit/></default-field></field>
            <field-layout><field-row-big><field-ref name="organizationPartyId"/><field-ref name="submitButton"/></field-row-big></field-layout>
        </form-single>
        <label type="p" style="text-negative" condition="!policyFound" text="Sales' defaults cannot be read for this organization just now."/>
        <section name="PolicySection" condition="policyFound">
            <widgets>
                <container-row>
                    <row-col md="6">
                        <container-box>
                            <box-header title="In effect"/>
                            <box-body-nopad>
                                <form-list name="DefaultsInEffect" list="policyRows" skip-form="true" skip-header="true" paginate="false">
                                    <field name="label"><default-field><label text="${label}" type="span" style="m-muted text-no-wrap"/></default-field></field>
                                    <field name="value"><default-field><display/></default-field></field>
                                </form-list>
                                <label type="p" style="m-muted q-pa-sm q-mb-none" condition="!policy"
                                        text="No defaults yet: a new quote's end is left open and unverified inquiries are kept 30 days. Publish the first with Publish new defaults."/>
                            </box-body-nopad>
                        </container-box>
                    </row-col>
                    <row-col md="6">
                        <container-box>
                            <box-header title="Commercial revision"/>
                            <box-toolbar>
                                <container-dialog id="CommercialRevisionDialog" button-text="${found?.commercialRevisionOnly ? 'Turn off' : 'Turn on'}"
                                        icon="sym_o_toggle_on" type="default" width="520" title="Change the commercial revision" condition="found?.commercialRevisionOwn">
                                    <form-single name="CommercialRevision" transition="setCommercialRevision" map="revisionValues">
                                        <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                                        <field name="commercialRevisionOnly"><default-field><hidden/></default-field></field>
                                        <field name="changeReason"><default-field title="Reason"><text-line size="40"/></default-field></field>
                                        <field name="submitButton"><default-field title="${found?.commercialRevisionOnly ? 'Turn off' : 'Turn on'}"><submit/></default-field></field>
                                    </form-single>
                                </container-dialog>
                            </box-toolbar>
                            <box-body>
                                <label type="p" condition="found?.commercialRevisionOnly"
                                        text="On: a quote's revision moves with its commercial changes only, so storing its PDF, a file or a note leaves an issue and an approval in force."/>
                                <label type="p" style="text-warning" condition="!found?.commercialRevisionOnly"
                                        text="Off: every change of a quote, a file or a note among them, moves its revision, so a quote cannot be issued."/>
                                <label type="p" style="text-caption m-muted" condition="!found?.commercialRevisionOwn"
                                        text="Set in ${found?.commercialRevisionOwnerName || 'another organization'}'s accounting preference."/>
                            </box-body>
                        </container-box>
                    </row-col>
                </container-row>
            </widgets>
        </section>
        <container-box condition="policyFound &amp;&amp; versionRows.length">
            <box-header title="Scheduled and earlier · ${versionRows.length}"/>
            <box-body-nopad>
                <form-list name="DefaultsVersions" list="versionRows" skip-form="true" paginate="false">
                    <field name="fromText"><default-field title="From"><display/></default-field></field>
                    <field name="thruText"><default-field title="Until"><display/></default-field></field>
                    <field name="stateText"><default-field title="State"><display/></default-field></field>
                    <field name="quoteValidityDays" align="right"><default-field title="Validity days"><display/></default-field></field>
                    <field name="teamName"><default-field title="Default team"><display/></default-field></field>
                    <field name="changeReason">
                        <default-field title="Why">
                            <label text="${changeReason}" type="span"/>
                            <label text="${changedByName}" type="div" style="text-caption m-muted" condition="changedByName"/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column><field-ref name="fromText"/><field-ref name="stateText"/></column>
                        <column><field-ref name="changeReason"/></column>
                    </columns>
                </form-list>
            </box-body-nopad>
        </container-box>
    </widgets>
</screen>
