<!-- Sales › Settings › TypesAndReasons (design-sales §9 TypesAndReasons: SalesTypes, LossReasons; style-guide §3.9 Settings; impl-sales
    P2): the opportunity types (Lead and Opportunity, fixed semantic ids), the outcomes and the recurring plans, read only
    (mantle.sales.OpportunityServices.get#SalesSetup); and the lost reasons, the instance's, added, renamed, reordered and ended,
    never deleted (store#LostReason): an ended reason stays on the deals that hold it and is offered for no new one.
    SALES_CONFIGURE, which Mantle checks; the reasons being the instance's, they are changed only by a configurer of every
    organization (SALES_ALL_ORGANIZATIONS, get#SalesSetup canEditReasons; the user's call, impl-sales §4 Nov 13, P4), and a
    configurer of one organization reads them. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Types and reasons" default-menu-index="5"
        default-menu-include="ec.user.hasPermission('SALES_CONFIGURE')">
    <parameter name="includeEnded"/>
    <transition name="storeReason">
        <actions>
            <service-call name="mantle.sales.OpportunityServices.store#LostReason"
                    in-map="{enumId:(enumId || null), description:(description ?? null), sequenceNum:(sequenceNum ?? null),
                        end:(endReason == 'Y'), expectedRevision:(expectedRevision || null)}"/>
            <if condition="!ec.message.hasError()"><message type="success">${endReason == 'Y' ? 'Reason ended' : 'Reason saved'}</message></if>
        </actions>
        <default-response url="."><parameter name="includeEnded"/></default-response>
        <error-response url="."><parameter name="includeEnded"/></error-response>
    </transition>
    <always-actions>
        <script>if(!(sales.capabilities.configure))throw new Error('PERMISSION_DENIED: Sales settings are the Sales administrator\'s')</script>
    </always-actions>
    <actions>
        <set field="can" from="sales.capabilities"/>
        <set field="organizationPartyId" from="sales.defaultOrganizationPartyId || (sales.organizationPartyIds || [])[0] || null"/>
        <if condition="can.configure &amp;&amp; organizationPartyId">
            <service-call name="mantle.sales.OpportunityServices.get#SalesSetup" out-map="setup" transaction="force-new"
                    ignore-error="true" in-map="{organizationPartyId:organizationPartyId, includeEnded:(includeEnded == 'Y')}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="setupFound" from="!!setup?.organizationPartyId"/>
        <set field="typeList" from="(setup?.types || []).map(row =&gt; Object.assign({}, row, {kindText: 'Opportunity type'}))
                .concat((setup?.recurringPlans || []).map(row =&gt; Object.assign({}, row, {kindText: 'Recurring plan', note: row.enumCode + (row.enumCode == '1' ? ' month' : ' months')})))"/>
        <set field="reasonList" from="setup?.lostReasons || []"/>
        <set field="canEditReasons" from="!!setup?.canEditReasons"/>
        <set field="findValues" from="{includeEnded: includeEnded || null}"/>
        <set field="newReason" from="{}"/>
    </actions>
    <widgets>
        <label text="Types and reasons" type="h5"/>
        <label type="p" style="text-negative" condition="!setupFound" text="Sales' types and reasons cannot be read just now."/>
        <container-box condition="setupFound">
            <box-header title="Types"/>
            <box-body-nopad>
                <label type="p" style="text-caption m-muted q-px-sm"
                        text="Fixed: a deal is a lead until qualified, then an opportunity; it ends Won or Lost."/>
                <form-list name="SalesTypes" list="typeList" skip-form="true" paginate="false">
                    <field name="description"><default-field title="Name"><display/></default-field></field>
                    <field name="kindText"><default-field title="Kind"><display/></default-field></field>
                    <field name="note"><default-field title=""><display/></default-field></field>
                    <columns type="mobile">
                        <column><field-ref name="description"/></column>
                        <column><field-ref name="kindText"/></column>
                    </columns>
                </form-list>
            </box-body-nopad>
        </container-box>
        <container-box condition="setupFound">
            <box-header title="Lost reasons"/>
            <box-toolbar>
                <container-dialog id="NewReasonDialog" button-text="Add reason" icon="sym_o_add" type="default" width="520" title="Add a lost reason"
                        condition="canEditReasons">
                    <form-single name="NewReason" transition="storeReason" map="newReason">
                        <field name="description"><default-field title="Reason"><text-line size="40"/></default-field></field>
                        <field name="sequenceNum"><default-field title="Order" tooltip="Empty: last"><text-line size="5" input-type="number"/></default-field></field>
                        <field name="submitButton"><default-field title="Add reason"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body-nopad>
                <form-single name="ReasonsFind" transition="." map="findValues">
                    <field name="includeEnded"><default-field title=" "><check><option key="Y" text="Include ended reasons"/></check></default-field></field>
                    <field name="submitButton"><default-field title="Show"><submit/></default-field></field>
                    <field-layout><field-row><field-ref name="includeEnded"/><field-ref name="submitButton"/></field-row></field-layout>
                </form-single>
                <form-list name="LossReasons" list="reasonList" skip-form="true" paginate="false">
                    <field name="sequenceNum" align="right"><default-field title="Order"><display/></default-field></field>
                    <field name="description"><default-field title="Reason"><display/></default-field></field>
                    <field name="stateText"><default-field title="State"><display/></default-field></field>
                    <field name="actions">
                        <default-field title="">
                            <container-dialog id="EditReason_${enumId}" button-text="Edit" icon="sym_o_edit" type="default" width="520"
                                    title="Edit ${description}" condition="!ended &amp;&amp; canEditReasons">
                                <form-single name="EditReason" transition="storeReason"
                                        map="{enumId:enumId, expectedRevision:revision, description:description, sequenceNum:sequenceNum}">
                                    <field name="enumId"><default-field><hidden/></default-field></field>
                                    <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                    <field name="description"><default-field title="Reason"><text-line size="40"/></default-field></field>
                                    <field name="sequenceNum"><default-field title="Order"><text-line size="5" input-type="number"/></default-field></field>
                                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                                </form-single>
                            </container-dialog>
                            <link url="storeReason" text="End" icon="sym_o_event_busy" link-type="hidden-form" btn-type="default" condition="!ended &amp;&amp; canEditReasons"
                                    confirmation="End ${description}? Deals lost for it keep it." parameter-map="{enumId:enumId, expectedRevision:revision, endReason:'Y'}"/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column><field-ref name="description"/></column>
                        <column><field-ref name="stateText"/><field-ref name="actions"/></column>
                    </columns>
                </form-list>
                <label text="${canEditReasons ? 'No lost reason yet: add the first.' : 'No lost reason yet.'}" type="p" style="m-muted q-pa-sm" condition="!reasonList.length"/>
                <label text="The lost reasons are shared by every organization; an administrator of every organization changes them."
                        type="p" style="text-caption m-muted q-pa-sm" condition="!canEditReasons"/>
            </box-body-nopad>
        </container-box>
    </widgets>
</screen>
