<!-- Insights › Wall display (design-insights §4 Playlists; impl-insights P2, INS-04): the dashboard playlists the viewer may read (a
    report definition of kind playlist), and one played in kiosk mode by the framework Playlist screen (Tools
    Dashboards/Playlist.xml) when one is chosen. It is Insights' own screen around the framework's Playlists (Tools
    Dashboards/Playlists.xml, mr-moqui docs/tools/Monitoring.md "Playlists and the wall display"): its list of playlists
    (template/ReportPlaylists.js, read through the report engine as the viewer, Tools' own left out), its New playlist and its
    transitions createPlaylist, play, edit and sharePlaylist, taken in here; what Insights adds is the wall displays and their
    devices. The display runs as the signed-in viewer: a dashboard they cannot read is skipped and its failure logged by
    name, and its dashboard links open Insights › Dashboard. An author creates a playlist here and orders it in DashboardEditor.
    P11 (design §4 Playlists, CX-DEVICE): a registered wall display plays its playlist on WallDisplay as its display account, which
    reads a playlist and its dashboards when they are shared with the wall displays (BOSS_INSIGHTS_DISPLAY). The owner's Share
    with wall displays and Stop sharing post the framework's sharePlaylist with that group or none: the transition holds the
    root's reportPolicy (features.share, the author's; the wall displays among its shareGroups) and the report engine's save
    takes the group only from one whose own grant holds its share artifact. Play full screen opens WallDisplay for the viewer;
    Register as display opens Admin's RegisterDevice for the playlist (a holder of ADMIN_ACCESS_MANAGE, whose service checks
    it); the devices showing each playlist are listed, read only, to a holder of ADMIN_ACCESS_VIEW or ADMIN_ACCESS_MANAGE
    (Mantle's find#SharedDevices, within their identity scope; another organization's device is not named). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Wall display" default-menu-index="4" menu-image="sym_o_slideshow" menu-image-type="icon">

    <parameter name="definitionId"/>
    <parameter name="from"/>
    <parameter name="thru"/>

    <transition-include name="data" location="component://tools/screen/Dashboards/Playlist.xml"/>
    <transition-include name="createPlaylist" location="component://tools/screen/Dashboards/Playlists.xml"/>
    <transition-include name="play" location="component://tools/screen/Dashboards/Playlists.xml"/>
    <transition-include name="edit" location="component://tools/screen/Dashboards/Playlists.xml"/>
    <!-- the owner shares the playlist with the wall displays, or makes it private (the framework's: features.share, the
        owner and the group checked there and by the engine's save) -->
    <transition-include name="sharePlaylist" location="component://tools/screen/Dashboards/Playlists.xml"/>

    <actions>
        <if condition="!definitionId">
            <!-- the framework's list: the playlists, New playlist for one who may save where there is an editor, and whether
                sharing is the viewer's here -->
            <set field="playlistView" from="ec.resource.script('component://tools/template/ReportPlaylists.js').list()"/>
            <set field="wallDisplayPath" from="sri.buildUrl('../WallDisplay').path"/>
            <set field="displayGroupId" value="BOSS_INSIGHTS_DISPLAY"/>
            <!-- P11: the devices showing each playlist, read only, for an access administrator (within their identity scope) -->
            <set field="canRegister" from="ec.user.hasPermission('ADMIN_ACCESS_MANAGE')"/>
            <set field="seesDevices" from="canRegister || ec.user.hasPermission('ADMIN_ACCESS_VIEW')"/>
            <script><![CDATA[
                const shownOn = {}
                if (seesDevices && playlistView.playlists.length) {
                    ec.message.pushErrors()
                    try {
                        const out = ec.service.sync().name('mantle.party.IdentityServices.find#SharedDevices')
                                .parameters({routeGroupId: 'INSIGHTS_PLAYLISTS', pageSize: 200}).call() || {}
                        for (const row of Array.from(out.deviceList || []))
                            (shownOn[row.parameterValue] = shownOn[row.parameterValue] || []).push(row.deviceName + ' (' + row.stateReason + ')')
                    } catch (error) { ec.logger.warn('Wall display devices not read: ' + String(error)) }
                    finally { ec.message.clearErrors(); ec.message.popErrors() }
                }
                // a definition has one group (P12): a playlist shared with another group is moved to the wall displays only
                // after the owner is told so
                for (const row of playlistView.playlists) {
                    row.devices = (shownOn[row.id] || []).join(', ')
                    row.onDisplays = row.userGroupId === displayGroupId
                    row.otherGroupName = row.userGroupId && !row.onDisplays ? (row.sharedWith || 'another group') : ''
                }
            ]]></script>
        </if>
    </actions>
    <widgets>
        <section name="PlayPlaylist" condition="definitionId"><widgets>
            <include-screen location="component://tools/screen/Dashboards/Playlist.xml" share-scope="true"/>
        </widgets><fail-widgets>
            <section-include name="PlaylistsHeader" location="component://tools/screen/Dashboards/Playlists.xml"/>
            <section name="PlaylistList" condition="playlistView.playlists.length"><widgets>
                <form-list name="Playlists" extends="component://tools/screen/Dashboards/Playlists.xml#Playlists" list="playlistView.playlists" skip-form="true" paginate="false">
                    <field name="sharedText"><conditional-field condition="playlistView.mayShare &amp;&amp; owned &amp;&amp; otherGroupName" title="Wall displays">
                            <link url="sharePlaylist" text="Share with wall displays" link-type="hidden-form-link"
                                    confirmation="It is shared with ${otherGroupName} now. A playlist is shared with one group at a time, so sharing it with the wall displays takes it from ${otherGroupName}."
                                    parameter-map="{shareDefinitionId:id, userGroupId:displayGroupId}"/>
                            <label text="Shared with ${otherGroupName}" type="p" style="text-caption m-muted q-mb-none"/></conditional-field>
                        <conditional-field condition="playlistView.mayShare &amp;&amp; owned" title="Wall displays">
                            <link url="sharePlaylist" text="${onDisplays ? 'Stop sharing with wall displays' : 'Share with wall displays'}" link-type="hidden-form-link"
                                    parameter-map="{shareDefinitionId:id, userGroupId:(onDisplays ? '' : displayGroupId)}"/></conditional-field>
                        <default-field title="Wall displays"><display text="${onDisplays ? 'Shared' : ''}"/></default-field></field>
                    <field name="devices"><conditional-field condition="seesDevices" title="Devices showing it"><display/></conditional-field>
                        <default-field title=""><display text=""/></default-field></field>
                    <field name="register"><conditional-field condition="canRegister" title=""><link url="//Admin/Security/Devices" text="Register as display"
                            link-type="anchor" parameter-map="{newRouteGroupId:'INSIGHTS_PLAYLISTS', newParameterValue:id}"/></conditional-field>
                        <default-field title=""><display text=""/></default-field></field>
                    <columns type="mobile">
                        <column><field-ref name="title"/><field-ref name="devices"/></column>
                        <column><field-ref name="count"/><field-ref name="edit"/><field-ref name="register"/></column>
                    </columns>
                </form-list>
            </widgets><fail-widgets>
                <label text="No wall display playlists are shared with you yet." type="p"/>
            </fail-widgets></section>
        </fail-widgets></section>
    </widgets>
</screen>
