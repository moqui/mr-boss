<!-- Insights › Scheduled reports (design-insights §7 ScheduledReports, ScheduledReportDetail, ReportDelivery; impl-insights P7,
    INS-06, INS-11): the list (Schedules, the default: Mine, Shared administration and Received) with the hidden
    ScheduledReportDetail and ReportDelivery, replacing the copied personal scheduled finds (impl-insights F20; design §13.2),
    whose rows are kept and listed under Mine. Every Insights user opens it (Received is every reader's); each transition
    reaches ironstone.insights.DeliveryServices, which checks INSIGHTS_SCHEDULE or INSIGHTS_DISTRIBUTE itself, and the report
    engine checks its own grants and each recipient. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Scheduled reports" default-menu-index="8" menu-image="sym_o_schedule" menu-image-type="icon">
    <subscreens default-item="Schedules" always-use-full-path="true">
        <subscreens-item name="Schedules" location="component://mr-boss/screen/Insights/ScheduledReports/Schedules.xml" menu-include="false"/>
        <subscreens-item name="ScheduledReportDetail" location="component://mr-boss/screen/Insights/ScheduledReports/ScheduledReportDetail.xml" menu-include="false"/>
        <subscreens-item name="ReportDelivery" location="component://mr-boss/screen/Insights/ScheduledReports/ReportDelivery.xml" menu-include="false"/>
    </subscreens>
    <widgets><subscreens-active/></widgets>
</screen>
