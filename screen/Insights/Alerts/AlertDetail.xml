<!-- Insights › Business alerts › an alert (design-insights §8 AlertDetail; impl-insights P8, INS-07; mr-moqui
    plans/archive/Admin-Screens-Down.md, Track I): the framework's Dashboards › AlertRule at this location, for anyone who reads the
    rule, with the seven transitions Insights offers: recipientChoices (Insights' readers, for a distributor), storeAlert
    (the reading, condition and timing of a rule of the caller's own; a new one over a panel's saved query, from the panel's
    New alert rule), storeAudience (the people and groups it tells, each accepted and then checked by the engine),
    pauseAlert (Activate runs the reading as the owner first), testAlert, copyAlert and deleteAlert. Each change is refused
    to one who may set no alert here, and every save writes Insights' topic, message, link and recipient cap (reportPolicy,
    which the root and the Alerts area set). The framework screen's contact points, silences, mute timings, shared items
    and evaluation are Tools' own: they are not shown under Insights' policy and their transitions (addContact,
    addSilence, addMute, removeItem, addRef, removeRef, evaluate) are not taken in, so they do not exist on this route. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Business alert" default-menu-include="false">
    <parameter name="definitionId"/>
    <parameter name="dashboardId"/>
    <parameter name="panelId"/>
    <parameter name="queryIndex"/>

    <transition-include name="recipientChoices" location="component://tools/screen/Dashboards/AlertRule.xml"/>
    <transition-include name="storeAlert" location="component://tools/screen/Dashboards/AlertRule.xml"/>
    <transition-include name="storeAudience" location="component://tools/screen/Dashboards/AlertRule.xml"/>
    <transition-include name="pauseAlert" location="component://tools/screen/Dashboards/AlertRule.xml"/>
    <transition-include name="testAlert" location="component://tools/screen/Dashboards/AlertRule.xml"/>
    <transition-include name="copyAlert" location="component://tools/screen/Dashboards/AlertRule.xml"/>
    <transition-include name="deleteAlert" location="component://tools/screen/Dashboards/AlertRule.xml"/>

    <widgets>
        <include-screen location="component://tools/screen/Dashboards/AlertRule.xml" share-scope="true"/>
    </widgets>
</screen>
