<!-- Insights › Business alerts, the list (design-insights §8 Alerts; impl-insights P8; mr-moqui plans/archive/Admin-Screens-Down.md,
    Track I): the framework's Dashboards › Alerts at this location, with the three transitions Insights offers: copyAlert (a
    shipped rule copied to the caller, with Insights' fixed parts, inactive until they activate it), pauseAlerts and
    deleteAlert, each of the caller's own rule and each refused to one who may set no alert here (a reader, a dataset
    steward). Under Insights' policy the views are Mine, Received (every reader's) and Templates, and only business rules
    are listed: Tools' telemetry rules and its shared contact points, silences and mute timings are not shown, and their
    transitions (evaluate, deleteShared) are not taken in, so they do not exist on this route. A new rule over a panel
    starts from that panel's menu on a dashboard (New alert rule). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Business alerts" default-menu-include="false">
    <parameter name="view"/>
    <parameter name="state"/>

    <transition-include name="copyAlert" location="component://tools/screen/Dashboards/Alerts.xml"/>
    <transition-include name="pauseAlerts" location="component://tools/screen/Dashboards/Alerts.xml"/>
    <transition-include name="deleteAlert" location="component://tools/screen/Dashboards/Alerts.xml"/>

    <widgets>
        <include-screen location="component://tools/screen/Dashboards/Alerts.xml" share-scope="true"/>
    </widgets>
</screen>
