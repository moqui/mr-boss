<!-- Insights › Scheduled reports, the list (design-insights §7 ScheduledReports; impl-insights P7): ScheduleFind (the view and
    the report), ScreenScheduledList and NewSchedule. Mine: the caller's personal schedules, with the screen schedules they
    set up for themselves (the copied scheduled finds, rows kept); Shared administration: the group schedules a distributor
    owns; Received: the reports delivered to the caller, each opening its delivery and their own report, for every reader
    whatever they may schedule (ironstone.insights.DeliveryServices find#Schedules). New schedule is the primary action: a
    report the caller reads, a timing and a format, for themselves, or for a distributor with people and groups, each checked
    by the report engine (store#Schedule; a recipient whose access differs is refused with the reason). Pause, resume and Send
    now confirm the report; the bulk pause answers each schedule's result. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Scheduled reports" default-menu-include="false">

    <parameter name="view"/>
    <parameter name="definitionId"/>
    <parameter name="state"/>
    <parameter name="pageIndex"/>

    <transition-include name="recipientChoices" location="component://mr-boss/template/InsightsDeliveryTransitions.xml"/>
    <transition-include name="ownReportFile" location="component://mr-boss/template/InsightsDeliveryTransitions.xml"/>
    <transition name="createSchedule" method="post">
        <actions>
            <service-call name="ironstone.insights.DeliveryServices.store#Schedule" out-map="stored"
                    in-map="{definitionId:newDefinitionId, cronSelected:cronSelected, renderMode:renderMode, noResultsAbort:'Y',
                        emailSubject:emailSubject, recipientsGiven:'Y', recipientUserIds:(audienceKind === 'group' ? recipientUserIds : null),
                        recipientGroupIds:(audienceKind === 'group' ? recipientGroupIds : null)}"/>
            <script>ec.message.addMessage(stored.applied ? 'Schedule saved' : stored.reason, stored.applied ? 'success' : 'danger')</script>
            <set field="screenScheduledId" from="stored.screenScheduledId"/>
        </actions>
        <conditional-response url="../ScheduledReportDetail" condition="stored?.applied"><parameter name="screenScheduledId"/></conditional-response>
        <default-response url="."/>
    </transition>
    <transition name="pauseSchedules" method="post">
        <actions>
            <service-call name="ironstone.insights.DeliveryServices.pause#Schedules" out-map="pausedOut"
                    in-map="{screenScheduledIds:screenScheduledIds, paused:paused}"/>
            <script><![CDATA[
                for (const result of pausedOut.results) if (!result.applied) ec.message.addMessage(result.reason, 'danger')
                if (pausedOut.appliedCount) ec.message.addMessage(pausedOut.appliedCount + (pausedOut.appliedCount === 1 ? ' schedule ' : ' schedules ')
                    + (pausedOut.paused ? 'paused' : 'resumed'), 'success')
            ]]></script>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="sendNow" method="post">
        <actions>
            <service-call name="ironstone.insights.DeliveryServices.send#Schedule" in-map="{screenScheduledId:screenScheduledId}" out-map="sent"/>
            <script>ec.message.addMessage(!sent.applied ? sent.reason : sent.skipped ? 'Nothing was sent: ' + (sent.skippedReason || 'not due')
                : 'Sent: each recipient has their own message', sent.applied &amp;&amp; !sent.skipped ? 'success' : 'warning')</script>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- a member of the root group alone reads nothing in Insights: told so, as on Home -->
        <if condition="insights.capabilities.view"><then>
            <service-call name="ironstone.insights.DeliveryServices.find#Schedules" out-map="found"
                    in-map="{view:view, definitionId:definitionId, state:state, pageIndex:(pageIndex ? Number(pageIndex) : 0)}"/>
        </then><else>
            <set field="found" from="{view:'received', schedules:[], received:[], canSchedule:false, canDistribute:false,
                    definitionOptions:[], formatOptions:[], cronOptions:[], receivedCount:0}"/>
        </else></if>
        <set field="view" from="found.view"/>
        <set field="scheduleList" from="found.schedules"/>
        <set field="received" from="found.received"/>
        <script>for (const key of ['Count', 'PageIndex', 'PageSize', 'PageMaxIndex', 'PageRangeLow', 'PageRangeHigh']) context['received' + key] = found['received' + key]</script>
        <set field="viewOptions" from="(found.canSchedule ? [{value:'mine', label:'Mine'}] : []).concat(
                found.canDistribute ? [{value:'shared', label:'Shared administration'}] : [], [{value:'received', label:'Received'}])"/>
        <set field="stateOptions" from="[{value:'active', label:'Active'}, {value:'paused', label:'Paused'}]"/>
        <set field="findValues" from="{view:view, definitionId:definitionId, state:state}"/>
        <set field="newValues" from="{newDefinitionId:definitionId, cronSelected:'0 0 6 ? * MON', renderMode:'pdf', audienceKind:'personal'}"/>
        <set field="audienceOptions" from="[{value:'personal', label:'Only me'}, {value:'group', label:'People and groups'}]"/>
        <if condition="found.canDistribute"><service-call name="ironstone.insights.DashboardServices.get#ShareGroups" out-map="share"/></if>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col"><label text="Scheduled reports" type="h5"/></container>
            <container style="col-auto row q-gutter-sm">
                <container-dialog id="NewSchedule" button-text="New schedule" type="primary" icon="sym_o_add" condition="found.canSchedule">
                    <label type="p" style="m-muted" text="The report is rendered as you and sent by email. Other people receive it only when they may read exactly what you read; each gets a message of their own."/>
                    <form-single name="NewScheduleForm" transition="createSchedule" map="newValues">
                        <field name="newDefinitionId"><default-field title="Report" tooltip="A dashboard or digest you may read">
                            <drop-down><list-options list="found.definitionOptions" key="${value}" text="${label}"/></drop-down>
                        </default-field></field>
                        <field name="cronSelected"><default-field title="When">
                            <drop-down><list-options list="found.cronOptions" key="${value}" text="${label}"/></drop-down>
                        </default-field></field>
                        <field name="renderMode"><default-field title="Format">
                            <drop-down><list-options list="found.formatOptions" key="${value}" text="${label}"/></drop-down>
                        </default-field></field>
                        <field name="emailSubject"><default-field title="Subject" tooltip="Leave it empty to use the report's name"><text-line size="50"/></default-field></field>
                        <field name="audienceKind">
                            <conditional-field condition="found.canDistribute" title="Send to">
                                <radio><list-options list="audienceOptions" key="${value}" text="${label}"/></radio>
                            </conditional-field>
                            <default-field><hidden default-value="personal"/></default-field>
                        </field>
                        <field name="recipientUserIds">
                            <conditional-field condition="found.canDistribute" title="People" tooltip="Insights readers; each is checked when you save">
                                <drop-down allow-multiple="true" allow-empty="true">
                                    <dynamic-options transition="recipientChoices" server-search="true" min-length="0"/>
                                </drop-down>
                            </conditional-field>
                            <default-field><ignored/></default-field>
                        </field>
                        <field name="recipientGroupIds">
                            <conditional-field condition="found.canDistribute" title="Groups" tooltip="A group you belong to; every member is checked">
                                <drop-down allow-multiple="true" allow-empty="true"><list-options list="share?.groups || []" key="${value}" text="${label}"/></drop-down>
                            </conditional-field>
                            <default-field><ignored/></default-field>
                        </field>
                        <field name="save"><default-field><submit text="Save schedule"/></default-field></field>
                    </form-single>
                </container-dialog>
            </container>
        </container>

        <form-single name="ScheduleFind" transition="." map="findValues">
            <field name="view"><default-field title="Show">
                <drop-down><list-options list="viewOptions" key="${value}" text="${label}"/></drop-down>
            </default-field></field>
            <field name="definitionId"><default-field title="Report">
                <drop-down allow-empty="true"><list-options list="found.definitionOptions" key="${value}" text="${label}"/></drop-down>
            </default-field></field>
            <field name="state"><default-field title="State">
                <drop-down allow-empty="true"><list-options list="stateOptions" key="${value}" text="${label}"/></drop-down>
            </default-field></field>
            <field name="apply"><default-field><submit text="Find"/></default-field></field>
            <field-layout><field-row><field-ref name="view"/><field-ref name="definitionId"/><field-ref name="state"/><field-ref name="apply"/></field-row></field-layout>
        </form-single>

        <section name="OwnedSchedules" condition="view != 'received'"><widgets>
            <label type="p" style="m-muted" condition="!scheduleList.length"
                    text="${view == 'shared' ? 'You own no schedule that delivers to other people.' : 'You have no schedule yet. Start one with New schedule.'}"/>
            <form-list name="ScreenScheduledList" list="scheduleList" paginate="false" condition="scheduleList.length">
                <row-selection id-field="screenScheduledId" parameter="screenScheduledIds" list-mode="true">
                    <action>
                        <dialog button-text="Pause" title="Pause the selected schedules"/>
                        <form-single name="PauseSelected" transition="pauseSchedules">
                            <field name="paused"><default-field><hidden default-value="true"/></default-field></field>
                            <field name="note"><default-field title=""><label text="The selected schedules send nothing until resumed. Each one's result is shown."/></default-field></field>
                            <field name="submitButton"><default-field title="Pause"><submit/></default-field></field>
                        </form-single>
                    </action>
                </row-selection>
                <field name="title"><default-field title="Schedule">
                    <link url="../ScheduledReportDetail" text="${title}" link-type="anchor" parameter-map="{screenScheduledId:screenScheduledId}"/>
                </default-field></field>
                <field name="definitionTitle"><default-field title="Report"><display/></default-field></field>
                <field name="cronText"><default-field title="When"><display text="${cronText} · ${formatText}"/></default-field></field>
                <field name="modeText"><default-field title="To"><display text="${audienceText}"/></default-field></field>
                <field name="stateText"><default-field title="State">
                    <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${
                                    WebUtilities.encodeHtml(stateText)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateText})}]]></text>
                                <text type="html">${stateText}</text>
                            </render-mode>
                </default-field></field>
                <field name="lastText"><default-field title="Last run">
                    <link url="../ReportDelivery" text="${lastText}" link-type="anchor" condition="lastOccurrenceId" parameter-map="{occurrenceId:lastOccurrenceId}"/>
                    <label text="${lastText}" condition="!lastOccurrenceId"/>
                </default-field></field>
                <field name="actions"><default-field title="">
                    <link url="pauseSchedules" link-type="hidden-form" text="Pause" condition="!paused"
                            confirmation="Pause ${title}? It sends nothing until resumed."
                            parameter-map="{screenScheduledIds:screenScheduledId, paused:'true'}"/>
                    <link url="pauseSchedules" link-type="hidden-form" text="Resume" condition="paused"
                            confirmation="Resume ${title}? Its recipients (${audienceText}) are checked again first."
                            parameter-map="{screenScheduledIds:screenScheduledId, paused:'false'}"/>
                    <link url="sendNow" link-type="hidden-form" text="Send now" condition="!legacy &amp;&amp; !paused"
                            confirmation="Send ${title} now to ${audienceText}? This is a new run, not a repeat of an earlier one."
                            parameter-map="{screenScheduledId:screenScheduledId}"/>
                </default-field></field>
                <columns type="mobile">
                    <column><field-ref name="title"/><field-ref name="cronText"/></column>
                    <column><field-ref name="stateText"/><field-ref name="actions"/></column>
                </columns>
            </form-list>
        </widgets></section>

        <section name="ReceivedReports" condition="view == 'received'"><widgets>
            <label type="p" style="m-muted" condition="!received.length"
                    text="${insights.capabilities.view ? 'No report has been delivered to you yet.' : 'Scheduled reports are shown to Insights readers.'}"/>
            <form-list name="ReceivedList" list="received" skip-form="true" paginate="true" condition="received.length">
                <field name="title"><default-field title="Report">
                    <link url="../ReportDelivery" text="${title}" link-type="anchor" parameter-map="{occurrenceId:occurrenceId}"/>
                </default-field></field>
                <field name="dateText"><default-field title="Run"><display/></default-field></field>
                <field name="stateText"><default-field title="Your delivery">
                    <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${
                                    WebUtilities.encodeHtml(stateText)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateText})}]]></text>
                                <text type="html">${stateText}</text>
                            </render-mode>
                </default-field></field>
                <field name="reasonText"><default-field title="Why"><display/></default-field></field>
                <field name="open"><default-field title="">
                    <link url="ownReportFile" text="Open my report" link-type="anchor" target-window="_blank" condition="sent"
                            parameter-map="{deliveryId:deliveryId}"/>
                </default-field></field>
                <columns type="mobile">
                    <column><field-ref name="title"/><field-ref name="dateText"/></column>
                    <column><field-ref name="stateText"/><field-ref name="open"/></column>
                </columns>
            </form-list>
        </widgets></section>
    </widgets>
</screen>
