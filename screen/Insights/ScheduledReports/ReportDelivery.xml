<!-- Insights › Scheduled reports › a delivery (design-insights §7 ReportDelivery; impl-insights P7, INS-06): one run of a
    schedule (ironstone.insights.DeliveryServices get#Delivery; missing and someone else's read alike as "not available").
    Occurrence: what ran, for its schedule's owner (the schedule's revision, the report's version, the safe counters).
    RecipientOutcomes: each recipient's own result with its safe reason, never a payload. RetryRecipients: the failed deliveries
    chosen, sent again after each recipient is checked again, at the revision read; a delivery whose outcome is not known is
    reconciled by a person first, never retried blind. OwnArtifact: the caller's own report, rendered again as themselves
    (nothing sent is kept), or why it is not released. A recipient who administers nothing sees their own delivery alone. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Report delivery" default-menu-include="false">

    <parameter name="occurrenceId" required="true"/>

    <transition-include name="ownReportFile" location="component://mr-boss/template/InsightsDeliveryTransitions.xml"/>
    <transition name="retryRecipients" method="post">
        <actions>
            <service-call name="ironstone.insights.DeliveryServices.retry#Recipients" out-map="retried"
                    in-map="{occurrenceId:occurrenceId, deliveryIds:deliveryIds, expectedRevision:expectedRevision, reason:reason}"/>
            <script><![CDATA[
                if (!retried.applied) ec.message.addMessage(retried.reason, 'danger')
                else {
                    for (const result of retried.results) if (!result.retried) ec.message.addMessage(result.reason, 'warning')
                    ec.message.addMessage(retried.sentCount + (retried.sentCount === 1 ? ' recipient' : ' recipients') + ' sent on retry',
                        retried.sentCount ? 'success' : 'warning')
                }
            ]]></script>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="reconcileRecipient" method="post">
        <actions>
            <service-call name="ironstone.insights.DeliveryServices.reconcile#Recipient" out-map="settled"
                    in-map="{deliveryId:deliveryId, outcome:outcome, reason:reason}"/>
            <script>ec.message.addMessage(settled.applied ? 'Delivery settled' : settled.reason, settled.applied ? 'success' : 'danger')</script>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <service-call name="ironstone.insights.DeliveryServices.get#Delivery" in-map="{occurrenceId:occurrenceId}" out-map="found"
                transaction="force-new" ignore-error="true"/>
        <script>ec.message.clearErrors()</script>
        <set field="recordFound" from="!!found?.occurrence"/>
        <set field="occurrence" from="found?.occurrence || {}"/>
        <set field="deliveries" from="found?.deliveries || []"/>
        <set field="ownDelivery" from="found?.ownDelivery || null"/>
        <set field="administers" from="!!found?.administers"/>
        <set field="canRetry" from="!!found?.canRetry"/>
        <set field="failedCount" from="deliveries.filter(row =&gt; row.retryable).length"/>
        <set field="outcomeOptions" from="[{value:'sent', label:'It did arrive'}, {value:'failed', label:'It did not arrive'}]"/>
    </actions>
    <widgets>
        <section name="DeliveryUnavailable" condition="!recordFound"><widgets>
            <label text="Delivery not available" type="h5"/>
            <label type="p" text="This delivery does not exist or is not yours to see."/>
            <link url="../Schedules" text="Back to scheduled reports" link-type="anchor"/>
        </widgets></section>
        <section name="DeliveryRecord" condition="recordFound"><widgets>
            <container style="m-record-header">
                <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                    <container style="col-12 col-md m-record-title">
                        <label text="${occurrence.title}" type="h5"/>
                        <label type="p" style="text-caption m-muted q-mb-none"
                                text="Run ${occurrence.dateText}${occurrence.formatText ? ' · ' + occurrence.formatText : ''}${occurrence.kindText ? ' · ' + occurrence.kindText : ''}"/>
                    </container>
                    <container style="col-12 col-md-auto m-record-status">
                        <section name="RunState" condition="administers"><widgets>
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${occurrence.stateColor}">${
                                    WebUtilities.encodeHtml(occurrence.stateText)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: occurrence.stateText})}]]></text>
                                <text type="html">${occurrence.stateText}</text>
                            </render-mode>
                        </widgets></section>
                    </container>
                </container>
                <container style="row items-center q-col-gutter-x-md q-col-gutter-y-sm m-record-foot">
                    <container style="col-12 col-md">
                        <label type="p" style="q-mb-none" condition="administers"
                                text="${occurrence.countsText}${occurrence.reasonText ? ' · ' + occurrence.reasonText : ''}"/>
                        <label type="p" style="q-mb-none text-caption m-muted" condition="administers"
                                text="${occurrence.modeText} · ${occurrence.versionText}${occurrence.rendersText ? ' · ' + occurrence.rendersText : ''}"/>
                    </container>
                    <container style="col-12 col-md-auto row items-center q-gutter-y-xs m-record-actions">
                        <link url="ownReportFile" text="Open my report" link-type="anchor-button" btn-type="primary" icon="sym_o_description"
                                target-window="_blank" condition="ownDelivery?.sent" parameter-map="{deliveryId:ownDelivery?.deliveryId}"/>
                        <link url="../ScheduledReportDetail" text="The schedule" link-type="anchor" condition="occurrence.screenScheduledId"
                                parameter-map="{screenScheduledId:occurrence.screenScheduledId}"/>
                        <link url="../Schedules" text="Received reports" link-type="anchor" condition="!administers" parameter-map="{view:'received'}"/>
                    </container>
                </container>
            </container>

            <section name="OwnArtifact" condition="ownDelivery"><widgets>
                <container-box>
                    <box-header title="Your delivery"/>
                    <box-body>
                        <label type="p" text="${ownDelivery.stateText}${ownDelivery.attemptText ? ' on ' + ownDelivery.attemptText : ''}${ownDelivery.reasonText ? ': ' + ownDelivery.reasonText : ''}"/>
                        <label type="p" style="m-muted" condition="ownDelivery.sent"
                                text="Open my report renders it again for you with what you may read now; what was sent is not kept here."/>
                    </box-body>
                </container-box>
            </widgets></section>

            <section name="RecipientOutcomesBox" condition="administers"><widgets>
                <container-box>
                    <box-header title="Recipients"/>
                    <box-body>
                        <label type="p" style="m-muted" text="Each recipient has a message and a result of their own. A reason says why one was not sent, never what the report held."/>
                        <label type="p" style="m-muted" text="Nobody was a recipient of this run." condition="!deliveries.length"/>
                    </box-body>
                    <box-body-nopad>
                        <form-list name="RecipientOutcomes" list="deliveries" paginate="false" condition="deliveries.length">
                            <row-selection id-field="deliveryId" parameter="deliveryIds" list-mode="true" condition="canRetry &amp;&amp; failedCount &gt; 0">
                                <action>
                                    <dialog button-text="Retry" title="Retry the selected failed deliveries"/>
                                    <form-single name="RetryRecipients" transition="retryRecipients">
                                        <field name="occurrenceId"><default-field><hidden default-value="${occurrenceId}"/></default-field></field>
                                        <field name="expectedRevision"><default-field><hidden default-value="${occurrence.revision}"/></default-field></field>
                                        <field name="note"><default-field title=""><label text="Only failed deliveries are sent again, each after its recipient is checked again. A delivery already sent is never repeated."/></default-field></field>
                                        <field name="reason"><default-field title="Reason"><text-line size="50"/></default-field></field>
                                        <field name="submitButton"><default-field title="Retry"><submit/></default-field></field>
                                    </form-single>
                                </action>
                            </row-selection>
                            <field name="recipientName"><default-field title="Recipient"><display/></default-field></field>
                            <field name="stateText"><default-field title="Result">
                                <render-mode>
                                    <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${
                                        WebUtilities.encodeHtml(stateText)}</q-chip>]]></text>
                                    <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateText})}]]></text>
                                    <text type="html">${stateText}</text>
                                </render-mode>
                            </default-field></field>
                            <field name="reasonText"><default-field title="Why"><display/></default-field></field>
                            <field name="attemptText"><default-field title="Attempted"><display text="${attemptText}${attemptCount &gt; 1 ? ' (' + attemptCount + ' attempts)' : ''}"/></default-field></field>
                            <field name="actions"><default-field title="">
                                <container-dialog id="Reconcile_${deliveryId}" button-text="Reconcile" condition="canRetry &amp;&amp; uncertain">
                                    <label type="p" text="Whether ${recipientName} received this message is not known. Check with them or the mail system, then record what happened; only then can it be sent again."/>
                                    <form-single name="ReconcileRecipient_${deliveryId}" transition="reconcileRecipient">
                                        <field name="occurrenceId"><default-field><hidden default-value="${occurrenceId}"/></default-field></field>
                                        <field name="deliveryId"><default-field><hidden default-value="${deliveryId}"/></default-field></field>
                                        <field name="outcome"><default-field title="Outcome">
                                            <radio><list-options list="outcomeOptions" key="${value}" text="${label}"/></radio>
                                        </default-field></field>
                                        <field name="reason"><default-field title="How you know"><text-line size="50"/></default-field></field>
                                        <field name="save"><default-field><submit text="Record outcome"/></default-field></field>
                                    </form-single>
                                </container-dialog>
                            </default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="recipientName"/><field-ref name="reasonText"/></column>
                                <column><field-ref name="stateText"/><field-ref name="actions"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets></section>
        </widgets></section>
    </widgets>
</screen>
