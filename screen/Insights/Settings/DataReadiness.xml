<!-- Insights › Settings › Data readiness (design-insights §11 DataReadiness; impl-insights P10, INS-09; style-guide §3.2 List):
    ReadinessFind (the organization whose freshness policy applies, the domain owner, the source and the state) over
    SourceReadiness, the sources of Insights the viewer may read: each business dataset's index with its last rebuild, the
    lag since, how often it is expected, its coverage and its owner (ironstone.insights.RegistryServices.find#SourceReadiness,
    which reads Admin's readiness registry as the viewer; there is no second registry). Ready, stale (older than the
    organization's freshness policy allows, with its lag), needs review, failed and unavailable are told apart, and a provider
    that could not be checked is named while the others answer. RefreshRequest asks the owner's registered refresh
    (org.moqui.admin.ReadinessServices.request#Refresh: the registration's own permission and the source's own grant decide; the
    request names one of Insights' registrations, never a service or an index, and gives its reason) and is offered only where
    the viewer may run it. It is not
    a replacement for Monitor. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Data readiness" default-menu-index="2">

    <parameter name="organizationPartyId"/>
    <parameter name="domainOwner"/>
    <parameter name="source"/>
    <parameter name="state"/>

    <transition name="requestRefresh" method="post">
        <actions>
            <!-- Insights' own registered refreshes only: another owner's is requested from its owner's screen or Admin's Health -->
            <if condition="!String(refreshKey || '').startsWith('insights.')"><return error="true" message="That refresh is not one of Insights' sources"/></if>
            <if condition="!String(reason || '').trim()"><return error="true" message="Say why the refresh is needed"/></if>
            <service-call name="org.moqui.admin.ReadinessServices.request#Refresh" out-map="refreshed"
                    in-map="{refreshKey:refreshKey, reason:reason, operationKey:(operationKey || null)}"/>
            <if condition="!ec.message.hasError()">
                <script>ec.message.addMessage(refreshed.message, refreshed.state === 'failed' ? 'warning' : 'success')</script>
            </if>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <!-- a member of the root group alone reads nothing in Insights: told so, as on Home -->
        <if condition="insights.capabilities.view">
            <service-call name="ironstone.insights.RegistryServices.find#SourceReadiness" out-map="found" transaction="force-new" ignore-error="true"
                    in-map="{organizationPartyId:(organizationPartyId || null), domainOwner:(domainOwner || null), source:(source || null),
                        state:(state || null)}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="sourceRows" from="found?.sources || []"/>
        <set field="failedText" from="(found?.failedProviders || []).join(', ')"/>
        <set field="scopeOptions" from="found?.organizations || insights.organizations || []"/>
        <set field="ownerOptions" from="found?.ownerOptions || []"/>
        <set field="stateOptions" from="found?.stateOptions || []"/>
        <set field="filtered" from="!!(domainOwner || source || state)"/>
        <set field="findValues" from="{organizationPartyId:organizationPartyId, domainOwner:domainOwner, source:source, state:state}"/>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Data readiness" type="h5"/>
                <label text="${found?.freshnessText}. Checked ${found?.checkedText}" type="p" style="text-caption m-muted q-mb-none" condition="found"/>
            </container>
        </container>
        <label text="Data readiness is shown to Insights readers." type="p" style="m-muted" condition="!insights.capabilities.view"/>
        <label text="Data readiness is not available just now." type="p" style="m-muted" condition="insights.capabilities.view &amp;&amp; !found"/>

        <form-single name="ReadinessFind" transition="." map="findValues">
            <field name="organizationPartyId"><default-field title="Organization" tooltip="Whose freshness policy decides what is stale">
                <drop-down allow-empty="true"><list-options list="scopeOptions" key="${value}" text="${label}"/></drop-down>
            </default-field></field>
            <field name="domainOwner"><default-field title="Owner">
                <drop-down allow-empty="true"><list-options list="ownerOptions" key="${it}" text="${it}"/></drop-down>
            </default-field></field>
            <field name="source"><default-field title="Source"><text-line size="25"/></default-field></field>
            <field name="state"><default-field title="State">
                <drop-down allow-empty="true"><list-options list="stateOptions" key="${value}" text="${label}"/></drop-down>
            </default-field></field>
            <field name="apply"><default-field><submit text="Find"/></default-field></field>
            <field-layout><field-row-big><field-ref name="organizationPartyId"/><field-ref name="domainOwner"/><field-ref name="source"/>
                <field-ref name="state"/><field-ref name="apply"/></field-row-big></field-layout>
        </form-single>

        <label type="p" style="text-warning" condition="failedText" text="Could not be checked: ${failedText}"/>
        <label text="No source matches." type="p" style="m-muted" condition="found &amp;&amp; !sourceRows.length &amp;&amp; filtered"/>
        <label text="No source is open to you yet. A source shows here once its dataset is admitted for you to read."
                type="p" style="m-muted" condition="found &amp;&amp; !sourceRows.length &amp;&amp; !filtered"/>
        <form-list name="SourceReadiness" list="sourceRows" skip-form="true" paginate="false" condition="sourceRows.length">
            <field name="source"><default-field title="Source">
                <link url="${detailUrl}" url-type="plain" text="${source}" link-type="anchor" condition="detailUrl"/>
                <label text="${source}" condition="!detailUrl"/>
            </default-field></field>
            <field name="domainOwner"><default-field title="Owner"><display/></default-field></field>
            <field name="stateName"><default-field title="State">
                <render-mode>
                    <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${
                        WebUtilities.encodeHtml(stateName)}</q-chip>]]></text>
                    <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateName})}]]></text>
                    <text type="html">${stateName}</text>
                </render-mode>
            </default-field></field>
            <field name="message"><default-field title="Explanation"><display/></default-field></field>
            <field name="watermarkText"><default-field title="Last rebuilt"><display/></default-field></field>
            <field name="lagText"><default-field title="Lag"><display text="${lagText ? lagText : ''}"/></default-field></field>
            <field name="expectedFrequencyText"><default-field title="Expected"><display text="${expectedFrequencyText ? 'every ' + expectedFrequencyText : ''}"/></default-field></field>
            <field name="coverage"><default-field title="Completeness"><display/></default-field></field>
            <field name="actions"><default-field title="">
                <container-dialog id="RefreshRequest_${datasetId || providerKey}" button-text="Request refresh" icon="sym_o_sync" width="520"
                        title="Request ${refreshTitle}" condition="refreshKey">
                    <label type="p" text="Asks the owner's refresh for ${source}: ${refreshTitle}. The source shows its new state once it is done."/>
                    <form-single name="RefreshRequestForm" transition="requestRefresh"
                            map="{refreshKey:refreshKey, operationKey:'refresh-' + ec.user.randomString(24)}">
                        <field name="refreshKey"><default-field><hidden/></default-field></field>
                        <field name="operationKey"><default-field><hidden/></default-field></field>
                        <field name="reason"><default-field title="Reason"><text-line size="40"/></default-field></field>
                        <field name="submitButton"><default-field title="Request refresh"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </default-field></field>
            <columns type="mobile">
                <column><field-ref name="source"/><field-ref name="domainOwner"/><field-ref name="message"/></column>
                <column><field-ref name="stateName"/><field-ref name="lagText"/><field-ref name="actions"/></column>
            </columns>
        </form-list>
    </widgets>
</screen>
