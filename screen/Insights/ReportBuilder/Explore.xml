<!-- Insights › Report builder › Explore (design-insights §5 Explore; impl-insights P2, INS-04): the framework Explore screen (Tools
    Dashboards/Explore.xml) with its transitions here. Its dataset choices are the datasets the viewer may read (each dataset's own
    artifact; P3 admits the business datasets), field suggestions and value counts are scoped by the same query path, and adding a
    panel opens Insights › Dashboard and Compare opens Split (the root's reportLinks). Saving a search or adding a panel is
    offered to authors only (the engine refuses the others); readers open saved searches. Trace, user, visit and log context
    links are Tools' and Monitor's telemetry fields, which no Insights group reads. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Explore" default-menu-index="1">

    <transition-include name="remember" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="trace" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="user" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="context" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="visit" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="tail" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="saveSearch" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="addPanel" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="split" location="component://tools/screen/Dashboards/Explore.xml"/>

    <actions><set field="from" from="from || insights.defaults.from"/></actions>
    <widgets><include-screen location="component://tools/screen/Dashboards/Explore.xml" share-scope="true"/></widgets>
</screen>
