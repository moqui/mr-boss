<!-- Insights › Report builder › Datasets (design-insights §5 Datasets; impl-insights P3, INS-03; mr-moqui
    plans/archive/Admin-Screens-Down.md, Track I): the framework's Dashboards › Datasets at this location, which
    BOSS_INS_DATASET_SCREENS opens to the author and the steward, with the one transition Insights offers: createDataset,
    through the engine's create#BusinessDataset, which asks the dataset-save artifact and the update artifact of the
    dataset named (the steward's insights-* grant). The list is the business datasets the viewer reads, and the steward's
    waiting for review (find#BusinessDatasets); a dataset created here is named insights- and its short name, and the
    scope field is the organization field (reportPolicy, set by the root: Insights.js). Tools' other datasets (the
    telemetry and document indexes) are not shown under a mount and their transitions (explore, definition) are not taken
    in, so they do not exist on this route. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Datasets" default-menu-index="3">
    <parameter name="status"/>
    <parameter name="text"/>

    <transition-include name="createDataset" location="component://tools/screen/Dashboards/Datasets.xml"/>

    <widgets>
        <include-screen location="component://tools/screen/Dashboards/Datasets.xml" share-scope="true"/>
    </widgets>
</screen>
