<!-- Insights › Report builder › Analysis (design-insights §5 Analysis; impl-insights P6, INS-03, INS-04): an author builds an
    aggregate over an admitted dataset and saves it as a library panel. It is Insights' own screen around the framework's
    Analysis (Tools Dashboards/Analysis.xml, mr-moqui docs/tools/Monitoring.md "Analysis"), whose sections show the page:
    AnalysisSource, the dataset, the measure and how it is aggregated, up to two groups, a time grain, one filter and the
    range; AnalysisResult, the choices run through the report engine as the author, with the engine's count of the records
    behind them and its notices; AnalysisRefused, what the engine's semantic guards refuse (an amount across currencies
    until it is grouped by its currency or filtered to one, a ratio averaged, a balance summed across its dates), shown as
    its reason, never as a number without a unit; SaveAnalysis, a library panel the author owns, private or shared with
    one of their groups, optionally placed on a dashboard of their own. What Insights keeps is the page and the save, from
    its own services (ironstone.insights.AnalysisServices get#AnalysisOptions, get#AnalysisResult and store#Analysis: only
    the author's admitted datasets and their own fields, the calendar of the organization in scope for a time grain, the
    author check, Insights' reason codes) and its own saveAnalysis, which the grant below names; the framework's
    saveAnalysis is not taken in. AnalysisSteps is then the framework definition editor (Insights › PanelDetail), where
    transformations, pivot, totals and the time comparison are the engine's own. The author's and the dataset steward's
    (BOSS_INS_ANALYSIS); a reader opens a saved analysis as the panel it is. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Analysis" default-menu-index="2">

    <parameter name="datasetId"/>
    <parameter name="aggregate"/>
    <parameter name="measureField"/>
    <parameter name="groupBy"/>
    <parameter name="groupBy2"/>
    <parameter name="timeGrain"/>
    <parameter name="filterField"/>
    <parameter name="filterValue"/>
    <parameter name="from"/>
    <parameter name="thru"/>
    <parameter name="organizationPartyId"/>
    <parameter name="run"/>

    <transition name="saveAnalysis" method="post">
        <actions>
            <service-call name="ironstone.insights.AnalysisServices.store#Analysis" in-map="context" out-map="saved"/>
            <set field="definitionId" from="saved?.definitionId"/>
        </actions>
        <default-response url="${sharedLinks['PanelDetail']}"><parameter name="definitionId"/></default-response>
        <error-response url="."/>
    </transition>

    <actions>
        <set field="from" from="from || insights.defaults.from"/>
        <set field="thru" from="thru || insights.defaults.thru"/>
        <service-call name="ironstone.insights.AnalysisServices.get#AnalysisOptions" out-map="analysisOptions"
                in-map="{datasetId:datasetId, ownDashboards:true, answerRefusal:true}" transaction="force-new" ignore-error="true"/>
        <!-- a refusal is the service's answer (impl-admin F129: ignore-error clears the message) -->
        <set field="optionsError" from="analysisOptions?.refusal || (analysisOptions?.datasets ? null : 'The analysis choices could not be read now')"/>
        <script>ec.message.clearErrors()</script>
        <set field="analysisOptions" from="analysisOptions?.datasets ? analysisOptions : {datasets:[], measureFields:[], groupFields:[],
                filterFields:[], aggregates:[], grains:[], visualizations:[], dashboards:[]}"/>
        <set field="choices" from="{datasetId:datasetId, aggregate:(aggregate || 'count'), measureField:measureField, groupBy:groupBy,
                groupBy2:groupBy2, timeGrain:timeGrain, filterField:filterField, filterValue:filterValue, from:from, thru:thru,
                organizationPartyId:organizationPartyId}"/>
        <if condition="datasetId &amp;&amp; run &amp;&amp; !optionsError">
            <service-call name="ironstone.insights.AnalysisServices.get#AnalysisResult" in-map="Object.assign({answerRefusal:true}, choices)"
                    out-map="analysisOut" transaction="force-new" ignore-error="true"/>
            <set field="resultError" from="analysisOut?.refusal || null"/>
            <script>ec.message.clearErrors()</script>
            <set field="analysis" from="(analysisOut?.result &amp;&amp; !analysisOut.refusalCode ? analysisOut.result : null) || {available:false, reason:(resultError || 'The analysis could not run'), rows:[], notices:[]}"/>
        </if>
        <service-call name="ironstone.insights.ContextServices.get#ShareGroups" out-map="share"/>
        <!-- the page as the framework's sections read it: the choices and the result are Insights' own services' -->
        <set field="analysisView" from="{options:analysisOptions, optionsError:optionsError,
                noDataset:(!analysisOptions.datasets.length &amp;&amp; !optionsError),
                noDatasetText:'No dataset is admitted for you to read. A dataset steward admits them under Datasets.',
                choices:choices, analysis:(analysis || null), canSave:true, shareGroups:share.groups,
                dashboards:(analysisOptions.dashboards || []), saveValues:Object.assign({}, choices, {visualization:'table'})}"/>
    </actions>
    <widgets>
        <section-include name="AnalysisSource" location="component://tools/screen/Dashboards/Analysis.xml"/>
        <section-include name="AnalysisRefused" location="component://tools/screen/Dashboards/Analysis.xml"/>
        <section-include name="AnalysisResult" location="component://tools/screen/Dashboards/Analysis.xml"/>
    </widgets>
</screen>
