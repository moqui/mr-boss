<!-- Insights › Report builder › DatasetDetail (design-insights §5 DatasetDetail; impl-insights P3, INS-03, INS-09; mr-moqui
    plans/archive/Admin-Screens-Down.md, Track I): the framework's Dashboards › DatasetDetail at this location, which
    BOSS_INS_DATASET_STEWARDSHIP opens to the dataset steward, with the four transitions Insights offers: storeDataset,
    admitDataset, retireDataset and rebuildIndex, each through the engine's guarded operations (store#BusinessDataset,
    index#BusinessDataset), which check the dataset's own update artifact. The dataset is read by get#BusinessDataset; the
    scope field is the organization field (reportPolicy). The screen's link to the definition editor is Tools' own, not
    shown under a mount, and its transition (definition) is not taken in, so it does not exist on this route. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dataset" default-menu-include="false">
    <parameter name="datasetId" required="true"/>

    <transition-include name="storeDataset" location="component://tools/screen/Dashboards/DatasetDetail.xml"/>
    <transition-include name="admitDataset" location="component://tools/screen/Dashboards/DatasetDetail.xml"/>
    <transition-include name="retireDataset" location="component://tools/screen/Dashboards/DatasetDetail.xml"/>
    <transition-include name="rebuildIndex" location="component://tools/screen/Dashboards/DatasetDetail.xml"/>

    <widgets>
        <include-screen location="component://tools/screen/Dashboards/DatasetDetail.xml" share-scope="true"/>
    </widgets>
</screen>
