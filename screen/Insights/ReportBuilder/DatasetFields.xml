<!-- Insights › Report builder › DatasetFields (design-insights §5 DatasetFields; impl-insights P3, INS-03; mr-moqui
    plans/Admin-Screens-Down.md, Track I): the framework's Dashboards › DatasetFields at this location, which
    BOSS_INS_DATASET_STEWARDSHIP opens to the dataset steward, with its two transitions: storeFields and storeConditions,
    through the engine's store#BusinessDatasetFields and store#BusinessDatasetConditions, which check the dataset's update
    artifact, refuse removing or renaming a field a definition over the dataset uses and a stale version, and leave the
    index to be rebuilt. The screen has no other transition. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Fields" default-menu-include="false">
    <parameter name="datasetId" required="true"/>

    <transition-include name="storeFields" location="component://tools/screen/Dashboards/DatasetFields.xml"/>
    <transition-include name="storeConditions" location="component://tools/screen/Dashboards/DatasetFields.xml"/>

    <widgets>
        <include-screen location="component://tools/screen/Dashboards/DatasetFields.xml" share-scope="true"/>
    </widgets>
</screen>
