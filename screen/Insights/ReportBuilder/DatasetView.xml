<!-- Insights › Report builder › DatasetView (design-insights §5 DatasetView; impl-insights P3, INS-03, INS-11; mr-moqui
    plans/archive/Admin-Screens-Down.md, Track I): the framework's Dashboards › DatasetView at this location, which
    BOSS_INS_DATASET_SCREENS opens to the author and the steward, with its one transition: exportDocuments, the rows the
    viewer reads through the engine's query with the dataset's row filter, to the cap, recorded through audit#Export. Every
    row passes the dataset's row filter in the engine, so a reader of one organization sees and exports only its rows. The
    range, when the request names none, is Insights' (reportPolicy.range). The screen has no other transition. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Preview" default-menu-include="false">
    <parameter name="datasetId"/>
    <parameter name="from"/>
    <parameter name="thru"/>
    <parameter name="queryString"/>
    <parameter name="pageIndex"/>

    <transition-include name="exportDocuments" location="component://tools/screen/Dashboards/DatasetView.xml"/>

    <widgets>
        <include-screen location="component://tools/screen/Dashboards/DatasetView.xml" share-scope="true"/>
    </widgets>
</screen>
