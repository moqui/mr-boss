<!-- Insights › Dashboards (design-insights §4 Dashboards; impl-insights P2, INS-04): the framework's dashboard list (Tools
    Dashboards/Home.xml) with the definition type fixed to dashboard. Its transitions are taken in here, and they go to Insights'
    own report screens by the root's reportLinks: a dashboard opens in Insights › Dashboard, New and edit in DashboardEditor
    (offered to authors only), Explore data in Report builder › Explore. REPORT_RECENT and REPORT_STARRED are the framework's
    preferences. ReportServices lists only the definitions the viewer may read: their own, their groups' and the shipped ones. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dashboards" default-menu-index="2" menu-image="sym_o_widgets" menu-image-type="icon">

    <transition-include name="dashboard" location="component://tools/screen/Dashboards/Home.xml"/>
    <transition-include name="star" location="component://tools/screen/Dashboards/Home.xml"/>
    <transition-include name="edit" location="component://tools/screen/Dashboards/Home.xml"/>
    <transition-include name="new" location="component://tools/screen/Dashboards/Home.xml"/>
    <transition-include name="explore" location="component://tools/screen/Dashboards/Home.xml"/>

    <actions><set field="definitionType" value="dashboard"/></actions>
    <widgets><include-screen location="component://tools/screen/Dashboards/Home.xml" share-scope="true"/></widgets>
</screen>
