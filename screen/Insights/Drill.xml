<!-- Insights › Drill (design-insights §4 Drill; impl-insights P6, INS-04): from a value of a saved panel to its meaning, a
    breakdown and the records behind it, opened from a panel's menu (Drill, the root's reportLinks) and hidden from the menu. The
    request names the dashboard or library panel, the panel, the range and the buckets chosen; ironstone.insights.DrillServices
    get#Drill asks the report engine, which reads the saved panel again as the viewer and computes every predicate, so the page
    carries no query, and the organization in scope is fixed as on Insights › Dashboard. DrillMeaning: the measure's registered
    meaning (the owner's). Breakdown: the panel's buckets to choose from, and one more of the dataset's dimensions; a breakdown
    the engine's guards refuse says why. SourceRows: a page of the records with the query's own columns, each opening its
    Insights record screen (read only, design §10), labelled as a sample when more match. A viewer who reads the total and not
    the records is told so; a value the viewer may not read is "not available". The same page is a linear task in the terminal
    and full width on a phone. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Drill" default-menu-include="false">

    <parameter name="definitionId" required="true"/>
    <parameter name="panelId"/>
    <parameter name="queryReference"/>
    <parameter name="organizationPartyId"/>
    <parameter name="from"/>
    <parameter name="thru"/>
    <parameter name="variablesJson"/>
    <parameter name="bucketsJson"/>
    <parameter name="breakdownDimension"/>
    <parameter name="pageIndex"/>

    <actions>
        <service-call name="ironstone.insights.DrillServices.get#Drill" out-map="drillOut" transaction="force-new" ignore-error="true"
                in-map="{definitionId:definitionId, panelId:panelId, queryReference:queryReference,
                    organizationPartyId:organizationPartyId, from:from, thru:thru, variablesJson:variablesJson,
                    bucketsJson:bucketsJson, breakdownDimension:breakdownDimension, pageIndex:(pageIndex ? Number(pageIndex) : 0)}"/>
        <set field="drillError" from="ec.message.hasError() ? ec.message.getErrorsString() : null"/>
        <script>ec.message.clearErrors()</script>
        <set field="drill" from="drillOut?.drill || {available:false, reason:(drillError || 'This value is not available'),
                selected:[], dimensions:[], breakdown:[], panelBuckets:[], rows:[], columns:[], carry:{definitionId:definitionId}}"/>
        <set field="meaning" from="drill.meaning"/>
        <set field="selectedText" from="Array.from(drill.selected || []).map(item =&gt; (item.sourceField || item.field) + ': ' + item.label).join(' › ')"/>
        <set field="breakdownValues" from="Object.assign({}, drill.carry, {breakdownDimension:(drill.breakdownDimension || '')})"/>
        <set field="dashboardParameters" from="{definitionId:definitionId, organizationPartyId:(organizationPartyId || ''), from:(from || ''), thru:(thru || '')}"/>
    </actions>
    <widgets>
        <container style="m-record-header">
            <container style="m-record-title">
                <label text="${drill.title || 'Drill'}" type="h5" style="q-my-none"/>
                <label text="${selectedText || 'The whole panel'}" type="p" style="text-caption m-muted q-mb-none"/>
            </container>
            <container style="m-record-actions">
                <link url="${sharedLinks['Dashboard']}" text="Back to the dashboard" link-type="anchor-button" btn-type="primary"
                        icon="sym_o_arrow_back" parameter-map="dashboardParameters" condition="drill.definitionType != 'panel'"/>
                <link url="${sharedLinks['Panels']}" text="Library panels" link-type="anchor-button" condition="drill.definitionType == 'panel'"/>
                <link url="." text="Clear the selection" link-type="anchor-button" parameter-map="drill.clearParameters"
                        condition="drill.available &amp;&amp; drill.selected.length"/>
                <link url="${sharedLinks['ReportBuilder/Analysis']}" text="Open as analysis" link-type="anchor-button"
                        parameter-map="{datasetId:drill.datasetId}"
                        condition="drill.available &amp;&amp; (insights.capabilities.author || insights.capabilities.datasetEdit)"/>
            </container>
        </container>
        <section name="DrillUnavailable" condition="!drill.available">
            <widgets>
                <container-box type="warning">
                    <box-header title="Not available"/>
                    <box-body><label type="p" text="${drill.reason}"/></box-body>
                </container-box>
            </widgets>
        </section>
        <section name="DrillAvailable" condition="drill.available">
            <widgets>
                <section name="DrillMeaning" condition="meaning">
                    <widgets>
                        <container-box>
                            <box-header title="Meaning"/>
                            <box-body>
                                <label text="${meaning.title} (${meaning.ownerName || meaning.ownerApp}, version ${meaning.version})" type="p"/>
                                <label text="Counts ${meaning.grain}. Basis: ${meaning.basis}." type="p" style="m-muted"/>
                                <label text="Rate: ${meaning.numerator} over ${meaning.denominator}." type="p" style="m-muted"
                                        condition="meaning.aggregation === 'ratio'"/>
                                <label text="Excludes: ${meaning.exclusions}" type="p" style="m-muted" condition="meaning.exclusions"/>
                                <label text="${(meaning.rules || []).join(' ')}" type="p" style="m-muted" condition="meaning.rules?.length"/>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
                <container-box>
                    <box-header title="Breakdown"/>
                    <box-body>
                        <form-single name="Breakdown" transition="." map="breakdownValues">
                            <field name="definitionId"><default-field><hidden/></default-field></field>
                            <field name="panelId"><default-field><hidden/></default-field></field>
                            <field name="queryReference"><default-field><hidden/></default-field></field>
                            <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                            <field name="from"><default-field><hidden/></default-field></field>
                            <field name="thru"><default-field><hidden/></default-field></field>
                            <field name="variablesJson"><default-field><hidden/></default-field></field>
                            <field name="bucketsJson"><default-field><hidden/></default-field></field>
                            <field name="breakdownDimension">
                                <default-field title="Break down by" tooltip="One more dimension of the same records, in the same scope">
                                    <drop-down allow-empty="true"><list-options list="drill.dimensions" key="${value}" text="${label}"/></drop-down>
                                </default-field>
                            </field>
                            <field name="apply"><default-field><submit text="Break down"/></default-field></field>
                            <field-layout><field-row><field-ref name="breakdownDimension"/><field-ref name="apply"/></field-row></field-layout>
                        </form-single>
                        <label type="p" style="text-warning" text="${drill.breakdownRefused}" condition="drill.breakdownRefused"/>
                    </box-body>
                    <box-body-nopad>
                        <section name="PanelBuckets" condition="drill.panelBuckets.length">
                            <widgets>
                                <form-list name="PanelBucketList" list="drill.panelBuckets" skip-form="true" paginate="false">
                                    <field name="label"><default-field title="Choose a value">
                                        <link url="." text="${label}" link-type="anchor" parameter-map="chooseParameters"/>
                                    </default-field></field>
                                    <field name="valuesText"><default-field title="Value"><display/></default-field></field>
                                </form-list>
                            </widgets>
                        </section>
                        <section name="BreakdownRows" condition="drill.breakdown.length">
                            <widgets>
                                <form-list name="BreakdownList" list="drill.breakdown" skip-form="true" paginate="false">
                                    <field name="label"><default-field title="${drill.breakdownDimension}"><display/></default-field></field>
                                    <field name="valuesText"><default-field title="Value"><display/></default-field></field>
                                </form-list>
                            </widgets>
                        </section>
                    </box-body-nopad>
                </container-box>
                <container-box>
                    <box-header title="Source records"/>
                    <box-toolbar>
                        <link url="." text="Previous" link-type="anchor" parameter-map="drill.previousParameters"
                                condition="drill.rowsAvailable &amp;&amp; drill.pageIndex &gt; 0"/>
                        <link url="." text="Next" link-type="anchor" parameter-map="drill.nextParameters"
                                condition="drill.rowsAvailable &amp;&amp; drill.pageIndex &lt; drill.pageMaxIndex"/>
                    </box-toolbar>
                    <box-body-nopad>
                        <label type="p" style="q-pa-md m-muted" text="${drill.rowsReason}" condition="!drill.rowsAvailable"/>
                        <section name="SourceRowsShown" condition="drill.rowsAvailable">
                            <widgets>
                                <form-list name="SourceRows" list="drill.rows" skip-form="true" paginate="false">
                                    <field name="title">
                                        <conditional-field condition="recordScreen" title="Record">
                                            <link url="${sharedLinks['Records/' + recordScreen]}" text="${title}" link-type="anchor"
                                                    parameter-map="recordParameters"/>
                                        </conditional-field>
                                        <default-field title="Record"><display/></default-field>
                                    </field>
                                    <field name="valuesText"><default-field title="In this value"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="title"/></column>
                                        <column><field-ref name="valuesText"/></column>
                                    </columns>
                                </form-list>
                                <label type="p" style="q-pa-md m-muted" condition="drill.bounded"
                                        text="Showing ${drill.rows.length} of ${drill.total} records: a page, not all of them."/>
                                <label type="p" style="q-pa-md m-muted" condition="!drill.rows.length" text="No record matches."/>
                            </widgets>
                        </section>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
