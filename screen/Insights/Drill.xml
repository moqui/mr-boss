<!-- Insights › Drill (design-insights §4 Drill; impl-insights P6, INS-04): from a value of a saved panel to its meaning, a
    breakdown and the records behind it, opened from a panel's menu (Drill, the root's reportLinks) and hidden from the menu. The
    request names the dashboard or library panel, the panel, the range and the buckets chosen; ironstone.insights.DrillServices
    get#Drill asks the report engine, which reads the saved panel again as the viewer and computes every predicate, so the page
    carries no query, and the organization in scope is fixed as on Insights › Dashboard. It is Insights' own screen around
    the framework's Drill (Tools Dashboards/Drill.xml, mr-moqui docs/tools/Monitoring.md "Drill"): the page is its
    (template/ReportDrill.js, through Insights' service with Insights' scope, range and cost filter) and so are the
    sections that show it (not available, the panel's buckets, the breakdown's rows, the source records), which have no
    transition. What Insights adds: its header (the organization kept in the links back; Analysis for an author),
    DrillMeaning, the measure's registered meaning (the owner's), the organization carried by the Breakdown form, and each
    record's Insights record screen (read only, design §10; the row's recordUrl, which the service sets). A breakdown the
    engine's guards refuse says why; the records are labelled as a sample when more match. A viewer who reads the total and not
    the records is told so; a value the viewer may not read is "not available". The same page is a linear task in the terminal
    and full width on a phone. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Drill" default-menu-include="false">

    <parameter name="definitionId" required="true"/>
    <parameter name="panelId"/>
    <parameter name="queryReference"/>
    <parameter name="organizationPartyId"/>
    <parameter name="from"/>
    <parameter name="thru"/>
    <parameter name="variablesJson"/>
    <parameter name="bucketsJson"/>
    <parameter name="breakdownDimension"/>
    <parameter name="pageIndex"/>

    <actions>
        <service-call name="ironstone.insights.DrillServices.get#Drill" out-map="drillOut" transaction="force-new" ignore-error="true"
                in-map="{definitionId:definitionId, panelId:panelId, queryReference:queryReference,
                    organizationPartyId:organizationPartyId, from:from, thru:thru, variablesJson:variablesJson,
                    bucketsJson:bucketsJson, breakdownDimension:breakdownDimension, pageIndex:(pageIndex ? Number(pageIndex) : 0),
                    answerRefusal:true}"/>
        <!-- a refusal is the service's answer (impl-admin F129: ignore-error clears the message) -->
        <set field="drillError" from="drillOut?.refusal || null"/>
        <script>ec.message.clearErrors()</script>
        <set field="drill" from="(drillOut?.drill &amp;&amp; !drillOut.refusalCode ? drillOut.drill : null) || {available:false, reason:(drillError || 'This value is not available'),
                selected:[], selectedText:'', dimensions:[], breakdown:[], panelBuckets:[], rows:[], columns:[], carry:{definitionId:definitionId}}"/>
        <set field="meaning" from="drill.meaning"/>
        <set field="dashboardParameters" from="{definitionId:definitionId, organizationPartyId:(organizationPartyId || ''), from:(from || ''), thru:(thru || '')}"/>
    </actions>
    <widgets>
        <container style="m-record-header">
            <container style="m-record-title">
                <label text="${drill.title || 'Drill'}" type="h5" style="q-my-none"/>
                <label text="${drill.selectedText || 'The whole panel'}" type="p" style="text-caption m-muted q-mb-none"/>
            </container>
            <container style="m-record-actions">
                <link url="${sharedLinks['Dashboard']}" text="Back to the dashboard" link-type="anchor-button" btn-type="primary"
                        icon="sym_o_arrow_back" parameter-map="dashboardParameters" condition="drill.definitionType != 'panel'"/>
                <link url="${sharedLinks['Panels']}" text="Library panels" link-type="anchor-button" condition="drill.definitionType == 'panel'"/>
                <link url="." text="Clear the selection" link-type="anchor-button" parameter-map="drill.clearParameters"
                        condition="drill.available &amp;&amp; drill.selected.length"/>
                <link url="${sharedLinks['ReportBuilder/Analysis']}" text="Open as analysis" link-type="anchor-button"
                        parameter-map="{datasetId:drill.datasetId}"
                        condition="drill.available &amp;&amp; (insights.capabilities.author || insights.capabilities.datasetEdit)"/>
            </container>
        </container>
        <section-include name="DrillUnavailable" location="component://tools/screen/Dashboards/Drill.xml"/>
        <section name="DrillAvailable" condition="drill.available">
            <widgets>
                <section name="DrillMeaning" condition="meaning">
                    <widgets>
                        <container-box>
                            <box-header title="Meaning"/>
                            <box-body>
                                <label text="${meaning.title} (${meaning.ownerName || meaning.ownerApp}, version ${meaning.version})" type="p"/>
                                <label text="Counts ${meaning.grain}. Basis: ${meaning.basis}." type="p" style="m-muted"/>
                                <label text="Rate: ${meaning.numerator} over ${meaning.denominator}." type="p" style="m-muted"
                                        condition="meaning.aggregation === 'ratio'"/>
                                <label text="Excludes: ${meaning.exclusions}" type="p" style="m-muted" condition="meaning.exclusions"/>
                                <label text="${(meaning.rules || []).join(' ')}" type="p" style="m-muted" condition="meaning.rules?.length"/>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
                <container-box>
                    <box-header title="Breakdown"/>
                    <box-body>
                        <!-- the framework's Breakdown form with the organization in scope carried too -->
                        <form-single name="Breakdown" extends="component://tools/screen/Dashboards/Drill.xml#Breakdown" transition="." map="drill.breakdownValues">
                            <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                        </form-single>
                        <section-include name="DrillBreakdownRefused" location="component://tools/screen/Dashboards/Drill.xml"/>
                    </box-body>
                    <box-body-nopad>
                        <section-include name="DrillPanelBuckets" location="component://tools/screen/Dashboards/Drill.xml"/>
                        <section-include name="DrillBreakdownRows" location="component://tools/screen/Dashboards/Drill.xml"/>
                    </box-body-nopad>
                </container-box>
                <section-include name="DrillSourceRows" location="component://tools/screen/Dashboards/Drill.xml"/>
            </widgets>
        </section>
    </widgets>
</screen>
