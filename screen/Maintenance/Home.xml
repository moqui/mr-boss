<!-- Maintenance Home (design-maintenance §3 Home, §1.2; style-guide §3.1 Landing; impl-maintenance P1): HomeFilters (the organization,
    from those of the user's maintenance scope, a facility of it and the as-of date, each checked by
    ironstone.maintenance.AccessServices.check#Record and shown "not available" when refused), the Counters of design §3 (open,
    unassigned, high priority, overdue PM, unknown meters, down resources) shown "Not configured" until the work orders, plans and
    downtime that answer them exist (mantle.work.MaintenanceReportServices.get#MaintenanceHome, P3, P5, P13), never zero, and the
    shortcuts to the areas built (Settings for the Maintenance administrator). A Maintenance user who reads nothing of Maintenance
    (the root group alone) is told what Home holds. P3: the work order counters (open, unassigned, high priority, overdue), each
    opening the filtered list, the others still not configured; My work, the user's open work orders; Team work, each team's open,
    active, unscheduled, blocked and overdue work, for a broad reader only (a technician sees no team totals); and New work order
    for a planner or supervisor (mantle.work.MaintenanceReportServices.get#MaintenanceHome). P5: Unavailable resources, the equipment
    and facilities out of service now (their open outages), opening Downtime. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Home" default-menu-index="1" menu-image="sym_o_dashboard" menu-image-type="icon">
    <parameter name="organizationPartyId"/>
    <parameter name="facilityId"/>
    <parameter name="asOfDate"/>
    <transition-include name="choices" location="component://mr-boss/template/MaintenanceParts.xml"/>
    <actions>
        <set field="can" from="maintenance.capabilities"/>
        <if condition="can.anyRead &amp;&amp; organizationPartyId">
            <service-call name="ironstone.maintenance.AccessServices.check#Record" out-map="organizationRecord" transaction="force-new"
                    ignore-error="true" in-map="{appRoot:appRoot, recordType:'organization', recordId:organizationPartyId}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <if condition="can.anyRead &amp;&amp; facilityId">
            <service-call name="ironstone.maintenance.AccessServices.check#Record" out-map="facilityRecord" transaction="force-new"
                    ignore-error="true" in-map="{appRoot:appRoot, recordType:'facility', recordId:facilityId}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="organizationRefused" from="!!organizationPartyId &amp;&amp; !organizationRecord?.recordId"/>
        <set field="facilityRefused" from="!!facilityId &amp;&amp; (!facilityRecord?.recordId
                || (!!organizationPartyId &amp;&amp; facilityRecord.organizationPartyId !== organizationPartyId))"/>
        <set field="scope" from="{organizationPartyId: organizationPartyId || null, facilityId: facilityId || null, asOfDate: asOfDate || null}"/>
        <set field="scopeText" from="[organizationRecord?.label || (maintenance.allOrganizations ? 'Every organization' : 'Your organizations'),
                facilityRecord?.recordId &amp;&amp; !facilityRefused ? facilityRecord.label : null,
                'as of ' + (asOfDate ? ec.l10n.format(asOfDate, 'yyyy-MM-dd') : 'today')].filter(Boolean).join(', ')"/>
        <!-- design §3's counters, none answered until its records exist: each is not configured, never zero -->
        <if condition="can.workRead &amp;&amp; !organizationRefused &amp;&amp; !facilityRefused">
            <service-call name="mantle.work.MaintenanceReportServices.get#MaintenanceHome" out-map="home" transaction="force-new"
                    ignore-error="true" in-map="{organizationPartyId:organizationPartyId, facilityId:facilityId}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="counters" from="home?.counters || {}"/>
        <set field="listLink" from="sharedLinks['WorkOrders/Find']"/>
        <set field="scopeParameters" from="{organizationPartyId: organizationPartyId || null, facilityId: facilityId || null}"/>
        <set field="counterRows" from="[
                {counter: 'Open work orders', source: 'Work orders', count: counters.openCount, saved: null},
                {counter: 'Unassigned', source: 'Work orders', count: counters.unassignedCount, saved: 'unassigned'},
                {counter: 'High priority', source: 'Work orders', count: counters.highPriorityCount, saved: null, high: true},
                {counter: 'Overdue work orders', source: 'Work orders', count: counters.overdueCount, saved: 'overdue'},
                {counter: 'Overdue preventive maintenance', source: 'Preventive plans', count: null},
                {counter: 'Unknown meter readings', source: 'Equipment meters', count: null},
                {counter: 'Unavailable resources', source: 'Downtime', count: counters.downResourceCount ?? null,
                    linkUrl: sharedLinks['Equipment/Downtime'], linkParameters: Object.assign({open: 'true'}, scopeParameters)}
            ].map(row =&gt; Object.assign(row, {state: row.count == null ? 'Not configured' : String(row.count)}))"/>
        <set field="myWorkList" from="home?.myWorkList || []"/>
        <set field="teamWorkList" from="home?.teamWorkList || []"/>
        <set field="canCreateWork" from="!!(can.plan || can.supervise)"/>
    </actions>
    <widgets>
        <label text="Maintenance" type="h5"/>
        <section name="NoRead" condition="!can.anyRead">
            <widgets>
                <label text="Home summarizes the maintenance work, equipment and facilities of your organizations. Nothing of it is open to you."
                        type="p" style="m-muted"/>
            </widgets>
        </section>
        <section name="ReaderHome" condition="can.anyRead">
            <widgets>
                <form-single name="HomeFilters" transition="." map="scope">
                    <field name="organizationPartyId">
                        <default-field title="Organization">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'organizations', selected:scope.organizationPartyId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="facilityId">
                        <default-field title="Facility">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0" depends-optional="true"
                                        parameter-map="{choice:'facilities', selected:scope.facilityId}">
                                    <depends-on field="organizationPartyId" parameter="choiceOrganizationPartyId"/>
                                </dynamic-options>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="asOfDate">
                        <default-field title="As of" tooltip="Today when empty"><date-time type="date"/></default-field>
                    </field>
                    <field name="submitButton"><default-field title="Show"><submit/></default-field></field>
                    <field-layout>
                        <field-row><field-ref name="organizationPartyId"/><field-ref name="facilityId"/></field-row>
                        <field-row><field-ref name="asOfDate"/><field-ref name="submitButton"/></field-row>
                    </field-layout>
                </form-single>
                <label text="This organization is not available to you." type="p" style="text-negative" condition="organizationRefused"/>
                <label text="This facility is not available to you." type="p" style="text-negative" condition="facilityRefused"/>
                <label text="${scopeText}" type="p" style="text-caption m-muted" condition="!organizationRefused &amp;&amp; !facilityRefused"/>
                <container-box>
                    <box-header title="Counters"/>
                    <box-body>
                        <label text="Each count opens its list. Preventive plans and meters are counted once they are set up; until then they are not configured, never zero."
                                type="p" style="text-caption m-muted"/>
                        <form-list name="CounterRows" list="counterRows" skip-form="true" paginate="false">
                            <field name="counter">
                                <default-field title="Counter">
                                    <link url="${linkUrl || listLink}" url-type="plain" text="${counter}" link-type="anchor" condition="count != null"
                                            parameter-map="linkParameters || Object.assign({savedFind: saved}, scopeParameters)"/>
                                    <label text="${counter}" type="span" condition="count == null"/>
                                </default-field>
                            </field>
                            <field name="state"><default-field title="State"><display/></default-field></field>
                            <field name="source"><default-field title="Counted from"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="counter"/><field-ref name="source"/></column>
                                <column><field-ref name="state"/></column>
                            </columns>
                        </form-list>
                    </box-body>
                </container-box>
                <container-box>
                    <box-header title="My work"/>
                    <box-toolbar>
                        <link url="${sharedLinks['WorkOrders/NewWorkOrder']}" text="New work order" link-type="anchor-button" btn-type="primary"
                                icon="sym_o_add" condition="canCreateWork"/>
                    </box-toolbar>
                    <box-body>
                        <label text="No open work order is assigned to you." type="p" style="m-muted" condition="!myWorkList.length"/>
                        <form-list name="MyWork" list="myWorkList" skip-form="true" paginate="false">
                            <field name="workEffortId">
                                <default-field title="Work order">
                                    <link url="${sharedLinks['WorkOrders/WorkOrderDetail']}" text="${workEffortId}" link-type="anchor"
                                            parameter-map="{workEffortId:workEffortId}"/>
                                </default-field>
                            </field>
                            <field name="workEffortName"><default-field title="Name"><display/></default-field></field>
                            <field name="targetName"><default-field title="Equipment or facility"><display/></default-field></field>
                            <field name="dueText"><default-field title="Due"><display style="${overdue ? 'text-negative' : ''}"/></default-field></field>
                            <field name="statusText"><default-field title="State"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="workEffortId"/><field-ref name="workEffortName"/></column>
                                <column><field-ref name="statusText"/><field-ref name="dueText"/></column>
                            </columns>
                        </form-list>
                    </box-body>
                </container-box>
                <section name="TeamWorkBox" condition="home?.teamTotals">
                    <widgets>
                        <container-box>
                            <box-header title="Team work"/>
                            <box-body>
                                <label text="No team has open work." type="p" style="m-muted" condition="!teamWorkList.length"/>
                                <form-list name="TeamWork" list="teamWorkList" skip-form="true" paginate="false">
                                    <field name="teamName">
                                        <default-field title="Team">
                                            <link url="${listLink}" url-type="plain" text="${teamName}" link-type="anchor"
                                                    parameter-map="{teamPartyId:teamPartyId}"/>
                                        </default-field>
                                    </field>
                                    <field name="openCount" align="right"><default-field title="Open"><display/></default-field></field>
                                    <field name="activeCount" align="right"><default-field title="Active"><display/></default-field></field>
                                    <field name="unscheduledCount" align="right"><default-field title="Unscheduled"><display/></default-field></field>
                                    <field name="blockedCount" align="right"><default-field title="Blocked"><display/></default-field></field>
                                    <field name="dueCount" align="right"><default-field title="Overdue"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="teamName"/></column>
                                        <column><field-ref name="openCount"/><field-ref name="dueCount"/></column>
                                    </columns>
                                </form-list>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
            </widgets>
        </section>
        <section name="Shortcuts" condition="can.settings">
            <widgets>
                <container-box>
                    <box-header title="Shortcuts"/>
                    <box-body>
                        <label text="Set up Maintenance for your organizations: the work policy, teams and lookups." type="p"/>
                        <link url="${sharedLinks['Settings']}" text="Settings" link-type="anchor-button" btn-type="primary" icon="sym_o_settings"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
