<!-- WorkOrderDetail's Conversation tab (design-maintenance §3 WorkConversationFiles; impl-maintenance P3, F69, F82): the work order's
    messages and activity log (chatter on its root WorkEffort, served under Maintenance for a work order its check admits). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Conversation" default-menu-index="80">
    <parameter name="workEffortId"/>
    <widgets>
        <section name="WorkOrderConversation" condition="recordFound">
            <widgets>
                <chatter id="MaintenanceWorkOrderConversation" record-entity="mantle.work.effort.WorkEffort" record-id="${workEffortId}"
                        default-tab="log"/>
            </widgets>
        </section>
    </widgets>
</screen>
