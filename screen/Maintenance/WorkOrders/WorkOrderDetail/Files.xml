<!-- WorkOrderDetail's Files tab (design-maintenance §3 WorkConversationFiles; impl-maintenance P3, F69, F82): the work order's files
    (its root WorkEffort as the record host, which Maintenance's root serves for a work order its check admits; Mantle's record check
    admits it only as Maintenance does), kept on cancel. Accepted evidence is protected in P7. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Files" default-menu-index="3">
    <parameter name="workEffortId"/>
    <widgets>
        <section name="WorkOrderFiles" condition="recordFound">
            <widgets>
                <record-files id="MaintenanceWorkOrderFiles" record-entity="mantle.work.effort.WorkEffort" record-id="${workEffortId}"/>
            </widgets>
        </section>
    </widgets>
</screen>
