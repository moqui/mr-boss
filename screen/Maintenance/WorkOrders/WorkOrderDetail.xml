<!-- Maintenance › Work orders › WorkOrderDetail (design-maintenance §3 WorkOrderDetail; style-guide §3.3 Detail; impl-maintenance P3):
    one work order the user may read (check#Record: a broad reader of its service organization, or the technician it is assigned to;
    else "not available"). The record header: its id and name, the equipment or facility, the organization, kind, type, priority and
    team, the planned window and due, and its status; the primary action by status (Approve, Start, Resume, Complete, Close), the
    Lifecycle dialog with every action open from the status, each allowed or with why not (the user's authority, a running timer,
    the threshold), and its input (a hold or cancel reason; for Complete the outcome, the equipment's state after the work, the
    failure mode and the finish, with the completion blockers), each posting transition#MaintenanceWorkOrder at the revision read.
    The tabs, by menu index in design §3's order, spaced by ten so a later tab takes its own gap (P5 review): Overview (10:
    WorkHeader with Edit, Assignments with Assign and schedule), Procedure (20, P7: the checklist, StepResponse, the waiver and
    amendment dialogs, the printed checklist; Complete waits for its required steps), Time (30: the user's timer and own time; the team's total for a
    broad reader), Downtime (60, P5: the outages the work recorded or linked, Record outage, Restore), Files (70), Conversation (80)
    and History (90). The other tabs of design §3 join with their phases at their gaps: Parts (40, P9: built, the planned parts and the parts used),
    Purchasing (50, P10: the work's purchase requests and order lines, Request a purchase, Accept outside service, whose service line
    Complete also offers to accept) and Costs (100, P11: built, the cost reader's only, BOSS_MNT_COSTS). P5: Start asks whether the work takes its target out of service, Complete may name follow-up work,
    and the header says when the target is out of service. P19 (design §1.4 Meetings, §12): More offers Print work order (the
    Instructions print, with the QR of the work order's link), Add to calendar (.ics of its planned window) and, for a planner,
    supervisor or its assigned technician, Add video call (a Commons event with a call link, the vendor's expert and the
    technicians invited; add#MaintenanceVideoCall). No cost outside the Costs tab. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Work order" default-menu-include="false">
    <parameter name="workEffortId" required="true"/>
    <!-- the work order is the user's (Maintenance's check and Mantle's scope), for every tab and transition -->
    <always-actions>
        <service-call name="ironstone.maintenance.AccessServices.check#Record" out-map="workOrderCheck" transaction="force-new"
                ignore-error="true" in-map="{appRoot:appRoot, recordType:'workOrder', recordId:workEffortId}"/>
        <script>ec.message.clearErrors()</script>
        <set field="recordFound" from="!!workOrderCheck?.recordId"/>
    </always-actions>
    <transition-include name="choices" location="component://mr-boss/template/MaintenanceParts.xml"/>
    <transition-include name="lifecycleAction" location="component://mr-boss/template/MaintenanceWorkOrderParts.xml"/>
    <!-- P19: the planned window as a calendar file, and a video call about the work order (Mantle checks the work and the authority) -->
    <transition name="calendarFile" read-only="true">
        <actions>
            <service-call name="ironstone.maintenance.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'workOrder', recordId:workEffortId}"/>
            <service-call name="mantle.work.MaintenanceServices.get#MaintenanceCalendarFile" out-map="calendar" in-map="{workEffortId:workEffortId}"/>
            <if condition="ec.message.hasError()"><return/></if>
            <script>ec.web.sendTextResponse(calendar.text, 'text/calendar', calendar.fileName)</script>
        </actions>
        <default-response type="none"/>
        <error-response url="."><parameter name="workEffortId"/></error-response>
    </transition>
    <transition name="videoAttendees" read-only="true">
        <actions>
            <service-call name="ironstone.commons.CalendarServices.search#Attendees" in-map="{term:term}" out-map="found"/>
            <script>ec.web.sendJsonResponse(found?.optionList || [])</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition name="addVideoCall">
        <actions>
            <service-call name="ironstone.maintenance.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'workOrder', recordId:workEffortId}"/>
            <service-call name="mantle.work.MaintenanceServices.add#MaintenanceVideoCall" out-map="videoCall"
                    in-map="{workEffortId:workEffortId, attendeePartyId:attendeePartyId, startDate:startDate, durationMinutes:durationMinutes,
                        note:note, operationKey:operationKey}"/>
            <if condition="!ec.message.hasError()"><script><![CDATA[
                const eventLink = '/qapps/Commons/Calendar/EventDetail?workEffortId=' + encodeURIComponent(videoCall.eventWorkEffortId)
                ec.message.addMessage(videoCall.skippedCount ? 'Video call added; ' + videoCall.skippedCount + ' could not be invited'
                        : 'Video call added and the invitations sent', videoCall.skippedCount ? 'warning' : 'success')
                ec.message.addMessage('The call is in your calendar: ' + eventLink, 'info')
            ]]></script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."><parameter name="workEffortId"/></error-response>
    </transition>
    <subscreens default-item="Overview"/>
    <actions>
        <if condition="recordFound">
            <service-call name="mantle.work.MaintenanceServices.get#MaintenanceWorkOrder" out-map="workOrderDetail"
                    transaction="force-new" ignore-error="true" in-map="{workEffortId:workEffortId}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="recordFound" from="recordFound &amp;&amp; !!workOrderDetail?.workOrder"/>
        <set field="workOrder" from="workOrderDetail?.workOrder || {}"/>
        <set field="blockerList" from="workOrderDetail?.blockerList || []"/>
        <set field="actionRows" from="workOrderDetail?.actionList || []"/>
        <set field="primaryAction" from="['approve', 'start', 'resume', 'complete', 'close'].map(action =&gt; actionRows.find(row =&gt;
                row.action === action &amp;&amp; row.allowed)).find(row =&gt; row) || null"/>
        <set field="statusColor" from="{WeInPlanning:'grey-8', WeApproved:'primary', WeInProgress:'positive', WeOnHold:'warning',
                WeComplete:'teal', WeClosed:'grey-7', WeCancelled:'negative'}[workOrder.statusId] || 'grey-8'"/>
        <set field="captionText" from="[workOrder.targetName, workOrder.organizationName, [workOrder.kindText, workOrder.typeText].filter(Boolean).join(', '),
                workOrder.priority != null ? 'priority ' + workOrder.priority : null, workOrder.teamName].filter(Boolean).join(' · ')"/>
        <!-- P19: the print, and who may add a video call (a planner or supervisor, or the assigned technician; Mantle checks again) -->
        <set field="printParameters" from="{workEffortId:workEffortId, renderMode:'html-print', lastStandalone:'true'}"/>
        <set field="canAddCall" from="!['WeClosed', 'WeCancelled'].includes(workOrder.statusId) &amp;&amp; (ec.user.hasPermission('MAINTENANCE_PLAN')
                || ec.user.hasPermission('MAINTENANCE_SUPERVISE') || (ec.user.hasPermission('MAINTENANCE_EXECUTE') &amp;&amp; !!workOrderDetail?.assigned))"/>
        <set field="videoValues" from="{workEffortId:workEffortId, durationMinutes:'30', operationKey:'video-' + ec.user.randomString(24)}"/>
        <set field="windowText" from="[workOrder.estimatedStartText ? 'Planned from ' + workOrder.estimatedStartText : null,
                workOrder.estimatedCompletionText ? 'due ' + workOrder.estimatedCompletionText + (workOrder.overdue ? ' (overdue)' : '') : null]
                .filter(Boolean).join(', ')"/>
    </actions>
    <widgets>
        <section name="WorkOrderNotFound" condition="!recordFound">
            <widgets>
                <container-box type="warning">
                    <box-header title="Not available"/>
                    <box-body>
                        <label text="Work order ${workEffortId} is not available: it does not exist, it is not one of your organizations', or it is not assigned to you."
                                type="p"/>
                        <link url="${sharedLinks['WorkOrders/Find']}" text="Back to the work orders" link-type="anchor"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="WorkOrderFound" condition="recordFound">
            <widgets>
                <context record-entity="mantle.work.effort.WorkEffort" record-id="${workEffortId}"
                        title="Work order ${workEffortId} · ${workOrder.workEffortName || ''}"/>
                <container style="m-record-header">
                    <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                        <container style="col-12 col-md m-record-title">
                            <container style="row items-center q-gutter-x-sm">
                                <label text="${workEffortId}" type="span" style="m-key-chip text-mono"/>
                                <label text="${workOrder.workEffortName}" type="h5" style="q-my-none"/>
                            </container>
                            <label text="${captionText}" type="div" style="text-caption m-muted"/>
                            <label text="${windowText}" type="div" style="${workOrder.overdue ? 'text-caption text-negative' : 'text-caption m-muted'}"
                                    condition="windowText"/>
                            <label text="Held: ${workOrder.holdReasonText}" type="div" style="text-caption text-warning"
                                    condition="workOrder.statusId == 'WeOnHold'"/>
                            <label text="${workOrder.outage?.text}" type="div" style="text-caption text-negative"
                                    condition="workOrder.outage?.open"/>
                        </container>
                        <container style="col-12 col-md-auto m-record-status">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip square class="q-ma-none m-tonal text-${statusColor}">${
                                    WebUtilities.encodeHtml(workOrder.statusText)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong", text: workOrder.statusText})}]]></text>
                                <text type="html">${workOrder.statusText}</text>
                            </render-mode>
                        </container>
                    </container>
                    <container style="row items-center q-col-gutter-x-md q-col-gutter-y-sm m-record-foot">
                        <container style="col-12 row items-center q-gutter-x-xs q-gutter-y-xs m-record-actions">
                            <section name="PrimaryAction" condition="primaryAction">
                                <widgets>
                                    <container-dialog id="PrimaryLifecycle" button-text="${primaryAction.label}" type="primary"
                                            icon="sym_o_play_arrow" title="${primaryAction.label} work order ${workEffortId}" width="640">
                                        <section name="PrimaryActionRow">
                                            <actions>
                                                <set field="actionRow" from="primaryAction"/>
                                                <set field="formPrefix" value="Primary"/>
                                            </actions>
                                            <widgets>
                                                <section-include name="LifecycleActionRow"
                                                        location="component://mr-boss/template/MaintenanceWorkOrderParts.xml"/>
                                            </widgets>
                                        </section>
                                    </container-dialog>
                                </widgets>
                            </section>
                            <container-dialog id="LifecycleDialog" button-text="Lifecycle" icon="sym_o_conversion_path"
                                    title="Lifecycle of work order ${workEffortId}" width="720">
                                <label text="Each action shows its input, or why it cannot be done now." type="p" style="text-caption m-muted"/>
                                <section name="LifecycleList">
                                    <actions>
                                        <set field="formPrefix" value="Dialog"/>
                                    </actions>
                                    <widgets>
                                        <section-iterate name="LifecycleActions" list="actionRows" entry="actionRow">
                                            <widgets>
                                                <section-include name="LifecycleActionRow"
                                                        location="component://mr-boss/template/MaintenanceWorkOrderParts.xml"/>
                                            </widgets>
                                        </section-iterate>
                                    </widgets>
                                </section>
                                <label text="No action is open while the work order is ${workOrder.statusText}." type="p" style="m-muted"
                                        condition="!actionRows.length"/>
                            </container-dialog>
                            <container-dialog id="VideoCallDialog" button-text="Add video call" icon="sym_o_video_call"
                                    title="Video call about work order ${workEffortId}" width="560" condition="canAddCall">
                                <label text="An event in your calendar with a call link; the person you choose and the work order's technicians are invited. Someone without an account gets the invitation by email and joins from its link."
                                        type="p" style="text-caption m-muted"/>
                                <form-single name="VideoCallForm" transition="addVideoCall" map="videoValues">
                                    <field name="workEffortId"><default-field><hidden/></default-field></field>
                                    <field name="operationKey"><default-field><hidden/></default-field></field>
                                    <field name="attendeePartyId">
                                        <default-field title="Invite" tooltip="The vendor's expert or another person; someone without an account needs an email address">
                                            <drop-down allow-empty="true"><dynamic-options transition="videoAttendees" server-search="true" min-length="2"/></drop-down>
                                        </default-field>
                                    </field>
                                    <field name="startDate"><default-field title="Starts"><date-time/></default-field></field>
                                    <field name="durationMinutes">
                                        <default-field title="Minutes"><text-line size="5" input-type="number"/></default-field>
                                    </field>
                                    <field name="note"><default-field title="Note to the attendees"><text-area rows="3" cols="50"/></default-field></field>
                                    <field name="submitButton"><default-field title="Add video call"><submit/></default-field></field>
                                </form-single>
                            </container-dialog>
                            <button-menu text="More" icon="more_horiz">
                                <link url="Instructions" text="Print work order" icon="sym_o_print" target-window="_blank"
                                        parameter-map="printParameters"/>
                                <link url="calendarFile" text="Add to calendar (.ics)" icon="sym_o_event" link-type="anchor"
                                        parameter-map="{workEffortId:workEffortId}" condition="workOrder.estimatedStartText"/>
                                <link url="${sharedLinks['Equipment/EquipmentDetail']}" text="Equipment" icon="sym_o_build"
                                        parameter-map="{assetId:workOrder.assetId}" condition="workOrder.assetId"/>
                                <link url="${sharedLinks['Facilities/FacilityDetail']}" text="Facility" icon="sym_o_domain"
                                        parameter-map="{facilityId:workOrder.facilityId}" condition="workOrder.facilityId"/>
                                <link url="${sharedLinks['WorkOrders/Find']}" text="All work orders" icon="sym_o_list"/>
                            </button-menu>
                        </container>
                    </container>
                </container>
                <subscreens-panel id="WorkOrderTabs" type="tab"/>
            </widgets>
        </section>
    </widgets>
</screen>
