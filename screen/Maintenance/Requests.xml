<!-- The Requests area of IronStone Maintenance (design-maintenance §3 Requests, §1.2; impl-maintenance P4): Find, the maintenance
    requests of the planner's or supervisor's organizations with the adoption queue of Manufacturing's maintenance records; and
    RequestDetail, the shared request screen in Maintenance's context (the reported fault and its triage), hidden from the menu.
    Opened by a planner or supervisor only (MAINTENANCE_PLAN or _SUPERVISE: the root's menu condition and the always-action, F346;
    the artifact group BOSS_MNT_REQUESTS denies the root user group too); a requester reports from Commons' quick create and follows their
    reports in Commons (impl-maintenance F78). Every read and decision is Mantle's mantle.work.MaintenanceServices. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Requests" default-menu-index="3" menu-image="sym_o_report_problem" menu-image-type="icon">
    <!-- the user's call of Nov 12 on F346 (impl-maintenance P20 "Gating Nov 12"): gated by permission, as the menu is, so a
        custom group given Maintenance in Admin, which the BOSS_MAINTENANCE deny rows do not reach, opens only what its
        permissions give -->
    <always-actions>
        <script>if(!(maintenance.capabilities.plan || maintenance.capabilities.supervise))throw new Error('PERMISSION_DENIED: Maintenance requests are triaged by planners and supervisors')</script>
    </always-actions>
    <subscreens default-item="Find" always-use-full-path="true">
        <subscreens-item name="RequestDetail" location="component://mr-boss/screen/Shared/RequestDetail.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="MaintenanceRequestsPanel" type="tab"/>
    </widgets>
</screen>
