<!-- Maintenance › Preventive › Plans (design-maintenance §5 Plans: FindPlans, PlanRows, NewPlan; style-guide §3.2 List; impl-maintenance
    P13): the preventive plans of the user's scope (Mantle's find#MaintenanceSchedules: MAINTENANCE_VIEW, the organizations of the
    user's maintenance scope), by text, organization, equipment, facility (with those inside it), equipment model, trigger and state
    (open by default), each with its target, procedure, interval, next due (a date in the target's zone, or a meter threshold), the
    age of its last reading and its due state; a model default shows as the plan's source, and choosing one does not enroll every
    piece of equipment of the model. New plan for a planner or supervisor: a draft for one piece of equipment (optionally following
    a maintenance default of its model, whose values it takes where it names none) or one facility; activation is on PlanDetail,
    where a missing time zone or procedure is named. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Plans" default-menu-index="1">
    <parameter name="text"/>
    <parameter name="organizationPartyId"/>
    <parameter name="assetId"/>
    <parameter name="facilityId"/>
    <parameter name="productId"/>
    <parameter name="triggerEnumId"/>
    <parameter name="statusId"/>
    <parameter name="pageIndex"/>
    <parameter name="pageSize"/>
    <transition-include name="choices" location="component://mr-boss/template/MaintenanceParts.xml"/>
    <transition-include name="storePlan" location="component://mr-boss/template/MaintenancePlanParts.xml"/>
    <actions>
        <set field="can" from="maintenance.capabilities"/>
        <set field="canPlan" from="!!(can.plan || can.supervise)"/>
        <service-call name="mantle.work.MaintenancePlanServices.find#MaintenanceSchedules" out-map="found" transaction="force-new"
                ignore-error="true" in-map="{text:text, organizationPartyId:organizationPartyId, assetId:assetId, facilityId:facilityId,
                    productId:productId, triggerEnumId:triggerEnumId, statusId:statusId, pageIndex:pageIndex, pageSize:pageSize}"/>
        <script>ec.message.clearErrors()</script>
        <set field="scheduleList" from="found?.scheduleList || []"/>
        <set field="scheduleListCount" from="found?.scheduleListCount"/>
        <set field="scheduleListPageIndex" from="found?.scheduleListPageIndex"/>
        <set field="scheduleListPageSize" from="found?.scheduleListPageSize"/>
        <set field="scheduleListPageMaxIndex" from="found?.scheduleListPageMaxIndex"/>
        <set field="scheduleListPageRangeLow" from="found?.scheduleListPageRangeLow"/>
        <set field="scheduleListPageRangeHigh" from="found?.scheduleListPageRangeHigh"/>
        <set field="filtered" from="!!(text || organizationPartyId || assetId || facilityId || productId || triggerEnumId || statusId)"/>
        <set field="emptyText" from="filtered ? 'No plan matches these filters.'
                : (canPlan ? 'No preventive plan yet. Start one with New plan.' : 'No preventive plan is open to you.')"/>
        <set field="newPlan" from="{targetKind: facilityId &amp;&amp; !assetId ? 'facility' : 'equipment', assetId: assetId || null,
                facilityId: facilityId || null, intervalUomId: 'TF_mon', operationKey: 'new-plan-' + ec.user.randomString(20)}"/>
    </actions>
    <widgets>
        <context title="Preventive plans"/>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Preventive plans" type="h5"/>
            </container>
            <container style="col-auto row items-center q-gutter-xs">
                <container-dialog id="NewPlanDialog" button-text="New plan" type="primary" icon="sym_o_add" title="New preventive plan"
                        width="720" condition="canPlan">
                    <label text="A plan starts as a draft; activate it on the plan once its time zone and procedure are in place." type="p"
                            style="text-caption m-muted"/>
                    <form-single name="NewPlan" transition="storePlan" map="newPlan">
                        <field name="operationKey"><default-field><hidden/></default-field></field>
                        <field name="targetKind">
                            <default-field title="The plan is for">
                                <radio><option key="equipment" text="Equipment"/><option key="facility" text="A facility or room"/></radio>
                            </default-field>
                        </field>
                        <field name="assetId">
                            <default-field title="Equipment">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0"
                                            parameter-map="{choice:'equipment', selected:newPlan.assetId}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="productMaintenanceId">
                            <default-field title="Follows the model's default" tooltip="Its interval, meter and procedure apply where the plan names none">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'planDefaults'}">
                                        <depends-on field="assetId" parameter="choiceAssetId"/>
                                    </dynamic-options>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="facilityId">
                            <default-field title="Facility or room">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0"
                                            parameter-map="{choice:'workFacilities', selected:newPlan.facilityId}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="scheduleName"><default-field title="Name" tooltip="The model default's or the target's when empty"><text-line size="50"/></default-field></field>
                        <field name="templateWorkEffortId">
                            <default-field title="Procedure" tooltip="An approved procedure for the equipment or facility">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'procedures'}">
                                        <depends-on field="assetId" parameter="choiceAssetId"/>
                                        <depends-on field="facilityId" parameter="choiceFacilityId"/>
                                    </dynamic-options>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="triggerEnumId">
                            <default-field title="Due by">
                                <radio><option key="MstCalendar" text="The calendar"/><option key="MstMeter" text="A meter"/></radio>
                            </default-field>
                        </field>
                        <field name="intervalQuantity"><default-field title="Every" tooltip="A number of the unit, or of the meter's unit"><text-line size="6"/></default-field></field>
                        <field name="intervalUomId">
                            <default-field title="Unit">
                                <drop-down>
                                    <option key="TF_day" text="Days"/>
                                    <option key="TF_wk" text="Weeks"/>
                                    <option key="TF_mon" text="Months"/>
                                    <option key="TF_yr" text="Years"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="firstDueLocal">
                            <default-field title="First due" tooltip="The date and time in the facility's time zone, as yyyy-MM-dd HH:mm">
                                <text-line size="16"/>
                            </default-field>
                        </field>
                        <field name="productMeterId">
                            <default-field title="Meter">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'planMeters'}">
                                        <depends-on field="assetId" parameter="choiceAssetId"/>
                                    </dynamic-options>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="baselineValue"><default-field title="Baseline reading"><text-line size="10"/></default-field></field>
                        <field name="baselineDate"><default-field title="Read at"><date-time/></default-field></field>
                        <field name="submitButton"><default-field title="Create draft"><submit type="primary"/></default-field></field>
                        <field-layout>
                            <field-ref name="targetKind"/>
                            <field-row><field-ref name="assetId"/><field-ref name="productMaintenanceId"/></field-row>
                            <field-ref name="facilityId"/>
                            <field-row><field-ref name="scheduleName"/><field-ref name="templateWorkEffortId"/></field-row>
                            <field-ref name="triggerEnumId"/>
                            <field-row><field-ref name="intervalQuantity"/><field-ref name="intervalUomId"/><field-ref name="firstDueLocal"/></field-row>
                            <field-row><field-ref name="productMeterId"/><field-ref name="baselineValue"/><field-ref name="baselineDate"/></field-row>
                            <field-ref name="submitButton"/>
                        </field-layout>
                    </form-single>
                </container-dialog>
            </container>
        </container>
        <container-box>
            <box-body-nopad>
                <form-list name="PlanList" list="scheduleList" skip-form="true" paginate="true" header-dialog="true" select-columns="true">
                    <field name="text">
                        <header-field title="Plan"><text-line/></header-field>
                        <default-field><ignored/></default-field>
                    </field>
                    <field name="organizationPartyId">
                        <header-field title="Organization">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'organizations', selected:organizationPartyId}"/>
                            </drop-down>
                        </header-field>
                        <default-field><ignored/></default-field>
                    </field>
                    <field name="assetId">
                        <header-field title="Equipment">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'equipment', selected:assetId}"/>
                            </drop-down>
                        </header-field>
                        <default-field><ignored/></default-field>
                    </field>
                    <field name="facilityId">
                        <header-field title="Facility" tooltip="With the facilities inside it">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'workFacilities', selected:facilityId}"/>
                            </drop-down>
                        </header-field>
                        <default-field><ignored/></default-field>
                    </field>
                    <field name="productId">
                        <header-field title="Equipment model">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'equipmentModels', selected:productId}"/>
                            </drop-down>
                        </header-field>
                        <default-field><ignored/></default-field>
                    </field>
                    <field name="triggerEnumId">
                        <header-field title="Due by">
                            <drop-down allow-empty="true">
                                <option key="MstCalendar" text="Calendar"/>
                                <option key="MstMeter" text="Meter"/>
                            </drop-down>
                        </header-field>
                        <default-field><ignored/></default-field>
                    </field>
                    <field name="statusId">
                        <header-field title="State">
                            <drop-down allow-empty="true">
                                <option key="draft" text="Draft"/>
                                <option key="active" text="Active"/>
                                <option key="ended" text="Ended"/>
                                <option key="all" text="All"/>
                            </drop-down>
                        </header-field>
                        <default-field><ignored/></default-field>
                    </field>
                    <field name="maintenanceScheduleId">
                        <header-field title="Plan"/>
                        <default-field>
                            <link url="${sharedLinks['Preventive/Plans/PlanDetail']}" text="${scheduleName}" link-type="anchor"
                                    parameter-map="{maintenanceScheduleId:maintenanceScheduleId}"/>
                        </default-field>
                    </field>
                    <field name="targetName"><header-field title="For"/><default-field><display/></default-field></field>
                    <field name="procedureName"><header-field title="Procedure"/><default-field><display/></default-field></field>
                    <field name="intervalText"><header-field title="Interval"/><default-field><display/></default-field></field>
                    <field name="defaultText"><header-field title="Model default"/><default-field><display/></default-field></field>
                    <field name="nextDueText"><header-field title="Next due"/><default-field><display/></default-field></field>
                    <field name="dataAgeText"><header-field title="Last reading"/><default-field><display/></default-field></field>
                    <field name="dueStateText">
                        <header-field title="Due"/>
                        <default-field>
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                                    dueStateColor}">${WebUtilities.encodeHtml(dueStateText)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong", text: dueStateText})}]]></text>
                                <text type="html">${dueStateText}</text>
                            </render-mode>
                        </default-field>
                    </field>
                    <field name="statusText">
                        <header-field title="State"/>
                        <default-field>
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                                    statusColor}">${WebUtilities.encodeHtml(statusText)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong", text: statusText})}]]></text>
                                <text type="html">${statusText}</text>
                            </render-mode>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column><field-ref name="maintenanceScheduleId"/><field-ref name="targetName"/></column>
                        <column><field-ref name="dueStateText"/><field-ref name="nextDueText"/></column>
                    </columns>
                </form-list>
                <section name="NoPlans" condition="!scheduleList.length">
                    <widgets>
                        <container style="q-pa-sm">
                            <label text="${emptyText}" type="p" style="m-muted q-mb-xs"/>
                            <link url="." text="Clear filters" link-type="anchor" condition="filtered"/>
                        </container>
                    </widgets>
                </section>
            </box-body-nopad>
        </container-box>
    </widgets>
</screen>
