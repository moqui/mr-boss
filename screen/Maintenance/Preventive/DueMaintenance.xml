<!-- Maintenance › Preventive › Due maintenance (design-maintenance §5 DueMaintenance: DueFind, DueRows, GenerateWork, ResolveDue;
    style-guide §3.2 List; impl-maintenance P14): the due of the active plans of the user's scope (Mantle's find#MaintenanceDue:
    MAINTENANCE_VIEW), by organization, equipment, facility (with those inside it), state (attention by default: due, overdue and
    unknown; or one, or all) and a horizon (a calendar due after it left out; a meter's always listed), overdue first. Each row: the
    plan, its target, the next due date in the target's zone or the meter's next threshold (a meter's predicted date is never shown),
    the planned day, the last reading and its age, what remains or the due dates missed, the state and what generation would do
    (make work, its work still open, not due yet, or blocked: request a reading, a procedure that does not qualify). Its views: the
    list and a calendar of the dated obligations (a meter's are not placed), each titled overdue, due or forecast. For a planner or
    supervisor: GenerateWork (the preview of every row of the page, then one confirmed generation, a result per plan, through
    generate#MaintenanceWorkOrders), Generate on one row, the selection generated, and ResolveDue on a row: coalesce a calendar
    plan's missed due dates into one catch-up or skip its next due date, with a reason (reconcile#MaintenanceSchedule), or, for a
    resource administrator, record a meter's reading (record#MaintenanceMeter). The list says when it stops at its cap. No cost. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Due maintenance" default-menu-index="2">
    <parameter name="organizationPartyId"/>
    <parameter name="assetId"/>
    <parameter name="facilityId"/>
    <parameter name="state"/>
    <parameter name="thruDate"/>
    <parameter name="pageIndex"/>
    <parameter name="pageSize"/>
    <transition-include name="choices" location="component://mr-boss/template/MaintenanceParts.xml"/>
    <transition-include name="generateDue" location="component://mr-boss/template/MaintenancePlanParts.xml"/>
    <transition-include name="resolveDue" location="component://mr-boss/template/MaintenancePlanParts.xml"/>
    <actions>
        <set field="can" from="maintenance.capabilities"/>
        <set field="canPlan" from="!!(can.plan || can.supervise)"/>
        <set field="stateFilter" from="state || 'attention'"/>
        <service-call name="mantle.work.MaintenancePlanServices.find#MaintenanceDue" out-map="found" transaction="force-new"
                ignore-error="true" in-map="{organizationPartyId:organizationPartyId, assetId:assetId, facilityId:facilityId,
                    state:(stateFilter == 'all' ? null : stateFilter), thruDate:thruDate, pageIndex:pageIndex, pageSize:pageSize}"/>
        <script>ec.message.clearErrors()</script>
        <set field="dueList" from="(found?.dueList || []).map(row =&gt; Object.assign(row, {
                nextText: row.nextDueText || '', plannedText: row.due?.moved ? row.due.plannedDateText : '',
                readingText: row.lastReadingText ? row.lastReadingText + (row.dataAgeText ? ' (' + row.dataAgeText + ' ago)' : '') : '',
                calendarTitle: ({overdue: 'Overdue', due: 'Due', upcoming: 'Forecast'}[row.dueState] || 'Due') + ': ' + row.scheduleName,
                meter: row.due?.trigger === 'meter', missedCount: (row.due?.missed || []).length,
                readyToMake: row.generation === 'ready'}))"/>
        <set field="dueListCount" from="found?.dueListCount"/>
        <set field="dueListPageIndex" from="found?.dueListPageIndex"/>
        <set field="dueListPageSize" from="found?.dueListPageSize"/>
        <set field="dueListPageMaxIndex" from="found?.dueListPageMaxIndex"/>
        <set field="dueListPageRangeLow" from="found?.dueListPageRangeLow"/>
        <set field="dueListPageRangeHigh" from="found?.dueListPageRangeHigh"/>
        <set field="failures" from="found?.failures || []"/>
        <set field="capped" from="!!found?.dueListCapped"/>
        <set field="readyRows" from="dueList.filter(row =&gt; row.readyToMake)"/>
        <set field="generateForm" from="{maintenanceScheduleIds: readyRows.map(row =&gt; row.maintenanceScheduleId).join(','),
                operationKey: 'due-' + ec.user.randomString(20)}"/>
        <set field="filtered" from="!!(organizationPartyId || assetId || facilityId || state || thruDate)"/>
        <set field="emptyText" from="filtered ? 'No plan matches these filters.' : 'Nothing is due: no active plan is due, overdue or unknown.'"/>
    </actions>
    <widgets>
        <context title="Due maintenance" selection-form="DueList"/>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Due maintenance" type="h5"/>
            </container>
            <container style="col-auto row items-center q-gutter-xs">
                <container-dialog id="GenerateWorkDialog" button-text="Generate due work" type="primary" icon="sym_o_playlist_add"
                        title="Generate the due work of this page" width="760" condition="canPlan">
                    <label text="Each plan is taken on its own: one work order for its next obligation, none while its work is open. What each would do now:"
                            type="p" style="text-caption m-muted"/>
                    <form-list name="GeneratePreview" list="dueList" skip-form="true" paginate="false">
                        <field name="scheduleName"><default-field title="Plan"><display/></default-field></field>
                        <field name="targetName"><default-field title="For"><display/></default-field></field>
                        <field name="generationText"><default-field title="Generation"><display/></default-field></field>
                    </form-list>
                    <form-single name="GenerateWork" transition="generateDue" map="generateForm">
                        <field name="maintenanceScheduleIds"><default-field><hidden/></default-field></field>
                        <field name="operationKey"><default-field><hidden/></default-field></field>
                        <field name="submitButton">
                            <conditional-field condition="readyRows.length" title="Make ${readyRows.length} work order(s)">
                                <submit type="primary" confirmation="Make the work of ${readyRows.length} plan(s)? Work over the approval threshold waits for a supervisor."/>
                            </conditional-field>
                            <default-field><label text="No plan on this page is ready for work." type="p"/></default-field>
                        </field>
                    </form-single>
                </container-dialog>
            </container>
        </container>
        <section name="DueNotices" condition="failures.length || capped">
            <widgets>
                <container-box>
                    <box-body>
                        <label text="Only the first 500 active plans are read; narrow the list by organization or facility." type="p"
                                style="text-warning" condition="capped"/>
                        <section-iterate name="DueFailures" list="failures" entry="failure">
                            <widgets><label text="Plan ${failure.maintenanceScheduleId}: its due could not be read" type="div" style="text-negative"/></widgets>
                        </section-iterate>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <container-box>
            <box-body-nopad>
                <form-list name="DueList" list="dueList" skip-form="true" paginate="true" header-dialog="true" select-columns="true"
                        views="list,calendar">
                    <row-selection id-field="maintenanceScheduleId" parameter="maintenanceScheduleIds" list-mode="true" condition="canPlan">
                        <action>
                            <form-single name="GenerateSelected" transition="generateDue">
                                <field name="submitButton">
                                    <default-field title="Generate">
                                        <submit icon="sym_o_playlist_add" confirmation="Make the work of the selected plans that are ready? The others are named with why not."/>
                                    </default-field>
                                </field>
                            </form-single>
                        </action>
                    </row-selection>
                    <field name="organizationPartyId">
                        <header-field title="Organization">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'organizations', selected:organizationPartyId}"/>
                            </drop-down>
                        </header-field>
                        <default-field><ignored/></default-field>
                    </field>
                    <field name="assetId">
                        <header-field title="Equipment">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'equipment', selected:assetId}"/>
                            </drop-down>
                        </header-field>
                        <default-field><ignored/></default-field>
                    </field>
                    <field name="facilityId">
                        <header-field title="Facility" tooltip="With the facilities inside it">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'workFacilities', selected:facilityId}"/>
                            </drop-down>
                        </header-field>
                        <default-field><ignored/></default-field>
                    </field>
                    <field name="state">
                        <header-field title="Due">
                            <drop-down allow-empty="true">
                                <option key="attention" text="Due, overdue or unknown"/>
                                <option key="overdue" text="Overdue"/>
                                <option key="due" text="Due"/>
                                <option key="unknown" text="Unknown"/>
                                <option key="upcoming" text="Not due yet"/>
                                <option key="all" text="All"/>
                            </drop-down>
                        </header-field>
                        <default-field><ignored/></default-field>
                    </field>
                    <field name="thruDate">
                        <header-field title="Due through" tooltip="A calendar due after it is left out; a meter's is listed"><date-time type="date"/></header-field>
                        <default-field><ignored/></default-field>
                    </field>
                    <field name="maintenanceScheduleId">
                        <header-field title="Plan"/>
                        <default-field>
                            <link url="${sharedLinks['Preventive/Plans/PlanDetail']}" text="${scheduleName}" link-type="anchor"
                                    parameter-map="{maintenanceScheduleId:maintenanceScheduleId}"/>
                        </default-field>
                    </field>
                    <field name="targetName"><header-field title="For"/><default-field><display/></default-field></field>
                    <field name="nextText"><header-field title="Next due"/><default-field><display/></default-field></field>
                    <field name="plannedText"><header-field title="Planned"/><default-field><display/></default-field></field>
                    <field name="readingText"><header-field title="Last reading"/><default-field><display/></default-field></field>
                    <field name="remainingText"><header-field title="Remaining or missed"/><default-field><display/></default-field></field>
                    <field name="dueStateText">
                        <header-field title="State"/>
                        <default-field>
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                                    dueStateColor}">${WebUtilities.encodeHtml(dueStateText)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong", text: dueStateText})}]]></text>
                                <text type="html">${dueStateText}</text>
                            </render-mode>
                        </default-field>
                    </field>
                    <field name="generationText">
                        <header-field title="Generation"/>
                        <default-field>
                            <label text="${generationText}" type="div" style="${readyToMake ? '' : 'm-muted'}"/>
                            <link url="${sharedLinks['WorkOrders/WorkOrderDetail']}" text="Open ${openWorkEffortId}" link-type="anchor"
                                    parameter-map="{workEffortId:openWorkEffortId}" condition="openWorkEffortId"/>
                        </default-field>
                    </field>
                    <field name="actions">
                        <header-field title=""/>
                        <default-field>
                            <link url="generateDue" text="Generate" icon="sym_o_playlist_add" link-type="hidden-form-link"
                                    parameter-map="{maintenanceScheduleIds:maintenanceScheduleId, operationKey:'due-' + maintenanceScheduleId + '-' + ec.user.randomString(10)}"
                                    condition="canPlan &amp;&amp; readyToMake" confirmation="Make the work of ${scheduleName}?"/>
                            <container-dialog id="Resolve_${maintenanceScheduleId}" button-text="Resolve" icon="sym_o_rule" title="Resolve ${scheduleName}"
                                    width="560" condition="canPlan &amp;&amp; (meter || missedCount || dueState == 'due')">
                                <section name="ResolveMeter" condition="meter">
                                    <widgets>
                                        <label text="${reasonText || 'The next threshold counts from the readings.'}" type="p" style="text-caption"/>
                                        <label text="A resource administrator records the reading; ask one for it." type="p" style="m-muted" condition="!can.resourceEdit"/>
                                        <form-single name="RecordReading" transition="resolveDue"
                                                map="{maintenanceScheduleId:maintenanceScheduleId, assetId:assetId, productMeterId:due.productMeterId, decision:'reading'}">
                                            <field name="maintenanceScheduleId"><default-field><hidden/></default-field></field>
                                            <field name="assetId"><default-field><hidden/></default-field></field>
                                            <field name="productMeterId"><default-field><hidden/></default-field></field>
                                            <field name="decision"><default-field><hidden/></default-field></field>
                                            <field name="meterValue"><default-field title="${due.meterName} reading"><text-line size="10" input-type="number"/></default-field></field>
                                            <field name="submitButton"><default-field title="Record reading"><submit type="primary"/></default-field></field>
                                        </form-single>
                                    </widgets>
                                </section>
                                <section name="ResolveCalendar" condition="!meter">
                                    <widgets>
                                        <label text="${missedCount} due date(s) passed without a completion. Coalesce them into one catch-up (late for each), or skip the next due date ${nextText}; either keeps its reason."
                                                type="p" style="text-caption"/>
                                        <form-single name="DecideDue" transition="resolveDue" map="{maintenanceScheduleId:maintenanceScheduleId,
                                                decision:(missedCount &gt; 1 ? 'coalesce' : 'skip')}">
                                            <field name="maintenanceScheduleId"><default-field><hidden/></default-field></field>
                                            <field name="decision">
                                                <default-field title="Decision">
                                                    <radio><option key="coalesce" text="Coalesce the missed due dates into one catch-up"/>
                                                        <option key="skip" text="Skip the next due date"/></radio>
                                                </default-field>
                                            </field>
                                            <field name="changeReason"><default-field title="Why"><text-area rows="2"/></default-field></field>
                                            <field name="submitButton"><default-field title="Decide"><submit type="primary"/></default-field></field>
                                        </form-single>
                                    </widgets>
                                </section>
                            </container-dialog>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column><field-ref name="maintenanceScheduleId"/><field-ref name="targetName"/></column>
                        <column><field-ref name="dueStateText"/><field-ref name="nextText"/></column>
                    </columns>
                    <view-calendar start-field="plannedDate" title-field="calendarTitle" color-field="dueState" key-fields="maintenanceScheduleId"
                            card-fields="targetName,dueStateText"/>
                </form-list>
                <section name="NoDue" condition="!dueList.length">
                    <widgets>
                        <container style="q-pa-sm">
                            <label text="${emptyText}" type="p" style="m-muted q-mb-xs"/>
                            <link url="." text="Clear filters" link-type="anchor" condition="filtered"/>
                        </container>
                    </widgets>
                </section>
            </box-body-nopad>
        </container-box>
    </widgets>
</screen>
