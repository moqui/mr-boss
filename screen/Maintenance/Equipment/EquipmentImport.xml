<!-- Maintenance › Equipment › Equipment import (design-maintenance §6 EquipmentImport, §12 the equipment import and outcome file;
    impl-maintenance P18): the shared import wizard (Shared/DataImport.xml) mounted for the `equipment` target, as People's
    EmployeeImport mounts it for employees, so this screen carries the Equipment area's grant and the shared wizard none of its own.
    The mount (DataImport.js, appRoot Maintenance) asks a reader of equipment to read and MAINTENANCE_IMPORT with
    MAINTENANCE_RESOURCE_EDIT to run; each row is Mantle's validate# and apply#EquipmentImportRow, through Maintenance's own
    equipment, custody and meter services with their permission and organization checks. Upload, map and preview, apply, and the
    results with the refused rows downloadable. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Equipment import" default-menu-index="4">
    <subscreens default-item="Index">
        <subscreens-item name="Index" location="component://mr-boss/screen/Shared/DataImport.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
