<!-- Maintenance › Facilities › Find (design-maintenance §6 Facilities: FacilityFind, FacilityTree with its list twin, NewFacility;
    style-guide §3.2 List, §3.15 tree; impl-maintenance P2): the facilities of the user's maintenance scope (Mantle's
    find#MaintenanceFacilities, scoped in the query before paging) as a tree by parent or a list, found by name, type,
    organization, bookable, capacity and a room feature, each with its type, organization, capacity, time zone (own or inherited),
    features, state and equipment count, and opening FacilityDetail. A parent outside the scope is an unnamed node, never its name
    or id. New facility for a holder of FACILITY_EDIT (store#Facility, which checks the owner and the parent cycle); a top-level
    facility asks for its time zone. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Facilities" default-menu-index="1">
    <parameter name="text"/>
    <parameter name="facilityTypeEnumId"/>
    <parameter name="organizationPartyId"/>
    <parameter name="bookable"/>
    <parameter name="minCapacity"/>
    <parameter name="featureEnumId"/>
    <parameter name="pageIndex"/>
    <transition-include name="choices" location="component://mr-boss/template/MaintenanceParts.xml"/>
    <transition-include name="createMaintenanceFacility" location="component://mr-boss/template/MaintenanceParts.xml"/>
    <!-- a level of the tree: the facilities inside one of the scope's (or under an unnamed node) -->
    <transition name="facilityChildren" read-only="true">
        <actions>
            <service-call name="mantle.product.MaintenanceResourceServices.find#MaintenanceFacilities" out-map="children"
                    in-map="{parentFacilityId:parentFacilityId, pageSize:100}"/>
            <script>ec.web.sendJsonResponse(children.facilityList)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <actions>
        <set field="can" from="maintenance.capabilities"/>
        <if condition="can.resourceRead">
            <service-call name="mantle.product.MaintenanceResourceServices.find#MaintenanceFacilities" out-map="context"
                    in-map="{text:text, facilityTypeEnumId:facilityTypeEnumId, organizationPartyId:organizationPartyId,
                        bookable:(bookable == 'Y'), minCapacity:minCapacity, featureEnumId:featureEnumId, pageIndex:pageIndex}"/>
        </if>
        <set field="facilityList" from="facilityList || []"/>
        <set field="newFacilityDefaults" from="{ownerPartyId: maintenance.defaultOrganizationPartyId || null,
                facilityTypeEnumId: 'FcTpBuilding'}"/>
    </actions>
    <widgets>
        <label text="You do not read facilities in Maintenance." type="p" style="m-muted" condition="!can.resourceRead"/>
        <section name="FacilityRegister" condition="can.resourceRead">
            <widgets>
                <container style="row items-center q-col-gutter-sm">
                    <container style="col">
                        <label text="Facilities" type="h5"/>
                    </container>
                    <container style="col-auto row q-gutter-sm">
                        <section-include name="NewMaintenanceFacility" location="component://mr-boss/template/MaintenanceParts.xml"/>
                    </container>
                </container>
                <form-list name="FacilityTree" list="facilityList" skip-form="true" paginate="true" header-dialog="true"
                        select-columns="true" views="tree,list">
                    <field name="text">
                        <header-field title="Name or id">
                            <text-line size="20"/>
                        </header-field>
                    </field>
                    <field name="facilityTypeEnumId">
                        <header-field title="Type">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'facilityTypes', selected:facilityTypeEnumId}"/>
                            </drop-down>
                        </header-field>
                    </field>
                    <field name="organizationPartyId">
                        <header-field title="Organization">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'organizations', selected:organizationPartyId}"/>
                            </drop-down>
                        </header-field>
                    </field>
                    <field name="bookable">
                        <header-field title="Bookable">
                            <drop-down allow-empty="true">
                                <option key="Y" text="Bookable only"/>
                            </drop-down>
                        </header-field>
                    </field>
                    <field name="minCapacity">
                        <header-field title="Holds at least">
                            <text-line size="5"/>
                        </header-field>
                    </field>
                    <field name="featureEnumId">
                        <header-field title="Room feature">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'roomFeatures', selected:featureEnumId}"/>
                            </drop-down>
                        </header-field>
                    </field>
                    <field name="facilityName">
                        <default-field title="Facility">
                            <link url="${sharedLinks['Facilities/FacilityDetail']}" text="${facilityName}" link-type="anchor"
                                    parameter-map="{facilityId:facilityId}" condition="!hiddenAncestor"/>
                            <label text="${label}" style="m-muted" condition="hiddenAncestor"/>
                        </default-field>
                    </field>
                    <field name="typeText">
                        <default-field title="Type">
                            <display/>
                        </default-field>
                    </field>
                    <field name="organizationName">
                        <default-field title="Organization">
                            <display/>
                        </default-field>
                    </field>
                    <field name="capacity" align="right">
                        <default-field title="Holds">
                            <display format="#,##0"/>
                        </default-field>
                    </field>
                    <field name="featuresText">
                        <default-field title="Features">
                            <display/>
                        </default-field>
                    </field>
                    <field name="timeZoneText">
                        <default-field title="Time zone">
                            <display/>
                        </default-field>
                    </field>
                    <field name="equipmentCount" align="right">
                        <default-field title="Equipment">
                            <display format="#,##0"/>
                        </default-field>
                    </field>
                    <field name="stateText">
                        <default-field title="State">
                            <render-mode>
                                <text type="qvt"><![CDATA[${stateText ? '<q-chip dense square class="q-ma-none m-tonal text-' + stateColor +
                                    '">' + WebUtilities.encodeHtml(stateText) + '</q-chip>' : ''}]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateText || ""})}]]></text>
                                <text type="html">${stateText || ''}</text>
                            </render-mode>
                        </default-field>
                    </field>
                    <field name="parentFacilityId">
                        <default-field>
                            <hidden/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="facilityName"/>
                            <field-ref name="typeText"/>
                        </column>
                        <column>
                            <field-ref name="stateText"/>
                            <field-ref name="capacity"/>
                        </column>
                    </columns>
                    <view-tree parent-field="parentFacilityId" key-fields="facilityId" child-count-field="childCount"
                            children-transition="facilityChildren"/>
                </form-list>
                <label text="No facilities match. Search by another name, or create a facility." type="p" style="m-muted"
                        condition="!facilityList.length"/>
            </widgets>
        </section>
    </widgets>
</screen>
