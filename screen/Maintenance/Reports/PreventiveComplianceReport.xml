<!-- Maintenance › Reports › PM compliance (design-maintenance §8 PreventiveComplianceReport: ComplianceOptions, ComplianceSummary,
    ComplianceRows; style-guide §3.7 Report; impl-maintenance P14): compliance over obligations, not a count of work orders
    (mantle.work.MaintenanceReportServices.get#MaintenanceCompliance: MAINTENANCE_VIEW, the organizations of the user's scope). The
    options: the due period (the last 90 days unless given), organization, equipment, facility (with those inside it) and one
    outcome. The summary: the obligations due (the denominator: on time, late, outstanding and skipped), each count opening its
    rows, the on-time percentage, and what is left out of the denominator (unknown, not yet due). The rows: each obligation's plan,
    target, due date or threshold, outcome, when it was satisfied, its work order and a note (coalesced into a catch-up, a skip's
    reason, the reading at a meter completion); its CSV is the form-list's own (P17: the columns chosen, every row). No cost. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="PM compliance" default-menu-index="2">
    <parameter name="fromDate"/>
    <parameter name="thruDate"/>
    <parameter name="organizationPartyId"/>
    <parameter name="assetId"/>
    <parameter name="facilityId"/>
    <parameter name="outcome"/>
    <parameter name="pageIndex"/>
    <parameter name="pageSize"/>
    <parameter name="pageNoLimit"/>
    <transition-include name="choices" location="component://mr-boss/template/MaintenanceParts.xml"/>
    <actions>
        <service-call name="mantle.work.MaintenanceReportServices.get#MaintenanceCompliance" out-map="report" transaction="force-new"
                ignore-error="true" in-map="{fromDate:fromDate, thruDate:thruDate, organizationPartyId:organizationPartyId, assetId:assetId,
                    facilityId:facilityId, outcome:outcome, pageIndex:pageIndex, pageSize:pageSize,
                    pageNoLimit:pageNoLimit == 'true' || pageNoLimit === true}"/>
        <set field="reportError" from="ec.message.hasError() ? ec.message.getErrorsString().replace(/^[A-Z][A-Z0-9_]+: /, '') : null"/>
        <script>ec.message.clearErrors()</script>
        <set field="summary" from="report?.summary || {}"/>
        <set field="complianceList" from="report?.complianceList || []"/>
        <set field="complianceListCount" from="report?.complianceListCount"/>
        <set field="complianceListPageIndex" from="report?.complianceListPageIndex"/>
        <set field="complianceListPageSize" from="report?.complianceListPageSize"/>
        <set field="complianceListPageMaxIndex" from="report?.complianceListPageMaxIndex"/>
        <set field="complianceListPageRangeLow" from="report?.complianceListPageRangeLow"/>
        <set field="complianceListPageRangeHigh" from="report?.complianceListPageRangeHigh"/>
        <set field="options" from="{fromDate: fromDate || null, thruDate: thruDate || null, organizationPartyId: organizationPartyId || null,
                assetId: assetId || null, facilityId: facilityId || null}"/>
        <set field="summaryRows" from="[
                {label: 'Due', key: null, count: summary.dueCount},
                {label: 'On time', key: 'onTime', count: summary.onTimeCount},
                {label: 'Late', key: 'late', count: summary.lateCount},
                {label: 'Outstanding', key: 'outstanding', count: summary.outstandingCount},
                {label: 'Skipped', key: 'skipped', count: summary.skippedCount},
                {label: 'Unknown', key: 'unknown', count: summary.unknownCount}]"/>
        <set field="rowsTitle" from="outcome ? 'Obligations: ' + (summaryRows.find(row =&gt; row.key == outcome)?.label || outcome) : 'Obligations'"/>
        <set field="percentText" from="summary.onTimePercent == null ? 'No obligation was due in the period' : summary.onTimePercent + '% on time'"/>
    </actions>
    <widgets>
        <context title="PM compliance"/>
        <label text="Preventive maintenance compliance" type="h5"/>
        <form-single name="ComplianceOptions" transition="." map="options">
            <field name="fromDate"><default-field title="Due from" tooltip="90 days before the end when empty"><date-time type="date"/></default-field></field>
            <field name="thruDate"><default-field title="Due through" tooltip="Today when empty"><date-time type="date"/></default-field></field>
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'organizations', selected:options.organizationPartyId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="assetId">
                <default-field title="Equipment">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'equipment', selected:options.assetId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="facilityId">
                <default-field title="Facility" tooltip="With the facilities inside it">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'workFacilities', selected:options.facilityId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="submitButton"><default-field title="Show"><submit/></default-field></field>
            <field-layout>
                <field-row><field-ref name="fromDate"/><field-ref name="thruDate"/></field-row>
                <field-row><field-ref name="organizationPartyId"/><field-ref name="assetId"/><field-ref name="facilityId"/></field-row>
                <field-ref name="submitButton"/>
            </field-layout>
        </form-single>
        <label text="${reportError}" type="p" style="text-negative" condition="reportError"/>
        <section name="ComplianceFound" condition="report">
            <widgets>
                <container-box>
                    <box-header title="Obligations due ${summary.fromText} to ${summary.thruText}: ${percentText}"/>
                    <box-body>
                        <label text="On time is satisfied by its due date, over every obligation due; a skipped or coalesced one is not compliant. ${summary.excludedText}."
                                type="p" style="text-caption m-muted"/>
                        <form-list name="ComplianceSummary" list="summaryRows" skip-form="true" paginate="false">
                            <field name="label">
                                <default-field title="Obligations">
                                    <link url="." text="${label}" link-type="anchor" condition="key &amp;&amp; count"
                                            parameter-map="Object.assign({outcome: key}, options)"/>
                                    <label text="${label}" type="span" condition="!(key &amp;&amp; count)"/>
                                </default-field>
                            </field>
                            <field name="count" align="right"><default-field title="Count"><display/></default-field></field>
                        </form-list>
                    </box-body>
                </container-box>
                <container-box>
                    <box-header title="${rowsTitle}"/>
                    <box-toolbar>
                        <link url="." text="All outcomes" link-type="anchor" parameter-map="options" condition="outcome"/>
                    </box-toolbar>
                    <box-body-nopad>
                        <form-list name="ComplianceRows" list="complianceList" skip-form="true" paginate="true" select-columns="true"
                                show-csv-button="true">
                            <field name="maintenanceScheduleId">
                                <default-field title="Plan">
                                    <link url="${sharedLinks['Preventive/Plans/PlanDetail']}" text="${scheduleName}" link-type="anchor"
                                            parameter-map="{maintenanceScheduleId:maintenanceScheduleId}"/>
                                </default-field>
                            </field>
                            <field name="targetName"><default-field title="For"><display/></default-field></field>
                            <field name="dueText"><default-field title="Due"><display/></default-field></field>
                            <field name="outcomeText">
                                <default-field title="Outcome">
                                    <render-mode>
                                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                                            outcomeColor}">${WebUtilities.encodeHtml(outcomeText)}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong", text: outcomeText})}]]></text>
                                        <text type="html">${outcomeText}</text>
                                    </render-mode>
                                </default-field>
                            </field>
                            <field name="satisfiedText"><default-field title="Satisfied"><display/></default-field></field>
                            <field name="workEffortId">
                                <default-field title="Work order">
                                    <link url="${sharedLinks['WorkOrders/WorkOrderDetail']}" text="${workEffortId}" link-type="anchor"
                                            parameter-map="{workEffortId:workEffortId}" condition="workEffortId"/>
                                </default-field>
                            </field>
                            <field name="note"><default-field title="Note"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="maintenanceScheduleId"/><field-ref name="dueText"/></column>
                                <column><field-ref name="outcomeText"/><field-ref name="satisfiedText"/></column>
                            </columns>
                        </form-list>
                        <label text="No obligation in this period." type="p" style="m-muted q-pa-sm" condition="!complianceList.length"/>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
