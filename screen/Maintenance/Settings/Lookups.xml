<!-- Maintenance › Settings › Lookups (design-maintenance §9 Lookups: MaintenanceLookups, FailureModes, CanonicalEditors; style-guide
    §3.9 Settings; impl-maintenance P18): Maintenance's lookups over mantle.work.MaintenanceSettingsServices find# and
    store#MaintenanceLookup, a whitelist of families. A vocabulary (work types, severities, hold and cancel reasons, outcomes,
    failure modes) takes Add value (the one primary), each value's Edit (name, code, order) and End (now or from a date, a danger
    dialog naming the value: it stays for the records that hold it and is offered for no new choice); a fixed kind (kinds,
    sources, resource dispositions) is renamed and reordered only. A failure mode's Applies to adds an asset class or a model, or
    ends one: with none it applies to all equipment, and a work order's failure mode choice offers those of its equipment.
    Nothing is deleted. CanonicalEditors links the owners' editors of what Maintenance does not keep: meters on the equipment
    model (Products), asset classes (Accounting), units (Products) and status flows (Tools). The Maintenance administrator's
    (MAINTENANCE_SETTINGS_EDIT, which Mantle checks on every change). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Lookups" default-menu-index="5"
        default-menu-include="ec.user.hasPermission('MAINTENANCE_SETTINGS_EDIT')">
    <parameter name="enumTypeId"/>
    <parameter name="includeEnded"/>
    <transition-include name="choices" location="component://mr-boss/template/MaintenanceParts.xml"/>
    <!-- a new value, a value's name, code or order, its end, or a failure mode's applicability: Mantle checks the administrator,
        the family and the revision -->
    <transition name="storeLookup">
        <actions>
            <service-call name="mantle.work.MaintenanceSettingsServices.store#MaintenanceLookup"
                    in-map="{enumTypeId:enumTypeId, enumId:(enumId || null), description:(description ?? null), enumCode:(enumCode ?? null),
                        sequenceNum:(sequenceNum ?? null), end:(endValue == 'Y' &amp;&amp; !thruDate), thruDate:(endValue == 'Y' ? (thruDate || null) : null),
                        expectedRevision:(expectedRevision || null), addClassEnumId:(addClassEnumId || null),
                        addProductId:(addProductId || null), endApplicabilityId:(endApplicabilityId || null)}"/>
            <if condition="!ec.message.hasError()"><message type="success">${endValue == 'Y' ? 'Value ended' : 'Value saved'}</message></if>
        </actions>
        <default-response url="."><parameter name="enumTypeId"/></default-response>
        <error-response url="."><parameter name="enumTypeId"/></error-response>
    </transition>
    <!-- the user's call of Nov 12 on F346 (impl-maintenance P20 "Gating Nov 12"): gated by permission, as the menu is, so a
        custom group given Maintenance in Admin, which the BOSS_MAINTENANCE deny rows do not reach, opens only what its
        permissions give -->
    <always-actions>
        <script>if(!(maintenance.capabilities.settingsEdit))throw new Error('PERMISSION_DENIED: Maintenance settings are the Maintenance administrator\'s')</script>
    </always-actions>
    <actions>
        <set field="can" from="maintenance.capabilities"/>
        <if condition="can.settingsEdit">
            <service-call name="mantle.work.MaintenanceSettingsServices.find#MaintenanceLookups" out-map="found" transaction="force-new"
                    ignore-error="true" in-map="{enumTypeId:(enumTypeId || 'MaintenanceType'), includeEnded:(includeEnded == 'Y')}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="lookupFound" from="!!found?.families"/>
        <set field="familyList" from="found?.families || []"/>
        <set field="values" from="(found?.values || []).map(row =&gt; Object.assign(row, {
                currentApplicability: (row.applicability || []).filter(applies =&gt; applies.current)}))"/>
        <set field="enumTypeId" from="found?.enumTypeId || enumTypeId || 'MaintenanceType'"/>
        <set field="family" from="familyList.find(row =&gt; row.enumTypeId === enumTypeId) || {}"/>
        <set field="familyFixed" from="!!found?.fixed"/>
        <set field="hasApplicability" from="!!found?.applicability"/>
        <set field="findValues" from="{enumTypeId: enumTypeId, includeEnded: includeEnded || null}"/>
        <set field="newValue" from="{enumTypeId: enumTypeId}"/>
        <!-- the owners' editors of what Maintenance reads and does not keep (design §9 CanonicalEditors) -->
        <set field="canonicalEditors" from="[
                {name: 'Meters', owner: 'Products: the equipment model', note: 'A model\'s meters and maintenance defaults are on its product', url: '/qapps/Products/Products/List'},
                {name: 'Asset classes', owner: 'Accounting', note: 'Classes and their accounts are Accounting\'s', url: '/qapps/Accounting/FixedAssets/AssetClasses'},
                {name: 'Units', owner: 'Products', note: 'Meter and duration units', url: '/qapps/Products/Units'},
                {name: 'Status flows', owner: 'Tools', note: 'A status label renamed there keeps its meaning', url: '/qapps/tools/StatusFlows'}]"/>
    </actions>
    <widgets>
        <section name="NotAdministrator" condition="!can.settingsEdit">
            <widgets>
                <label text="Lookups" type="h5"/>
                <label text="Maintenance's settings are the Maintenance administrator's." type="p" style="m-muted"/>
            </widgets>
        </section>
        <section name="MaintenanceLookups" condition="can.settingsEdit">
            <widgets>
                <container style="row items-center q-col-gutter-sm">
                    <container style="col">
                        <label text="Lookups" type="h5"/>
                        <label type="p" style="text-caption m-muted q-mb-none"
                                text="The values maintenance work chooses from. A value in use is ended, never deleted: the records that hold it keep it."/>
                    </container>
                    <container style="col-auto">
                        <container-dialog id="AddValueDialog" button-text="Add value" icon="sym_o_add" type="primary" width="560"
                                title="Add a value to ${family.title || ''}" condition="lookupFound &amp;&amp; !familyFixed">
                            <form-single name="AddValue" transition="storeLookup" map="newValue">
                                <field name="enumTypeId"><default-field><hidden/></default-field></field>
                                <field name="description"><default-field title="Name"><text-line size="40"/></default-field></field>
                                <field name="enumCode"><default-field title="Code"><text-line size="10"/></default-field></field>
                                <field name="sequenceNum"><default-field title="Order"><text-line size="5" input-type="number"/></default-field></field>
                                <field name="submitButton"><default-field title="Add value"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </container>
                </container>

                <form-single name="FindLookups" transition="." map="findValues">
                    <field name="enumTypeId">
                        <default-field title="Lookup">
                            <drop-down><list-options list="familyList" key="${enumTypeId}" text="${title}"/></drop-down>
                        </default-field>
                    </field>
                    <field name="includeEnded"><default-field title=" "><check><option key="Y" text="Include ended values"/></check></default-field></field>
                    <field name="submitButton"><default-field title="Show"><submit/></default-field></field>
                    <field-layout>
                        <field-row-big><field-ref name="enumTypeId"/><field-ref name="includeEnded"/><field-ref name="submitButton"/></field-row-big>
                    </field-layout>
                </form-single>
                <label type="p" style="text-caption m-muted" text="${family.kindText}" condition="family.kindText"/>

                <container-box>
                    <box-header title="${family.title || ''}"/>
                    <box-body-nopad>
                        <form-list name="LookupValues" list="values" skip-form="true" paginate="false" condition="values.length">
                            <field name="description"><default-field title="Name"><display/></default-field></field>
                            <field name="enumCode"><default-field title="Code"><display/></default-field></field>
                            <field name="sequenceNum"><default-field title="Order"><display/></default-field></field>
                            <field name="appliesText" hide="!hasApplicability"><default-field title="Applies to"><display/></default-field></field>
                            <field name="useCount"><default-field title="Records using it"><display format="#,##0"/></default-field></field>
                            <field name="stateText">
                                <default-field title="State">
                                    <render-mode>
                                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${ended ? 'grey-8' : 'positive'}">${
                                            WebUtilities.encodeHtml(stateText)}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateText})}]]></text>
                                        <text type="html">${stateText}</text>
                                    </render-mode>
                                </default-field>
                            </field>
                            <field name="actions">
                                <default-field title="">
                                    <container-dialog id="EditValue_${enumId}" button-text="Edit" icon="sym_o_edit" type="default" width="560"
                                            title="Edit ${description}" condition="canEdit">
                                        <form-single name="EditValue" transition="storeLookup"
                                                map="{enumTypeId:enumTypeId, enumId:enumId, expectedRevision:revision, description:description,
                                                    enumCode:enumCode, sequenceNum:sequenceNum}">
                                            <field name="enumTypeId"><default-field><hidden/></default-field></field>
                                            <field name="enumId"><default-field><hidden/></default-field></field>
                                            <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                            <field name="description"><default-field title="Name"><text-line size="40"/></default-field></field>
                                            <field name="enumCode"><default-field title="Code"><text-line size="10"/></default-field></field>
                                            <field name="sequenceNum"><default-field title="Order"><text-line size="5" input-type="number"/></default-field></field>
                                            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                                        </form-single>
                                    </container-dialog>
                                    <container-dialog id="AppliesTo_${enumId}" button-text="Applies to" icon="sym_o_filter_alt" type="default" width="620"
                                            title="Where ${description} applies" condition="canEdit &amp;&amp; hasApplicability">
                                        <label type="p" text="Applies to: ${appliesText}. With no class or model it applies to all equipment."/>
                                        <form-single name="AddApplicability" transition="storeLookup" map="{enumTypeId:enumTypeId, enumId:enumId}">
                                            <field name="enumTypeId"><default-field><hidden/></default-field></field>
                                            <field name="enumId"><default-field><hidden/></default-field></field>
                                            <field name="addClassEnumId">
                                                <default-field title="Asset class">
                                                    <drop-down allow-empty="true">
                                                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'equipmentClasses'}"/>
                                                    </drop-down>
                                                </default-field>
                                            </field>
                                            <field name="addProductId">
                                                <default-field title="or model">
                                                    <drop-down allow-empty="true">
                                                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'equipmentModels'}"/>
                                                    </drop-down>
                                                </default-field>
                                            </field>
                                            <field name="endApplicabilityId">
                                                <default-field title="or end">
                                                    <drop-down allow-empty="true">
                                                        <list-options list="currentApplicability" key="${applicabilityId}" text="${appliesText}"/>
                                                    </drop-down>
                                                </default-field>
                                            </field>
                                            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                                        </form-single>
                                    </container-dialog>
                                    <container-dialog id="EndValue_${enumId}" button-text="End" icon="sym_o_event_busy" type="default" width="520"
                                            title="End ${description}" condition="canEnd">
                                        <label type="p" text="${description} stays on the records that hold it (${useCount}) and is offered for no new choice."/>
                                        <form-single name="EndValue" transition="storeLookup"
                                                map="{enumTypeId:enumTypeId, enumId:enumId, expectedRevision:revision, endValue:'Y'}">
                                            <field name="enumTypeId"><default-field><hidden/></default-field></field>
                                            <field name="enumId"><default-field><hidden/></default-field></field>
                                            <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                            <field name="endValue"><default-field><hidden/></default-field></field>
                                            <field name="thruDate"><default-field title="Ends" tooltip="Empty: now"><date-time/></default-field></field>
                                            <field name="submitButton">
                                                <default-field title="End value">
                                                    <submit type="danger" confirmation="End ${description}?"/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="description"/><field-ref name="useCount"/></column>
                                <column><field-ref name="stateText"/><field-ref name="actions"/></column>
                            </columns>
                        </form-list>
                        <label type="p" style="q-pa-md m-muted" condition="lookupFound &amp;&amp; !values.length"
                                text="No value yet. Add the first with Add value."/>
                        <label type="p" style="q-pa-md text-negative" condition="!lookupFound"
                                text="These lookups are not available just now."/>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
        <section name="CanonicalEditors" condition="can.settingsEdit">
            <widgets>
                <container-box>
                    <box-header title="Kept by their owners"/>
                    <box-body-nopad>
                        <form-list name="CanonicalEditorRows" list="canonicalEditors" skip-form="true" paginate="false">
                            <field name="name">
                                <default-field title="What">
                                    <link url="${url}" url-type="plain" text="${name}" link-type="anchor"/>
                                </default-field>
                            </field>
                            <field name="owner"><default-field title="Kept in"><display/></default-field></field>
                            <field name="note"><default-field title=""><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="name"/><field-ref name="note"/></column>
                                <column><field-ref name="owner"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
