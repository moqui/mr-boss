<!-- Maintenance › Settings › Work policy (design-maintenance §9 MaintenanceSettings; style-guide §3.9 Settings; impl-maintenance P3):
    one organization's work policy (mantle.work.MaintenanceSettingsServices get# and store#MaintenancePolicy, MAINTENANCE_SETTINGS_EDIT):
    the planned-work approval threshold in hours (zero puts all template, preventive and planned work before a supervisor; corrective
    work by a planner is approved on create), the closure policy, the default work type and team, and whether production requests
    and warranty repairs become managed work (off), whether a procedure's last author may approve it (P6; off), and whether a
    technician's voice note on a checklist step is transcribed (P7 review, the user's call of Nov 12; off). A change starts a
    dated policy from now and ends the one in effect. The cost half of the threshold, the qualification check and the job defaults
    join with their phases (P11, P8, P14). P18: a change starts from a date chosen (now or later; the one in effect ends then, a
    later plan is withdrawn), and the policies planned and the last ended are listed (PolicyDates); a field a form does not post
    is kept from the policy in effect, so each phase's section stores its own fields. P18 review R4: a start before a planned policy is
    refused (PLAN_PENDING) unless Withdraw, which the form offers while a policy is planned. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Work policy" default-menu-index="2">
    <parameter name="organizationPartyId"/>
    <transition-include name="choices" location="component://mr-boss/template/MaintenanceParts.xml"/>
    <transition name="storePolicy">
        <actions>
            <service-call name="ironstone.maintenance.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'organization', recordId:organizationPartyId, capability:'settingsEdit'}"/>
            <service-call name="mantle.work.MaintenanceSettingsServices.store#MaintenancePolicy"
                    in-map="{organizationPartyId:organizationPartyId, approvalThresholdHours:approvalThresholdHours,
                        fromDate:(fromDate || null), withdrawPlanned:(withdrawPlanned == 'Y'), closurePolicyEnumId:closurePolicyEnumId, defaultMaintenanceTypeEnumId:defaultMaintenanceTypeEnumId,
                        defaultTeamPartyId:defaultTeamPartyId, productionRequestsManaged:productionRequestsManaged,
                        warrantyRepairsManaged:warrantyRepairsManaged, procedureSelfApproval:procedureSelfApproval,
                        voiceNoteTranscription:voiceNoteTranscription, comments:comments}"/>
            <if condition="!ec.message.hasError()"><message type="success">Work policy saved</message></if>
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId"/>
        </default-response>
        <error-response url=".">
            <parameter name="organizationPartyId"/>
        </error-response>
    </transition>
    <actions>
        <set field="can" from="maintenance.capabilities"/>
        <set field="organizationPartyId" from="organizationPartyId || maintenance.activeOrganizationPartyId || maintenance.organizationPartyIds?.[0] || null"/>
        <if condition="can.settingsEdit &amp;&amp; organizationPartyId">
            <service-call name="mantle.work.MaintenanceSettingsServices.get#MaintenancePolicy" out-map="policyOut" transaction="force-new"
                    ignore-error="true" in-map="{organizationPartyId:organizationPartyId}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="policy" from="policyOut?.policy || null"/>
        <!-- P18: the policies planned to start later and the last that ended -->
        <set field="datedPolicies" from="(policyOut?.planned || []).map(row =&gt; Object.assign({stateText: 'Planned'}, row)).concat(
                (policyOut?.ended || []).map(row =&gt; Object.assign({stateText: 'Ended'}, row))).map(row =&gt; Object.assign(row, {
                    thresholdText: String(row.approvalThresholdHours ?? 0) + ' h', periodText: row.fromDateText + (row.thruDateText ? ' to ' + row.thruDateText : '')}))"/>
        <set field="policyValues" from="policy ? {organizationPartyId: organizationPartyId,
                approvalThresholdHours: String(policy.approvalThresholdHours ?? 0), closurePolicyEnumId: policy.closurePolicyEnumId,
                defaultMaintenanceTypeEnumId: policy.defaultMaintenanceTypeEnumId, defaultTeamPartyId: policy.defaultTeamPartyId,
                productionRequestsManaged: policy.productionRequestsManaged ? 'Y' : 'N',
                warrantyRepairsManaged: policy.warrantyRepairsManaged ? 'Y' : 'N', procedureSelfApproval: policy.procedureSelfApproval ? 'Y' : 'N',
                voiceNoteTranscription: policy.voiceNoteTranscription ? 'Y' : 'N',
                comments: policy.comments} : {organizationPartyId: organizationPartyId}"/>
        <!-- P18 review R4 (the user's call of Nov 12): a start before a planned policy withdraws it only when asked -->
        <set field="plannedText" from="(policyOut?.planned || []).map(row =&gt; row.fromDateText).join(', ')"/>
        <set field="sinceText" from="policy?.fromDate ? 'In effect since ' + policy.fromDateText : 'The defaults are in effect: no policy has been saved.'"/>
    </actions>
    <widgets>
        <label text="Work policy" type="h5"/>
        <label text="Maintenance's settings are the Maintenance administrator's." type="p" style="m-muted" condition="!can.settingsEdit"/>
        <label text="This organization is not available to you." type="p" style="text-negative" condition="can.settingsEdit &amp;&amp; !policy"/>
        <section name="PolicyForm" condition="can.settingsEdit &amp;&amp; policy">
            <widgets>
                <form-single name="PolicyOrganization" transition="." map="policyValues">
                    <field name="organizationPartyId">
                        <default-field title="Organization">
                            <drop-down>
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'organizations', selected:policyValues.organizationPartyId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="showButton"><default-field title="Show"><submit/></default-field></field>
                    <field-layout><field-row><field-ref name="organizationPartyId"/><field-ref name="showButton"/></field-row></field-layout>
                </form-single>
                <label text="${sinceText}" type="p" style="text-caption m-muted"/>
                <container-box>
                    <box-body>
                        <form-single name="MaintenanceSettings" transition="storePolicy" map="policyValues">
                            <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                            <field name="approvalThresholdHours">
                                <default-field title="Approve planned work up to (hours)"
                                        tooltip="Planned work estimated above this, or with no estimate, waits for a supervisor; zero sends all of it">
                                    <text-line size="6" input-type="number"/>
                                </default-field>
                            </field>
                            <field name="closurePolicyEnumId">
                                <default-field title="Closing completed work">
                                    <drop-down>
                                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                                parameter-map="{choice:'closurePolicies', selected:policyValues.closurePolicyEnumId}"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="defaultMaintenanceTypeEnumId">
                                <default-field title="Default work type">
                                    <drop-down allow-empty="true">
                                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                                parameter-map="{choice:'maintenanceTypes', selected:policyValues.defaultMaintenanceTypeEnumId}"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="defaultTeamPartyId">
                                <default-field title="Default team">
                                    <drop-down allow-empty="true">
                                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                                parameter-map="{choice:'teams', selected:policyValues.defaultTeamPartyId, organizationPartyId:policyValues.organizationPartyId}"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="productionRequestsManaged">
                                <default-field title="Production maintenance requests become work orders">
                                    <radio><option key="N" text="No"/><option key="Y" text="Yes"/></radio>
                                </default-field>
                            </field>
                            <field name="warrantyRepairsManaged">
                                <default-field title="Warranty repairs become work orders">
                                    <radio><option key="N" text="No"/><option key="Y" text="Yes"/></radio>
                                </default-field>
                            </field>
                            <field name="procedureSelfApproval">
                                <default-field title="A procedure's last author may approve it" tooltip="Off: another approver approves each change">
                                    <radio><option key="N" text="No"/><option key="Y" text="Yes"/></radio>
                                </default-field>
                            </field>
                            <field name="voiceNoteTranscription">
                                <default-field title="Transcribe technicians' voice notes"
                                        tooltip="Yes sends a voice note on a checklist step to the speech model and keeps its text on the check; the recording is kept either way">
                                    <radio><option key="N" text="No"/><option key="Y" text="Yes"/></radio>
                                </default-field>
                            </field>
                            <field name="fromDate">
                                <default-field title="Starts" tooltip="Empty: now. The policy in effect ends when this one starts">
                                    <date-time type="timestamp"/>
                                </default-field>
                            </field>
                            <field name="withdrawPlanned">
                                <conditional-field condition="plannedText" title="Withdraw the policy planned from ${plannedText}"
                                        tooltip="No: a policy that starts before the planned one is refused. Yes: the planned one is withdrawn and this one stays in effect">
                                    <radio no-current-selected-key="N"><option key="N" text="No"/><option key="Y" text="Yes"/></radio>
                                </conditional-field>
                                <default-field><hidden default-value="N"/></default-field>
                            </field>
                            <field name="comments"><default-field title="Why it changes"><text-line size="60"/></default-field></field>
                            <field name="submitButton">
                                <default-field title="Save">
                                    <submit type="primary" confirmation="Save this work policy? The one in effect ends when it starts."/>
                                </default-field>
                            </field>
                        </form-single>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <!-- P18: the dated policies, planned and ended -->
        <section name="PolicyDates" condition="can.settingsEdit &amp;&amp; policy &amp;&amp; datedPolicies">
            <widgets>
                <container-box>
                    <box-header title="Planned and earlier policies"/>
                    <box-body>
                        <form-list name="DatedPolicies" list="datedPolicies" skip-form="true" paginate="false">
                            <field name="stateText"><default-field title="State"><display/></default-field></field>
                            <field name="periodText"><default-field title="In effect"><display/></default-field></field>
                            <field name="thresholdText"><default-field title="Approve up to"><display/></default-field></field>
                            <field name="closurePolicyText"><default-field title="Closing"><display/></default-field></field>
                            <field name="comments"><default-field title="Why"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="periodText"/><field-ref name="thresholdText"/></column>
                                <column><field-ref name="stateText"/></column>
                            </columns>
                        </form-list>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
