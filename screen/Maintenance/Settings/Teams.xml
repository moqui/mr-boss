<!-- Maintenance › Settings › Teams (design-maintenance §9 Teams: TeamList, TeamMembers, TeamDefaults; review Y4; style-guide §3.9
    Settings; impl-maintenance P8): the maintenance teams of the administrator's organizations, read only views of People's teams (an
    OrgTeam Organization with dated PrtMember rows; mantle.work.MaintenanceSettingsServices.find#MaintenanceTeams). TeamList names
    each team with its organization, lead and members; a team's TeamMembers lists its dated membership (lead or member, from and
    to), changed only in People's organization structure, which it links (shown to a user whose groups open People). TeamDefaults
    is what Maintenance owns: the dispatch and intake defaults (the resource scope, the default assignee among the members and the
    project, dated, and the intake address's plus-tag, the team's setting the mail intake reads; store#MaintenanceTeamDefaults,
    MAINTENANCE_SETTINGS_EDIT, which Mantle checks).
    Membership grants nothing in Maintenance. New teams are made in People. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Teams" default-menu-index="3">
    <parameter name="organizationPartyId"/>
    <parameter name="teamPartyId"/>
    <transition-include name="choices" location="component://mr-boss/template/MaintenanceParts.xml"/>
    <transition name="storeTeamDefaults">
        <actions>
            <service-call name="mantle.work.MaintenanceSettingsServices.store#MaintenanceTeamDefaults"
                    in-map="{teamPartyId:teamPartyId, facilityId:(facilityId || ''), defaultAssigneePartyId:(defaultAssigneePartyId || ''),
                        intakeTag:(intakeTag || ''), projectWorkEffortId:(projectWorkEffortId || ''), comments:(comments || null)}"/>
            <if condition="!ec.message.hasError()"><message type="success">Team defaults saved</message></if>
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId"/>
            <parameter name="teamPartyId"/>
        </default-response>
        <error-response url=".">
            <parameter name="organizationPartyId"/>
            <parameter name="teamPartyId"/>
        </error-response>
    </transition>
    <actions>
        <set field="can" from="maintenance.capabilities"/>
        <if condition="can.settingsEdit">
            <service-call name="mantle.work.MaintenanceSettingsServices.find#MaintenanceTeams" out-map="teamsOut" transaction="force-new"
                    ignore-error="true" in-map="{organizationPartyId:(organizationPartyId || null)}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="teamList" from="(teamsOut?.teamList || []).map(row =&gt; Object.assign({}, row, {
                defaultsText: row.defaults ? [row.defaults.defaultAssigneeName ? 'Assignee ' + row.defaults.defaultAssigneeName : '',
                    row.defaults.facilityName ? 'Scope ' + row.defaults.facilityName : '', row.defaults.intakeTag ? 'Intake +' + row.defaults.intakeTag : '']
                    .filter(Boolean).join(', ') : 'None'}))"/>
        <set field="team" from="teamPartyId ? teamList.find(row =&gt; row.teamPartyId == teamPartyId) || null : null"/>
        <set field="memberList" from="team ? team.members : []"/>
        <set field="currentMembers" from="memberList.filter(row =&gt; row.current)"/>
        <set field="defaultsValues" from="team ? {teamPartyId: team.teamPartyId, organizationPartyId: organizationPartyId,
                facilityId: team.defaults?.facilityId || '', defaultAssigneePartyId: team.defaults?.defaultAssigneePartyId || '',
                intakeTag: team.defaults?.intakeTag || '', projectWorkEffortId: team.defaults?.projectWorkEffortId || ''} : {}"/>
        <set field="findValues" from="{organizationPartyId: organizationPartyId || null}"/>
        <!-- People's organization structure, where membership changes, for a user whose groups open People -->
        <set field="peopleOpens" from="ec.artifactExecution.isPermittedOwn('component://mr-boss/screen/People.xml')"/>
    </actions>
    <widgets>
        <label text="Teams" type="h5"/>
        <label text="Maintenance's settings are the Maintenance administrator's." type="p" style="m-muted" condition="!can.settingsEdit"/>
        <section name="TeamsFound" condition="can.settingsEdit">
            <widgets>
                <form-single name="TeamsFind" transition="." map="findValues">
                    <field name="organizationPartyId">
                        <default-field title="Organization">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'organizations', selected:findValues.organizationPartyId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="submitButton"><default-field title="Show"><submit/></default-field></field>
                    <field-layout><field-row><field-ref name="organizationPartyId"/><field-ref name="submitButton"/></field-row></field-layout>
                </form-single>
                <label text="A team is People's: it is made, and its members join and leave, in People's organization structure. Being a member grants nothing in Maintenance."
                        type="p" style="text-caption m-muted"/>
                <container-box>
                    <box-header title="Teams"/>
                    <box-toolbar>
                        <link url="/qapps/People/Employees/OrgStructure" text="Organization structure" link-type="anchor-button" icon="sym_o_account_tree"
                                condition="peopleOpens"/>
                    </box-toolbar>
                    <box-body-nopad>
                        <form-list name="TeamList" list="teamList" skip-form="true" paginate="false">
                            <field name="teamName">
                                <header-field title="Team"/>
                                <default-field><link url="." text="${teamName}" link-type="anchor"
                                        parameter-map="{organizationPartyId:organizationPartyId, teamPartyId:teamPartyId}"/></default-field>
                            </field>
                            <field name="organizationName"><header-field title="Organization"/><default-field><display/></default-field></field>
                            <field name="leadName"><header-field title="Lead"/><default-field><display/></default-field></field>
                            <field name="memberCount" align="right"><header-field title="Members"/><default-field><display/></default-field></field>
                            <field name="defaultsText"><header-field title="Defaults"/><default-field><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="teamName"/><field-ref name="organizationName"/></column>
                                <column><field-ref name="memberCount"/></column>
                            </columns>
                        </form-list>
                        <label text="No maintenance team: make one in People's organization structure." type="p" style="m-muted q-pa-sm"
                                condition="!teamList.length"/>
                    </box-body-nopad>
                </container-box>
                <section name="TeamDetail" condition="team">
                    <widgets>
                        <container-box>
                            <box-header title="${team.teamName}: members"/>
                            <box-toolbar>
                                <link url="/qapps/People/Employees/OrgStructure" text="Change in People" link-type="anchor-button" icon="sym_o_open_in_new"
                                        parameter-map="{unitPartyId:team.teamPartyId}" condition="peopleOpens"/>
                            </box-toolbar>
                            <box-body-nopad>
                                <form-list name="TeamMembers" list="memberList" skip-form="true" paginate="false">
                                    <field name="personName"><header-field title="Person"/><default-field><display/></default-field></field>
                                    <field name="roleText"><header-field title="As"/><default-field><display/></default-field></field>
                                    <field name="fromDateText"><header-field title="From"/><default-field><display/></default-field></field>
                                    <field name="thruDateText"><header-field title="To"/><default-field><display/></default-field></field>
                                    <field name="stateText"><header-field title="State"/><default-field><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="personName"/><field-ref name="roleText"/></column>
                                        <column><field-ref name="stateText"/></column>
                                    </columns>
                                </form-list>
                                <label text="No member now." type="p" style="m-muted q-pa-sm" condition="!memberList.length"/>
                            </box-body-nopad>
                        </container-box>
                        <container-box>
                            <box-header title="Dispatch defaults"/>
                            <box-body>
                                <label text="${team.defaults?.fromDateText ? 'In effect since ' + team.defaults.fromDateText : 'No defaults have been saved.'}" type="p"
                                        style="text-caption m-muted"/>
                                <form-single name="TeamDefaults" transition="storeTeamDefaults" map="defaultsValues">
                                    <field name="teamPartyId"><default-field><hidden/></default-field></field>
                                    <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                                    <field name="facilityId">
                                        <default-field title="Takes the work of" tooltip="A facility and those under it; empty: the whole organization">
                                            <drop-down allow-empty="true">
                                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                                        parameter-map="{choice:'facilities', selected:defaultsValues.facilityId, organizationPartyId:team.organizationPartyId}"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="defaultAssigneePartyId">
                                        <default-field title="Default technician" tooltip="A current member, proposed first when the team is assigned">
                                            <drop-down allow-empty="true">
                                                <list-options list="currentMembers" key="${partyId}" text="${personName}"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="intakeTag">
                                        <default-field title="Intake address tag" tooltip="The plus-tag of the maintenance mailbox that files a request for this team: letters, digits and hyphens">
                                            <text-line size="20"/>
                                        </default-field>
                                    </field>
                                    <field name="projectWorkEffortId">
                                        <default-field title="Charged to project" tooltip="The project the team's repairs are charged to by default">
                                            <drop-down allow-empty="true">
                                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                                        parameter-map="{choice:'projects', selected:defaultsValues.projectWorkEffortId, organizationPartyId:team.organizationPartyId}"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="comments"><default-field title="Why it changes"><text-line size="50"/></default-field></field>
                                    <field name="submitButton">
                                        <default-field title="Save"><submit type="primary" confirmation="Save these defaults? The ones in effect end now."/></default-field>
                                    </field>
                                </form-single>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
