<!-- Maintenance › Settings › Readiness (design-maintenance §9 Settings Readiness; style-guide §3.9 Settings; impl-maintenance P18): what
    an organization's maintenance work still needs, over Mantle's check#MaintenanceReadiness (the provider maintenance.readiness that
    Admin's Health shows too): approved procedures, an approver for each resource approved by people, a technician who may issue
    parts, the maintenance expense mapping, the technicians' labor costing rates and the preventive generation job's last result.
    Each finding names its owner's place, resolved here from its route key (fixRoute, the keys Admin.js mountRoutes gives Admin);
    a ready check needs none. The organization chosen, or each of the administrator's organizations that uses Maintenance. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Readiness" default-menu-index="6">
    <parameter name="organizationPartyId"/>
    <transition-include name="choices" location="component://mr-boss/template/MaintenanceParts.xml"/>
    <actions>
        <set field="can" from="maintenance.capabilities"/>
        <if condition="can.settingsEdit">
            <service-call name="mantle.work.MaintenanceSettingsServices.check#MaintenanceReadiness" out-map="found" transaction="force-new"
                    ignore-error="true" in-map="{organizationPartyId:(organizationPartyId || null)}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="readinessFound" from="!!found?.checks"/>
        <!-- the owners' places of the route keys a check names: Maintenance's own, Accounting's and Admin's -->
        <set field="fixPlaces" from="{
                maintenanceSettings: {url: maintenance.sharedLinks['Settings/WorkPolicy'], text: 'Work policy'},
                maintenanceProcedures: {url: maintenance.sharedLinks['Procedures/Find'], text: 'Procedures'},
                maintenanceResources: {url: maintenance.sharedLinks['Scheduling/Resources'], text: 'Resources'},
                accountingPostingDefaults: {url: '/qapps/Accounting/Settings/PostingDefaults', text: 'Accounting: Posting defaults', plain: true},
                accountingCostingPolicies: {url: '/qapps/Accounting/Settings/CostingPolicies', text: 'Accounting: Costing policies', plain: true},
                adminGroups: {url: '/qapps/Admin/Access/Groups', text: 'Admin: Groups', plain: true},
                adminJob: {url: '/qapps/Admin/Operations/JobDetail', text: 'Admin: the job', idParameter: 'jobName', plain: true}}"/>
        <set field="checkRows" from="(found?.checks || []).map(row =&gt; {
                const place = row.fixRoute ? fixPlaces[row.fixRoute] : null
                return Object.assign({}, row, {
                    fixUrl: place ? place.url + (place.idParameter &amp;&amp; row.fixId ? '?' + place.idParameter + '=' + encodeURIComponent(row.fixId) : '') : null,
                    fixText: place?.text || '',
                    fixPlain: !!place?.plain,
                    stateColor: {ready: 'positive', warning: 'warning', failed: 'negative'}[row.state] || 'grey-8'})})"/>
        <set field="attentionCount" from="checkRows.filter(row =&gt; row.state !== 'ready').length"/>
        <set field="findValues" from="{organizationPartyId: organizationPartyId || null}"/>
    </actions>
    <widgets>
        <label text="Setup readiness" type="h5"/>
        <label text="Maintenance's settings are the Maintenance administrator's." type="p" style="m-muted" condition="!can.settingsEdit"/>
        <section name="ReadinessChecks" condition="can.settingsEdit">
            <widgets>
                <form-single name="ReadinessFind" transition="." map="findValues">
                    <field name="organizationPartyId">
                        <default-field title="Organization">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'organizations', selected:findValues.organizationPartyId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="submitButton"><default-field title="Check"><submit/></default-field></field>
                    <field-layout><field-row><field-ref name="organizationPartyId"/><field-ref name="submitButton"/></field-row></field-layout>
                </form-single>
                <label type="p" style="text-caption m-muted" condition="readinessFound &amp;&amp; checkRows.length"
                        text="${attentionCount ? attentionCount + ' to look at' : 'Everything checked is ready'}"/>
                <label type="p" style="text-negative" condition="!readinessFound"
                        text="This organization is not available to you, or readiness cannot be checked just now."/>
                <label type="p" style="m-muted" condition="readinessFound &amp;&amp; !checkRows.length"
                        text="No organization of yours uses Maintenance yet: choose one to check it."/>
                <container-box condition="checkRows.length">
                    <box-body-nopad>
                        <form-list name="ReadinessRows" list="checkRows" skip-form="true" paginate="false">
                            <field name="title"><default-field title="Check"><display/></default-field></field>
                            <field name="subject"><default-field title="Organization"><display/></default-field></field>
                            <field name="state">
                                <default-field title="State">
                                    <render-mode>
                                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${
                                            WebUtilities.encodeHtml(state)}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: state})}]]></text>
                                        <text type="html">${state}</text>
                                    </render-mode>
                                </default-field>
                            </field>
                            <field name="message"><default-field title="Finding"><display/></default-field></field>
                            <field name="fix">
                                <default-field title="Fix in">
                                    <link url="${fixUrl}" url-type="plain" text="${fixText}" link-type="anchor" condition="fixUrl &amp;&amp; fixPlain"/>
                                    <link url="${fixUrl}" text="${fixText}" link-type="anchor" condition="fixUrl &amp;&amp; !fixPlain"/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="title"/><field-ref name="message"/></column>
                                <column><field-ref name="state"/><field-ref name="fix"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
