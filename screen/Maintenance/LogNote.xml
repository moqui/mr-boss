<!-- LogNote (design-maintenance §1.4 Assist "Log as note"; impl-maintenance P19): the root's response-action opens it in the shell's
    quick-create frame from an Assist answer on a Maintenance record's page (a work order, equipment or a facility), with the page's
    record (entityName, recordId) and the answer's text in noteText. The record is checked as Maintenance checks it (check#Record:
    the user's maintenance scope, a technician their assigned work); the user reads and edits the text, then files it as a note on
    that record (mantle.party.CommunicationServices.log#RecordNote, which checks the record again), seen in its Conversation by those
    who may see the record. Nothing is filed until the user submits. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Log as note" default-menu-include="false">
    <parameter name="entityName"/>
    <parameter name="recordId"/>
    <transition name="logNote">
        <actions>
            <set field="recordType" from="({'mantle.work.effort.WorkEffort': 'workOrder', 'mantle.product.asset.Asset': 'asset',
                    'mantle.facility.Facility': 'facility'})[entityName] || null"/>
            <if condition="!recordType"><return error="true" message="Open a work order, equipment or a facility to log a note on it"/></if>
            <service-call name="ironstone.maintenance.AccessServices.check#Record" in-map="{appRoot:appRoot, recordType:recordType, recordId:recordId}"/>
            <if condition="!ec.message.hasError()">
                <service-call name="mantle.party.CommunicationServices.log#RecordNote"
                        in-map="{recordEntityName:entityName, recordId:recordId, body:noteText, subject:'Assist note'}"/>
            </if>
            <if condition="!ec.message.hasError()"><message type="success">Note logged</message></if>
        </actions>
        <default-response url="."><parameter name="entityName"/><parameter name="recordId"/></default-response>
        <error-response url="."><parameter name="entityName"/><parameter name="recordId"/></error-response>
    </transition>
    <actions>
        <set field="noteRecord" from="['mantle.work.effort.WorkEffort', 'mantle.product.asset.Asset', 'mantle.facility.Facility'].includes(entityName) &amp;&amp; recordId ? recordId : null"/>
        <set field="noteValues" from="{entityName:entityName, recordId:noteRecord, noteText:''}"/>
    </actions>
    <widgets>
        <label text="Log as note" type="h6"/>
        <section name="NoRecord" condition="!noteRecord">
            <widgets><label type="p" style="m-muted" text="Open a work order, equipment or a facility to log a note on it."/></widgets>
        </section>
        <section name="LogNoteFormShown" condition="noteRecord"><widgets>
            <form-single name="LogNoteForm" transition="logNote" map="noteValues">
                <field name="entityName"><default-field><hidden/></default-field></field>
                <field name="recordId"><default-field title="Record"><display/></default-field></field>
                <field name="noteText">
                    <default-field title="Note" tooltip="A note on the record, seen by those who may see the record">
                        <text-area rows="8" cols="60"/>
                    </default-field>
                </field>
                <field name="submitButton"><default-field title="Log the note"><submit/></default-field></field>
            </form-single>
        </widgets></section>
    </widgets>
</screen>
