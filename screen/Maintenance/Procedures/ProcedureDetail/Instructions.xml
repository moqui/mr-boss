<!-- ProcedureDetail's Instructions tab (design-maintenance §4 Instructions, §4.2; impl-maintenance P6, F68): the instruction of the
    procedure and of each step: the published one in effect, or the author's draft, which the next approval publishes as a
    WectInstruction row (stored once with its checksum and its start; the one before ended). Work made of the procedure resolves the
    instruction in effect when it was made, so a later approval changes none of it. For an author: Edit (store#ProcessInstruction, a
    draft) and Remove (no instruction from the next approval). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Instructions" default-menu-index="4">
    <parameter name="workEffortId"/>
    <transition-include name="storeInstruction" location="component://mr-boss/template/MaintenanceProcedureParts.xml"/>
    <actions>
        <!-- ProcedureDetail's actions read the procedure when it renders with the tab; alone (a reloaded tab, the terminal) it reads
            it here -->
        <if condition="procedureDetail == null &amp;&amp; recordFound">
            <service-call name="mantle.work.ProcessServices.get#WorkProcess" out-map="procedureDetail"
                    transaction="force-new" ignore-error="true" in-map="{workEffortId:workEffortId}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="procedure" from="procedureDetail?.procedure || null"/>
        <set field="canEdit" from="!!procedureDetail?.canEdit"/>
        <set field="instructionsById" from="Object.fromEntries((procedureDetail?.instructionList || []).map(row =&gt; [row.workEffortId, row]))"/>
        <set field="nodeList" from="procedure ? [{workEffortId: workEffortId, name: 'The whole procedure'}].concat((procedureDetail.stepList || [])
                .map(row =&gt; ({workEffortId: row.workEffortId, name: row.indentedName}))).map(node =&gt; Object.assign(node, {
                    instruction: instructionsById[node.workEffortId] || null})) : []"/>
    </actions>
    <widgets>
        <section name="InstructionsFound" condition="procedure">
            <widgets>
                <container-box>
                    <box-header title="Instructions"/>
                    <box-body>
                        <section-iterate name="InstructionRows" list="nodeList" entry="node">
                            <actions>
                                <set field="instructionValues" from="{rootWorkEffortId: workEffortId, stepWorkEffortId: node.workEffortId,
                                        contentText: node.instruction?.text || '', description: node.instruction?.description || ''}"/>
                                <set field="stateText" from="node.instruction ? [node.instruction.stateText, node.instruction.publishedFromText ?
                                        'published ' + node.instruction.publishedFromText : null].filter(Boolean).join(', ') : 'No instruction'"/>
                            </actions>
                            <widgets>
                                <container style="row items-start q-py-xs m-divider-bottom">
                                    <container style="col">
                                        <label text="${node.name}" type="div" style="text-weight-medium"/>
                                        <label text="${node.instruction?.text || ''}" type="div" style="m-pre-wrap" condition="node.instruction?.text"/>
                                        <label text="${stateText}" type="div" style="text-caption m-muted"/>
                                    </container>
                                    <section name="InstructionActions" condition="canEdit"><widgets>
                                        <container style="col-auto row items-center q-gutter-x-xs">
                                            <container-dialog id="EditInstruction_${node.workEffortId}" button-text="Edit" icon="sym_o_edit"
                                                    title="Instruction: ${node.name}" width="720">
                                                <form-single name="InstructionForm_${node.workEffortId}" transition="storeInstruction" map="instructionValues">
                                                    <field name="rootWorkEffortId"><default-field><hidden/></default-field></field>
                                                    <field name="stepWorkEffortId"><default-field><hidden/></default-field></field>
                                                    <field name="description"><default-field title="Title"><text-line size="50"/></default-field></field>
                                                    <field name="contentText"><default-field title="Instruction"><text-area rows="8"/></default-field></field>
                                                    <field name="submitButton"><default-field title="Save draft"><submit type="primary"/></default-field></field>
                                                </form-single>
                                            </container-dialog>
                                            <link url="storeInstruction" text="Remove" icon="sym_o_delete" link-type="hidden-form-link"
                                                    condition="node.instruction" confirmation="Remove this instruction from the next approval on?"
                                                    parameter-map="{rootWorkEffortId:workEffortId, stepWorkEffortId:node.workEffortId, endInstruction:'Y'}"/>
                                        </container>
                                    </widgets></section>
                                </container>
                            </widgets>
                        </section-iterate>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
