<!-- LossReport (design-manufacturing §9 LossReport; style-guide §3.12 Report): the production losses of the period by
    product, reason and type (LossFind; mantle.work.ProductionReportServices.get#ProductionLossReport), with the good
    output of the same products, the loss rate and, with financial read only, the loss's cost (LossRows); the totals
    per unit, the cost per currency and the trend by week. The export holds the parameters and columns, the cost only
    for a financial reader. Every Manufacturing reader reads it. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Loss" default-menu-index="5">
    <parameter name="organizationPartyId"/>
    <parameter name="facilityId"/>
    <parameter name="productId"/>
    <parameter name="reasonCode"/>
    <parameter name="lossTypeEnumId"/>
    <parameter name="statusId"/>
    <parameter name="fromDate"/>
    <parameter name="thruDate"/>
    <transition-include name="choices" location="component://mr-boss/template/ManufacturingParts.xml"/>
    <actions>
        <!-- the selected plant until the parameters name a facility or clear it (every facility) -->
        <set field="reportFacilityId" from="facilityId == null ? (manufacturing.plantId || null) : (facilityId || null)"/>
        <set field="lossStatusOptions" from="[{value:'PlsApproved', label:'Recorded'},
                {value:'PlsPending', label:'Waiting for approval'}, {value:'PlsRefused', label:'Refused'}]"/>
        <set field="options" from="{organizationPartyId:organizationPartyId || null, facilityId:reportFacilityId,
                productId:productId || null, reasonCode:reasonCode || null, lossTypeEnumId:lossTypeEnumId || null,
                statusId:statusId || 'PlsApproved', fromDate:fromDate || null, thruDate:thruDate || null}"/>
        <service-call name="mantle.work.ProductionReportServices.get#ProductionLossReport" out-map="report"
                in-map="Object.assign({}, options, {pageIndex:pageIndex, pageSize:pageSize, pageNoLimit:pageNoLimit})"
                transaction="force-new" ignore-error="true"/>
        <set field="reportFound" from="!!report?.asOf"/>
        <set field="financialRead" from="!!report?.financialRead"/>
        <set field="lossRows" from="report?.lossRows || []"/>
        <set field="totalRows" from="report?.totalRows || []"/>
        <set field="costTotals" from="report?.costTotals || []"/>
        <set field="trendRows" from="report?.trendRows || []"/>
        <script>if (report) for (const key of ['Count', 'PageIndex', 'PageSize', 'PageMaxIndex', 'PageRangeLow',
            'PageRangeHigh']) context['lossRows' + key] = report['lossRows' + key]</script>
    </actions>
    <widgets>
        <container style="m-record-header">
            <container style="m-record-title">
                <label text="Loss" type="h5"/>
                <label text="Good output, scrap, process loss and rework by product, reason and type, with the loss rate
                        over all output. A loss's cost needs financial read."
                        type="p" style="text-caption m-muted q-mb-none"/>
            </container>
        </container>
        <form-single name="LossFind" transition="." map="options">
            <field name="organizationPartyId">
                <default-field title="Organization" tooltip="Every organization of yours when empty">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'organizations', selected:organizationPartyId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="facilityId">
                <default-field title="Plant or work center" tooltip="Every facility of yours when empty">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'runFacilities', selected:reportFacilityId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="productId">
                <default-field title="Product">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'materialProducts', selected:productId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="reasonCode">
                <default-field title="Reason">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'lossReasons', selected:reasonCode}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="lossTypeEnumId">
                <default-field title="Loss">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'lossTypes', selected:lossTypeEnumId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="statusId">
                <default-field title="Losses">
                    <drop-down allow-empty="false">
                        <list-options list="lossStatusOptions" key="${value}" text="${label}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="fromDate">
                <default-field title="From" tooltip="30 days before the last day when empty">
                    <date-time type="date"/>
                </default-field>
            </field>
            <field name="thruDate">
                <default-field title="Through" tooltip="Today when empty">
                    <date-time type="date"/>
                </default-field>
            </field>
            <field name="submit">
                <default-field title="">
                    <submit text="Show report" type="primary"/>
                </default-field>
            </field>
            <field-layout>
                <field-row-big>
                    <field-ref name="organizationPartyId"/>
                    <field-ref name="facilityId"/>
                    <field-ref name="productId"/>
                    <field-ref name="reasonCode"/>
                </field-row-big>
                <field-row-big>
                    <field-ref name="lossTypeEnumId"/>
                    <field-ref name="statusId"/>
                    <field-ref name="fromDate"/>
                    <field-ref name="thruDate"/>
                </field-row-big>
                <field-ref name="submit"/>
            </field-layout>
        </form-single>
        <label text="The report is not available for these choices." type="p" condition="!reportFound"/>
        <section-include name="ReportStatus" location="component://mr-boss/template/ManufacturingReportParts.xml"/>
        <section name="TotalRowsSection" condition="reportFound">
            <widgets>
                <container-box>
                    <box-header title="Totals"/>
                    <box-body-nopad>
                        <label text="No output or loss in this period." type="p" style="q-pa-md m-muted"
                                condition="!totalRows.length"/>
                        <form-list name="LossTotals" list="totalRows" skip-form="true" paginate="false">
                            <field name="unitText">
                                <default-field title="Unit">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="goodQuantity" align="right">
                                <default-field title="Good">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="scrapQuantity" align="right">
                                <default-field title="Scrap">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="processLossQuantity" align="right">
                                <default-field title="Process loss">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="reworkQuantity" align="right">
                                <default-field title="Rework">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="componentScrapQuantity" align="right">
                                <default-field title="Component scrap">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="lossRateText">
                                <default-field title="Loss rate">
                                    <display/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="unitText"/>
                                    <field-ref name="goodQuantity"/>
                                </column>
                                <column>
                                    <field-ref name="scrapQuantity"/>
                                    <field-ref name="lossRateText"/>
                                </column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
        <section name="LossRowsSection" condition="reportFound">
            <widgets>
                <container-box>
                    <box-header title="Losses"/>
                    <box-body-nopad>
                        <label text="No loss in this period." type="p" style="q-pa-md m-muted"
                                condition="!lossRows.length"/>
                        <section name="LossRowsMoney" condition="financialRead">
                            <widgets>
                                <form-list name="LossRows" list="lossRows" skip-form="true" paginate="true"
                                        select-columns="true" show-csv-button="true" show-xlsx-button="true">
                                    <field name="productName">
                                        <default-field title="Product">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="lossTypeText">
                                        <default-field title="Loss">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="reasonText">
                                        <default-field title="Reason">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="quantity" align="right">
                                        <default-field title="Quantity">
                                            <display format="#,##0.###"/>
                                        </default-field>
                                    </field>
                                    <field name="unitText">
                                        <default-field title="Unit">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="lossCount" align="right">
                                        <default-field title="Records">
                                            <display format="#,##0"/>
                                        </default-field>
                                    </field>
                                    <field name="goodQuantity" align="right">
                                        <default-field title="Good output">
                                            <display format="#,##0.###"/>
                                        </default-field>
                                    </field>
                                    <field name="lossRateText">
                                        <default-field title="Loss rate">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="lossCost" align="right">
                                        <default-field title="Cost">
                                            <display currency-unit-field="currencyUomId"/>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column>
                                            <field-ref name="productName"/>
                                            <field-ref name="lossTypeText"/>
                                        </column>
                                        <column>
                                            <field-ref name="quantity"/>
                                            <field-ref name="lossRateText"/>
                                        </column>
                                    </columns>
                                </form-list>
                            </widgets>
                        </section>
                        <section name="LossRowsQuantities" condition="!financialRead">
                            <widgets>
                                <form-list name="LossRowsQuantities" list="lossRows" skip-form="true" paginate="true"
                                        select-columns="true" show-csv-button="true" show-xlsx-button="true">
                                    <field name="productName">
                                        <default-field title="Product">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="lossTypeText">
                                        <default-field title="Loss">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="reasonText">
                                        <default-field title="Reason">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="quantity" align="right">
                                        <default-field title="Quantity">
                                            <display format="#,##0.###"/>
                                        </default-field>
                                    </field>
                                    <field name="unitText">
                                        <default-field title="Unit">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="lossCount" align="right">
                                        <default-field title="Records">
                                            <display format="#,##0"/>
                                        </default-field>
                                    </field>
                                    <field name="goodQuantity" align="right">
                                        <default-field title="Good output">
                                            <display format="#,##0.###"/>
                                        </default-field>
                                    </field>
                                    <field name="lossRateText">
                                        <default-field title="Loss rate">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column>
                                            <field-ref name="productName"/>
                                            <field-ref name="lossTypeText"/>
                                        </column>
                                        <column>
                                            <field-ref name="quantity"/>
                                            <field-ref name="lossRateText"/>
                                        </column>
                                    </columns>
                                </form-list>
                            </widgets>
                        </section>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
        <section name="CostTotalsSection" condition="reportFound &amp;&amp; financialRead">
            <widgets>
                <container-box>
                    <box-header title="Cost of loss"/>
                    <box-body-nopad>
                        <label text="No loss cost in this period." type="p" style="q-pa-md m-muted"
                                condition="!costTotals.length"/>
                        <form-list name="LossCostTotals" list="costTotals" skip-form="true" paginate="false">
                            <field name="currencyUomId">
                                <default-field title="Currency">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="lossCost" align="right">
                                <default-field title="Cost">
                                    <display currency-unit-field="currencyUomId"/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="currencyUomId"/>
                                </column>
                                <column>
                                    <field-ref name="lossCost"/>
                                </column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
        <section name="TrendRowsSection" condition="reportFound">
            <widgets>
                <container-box>
                    <box-header title="Trend by week"/>
                    <box-body-nopad>
                        <label text="No output or loss in this period." type="p" style="q-pa-md m-muted"
                                condition="!trendRows.length"/>
                        <form-list name="LossTrend" list="trendRows" skip-form="true" paginate="false">
                            <field name="weekText">
                                <default-field title="Week of">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="unitText">
                                <default-field title="Unit">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="goodQuantity" align="right">
                                <default-field title="Good">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="scrapQuantity" align="right">
                                <default-field title="Scrap">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="processLossQuantity" align="right">
                                <default-field title="Process loss">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="reworkQuantity" align="right">
                                <default-field title="Rework">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="weekText"/>
                                    <field-ref name="unitText"/>
                                </column>
                                <column>
                                    <field-ref name="goodQuantity"/>
                                    <field-ref name="scrapQuantity"/>
                                </column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
