<!-- BillOfMaterialsVarianceReport (design-manufacturing §9 BillOfMaterialsVarianceReport; style-guide §3.12 Report):
    the work orders released in the period, or one (VarianceFind;
    mantle.work.ProductionReportServices.get#BomVarianceReport): each material line's planned quantity (scaled to the
    good output or the target) against its net issue, the variance, its substitute, BOM and release date, and with
    financial read only its actual cost and usage variance (LineRows); each work order's target, good, yield and its
    standard against recorded hours (YieldRows); totals per unit. The export holds the parameters and columns. Every
    Manufacturing reader reads it. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="BOM variance" default-menu-index="8">
    <parameter name="organizationPartyId"/>
    <parameter name="facilityId"/>
    <parameter name="productId"/>
    <parameter name="productBomId"/>
    <parameter name="workEffortId"/>
    <parameter name="quantityBasis"/>
    <parameter name="fromDate"/>
    <parameter name="thruDate"/>
    <transition-include name="choices" location="component://mr-boss/template/ManufacturingParts.xml"/>
    <actions>
        <!-- the selected plant until the parameters name a facility or clear it (every facility) -->
        <set field="reportFacilityId" from="facilityId == null ? (manufacturing.plantId || null) : (facilityId || null)"/>
        <set field="quantityBasisOptions" from="[{value:'good', label:'Good output'}, {value:'target', label:'Target'}]"/>
        <set field="options" from="{organizationPartyId:organizationPartyId || null, facilityId:reportFacilityId,
                productId:productId || null, productBomId:productBomId || null, workEffortId:workEffortId || null,
                quantityBasis:quantityBasis || 'good', fromDate:fromDate || null, thruDate:thruDate || null}"/>
        <service-call name="mantle.work.ProductionReportServices.get#BomVarianceReport" out-map="report"
                in-map="Object.assign({}, options, {pageIndex:pageIndex, pageSize:pageSize, pageNoLimit:pageNoLimit})"
                transaction="force-new" ignore-error="true"/>
        <set field="reportFound" from="!!report?.asOf"/>
        <set field="financialRead" from="!!report?.financialRead"/>
        <set field="lineRows" from="report?.lineRows || []"/>
        <set field="totalRows" from="report?.totalRows || []"/>
        <set field="moneyTotals" from="report?.moneyTotals || []"/>
        <set field="yieldRows" from="report?.yieldRows || []"/>
        <script>if (report) for (const key of ['Count', 'PageIndex', 'PageSize', 'PageMaxIndex', 'PageRangeLow',
            'PageRangeHigh']) context['lineRows' + key] = report['lineRows' + key]</script>
    </actions>
    <widgets>
        <container style="m-record-header">
            <container style="m-record-title">
                <label text="BOM variance" type="h5"/>
                <label text="Each released work order's material lines, planned against net issued, with substitutes and
                        the usage variance at actual cost (financial read); and each work order's yield and standard
                        against recorded hours."
                        type="p" style="text-caption m-muted q-mb-none"/>
            </container>
        </container>
        <form-single name="VarianceFind" transition="." map="options">
            <field name="organizationPartyId">
                <default-field title="Organization" tooltip="Every organization of yours when empty">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'organizations', selected:organizationPartyId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="facilityId">
                <default-field title="Plant or work center" tooltip="Every facility of yours when empty">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'runFacilities', selected:reportFacilityId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="productId">
                <default-field title="Product">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'materialProducts', selected:productId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="productBomId">
                <default-field title="BOM" tooltip="The released BOMs of the product">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'releasedBoms', selected:productBomId, productId:productId}">
                            <depends-on field="productId"/>
                        </dynamic-options>
                    </drop-down>
                </default-field>
            </field>
            <field name="workEffortId">
                <default-field title="Work order">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'workOrders', selected:workEffortId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="quantityBasis">
                <default-field title="Planned for" tooltip="The planned quantity scaled to the good output, or the whole target">
                    <drop-down allow-empty="false">
                        <list-options list="quantityBasisOptions" key="${value}" text="${label}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="fromDate">
                <default-field title="From" tooltip="30 days before the last day when empty">
                    <date-time type="date"/>
                </default-field>
            </field>
            <field name="thruDate">
                <default-field title="Through" tooltip="Today when empty">
                    <date-time type="date"/>
                </default-field>
            </field>
            <field name="submit">
                <default-field title="">
                    <submit text="Show report" type="primary"/>
                </default-field>
            </field>
            <field-layout>
                <field-row-big>
                    <field-ref name="organizationPartyId"/>
                    <field-ref name="facilityId"/>
                    <field-ref name="productId"/>
                    <field-ref name="productBomId"/>
                </field-row-big>
                <field-row-big>
                    <field-ref name="workEffortId"/>
                    <field-ref name="quantityBasis"/>
                    <field-ref name="fromDate"/>
                    <field-ref name="thruDate"/>
                </field-row-big>
                <field-ref name="submit"/>
            </field-layout>
        </form-single>
        <label text="The report is not available for these choices." type="p" condition="!reportFound"/>
        <section-include name="ReportStatus" location="component://mr-boss/template/ManufacturingReportParts.xml"/>
        <section name="TotalRowsSection" condition="reportFound">
            <widgets>
                <container-box>
                    <box-header title="Totals"/>
                    <box-body-nopad>
                        <label text="No totals." type="p" style="q-pa-md m-muted"
                                condition="!totalRows.length"/>
                        <form-list name="VarianceTotals" list="totalRows" skip-form="true" paginate="false">
                            <field name="unitText">
                                <default-field title="Unit">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="rowCount" align="right">
                                <default-field title="Lines">
                                    <display format="#,##0"/>
                                </default-field>
                            </field>
                            <field name="plannedQuantity" align="right">
                                <default-field title="Planned">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="actualQuantity" align="right">
                                <default-field title="Net issued">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="varianceQuantity" align="right">
                                <default-field title="Variance">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="unitText"/>
                                    <field-ref name="rowCount"/>
                                </column>
                                <column>
                                    <field-ref name="varianceQuantity"/>
                                </column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
        <section name="MoneyTotalsSection" condition="reportFound &amp;&amp; financialRead">
            <widgets>
                <container-box>
                    <box-header title="Amounts"/>
                    <box-body-nopad>
                        <label text="No amounts." type="p" style="q-pa-md m-muted"
                                condition="!moneyTotals.length"/>
                        <form-list name="VarianceMoneyTotals" list="moneyTotals" skip-form="true" paginate="false">
                            <field name="currencyUomId">
                                <default-field title="Currency">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="actualCost" align="right">
                                <default-field title="Actual cost">
                                    <display currency-unit-field="currencyUomId"/>
                                </default-field>
                            </field>
                            <field name="usageVariance" align="right">
                                <default-field title="Usage variance">
                                    <display currency-unit-field="currencyUomId"/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="currencyUomId"/>
                                </column>
                                <column>
                                    <field-ref name="usageVariance"/>
                                </column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
        <section name="LineRowsSection" condition="reportFound">
            <widgets>
                <container-box>
                    <box-header title="Material lines"/>
                    <box-body-nopad>
                        <label text="No work order released in this period." type="p" style="q-pa-md m-muted"
                                condition="!lineRows.length"/>
                        <section name="VarianceRowsMoney" condition="financialRead">
                            <widgets>
                                <form-list name="VarianceRows" list="lineRows" skip-form="true" paginate="true"
                                        select-columns="true" show-csv-button="true" show-xlsx-button="true">
                                    <field name="workEffortId">
                                        <default-field title="Work order">
                                            <link url="${sharedLinks['WorkOrders/WorkOrderDetail']}" text="${workEffortId}"
                                                    link-type="anchor" parameter-map="{workEffortId:workEffortId}"/>
                                        </default-field>
                                    </field>
                                    <field name="productName">
                                        <default-field title="Component">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="operationText">
                                        <default-field title="Operation">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="productBomId">
                                        <default-field title="BOM">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="releaseText">
                                        <default-field title="Released">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="plannedQuantity" align="right">
                                        <default-field title="Planned">
                                            <display format="#,##0.###"/>
                                        </default-field>
                                    </field>
                                    <field name="actualQuantity" align="right">
                                        <default-field title="Net issued">
                                            <display format="#,##0.###"/>
                                        </default-field>
                                    </field>
                                    <field name="varianceQuantity" align="right">
                                        <default-field title="Variance">
                                            <display format="#,##0.###"/>
                                        </default-field>
                                    </field>
                                    <field name="variancePercentText">
                                        <default-field title="Variance %">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="substituteText">
                                        <default-field title="Substitute">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="unitText">
                                        <default-field title="Unit">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="actualCost" align="right">
                                        <default-field title="Actual cost">
                                            <display currency-unit-field="currencyUomId"/>
                                        </default-field>
                                    </field>
                                    <field name="usageVariance" align="right">
                                        <default-field title="Usage variance">
                                            <display currency-unit-field="currencyUomId"/>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column>
                                            <field-ref name="workEffortId"/>
                                            <field-ref name="productName"/>
                                        </column>
                                        <column>
                                            <field-ref name="varianceQuantity"/>
                                            <field-ref name="variancePercentText"/>
                                        </column>
                                    </columns>
                                </form-list>
                            </widgets>
                        </section>
                        <section name="VarianceRowsQuantities" condition="!financialRead">
                            <widgets>
                                <form-list name="VarianceRowsQuantities" list="lineRows" skip-form="true" paginate="true"
                                        select-columns="true" show-csv-button="true" show-xlsx-button="true">
                                    <field name="workEffortId">
                                        <default-field title="Work order">
                                            <link url="${sharedLinks['WorkOrders/WorkOrderDetail']}" text="${workEffortId}"
                                                    link-type="anchor" parameter-map="{workEffortId:workEffortId}"/>
                                        </default-field>
                                    </field>
                                    <field name="productName">
                                        <default-field title="Component">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="operationText">
                                        <default-field title="Operation">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="productBomId">
                                        <default-field title="BOM">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="releaseText">
                                        <default-field title="Released">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="plannedQuantity" align="right">
                                        <default-field title="Planned">
                                            <display format="#,##0.###"/>
                                        </default-field>
                                    </field>
                                    <field name="actualQuantity" align="right">
                                        <default-field title="Net issued">
                                            <display format="#,##0.###"/>
                                        </default-field>
                                    </field>
                                    <field name="varianceQuantity" align="right">
                                        <default-field title="Variance">
                                            <display format="#,##0.###"/>
                                        </default-field>
                                    </field>
                                    <field name="variancePercentText">
                                        <default-field title="Variance %">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="substituteText">
                                        <default-field title="Substitute">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="unitText">
                                        <default-field title="Unit">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column>
                                            <field-ref name="workEffortId"/>
                                            <field-ref name="productName"/>
                                        </column>
                                        <column>
                                            <field-ref name="varianceQuantity"/>
                                            <field-ref name="variancePercentText"/>
                                        </column>
                                    </columns>
                                </form-list>
                            </widgets>
                        </section>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
        <section name="YieldRowsSection" condition="reportFound">
            <widgets>
                <container-box>
                    <box-header title="Yield and time"/>
                    <box-body-nopad>
                        <label text="No work order released in this period." type="p" style="q-pa-md m-muted"
                                condition="!yieldRows.length"/>
                        <form-list name="YieldRows" list="yieldRows" skip-form="true" paginate="false">
                            <field name="workEffortId">
                                <default-field title="Work order">
                                    <link url="${sharedLinks['WorkOrders/WorkOrderDetail']}" text="${workEffortId}"
                                            link-type="anchor" parameter-map="{workEffortId:workEffortId}"/>
                                </default-field>
                            </field>
                            <field name="productName">
                                <default-field title="Product">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="releaseText">
                                <default-field title="Released">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="targetQuantity" align="right">
                                <default-field title="Target">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="goodQuantity" align="right">
                                <default-field title="Good">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="unitText">
                                <default-field title="Unit">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="yieldText">
                                <default-field title="Yield">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="plannedHoursText">
                                <default-field title="Standard hours">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="actualHours" align="right">
                                <default-field title="Recorded hours">
                                    <display format="#,##0.##"/>
                                </default-field>
                            </field>
                            <field name="timeVarianceHours" align="right">
                                <default-field title="Time variance">
                                    <display format="#,##0.##"/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="workEffortId"/>
                                    <field-ref name="productName"/>
                                </column>
                                <column>
                                    <field-ref name="yieldText"/>
                                    <field-ref name="timeVarianceHours"/>
                                </column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
