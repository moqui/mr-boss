<!-- WorkOrderStatusReport (design-manufacturing §9 WorkOrderStatusReport; style-guide §3.12 Report): the work orders of
    the user's organizations by status, due and completion dates, product, plant or work center and assignee
    (StatusFind; mantle.work.ProductionReportServices.get#ProductionStatusReport after the root's access check), each
    with its target, good and remaining quantity, due date, days late and what blocks it (StatusRows), with the totals
    per unit and the count per status. The report's scope, as-of time, units and any partition it could not read show
    above the results (ReportStatus). The export holds the parameters and columns. Every Manufacturing reader reads it. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Status" default-menu-index="2">
    <parameter name="organizationPartyId"/>
    <parameter name="facilityId"/>
    <parameter name="statusId"/>
    <parameter name="productId"/>
    <parameter name="assigneePartyId"/>
    <parameter name="dueFrom"/>
    <parameter name="dueThru"/>
    <parameter name="completedFrom"/>
    <parameter name="completedThru"/>
    <transition-include name="choices" location="component://mr-boss/template/ManufacturingParts.xml"/>
    <actions>
        <!-- the selected plant until the parameters name a facility or clear it (every facility) -->
        <set field="reportFacilityId" from="facilityId == null ? (manufacturing.plantId || null) : (facilityId || null)"/>
        <set field="statusOptions" from="[{value:'all', label:'Every status'}, {value:'WeInPlanning', label:'Draft'},
                {value:'WeApproved', label:'Released'}, {value:'WeInProgress', label:'In progress'},
                {value:'WeOnHold', label:'On hold'}, {value:'WeComplete,WeClosed', label:'Completed'},
                {value:'WeCancelled', label:'Cancelled'}]"/>
        <set field="options" from="{organizationPartyId:organizationPartyId || null, facilityId:reportFacilityId,
                statusId:statusId || null, productId:productId || null, assigneePartyId:assigneePartyId || null,
                dueFrom:dueFrom || null, dueThru:dueThru || null, completedFrom:completedFrom || null,
                completedThru:completedThru || null}"/>
        <service-call name="mantle.work.ProductionReportServices.get#ProductionStatusReport" out-map="report"
                in-map="Object.assign({}, options, {pageIndex:pageIndex, pageSize:pageSize, pageNoLimit:pageNoLimit})"
                transaction="force-new" ignore-error="true"/>
        <set field="reportFound" from="!!report?.asOf"/>
        <set field="financialRead" from="!!report?.financialRead"/>
        <set field="statusRows" from="report?.statusRows || []"/>
        <set field="totalRows" from="report?.totalRows || []"/>
        <set field="statusCounts" from="report?.statusCounts || []"/>
        <script>if (report) for (const key of ['Count', 'PageIndex', 'PageSize', 'PageMaxIndex', 'PageRangeLow',
            'PageRangeHigh']) context['statusRows' + key] = report['statusRows' + key]</script>
    </actions>
    <widgets>
        <container style="m-record-header">
            <container style="m-record-title">
                <label text="Work order status" type="h5"/>
                <label text="Each work order's target, good and remaining quantity in its stock unit, its due date and how
                        late it is, and what blocks it. Totals are per unit."
                        type="p" style="text-caption m-muted q-mb-none"/>
            </container>
        </container>
        <form-single name="StatusFind" transition="." map="options">
            <field name="organizationPartyId">
                <default-field title="Organization" tooltip="Every organization of yours when empty">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'organizations', selected:organizationPartyId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="facilityId">
                <default-field title="Plant or work center" tooltip="Every facility of yours when empty">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'runFacilities', selected:reportFacilityId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="statusId">
                <default-field title="Status" tooltip="Open work orders when empty">
                    <drop-down allow-empty="true">
                        <list-options list="statusOptions" key="${value}" text="${label}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="productId">
                <default-field title="Product">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'materialProducts', selected:productId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="assigneePartyId">
                <default-field title="Assignee">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'runPeople', selected:assigneePartyId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="dueFrom">
                <default-field title="Due from" tooltip="Any due date when empty">
                    <date-time type="date"/>
                </default-field>
            </field>
            <field name="dueThru">
                <default-field title="Due through" tooltip="Any due date when empty">
                    <date-time type="date"/>
                </default-field>
            </field>
            <field name="completedFrom">
                <default-field title="Completed from" tooltip="Any completion when empty">
                    <date-time type="date"/>
                </default-field>
            </field>
            <field name="completedThru">
                <default-field title="Completed through" tooltip="Any completion when empty">
                    <date-time type="date"/>
                </default-field>
            </field>
            <field name="submit">
                <default-field title="">
                    <submit text="Show report" type="primary"/>
                </default-field>
            </field>
            <field-layout>
                <field-row-big>
                    <field-ref name="organizationPartyId"/>
                    <field-ref name="facilityId"/>
                    <field-ref name="statusId"/>
                    <field-ref name="productId"/>
                </field-row-big>
                <field-row-big>
                    <field-ref name="assigneePartyId"/>
                    <field-ref name="dueFrom"/>
                    <field-ref name="dueThru"/>
                    <field-ref name="completedFrom"/>
                    <field-ref name="completedThru"/>
                </field-row-big>
                <field-ref name="submit"/>
            </field-layout>
        </form-single>
        <label text="The report is not available for these choices." type="p" condition="!reportFound"/>
        <section-include name="ReportStatus" location="component://mr-boss/template/ManufacturingReportParts.xml"/>
        <section name="TotalRowsSection" condition="reportFound">
            <widgets>
                <container-box>
                    <box-header title="Totals"/>
                    <box-body-nopad>
                        <label text="No totals." type="p" style="q-pa-md m-muted"
                                condition="!totalRows.length"/>
                        <form-list name="StatusTotals" list="totalRows" skip-form="true" paginate="false">
                            <field name="unitText">
                                <default-field title="Unit">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="rowCount" align="right">
                                <default-field title="Work orders">
                                    <display format="#,##0"/>
                                </default-field>
                            </field>
                            <field name="targetQuantity" align="right">
                                <default-field title="Target">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="goodQuantity" align="right">
                                <default-field title="Good">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="remainingQuantity" align="right">
                                <default-field title="Remaining">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="lateCount" align="right">
                                <default-field title="Late">
                                    <display format="#,##0"/>
                                </default-field>
                            </field>
                            <field name="blockedCount" align="right">
                                <default-field title="Blocked">
                                    <display format="#,##0"/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="unitText"/>
                                    <field-ref name="rowCount"/>
                                </column>
                                <column>
                                    <field-ref name="remainingQuantity"/>
                                    <field-ref name="lateCount"/>
                                </column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
        <section name="StatusRowsSection" condition="reportFound">
            <widgets>
                <container-box>
                    <box-header title="Work orders"/>
                    <box-body-nopad>
                        <label text="No work order matches." type="p" style="q-pa-md m-muted"
                                condition="!statusRows.length"/>
                        <form-list name="StatusRows" list="statusRows" skip-form="true" paginate="true"
                                select-columns="true" show-csv-button="true" show-xlsx-button="true">
                            <field name="workEffortId">
                                <default-field title="Work order">
                                    <link url="${sharedLinks['WorkOrders/WorkOrderDetail']}" text="${workEffortId}"
                                            link-type="anchor" parameter-map="{workEffortId:workEffortId}"/>
                                </default-field>
                            </field>
                            <field name="workEffortName">
                                <default-field title="Name">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="productName">
                                <default-field title="Product">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="facilityName">
                                <default-field title="Facility">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="statusText">
                                <default-field title="Status">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="targetQuantity" align="right">
                                <default-field title="Target">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="goodQuantity" align="right">
                                <default-field title="Good">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="remainingQuantity" align="right">
                                <default-field title="Remaining">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="unitText">
                                <default-field title="Unit">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="dueText">
                                <default-field title="Due">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="completedText">
                                <default-field title="Completed">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="delayText">
                                <default-field title="Late by">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="blockText">
                                <default-field title="Blocked by">
                                    <display/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="workEffortId"/>
                                    <field-ref name="productName"/>
                                </column>
                                <column>
                                    <field-ref name="statusText"/>
                                    <field-ref name="remainingQuantity"/>
                                    <field-ref name="delayText"/>
                                </column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
        <section name="StatusCountsSection" condition="reportFound">
            <widgets>
                <container-box>
                    <box-header title="By status"/>
                    <box-body-nopad>
                        <label text="No work order." type="p" style="q-pa-md m-muted"
                                condition="!statusCounts.length"/>
                        <form-list name="StatusCounts" list="statusCounts" skip-form="true" paginate="false">
                            <field name="statusText">
                                <default-field title="Status">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="rowCount" align="right">
                                <default-field title="Work orders">
                                    <display format="#,##0"/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="statusText"/>
                                </column>
                                <column>
                                    <field-ref name="rowCount"/>
                                </column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
