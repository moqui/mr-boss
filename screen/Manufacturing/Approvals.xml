<!-- The Approvals area of IronStone Manufacturing (design-manufacturing §1.2, §8 Approvals; crosscut §3.15; impl-manufacturing
    P2, F40): the Commons Notifications list mounted with the approval topics Manufacturing owns, for the method approver and
    supervisor groups only (BOSS_MFG_APPROVALS). P2's are a BOM or a routing draft whose engineer asked for its release
    (BomRelease, RoutingRelease, sent by Mantle's request#BomRelease and request#RoutingRelease to the organization's users
    holding METHOD_APPROVE). Opening a row opens the method, where it is released (release#BomDraft, release#RoutingDraft),
    which marks the notification read. Later phases add their topics (amendments, substitutions, loss, overproduction). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Approvals" default-menu-index="11" menu-image="sym_o_approval" menu-image-type="icon">
    <always-actions>
        <set field="notificationTopics" from="['BomRelease', 'RoutingRelease']"/>
        <set field="notificationsTitle" value="Approvals"/>
    </always-actions>
    <subscreens default-item="Notifications" always-use-full-path="true">
        <subscreens-item name="Notifications" location="component://mr-boss/screen/Commons/Notifications.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
