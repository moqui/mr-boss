<!-- The inspection station's start (impl-manufacturing P8): what to scan, and the user's open inspections to pick from. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Scan" default-menu-include="false">
    <actions>
        <service-call name="ironstone.manufacturing.QualityServices.get#InspectionList" out-map="found"
                transaction="force-new" ignore-error="true" in-map="{assignedOnly:'Y', pageSize:20}"/>
        <set field="mine" from="found?.inspections || []"/>
    </actions>
    <widgets>
        <label text="Scan the inspection's label, its held stock or its lot to record its readings one at a time." type="p"/>
        <form-list name="MyInspections" list="mine" skip-form="true" paginate="false">
            <field name="qualityInspectionId">
                <default-field title="Inspection">
                    <link url="../Inspection" text="${qualityInspectionId} · ${productName}" link-type="anchor"
                            parameter-map="{qualityInspectionId:qualityInspectionId}"/>
                </default-field>
            </field>
            <field name="statusText"><default-field title="State"><display/></default-field></field>
        </form-list>
    </widgets>
</screen>
