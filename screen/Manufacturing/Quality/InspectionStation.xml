<!-- The inspection station (design-manufacturing QualityInspection's operator mode; impl-manufacturing P8; style-guide §8.2):
    at handheld density (48 px controls, 18 px text), a scan field that opens a production inspection by its id, its held
    stock or its lot (ironstone.manufacturing.QualityServices.resolve#InspectionScan), and the shared QualityInspection at
    InspectionStation/Inspection with operatorMode set: one characteristic and sample at a time with large pass and fail
    controls or the measured value, then Submit result, through the same transitions and Mantle verbs as the desk. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Inspection station" default-menu-include="false" server-static="qvt" density="handheld">
    <always-actions>
        <set field="operatorMode" from="true"/>
    </always-actions>
    <transition name="openScanned">
        <actions>
            <if condition="!qualityInspectionId">
                <return error="true" message="Scan or type an inspection, its stock or its lot"/>
            </if>
            <service-call name="ironstone.manufacturing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'inspection', recordId:qualityInspectionId}"/>
        </actions>
        <default-response url="Inspection">
            <parameter name="qualityInspectionId"/>
        </default-response>
        <error-response url="Scan"/>
    </transition>
    <subscreens default-item="Scan">
        <subscreens-item name="Inspection" location="component://mr-boss/screen/Shared/QualityInspection.xml"
                menu-include="false"/>
    </subscreens>
    <widgets>
        <context title="Inspection station"/>
        <label text="Inspection station" type="h5"/>
        <form-single name="InspectionScan" transition="openScanned">
            <field name="qualityInspectionId">
                <default-field title="Scan">
                    <scan-input resolver="ironstone.manufacturing.QualityServices.resolve#InspectionScan"
                            allowed-types="inspection" placeholder="Scan the inspection, its stock or lot"/>
                </default-field>
            </field>
            <field name="submit">
                <default-field title=""><submit text="Open"/></default-field>
            </field>
        </form-single>
        <subscreens-active/>
    </widgets>
</screen>
