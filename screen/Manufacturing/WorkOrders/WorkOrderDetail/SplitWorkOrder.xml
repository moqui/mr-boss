<!-- SplitWorkOrder (design-manufacturing §3 SplitWorkOrder; style-guide §3.10 Wizard; impl-manufacturing P9): a split of a
    work order's remaining demand, or a backorder of it, in three steps under the work order's header, the URL holding each
    step's values so Back keeps them. Allocation: split or backorder, the quantity of what is left (all of it for a backorder),
    the due date, the plant or line and the reason; a backorder of a running work order may complete it. Disposition: what
    moves (mantle.work.ProductionServices.preview#ProductionSplit): each line's share, the material already issued staying
    with this work order as WIP, the demand links moved, the operations and the new work order's status (a draft, or released
    at the same method date). Confirm: split#ProductionOrder at the reviewed preview, its operation key made at the first step,
    so a second submit answers the same work orders, then the new work order opens. For planners (PRODUCTION_PLAN); a
    completing backorder also needs PRODUCTION_SUPERVISE. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Split" default-menu-include="false">
    <parameter name="workEffortId"/>
    <parameter name="step"/>
    <parameter name="operationKey"/>
    <parameter name="mode"/>
    <parameter name="quantity"/>
    <parameter name="estimatedCompletionDate"/>
    <parameter name="facilityId"/>
    <parameter name="reason"/>
    <parameter name="complete"/>
    <parameter name="acceptMaterialVariance"/>
    <transition-include name="choices" location="component://mr-boss/template/ManufacturingParts.xml"/>
    <transition name="toStep">
        <actions>
            <set field="step" from="nextStep || 'allocation'"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="confirmSplit">
        <actions>
            <if condition="!recordFound"><return error="true" message="Work order ${workEffortId} is not available"/></if>
            <service-call name="mantle.work.ProductionServices.split#ProductionOrder" out-map="splitOut"
                    in-map="{operationKey:operationKey, workEffortId:workEffortId, expectedRevision:expectedRevision,
                        mode:mode || 'split', quantity:quantity || null, facilityId:facilityId || null,
                        estimatedCompletionDate:estimatedCompletionDate || null, previewKey:previewKey,
                        complete:complete == 'true', acceptMaterialVariance:acceptMaterialVariance == 'true', reason:reason}"/>
            <set field="newWorkEffortId" from="splitOut.result?.newWorkEffortId"/>
            <script>if (!ec.message.hasError()) ec.message.addMessage((splitOut.result?.resultCode == 'BACKORDERED' ? 'Backorder '
                    : 'Split ') + newWorkEffortId + ' made for ' + splitOut.result?.quantity
                    + (splitOut.result?.completed ? '; work order ' + workEffortId + ' completed' : ''), 'success')</script>
        </actions>
        <default-response url="..">
            <parameter name="workEffortId" from="newWorkEffortId"/>
        </default-response>
        <error-response url=".">
            <parameter name="step" value="confirm"/>
        </error-response>
    </transition>
    <actions>
        <set field="step" from="['allocation', 'disposition', 'confirm'].includes(step) ? step : 'allocation'"/>
        <set field="mode" from="mode == 'backorder' ? 'backorder' : 'split'"/>
        <set field="operationKey" from="operationKey || ('split-wo-' + ec.user.randomString(24))"/>
        <set field="canPlan" from="!!manufacturing.capabilities.plan"/>
        <set field="carried" from="{workEffortId:workEffortId, operationKey:operationKey, mode:mode, quantity:quantity || '',
                estimatedCompletionDate:estimatedCompletionDate || '', facilityId:facilityId || '', reason:reason || '',
                complete:complete || '', acceptMaterialVariance:acceptMaterialVariance || ''}"/>
        <set field="stepTitles" from="[{key:'allocation', text:'1. Allocation'}, {key:'disposition', text:'2. Disposition'},
                {key:'confirm', text:'3. Confirm'}]"/>
        <if condition="step != 'allocation' &amp;&amp; (!reason || (mode == 'split' &amp;&amp; !quantity))">
            <set field="step" value="allocation"/>
            <message type="warning">Give the quantity and the reason first.</message>
        </if>
        <if condition="recordFound &amp;&amp; step != 'allocation' &amp;&amp; canPlan">
            <service-call name="mantle.work.ProductionServices.preview#ProductionSplit" out-map="previewOut"
                    transaction="force-new" ignore-error="true"
                    in-map="{workEffortId:workEffortId, mode:mode, quantity:quantity || null, facilityId:facilityId || null,
                        estimatedCompletionDate:estimatedCompletionDate || null, complete:complete == 'true',
                        acceptMaterialVariance:acceptMaterialVariance == 'true', reason:reason || null}"/>
            <set field="previewError" from="ec.message.getErrorsString() || ''"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="split" from="previewOut?.split || null"/>
        <set field="findingText" from="(split?.findings || []).map((row) =&gt; row.message).join(' ')"/>
        <set field="completeText" from="split?.completeCheck ? (split.completeCheck.allowed ? 'Completes work order ' + workEffortId
                + ' in the same step' : split.completeCheck.message) : ''"/>
    </actions>
    <widgets>
        <section name="SplitFound" condition="recordFound &amp;&amp; canPlan">
            <widgets>
                <container style="row q-gutter-sm q-mb-sm">
                    <section-iterate name="StepTitles" list="stepTitles" entry="stepTitle">
                        <widgets>
                            <label text="${stepTitle.text}" type="span"
                                    style="${stepTitle.key == step ? 'text-weight-bold text-primary' : 'm-muted'}"/>
                        </widgets>
                    </section-iterate>
                </container>
                <section name="AllocationStep" condition="step == 'allocation'">
                    <widgets>
                        <container-box>
                            <box-header title="Allocate what is left of work order ${workEffortId}"/>
                            <box-body>
                                <form-single name="Allocation" transition="toStep" map="carried">
                                    <field name="nextStep" from="'disposition'"><default-field><hidden/></default-field></field>
                                    <field name="workEffortId"><default-field><hidden/></default-field></field>
                                    <field name="operationKey"><default-field><hidden/></default-field></field>
                                    <field name="mode">
                                        <default-field title="Kind">
                                            <radio>
                                                <option key="split" text="Split: move part of what is left to a new work order"/>
                                                <option key="backorder" text="Backorder: what is left goes to a linked work order"/>
                                            </radio>
                                        </default-field>
                                    </field>
                                    <field name="quantity">
                                        <default-field title="Quantity" tooltip="Of what is left to produce; all of it for a backorder when empty">
                                            <text-line size="8" input-type="number"/>
                                        </default-field>
                                    </field>
                                    <field name="estimatedCompletionDate">
                                        <default-field title="Due"><date-time/></default-field>
                                    </field>
                                    <field name="facilityId">
                                        <default-field title="Plant or line" tooltip="This work order's when empty">
                                            <drop-down allow-empty="true">
                                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                                        parameter-map="{choice:'runFacilities', selected:facilityId}"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="complete">
                                        <default-field title="Complete">
                                            <check><option key="true" text="Complete this work order with the backorder (a running one)"/></check>
                                        </default-field>
                                    </field>
                                    <field name="acceptMaterialVariance">
                                        <default-field title="Material">
                                            <check><option key="true" text="Accept the material not issued as a variance"/></check>
                                        </default-field>
                                    </field>
                                    <field name="reason"><default-field title="Reason"><text-line required="true"/></default-field></field>
                                    <field name="submit"><default-field title=""><submit text="Next"/></default-field></field>
                                    <field-layout>
                                        <field-ref name="mode"/>
                                        <field-row><field-ref name="quantity"/><field-ref name="estimatedCompletionDate"/></field-row>
                                        <field-row><field-ref name="facilityId"/><field-ref name="reason"/></field-row>
                                        <field-row><field-ref name="complete"/><field-ref name="acceptMaterialVariance"/></field-row>
                                        <field-ref name="submit"/>
                                    </field-layout>
                                </form-single>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
                <section name="PreviewRefused" condition="step != 'allocation' &amp;&amp; !split">
                    <widgets>
                        <container-box type="warning">
                            <box-header title="This split cannot be made"/>
                            <box-body>
                                <label text="${previewError || 'The split is not available.'}" type="p"/>
                                <link url="." text="Back to the allocation" link-type="anchor"
                                        parameter-map="Object.assign({}, carried, {step:'allocation'})"/>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
                <section name="DispositionStep" condition="step == 'disposition' &amp;&amp; split">
                    <widgets>
                        <container-box>
                            <box-header title="What moves: ${split.quantity} of ${split.remaining} left; this work order keeps ${split.sourceTarget}"/>
                            <box-toolbar>
                                <link url="." text="Back" link-type="anchor-button"
                                        parameter-map="Object.assign({}, carried, {step:'allocation'})"/>
                                <link url="." text="Next" link-type="anchor-button" btn-type="primary"
                                        parameter-map="Object.assign({}, carried, {step:'confirm'})"/>
                            </box-toolbar>
                            <box-body>
                                <label text="The new work order: ${split.newStatusText}, method as of ${split.methodDateText}." type="p"
                                        style="text-caption"/>
                                <label text="${findingText}" type="p" style="text-caption text-warning" condition="findingText"/>
                            </box-body>
                            <box-body-nopad>
                                <form-list name="SplitLines" list="split.lineRows" skip-form="true" paginate="false">
                                    <field name="productName"><default-field title="Line"><display/></default-field></field>
                                    <field name="role"><default-field title="Kind"><display/></default-field></field>
                                    <field name="current" align="right"><default-field title="Now"><display/></default-field></field>
                                    <field name="moved" align="right"><default-field title="Moves"><display/></default-field></field>
                                    <field name="keep" align="right"><default-field title="Stays"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="productName"/><field-ref name="role"/></column>
                                        <column><field-ref name="moved"/><field-ref name="keep"/></column>
                                    </columns>
                                </form-list>
                                <form-list name="SplitOperations" list="split.operationRows" skip-form="true" paginate="false">
                                    <field name="workEffortName"><default-field title="Operation"><display/></default-field></field>
                                    <field name="statusText"><default-field title="Status"><display/></default-field></field>
                                    <field name="disposition"><default-field title="Disposition"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="workEffortName"/></column>
                                        <column><field-ref name="disposition"/></column>
                                    </columns>
                                </form-list>
                                <form-list name="SplitDemand" list="split.supplyRows" skip-form="true" paginate="false">
                                    <field name="requirementId"><default-field title="Demand"><display/></default-field></field>
                                    <field name="current" align="right"><default-field title="Covered now"><display/></default-field></field>
                                    <field name="moved" align="right"><default-field title="Moves"><display/></default-field></field>
                                    <field name="keep" align="right"><default-field title="Stays"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="requirementId"/></column>
                                        <column><field-ref name="moved"/></column>
                                    </columns>
                                </form-list>
                            </box-body-nopad>
                        </container-box>
                    </widgets>
                </section>
                <section name="ConfirmStep" condition="step == 'confirm' &amp;&amp; split">
                    <widgets>
                        <container-box>
                            <box-header title="Confirm the ${mode == 'backorder' ? 'backorder' : 'split'} of ${split.quantity}"/>
                            <box-body>
                                <label text="Work order ${workEffortId} keeps ${split.sourceTarget} with its receipts, issues, time and WIP; the new work order takes ${split.quantity} (${split.newStatusText})."
                                        type="p"/>
                                <label text="${completeText}" type="p" style="text-caption" condition="completeText"/>
                                <label text="${findingText}" type="p" style="text-caption text-warning" condition="findingText"/>
                                <form-single name="ConfirmSplit" transition="confirmSplit"
                                        map="Object.assign({}, carried, {expectedRevision:split.revision, previewKey:split.previewKey})">
                                    <field name="workEffortId"><default-field><hidden/></default-field></field>
                                    <field name="operationKey"><default-field><hidden/></default-field></field>
                                    <field name="mode"><default-field><hidden/></default-field></field>
                                    <field name="quantity"><default-field><hidden/></default-field></field>
                                    <field name="estimatedCompletionDate"><default-field><hidden/></default-field></field>
                                    <field name="facilityId"><default-field><hidden/></default-field></field>
                                    <field name="reason"><default-field><hidden/></default-field></field>
                                    <field name="complete"><default-field><hidden/></default-field></field>
                                    <field name="acceptMaterialVariance"><default-field><hidden/></default-field></field>
                                    <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                    <field name="previewKey"><default-field><hidden/></default-field></field>
                                    <field name="submit">
                                        <default-field title="">
                                            <submit text="Confirm ${mode == 'backorder' ? 'backorder' : 'split'}" type="primary"
                                                    confirmation="Move ${split.quantity} of work order ${workEffortId} to a new work order?"/>
                                        </default-field>
                                    </field>
                                </form-single>
                                <link url="." text="Back" link-type="anchor"
                                        parameter-map="Object.assign({}, carried, {step:'disposition'})"/>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
            </widgets>
        </section>
        <section name="NotPlanner" condition="recordFound &amp;&amp; !canPlan">
            <widgets>
                <label text="Splitting a work order is for planners." type="p" style="m-muted"/>
            </widgets>
        </section>
    </widgets>
</screen>
