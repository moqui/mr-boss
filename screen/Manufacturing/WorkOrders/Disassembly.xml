<!-- Disassembly (design-manufacturing §3 Disassembly; style-guide §3.6 Task; impl-manufacturing P9, F29–F32): the reversal of a
    supported pick assembly only, never a general unbuild of produced output. Assembly: a pick assembly kit on hand in the
    user's facilities, the quantity (what is on hand by default) and the reason. Preview
    (mantle.work.ProductionServices.preview#SupportedAssemblyReversal): its pick assembly, each component issue to cancel,
    newest first, by the slices the kits were costed at, with lot and status (and their value with financial read), or why
    it is refused: not a kit, already sold, held, counted, a closed period, a changed method, slices of another cost, or
    Accounting's forward repost flag that is off for the kit's owner. Confirm: reverse#SupportedAssembly at that preview, with
    an explicit warning; the reversing entries are dated now and the posted history stays. For supervisors
    (PRODUCTION_SUPERVISE), after the asset's record check. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Disassembly" default-menu-include="false">
    <parameter name="assetId"/>
    <parameter name="quantity"/>
    <parameter name="reason"/>
    <parameter name="operationKey"/>
    <transition-include name="choices" location="component://mr-boss/template/ManufacturingParts.xml"/>
    <transition name="reverseKit">
        <actions>
            <service-call name="ironstone.manufacturing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'asset', recordId:assetId, capability:'supervise'}"/>
            <service-call name="mantle.work.ProductionServices.reverse#SupportedAssembly" out-map="reversed"
                    in-map="{operationKey:operationKey, assetId:assetId, quantity:quantity || null, previewKey:previewKey,
                        reason:reason}"/>
            <script>if (!ec.message.hasError()) ec.message.addMessage('Kit ' + assetId + ': ' + reversed.result?.quantity
                    + ' reversed; its components are back in stock and the reversing entries are dated now', 'success')</script>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <actions>
        <set field="canReverse" from="!!manufacturing.capabilities.supervise"/>
        <set field="operationKey" from="operationKey || ('kit-reverse-' + ec.user.randomString(24))"/>
        <if condition="assetId &amp;&amp; canReverse">
            <service-call name="ironstone.manufacturing.AccessServices.check#Record" out-map="kitCheck" transaction="force-new"
                    ignore-error="true" in-map="{appRoot:appRoot, recordType:'asset', recordId:assetId}"/>
            <if condition="kitCheck?.recordId">
                <service-call name="mantle.work.ProductionServices.preview#SupportedAssemblyReversal" out-map="previewOut"
                        transaction="force-new" ignore-error="true" in-map="{assetId:assetId, quantity:quantity || null}"/>
                <set field="previewError" from="ec.message.getErrorsString() || ''"/>
                <script>ec.message.clearErrors()</script>
            </if>
            <set field="previewError" from="kitCheck?.recordId ? previewError : 'Asset ' + assetId + ' is not available'"/>
        </if>
        <set field="reversal" from="previewOut?.reversal || null"/>
    </actions>
    <widgets>
        <container style="m-record-header">
            <container style="col-12 m-record-title">
                <label text="Disassembly" type="h5" style="q-my-none"/>
                <label text="Reverses a pick assembly kit that is still on hand into its components, at the cost it was assembled at. General unbuild of produced output is not done here."
                        type="div" style="text-caption m-muted"/>
            </container>
        </container>
        <label text="Disassembly is for production supervisors." type="p" style="m-muted" condition="!canReverse"/>
        <section name="AssemblyStep" condition="canReverse">
            <widgets>
                <container-box>
                    <box-header title="Assembly"/>
                    <box-body>
                        <form-single name="Assembly" transition=".">
                            <field name="operationKey" from="operationKey"><default-field><hidden/></default-field></field>
                            <field name="assetId" from="assetId || null">
                                <default-field title="Kit" tooltip="A pick assembly kit on hand">
                                    <drop-down allow-empty="false">
                                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                                parameter-map="{choice:'kitAssets', selected:assetId}"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="quantity" from="quantity || null">
                                <default-field title="Quantity" tooltip="What is on hand when empty">
                                    <text-line size="8" input-type="number"/>
                                </default-field>
                            </field>
                            <field name="reason" from="reason || null">
                                <default-field title="Reason"><text-line/></default-field>
                            </field>
                            <field name="submit"><default-field title=""><submit text="Preview"/></default-field></field>
                            <field-layout>
                                <field-row><field-ref name="assetId"/><field-ref name="quantity"/></field-row>
                                <field-row><field-ref name="reason"/><field-ref name="submit"/></field-row>
                            </field-layout>
                        </form-single>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="PreviewRefused" condition="canReverse &amp;&amp; assetId &amp;&amp; !reversal">
            <widgets>
                <container-box type="warning">
                    <box-header title="This kit cannot be reversed"/>
                    <box-body><label text="${previewError || 'The kit is not available.'}" type="p"/></box-body>
                </container-box>
            </widgets>
        </section>
        <section name="PreviewStep" condition="canReverse &amp;&amp; reversal">
            <widgets>
                <container-box>
                    <box-header title="Preview: ${reversal.quantity} of ${reversal.productName} from ${reversal.workEffortName}"/>
                    <box-toolbar>
                        <container-dialog id="ConfirmReversal" button-text="Reverse the kit" type="primary" icon="sym_o_undo"
                                width="560" title="Reverse ${reversal.quantity} of kit ${reversal.assetId}">
                            <label text="The kit leaves stock and each component issue below is cancelled, newest first. Accounting posts the reversing entries dated now; the original postings stay."
                                    type="p" style="text-caption text-warning"/>
                            <form-single name="ConfirmReversalForm" transition="reverseKit"
                                    map="{assetId:reversal.assetId, quantity:reversal.quantity, previewKey:reversal.previewKey,
                                        operationKey:operationKey, reason:reason || ''}">
                                <field name="assetId"><default-field><hidden/></default-field></field>
                                <field name="quantity"><default-field><hidden/></default-field></field>
                                <field name="previewKey"><default-field><hidden/></default-field></field>
                                <field name="operationKey"><default-field><hidden/></default-field></field>
                                <field name="reason"><default-field title="Reason"><text-line required="true"/></default-field></field>
                                <field name="submit">
                                    <default-field title="">
                                        <submit text="Reverse the kit" type="danger"
                                                confirmation="Reverse ${reversal.quantity} of kit ${reversal.assetId} into its components?"/>
                                    </default-field>
                                </field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body>
                        <label text="On hand ${reversal.onHand} of ${reversal.kitsReceived} received" type="p" style="text-caption"/>
                        <label text="Kit value ${reversal.kitValue}, components ${reversal.sliceValue}" type="p" style="text-caption"
                                condition="reversal.kitValue"/>
                    </box-body>
                    <box-body-nopad>
                        <form-list name="ReversalComponents" list="reversal.componentRows" skip-form="true" paginate="false">
                            <field name="productName"><default-field title="Component"><display/></default-field></field>
                            <field name="assetIssuanceId"><default-field title="Issue"><display/></default-field></field>
                            <field name="assetId"><default-field title="Stock"><display/></default-field></field>
                            <field name="lotId"><default-field title="Lot"><display/></default-field></field>
                            <field name="statusId">
                                <default-field title="Status">
                                    <display-entity entity-name="moqui.basic.StatusItem" text="${description}"/>
                                </default-field>
                            </field>
                            <field name="issued" align="right"><default-field title="Issued"><display/></default-field></field>
                            <field name="quantity" align="right"><default-field title="Returned"><display/></default-field></field>
                            <field name="value" align="right"><default-field title="Value"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="productName"/><field-ref name="assetIssuanceId"/></column>
                                <column><field-ref name="quantity"/><field-ref name="statusId"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
