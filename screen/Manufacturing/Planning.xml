<!-- The Planning area of IronStone Manufacturing (design-manufacturing §1.2, §7), for the planner, scheduler and supervisor
    groups only (BOSS_MFG_PLANNING): the shared SupplyPlanning with the Manufacturing context (impl-manufacturing P13, the
    default), and P12's ProductionSchedule (with its terminal twin ProductionScheduleTui and the plan snapshot ScheduleSnapshot,
    hidden from the menu) and Capacity, the files of Planning/; InventoryAvailability comes with P5b. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Planning" default-menu-index="8" menu-image="sym_o_view_timeline" menu-image-type="icon">
    <subscreens default-item="SupplyPlanning" always-use-full-path="true">
        <subscreens-item name="SupplyPlanning" location="component://mr-boss/screen/Shared/SupplyPlanning.xml"
                menu-title="Supply planning" menu-index="1"/>
    </subscreens>
    <widgets>
        <subscreens-menu id="ManufacturingPlanningTabs" type="tab"/>
        <subscreens-active/>
    </widgets>
</screen>
