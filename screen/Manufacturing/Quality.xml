<!-- The Quality area of IronStone Manufacturing (design-manufacturing §1.2, §6), for the quality inspector, verifier and
    administrator groups and the supervisor only (BOSS_MFG_QUALITY): Inspections (impl-manufacturing P8, the default),
    Templates (Warehouse's shared InspectionTemplates with the Manufacturing context) and ScrapLoss (P7); hidden from the
    menu, the shared QualityInspection with the Manufacturing context, InspectionStation (its operator mode at handheld
    density) and the quality checklist and certificate prints (P8). Each is a file of Quality/ or a subscreens-item here. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Quality" default-menu-index="7" menu-image="sym_o_verified" menu-image-type="icon">
    <subscreens default-item="Inspections" always-use-full-path="true">
        <!-- P8: Warehouse's shared inspection and templates with the Manufacturing context -->
        <subscreens-item name="InspectionTemplates" location="component://mr-boss/screen/Shared/InspectionTemplates.xml"
                menu-title="Templates" menu-index="2"/>
        <subscreens-item name="QualityInspection" location="component://mr-boss/screen/Shared/QualityInspection.xml"
                menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-menu id="ManufacturingQualityTabs" type="tab"/>
        <subscreens-active/>
    </widgets>
</screen>
