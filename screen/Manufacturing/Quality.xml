<!-- The Quality area of IronStone Manufacturing (design-manufacturing §1.2, §6), for the quality inspector, verifier and
    administrator groups and the supervisor only (BOSS_MFG_QUALITY): ScrapLoss (impl-manufacturing P7, the default for now);
    Inspections, the shared InspectionTemplates and Downtime come with P8 and P11, each a file of Quality/ or a
    subscreens-item here. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Quality" default-menu-index="7" menu-image="sym_o_verified" menu-image-type="icon">
    <subscreens default-item="ScrapLoss" always-use-full-path="true"/>
    <widgets>
        <subscreens-menu id="ManufacturingQualityTabs" type="tab"/>
        <subscreens-active/>
    </widgets>
</screen>
