<!-- ProductionTime (design-manufacturing §3 ProductionTime; impl-manufacturing P10, F33-F35, F44): the Projects person time of a
    work order and its operations, through the production time path (mantle.work.ProductionServices.get#ProductionTime), since
    Projects' own time screens leave a run's operations out (F38, F44): each entry's person, operation, work type, from,
    through, hours, pieces, its week's state and whether its labor cost is recorded; and each week of that time with Submit (its
    person), Approve and Reopen (its approvers: the work order's supervisor as its Manager under the organization's timesheet
    policy, F33), which are Projects' mantle.work.TimesheetServices submit#, approve# and reopen#Timesheet. An approval writes
    the labor cost events and a reopen their reversal under the plant's production policy (laborCostSync). The user's timer
    stops here too. Each action checks the work order through ironstone.manufacturing.AccessServices.check#Record first. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Production time" default-menu-include="false">
    <parameter name="workEffortId" required="true"/>
    <always-actions>
        <service-call name="ironstone.manufacturing.AccessServices.check#Record" out-map="runCheck" transaction="force-new"
                ignore-error="true" in-map="{appRoot:appRoot, recordType:'run', recordId:workEffortId || '_NA_'}"/>
        <set field="recordFound" from="!!runCheck?.recordId"/>
    </always-actions>
    <transition name="stopTimer">
        <actions>
            <service-call name="ironstone.manufacturing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'run', recordId:workEffortId}"/>
            <service-call name="mantle.work.TimesheetServices.stop#Timer" out-map="stopped" in-map="{timeEntryId:timeEntryId}"/>
            <script>if (!ec.message.hasError()) ec.message.addMessage(stopped.message, 'success')</script>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."><parameter name="workEffortId"/></error-response>
    </transition>
    <transition name="submitWeek">
        <actions>
            <service-call name="ironstone.manufacturing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'run', recordId:workEffortId}"/>
            <service-call name="mantle.work.TimesheetServices.submit#Timesheet" out-map="submitted" in-map="{timesheetId:timesheetId}"/>
            <script>if (!ec.message.hasError()) ec.message.addMessage(submitted.message, 'success')</script>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."><parameter name="workEffortId"/></error-response>
    </transition>
    <transition name="approveWeek">
        <actions>
            <service-call name="ironstone.manufacturing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'run', recordId:workEffortId, capability:'supervise'}"/>
            <service-call name="mantle.work.TimesheetServices.approve#Timesheet" out-map="approved" in-map="{timesheetId:timesheetId}"/>
            <script>if (!ec.message.hasError()) ec.message.addMessage(approved.message, 'success')</script>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."><parameter name="workEffortId"/></error-response>
    </transition>
    <transition name="reopenWeek">
        <actions>
            <service-call name="ironstone.manufacturing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'run', recordId:workEffortId, capability:'supervise'}"/>
            <service-call name="mantle.work.TimesheetServices.reopen#Timesheet" out-map="reopened"
                    in-map="{timesheetId:timesheetId, reason:reason || null}"/>
            <script>if (!ec.message.hasError()) ec.message.addMessage(reopened.message, 'success')</script>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."><parameter name="workEffortId"/></error-response>
    </transition>
    <actions>
        <if condition="recordFound">
            <service-call name="mantle.work.ProductionServices.get#ProductionTime" out-map="timeFound" transaction="force-new"
                    ignore-error="true" in-map="{workEffortId:workEffortId}"/>
        </if>
        <set field="recordFound" from="recordFound &amp;&amp; !!timeFound?.productionTime"/>
        <set field="time" from="timeFound?.productionTime || {}"/>
        <set field="timeRows" from="time.timeRows || []"/>
        <set field="weekRows" from="(time.timesheetRows || []).map((row) =&gt; Object.assign({}, row, {workEffortId: workEffortId,
                stateColor: {TmshApproved:'positive', TmshCompleted:'warning', TmshInProcess:'grey-8'}[row.statusId] || 'grey'}))"/>
        <set field="timer" from="time.timer || null"/>
        <set field="stopValues" from="{workEffortId:workEffortId, timeEntryId:timer?.timeEntryId}"/>
        <set field="runParameters" from="{workEffortId:workEffortId}"/>
    </actions>
    <widgets>
        <section name="TimeNotFound" condition="!recordFound">
            <widgets>
                <container-box type="warning">
                    <box-header title="Not available"/>
                    <box-body>
                        <label text="Work order ${workEffortId} is not available to you." type="p"/>
                        <link url="../Station" text="Back to the station" icon="sym_o_arrow_back"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="TimeFound" condition="recordFound">
            <widgets>
                <context record-entity="mantle.work.effort.WorkEffort" record-id="${workEffortId}"
                        title="Production time · ${time.runName}"/>
                <container style="row items-center q-col-gutter-x-md q-mb-sm">
                    <container style="col-12 col-md">
                        <label text="Production time: ${time.runName}" type="h5"/>
                        <label text="Work order ${workEffortId} · ${time.totalHours} h on it and its operations" type="p"
                                style="text-caption m-muted"/>
                    </container>
                    <container style="col-12 col-md-auto q-gutter-x-sm">
                        <section name="StopMyTimer" condition="timer">
                            <widgets>
                                <form-single name="StopTimerForm" transition="stopTimer" map="stopValues">
                                    <field name="workEffortId"><default-field><hidden/></default-field></field>
                                    <field name="timeEntryId"><default-field><hidden/></default-field></field>
                                    <field name="submit"><default-field title=""><submit text="Stop my timer"
                                            type="default" icon="sym_o_stop"/></default-field></field>
                                </form-single>
                            </widgets>
                        </section>
                        <link url="../../WorkOrders/WorkOrderDetail" text="Work order" icon="sym_o_precision_manufacturing"
                                parameter-map="runParameters"/>
                    </container>
                </container>
                <container-box>
                    <box-header title="Weeks"/>
                    <box-body-nopad>
                        <label text="No time is recorded on this work order yet." type="p" style="m-muted q-pa-sm"
                                condition="!weekRows.length"/>
                        <form-list name="WeekList" list="weekRows" skip-form="true" paginate="false">
                            <field name="personName"><default-field title="Person"><display/></default-field></field>
                            <field name="weekText"><default-field title="Week"><display/></default-field></field>
                            <field name="statusText">
                                <default-field title="State">
                                    <render-mode>
                                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${WebUtilities.encodeHtml(statusText)}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: statusText})}]]></text>
                                        <text type="html">${statusText}</text>
                                    </render-mode>
                                </default-field>
                            </field>
                            <field name="actions">
                                <default-field title="">
                                    <container-dialog id="SubmitWeek_${timesheetId}" condition="canSubmit" type="default"
                                            button-text="Submit" icon="sym_o_send" title="Submit the week ${weekText}" width="480">
                                        <form-single name="SubmitWeekForm" transition="submitWeek">
                                            <field name="workEffortId"><default-field><hidden/></default-field></field>
                                            <field name="timesheetId"><default-field><hidden/></default-field></field>
                                            <field name="submit"><default-field title=""><submit text="Submit for approval"/></default-field></field>
                                        </form-single>
                                    </container-dialog>
                                    <container-dialog id="ApproveWeek_${timesheetId}" condition="canApprove" type="primary"
                                            button-text="Approve" icon="sym_o_check" title="Approve the week of ${personName}" width="480">
                                        <label text="Approving the week records the labor cost of its production time." type="p"
                                                style="text-caption"/>
                                        <form-single name="ApproveWeekForm" transition="approveWeek">
                                            <field name="workEffortId"><default-field><hidden/></default-field></field>
                                            <field name="timesheetId"><default-field><hidden/></default-field></field>
                                            <field name="submit"><default-field title=""><submit text="Approve"
                                                    confirmation="Approve the week ${weekText} of ${personName}?"/></default-field></field>
                                        </form-single>
                                    </container-dialog>
                                    <container-dialog id="ReopenWeek_${timesheetId}" condition="canReopen" type="danger"
                                            button-text="Reopen" icon="sym_o_undo" title="Reopen the week of ${personName}" width="480">
                                        <label text="Reopening the week reverses the labor cost recorded at its approval." type="p"
                                                style="text-caption"/>
                                        <form-single name="ReopenWeekForm" transition="reopenWeek">
                                            <field name="workEffortId"><default-field><hidden/></default-field></field>
                                            <field name="timesheetId"><default-field><hidden/></default-field></field>
                                            <field name="reason"><default-field title="Reason"><text-line/></default-field></field>
                                            <field name="submit"><default-field title=""><submit text="Reopen" type="danger"
                                                    confirmation="Reopen the week ${weekText} of ${personName}?"/></default-field></field>
                                        </form-single>
                                    </container-dialog>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="personName"/><field-ref name="weekText"/></column>
                                <column><field-ref name="statusText"/><field-ref name="actions"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
                <container-box>
                    <box-header title="Time entries"/>
                    <box-body-nopad>
                        <form-list name="TimeList" list="timeRows" skip-form="true" paginate="false">
                            <field name="personName"><default-field title="Person"><display/></default-field></field>
                            <field name="operationName"><default-field title="Operation"><display/></default-field></field>
                            <field name="workTypeText"><default-field title="Work type"><display/></default-field></field>
                            <field name="fromText"><default-field title="From"><display/></default-field></field>
                            <field name="thruText"><default-field title="Through"><display/></default-field></field>
                            <field name="hours"><default-field title="Hours"><display align="right"/></default-field></field>
                            <field name="pieceCount"><default-field title="Pieces"><display align="right"/></default-field></field>
                            <field name="timesheetText"><default-field title="Week"><display/></default-field></field>
                            <field name="laborText"><default-field title="Labor cost"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="personName"/><field-ref name="operationName"/></column>
                                <column><field-ref name="hours"/><field-ref name="timesheetText"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
