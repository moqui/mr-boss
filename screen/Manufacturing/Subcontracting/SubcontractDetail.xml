<!-- SubcontractDetail (design-manufacturing §7 SubcontractDetail; style-guide §3.3 Detail): the outside processing of one
    operation of a work order of the user's organizations, by the operation (workEffortId). The header: the operation, its work
    order, supplier and service, and its state; its primary action Request outside processing (none asked yet, the planner)
    or Edit agreement (the planner before the purchase order, and the buyer's price basis); More: the dispatch and return
    instructions, the work order, the supplier, the purchase order and Supply planning, where the buyer converts the request.
    Agreement (store#ProductionSubcontract), Materials (get#SubcontractMaterials: components sent, at the supplier, consumed and
    returned, the organization's throughout, and the dispatches) and Acceptance (get#SubcontractStatus: the service purchase
    lines with accepted, billed and remaining, the price only for a buyer or price reader, the output received with its
    inspection hold, match exceptions and the outside-processing cost events, their amounts with financial read). Dispatch,
    return and the output receipt are Warehouse's (SubcontractShipmentDetail); placing the order is Purchasing's. An operation
    outside the user's organizations is "not available". -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Outside processing" default-menu-include="false">
    <parameter name="workEffortId" required="true"/>
    <always-actions>
        <service-call name="ironstone.manufacturing.AccessServices.check#Record" out-map="operationCheck"
                transaction="force-new" ignore-error="true"
                in-map="{appRoot:appRoot, recordType:'operation', recordId:workEffortId}"/>
        <set field="recordFound" from="!!operationCheck?.recordId"/>
    </always-actions>
    <transition-include name="choices" location="component://mr-boss/template/ManufacturingParts.xml"/>
    <transition-include name="requestService" location="component://mr-boss/template/ManufacturingSubcontractParts.xml"/>
    <transition-include name="storeSubcontract" location="component://mr-boss/template/ManufacturingSubcontractParts.xml"/>
    <actions>
        <if condition="recordFound">
            <service-call name="mantle.work.ProductionServices.get#SubcontractStatus" out-map="status"
                    transaction="force-new" ignore-error="true" in-map="{operationWorkEffortId:workEffortId}"/>
            <service-call name="mantle.work.ProductionServices.get#SubcontractMaterials" out-map="materialsFound"
                    transaction="force-new" ignore-error="true" in-map="{operationWorkEffortId:workEffortId}"/>
        </if>
        <set field="recordFound" from="recordFound &amp;&amp; !!status?.run"/>
        <set field="subcontract" from="status?.subcontract || null"/>
        <set field="serviceLines" from="status?.serviceLines || []"/>
        <set field="outputReceipts" from="status?.output?.receipts || []"/>
        <set field="costEvents" from="status?.costEvents || []"/>
        <set field="materials" from="materialsFound?.materials || []"/>
        <set field="shipments" from="materialsFound?.shipments || []"/>
        <set field="priceRead" from="!!status?.priceRead"/>
        <set field="financialRead" from="!!status?.financialRead"/>
        <set field="canRequest" from="!!status?.canRequest &amp;&amp; !!manufacturing.capabilities.plan"/>
        <set field="canEdit" from="!!status?.canEdit"/>
        <set field="firstLine" from="serviceLines.find((line) =&gt; !line.cancelled) || serviceLines[0] || null"/>
        <set field="supplierPartyId" from="firstLine?.supplierPartyId || subcontract?.supplierPartyId || null"/>
        <set field="supplierName" from="firstLine?.supplierName || subcontract?.supplierName || ''"/>
        <set field="lineRows" from="serviceLines.map((line) =&gt; Object.assign({}, line, {
                exceptionText: line.matchExceptions.map((row) =&gt; row.exceptionText).join('; '),
                acceptedText: line.acceptances.map((row) =&gt; row.acceptedQuantity + ' on ' + row.acceptedDateText).join(', ')}))"/>
        <set field="agreementRows" from="subcontract ? [['Supplier', subcontract.supplierName || 'Not chosen yet'],
                ['Service', subcontract.productName + ' · ' + subcontract.quantity + ' ' + subcontract.uomText],
                ['Required by', subcontract.requiredByText], ['Lead time', subcontract.leadTimeDays ? subcontract.leadTimeDays + ' days' : ''],
                ['Components go to', subcontract.vendorFacilityName ? subcontract.vendorFacilityName + ' (still owned by '
                    + status.run.organizationName + ')' : ''],
                ['Price basis', priceRead ? subcontract.priceBasisNote || '' : ''],
                ['Requirement', subcontract.requirementId ? subcontract.requirementId + ' · ' + subcontract.requirementStatusText : ''],
                ['Purchase order', subcontract.orderId ? subcontract.orderId + ':' + subcontract.orderItemSeqId : 'Not converted yet'],
                ['Note', subcontract.changeReason || '']].filter((pair) =&gt; pair[1]).map((pair) =&gt; ({label: pair[0], value: pair[1]}))
                : []"/>
        <set field="operationKey" from="'subcontract-' + ec.user.randomString(24)"/>
        <set field="requestValues" from="{operationWorkEffortId:workEffortId, quantity:status?.output?.quantity || null,
                supplierPartyId:supplierPartyId}"/>
        <set field="agreementValues" from="subcontract ? {productionSubcontractId:subcontract.productionSubcontractId,
                expectedRevision:subcontract.revision, supplierPartyId:subcontract.supplierPartyId, quantity:subcontract.quantity,
                requiredByDate:subcontract.requiredByDate, leadTimeDays:subcontract.leadTimeDays,
                vendorFacilityId:subcontract.vendorFacilityId, priceBasisNote:priceRead ? subcontract.priceBasisNote : null,
                canEditAgreement:status.canEditAgreement ? 'Y' : 'N', canEditPrice:status.canEditPrice ? 'Y' : 'N'} : {}"/>
        <set field="printDispatch" from="{workEffortId:workEffortId, kind:'dispatch', renderMode:'html-print', lastStandalone:'true'}"/>
        <set field="printReturn" from="{workEffortId:workEffortId, kind:'return', renderMode:'html-print', lastStandalone:'true'}"/>
    </actions>
    <widgets>
        <section name="SubcontractNotFound" condition="!recordFound">
            <widgets>
                <container-box type="warning">
                    <box-header title="Not available"/>
                    <box-body>
                        <label text="Operation ${workEffortId} is not available: it does not exist or it is not an operation of your organizations' work orders."
                                type="p"/>
                        <link url="../SubcontractOperations" text="Back to outside processing" link-type="anchor"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="SubcontractFound" condition="recordFound">
            <widgets>
                <context record-entity="mantle.work.effort.WorkEffort" record-id="${workEffortId}"
                        title="Outside processing · ${status.operation.workEffortName}"/>
                <container style="m-record-header">
                    <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                        <container style="col-12 col-md m-record-title">
                            <container style="row items-center q-gutter-x-sm">
                                <label text="${workEffortId}" type="span" style="m-key-chip text-mono"/>
                                <label text="${status.operation.workEffortName}" type="h5" style="q-my-none"/>
                            </container>
                            <label text="${['Work order ' + status.run.workEffortId + ' ' + status.run.workEffortName, status.run.facilityName,
                                supplierName ? 'by ' + supplierName : '', subcontract ? subcontract.productName : ''].filter(Boolean).join(' · ')}"
                                    type="div" style="text-caption m-muted"/>
                            <label text="Ordered ${status.orderedQuantity} · accepted ${status.acceptedQuantity} · output received ${status.output.receivedQuantity} of ${status.output.quantity || '0'} · ${status.dispatchCount} dispatches"
                                    type="div" style="text-caption m-muted"/>
                        </container>
                        <container style="col-12 col-md-auto m-record-status">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip square class="q-ma-none m-tonal text-${status.stateColor}">${
                                    WebUtilities.encodeHtml(status.stateText)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong", text: status.stateText})}]]></text>
                                <text type="html">${status.stateText}</text>
                            </render-mode>
                        </container>
                    </container>
                    <container style="row items-center q-col-gutter-x-md q-col-gutter-y-sm m-record-foot">
                        <container style="col-12 row items-center q-gutter-x-xs q-gutter-y-xs m-record-actions">
                            <container-dialog id="RequestOutsideProcessing" button-text="Request outside processing" type="primary"
                                    icon="sym_o_add" width="760" title="Ask for ${status.operation.workEffortName} to be done by a supplier"
                                    condition="canRequest">
                                <form-single name="RequestService" transition="requestService" map="requestValues">
                                    <field name="operationKey" from="operationKey"><default-field><hidden/></default-field></field>
                                    <field name="operationWorkEffortId"><default-field><hidden/></default-field></field>
                                    <field name="productId">
                                        <default-field title="Service">
                                            <drop-down required-manual-select="true">
                                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                                        parameter-map="{choice:'serviceProducts'}"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="quantity">
                                        <default-field title="Quantity"><text-line size="8" input-type="number"/></default-field>
                                    </field>
                                    <field name="supplierPartyId">
                                        <default-field title="Supplier">
                                            <drop-down allow-empty="true">
                                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                                        parameter-map="{choice:'suppliers', selected:supplierPartyId}"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="vendorFacilityId">
                                        <default-field title="Components go to">
                                            <drop-down allow-empty="true">
                                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                                        parameter-map="{choice:'vendorFacilities'}"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="requiredByDate">
                                        <default-field title="Required by"><date-time type="timestamp"/></default-field>
                                    </field>
                                    <field name="leadTimeDays">
                                        <default-field title="Lead time in days"><text-line size="6" input-type="number"/></default-field>
                                    </field>
                                    <field name="submit">
                                        <default-field title=""><submit text="Request outside processing"/></default-field>
                                    </field>
                                    <field-layout>
                                        <field-row>
                                            <field-ref name="productId"/>
                                            <field-ref name="quantity"/>
                                        </field-row>
                                        <field-row>
                                            <field-ref name="supplierPartyId"/>
                                            <field-ref name="vendorFacilityId"/>
                                        </field-row>
                                        <field-row>
                                            <field-ref name="requiredByDate"/>
                                            <field-ref name="leadTimeDays"/>
                                        </field-row>
                                        <field-ref name="submit"/>
                                    </field-layout>
                                </form-single>
                            </container-dialog>
                            <container-dialog id="EditAgreement" button-text="Edit agreement" type="primary" icon="sym_o_edit"
                                    width="760" title="Outside processing agreement of ${status.operation.workEffortName}"
                                    condition="canEdit &amp;&amp; !canRequest">
                                <form-single name="SubcontractAgreement" transition="storeSubcontract" map="agreementValues">
                                    <field name="operationKey" from="operationKey"><default-field><hidden/></default-field></field>
                                    <field name="workEffortId" from="workEffortId"><default-field><hidden/></default-field></field>
                                    <field name="productionSubcontractId"><default-field><hidden/></default-field></field>
                                    <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                    <field name="canEditAgreement"><default-field><hidden/></default-field></field>
                                    <field name="canEditPrice"><default-field><hidden/></default-field></field>
                                    <field name="supplierPartyId" hide="!status.canEditAgreement">
                                        <default-field title="Supplier">
                                            <drop-down allow-empty="true">
                                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                                        parameter-map="{choice:'suppliers', selected:subcontract.supplierPartyId}"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="quantity" hide="!status.canEditAgreement">
                                        <default-field title="Quantity"><text-line size="8" input-type="number"/></default-field>
                                    </field>
                                    <field name="requiredByDate" hide="!status.canEditAgreement">
                                        <default-field title="Required by"><date-time type="timestamp"/></default-field>
                                    </field>
                                    <field name="leadTimeDays">
                                        <default-field title="Lead time in days"><text-line size="6" input-type="number"/></default-field>
                                    </field>
                                    <field name="vendorFacilityId">
                                        <default-field title="Components go to">
                                            <drop-down allow-empty="true">
                                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                                        parameter-map="{choice:'vendorFacilities', selected:subcontract.vendorFacilityId,
                                                            supplierPartyId:subcontract.supplierPartyId}"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="priceBasisNote" hide="!status.canEditPrice">
                                        <default-field title="Price basis" tooltip="Per piece, per batch or the quote it rests on">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="changeReason">
                                        <default-field title="Reason"><text-line/></default-field>
                                    </field>
                                    <field name="submit">
                                        <default-field title=""><submit text="Save agreement"/></default-field>
                                    </field>
                                </form-single>
                            </container-dialog>
                            <button-menu text="More" icon="more_horiz">
                                <link url="../SubcontractInstructions" text="Print dispatch instructions" icon="sym_o_print"
                                        target-window="_blank" parameter-map="printDispatch"/>
                                <link url="../SubcontractInstructions" text="Print return instructions" icon="sym_o_print"
                                        target-window="_blank" parameter-map="printReturn"/>
                                <link url="${sharedLinks['WorkOrders/WorkOrderDetail']}" text="Work order" icon="sym_o_precision_manufacturing"
                                        parameter-map="{workEffortId:status.run.workEffortId}"/>
                                <link url="../Supplier360" text="Supplier" icon="sym_o_storefront"
                                        parameter-map="{vendorPartyId:supplierPartyId}" condition="supplierPartyId"/>
                                <link url="../OrderDetail" text="Purchase order" icon="sym_o_receipt_long"
                                        parameter-map="{orderId:firstLine.orderId}" condition="firstLine"/>
                                <link url="${sharedLinks['Planning/SupplyPlanning']}" text="Supply planning" icon="sym_o_view_timeline"
                                        parameter-map="{plantId:status.run.facilityId, methodEnumId:'PsmOutside'}"
                                        condition="subcontract &amp;&amp; !subcontract.ordered"/>
                            </button-menu>
                        </container>
                    </container>
                </container>
                <container-row>
                    <row-col md="5">
                        <container-box>
                            <box-header title="Agreement"/>
                            <box-body-nopad>
                                <form-list name="AgreementDetails" list="agreementRows" skip-form="true" skip-header="true"
                                        paginate="false">
                                    <field name="label"><default-field><label text="${label}" type="span" style="m-muted text-no-wrap"/></default-field></field>
                                    <field name="value"><default-field><display/></default-field></field>
                                </form-list>
                                <label text="No outside processing has been asked for this operation yet${canRequest ? '. Ask for it with Request outside processing.' : '.'}"
                                        type="p" style="q-pa-md m-muted" condition="!subcontract"/>
                            </box-body-nopad>
                        </container-box>
                    </row-col>
                    <row-col md="7">
                        <container-box>
                            <box-header title="Materials"/>
                            <box-body-nopad>
                                <label text="${materialsFound?.vendorFacilityName ? 'At ' + materialsFound.vendorFacilityName + ', in the custody of ' + materialsFound.custodianName + '; the components are still owned by ' + status.run.organizationName + '.' : 'No vendor-custody facility is chosen yet.'}"
                                        type="p" style="q-pa-sm q-mb-none text-caption m-muted"/>
                                <form-list name="SubcontractMaterials" list="materials" skip-form="true" paginate="false">
                                    <field name="productName"><default-field title="Component"><display/></default-field></field>
                                    <field name="ownerName"><default-field title="Owner"><display/></default-field></field>
                                    <field name="quantity" align="right">
                                        <default-field title="Needed"><display text="${quantity} ${uomText}"/></default-field>
                                    </field>
                                    <field name="sentQuantity" align="right">
                                        <default-field title="Sent"><display format="#,##0.###"/></default-field>
                                    </field>
                                    <field name="atVendorQuantity" align="right">
                                        <default-field title="At the supplier"><display format="#,##0.###"/></default-field>
                                    </field>
                                    <field name="consumedQuantity" align="right">
                                        <default-field title="Consumed"><display format="#,##0.###"/></default-field>
                                    </field>
                                    <field name="returnedQuantity" align="right">
                                        <default-field title="Returned"><display format="#,##0.###"/></default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column><field-ref name="productName"/><field-ref name="ownerName"/></column>
                                        <column><field-ref name="sentQuantity"/><field-ref name="atVendorQuantity"/></column>
                                    </columns>
                                </form-list>
                                <label text="This operation has no components." type="p" style="q-pa-md m-muted"
                                        condition="!materials.length"/>
                                <section name="DispatchSection" condition="shipments.length">
                                    <widgets>
                                        <form-list name="SubcontractShipments" list="shipments" skip-form="true" paginate="false">
                                            <field name="shipmentId">
                                                <default-field title="Shipment">
                                                    <link url="../ShipmentDetail" text="${shipmentId}" link-type="anchor"
                                                            parameter-map="{shipmentId:shipmentId}"/>
                                                </default-field>
                                            </field>
                                            <field name="directionText"><default-field title="Direction"><display/></default-field></field>
                                            <field name="lineText"><default-field title="Lines"><display/></default-field></field>
                                            <field name="statusText"><default-field title="Status"><display/></default-field></field>
                                            <field name="dateText"><default-field title="Date"><display/></default-field></field>
                                            <columns type="mobile">
                                                <column><field-ref name="shipmentId"/><field-ref name="directionText"/></column>
                                                <column><field-ref name="statusText"/><field-ref name="dateText"/></column>
                                            </columns>
                                        </form-list>
                                    </widgets>
                                </section>
                            </box-body-nopad>
                        </container-box>
                    </row-col>
                </container-row>
                <container-box>
                    <box-header title="Acceptance"/>
                    <box-body-nopad>
                        <form-list name="SubcontractServiceLines" list="lineRows" skip-form="true" paginate="false">
                            <field name="orderId">
                                <default-field title="Purchase order">
                                    <link url="../OrderDetail" text="${orderId}:${orderItemSeqId}" link-type="anchor"
                                            parameter-map="{orderId:orderId}"/>
                                </default-field>
                            </field>
                            <field name="orderStatusText"><default-field title="Order status"><display/></default-field></field>
                            <field name="quantity" align="right">
                                <default-field title="Ordered"><display text="${quantity} ${uomText}"/></default-field>
                            </field>
                            <field name="unitAmount" align="right" hide="!priceRead">
                                <default-field title="Price"><display currency-unit-field="currencyUomId"/></default-field>
                            </field>
                            <field name="acceptedQuantity" align="right">
                                <default-field title="Accepted"><display format="#,##0.###"/></default-field>
                            </field>
                            <field name="billedQuantity" align="right">
                                <default-field title="Billed"><display format="#,##0.###"/></default-field>
                            </field>
                            <field name="remainingQuantity" align="right">
                                <default-field title="Left to accept"><display format="#,##0.###"/></default-field>
                            </field>
                            <field name="exceptionText">
                                <default-field title="Match exceptions"><display style="text-negative"/></default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="orderId"/><field-ref name="orderStatusText"/></column>
                                <column><field-ref name="acceptedQuantity"/><field-ref name="remainingQuantity"/></column>
                            </columns>
                        </form-list>
                        <label text="No purchase order line yet: a buyer converts the request in Supply planning." type="p"
                                style="q-pa-md m-muted" condition="!lineRows.length"/>
                        <section name="OutputSection" condition="outputReceipts.length">
                            <widgets>
                                <label text="Output of ${status.output.productName} received" type="h6" style="q-px-sm"/>
                                <form-list name="SubcontractOutput" list="outputReceipts" skip-form="true" paginate="false">
                                    <field name="assetReceiptId"><default-field title="Receipt"><display/></default-field></field>
                                    <field name="quantity" align="right">
                                        <default-field title="Quantity"><display format="#,##0.###"/></default-field>
                                    </field>
                                    <field name="receivedDateText"><default-field title="Received"><display/></default-field></field>
                                    <field name="lotId"><default-field title="Lot"><display/></default-field></field>
                                    <field name="statusText">
                                        <default-field title="State"><display style="${held ? 'text-warning' : ''}"/></default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column><field-ref name="assetReceiptId"/><field-ref name="receivedDateText"/></column>
                                        <column><field-ref name="quantity"/><field-ref name="statusText"/></column>
                                    </columns>
                                </form-list>
                            </widgets>
                        </section>
                        <section name="OutsideCostsSection" condition="costEvents.length">
                            <widgets>
                                <label text="Outside-processing costs" type="h6" style="q-px-sm"/>
                                <form-list name="SubcontractCostEvents" list="costEvents" skip-form="true" paginate="false">
                                    <field name="eventTypeText"><default-field title="Event"><display/></default-field></field>
                                    <field name="quantity" align="right">
                                        <default-field title="Quantity"><display format="#,##0.###"/></default-field>
                                    </field>
                                    <field name="amount" align="right" hide="!financialRead">
                                        <default-field title="Amount"><display currency-unit-field="amountUomId"/></default-field>
                                    </field>
                                    <field name="ledgerText"><default-field title="Ledger"><display/></default-field></field>
                                    <field name="eventDateText"><default-field title="Date"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="eventTypeText"/><field-ref name="eventDateText"/></column>
                                        <column><field-ref name="quantity"/><field-ref name="ledgerText"/></column>
                                    </columns>
                                </form-list>
                            </widgets>
                        </section>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
