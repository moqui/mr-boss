<!-- OperationTemplates (design-manufacturing §5 OperationTemplates; impl-manufacturing P2): Templates, the organization's
    operation catalogue (ironstone.manufacturing.MethodServices.get#TemplateList over Mantle's find#OperationTemplates);
    EditTemplate (store#OperationTemplate: standards, the work center it needs, required evidence and its inspection
    template, audit-logged); InstructionVersion (store#OperationInstruction: a dated instruction stored once with its
    checksum, ending the one before); Archive, which blocks new copies only; and the template's conversation and files.
    A routing copies templates from RoutingDetail's Copy operations. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Operation templates" default-menu-include="false">
    <parameter name="organizationPartyId"/>
    <parameter name="workEffortId"/>
    <parameter name="text"/>
    <parameter name="includeArchived"/>
    <parameter name="pageIndex"/>
    <parameter name="pageSize"/>
    <transition-include name="choices" location="component://mr-boss/template/ManufacturingParts.xml"/>
    <transition name="storeTemplate">
        <actions>
            <if condition="workEffortId">
                <service-call name="ironstone.manufacturing.AccessServices.check#Record"
                        in-map="{recordType:'routing', recordId:workEffortId, capability:'methodEdit'}"/>
            </if>
            <service-call name="mantle.work.RoutingServices.store#OperationTemplate" in-map="context" out-map="stored"/>
            <set field="workEffortId" from="stored?.template?.workEffortId || workEffortId"/>
        </actions>
        <default-response url=".">
            <parameter name="workEffortId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="publishInstruction">
        <actions>
            <service-call name="ironstone.manufacturing.AccessServices.check#Record"
                    in-map="{recordType:'routing', recordId:workEffortId, capability:'methodEdit'}"/>
            <service-call name="mantle.work.RoutingServices.store#OperationInstruction"
                    in-map="{workEffortId:workEffortId, expectedRevision:expectedRevision, fromDate:fromDate, description:description,
                        contentText:contentText, contentFile:contentFile, filename:contentText ? 'instruction.md' : null,
                        changeReason:changeReason}"/>
        </actions>
        <default-response url=".">
            <parameter name="workEffortId"/>
        </default-response>
        <error-response url=".">
            <parameter name="workEffortId"/>
        </error-response>
    </transition>
    <!-- an instruction's file, for a user who may read its template -->
    <transition name="instructionFile" read-only="true">
        <actions>
            <service-call name="ironstone.manufacturing.AccessServices.check#Record"
                    in-map="{recordType:'routing', recordId:workEffortId}"/>
            <service-call name="mantle.work.RoutingServices.find#OperationTemplates" in-map="{workEffortId:workEffortId}"
                    out-map="found"/>
            <set field="instruction" from="(found.instructionRows || []).find(row =&gt; row.workEffortContentId === workEffortContentId)"/>
            <script>if (!instruction) throw new Error('Instruction is not available'); ec.web.sendResourceResponse(instruction.contentLocation)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <actions>
        <service-call name="ironstone.manufacturing.MethodServices.get#TemplateList"
                in-map="{organizationPartyId:organizationPartyId, workEffortId:workEffortId, text:text, includeArchived:includeArchived,
                    pageIndex:pageIndex, pageSize:pageSize}"
                out-map="context" transaction="force-new" ignore-error="true"/>
        <set field="canEdit" from="!!manufacturing.capabilities.methodEdit"/>
        <set field="newTemplate" from="{organizationPartyId:organizationPartyId, timeUomId:'TF_hr', methodBatchQuantity:1,
                estimatedSetupTime:0, estimatedWorkTime:0, methodMachineSetupTime:0, methodMachineRunTime:0}"/>
    </actions>
    <widgets>
        <context title="Operation templates" selection-form="TemplateList"/>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Operation templates" type="h5"/>
                <label text="${methodMessage}" type="p" style="m-muted" condition="!!methodMessage"/>
            </container>
            <container style="col-auto">
                <container-dialog id="NewTemplateDialog" condition="canEdit" button-text="New template" icon="sym_o_add"
                        title="New operation template" width="800">
                    <form-single name="NewTemplate" transition="storeTemplate" map="newTemplate">
                        <field name="organizationPartyId">
                            <default-field>
                                <hidden/>
                            </default-field>
                        </field>
                        <field name="workEffortName">
                            <default-field title="Name">
                                <text-line size="40"/>
                            </default-field>
                        </field>
                        <field name="description">
                            <default-field title="Description">
                                <text-area rows="3"/>
                            </default-field>
                        </field>
                        <field name="estimatedSetupTime">
                            <default-field title="Setup time">
                                <text-line size="10"/>
                            </default-field>
                        </field>
                        <field name="estimatedWorkTime">
                            <default-field title="Run time" tooltip="For each batch">
                                <text-line size="10"/>
                            </default-field>
                        </field>
                        <field name="methodMachineSetupTime">
                            <default-field title="Machine setup time">
                                <text-line size="10"/>
                            </default-field>
                        </field>
                        <field name="methodMachineRunTime">
                            <default-field title="Machine run time">
                                <text-line size="10"/>
                            </default-field>
                        </field>
                        <field name="timeUomId">
                            <default-field title="Time unit">
                                <drop-down allow-empty="false">
                                    <list-options list="timeUnitOptions" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="methodBatchQuantity">
                            <default-field title="Batch quantity">
                                <text-line size="10"/>
                            </default-field>
                        </field>
                        <field name="methodQuantityUomId">
                            <default-field title="Batch unit">
                                <drop-down allow-empty="false">
                                    <list-options list="unitOptions" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="methodWorkCenterId">
                            <default-field title="Work center">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0"
                                            parameter-map="{choice:'workCenters'}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="methodRequiredEvidence">
                            <default-field title="Required evidence" tooltip="What the operator records to complete it">
                                <text-line size="40"/>
                            </default-field>
                        </field>
                        <field name="methodInspectionTemplateId">
                            <default-field title="Inspection template">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0"
                                            parameter-map="{choice:'inspectionTemplates'}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="changeReason">
                            <default-field title="Reason">
                                <text-line size="40"/>
                            </default-field>
                        </field>
                        <field name="submitButton">
                            <default-field title="Create template">
                                <submit/>
                            </default-field>
                        </field>
                        <field-layout>
                            <field-row>
                                <field-ref name="workEffortName"/>
                                <field-ref name="methodWorkCenterId"/>
                            </field-row>
                            <field-ref name="description"/>
                            <field-row>
                                <field-ref name="estimatedSetupTime"/>
                                <field-ref name="estimatedWorkTime"/>
                            </field-row>
                            <field-row>
                                <field-ref name="methodMachineSetupTime"/>
                                <field-ref name="methodMachineRunTime"/>
                            </field-row>
                            <field-row>
                                <field-ref name="timeUomId"/>
                                <field-ref name="methodBatchQuantity"/>
                                <field-ref name="methodQuantityUomId"/>
                            </field-row>
                            <field-row>
                                <field-ref name="methodRequiredEvidence"/>
                                <field-ref name="methodInspectionTemplateId"/>
                            </field-row>
                            <field-ref name="changeReason"/>
                            <field-ref name="submitButton"/>
                        </field-layout>
                    </form-single>
                </container-dialog>
            </container>
        </container>
        <section name="SelectedTemplate" condition="!!selectedTemplate">
            <widgets>
                <container style="m-record-header">
                    <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                        <container style="col-12 col-md m-record-title">
                            <label text="${selectedTemplate.workEffortName}" type="h5"/>
                            <label text="${[selectedTemplate.centerText, selectedTemplate.methodRequiredEvidence ? 'Evidence: ' + selectedTemplate.methodRequiredEvidence : '',
                                    selectedTemplate.inspectionTemplateName ? 'Inspection: ' + selectedTemplate.inspectionTemplateName : ''].filter(Boolean).join(' · ')}"
                                    type="p" style="text-caption m-muted q-mb-none"/>
                        </container>
                        <container style="col-12 col-md-auto m-record-status">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${selectedTemplate.state.color}">${WebUtilities.encodeHtml(selectedTemplate.state.text)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", id: "TemplateState", text: selectedTemplate.state.text})}]]></text>
                            </render-mode>
                        </container>
                        <container style="col-12 col-md-auto row items-center q-gutter-xs m-record-actions">
                            <container-dialog id="PublishInstructionDialog" condition="canEdit &amp;&amp; !selectedTemplate.archived" type="primary"
                                    button-text="Publish instruction" icon="sym_o_publish" title="Publish an instruction for ${selectedTemplate.workEffortName}" width="720">
                                <label text="The instruction takes effect at its start and ends the one in effect then. Its file is kept as published."
                                        type="p"/>
                                <form-single name="PublishInstruction" transition="publishInstruction"
                                        map="{workEffortId:selectedTemplate.workEffortId, expectedRevision:selectedTemplate.expectedRevision}">
                                    <field name="workEffortId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="expectedRevision">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="description">
                                        <default-field title="Title">
                                            <text-line size="40"/>
                                        </default-field>
                                    </field>
                                    <field name="contentFile">
                                        <default-field title="Instruction file">
                                            <file/>
                                        </default-field>
                                    </field>
                                    <field name="contentText">
                                        <default-field title="Or write the steps">
                                            <text-area rows="8"/>
                                        </default-field>
                                    </field>
                                    <field name="fromDate">
                                        <default-field title="Effective start" tooltip="Leave empty to start now">
                                            <date-time/>
                                        </default-field>
                                    </field>
                                    <field name="changeReason">
                                        <default-field title="Reason">
                                            <text-line size="40"/>
                                        </default-field>
                                    </field>
                                    <field name="submitButton">
                                        <default-field title="Publish instruction">
                                            <submit/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </container-dialog>
                            <button-menu text="More" icon="more_horiz" condition="canEdit">
                                <container-dialog id="EditTemplateDialog" button-text="Edit template" icon="sym_o_edit"
                                        title="${ec.l10n.localize('Edit')} ${selectedTemplate.workEffortName}" width="800">
                                    <form-single name="EditTemplate" transition="storeTemplate" extends="NewTemplate" map="selectedTemplate">
                                        <field name="workEffortId">
                                            <default-field>
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="expectedRevision">
                                            <default-field>
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="submitButton">
                                            <default-field title="Save template">
                                                <submit/>
                                            </default-field>
                                        </field>
                                    </form-single>
                                </container-dialog>
                                <container-dialog id="ArchiveTemplateDialog" condition="!selectedTemplate.archived" type="danger" button-text="Archive"
                                        icon="sym_o_archive" title="Archive ${selectedTemplate.workEffortName}" width="560">
                                    <label text="An archived template is not copied into routings any more. Routings that copied it keep their
                                            operations." type="p"/>
                                    <form-single name="ArchiveTemplate" transition="storeTemplate"
                                            map="{workEffortId:selectedTemplate.workEffortId, expectedRevision:selectedTemplate.expectedRevision, methodArchived:'Y'}">
                                        <field name="workEffortId">
                                            <default-field>
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="expectedRevision">
                                            <default-field>
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="methodArchived">
                                            <default-field>
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="changeReason">
                                            <default-field title="Reason">
                                                <text-line size="40"/>
                                            </default-field>
                                        </field>
                                        <field name="submitButton">
                                            <default-field title="Archive template">
                                                <submit confirmation="Archive ${selectedTemplate.workEffortName}? It is not copied into routings any more."/>
                                            </default-field>
                                        </field>
                                    </form-single>
                                </container-dialog>
                            </button-menu>
                        </container>
                    </container>
                </container>
                <container-box>
                    <box-header title="Instructions"/>
                    <box-body-nopad>
                        <label text="No instruction is published for this template yet." type="p" style="m-muted q-pa-md"
                                condition="!instructionRows.length"/>
                        <form-list name="InstructionList" list="instructionRows" skip-form="true" paginate="false">
                            <field name="description">
                                <default-field title="Instruction">
                                    <link url="instructionFile" text="${description}" link-type="anchor" target-window="_blank"
                                            parameter-map="{workEffortId:selectedTemplate.workEffortId, workEffortContentId:workEffortContentId}"/>
                                </default-field>
                            </field>
                            <field name="fromText">
                                <default-field title="From">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="thruText">
                                <default-field title="Through">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="checksumText">
                                <default-field title="Checksum" tooltip="The start of the file's SHA-256">
                                    <display/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="description"/>
                                    <field-ref name="fromText"/>
                                </column>
                                <column>
                                    <field-ref name="thruText"/>
                                </column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
                <container-box>
                    <box-header title="Notes and files"/>
                    <box-body>
                        <chatter id="TemplateConversation" record-entity="mantle.work.effort.WorkEffort" record-id="${selectedTemplate.workEffortId}"
                                default-tab="message"/>
                        <record-files id="TemplateFiles" record-entity="mantle.work.effort.WorkEffort" record-id="${selectedTemplate.workEffortId}"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="NoTemplates" condition="!templateRows?.length &amp;&amp; !text">
            <widgets>
                <label text="This organization has no operation templates yet. Start the catalogue with New template." type="p"
                        style="m-muted"/>
            </widgets>
        </section>
        <container-box>
            <box-header title="Templates"/>
            <box-body-nopad>
                <form-list name="TemplateList" list="templateRows" skip-form="true" paginate="true" header-dialog="true"
                        show-csv-button="true">
                    <field name="text">
                        <header-field title="Template name or ID">
                            <text-line/>
                        </header-field>
                        <default-field>
                            <ignored/>
                        </default-field>
                    </field>
                    <field name="includeArchived">
                        <header-field title="Archived">
                            <check>
                                <option key="Y" text="Show archived templates"/>
                            </check>
                        </header-field>
                        <default-field>
                            <ignored/>
                        </default-field>
                    </field>
                    <field name="workEffortName">
                        <header-field title="Template"/>
                        <default-field>
                            <link url="." text="${workEffortName}" link-type="anchor" parameter-map="{workEffortId:workEffortId}"/>
                        </default-field>
                    </field>
                    <field name="centerText">
                        <header-field title="Work center"/>
                        <default-field>
                            <display/>
                        </default-field>
                    </field>
                    <field name="instructionText">
                        <header-field title="Instruction"/>
                        <default-field>
                            <display/>
                        </default-field>
                    </field>
                    <field name="inspectionTemplateName">
                        <header-field title="Inspection"/>
                        <default-field>
                            <display/>
                        </default-field>
                    </field>
                    <field name="stateText" from="state?.text">
                        <header-field title="State"/>
                        <default-field>
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                                    state.color}">${WebUtilities.encodeHtml(state.text)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong", text: state.text})}]]></text>
                                <text type="html">${state.text}</text>
                            </render-mode>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="workEffortName"/>
                            <field-ref name="centerText"/>
                        </column>
                        <column>
                            <field-ref name="stateText"/>
                        </column>
                    </columns>
                </form-list>
            </box-body-nopad>
        </container-box>
    </widgets>
</screen>
