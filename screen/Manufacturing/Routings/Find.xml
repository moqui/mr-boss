<!-- Routings (design-manufacturing §5 Routings; style-guide §3.2 List): Find and the list of the organization's routings
    (ironstone.manufacturing.MethodServices.get#RoutingList over Mantle's find#Routings), NewRouting (store#Routing) and
    the CSV import with its preview (import#RoutingCsv: each routing atomic, a bad one named). A routing opens in the shared
    RoutingDetail, where its operations are edited, copied from templates and released. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Routings" default-menu-include="false">
    <parameter name="organizationPartyId"/>
    <parameter name="text"/>
    <parameter name="pageIndex"/>
    <parameter name="pageSize"/>
    <transition name="createRouting">
        <actions>
            <service-call name="mantle.work.RoutingServices.store#Routing"
                    in-map="{organizationPartyId:organizationPartyId, workEffortName:workEffortName, description:description,
                        changeReason:changeReason}"
                    out-map="created"/>
            <set field="workEffortId" from="created?.routing?.workEffortId"/>
        </actions>
        <default-response url="../RoutingDetail">
            <parameter name="workEffortId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="importCsv">
        <actions>
            <service-call name="mantle.work.RoutingServices.import#RoutingCsv"
                    in-map="{organizationPartyId:organizationPartyId, contentFile:contentFile, csvText:csvText,
                        preview:preview == 'true', changeReason:changeReason}"
                    out-map="imported"/>
            <!-- each routing's outcome by name: ready or imported, and failed with its rows' messages -->
            <script><![CDATA[
            for (const version of imported.versionRows || []) {
                if (version.status === 'failed') ec.message.addError(version.routingName + ' not imported: ' + version.messages.join('; '))
                else if (version.status === 'ready') ec.message.addMessage(version.routingName + ' is ready: ' + version.lineCount + ' operations')
                else ec.message.addMessage(version.routingName + ' imported as draft operations: ' + version.lineCount + ' operations')
            }
            ]]></script>
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId"/>
        </default-response>
        <error-response url=".">
            <parameter name="organizationPartyId"/>
        </error-response>
    </transition>
    <actions>
        <service-call name="ironstone.manufacturing.MethodServices.get#RoutingList"
                in-map="{organizationPartyId:organizationPartyId, text:text, pageIndex:pageIndex, pageSize:pageSize}"
                out-map="context"/>
        <set field="canEdit" from="!!manufacturing.capabilities.methodEdit"/>
    </actions>
    <widgets>
        <context title="Routings" selection-form="RoutingList"/>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Routings" type="h5"/>
                <label text="${methodMessage}" type="p" style="m-muted" condition="!!methodMessage"/>
            </container>
            <container style="col-auto row items-center q-gutter-xs">
                <container-dialog id="NewRoutingDialog" condition="canEdit" type="primary" button-text="New routing" icon="sym_o_add"
                        title="New routing" width="640">
                    <form-single name="NewRouting" transition="createRouting" map="{organizationPartyId:organizationPartyId}">
                        <field name="organizationPartyId">
                            <default-field title="Organization">
                                <drop-down allow-empty="false">
                                    <list-options list="organizationOptions" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="workEffortName">
                            <default-field title="Name">
                                <text-line size="40"/>
                            </default-field>
                        </field>
                        <field name="description">
                            <default-field title="Description">
                                <text-area rows="3"/>
                            </default-field>
                        </field>
                        <field name="changeReason">
                            <default-field title="Reason">
                                <text-line size="40"/>
                            </default-field>
                        </field>
                        <field name="submitButton">
                            <default-field title="Create routing draft">
                                <submit/>
                            </default-field>
                        </field>
                    </form-single>
                </container-dialog>
                <button-menu text="More" icon="more_horiz" condition="canEdit">
                    <container-dialog id="ImportRoutingCsvDialog" button-text="Import from CSV" icon="sym_o_table_view"
                            title="Import routings from CSV" width="720">
                        <label text="Columns: routingName, operationName, quantityUomId; optional sequenceNum, setupTime, runTime,
                                machineSetupTime, machineRunTime, timeUomId, batchQuantity and workCenterId. Each routing imports whole or
                                not at all, as draft operations; a routing of the same name takes them. Preview checks without saving." type="p"/>
                        <form-single name="ImportRoutingCsv" transition="importCsv" map="{organizationPartyId:organizationPartyId, preview:'true'}">
                            <field name="organizationPartyId">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="contentFile">
                                <default-field title="CSV file">
                                    <file/>
                                </default-field>
                            </field>
                            <field name="csvText">
                                <default-field title="Or paste the rows">
                                    <text-area rows="6"/>
                                </default-field>
                            </field>
                            <field name="preview">
                                <default-field title="Preview">
                                    <check>
                                        <option key="true" text="Check only; save nothing"/>
                                    </check>
                                </default-field>
                            </field>
                            <field name="changeReason">
                                <default-field title="Reason">
                                    <text-line size="40"/>
                                </default-field>
                            </field>
                            <field name="submitButton">
                                <default-field title="Import routings">
                                    <submit/>
                                </default-field>
                            </field>
                        </form-single>
                    </container-dialog>
                </button-menu>
            </container>
        </container>
        <section name="NoRoutings" condition="!routingRows?.length &amp;&amp; !text">
            <widgets>
                <label text="This organization has no routings yet. Start one with New routing and copy its operations from the
                        operation templates, or import a CSV file from More." type="p" style="m-muted"/>
            </widgets>
        </section>
        <container-box>
            <box-header title="Routings"/>
            <box-body-nopad>
                <form-list name="RoutingList" list="routingRows" skip-form="true" paginate="true" header-dialog="true"
                        show-csv-button="true">
                    <field name="text">
                        <header-field title="Routing name or ID">
                            <text-line/>
                        </header-field>
                        <default-field>
                            <ignored/>
                        </default-field>
                    </field>
                    <field name="organizationPartyId">
                        <header-field title="Organization">
                            <drop-down allow-empty="false">
                                <list-options list="organizationOptions" key="${value}" text="${label}"/>
                            </drop-down>
                        </header-field>
                        <default-field>
                            <ignored/>
                        </default-field>
                    </field>
                    <field name="workEffortName">
                        <header-field title="Routing"/>
                        <default-field>
                            <link url="../RoutingDetail" text="${workEffortName}" link-type="anchor"
                                    parameter-map="{workEffortId:workEffortId}"/>
                        </default-field>
                    </field>
                    <field name="description">
                        <header-field title="Description"/>
                        <default-field>
                            <display/>
                        </default-field>
                    </field>
                    <field name="operationCount" align="right">
                        <header-field title="Operations"/>
                        <default-field>
                            <display format="#,##0"/>
                        </default-field>
                    </field>
                    <field name="lastReleaseText">
                        <header-field title="Last release"/>
                        <default-field>
                            <display/>
                        </default-field>
                    </field>
                    <field name="stateText" from="state?.text">
                        <header-field title="State"/>
                        <default-field>
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                                    state.color}">${WebUtilities.encodeHtml(state.text)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong", text: state.text})}]]></text>
                                <text type="html">${state.text}</text>
                            </render-mode>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="workEffortName"/>
                            <field-ref name="operationCount"/>
                        </column>
                        <column>
                            <field-ref name="stateText"/>
                        </column>
                    </columns>
                </form-list>
            </box-body-nopad>
        </container-box>
    </widgets>
</screen>
