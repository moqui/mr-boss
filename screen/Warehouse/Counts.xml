<!-- The Counts area of IronStone Warehouse (design-warehouse §7), for the count, count reviewer and adjust groups
    (BOSS_WH_COUNTS): Counts (the list, the Due saved find and New count), CountDetail, CountEntry (with its handheld mount
    at Handheld/Count), CountReview and the printed count sheets; CountVariance is under Reports. The services are Mantle's
    mantle.product.InventoryCountServices, through ironstone.warehouse.CountServices' reads and the transitions of
    template/WarehouseCountParts.xml. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Counts" default-menu-index="5" menu-image="sym_o_checklist" menu-image-type="icon">
    <subscreens default-item="Counts" always-use-full-path="true"/>
    <widgets>
        <subscreens-panel id="CountsPanel" type="tab"/>
    </widgets>
</screen>
