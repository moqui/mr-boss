<!-- The printer test page (design-warehouse §12 PrinterTest): a marked sample, printed as PDF by
    mantle.facility.PrintServices.dispatch#Document on a facility's printer for a purpose. It reads no record. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Printer test" default-menu-include="false">
    <parameter name="facilityId"/>
    <parameter name="printerPurposeEnumId"/>
    <actions>
        <set field="printedText" from="ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd HH:mm')"/>
    </actions>
    <widgets>
        <label text="Printer test" type="h5"/>
        <label type="p" text="TEST PAGE: this sample is not a document. Facility ${facilityId || ''},
                purpose ${printerPurposeEnumId || ''}, printed ${printedText}."/>
    </widgets>
</screen>
