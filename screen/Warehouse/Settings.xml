<!-- The Settings area of IronStone Warehouse (design-warehouse §14): the settings index, stock policies, reservation
    policies and asset pools. Every Warehouse user reads the effective policy; warehouse managers (STOCK_POLICY_MANAGE)
    change it, and product tracking exceptions also take the stock planner (STOCK_POLICY_PLAN). Each change goes to
    Mantle's WarehousePolicyServices or AssetPoolServices, which check again. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Settings" default-menu-index="13" menu-image="sym_o_settings" menu-image-type="icon"
        server-static="qvt">
    <subscreens default-item="Index"/>
    <widgets>
        <subscreens-menu id="WarehouseSettingsTabs" type="tab"/>
        <subscreens-active/>
    </widgets>
</screen>
