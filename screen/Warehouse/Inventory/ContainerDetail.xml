<!-- ContainerDetail (design-warehouse §6 ContainerDetail; style-guide §3.3 Detail): one container of the user's facilities
    (ironstone.warehouse.InventoryServices.get#ContainerDetail): ContainerHeader (its type, serial, description, and its
    facility and location, read only) and ContainerContents, the assets in it with their stock and trace links. Attaching,
    detaching and moving a container are the guarded container tasks (impl-warehouse P5): AddOrRemoveAsset puts an asset that
    is where the container is into it, or takes one out, and MoveContainer moves it with all its contents to another location
    of its facility, all or nothing; each transition checks the record with the move capability
    (ironstone.warehouse.AccessServices.check#Record), then calls mantle.shipment.WarehouseTaskServices'
    attach#AssetToContainer, detach#AssetFromContainer or move#Container with the page's operation key, so a double submit
    answers the first. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Container" default-menu-include="false">
    <parameter name="containerId" required="true"/>
    <transition-include name="facilityChoices" location="component://mr-boss/template/WarehouseFacilityParts.xml"/>
    <transition name="attachAsset">
        <actions>
            <service-call name="ironstone.warehouse.AccessServices.check#Record"
                    in-map="{recordType:'container', recordId:containerId, capability:'move'}"/>
            <service-call name="ironstone.warehouse.AccessServices.check#Record"
                    in-map="{recordType:'asset', recordId:assetId, capability:'move'}"/>
            <service-call name="mantle.shipment.WarehouseTaskServices.attach#AssetToContainer" out-map="attached"
                    in-map="{operationKey:operationKey, assetId:assetId, containerId:containerId, quantity:quantity || null}"/>
            <message type="success">Put ${attached.result.quantity} of ${assetId} in ${containerId}</message>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="detachAsset">
        <actions>
            <service-call name="ironstone.warehouse.AccessServices.check#Record"
                    in-map="{recordType:'asset', recordId:assetId, capability:'move'}"/>
            <service-call name="mantle.shipment.WarehouseTaskServices.detach#AssetFromContainer" out-map="detached"
                    in-map="{operationKey:operationKey, assetId:assetId, quantity:quantity || null}"/>
            <message type="success">Took ${detached.result.quantity} of ${assetId} out of ${detached.result.containerId}</message>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="moveContainer">
        <actions>
            <service-call name="ironstone.warehouse.AccessServices.check#Record"
                    in-map="{recordType:'container', recordId:containerId, capability:'move'}"/>
            <service-call name="mantle.shipment.WarehouseTaskServices.move#Container" out-map="moved"
                    in-map="{operationKey:operationKey, containerId:containerId, toLocationSeqId:toLocationSeqId,
                        reason:reason || null}"/>
            <message type="success">Moved ${containerId} with ${moved.result.assets.length} assets to ${toLocationSeqId}</message>
            <iterate list="moved.result.warnings || []" entry="warning">
                <message type="warning">${warning.assetId}: ${warning.message}</message>
            </iterate>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="ironstone.warehouse.InventoryServices.get#ContainerDetail" in-map="{containerId:containerId}"
                out-map="context" transaction="force-new" ignore-error="true"/>
        <set field="recordFound" from="!!recordFound"/>
        <set field="canMove" from="recordFound &amp;&amp; !!warehouse.capabilities.move"/>
        <!-- the operation key of this page's forms, so a double submit is the same operation (a token, not a record id) -->
        <set field="containerOperationKey" from="'container-' + ec.user.randomString(24)"/>
    </actions>
    <widgets>
        <section name="ContainerNotAvailable" condition="!recordFound">
            <widgets>
                <container-box type="warning">
                    <box-header title="Not available"/>
                    <box-body>
                        <label
                                text="Container ${containerId} is not in your facilities, or does not exist."
                                type="p"/>
                        <link url="../Containers" text="Back to containers" link-type="anchor" icon="arrow_back"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="ContainerFound" condition="recordFound">
            <widgets>
                <context record-entity="mantle.product.asset.Container" record-id="${containerId}"
                        title="${container.description || container.serialNumber}"/>
                <link url="../Containers" text="Containers" link-type="anchor" icon="arrow_back"/>
                <container style="m-record-header">
                    <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                        <container style="col-12 col-md m-record-title">
                            <container style="row items-center no-wrap">
                                <render-mode>
                                    <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none q-mr-sm text-mono">${
                                        WebUtilities.encodeHtml(containerId)}</q-chip>]]></text>
                                    <text type="tui"><![CDATA[${JSON.stringify({t: "text", id: "ContainerKey", style: "strong",
                                        text: containerId})}]]></text>
                                    <text type="html">${containerId}</text>
                                </render-mode>
                                <label text="${container.description || container.serialNumber || containerId}" type="h5"/>
                            </container>
                            <label text="${[container.typeText, container.serialNumber ? 'Serial ' + container.serialNumber : '',
                                    [container.facilityName, container.locationSeqId].filter(Boolean).join(' · ')]
                                    .filter(Boolean).join(' · ')}" type="p" style="text-caption m-muted q-mb-none"/>
                        </container>
                        <container style="col-12 col-md-auto m-record-status">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                                    container.assetCount ? 'positive' : 'grey'}">${container.assetCount ? container.assetCount +
                                    ' assets' : 'Empty'}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", id: "ContainerState", style: "strong",
                                    text: container.assetCount ? container.assetCount + ' assets' : 'Empty'})}]]></text>
                                <text type="html">${container.assetCount ? container.assetCount + ' assets' : 'Empty'}</text>
                            </render-mode>
                        </container>
                    </container>
                </container>
                <container style="row items-center q-gutter-sm q-mb-sm">
                    <container-dialog id="MoveContainerDialog" condition="canMove &amp;&amp; container.locationSeqId"
                            type="primary" button-text="Move container" icon="sym_o_move_down"
                            title="Move ${containerId} with its contents" width="640">
                        <label text="All ${container.assetCount || 0} assets in it move with it, or none do." type="p"/>
                        <form-single name="MoveContainer" transition="moveContainer"
                                map="{containerId:containerId, operationKey:containerOperationKey}">
                            <field name="containerId">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="operationKey">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="toLocationSeqId">
                                <default-field title="To location">
                                    <drop-down allow-empty="false">
                                        <dynamic-options transition="facilityChoices" server-search="true" min-length="0"
                                                parameter-map="{choice:'locations', facilityId:container.facilityId}"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="reason">
                                <default-field title="Reason">
                                    <text-line size="40"/>
                                </default-field>
                            </field>
                            <field name="submit">
                                <default-field title="">
                                    <submit text="Move container"/>
                                </default-field>
                            </field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="AddAssetDialog" condition="canMove" button-text="Put stock in"
                            icon="sym_o_add" title="Put stock in ${containerId}" width="640">
                        <label text="Only stock at ${container.locationSeqId || 'the container'} goes in: putting it in
                                moves nothing." type="p"/>
                        <form-single name="AddOrRemoveAsset" transition="attachAsset"
                                map="{containerId:containerId, operationKey:containerOperationKey}">
                            <field name="containerId">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="operationKey">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="assetId">
                                <default-field title="Stock">
                                    <scan-input resolver="ironstone.warehouse.AccessServices.resolve#Scan" allowed-types="asset"
                                            auto-submit="false" scan-id-field="assetScanId" placeholder="Scan the stock">
                                        <parameter name="facilityId" from="container.facilityId"/>
                                    </scan-input>
                                </default-field>
                            </field>
                            <field name="quantity">
                                <default-field title="Quantity" tooltip="Empty puts all of it in">
                                    <text-line size="10" input-type="number"/>
                                </default-field>
                            </field>
                            <field name="submit">
                                <default-field title="">
                                    <submit text="Put in container"/>
                                </default-field>
                            </field>
                        </form-single>
                    </container-dialog>
                </container>
                <container-box>
                    <box-header title="Contents"/>
                    <box-body-nopad>
                        <label text="This container is empty." type="p" style="q-pa-sm" condition="!contentRows.length"/>
                        <form-list name="ContainerContents" list="contentRows" skip-form="true" paginate="false">
                            <field name="assetId">
                                <default-field title="Asset">
                                    <link url="../AssetDetail" text="${assetId}" link-type="anchor"
                                            parameter-map="{assetId:assetId}"/>
                                </default-field>
                            </field>
                            <field name="productName">
                                <default-field title="Product">
                                    <link url="../Availability" text="${productName}" link-type="anchor"
                                            parameter-map="{productId:productId}"/>
                                </default-field>
                            </field>
                            <field name="identityText"
                                    from="[serialNumber ? 'Serial ' + serialNumber : '', lotNumber ? 'Lot ' + lotNumber : '']
                                    .filter(Boolean).join(' · ')">
                                <default-field title="Serial or lot">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="ownerName">
                                <default-field title="Owner">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="statusText">
                                <default-field title="Status">
                                    <render-mode>
                                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                                            statusColor}">${WebUtilities.encodeHtml(statusText)}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong",
                                            text: statusText})}]]></text>
                                        <text type="html">${statusText}</text>
                                    </render-mode>
                                </default-field>
                            </field>
                            <field name="quantityOnHand" align="right">
                                <default-field title="On hand">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="trace">
                                <default-field title="">
                                    <link url="../Traceability" text="Trace" link-type="anchor"
                                            parameter-map="{rootType:'asset', rootId:assetId}"/>
                                </default-field>
                            </field>
                            <field name="takeOut">
                                <conditional-field condition="canMove" title="">
                                    <container-dialog id="TakeOut_${assetId}" button-text="Take out"
                                            title="Take ${assetId} out of ${containerId}" width="480">
                                        <form-single name="TakeOut_${assetId}" transition="detachAsset"
                                                map="{assetId:assetId, containerId:containerId,
                                                    operationKey:containerOperationKey + '-' + assetId}">
                                            <field name="assetId">
                                                <default-field>
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="containerId">
                                                <default-field>
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="operationKey">
                                                <default-field>
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="quantity">
                                                <default-field title="Quantity" tooltip="Empty takes all of it out">
                                                    <text-line size="10" input-type="number"/>
                                                </default-field>
                                            </field>
                                            <field name="submit">
                                                <default-field title="">
                                                    <submit text="Take out"/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                </conditional-field>
                                <default-field title="">
                                    <display text=""/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="assetId"/>
                                    <field-ref name="productName"/>
                                </column>
                                <column>
                                    <field-ref name="statusText"/>
                                    <field-ref name="quantityOnHand"/>
                                </column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
