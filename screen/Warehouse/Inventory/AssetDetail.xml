<!-- AssetDetail (design-warehouse §6 AssetDetail; style-guide §3.3 Detail): one stock asset of the user's facilities
    (ironstone.warehouse.InventoryServices.get#AssetDetail). The header shows its product, lot or serial, status, location,
    owner and quantities, read only, with its unit cost for a user with financial read; Edit details changes only its
    name and comments (the metadata allowlist, mantle.product.AssetRecordServices.update#AssetMetadata, audit-logged) for
    a user with adjust. Quantity, location, status, owner and cost change only through their guarded tasks. Tabs: the
    ledger, reservations, the audit trail, files (AssetContent) and notes. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Asset" default-menu-include="false">
    <parameter name="assetId" required="true"/>
    <transition name="storeMetadata">
        <actions>
            <service-call name="ironstone.warehouse.InventoryServices.store#AssetMetadata"
                    in-map="{assetId:assetId, assetName:assetName, comments:comments,
                        expectedLastUpdatedStamp:expectedLastUpdatedStamp}"/>
        </actions>
        <default-response url=".">
            <parameter name="assetId"/>
        </default-response>
        <error-response url=".">
            <parameter name="assetId"/>
        </error-response>
    </transition>
    <subscreens default-item="Ledger"/>
    <actions>
        <service-call name="ironstone.warehouse.InventoryServices.get#AssetDetail" in-map="{assetId:assetId}" out-map="context"
                transaction="force-new" ignore-error="true"/>
        <set field="recordFound" from="!!recordFound"/>
        <set field="factsText" from="recordFound ? [asset.serialNumber ? 'Serial ' + asset.serialNumber : '',
                asset.lotNumber ? 'Lot ' + asset.lotNumber : '', asset.typeText, asset.ownerName]
                .filter(Boolean).join(' · ') : ''"/>
    </actions>
    <widgets>
        <section name="AssetNotAvailable" condition="!recordFound">
            <widgets>
                <container-box type="warning">
                    <box-header title="Not available"/>
                    <box-body>
                        <label
                                text="Asset ${assetId} is not available: it does not exist, or it is not in your facilities."
                                type="p"/>
                        <link url="../Assets" text="Back to assets" link-type="anchor" icon="arrow_back"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="AssetFound" condition="recordFound">
            <widgets>
                <context record-entity="mantle.product.asset.Asset" record-id="${assetId}" title="${asset.productName}"/>
                <link url="../Assets" text="Assets" link-type="anchor" icon="arrow_back"/>
                <container style="m-record-header">
                    <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                        <container style="col-12 col-md m-record-title">
                            <container style="row items-center no-wrap">
                                <render-mode>
                                    <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none q-mr-sm text-mono">${
                                        WebUtilities.encodeHtml(assetId)}</q-chip>]]></text>
                                    <text type="tui"><![CDATA[${JSON.stringify({t: "text", id: "AssetKey", style: "strong",
                                        text: assetId})}]]></text>
                                    <text type="html">${assetId}</text>
                                </render-mode>
                                <label text="${asset.assetName || asset.productName}" type="h5"/>
                            </container>
                            <label text="${factsText}" type="p" style="text-caption m-muted q-mb-none"/>
                        </container>
                        <container style="col-12 col-md-auto m-record-status">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                                    asset.statusColor}">${WebUtilities.encodeHtml(asset.statusText)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", id: "AssetStatus", style: "strong",
                                    text: asset.statusText})}]]></text>
                                <text type="html">${asset.statusText}</text>
                            </render-mode>
                        </container>
                    </container>
                    <container style="row items-center q-col-gutter-x-md q-col-gutter-y-sm m-record-foot">
                        <container style="col-12 col-md row q-gutter-xs">
                            <link url="../Availability" text="Stock of ${asset.productName}" link-type="anchor-button"
                                    icon="sym_o_inventory_2" parameter-map="{productId:asset.productId}"/>
                            <link url="../Traceability" text="Trace" link-type="anchor-button" icon="sym_o_account_tree"
                                    parameter-map="{rootType:'asset', rootId:assetId}"/>
                            <link url="../Lots" text="Lot ${asset.lotNumber}" link-type="anchor-button" icon="sym_o_barcode"
                                    condition="asset.lotId" parameter-map="{lotId:asset.lotId}"/>
                            <link url="../ContainerDetail" text="${asset.containerText}" link-type="anchor-button"
                                    icon="sym_o_pallet" condition="asset.containerId"
                                    parameter-map="{containerId:asset.containerId}"/>
                            <link url="${sharedLinks['Shipping/LabelSheet']}" text="Serial label" link-type="anchor-button"
                                    icon="sym_o_qr_code" target-window="_blank" condition="asset.serialNumber"
                                    parameter-map="{kind:'serial', ids:assetId, renderMode:'html-print'}"/>
                        </container>
                        <container style="col-12 col-md-auto row items-center q-gutter-y-xs m-record-actions">
                            <!-- Move: the guarded move task with this asset chosen (P5) -->
                            <link url="${sharedLinks['Transfers/Move']}" url-type="plain" text="Move" link-type="anchor-button"
                                    icon="sym_o_move_down" condition="warehouse.capabilities.move &amp;&amp; !asset.equipment"
                                    parameter-map="{assetId:assetId, facilityId:asset.facilityId}"/>
                            <!-- Record adjustment and Scrap: the guarded adjustment task with this asset fixed (P6) -->
                            <link url="../Adjustments" text="Record adjustment" link-type="anchor-button"
                                    icon="sym_o_edit_note" condition="warehouse.capabilities.adjust &amp;&amp; !asset.equipment"
                                    parameter-map="{assetId:assetId}"/>
                            <link url="../Adjustments" text="Scrap" link-type="anchor-button" icon="sym_o_delete"
                                    condition="warehouse.capabilities.adjust &amp;&amp; !asset.equipment"
                                    parameter-map="{assetId:assetId, _openDialog:'ScrapDialog'}"/>
                            <container-dialog id="EditAssetDialog" condition="canEditMetadata" button-text="Edit details"
                                    icon="sym_o_edit" title="Edit the details of ${assetId}" width="640">
                                <form-single name="EditAsset" transition="storeMetadata"
                                        map="{assetId:assetId, assetName:asset.assetName, comments:asset.comments,
                                            expectedLastUpdatedStamp:asset.lastUpdatedStamp}">
                                    <field name="assetId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="expectedLastUpdatedStamp">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="assetName">
                                        <default-field title="Name">
                                            <text-line size="60"/>
                                        </default-field>
                                    </field>
                                    <field name="comments">
                                        <default-field title="Comments">
                                            <text-area rows="4"/>
                                        </default-field>
                                    </field>
                                    <field name="note">
                                        <default-field title="">
                                            <label
                                                    text="Quantity, location, status, owner and cost change only by their tasks."
                                                    type="p" style="m-muted"/>
                                        </default-field>
                                    </field>
                                    <field name="submitButton">
                                        <default-field title="Save details">
                                            <submit/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </container-dialog>
                        </container>
                    </container>
                </container>
                <dashboard min-width="140" style="q-mb-sm">
                    <number-card title="On hand" value="${ec.l10n.format(asset.quantityOnHand ?? 0, '#,##0.###')}" size="sm"
                            icon="sym_o_inventory_2"/>
                    <number-card title="Available to promise"
                            value="${ec.l10n.format(asset.availableToPromise ?? 0, '#,##0.###')}"
                            size="sm" icon="sym_o_check_circle"/>
                    <number-card title="Location" value="${asset.locationText || '—'}" size="sm" icon="sym_o_shelves"/>
                    <number-card title="Unit cost" condition="costIncluded" size="sm" icon="sym_o_payments"
                            value="${asset.acquireCost == null ? '—'
                                : ec.l10n.formatCurrency(asset.acquireCost, asset.acquireCostUomId)}"/>
                </dashboard>
                <subscreens-panel id="AssetTabs" type="tab"/>
            </widgets>
        </section>
    </widgets>
</screen>
