<!-- Lots (design-warehouse §6 Lots; split): LotList, the lots with stock in the user's facilities and the lots with no stock
    yet, by lot number and expiry (ironstone.warehouse.InventoryServices.find#Lots); LotStock beside it, the chosen lot's
    stock by asset and the products it is of (get#LotDetail); LotMetadata for a new lot (create#Lot, for a user with
    receive). Correct changes a lot's number, manufacturer, dates or expiry with a reason through Mantle's guarded
    mantle.shipment.WarehouseTaskServices.correct#LotMetadata (an extension of the expiry needs the quality manager's lot
    expiry permission and releases no quarantine), and the lot's corrections are listed with their old and new values
    (ironstone.warehouse.AdjustmentServices.get#LotCorrections). An expired or near-expiry lot's stock offers Scrap (P6). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Lots" default-menu-index="3">
    <parameter name="lotId"/>
    <parameter name="text"/>
    <parameter name="expiry"/>
    <parameter name="pageIndex"/>
    <transition-include name="inventoryChoices" location="component://mr-boss/template/WarehouseInventoryParts.xml"/>
    <transition name="createLot">
        <actions>
            <service-call name="ironstone.warehouse.InventoryServices.create#Lot"
                    in-map="{lotNumber:lotNumber, mfgPartyId:mfgPartyId, manufacturedDate:manufacturedDate || null,
                        expirationDate:expirationDate || null}"
                    out-map="created"/>
            <set field="lotId" from="created?.lotId"/>
        </actions>
        <default-response url=".">
            <parameter name="lotId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="correctLot">
        <actions>
            <service-call name="ironstone.warehouse.AccessServices.check#Record" in-map="{recordType:'lot', recordId:lotId}"/>
            <service-call name="mantle.shipment.WarehouseTaskServices.correct#LotMetadata" out-map="corrected"
                    in-map="{operationKey:operationKey, lotId:lotId, lotNumber:lotNumber || null, mfgPartyId:mfgPartyId || null,
                        manufacturedDate:manufacturedDate || null, expirationDate:expirationDate || null,
                        clearExpirationDate:clearExpirationDate == 'Y', changeReason:changeReason}"/>
            <set field="correctedText" from="(corrected.result.alreadyApplied ? 'Already corrected: ' : 'Corrected: ') +
                    corrected.result.changes.map(change =&gt; change.field + ' ' + (change.oldValue || 'none') + ' to ' +
                        (change.newValue || 'none')).join(', ')"/>
            <message type="success">${correctedText}</message>
        </actions>
        <default-response url=".">
            <parameter name="lotId"/>
        </default-response>
        <error-response url=".">
            <parameter name="lotId"/>
        </error-response>
    </transition>
    <actions>
        <service-call name="ironstone.warehouse.InventoryServices.find#Lots"
                in-map="{text:text, expiry:expiry, pageIndex:pageIndex, pageNoLimit:pageNoLimit}" out-map="context"/>
        <set field="lotFound" from="false"/>
        <if condition="lotId">
            <service-call name="ironstone.warehouse.InventoryServices.get#LotDetail" in-map="{lotId:lotId}" out-map="context"
                    transaction="force-new" ignore-error="true"/>
            <set field="lotFound" from="!!lot"/>
            <if condition="lotFound">
                <service-call name="ironstone.warehouse.AdjustmentServices.get#LotCorrections" in-map="{lotId:lotId}"
                        out-map="corrections" transaction="force-new" ignore-error="true"/>
            </if>
        </if>
        <set field="correctionRows" from="corrections?.correctionRows || []"/>
        <set field="canCorrect" from="!!(warehouse.capabilities.adjust || warehouse.capabilities.lotExpiryExtend)"/>
        <set field="expiring" from="lotFound &amp;&amp; ['negative', 'warning'].includes(lot.expiryColor)"/>
        <set field="correctHint" from="'Only the fields you fill change. Extending the expiry needs the quality ' +
                'manager\'s permission and releases no quarantine.'"/>
        <!-- the operation key of this page's correction form (a token, not a record id) -->
        <set field="correctOperationKey" from="'lot-' + ec.user.randomString(24)"/>
    </actions>
    <widgets>
        <context title="Lots" selection-form="LotList"/>
        <container style="row items-center q-gutter-sm q-mb-sm">
            <container-dialog id="NewLotDialog" condition="warehouse.capabilities.receive" type="primary" button-text="New lot"
                    icon="sym_o_add" title="New lot" width="640">
                <form-single name="NewLot" transition="createLot">
                    <field name="lotNumber">
                        <default-field title="Lot number">
                            <text-line size="30"/>
                        </default-field>
                    </field>
                    <field name="mfgPartyId">
                        <default-field title="Manufacturer" tooltip="Leave empty for your own lots">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="inventoryChoices" server-search="true" min-length="0"
                                        parameter-map="{choice:'manufacturers'}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="manufacturedDate">
                        <default-field title="Manufactured">
                            <date-time type="date"/>
                        </default-field>
                    </field>
                    <field name="expirationDate">
                        <default-field title="Expires">
                            <date-time type="date"/>
                        </default-field>
                    </field>
                    <field name="submitButton">
                        <default-field title="Create lot">
                            <submit/>
                        </default-field>
                    </field>
                    <field-layout>
                        <field-row>
                            <field-ref name="lotNumber"/>
                            <field-ref name="mfgPartyId"/>
                        </field-row>
                        <field-row>
                            <field-ref name="manufacturedDate"/>
                            <field-ref name="expirationDate"/>
                        </field-row>
                        <field-ref name="submitButton"/>
                    </field-layout>
                </form-single>
            </container-dialog>
        </container>
        <container style="row q-col-gutter-md">
            <container style="col-12 col-md-6">
                <container-box>
                    <box-header title="Lots"/>
                    <box-body-nopad>
                        <form-list name="LotList" list="lotList" skip-form="true" paginate="true" header-dialog="true"
                                show-csv-button="true">
                            <field name="text">
                                <header-field title="Lot number">
                                    <text-line/>
                                </header-field>
                                <default-field>
                                    <ignored/>
                                </default-field>
                            </field>
                            <field name="expiry">
                                <header-field title="Expiry">
                                    <drop-down allow-empty="true">
                                        <option key="expired" text="Expired"/>
                                        <option key="near" text="Expiring within 30 days"/>
                                        <option key="none" text="No expiry date"/>
                                    </drop-down>
                                </header-field>
                                <default-field>
                                    <ignored/>
                                </default-field>
                            </field>
                            <field name="lotNumber">
                                <header-field title="Lot"/>
                                <default-field>
                                    <link url="." text="${lotNumber}" link-type="anchor"
                                            parameter-map="{lotId:lotId, text:text || '', expiry:expiry || ''}"/>
                                </default-field>
                            </field>
                            <field name="mfgName">
                                <header-field title="Manufacturer"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="expiryText">
                                <header-field title="Expiry"/>
                                <default-field>
                                    <render-mode>
                                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                                            expiryColor}">${WebUtilities.encodeHtml(expiryText || 'No expiry')}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong",
                                            text: expiryText || 'No expiry'})}]]></text>
                                        <text type="html">${expiryText || 'No expiry'}</text>
                                    </render-mode>
                                </default-field>
                            </field>
                            <field name="quantityOnHand" align="right">
                                <header-field title="On hand"/>
                                <default-field>
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="lotNumber"/>
                                    <field-ref name="mfgName"/>
                                </column>
                                <column>
                                    <field-ref name="expiryText"/>
                                    <field-ref name="quantityOnHand"/>
                                </column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </container>
            <container style="col-12 col-md-6">
                <section name="NoLotChosen" condition="!lotFound">
                    <widgets>
                        <label text="Choose a lot to see where its stock is." type="p" style="m-muted" condition="!lotId"/>
                        <label
                                text="Lot ${lotId} is not available: it does not exist, or its stock is not in your facilities."
                                type="p" condition="lotId"/>
                    </widgets>
                </section>
                <section name="LotStock" condition="lotFound">
                    <widgets>
                        <container-box>
                            <box-header title="Lot ${lot.lotNumber}"/>
                            <box-toolbar>
                                <link url="../Traceability" text="Trace" link-type="anchor-button" icon="sym_o_account_tree"
                                        parameter-map="{rootType:'lot', rootId:lotId}"/>
                                <link url="../Movements" text="Movements" link-type="anchor-button" icon="sym_o_swap_horiz"
                                        parameter-map="{lotId:lotId}"/>
                                <container-dialog id="CorrectLotDialog" condition="canCorrect" button-text="Correct"
                                        icon="sym_o_edit" title="Correct lot ${lot.lotNumber}" width="640">
                                    <label text="${correctHint}" type="p" style="text-caption"/>
                                    <form-single name="CorrectLot" transition="correctLot"
                                            map="{lotId:lotId, operationKey:correctOperationKey}">
                                        <field name="lotId">
                                            <default-field>
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="operationKey">
                                            <default-field>
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="lotNumber">
                                            <default-field title="Lot number">
                                                <text-line size="30"/>
                                            </default-field>
                                        </field>
                                        <field name="mfgPartyId">
                                            <default-field title="Manufacturer">
                                                <drop-down allow-empty="true">
                                                    <dynamic-options transition="inventoryChoices" server-search="true"
                                                            min-length="0" parameter-map="{choice:'manufacturers'}"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="manufacturedDate">
                                            <default-field title="Manufactured">
                                                <date-time type="date"/>
                                            </default-field>
                                        </field>
                                        <field name="expirationDate">
                                            <default-field title="Expires">
                                                <date-time type="date"/>
                                            </default-field>
                                        </field>
                                        <field name="clearExpirationDate">
                                            <default-field title="No expiry">
                                                <check>
                                                    <option key="Y" text="Remove the expiry date"/>
                                                </check>
                                            </default-field>
                                        </field>
                                        <field name="changeReason">
                                            <default-field title="Reason">
                                                <text-line size="50"/>
                                            </default-field>
                                        </field>
                                        <field name="submitButton">
                                            <default-field title="Save correction">
                                                <submit/>
                                            </default-field>
                                        </field>
                                        <field-layout>
                                            <field-row>
                                                <field-ref name="lotNumber"/>
                                                <field-ref name="mfgPartyId"/>
                                            </field-row>
                                            <field-row>
                                                <field-ref name="manufacturedDate"/>
                                                <field-ref name="expirationDate"/>
                                            </field-row>
                                            <field-ref name="clearExpirationDate"/>
                                            <field-ref name="changeReason"/>
                                            <field-ref name="submitButton"/>
                                        </field-layout>
                                    </form-single>
                                </container-dialog>
                                <link url="${sharedLinks['Shipping/LabelSheet']}" text="Lot label" link-type="anchor-button"
                                        icon="sym_o_barcode" target-window="_blank"
                                        parameter-map="{kind:'lot', ids:lotId, renderMode:'html-print'}"/>
                            </box-toolbar>
                            <box-body>
                                <label
                                        text="${[lot.mfgName,
                                            lot.manufacturedDateText ? 'Manufactured ' + lot.manufacturedDateText : '',
                                        lot.expiryText].filter(Boolean).join(' · ')}" type="p" style="text-caption m-muted"/>
                                <section-iterate name="LotProduct" list="lotProducts" entry="lotProduct">
                                    <widgets>
                                        <link url="../Availability" text="Stock of ${lotProduct.productName}"
                                                link-type="anchor-button" icon="sym_o_inventory_2"
                                                parameter-map="{productId:lotProduct.productId}"/>
                                        <link url="../Product360" text="${lotProduct.productName}" link-type="anchor-button"
                                                icon="sym_o_info" parameter-map="{productId:lotProduct.productId}"/>
                                    </widgets>
                                </section-iterate>
                                <label text="This lot has no stock in your facilities." type="p"
                                        condition="!lotStockRows.length"/>
                                <form-list name="LotStockList" list="lotStockRows" skip-form="true" paginate="false">
                                    <field name="assetId">
                                        <default-field title="Asset">
                                            <link url="../AssetDetail" text="${assetId}" link-type="anchor"
                                                    parameter-map="{assetId:assetId}"/>
                                        </default-field>
                                    </field>
                                    <field name="placeText" from="[facilityName, locationSeqId].filter(Boolean).join(' · ')">
                                        <default-field title="Location">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="statusText">
                                        <default-field title="Status">
                                            <render-mode>
                                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                                                    statusColor}">${WebUtilities.encodeHtml(statusText)}</q-chip>]]></text>
                                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong",
                                                    text: statusText})}]]></text>
                                                <text type="html">${statusText}</text>
                                            </render-mode>
                                        </default-field>
                                    </field>
                                    <field name="quantityOnHand" align="right">
                                        <default-field title="On hand">
                                            <display format="#,##0.###"/>
                                        </default-field>
                                    </field>
                                    <!-- the expiry list's Scrap: the adjustment task's Scrap dialog with this asset (P6) -->
                                    <field name="scrap" hide="!(expiring &amp;&amp; warehouse.capabilities.adjust)">
                                        <conditional-field
                                                condition="quantityOnHand &gt; 0 &amp;&amp; statusId != 'AstQuarantine'">
                                            <link url="../Adjustments" text="Scrap" link-type="anchor" icon="sym_o_delete"
                                                    parameter-map="{assetId:assetId, _openDialog:'ScrapDialog'}"/>
                                        </conditional-field>
                                        <default-field title="">
                                            <display text=""/>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column>
                                            <field-ref name="assetId"/>
                                            <field-ref name="placeText"/>
                                        </column>
                                        <column>
                                            <field-ref name="statusText"/>
                                            <field-ref name="quantityOnHand"/>
                                            <field-ref name="scrap"/>
                                        </column>
                                    </columns>
                                </form-list>
                                <label text="Corrections" type="h6" condition="correctionRows.length"/>
                                <form-list name="LotCorrections" list="correctionRows" skip-form="true" paginate="false">
                                    <field name="changedDateText">
                                        <default-field title="When">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="fieldText">
                                        <default-field title="Field">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="oldValueText">
                                        <default-field title="Was">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="newValueText">
                                        <default-field title="Now">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="changeReason">
                                        <default-field title="Reason">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="userText">
                                        <default-field title="By">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column>
                                            <field-ref name="fieldText"/>
                                            <field-ref name="changeReason"/>
                                        </column>
                                        <column>
                                            <field-ref name="newValueText"/>
                                            <field-ref name="changedDateText"/>
                                        </column>
                                    </columns>
                                </form-list>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
            </container>
        </container>
    </widgets>
</screen>
