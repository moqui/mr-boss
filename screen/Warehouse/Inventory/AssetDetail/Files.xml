<!-- AssetDetail's files (WH-RECORD-HOSTS): the asset's AssetContent files, through the shared record files panel, which
    checks the asset is one the user sees (get#RecordLinkInfo). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Files" default-menu-index="4" server-static="qvt">
    <parameter name="assetId" required="true"/>
    <widgets>
        <record-files id="WarehouseAssetFiles" record-entity="mantle.product.asset.Asset" record-id="${assetId}"/>
    </widgets>
</screen>
