<!-- The Reports area of IronStone Warehouse (design-warehouse §14): CountVariance (P10); stock at a date, valuation and
    operations history come with their phase. Every Warehouse user opens the area; each report's service decides what it
    shows them (CountVariance: count reviewers and adjusters). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Reports" default-menu-index="12" menu-image="sym_o_bar_chart" menu-image-type="icon">
    <subscreens default-item="CountVariance" always-use-full-path="true"/>
    <widgets>
        <subscreens-panel id="ReportsPanel" type="tab"/>
    </widgets>
</screen>
