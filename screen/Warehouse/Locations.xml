<!-- The Locations area of IronStone Warehouse (design-warehouse §12): Facilities, the user's facilities as a list and a
    tree by parent; FacilityDetail, the shared facility screen with the Warehouse context; and EquipmentDetail, the shared
    equipment screen with the Warehouse context; and PutawayRules, the facility's putaway rules with a rule test. Box types (P12),
    Carriers and Printers (P13), and the printer test page, each a file under Locations/. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Locations" default-menu-index="10" menu-image="sym_o_domain" menu-image-type="icon">
    <subscreens default-item="Facilities" always-use-full-path="true">
        <subscreens-item name="FacilityDetail" location="component://mr-boss/screen/Shared/FacilityDetail.xml"
                menu-include="false"/>
        <subscreens-item name="EquipmentDetail" location="component://mr-boss/screen/Shared/EquipmentDetail.xml"
                menu-include="false"/>
        <subscreens-item name="PrinterTestPage" location="component://mr-boss/screen/Warehouse/Locations/PrinterTestPage.xml"
                menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="LocationsPanel" type="tab"/>
    </widgets>
</screen>
