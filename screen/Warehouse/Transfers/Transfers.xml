<!-- Transfers between facilities (design-warehouse §8 Transfers): Move opens this page for a move to another facility, which
    is a transfer shipment rather than a change of location. The transfer list and its shipments are not built yet; until
    they are the page says so and leads back to Move. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Transfers" default-menu-index="1" default-menu-include="false">
    <widgets>
        <container-box>
            <box-header title="Transfers between facilities"/>
            <box-body>
                <label text="Stock goes to another facility on a transfer shipment, which ships from one facility and is
                        received at the other. Transfer shipments cannot be made here yet." type="p"/>
                <link url="../Move" text="Back to Move" link-type="anchor" icon="arrow_back"/>
            </box-body>
        </container-box>
    </widgets>
</screen>
