<!-- NewStockRequest as the shell's quick create (design-warehouse §1 shell providers, §8 StockRequests): the
    NewStockRequest form, then RequestDetail. Open to every Warehouse user: a stock request names one of the user's
    facilities (create#Request's RqtInventory validation), and approval and allocation need their own permissions. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="New stock request" default-menu-include="false">
    <transition-include name="transferChoices" location="component://mr-boss/template/WarehouseTransferParts.xml"/>
    <transition-include name="createStockRequest" location="component://mr-boss/template/WarehouseTransferParts.xml"/>
    <widgets>
        <label text="Ask for stock" type="h6"/>
        <section-include name="NewStockRequestForm" location="component://mr-boss/template/WarehouseTransferParts.xml"/>
    </widgets>
</screen>
