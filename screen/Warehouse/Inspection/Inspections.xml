<!-- Inspections (design-warehouse §5 Inspections; style-guide §3.2 List): InspectionFind (the list's header dialog) and
    InspectionList, the open inspections of the user's facilities with their held quantity and next step
    (ironstone.warehouse.InspectionServices.get#InspectionList over Mantle's find#Inspections), as a list or a board by
    status or by inspector. Moving a card assigns work only (to another inspector; a move to another status goes back with
    the reason), and Reassign gives the selected inspections to one inspector, naming each result. There is no bulk
    acceptance: each inspection has its own readings and disposition. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Inspections" default-menu-index="1">
    <parameter name="facilityId"/>
    <parameter name="statusId"/>
    <parameter name="productId"/>
    <parameter name="inspectorPartyId"/>
    <parameter name="sourceTypeEnumId"/>
    <parameter name="assignedOnly"/>
    <parameter name="openOnly"/>
    <transition-include name="choices" location="component://mr-boss/template/WarehouseParts.xml"/>
    <transition-include name="inspectionChoices" location="component://mr-boss/template/WarehouseInspectionParts.xml"/>
    <transition-include name="moveInspection" location="component://mr-boss/template/WarehouseInspectionParts.xml"/>
    <transition-include name="reassignInspections" location="component://mr-boss/template/WarehouseInspectionParts.xml"/>
    <actions>
        <set field="listFacilityId" from="facilityId || warehouse.facilityId"/>
        <!-- the list and its page fields come from the service -->
        <service-call name="ironstone.warehouse.InspectionServices.get#InspectionList" out-map="context"
                transaction="force-new" ignore-error="true"
                in-map="{facilityId:listFacilityId, statusId:statusId, productId:productId, inspectorPartyId:inspectorPartyId,
                    sourceTypeEnumId:sourceTypeEnumId, assignedOnly:assignedOnly, openOnly:openOnly, pageIndex:pageIndex,
                    pageSize:pageSize, pageNoLimit:pageNoLimit}"/>
        <set field="inspections" from="inspections || []"/>
        <set field="canAssign" from="!!canAssign"/>
        <set field="filtered" from="!!(statusId || productId || inspectorPartyId || sourceTypeEnumId || assignedOnly)"/>
    </actions>
    <widgets>
        <container style="row items-center q-gutter-sm q-mb-sm">
            <label text="Inspections" type="h5"/>
            <link url="." text="Assigned to me" link-type="anchor" icon="sym_o_person" condition="assignedOnly != 'Y'"
                    parameter-map="{facilityId:listFacilityId || '', assignedOnly:'Y'}"/>
            <link url="." text="All open" link-type="anchor" condition="assignedOnly == 'Y'"
                    parameter-map="{facilityId:listFacilityId || ''}"/>
            <link url="${sharedLinks['Inspection/InspectionTemplates']}" text="Inspection templates" link-type="anchor"
                    icon="sym_o_rule"/>
        </container>
        <form-list name="InspectionList" list="inspections" skip-form="true" header-dialog="true" select-columns="true"
                show-csv-button="true">
            <row-selection id-field="qualityInspectionId" parameter="qualityInspectionIdList" list-mode="true"
                    condition="canAssign">
                <action>
                    <dialog button-text="Reassign" title="Assign the selected inspections"/>
                    <form-single name="ReassignInspections" transition="reassignInspections"
                            map="{facilityId:listFacilityId}">
                        <field name="facilityId">
                            <default-field>
                                <hidden/>
                            </default-field>
                        </field>
                        <field name="inspectorPartyId">
                            <default-field title="Inspector" tooltip="Empty leaves them unassigned">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="inspectionChoices" server-search="true" min-length="0"
                                            parameter-map="{choice:'inspectors'}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="submit">
                            <default-field title="">
                                <submit text="Assign"/>
                            </default-field>
                        </field>
                    </form-single>
                </action>
            </row-selection>
            <field name="qualityInspectionId">
                <header-field title="Inspection">
                    <text-find size="10" hide-options="true"/>
                </header-field>
                <default-field title="Inspection">
                    <link url="${sharedLinks['QualityInspection']}" text="${qualityInspectionId}" link-type="anchor"
                            parameter-map="{qualityInspectionId:qualityInspectionId}"/>
                </default-field>
            </field>
            <field name="productId">
                <header-field title="Product">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="inspectionChoices" server-search="true" min-length="0"
                                parameter-map="{choice:'products', selected:productId}"/>
                    </drop-down>
                </header-field>
                <default-field title="Product">
                    <display text="${productName}${lotNumber ? ' · lot ' + lotNumber : ''}"/>
                </default-field>
            </field>
            <field name="sourceTypeEnumId">
                <header-field title="Source">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="inspectionChoices" parameter-map="{choice:'sourceTypes'}"/>
                    </drop-down>
                </header-field>
                <default-field title="Source">
                    <display text="${sourceText}"/>
                </default-field>
            </field>
            <field name="facilityId">
                <header-field title="Facility">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'facilities', selected:facilityId}"/>
                    </drop-down>
                </header-field>
                <default-field title="Facility">
                    <display text="${facilityName}"/>
                </default-field>
            </field>
            <field name="statusId">
                <header-field title="Status">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="inspectionChoices" parameter-map="{choice:'statuses'}"/>
                    </drop-down>
                </header-field>
                <default-field title="Status">
                    <render-mode>
                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                            statusColor}">${WebUtilities.encodeHtml(statusText)}</q-chip>]]></text>
                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong", text: statusText})}]]></text>
                        <text type="html">${statusText}</text>
                    </render-mode>
                </default-field>
            </field>
            <field name="resultText">
                <default-field title="Outcome">
                    <display/>
                </default-field>
            </field>
            <field name="quantityText" align="right">
                <default-field title="Quantity">
                    <display/>
                </default-field>
            </field>
            <field name="sampleSize" align="right">
                <default-field title="Sample">
                    <display format="#,##0.###"/>
                </default-field>
            </field>
            <field name="inspectorPartyId">
                <header-field title="Inspector">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="inspectionChoices" server-search="true" min-length="0"
                                parameter-map="{choice:'inspectors', selected:inspectorPartyId}"/>
                    </drop-down>
                </header-field>
                <default-field title="Inspector">
                    <display text="${inspectorName || 'Unassigned'}"/>
                </default-field>
            </field>
            <field name="dueText">
                <default-field title="Due">
                    <display/>
                </default-field>
            </field>
            <field name="openOnly">
                <header-field title="Closed too">
                    <check>
                        <option key="N" text=" "/>
                    </check>
                </header-field>
                <default-field>
                    <ignored/>
                </default-field>
            </field>
            <field name="submitButton">
                <header-field title="Find">
                    <submit/>
                </header-field>
                <default-field>
                    <ignored/>
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="qualityInspectionId"/>
                    <field-ref name="productId"/>
                </column>
                <column>
                    <field-ref name="statusId"/>
                    <field-ref name="quantityText"/>
                </column>
            </columns>
            <view-board group-fields="statusId,inspectorPartyId" card-title-field="qualityInspectionId"
                    card-fields="productId,quantityText,dueText" key-fields="qualityInspectionId"
                    status-type-id="QualityInspection" transition="moveInspection" move-condition="canAssign"/>
        </form-list>
        <section name="NoInspections" condition="!inspections.length">
            <widgets>
                <container style="q-pa-sm">
                    <label text="No open inspection matches. A receipt that needs inspection lands in quarantine and creates
                            its inspection here." type="p" style="m-muted q-mb-xs"/>
                    <link url="." text="Clear filters" link-type="anchor" condition="filtered"/>
                </container>
            </widgets>
        </section>
    </widgets>
</screen>
