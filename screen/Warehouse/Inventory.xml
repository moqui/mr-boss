<!-- The Inventory area of IronStone Warehouse (design-warehouse §6): the stock assets, the stock ledger, lots, containers and
    traceability, each limited to the user's facilities (ironstone.warehouse.InventoryServices). An asset's and a
    container's detail open from the lists; Products' Shared/Product360 and Shared/InventoryAvailability are mounted with
    the Warehouse context (Products' get#SharedContext Warehouse branch) and open from a product; Shared/MaterialIssueReceipt
    (P12: a shipment's pick assembly) opens from Pack. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Inventory" default-menu-index="4" menu-image="sym_o_inventory" menu-image-type="icon"
        server-static="qvt">
    <subscreens default-item="Assets" always-use-full-path="true">
        <subscreens-item name="Availability" location="component://mr-boss/screen/Shared/InventoryAvailability.xml"
                menu-include="false"/>
        <subscreens-item name="Product360" location="component://mr-boss/screen/Shared/Product360.xml" menu-include="false"/>
        <subscreens-item name="MaterialIssueReceipt" location="component://mr-boss/screen/Shared/MaterialIssueReceipt.xml"
                menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="InventoryPanel" type="tab"/>
    </widgets>
</screen>
