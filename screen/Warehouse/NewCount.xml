<!-- NewCount as the shell's quick create (design-warehouse §3 Home's quick create, §7 Counts; impl-warehouse P18): the plan
    a count form of Counts' New count, then Counts/CountDetail. Its artifact group opens it to the count group only
    (BOSS_WH_NEW_COUNT), so quick create offers it only to users who may plan a count (create#Count needs STOCK_COUNT); it
    is under the root because the Counts area's grants to the count reviewer and adjust groups would open it to them. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="New count" default-menu-include="false" server-static="qvt">
    <transition-include name="choices" location="component://mr-boss/template/WarehouseParts.xml"/>
    <transition-include name="countChoices" location="component://mr-boss/template/WarehouseCountParts.xml"/>
    <transition-include name="inventoryChoices" location="component://mr-boss/template/WarehouseInventoryParts.xml"/>
    <transition-include name="facilityChoices" location="component://mr-boss/template/WarehouseFacilityParts.xml"/>
    <transition-include name="createCount" location="component://mr-boss/template/WarehouseCountParts.xml"/>
    <actions>
        <set field="newCountParams" from="{facilityId:warehouse.facilityId, countModeEnumId:'CntModeCycle'}"/>
    </actions>
    <widgets>
        <label text="Plan a count" type="h6"/>
        <section-include name="NewCountForm" location="component://mr-boss/template/WarehouseCountParts.xml"/>
    </widgets>
</screen>
