<!-- Warehouse stock policies (design-warehouse StockPolicies): the operation policy, the tracking defaults, the product
    tracking exceptions, the policy preview and the count schedule (P10), for a facility or, with none chosen, the
    organization's default. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Stock policies" default-menu-index="2">
    <parameter name="facilityId"/>
    <parameter name="organizationPartyId"/>
    <transition-include name="choices" location="component://mr-boss/template/WarehouseParts.xml"/>
    <transition-include name="policyChoices" location="component://mr-boss/template/WarehousePolicyParts.xml"/>
    <subscreens default-item="OperationPolicy"/>
    <widgets>
        <section-include name="PolicyScope" location="component://mr-boss/template/WarehousePolicyParts.xml"/>
        <subscreens-menu id="StockPolicyTabs" type="tab"/>
        <subscreens-active/>
    </widgets>
</screen>
