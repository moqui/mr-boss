<!-- An asset pool (design-warehouse AssetPools; style-guide §3.3 Detail): its header (PoolHeader), the parties that may
    consume its stock (PoolParties) and the stores that may (PoolStores), each between its dates, and the open reservations
    on its stock with whether each order still qualifies (ironstone.warehouse.PolicyServices.get#PoolDetail). A manager
    changes them through mantle.product.AssetPoolServices; a change never reaches back before now, and ending a member
    moves no reservation: the preview names those it leaves unqualified. A pool the user may not see is "not available". -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Pool" default-menu-include="false">
    <parameter name="assetPoolId"/>
    <transition-include name="policyChoices" location="component://mr-boss/template/WarehousePolicyParts.xml"/>
    <transition name="savePool">
        <actions>
            <service-call name="mantle.product.AssetPoolServices.store#AssetPool" in-map="context"/>
        </actions>
        <default-response url=".">
            <parameter name="assetPoolId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="storePoolParty">
        <actions>
            <service-call name="mantle.product.AssetPoolServices.store#AssetPoolParty" in-map="context"/>
        </actions>
        <default-response url=".">
            <parameter name="assetPoolId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="storePoolStore">
        <actions>
            <service-call name="mantle.product.AssetPoolServices.store#AssetPoolStore" in-map="context"/>
        </actions>
        <default-response url=".">
            <parameter name="assetPoolId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="ironstone.warehouse.PolicyServices.get#PoolDetail"
                in-map="{appRoot:appRoot, assetPoolId:assetPoolId}"
                out-map="detail" transaction="force-new" ignore-error="true"/>
        <set field="recordFound" from="!!detail?.pool"/>
        <set field="pool" from="detail?.pool || {}"/>
        <set field="partyRows" from="detail?.partyRows || []"/>
        <set field="storeRows" from="detail?.storeRows || []"/>
        <set field="reservationRows" from="detail?.reservationRows || []"/>
        <set field="canManage" from="!!detail?.canManage"/>
        <set field="newMember" from="{assetPoolId:assetPoolId}"/>
    </actions>
    <widgets>
        <section name="PoolNotAvailable" condition="!recordFound">
            <widgets>
                <container-box type="warning">
                    <box-header title="Pool not available"/>
                    <box-body>
                        <label text="Pool ${assetPoolId || ''} does not exist, or you may not see it." type="p"/>
                        <link url="../PoolList" text="Back to asset pools" link-type="anchor"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="PoolFound" condition="recordFound">
            <widgets>
                <link url="../PoolList" text="Asset pools" link-type="anchor" icon="arrow_back"/>
                <container style="m-record-header">
                    <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                        <container style="col-12 col-md m-record-title">
                            <container style="row items-center no-wrap">
                                <render-mode>
                                    <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none q-mr-sm text-mono">${
                                        WebUtilities.encodeHtml(pool.pseudoId)}</q-chip>]]></text>
                                    <text type="tui"><![CDATA[${JSON.stringify({t: "text", id: "PoolKey", style: "strong",
                                        text: pool.pseudoId})}]]></text>
                                </render-mode>
                                <label text="${pool.description || pool.pseudoId}" type="h5"/>
                            </container>
                        </container>
                    </container>
                    <container style="row items-center q-col-gutter-x-md q-col-gutter-y-sm m-record-foot">
                        <container style="col-12 col-md">
                            <label text="${pool.ownerName} · ${partyRows.length} parties · ${storeRows.length} stores"
                                    type="p" style="q-mb-none"/>
                        </container>
                        <container style="col-12 col-md-auto row items-center q-gutter-sm m-record-actions">
                            <container-dialog id="EditPool" button-text="Edit pool" title="Edit pool ${pool.pseudoId}"
                                    icon="sym_o_edit" condition="canManage">
                                <form-single name="EditPoolForm" transition="savePool" map="pool">
                                    <field name="assetPoolId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="pseudoId">
                                        <default-field title="Pool ID">
                                            <text-line size="20"/>
                                        </default-field>
                                    </field>
                                    <field name="description">
                                        <default-field title="Name">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="changeReason">
                                        <default-field title="Reason">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="submitButton">
                                        <default-field title="Save pool">
                                            <submit/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </container-dialog>
                        </container>
                    </container>
                </container>
                <container-box>
                    <box-header title="Parties that may consume this stock"/>
                    <box-toolbar>
                        <container-dialog id="AddParty" button-text="Add party" type="primary"
                                title="Add a party to pool ${pool.pseudoId}" icon="sym_o_add" condition="canManage">
                            <form-single name="AddPartyForm" transition="storePoolParty" map="newMember">
                                <field name="assetPoolId">
                                    <default-field>
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="partyId">
                                    <default-field title="Party">
                                        <drop-down allow-empty="true">
                                            <dynamic-options transition="policyChoices" server-search="true" min-length="0"
                                                    parameter-map="{choice:'parties'}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="roleTypeId">
                                    <default-field title="May consume as">
                                        <drop-down allow-empty="true" no-current-selected-key="">
                                            <option key="" text="Vendor or customer"/>
                                            <option key="Customer" text="Customer"/>
                                            <option key="Vendor" text="Vendor"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="fromDate">
                                    <default-field title="From" tooltip="Empty starts now">
                                        <date-time/>
                                    </default-field>
                                </field>
                                <field name="thruDate">
                                    <default-field title="Through" tooltip="Empty is open">
                                        <date-time/>
                                    </default-field>
                                </field>
                                <field name="changeReason">
                                    <default-field title="Reason">
                                        <text-line/>
                                    </default-field>
                                </field>
                                <field name="submitButton">
                                    <default-field title="Add party">
                                        <submit/>
                                    </default-field>
                                </field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body>
                        <label text="No party may consume this pool's stock yet." type="p" condition="!partyRows.length"/>
                <form-list name="PoolPartys" list="partyRows" skip-form="true" paginate="false">
                    <field name="partyName">
                        <default-field title="Party">
                            <display/>
                        </default-field>
                    </field>
                    <field name="roleText">
                        <default-field title="As">
                            <display/>
                        </default-field>
                    </field>
                    <field name="fromDateText">
                        <default-field title="From">
                            <display/>
                        </default-field>
                    </field>
                    <field name="thruDateText">
                        <default-field title="Through">
                            <display/>
                        </default-field>
                    </field>
                    <field name="stateText">
                        <default-field title="State">
                            <display/>
                        </default-field>
                    </field>
                    <field name="actions">
                        <default-field title="">
                            <container-dialog id="EditParty_${rowKey}" button-text="Change"
                                    title="Change ${partyName} in pool ${pool.pseudoId}" condition="canManage">
                                <form-single name="EditParty_${rowKey}" transition="storePoolParty">
                                    <field name="assetPoolId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="partyId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="roleTypeId">
                                        <default-field title="May consume as">
                                            <drop-down allow-empty="true" no-current-selected-key="">
                                                <option key="" text="Vendor or customer"/>
                                                <option key="Customer" text="Customer"/>
                                                <option key="Vendor" text="Vendor"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="thruDate">
                                        <default-field title="Through" tooltip="Empty is open">
                                            <date-time/>
                                        </default-field>
                                    </field>
                                    <field name="changeReason">
                                        <default-field title="Reason">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="submitButton">
                                        <default-field title="Save">
                                            <submit/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </container-dialog>
                            <link url="storePoolParty" text="End" link-type="hidden-form" btn-type="danger"
                                    condition="canManage &amp;&amp; !ended"
                                    confirmation="End ${partyName} in pool ${pool.pseudoId} now? Reservations already made stay."
                                    parameter-map="{assetPoolId:assetPoolId, partyId:partyId, roleTypeId:roleTypeId, endNow:true,
                                        changeReason:'Ended from the pool'}"/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="partyName"/>
                            <field-ref name="stateText"/>
                        </column>
                        <column>
                            <field-ref name="thruDateText"/>
                            <field-ref name="actions"/>
                        </column>
                    </columns>
                </form-list>
                    </box-body>
                </container-box>
                <container-box>
                    <box-header title="Stores that may consume this stock"/>
                    <box-toolbar>
                        <container-dialog id="AddStore" button-text="Add store"
                                title="Add a store to pool ${pool.pseudoId}" icon="sym_o_add" condition="canManage">
                            <form-single name="AddStoreForm" transition="storePoolStore" map="newMember">
                                <field name="assetPoolId">
                                    <default-field>
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="productStoreId">
                                    <default-field title="Store">
                                        <drop-down allow-empty="true">
                                            <dynamic-options transition="policyChoices" server-search="true" min-length="0"
                                                    parameter-map="{choice:'stores'}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="fromDate">
                                    <default-field title="From" tooltip="Empty starts now">
                                        <date-time/>
                                    </default-field>
                                </field>
                                <field name="thruDate">
                                    <default-field title="Through" tooltip="Empty is open">
                                        <date-time/>
                                    </default-field>
                                </field>
                                <field name="changeReason">
                                    <default-field title="Reason">
                                        <text-line/>
                                    </default-field>
                                </field>
                                <field name="submitButton">
                                    <default-field title="Add store">
                                        <submit/>
                                    </default-field>
                                </field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body>
                        <label text="No store may consume this pool's stock yet." type="p" condition="!storeRows.length"/>
                <form-list name="PoolStores" list="storeRows" skip-form="true" paginate="false">
                    <field name="storeName">
                        <default-field title="Store">
                            <display/>
                        </default-field>
                    </field>
                    <field name="fromDateText">
                        <default-field title="From">
                            <display/>
                        </default-field>
                    </field>
                    <field name="thruDateText">
                        <default-field title="Through">
                            <display/>
                        </default-field>
                    </field>
                    <field name="stateText">
                        <default-field title="State">
                            <display/>
                        </default-field>
                    </field>
                    <field name="actions">
                        <default-field title="">
                            <container-dialog id="EditStore_${rowKey}" button-text="Change"
                                    title="Change ${storeName} in pool ${pool.pseudoId}" condition="canManage">
                                <form-single name="EditStore_${rowKey}" transition="storePoolStore">
                                    <field name="assetPoolId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="productStoreId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="thruDate">
                                        <default-field title="Through" tooltip="Empty is open">
                                            <date-time/>
                                        </default-field>
                                    </field>
                                    <field name="changeReason">
                                        <default-field title="Reason">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="submitButton">
                                        <default-field title="Save">
                                            <submit/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </container-dialog>
                            <link url="storePoolStore" text="End" link-type="hidden-form" btn-type="danger"
                                    condition="canManage &amp;&amp; !ended"
                                    confirmation="End ${storeName} in pool ${pool.pseudoId} now? Reservations already made stay."
                                    parameter-map="{assetPoolId:assetPoolId, productStoreId:productStoreId, endNow:true,
                                        changeReason:'Ended from the pool'}"/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="storeName"/>
                            <field-ref name="stateText"/>
                        </column>
                        <column>
                            <field-ref name="thruDateText"/>
                            <field-ref name="actions"/>
                        </column>
                    </columns>
                </form-list>
                    </box-body>
                </container-box>
                <container-box>
                    <box-header title="Open reservations on this stock"/>
                    <box-body>
                        <label text="No open reservation is on this pool's stock." type="p"
                                condition="!reservationRows.length"/>
                        <label text="${detail.unqualifiedCount} reservations are for orders that no longer qualify; they
                            stay until they are moved." type="p" style="text-warning" condition="detail?.unqualifiedCount"/>
                        <form-list name="PoolReservations" list="reservationRows" skip-form="true" paginate="false">
                            <field name="orderText">
                                <default-field title="Order item">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="productName">
                                <default-field title="Product">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="facilityName">
                                <default-field title="Facility">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="quantityText" align="right">
                                <default-field title="Reserved">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="qualifiesText">
                                <default-field title="Order">
                                    <display/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="orderText"/>
                                    <field-ref name="productName"/>
                                </column>
                                <column>
                                    <field-ref name="qualifiesText"/>
                                </column>
                            </columns>
                        </form-list>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
