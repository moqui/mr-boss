<!-- The asset pools of the user's organizations (design-warehouse AssetPools PoolList), searched by ID or description,
    with owner and members (ironstone.warehouse.PolicyServices.get#Pools); a manager creates one
    (mantle.product.AssetPoolServices.store#AssetPool). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Pools" default-menu-index="1" default-menu-include="false">
    <parameter name="term"/>
    <transition-include name="policyChoices" location="component://mr-boss/template/WarehousePolicyParts.xml"/>
    <transition name="createPool">
        <actions>
            <service-call name="mantle.product.AssetPoolServices.store#AssetPool"
                    in-map="{ownerPartyId:ownerPartyId, pseudoId:pseudoId, description:description,
                        changeReason:changeReason}"
                    out-map="created"/>
            <set field="assetPoolId" from="created.pool.assetPoolId"/>
        </actions>
        <default-response url="../PoolDetail">
            <parameter name="assetPoolId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="ironstone.warehouse.PolicyServices.get#Pools" in-map="{appRoot:appRoot, term:term}"
                out-map="found" transaction="force-new" ignore-error="true"/>
        <set field="poolRows" from="found?.poolRows || []"/>
        <set field="newPool" from="{ownerPartyId:warehouse.defaultOrganizationPartyId || null}"/>
    </actions>
    <widgets>
        <container-box>
            <box-header title="Asset pools"/>
            <box-toolbar>
                <container-dialog id="NewPool" button-text="New pool" type="primary" title="Set aside stock in a new pool"
                        condition="found?.canManage">
                    <form-single name="NewPoolForm" transition="createPool" map="newPool">
                        <field name="ownerPartyId">
                            <default-field title="Organization">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="policyChoices" server-search="true" min-length="0"
                                            parameter-map="{choice:'organizations', selected:ownerPartyId}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="pseudoId">
                            <default-field title="Pool ID">
                                <text-line size="20"/>
                            </default-field>
                        </field>
                        <field name="description">
                            <default-field title="Name">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="changeReason">
                            <default-field title="Reason">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="submitButton">
                            <default-field title="Create pool">
                                <submit/>
                            </default-field>
                        </field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <form-single name="FindPools" transition="." map="{term:term}">
                    <field name="term">
                        <default-field title="Find">
                            <text-find size="20" hide-options="true"/>
                        </default-field>
                    </field>
                    <field name="submitButton">
                        <default-field title="">
                            <submit text="Find"/>
                        </default-field>
                    </field>
                    <field-layout>
                        <field-row>
                            <field-ref name="term"/>
                            <field-ref name="submitButton"/>
                        </field-row>
                    </field-layout>
                </form-single>
                <label text="No stock is set aside in a pool. A pool keeps stock for the parties and stores you name."
                        type="p" condition="!poolRows.length"/>
                <label text="Only the first 100 pools are shown; narrow the search." type="p" condition="found?.truncated"/>
                <form-list name="PoolList" list="poolRows" skip-form="true" paginate="false">
                    <field name="pseudoId">
                        <default-field title="Pool">
                            <link url="../PoolDetail" text="${pseudoId}" link-type="anchor"
                                    parameter-map="{assetPoolId:assetPoolId}"/>
                        </default-field>
                    </field>
                    <field name="description">
                        <default-field title="Name">
                            <display/>
                        </default-field>
                    </field>
                    <field name="ownerName">
                        <default-field title="Organization">
                            <display/>
                        </default-field>
                    </field>
                    <field name="memberText">
                        <default-field title="Members">
                            <display/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="pseudoId"/>
                            <field-ref name="description"/>
                        </column>
                        <column>
                            <field-ref name="memberText"/>
                        </column>
                    </columns>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
