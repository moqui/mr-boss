<!-- Reservation check (design-warehouse ReservationPolicies ReservationCheck): the reservations at a facility that a
    repair would change, each named by its reason (mantle.facility.WarehousePolicyServices.preview#FacilityReservations,
    through ironstone.warehouse.PolicyServices.get#ReservationCheck), and its repair (impl-warehouse P5): a warehouse manager
    repairs what the check named through mantle.shipment.WarehouseTaskServices.repair#FacilityReservations, which refuses a
    check the reservations changed since and names each reservation it could not repair. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Reservation check" default-menu-index="3">
    <parameter name="productId"/>
    <transition-include name="choices" location="component://mr-boss/template/WarehouseParts.xml"/>
    <transition-include name="policyChoices" location="component://mr-boss/template/WarehousePolicyParts.xml"/>
    <transition name="repairReservations">
        <actions>
            <service-call name="ironstone.warehouse.AccessServices.check#Record"
                    in-map="{recordType:'facility', recordId:facilityId, capability:'policyManage'}"/>
            <service-call name="mantle.shipment.WarehouseTaskServices.repair#FacilityReservations" out-map="repaired"
                    in-map="{operationKey:operationKey, facilityId:facilityId, productId:productId || null,
                        previewFingerprint:previewFingerprint}"/>
            <message type="success">Repaired ${repaired.result.repairedCount} reservations</message>
            <iterate list="repaired.result.rows.filter(row =&gt; !row.ok)" entry="row">
                <message type="warning">Order item ${row.orderId}:${row.orderItemSeqId}: not repaired, ${row.message}</message>
            </iterate>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <actions>
        <set field="checkFacilityId" from="facilityId || warehouse.facilityId"/>
        <service-call name="ironstone.warehouse.PolicyServices.get#ReservationCheck"
                in-map="{appRoot:appRoot, facilityId:checkFacilityId, productId:productId}"
                out-map="check" transaction="force-new" ignore-error="true"/>
        <set field="findingRows" from="check?.findingRows || []"/>
        <set field="canRepair" from="!!(warehouse.capabilities.policyManage &amp;&amp; check &amp;&amp; findingRows.length)"/>
        <!-- the repair's operation key: a double submit is the same repair (a token, not a record id) -->
        <set field="repairOperationKey" from="'repair-' + ec.user.randomString(24)"/>
    </actions>
    <widgets>
        <container-box>
            <box-header title="Reservation check"/>
            <box-body>
                <form-single name="CheckFor" transition="." map="{facilityId:checkFacilityId, productId:productId}">
                    <field name="facilityId">
                        <default-field title="Facility">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'facilities', selected:checkFacilityId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="productId">
                        <default-field title="Product">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="policyChoices" server-search="true" min-length="0"
                                        parameter-map="{choice:'products', selected:productId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="submitButton">
                        <default-field title="">
                            <submit text="Check reservations"/>
                        </default-field>
                    </field>
                    <field-layout>
                        <field-row>
                            <field-ref name="facilityId"/>
                            <field-ref name="productId"/>
                            <field-ref name="submitButton"/>
                        </field-row>
                    </field-layout>
                </form-single>
                <label text="Choose a facility to check its reservations." type="p" condition="!checkFacilityId"/>
                <label text="This facility is not available to you." type="p" condition="checkFacilityId &amp;&amp; !check"/>
                <section name="Findings" condition="check &amp;&amp; checkFacilityId">
                    <widgets>
                        <label text="This check reads only; it changes no reservation." type="p" style="text-caption m-muted"/>
                        <container-dialog id="RepairReservationsDialog" condition="canRepair" type="primary"
                                button-text="Repair reservations" icon="sym_o_build"
                                title="Repair the ${findingRows.length} reservations named">
                            <label text="Each reservation is checked again and the order re-reserved on available stock, or
                                    moved onto it. One that cannot be repaired is named; the others are repaired." type="p"/>
                            <form-single name="RepairReservations" transition="repairReservations"
                                    map="{facilityId:checkFacilityId, productId:productId, operationKey:repairOperationKey,
                                        previewFingerprint:check.previewFingerprint}">
                                <field name="facilityId">
                                    <default-field>
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="productId">
                                    <default-field>
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="operationKey">
                                    <default-field>
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="previewFingerprint">
                                    <default-field>
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="submit">
                                    <default-field title="">
                                        <submit text="Repair reservations" confirmation="Repair the ${findingRows.length}
                                                reservations named?"/>
                                    </default-field>
                                </field>
                            </form-single>
                        </container-dialog>
                        <label text="All ${check.checkedCount} reservations checked are in order." type="p"
                                condition="!findingRows.length"/>
                        <label text="Only the first ${check.checkedCount} reservations were checked." type="p"
                                condition="check.truncated"/>
                        <form-list name="Findings" list="findingRows" skip-form="true" paginate="false">
                            <field name="orderText">
                                <default-field title="Order item">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="productName">
                                <default-field title="Product">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="assetId">
                                <default-field title="Asset">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="quantityText" align="right">
                                <default-field title="Reserved">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="reasonText">
                                <default-field title="Why">
                                    <display/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="orderText"/>
                                    <field-ref name="productName"/>
                                </column>
                                <column>
                                    <field-ref name="reasonText"/>
                                </column>
                            </columns>
                        </form-list>
                    </widgets>
                </section>
            </box-body>
        </container-box>
    </widgets>
</screen>
