<!-- The count schedule at a facility or the organization (design-warehouse StockPolicies CountSchedule; impl-warehouse §4):
    when locations or products come due for counting, each row's scope (a location type, area or location; or a product
    category or ABC class), kind (every few days, once a year on a date, or when stock reaches zero), count mode, blind
    default and assignee, with its dates (Mantle's find#CountSchedules). A manager adds a row, changes one (the row in effect
    ends where the change starts) or ends one, each with a reason (store#CountSchedule after check#Record of the facility
    with policyManage); Counts' Due list reads them. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Count schedule" default-menu-index="5">
    <parameter name="includeHistory"/>
    <transition-include name="countChoices" location="component://mr-boss/template/WarehouseCountParts.xml"/>
    <transition-include name="facilityChoices" location="component://mr-boss/template/WarehouseFacilityParts.xml"/>
    <transition name="storeCountSchedule">
        <actions>
            <if condition="facilityId">
                <service-call name="ironstone.warehouse.AccessServices.check#Record"
                        in-map="{recordType:'facility', recordId:facilityId, capability:'policyManage'}"/>
            </if>
            <service-call name="mantle.facility.WarehousePolicyServices.store#CountSchedule"
                    in-map="{countScheduleId:countScheduleId || null,
                        organizationPartyId:facilityId ? null : organizationPartyId || null, facilityId:facilityId || null,
                        locationTypeEnumId:locationTypeEnumId, areaId:areaId, locationSeqId:locationSeqId,
                        productCategoryId:productCategoryId, abcClassEnumId:abcClassEnumId,
                        scheduleKindEnumId:scheduleKindEnumId, frequencyDays:frequencyDays, annualMonth:annualMonth,
                        annualDay:annualDay, countModeEnumId:countModeEnumId, blindIndicator:blindIndicator,
                        assigneePartyId:assigneePartyId, fromDate:effectiveFromDate || null, endNow:endNow == 'Y',
                        changeReason:changeReason}"/>
            <message type="success">Count schedule saved</message>
        </actions>
        <default-response url=".">
            <parameter name="facilityId"/>
            <parameter name="organizationPartyId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="ironstone.warehouse.CountServices.get#CountSchedules" out-map="found" transaction="force-new"
                ignore-error="true"
                in-map="{appRoot:appRoot, facilityId:facilityId, organizationPartyId:organizationPartyId,
                    includeHistory:includeHistory}"/>
        <set field="scheduleRows" from="found?.schedules || []"/>
        <set field="scheduleAvailable" from="!!found?.available"/>
        <set field="canManage" from="!!found?.canManage"/>
        <set field="newParams" from="{facilityId:facilityId, organizationPartyId:organizationPartyId,
                scheduleKindEnumId:'CskPeriodic', countModeEnumId:'CntModeCycle'}"/>
    </actions>
    <widgets>
        <label text="${found?.message || 'The count schedule is not available to you.'}" type="p"
                condition="!scheduleAvailable"/>
        <section name="Schedule" condition="scheduleAvailable">
            <widgets>
                <container-box>
                    <box-header title="Count schedule at ${found.scopeText}"/>
                    <box-toolbar>
                        <container-dialog id="AddCountScheduleDialog" condition="canManage" type="primary"
                                button-text="Add schedule" icon="sym_o_add" title="Add a count schedule" width="760">
                            <form-single name="AddCountSchedule" transition="storeCountSchedule" map="newParams">
                                <field name="facilityId">
                                    <default-field>
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="organizationPartyId">
                                    <default-field>
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="scheduleKindEnumId">
                                    <default-field title="Comes due">
                                        <drop-down allow-empty="false">
                                            <dynamic-options transition="countChoices" parameter-map="{choice:'scheduleKinds'}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="frequencyDays">
                                    <default-field title="Every how many days" tooltip="For a count every few days">
                                        <text-line size="5" input-type="number"/>
                                    </default-field>
                                </field>
                                <field name="annualMonth">
                                    <default-field title="Month" tooltip="For a count once a year">
                                        <drop-down allow-empty="true">
                                            <dynamic-options transition="countChoices" parameter-map="{choice:'months'}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="annualDay">
                                    <default-field title="Day">
                                        <text-line size="3" input-type="number"/>
                                    </default-field>
                                </field>
                                <field name="locationTypeEnumId">
                                    <default-field title="Location type">
                                        <drop-down allow-empty="true">
                                            <dynamic-options transition="countChoices" parameter-map="{choice:'locationTypes'}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="areaId">
                                    <default-field title="Area">
                                        <text-line size="10"/>
                                    </default-field>
                                </field>
                                <field name="locationSeqId">
                                    <default-field title="Location">
                                        <drop-down allow-empty="true">
                                            <dynamic-options transition="facilityChoices" server-search="true" min-length="0"
                                                    parameter-map="{choice:'locations', facilityId:facilityId}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="productCategoryId">
                                    <default-field title="Product category" tooltip="Products, not locations">
                                        <drop-down allow-empty="true">
                                            <dynamic-options transition="countChoices" server-search="true" min-length="0"
                                                    parameter-map="{choice:'categories'}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="abcClassEnumId">
                                    <default-field title="ABC class" tooltip="Products, not locations">
                                        <drop-down allow-empty="true">
                                            <dynamic-options transition="countChoices" parameter-map="{choice:'abcClasses'}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="countModeEnumId">
                                    <default-field title="Mode">
                                        <drop-down allow-empty="false">
                                            <dynamic-options transition="countChoices" parameter-map="{choice:'countModes'}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="blindIndicator">
                                    <default-field title="Blind" tooltip="Empty takes the operation policy">
                                        <drop-down allow-empty="true">
                                            <option key="Y" text="Blind"/>
                                            <option key="N" text="Not blind"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="assigneePartyId">
                                    <default-field title="Assignee">
                                        <drop-down allow-empty="true">
                                            <dynamic-options transition="countChoices" server-search="true" min-length="0"
                                                    parameter-map="{choice:'assignees'}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="effectiveFromDate">
                                    <default-field title="From" tooltip="Empty starts now">
                                        <date-time/>
                                    </default-field>
                                </field>
                                <field name="changeReason">
                                    <default-field title="Reason">
                                        <text-line size="40"/>
                                    </default-field>
                                </field>
                                <field name="submit">
                                    <default-field title="">
                                        <submit text="Add schedule"/>
                                    </default-field>
                                </field>
                                <field-layout>
                                    <field-row>
                                        <field-ref name="scheduleKindEnumId"/>
                                        <field-ref name="frequencyDays"/>
                                    </field-row>
                                    <field-row>
                                        <field-ref name="annualMonth"/>
                                        <field-ref name="annualDay"/>
                                    </field-row>
                                    <field-row>
                                        <field-ref name="locationTypeEnumId"/>
                                        <field-ref name="areaId"/>
                                    </field-row>
                                    <field-row>
                                        <field-ref name="locationSeqId"/>
                                        <field-ref name="productCategoryId"/>
                                    </field-row>
                                    <field-row>
                                        <field-ref name="abcClassEnumId"/>
                                        <field-ref name="countModeEnumId"/>
                                    </field-row>
                                    <field-row>
                                        <field-ref name="blindIndicator"/>
                                        <field-ref name="assigneePartyId"/>
                                    </field-row>
                                    <field-row>
                                        <field-ref name="effectiveFromDate"/>
                                        <field-ref name="changeReason"/>
                                    </field-row>
                                    <field-ref name="submit"/>
                                </field-layout>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body-nopad>
                        <label text="No count schedule yet: locations and products come due only by request. Add one to count
                                a location type every few days, the facility once a year, or a bin when it reaches zero."
                                type="p" style="q-pa-sm" condition="!scheduleRows.length"/>
                        <form-list name="CountScheduleList" list="scheduleRows" skip-form="true" paginate="false">
                            <field name="dueText">
                                <default-field title="Comes due">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="scopeText">
                                <default-field title="Counts">
                                    <display text="${scopeText}${facilityId ? '' : ' (organization)'}"/>
                                </default-field>
                            </field>
                            <field name="countModeText">
                                <default-field title="Mode">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="blindText">
                                <default-field title="Blind">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="assigneeName">
                                <default-field title="Assignee">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="fromDateText">
                                <default-field title="From">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="thruDateText">
                                <default-field title="Through">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="actions">
                                <default-field title="">
                                    <container-dialog id="EndCountSchedule_${countScheduleId}" condition="canManage"
                                            button-text="End" title="End this count schedule" width="480">
                                        <form-single name="EndCountSchedule" transition="storeCountSchedule"
                                                map="{countScheduleId:countScheduleId, facilityId:facilityId,
                                                    organizationPartyId:organizationPartyId, endNow:'Y'}">
                                            <field name="countScheduleId">
                                                <default-field>
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="facilityId">
                                                <default-field>
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="organizationPartyId">
                                                <default-field>
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="endNow">
                                                <default-field>
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="changeReason">
                                                <default-field title="Reason">
                                                    <text-line size="40"/>
                                                </default-field>
                                            </field>
                                            <field name="submit">
                                                <default-field title="">
                                                    <submit text="End schedule" btn-type="danger"
                                                            confirmation="End the schedule '${dueText}' now?"/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="dueText"/>
                                    <field-ref name="scopeText"/>
                                </column>
                                <column>
                                    <field-ref name="fromDateText"/>
                                    <field-ref name="actions"/>
                                </column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
