<!-- The tracking defaults at a facility or the organization (design-warehouse StockPolicies TrackingPolicy): lot and
    serial requirements, patterns, shelf life, near-expiry warnings and the expiry gate's flag (off unless set), each
    with its source. A narrower scope cannot lift an inherited expiry block. A manager changes them by a dated row
    (mantle.facility.WarehousePolicyServices.store#TrackingPolicy); product exceptions are on their own tab. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Tracking" default-menu-index="2">
    <transition-include name="storeTrackingPolicy" location="component://mr-boss/template/WarehousePolicyParts.xml"/>
    <actions>
        <service-call name="ironstone.warehouse.PolicyServices.get#PolicyContext"
                in-map="{appRoot:appRoot, facilityId:facilityId, organizationPartyId:organizationPartyId,
                    policyTypes:'tracking'}"
                out-map="found" transaction="force-new" ignore-error="true"/>
        <set field="policy" from="found?.policy"/>
        <set field="traceRows" from="(policy?.traceRows || []).filter(row =&gt; row.policyType === 'tracking')"/>
        <set field="historyRows" from="policy?.trackingHistory || []"/>
    </actions>
    <widgets>
        <label text="${policy?.message || 'This policy is not available to you.'}" type="p" condition="!policy?.available"/>
        <section name="Tracking" condition="policy?.available">
            <widgets>
                <container-box>
                    <box-header title="Tracking at ${policy.scopeText}"/>
                    <box-toolbar>
                        <container-dialog id="TrackingPolicyDialog" button-text="Change tracking" type="primary"
                                title="Change the tracking defaults at ${policy.scopeText}" condition="policy.canManage">
                            <form-single name="TrackingPolicy" transition="storeTrackingPolicy" map="policy.trackingSettings">
                                <field name="organizationPartyId">
                                    <default-field>
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="facilityId">
                                    <default-field>
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="expectedFromDate">
                                    <default-field>
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="lotRequired">
                                    <default-field title="Lot required" tooltip="Empty inherits">
                                        <drop-down allow-empty="true">
                                            <option key="Y" text="Yes"/>
                                            <option key="N" text="No"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="serialRequired">
                                    <default-field title="Serial required" tooltip="Empty inherits">
                                        <drop-down allow-empty="true">
                                            <option key="Y" text="Yes"/>
                                            <option key="N" text="No"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="expiryBlock">
                                    <default-field title="Block expired stock" tooltip="Empty inherits">
                                        <drop-down allow-empty="true">
                                            <option key="Y" text="Yes"/>
                                            <option key="N" text="No"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="serialPattern">
                                    <default-field title="Serial pattern">
                                        <text-line/>
                                    </default-field>
                                </field>
                                <field name="lotPattern">
                                    <default-field title="Lot pattern">
                                        <text-line/>
                                    </default-field>
                                </field>
                                <field name="shelfLifeDays">
                                    <default-field title="Shelf life days">
                                        <text-line input-type="number"/>
                                    </default-field>
                                </field>
                                <field name="nearExpiryDays">
                                    <default-field title="Near-expiry warning days">
                                        <text-line input-type="number"/>
                                    </default-field>
                                </field>
                                <field name="minimumRemainingShelfLifeDays">
                                    <default-field title="Minimum remaining shelf life days">
                                        <text-line input-type="number"/>
                                    </default-field>
                                </field>
                                <field name="effectiveFromDate">
                                    <default-field title="Effective from" tooltip="Leave empty to start now">
                                        <date-time/>
                                    </default-field>
                                </field>
                                <field name="changeReason">
                                    <default-field title="Reason">
                                        <text-line/>
                                    </default-field>
                                </field>
                                <field name="submitButton">
                                    <default-field title="Save tracking defaults">
                                        <submit/>
                                    </default-field>
                                </field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body>
                        <section-include name="PolicyTrace" location="component://mr-boss/template/WarehousePolicyParts.xml"/>
                    </box-body>
                </container-box>
                <container-box>
                    <box-header title="Tracking defaults set here"/>
                    <box-body>
                        <section-include name="PolicyHistory" location="component://mr-boss/template/WarehousePolicyParts.xml"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
