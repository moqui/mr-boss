<!-- Product tracking exceptions (design-warehouse StockPolicies ProductTrackingExceptions): the product rows of the
    tracking policy in effect for the organization, for every facility or one, the same records Product360's Stock tab
    shows (ironstone.warehouse.PolicyServices.get#TrackingExceptions). A stock planner or manager adds or changes one by
    a dated row (mantle.facility.WarehousePolicyServices.store#TrackingPolicy with the product). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Product exceptions" default-menu-index="3">
    <transition-include name="storeTrackingPolicy" location="component://mr-boss/template/WarehousePolicyParts.xml"/>
    <transition-include name="policyChoices" location="component://mr-boss/template/WarehousePolicyParts.xml"/>
    <transition-include name="choices" location="component://mr-boss/template/WarehouseParts.xml"/>
    <actions>
        <service-call name="ironstone.warehouse.PolicyServices.get#TrackingExceptions"
                in-map="{appRoot:appRoot, facilityId:facilityId, organizationPartyId:organizationPartyId}"
                out-map="found" transaction="force-new" ignore-error="true"/>
        <set field="exceptionRows" from="found?.exceptionRows || []"/>
        <set field="canPlan" from="!!found?.canPlan"/>
        <!-- where a change returns: the facility the tab shows, not the exception's -->
        <set field="scopeFacilityId" from="facilityId || ''"/>
        <set field="newException" from="{organizationPartyId:found?.organizationPartyId, facilityId:facilityId || '',
            scopeFacilityId:facilityId || '', addException:'true'}"/>
    </actions>
    <widgets>
        <container-box>
            <box-header title="Product tracking exceptions"/>
            <box-toolbar>
                <container-dialog id="NewException" button-text="Add exception" type="primary"
                        title="Add a product tracking exception" condition="canPlan">
                    <form-single name="NewExceptionForm" transition="storeTrackingPolicy" map="newException">
                        <field name="organizationPartyId">
                            <default-field>
                                <hidden/>
                            </default-field>
                        </field>
                        <field name="addException">
                            <default-field>
                                <hidden/>
                            </default-field>
                        </field>
                        <field name="scopeFacilityId">
                            <default-field>
                                <hidden/>
                            </default-field>
                        </field>
                        <field name="productId">
                            <default-field title="Product">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="policyChoices" server-search="true" min-length="0"
                                            parameter-map="{choice:'products'}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="facilityId">
                            <default-field title="Facility" tooltip="Empty for every facility">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0"
                                            parameter-map="{choice:'facilities'}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="lotRequired">
                            <default-field title="Lot required" tooltip="Empty inherits">
                                <drop-down allow-empty="true">
                                    <option key="Y" text="Yes"/>
                                    <option key="N" text="No"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="serialRequired">
                            <default-field title="Serial required" tooltip="Empty inherits">
                                <drop-down allow-empty="true">
                                    <option key="Y" text="Yes"/>
                                    <option key="N" text="No"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="expiryBlock">
                            <default-field title="Block expired stock" tooltip="Empty inherits">
                                <drop-down allow-empty="true">
                                    <option key="Y" text="Yes"/>
                                    <option key="N" text="No"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="serialPattern">
                            <default-field title="Serial pattern">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="lotPattern">
                            <default-field title="Lot pattern">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="shelfLifeDays">
                            <default-field title="Shelf life days">
                                <text-line input-type="number"/>
                            </default-field>
                        </field>
                        <field name="nearExpiryDays">
                            <default-field title="Near-expiry warning days">
                                <text-line input-type="number"/>
                            </default-field>
                        </field>
                        <field name="minimumRemainingShelfLifeDays">
                            <default-field title="Minimum remaining shelf life days">
                                <text-line input-type="number"/>
                            </default-field>
                        </field>
                        <field name="effectiveFromDate">
                            <default-field title="Effective from" tooltip="Leave empty to start now">
                                <date-time/>
                            </default-field>
                        </field>
                        <field name="changeReason">
                            <default-field title="Reason">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="submitButton">
                            <default-field title="Save exception">
                                <submit/>
                            </default-field>
                        </field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body>
                <label text="No product has its own tracking policy here; every product follows the defaults." type="p"
                        condition="!exceptionRows.length"/>
                <form-list name="Exceptions" list="exceptionRows" skip-form="true" paginate="false">
                    <field name="productName">
                        <default-field title="Product">
                            <display/>
                        </default-field>
                    </field>
                    <field name="facilityText">
                        <default-field title="Facility">
                            <display/>
                        </default-field>
                    </field>
                    <field name="lotText">
                        <default-field title="Lot">
                            <display/>
                        </default-field>
                    </field>
                    <field name="serialText">
                        <default-field title="Serial">
                            <display/>
                        </default-field>
                    </field>
                    <field name="shelfLifeText">
                        <default-field title="Shelf life">
                            <display/>
                        </default-field>
                    </field>
                    <field name="fromDateText">
                        <default-field title="Since">
                            <display/>
                        </default-field>
                    </field>
                    <field name="actions">
                        <default-field title="">
                            <container-dialog id="EditException_${rowKey}" button-text="Change"
                                    title="Change the tracking exception of ${productName}" condition="canPlan">
                                <form-single name="EditException_${rowKey}" transition="storeTrackingPolicy">
                                    <field name="organizationPartyId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="productId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="facilityId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="scopeFacilityId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="expectedFromDate">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="lotRequired">
                                        <default-field title="Lot required" tooltip="Empty inherits">
                                            <drop-down allow-empty="true">
                                                <option key="Y" text="Yes"/>
                                                <option key="N" text="No"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="serialRequired">
                                        <default-field title="Serial required" tooltip="Empty inherits">
                                            <drop-down allow-empty="true">
                                                <option key="Y" text="Yes"/>
                                                <option key="N" text="No"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="expiryBlock">
                                        <default-field title="Block expired stock" tooltip="Empty inherits">
                                            <drop-down allow-empty="true">
                                                <option key="Y" text="Yes"/>
                                                <option key="N" text="No"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="serialPattern">
                                        <default-field title="Serial pattern">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="lotPattern">
                                        <default-field title="Lot pattern">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="shelfLifeDays">
                                        <default-field title="Shelf life days">
                                            <text-line input-type="number"/>
                                        </default-field>
                                    </field>
                                    <field name="nearExpiryDays">
                                        <default-field title="Near-expiry warning days">
                                            <text-line input-type="number"/>
                                        </default-field>
                                    </field>
                                    <field name="minimumRemainingShelfLifeDays">
                                        <default-field title="Minimum remaining shelf life days">
                                            <text-line input-type="number"/>
                                        </default-field>
                                    </field>
                                    <field name="effectiveFromDate">
                                        <default-field title="Effective from" tooltip="Leave empty to start now">
                                            <date-time/>
                                        </default-field>
                                    </field>
                                    <field name="changeReason">
                                        <default-field title="Reason">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="submitButton">
                                        <default-field title="Save exception">
                                            <submit/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </container-dialog>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="productName"/>
                            <field-ref name="facilityText"/>
                        </column>
                        <column>
                            <field-ref name="lotText"/>
                            <field-ref name="actions"/>
                        </column>
                    </columns>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
