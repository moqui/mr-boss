<!-- Warehouse reservation policies (design-warehouse ReservationPolicies): the facility reservation default, which
    applies where a store leaves the setting unset (orders without a store), a store's own settings, which win for that
    store's orders only, and the reservation check. A setting change alone moves no reservation. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Reservation policies" default-menu-index="3">
    <parameter name="facilityId"/>
    <parameter name="organizationPartyId"/>
    <subscreens default-item="FacilityReservation"/>
    <widgets>
        <subscreens-menu id="ReservationPolicyTabs" type="tab"/>
        <subscreens-active/>
    </widgets>
</screen>
