<!-- Warehouse Home (design-warehouse §3; style-guide §3.1 Landing): the selected facility (QueueFilters, a preference that
    never widens the scope), the operation queues the user's capabilities reach (OperationQueues: a number card per queue
    linking to its list, and the table of ready, waiting, late and backorder counts, each unavailable where its queue is not
    counted; ironstone.warehouse.HomeServices.get#Home), the work assigned to them (MyWork: the Warehouse Today source's
    items, with their step, due day and exception), the quantity indicators of the facility (counts, never quantities added
    across units; values are in Reports) and the lookup of a scanned or typed code (ScanOrPack, a scan-input resolved by
    ironstone.warehouse.AccessServices.resolve#Scan over get#ScannedIdGeneral, then looked up through get#ScannedRecord; it
    reads only). Record links of kinds whose Warehouse screen is
    not built yet open the lookup of the record (lookupType and lookupId). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Home" default-menu-index="1" menu-image="sym_o_dashboard" menu-image-type="icon">
    <parameter name="scanText"/>
    <parameter name="lookupType"/>
    <parameter name="lookupId"/>
    <parameter name="lookupFacilityId"/>
    <transition-include name="choices" location="component://mr-boss/template/WarehouseParts.xml"/>
    <transition-include name="selectFacility" location="component://mr-boss/template/WarehouseParts.xml"/>
    <!-- a scan resolved to one of the user's records (resolve#Scan) is looked up as that kind -->
    <transition name="lookup">
        <actions>
            <set field="lookupId" from="scanText"/>
            <set field="lookupType" from="scanText_type || null"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="ironstone.warehouse.HomeServices.get#Home" in-map="{appRoot:appRoot}" out-map="home"/>
        <set field="queueRows"
                from="home.queueRows.map(row =&gt; Object.assign({}, row, Object.fromEntries(
                    ['ready', 'waiting', 'late', 'backorder'].map(name =&gt; [name + 'Text',
                        row[name + 'Count'] == null ? 'Unavailable' : String(row[name + 'Count'])]))))"/>
        <set field="workRows" from="home.workRows"/>
        <!-- each queue's list (the card's link and the operation's), and its card text: the counts it has -->
        <set field="queueLinks" from="{receiving:'Receiving/Receipts', putaway:'Receiving/Putaway',
                inspection:'Inspection/Inspections', picking:'Picking/Picklists', packing:'Shipping/Pack',
                shipping:'Shipping/Ship', returns:'Returns/Returns', transfers:'Transfers/Transfers',
                counts:'Counts/Counts'}"/>
        <set field="queueRows" from="queueRows.map(row =&gt; Object.assign({}, row, {
                link: '/qapps/Warehouse/' + queueLinks[row.operation],
                cardText: [['ready', row.readyCount], ['waiting', row.waitingCount], ['late', row.lateCount],
                    ['backorder', row.backorderCount]].filter(entry =&gt; entry[1] != null)
                    .map(entry =&gt; entry[1] + ' ' + entry[0]).join(' · ') || 'Unavailable'}))"/>
        <set field="queues" from="Object.fromEntries(queueRows.map(row =&gt; [row.operation, row]))"/>
        <set field="indicators" from="home.indicators || {}"/>
        <set field="indicatorText" from="Object.fromEntries(['productCount', 'onHoldCount', 'quarantineCount'].map(name =&gt;
                [name, indicators[name] == null ? 'Unavailable' : String(indicators[name])]))"/>
        <set field="lookupText" from="lookupId || scanText"/>
        <if condition="lookupText">
            <service-call name="ironstone.warehouse.AccessServices.get#ScannedRecord"
                    in-map="{appRoot:appRoot, scanText:lookupText, recordType:lookupId ? lookupType : null,
                        facilityId:lookupFacilityId}"
                    out-map="lookup"
                    transaction="force-new"
                    ignore-error="true"/>
            <set field="matches" from="lookup?.matches || []"/>
        </if>
    </actions>
    <widgets>
        <label text="Warehouse" type="h5"/>
        <section-include name="FacilityPicker" location="component://mr-boss/template/WarehouseParts.xml"/>
        <label text="You have no facility to work in. An administrator adds you to the organization that owns one."
                type="p" condition="!warehouse.facilityCount"/>
        <dashboard min-width="170">
            <number-card title="Receiving" value="${queues.receiving?.cardText}" icon="sym_o_inbox" size="sm"
                    link="${queues.receiving?.link}" condition="queues.receiving"/>
            <number-card title="Putaway" value="${queues.putaway?.cardText}" icon="sym_o_shelves" size="sm"
                    link="${queues.putaway?.link}" condition="queues.putaway"/>
            <number-card title="Inspection" value="${queues.inspection?.cardText}" icon="sym_o_verified" size="sm"
                    link="${queues.inspection?.link}" condition="queues.inspection"/>
            <number-card title="Picking" value="${queues.picking?.cardText}" icon="sym_o_shopping_cart" size="sm"
                    link="${queues.picking?.link}" condition="queues.picking"/>
            <number-card title="Packing" value="${queues.packing?.cardText}" icon="sym_o_package_2" size="sm"
                    link="${queues.packing?.link}" condition="queues.packing"/>
            <number-card title="Shipping" value="${queues.shipping?.cardText}" icon="sym_o_local_shipping" size="sm"
                    link="${queues.shipping?.link}" condition="queues.shipping"/>
            <number-card title="Returns" value="${queues.returns?.cardText}" icon="sym_o_assignment_return" size="sm"
                    link="${queues.returns?.link}" condition="queues.returns"/>
            <number-card title="Transfers" value="${queues.transfers?.cardText}" icon="sym_o_swap_horiz" size="sm"
                    link="${queues.transfers?.link}" condition="queues.transfers"/>
            <number-card title="Counts" value="${queues.counts?.cardText}" icon="sym_o_fact_check" size="sm"
                    link="${queues.counts?.link}" condition="queues.counts"/>
        </dashboard>
        <container-box>
            <box-header title="Operation queues${warehouse.facilityName ? ' at ' + warehouse.facilityName : ''}"/>
            <box-body>
                <form-list name="QueueRows" list="queueRows" skip-form="true" paginate="false">
                    <field name="title">
                        <default-field title="Operation">
                            <link url="${link}" text="${title}" link-type="anchor" url-type="plain"/>
                        </default-field>
                    </field>
                    <field name="readyText" align="right">
                        <default-field title="Ready">
                            <display/>
                        </default-field>
                    </field>
                    <field name="waitingText" align="right">
                        <default-field title="Waiting">
                            <display/>
                        </default-field>
                    </field>
                    <field name="lateText" align="right">
                        <default-field title="Late">
                            <display/>
                        </default-field>
                    </field>
                    <field name="backorderText" align="right">
                        <default-field title="Backorder">
                            <display/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="title"/>
                        </column>
                        <column>
                            <field-ref name="readyText"/>
                        </column>
                    </columns>
                </form-list>
            </box-body>
        </container-box>
        <container-box>
            <box-header title="Your work"/>
            <box-body>
                <label text="Nothing is assigned to you." type="p" condition="!workRows.length"/>
                <form-list name="WorkRows" list="workRows" skip-form="true" paginate="false">
                    <field name="title">
                        <default-field title="Document">
                            <link url="${url}" text="${title}" link-type="anchor"/>
                        </default-field>
                    </field>
                    <field name="step">
                        <default-field title="Step">
                            <display/>
                        </default-field>
                    </field>
                    <field name="dueText">
                        <default-field title="Due">
                            <display/>
                        </default-field>
                    </field>
                    <field name="exceptionText">
                        <default-field title="Exception">
                            <display/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="title"/>
                        </column>
                        <column>
                            <field-ref name="dueText"/>
                            <field-ref name="exceptionText"/>
                        </column>
                    </columns>
                </form-list>
            </box-body>
        </container-box>
        <container-box>
            <box-header title="Scan or look up"/>
            <box-body>
                <form-single name="ScanOrPack" transition="lookup">
                    <field name="scanText">
                        <default-field title="Code"
                                tooltip="An asset, container, location, product, shipment, return, count or lot">
                            <scan-input resolver="ironstone.warehouse.AccessServices.resolve#Scan" size="30"
                                    placeholder="Scan or type a code">
                                <parameter name="facilityId" from="warehouse.facilityId"/>
                            </scan-input>
                        </default-field>
                    </field>
                </form-single>
                <section name="LookupResult" condition="lookupText">
                    <widgets>
                        <label text="Nothing in your facilities matches ${lookupText}." type="p" condition="!matches.length"/>
                        <section-iterate name="LookupMatch" list="matches" entry="match">
                            <widgets>
                                <container style="q-mb-sm">
                                    <label text="${match.kindName} ${match.recordId}" type="strong"/>
                                    <label text="${match.label}" type="p"
                                            condition="match.label &amp;&amp; match.label != match.recordId"/>
                                    <label text="${[match.detail, match.facilityName].filter(Boolean).join(' · ')}" type="p"
                                            style="text-caption m-muted"/>
                                </container>
                            </widgets>
                        </section-iterate>
                    </widgets>
                </section>
            </box-body>
        </container-box>
        <section name="StockIndicators" condition="warehouse.facilityId">
            <widgets>
                <label text="Stock at ${warehouse.facilityName}" type="h6"/>
                <dashboard min-width="170">
                    <number-card title="Products in stock" value="${indicatorText.productCount}" icon="sym_o_inventory_2"
                            size="sm" link="/qapps/Warehouse/Inventory/Assets?groupBy=product"/>
                    <number-card title="Stock lines on hold" value="${indicatorText.onHoldCount}" icon="sym_o_pause_circle"
                            size="sm" link="/qapps/Warehouse/Inventory/Assets?statusId=AstOnHold"/>
                    <number-card title="Stock lines in quarantine" value="${indicatorText.quarantineCount}"
                            icon="sym_o_block" size="sm" link="/qapps/Warehouse/Inventory/Assets?statusId=AstQuarantine"/>
                    <number-card title="Reports" value="Stock at date, history, valuation" icon="sym_o_bar_chart" size="sm"
                            link="/qapps/Warehouse/Reports/ReportIndex"/>
                </dashboard>
            </widgets>
        </section>
    </widgets>
</screen>
