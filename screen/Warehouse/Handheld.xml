<!-- The Handheld area of IronStone Warehouse (design-warehouse §13): the scanning screens at handheld density
    (density="handheld": 48 px controls, 18 px text, no drawer, a reduced header, over the user's density preference;
    style-guide §8.2). HandheldHome chooses the facility and resolves a scan; each task is the desk task's own screen mounted
    here with handheldMount set (Move at Handheld/Move, Receive at Handheld/Receive, Putaway at Handheld/Putaway, Pick at
    Handheld/Pick, Pack at Handheld/Pack, Count at Handheld/Count, PickLocationMoves at Handheld/PickFace), so it posts
    through the same transition and operation key. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Handheld" default-menu-index="11" menu-image="sym_o_barcode_reader" menu-image-type="icon"
        density="handheld" server-static="qvt">
    <always-actions>
        <set field="handheldMount" from="true"/>
    </always-actions>
    <subscreens default-item="Home" always-use-full-path="true">
        <subscreens-item name="Move" location="component://mr-boss/screen/Warehouse/Transfers/Move.xml" menu-index="2"/>
        <subscreens-item name="Receive" location="component://mr-boss/screen/Warehouse/Receiving/Receive.xml" menu-index="3"/>
        <subscreens-item name="Putaway" location="component://mr-boss/screen/Warehouse/Receiving/Putaway.xml" menu-index="4"/>
        <subscreens-item name="Pick" location="component://mr-boss/screen/Warehouse/Picking/Pick.xml" menu-index="5"/>
        <subscreens-item name="Pack" location="component://mr-boss/screen/Warehouse/Shipping/Pack.xml" menu-index="6"/>
        <subscreens-item name="Count" location="component://mr-boss/screen/Warehouse/Counts/CountEntry.xml" menu-index="7"/>
        <subscreens-item name="PickFace" location="component://mr-boss/screen/Warehouse/Picking/PickLocationMoves.xml"
                menu-index="8"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="HandheldPanel" type="tab"/>
    </widgets>
</screen>
