<!-- IronStone People (design-people §1): the root of the app for HR officers, managers, recruiters, payroll and development
    staff, case handlers and the People administrator. The root user group BOSS_PEOPLE and the administrator group
    BOSS_PEOPLE_ADMIN open it (data/BossSetupData.xml), as ADMIN does; BOSS_PEOPLE_SELF has no root grant (an employee's
    self-service is Commons', impl-people P8). The root grant opens navigation only: ironstone.people.ContextServices
    .get#SharedContext checks the user and resolves their capabilities, employers, units, own employments and links for every
    subscreen, and each Mantle service (mantle.humanres.PeopleServices) checks the scope again. The menu of design §1.2 grows by
    phase: P1 builds Home (every People user's) and Settings (the People administrator's, BOSS_PPL_SETTINGS); P2 Employees (the
    directory and Employee360, every People user's, each seeing what Mantle's scope admits); each later phase adds its entries,
    and the design's later entries stay absent. P2 adds the palette's directory and the Person record-lookup; quick create and
    Today arrive with their records. The Chatter and RecordFiles panels under this root open only People's own record hosts (the
    employment, P2; each later host with its phase): any other record's notes and files are kept in its own app, so the root's
    grant opens no other record's panel. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="People" menu-image="sym_o_groups" menu-image-type="icon">

    <always-actions>
        <set field="appRoot" value="People"/>

        <service-call name="mantle.party.PartyServices.setup#UserOrganizationInfo" out-map="context"/>
        <service-call name="ironstone.people.ContextServices.get#SharedContext" in-map="{appRoot:appRoot}" out-map="people"/>
        <set field="sharedLinks" from="people.sharedLinks"/>
        <!-- P2: the record panels serve People's HR hosts only (design §13 Chatter and RecordFiles; F66); a panel request with no
            record (a person search, an avatar) names none -->
        <script><![CDATA[
            const pathNames = Array.from(sri.getScreenUrlInfo().fullPathNameList || []).map(String)
            const panelName = pathNames[pathNames.indexOf('People') + 1]
            const wanted = ec.context.recordEntity
            if ((panelName === 'Chatter' || panelName === 'RecordFiles') && wanted) {
                let entityName = String(wanted)
                try { entityName = ec.entity.makeValue(entityName).getEntityName() } catch (error) { entityName = '' }
                if (!['mantle.humanres.employment.Employment'].includes(entityName))
                    throw new Error('RECORD_PANEL_UNAVAILABLE: Notes and files of this record are kept in the app that owns it')
            }
        ]]></script>
    </always-actions>

    <subscreens default-item="Home" always-use-full-path="true">
        <!-- the record panels the chatter and record-files elements load under this app root, hidden from the menu
            (the theme values STRT_CHATTER_SCREEN and STRT_RECORD_FILES_SCREEN; impl-drawers-commons.md R5) -->
        <subscreens-item name="Chatter" location="component://mr-boss/screen/Shared/Chatter.xml" menu-include="false"/>
        <subscreens-item name="RecordFiles" location="component://mr-boss/screen/Shared/RecordFiles.xml" menu-include="false"/>
    </subscreens>

    <!-- P1: the people keymap. P2: the palette's directory (Employees, as Commons' People group is its contacts) and the Person
        record-lookup over the directory projection (design §1.4). Quick create and Today (design §1.4) come with their records. -->
    <shell-providers>
        <palette-source group="Employees" label="Employee directory" icon="sym_o_badge"
                service="ironstone.people.ContextServices.search#Records" sequence="25"/>
        <record-lookup name="people.records" service="ironstone.people.ContextServices.lookup#Records" sequence="30"/>
        <keymap scope="people">
            <key keys="g p" label="People home" screen="People/Home"/>
            <key keys="g e" label="Employees" screen="People/Employees"/>
        </keymap>
    </shell-providers>

    <widgets><subscreens-panel id="people-panel" type="popup"/></widgets>
</screen>
