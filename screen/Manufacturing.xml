<!-- IronStone Manufacturing (design-manufacturing §1): the root of the app for production planners, method engineers,
    supervisors, quality and the shop floor. The root user group BOSS_MANUFACTURING and the administrator group
    BOSS_MANUFACTURING_ADMIN open it (data/BossSetupData.xml); its areas are the files of screen/Manufacturing/, in the menu
    order of design §1.2 by their default-menu-index:
    1 Home; 2 Work orders (WorkOrders); 3 Shop floor (ShopFloor); 4 BOMs (BillsOfMaterials); 5 Routings; 6 Work centers
    (WorkCenters); 7 Quality; 8 Planning; 9 Subcontracting; 10 Settings; 11 Approvals; 12 Reports.
    Shop floor, Quality, Planning, Subcontracting, Settings and Approvals are for their capability groups only (the
    BOSS_MFG_<Area> artifact groups). ironstone.manufacturing.AccessServices.get#SharedContext checks the user and resolves
    their organizations, plants, the selected plant and capabilities for every subscreen; each service checks again. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Manufacturing" menu-image="sym_o_precision_manufacturing" menu-image-type="icon">

    <always-actions>
        <set field="appRoot" value="Manufacturing"/>

        <service-call name="mantle.party.PartyServices.setup#UserOrganizationInfo" out-map="context"/>
        <service-call name="ironstone.manufacturing.AccessServices.get#SharedContext" in-map="{appRoot:appRoot}"
                out-map="manufacturing"/>
        <set field="sharedLinks" from="manufacturing.sharedLinks"/>
    </always-actions>

    <subscreens default-item="Home" always-use-full-path="true">
        <!-- the record panels the chatter and record-files elements load under this app root, hidden from the menu
            (the theme values STRT_CHATTER_SCREEN and STRT_RECORD_FILES_SCREEN; impl-drawers-commons.md R5) -->
        <subscreens-item name="Chatter" location="component://mr-boss/screen/Shared/Chatter.xml" menu-include="false"/>
        <subscreens-item name="RecordFiles" location="component://mr-boss/screen/Shared/RecordFiles.xml" menu-include="false"/>
        <!-- later phases: the shared screens mounted at the root, hidden from the menu (as Warehouse's QualityInspection) -->
    </subscreens>

    <!-- palette types, quick create, Today sources and notification topics grow with the phases that build their records
        (M1, CX-SHELL): P5 a draft work order (NewWorkOrder), P11 a downtime report, each for the groups that may create it -->
    <shell-providers>
        <!-- P1: runs, methods, routings, work centers and scoped equipment in the palette (search#Records) -->
        <palette-source group="Manufacturing" label="Manufacturing records" icon="sym_o_precision_manufacturing"
                service="ironstone.manufacturing.AccessServices.search#Records" sequence="49"/>
        <!-- P2: the method release requests of Approvals (F40) -->
        <notification-topic topic="BomRelease"/>
        <notification-topic topic="RoutingRelease"/>
        <!-- P5a: quick create of a draft work order, for the planners (WorkOrders/QuickCreate is BOSS_MFG_NEW_WORK_ORDER's);
            the release notice and the staged release requests -->
        <quick-create kind="manufacturingWorkOrder" label="Work order" icon="sym_o_precision_manufacturing"
                screen="Manufacturing/WorkOrders/QuickCreate" sequence="85"/>
        <notification-topic topic="ProductionRelease"/>
        <notification-topic topic="ProductionStagedRelease"/>
        <!-- P7: a loss and an overproduction waiting for a supervisor -->
        <notification-topic topic="ProductionLossApproval"/>
        <notification-topic topic="ProductionOverproduction"/>
        <keymap scope="manufacturing">
            <key keys="g q" label="Manufacturing queue" screen="Manufacturing/Home"/>
        </keymap>
    </shell-providers>

    <widgets><subscreens-panel id="manufacturing-panel" type="popup"/></widgets>
</screen>
