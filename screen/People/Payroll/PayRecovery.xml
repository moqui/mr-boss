<!-- People › Payroll › Overpayment recovery (impl-people P27 review, the user's call of Nov 13, 2026; design-people §8.2): each
    employer's overpayment recovery settings from mantle.humanres.PayrollSetupServices.get#RecoverySettings (a payroll reader's): the
    deduction a negative correction is recovered through on the next regular runs, and the most recovered a period: an amount, a
    percentage of net pay (the employee's wage net on their latest finalized regular run), or both (P28 review, the user's call of Nov
    13, 2026: the percentage of the last net, at most the amount, and the amount before a first net). A configuration holder (PAYROLL_EDIT and
    PAYROLL_CONFIGURE, which Mantle checks) changes them at the revision read (store#RecoverySettings; audited). Beside Pay groups,
    payroll's area. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Overpayment recovery" default-menu-index="9">
    <parameter name="organizationPartyId"/>
    <transition name="storeSettings">
        <actions>
            <service-call name="mantle.humanres.PayrollSetupServices.store#RecoverySettings"
                    in-map="{organizationPartyId:organizationPartyId, expectedRevision:(expectedRevision || null),
                        payrollComponentId:(payrollComponentId ?? ''), capAmount:(capAmount ?? ''), capPercent:(capPercent ?? '')}"/>
            <if condition="!ec.message.hasError()"><message type="success">Recovery settings saved</message></if>
        </actions>
        <default-response url="."><parameter name="organizationPartyId"/></default-response>
        <error-response url="."><parameter name="organizationPartyId"/></error-response>
    </transition>
    <actions>
        <service-call name="mantle.humanres.PayrollSetupServices.get#RecoverySettings" out-map="found" transaction="force-new"
                ignore-error="true" in-map="{}"/>
        <script><![CDATA[
            ec.message.clearErrors()
            settingsFound = !!found?.employers
            canEdit = !!found?.canEdit
            employerRows = Array.from(found?.employers || [])
            opened = employerRows.find(row => row.organizationPartyId == organizationPartyId) ||
                (employerRows.length == 1 ? employerRows[0] : null)
            deductionOptions = opened ? Array.from(opened.deductions || []) : []
            settingsValues = opened ? {organizationPartyId: opened.organizationPartyId, expectedRevision: opened.revision,
                payrollComponentId: opened.payrollComponentId, capAmount: opened.capAmount, capPercent: opened.capPercent} : {}
        ]]></script>
    </actions>
    <widgets>
        <label text="Overpayment recovery" type="h5"/>
        <section name="NotOpen" condition="!settingsFound">
            <widgets>
                <label text="The overpayment recovery settings are open to payroll. They are not open to you." type="p" style="m-muted"/>
            </widgets>
        </section>
        <section name="Settings" condition="settingsFound">
            <widgets>
                <label text="A correction that pays less than was paid is recovered on the employee's next regular runs through this deduction, at most the cap a period; from someone who has left, as a receivable."
                        type="p" style="text-caption m-muted"/>
                <container-box>
                    <box-body-nopad>
                        <form-list name="Employers" list="employerRows" skip-form="true" paginate="false" condition="employerRows.length">
                            <field name="organizationName">
                                <default-field title="Employer">
                                    <link url="." text="${organizationName}" link-type="anchor" parameter-map="{organizationPartyId:organizationPartyId}"/>
                                </default-field>
                            </field>
                            <field name="componentText"><default-field title="Recovery deduction"><display text="${componentText || 'Not set'}"/></default-field></field>
                            <field name="capText"><default-field title="Most a period"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="organizationName"/><field-ref name="capText"/></column>
                                <column><field-ref name="componentText"/></column>
                            </columns>
                        </form-list>
                        <label type="p" style="q-pa-md m-muted" condition="!employerRows.length" text="No employer is in your payroll scope."/>
                    </box-body-nopad>
                </container-box>
                <section name="OpenedEmployer" condition="opened">
                    <widgets>
                        <container-box>
                            <box-header title="${opened.organizationName}"/>
                            <box-body>
                                <label type="p" condition="!canEdit" style="m-muted"
                                        text="Recovery deduction: ${opened.componentText || 'Not set'}. Most a period: ${opened.capText}."/>
                                <form-single name="EditSettings" transition="storeSettings" map="settingsValues" condition="canEdit">
                                    <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                                    <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                    <field name="payrollComponentId">
                                        <default-field title="Recovery deduction"
                                                tooltip="One of the employer's deductions: its liability account is where a recovered amount posts">
                                            <drop-down allow-empty="true"><list-options list="deductionOptions" key="${value}" text="${label}"/></drop-down>
                                        </default-field>
                                    </field>
                                    <field name="capPercent">
                                        <default-field title="Most a period: percentage of net pay"
                                                tooltip="Of the employee's net pay on their latest finalized regular run, above 0 and at most 100. Before their first, the amount below applies, or with none the recovery waits a period. Empty with no amount: no cap, the whole rest">
                                            <text-line size="6" input-type="number"/></default-field>
                                    </field>
                                    <field name="capAmount">
                                        <default-field title="Most a period: amount"
                                                tooltip="In the pay group's currency. With a percentage, the most it takes and what is taken before the employee's first net pay; alone, the cap">
                                            <text-line size="10" input-type="number"/></default-field>
                                    </field>
                                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                                    <field-layout>
                                        <field-ref name="payrollComponentId"/>
                                        <field-row><field-ref name="capPercent"/><field-ref name="capAmount"/></field-row>
                                        <field-ref name="submitButton"/>
                                    </field-layout>
                                </form-single>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
