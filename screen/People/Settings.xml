<!-- The Settings area of IronStone People (design-people §12 Settings, §1.2; impl-people P1), the People administrator's
    (BOSS_PPL_SETTINGS denies the root user group; BOSS_PEOPLE_ADMIN and ADMIN open it through the root): SettingsHome (the
    default: SetupReadiness over mantle.humanres.PeopleServices.get#Readiness). PeoplePreferences is P29's; the domain editors
    of design §1.2's Settings group (pay components, structures and groups, leave policies and allocations, holidays, approval
    rules, checklists, forms, lookups, EmployeeImport) join with their phases, each opening it to its own groups. P5: Approval
    rules (ApprovalPolicies) and Lookups, the People administrator's. HR's own editors (P7's Checklists and Employee import) are
    under Employees, HR's area (the user's call, Nov 11): Settings stays the People administrator's, and HR does not open it.
    P16: Forms and FormDetail, the survey builder's shared screens (Shared/SurveyForms, SurveyFormDetail) with People's
    registration (service/ironstone/shared/SurveyApps.js; design §13 Forms, impl-people F51): People's private purposes, built by
    the People administrator (PEOPLE_CONFIGURE, checked in mantle.party.FormDefinitionServices). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Settings" default-menu-index="20" menu-image="sym_o_settings" menu-image-type="icon">
    <subscreens default-item="SettingsHome" always-use-full-path="true">
        <!-- P16: the survey builder with People's registration (design §13 Forms) -->
        <subscreens-item name="Forms" location="component://mr-boss/screen/Shared/SurveyForms.xml" menu-title="Forms" menu-index="4"/>
        <subscreens-item name="FormDetail" location="component://mr-boss/screen/Shared/SurveyFormDetail.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-menu id="PeopleSettingsTabs" type="tab"/>
        <subscreens-active/>
    </widgets>
</screen>
