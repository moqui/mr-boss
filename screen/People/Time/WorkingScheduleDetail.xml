<!-- People › Working schedule (design-people §6 WorkingScheduleDetail; style-guide §3.3 Detail; impl-people P9): one schedule, from
    mantle.humanres.ScheduleServices.get#Schedule: the record header (name, employer, zone, hours a week, state), Week (its dated
    weekly intervals: day, local start and end, a night shift ending the next day, break, hours, dates), Assignments (who follows it
    now or later, from when, with a holiday calendar in place of the schedule's: every one for HR, a manager their reports) and
    Capacity preview (a person's days as Projects and timesheets read them, ScheduleServices.get#CapacityPreview over
    ResourceServices.get#PartyCapacity: planned hours, holiday, leave, capacity, and where the hours come from). An HR editor of the
    employer assigns it from a date (Assign, the one primary, assign#Schedule: a change of the employment's assignment, kept in its
    history), ends an employment's following of it, adds working hours and changes or ends them from a date (store#ScheduleLine:
    a past week keeps its hours, intervals in effect together never overlap), edits its name, calendar and, until someone follows
    it, its zone, and ends it (store#Schedule, refused while someone follows it after the end). Each write names the revision read.
    No historical pay is recomputed. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Working schedule" default-menu-include="false">
    <parameter name="workingScheduleId"/>
    <parameter name="previewPartyId"/>
    <parameter name="previewFromDate"/>
    <parameter name="previewThruDate"/>
    <transition-include name="choices" location="component://mr-boss/template/PeopleParts.xml"/>
    <!-- the schedule's name, calendar, zone and end: Mantle checks the HR editor, the revision read and who follows it -->
    <transition name="storeSchedule">
        <actions>
            <service-call name="mantle.humanres.ScheduleServices.store#Schedule"
                    in-map="{workingScheduleId:workingScheduleId, expectedRevision:(expectedRevision || null), scheduleName:(scheduleName ?? null),
                        description:(description ?? null), holidayCategoryId:(holidayCategoryId ?? null), timeZone:(timeZone || null),
                        end:(end == 'true'), thruDate:(thruDate || null), changeReason:(changeReason || null)}"/>
            <if condition="!ec.message.hasError()"><message type="success">${end == 'true' ? 'Schedule ended' : 'Schedule saved'}</message></if>
        </actions>
        <default-response url="."><parameter name="workingScheduleId"/></default-response>
        <error-response url="."><parameter name="workingScheduleId"/></error-response>
    </transition>
    <!-- working hours added, changed or ended from a date -->
    <transition name="storeLine">
        <actions>
            <service-call name="mantle.humanres.ScheduleServices.store#ScheduleLine"
                    in-map="{workingScheduleId:workingScheduleId, expectedRevision:(expectedRevision || null),
                        workingScheduleLineId:(workingScheduleLineId || null), isoDay:(isoDay || null), startTime:(startTime || null),
                        endTime:(endTime || null), breakMinutes:(breakMinutes ?? null), fromDate:(fromDate || null), end:(end == 'true'),
                        changeReason:(changeReason || null)}"/>
            <if condition="!ec.message.hasError()">
                <message type="success">${end == 'true' ? 'Working hours ended' : (workingScheduleLineId ? 'Working hours changed' : 'Working hours added')}</message></if>
        </actions>
        <default-response url="."><parameter name="workingScheduleId"/></default-response>
        <error-response url="."><parameter name="workingScheduleId"/></error-response>
    </transition>
    <!-- an employment follows the schedule from a date, or no longer does (an empty schedule) -->
    <transition name="assignSchedule">
        <actions>
            <service-call name="mantle.humanres.ScheduleServices.assign#Schedule"
                    in-map="{partyRelationshipId:(partyRelationshipId || ''), workingScheduleId:(release == 'true' ? null : workingScheduleId),
                        holidayCategoryId:(release == 'true' ? null : (holidayCategoryId || null)), fromDate:(fromDate || null),
                        expectedRevision:(expectedRevision || null), reason:(reason || null)}"/>
            <if condition="!ec.message.hasError()"><message type="success">${release == 'true' ? 'Schedule ended for the employee' : 'Schedule assigned'}</message></if>
        </actions>
        <default-response url="."><parameter name="workingScheduleId"/></default-response>
        <error-response url="."><parameter name="workingScheduleId"/></error-response>
    </transition>
    <actions>
        <service-call name="mantle.humanres.ScheduleServices.get#Schedule" out-map="found" transaction="force-new" ignore-error="true"
                in-map="{workingScheduleId:(workingScheduleId || '')}"/>
        <script>ec.message.clearErrors()</script>
        <set field="schedule" from="found?.schedule || null"/>
        <set field="recordFound" from="!!schedule"/>
        <set field="lines" from="found?.lines || []"/>
        <set field="assignments" from="found?.assignments || []"/>
        <set field="assignmentsShown" from="!!found?.assignmentsShown"/>
        <set field="canEdit" from="!!schedule?.canEdit &amp;&amp; schedule.state !== 'ended'"/>
        <set field="canAssign" from="!!schedule?.canAssign &amp;&amp; schedule.state !== 'ended'"/>
        <set field="previewParty" from="previewPartyId || assignments[0]?.partyId || null"/>
        <if condition="recordFound &amp;&amp; previewParty">
            <service-call name="mantle.humanres.ScheduleServices.get#CapacityPreview" out-map="preview" transaction="force-new" ignore-error="true"
                    in-map="{partyId:previewParty, fromDate:(previewFromDate || null), thruDate:(previewThruDate || null)}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <script><![CDATA[
            previewDays = Array.from(preview?.days || []).map(row => Object.assign({}, row, {holidayText: row.holiday || ''}))
            previewShown = !!preview?.partyId
            stateColors = {current: 'positive', future: 'primary', ended: 'grey-8'}
            dayOptions = [1, 2, 3, 4, 5, 6, 7].map(day => ({key: String(day), text: ['', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'][day]}))
            editValues = schedule ? {workingScheduleId: schedule.workingScheduleId, expectedRevision: schedule.revision, scheduleName: schedule.scheduleName,
                description: schedule.description, holidayCategoryId: schedule.holidayCategoryId, timeZone: schedule.timeZone} : {}
            lineValues = schedule ? {workingScheduleId: schedule.workingScheduleId, expectedRevision: schedule.revision, breakMinutes: 0} : {}
            assignValues = schedule ? {workingScheduleId: schedule.workingScheduleId} : {}
            previewValues = {workingScheduleId: workingScheduleId, previewPartyId: previewParty, previewFromDate: previewFromDate || null,
                previewThruDate: previewThruDate || null}
            headerCaption = schedule ? [schedule.organizationName, schedule.timeZone, schedule.weeklyHours + ' h a week',
                schedule.holidayCalendarName ? 'Holidays: ' + schedule.holidayCalendarName : 'No holiday calendar'].join(' · ') : ''
        ]]></script>
    </actions>
    <widgets>
        <section name="ScheduleMissing" condition="!recordFound">
            <widgets>
                <container-box type="warning">
                    <box-header title="Not available"/>
                    <box-body>
                        <label type="p" text="This working schedule is not available to you."/>
                        <link url="${sharedLinks['Time/WorkingSchedules']}" text="Back to working schedules" link-type="anchor"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="ScheduleRecord" condition="recordFound">
            <widgets>
                <container style="m-record-header">
                    <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                        <container style="col-12 col-md m-record-title">
                            <label text="${schedule.scheduleName}" type="h5"/>
                            <label text="${headerCaption}" type="p" style="text-caption m-muted q-mb-none"/>
                        </container>
                        <container style="col-12 col-md-auto m-record-status">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColors[schedule.state] || 'grey-8'}">${
                                    WebUtilities.encodeHtml(schedule.stateText)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: schedule.stateText})}]]></text>
                                <text type="html">${schedule.stateText}</text>
                            </render-mode>
                        </container>
                    </container>
                    <container style="row items-center q-col-gutter-x-md q-col-gutter-y-sm m-record-foot">
                        <container style="col-12 col-md row q-gutter-md">
                            <link url="${sharedLinks['Time/WorkingSchedules']}" text="Working schedules" link-type="anchor" icon="sym_o_arrow_back"/>
                            <label text="From ${schedule.fromDateText}${schedule.thruDateText ? ' through ' + schedule.thruDateText : ''}" type="span" style="text-caption"/>
                        </container>
                        <container style="col-12 col-md-auto row items-center q-gutter-sm m-record-actions">
                            <container-dialog id="AssignScheduleDialog" button-text="Assign" icon="sym_o_person_add" type="primary" width="640"
                                    title="Assign ${schedule.scheduleName}" condition="canAssign">
                                <label type="p" text="The employee follows this schedule from the date given; their capacity and timesheet hours follow it from then. A change already set for a later date comes first."/>
                                <form-single name="AssignSchedule" transition="assignSchedule" map="assignValues">
                                    <field name="workingScheduleId"><default-field><hidden/></default-field></field>
                                    <field name="partyRelationshipId">
                                        <default-field title="Employee">
                                            <drop-down>
                                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                                        parameter-map="{choice:'employments', choiceOrganizationPartyId:schedule.organizationPartyId}"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="fromDate"><default-field title="From" tooltip="Today when empty"><date-time type="date"/></default-field></field>
                                    <field name="holidayCategoryId">
                                        <default-field title="Holiday calendar" tooltip="Optional: in place of the schedule's, for this employee">
                                            <drop-down allow-empty="true">
                                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                                        parameter-map="{choice:'holidayCalendars', choiceOrganizationPartyId:schedule.organizationPartyId}"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="reason"><default-field title="Reason"><text-line size="50"/></default-field></field>
                                    <field name="submitButton"><default-field title="Assign schedule"><submit/></default-field></field>
                                    <field-layout>
                                        <field-row><field-ref name="partyRelationshipId"/><field-ref name="fromDate"/></field-row>
                                        <field-ref name="holidayCategoryId"/>
                                        <field-ref name="reason"/>
                                        <field-ref name="submitButton"/>
                                    </field-layout>
                                </form-single>
                            </container-dialog>
                            <button-menu text="More" icon="more_horiz" condition="canEdit">
                                <container-dialog id="EditScheduleDialog" button-text="Edit schedule" icon="sym_o_edit" width="640"
                                        title="Edit ${schedule.scheduleName}">
                                    <form-single name="EditSchedule" transition="storeSchedule" map="editValues">
                                        <field name="workingScheduleId"><default-field><hidden/></default-field></field>
                                        <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                        <field name="scheduleName"><default-field title="Name"><text-line size="40"/></default-field></field>
                                        <field name="timeZone">
                                            <conditional-field condition="!schedule.assignedEver" title="Time zone">
                                                <drop-down>
                                                    <dynamic-options transition="choices" server-search="true" min-length="0"
                                                            parameter-map="{choice:'timeZones', selected:schedule.timeZone}"/>
                                                </drop-down>
                                            </conditional-field>
                                            <default-field title="Time zone" tooltip="People have followed it: copy the schedule for another zone">
                                                <display text="${schedule.timeZone}"/></default-field>
                                        </field>
                                        <field name="holidayCategoryId">
                                            <default-field title="Holiday calendar">
                                                <drop-down allow-empty="true">
                                                    <dynamic-options transition="choices" server-search="true" min-length="0"
                                                            parameter-map="{choice:'holidayCalendars', choiceOrganizationPartyId:schedule.organizationPartyId,
                                                                selected:schedule.holidayCategoryId}"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="description"><default-field title="Description"><text-line size="50"/></default-field></field>
                                        <field name="changeReason"><default-field title="Reason"><text-line size="50"/></default-field></field>
                                        <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                                    </form-single>
                                </container-dialog>
                                <container-dialog id="EndScheduleDialog" button-text="End schedule" icon="sym_o_event_busy" width="520"
                                        title="End ${schedule.scheduleName}">
                                    <label type="p" text="Nobody may follow the schedule after its end: assign them another first. Its history stays."/>
                                    <form-single name="EndSchedule" transition="storeSchedule"
                                            map="{workingScheduleId:schedule.workingScheduleId, expectedRevision:schedule.revision, end:'true'}">
                                        <field name="workingScheduleId"><default-field><hidden/></default-field></field>
                                        <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                        <field name="end"><default-field><hidden/></default-field></field>
                                        <field name="thruDate"><default-field title="Ends on" tooltip="Today when empty"><date-time type="date"/></default-field></field>
                                        <field name="changeReason"><default-field title="Reason"><text-line size="50"/></default-field></field>
                                        <field name="submitButton">
                                            <default-field title="End schedule">
                                                <submit type="danger" confirmation="End ${schedule.scheduleName} on the date given?"/></default-field>
                                        </field>
                                    </form-single>
                                </container-dialog>
                            </button-menu>
                        </container>
                    </container>
                </container>

                <container-box>
                    <box-header title="Week"/>
                    <box-toolbar>
                        <container-dialog id="AddLineDialog" button-text="Add working hours" icon="sym_o_add" type="default" width="640"
                                title="Add working hours to ${schedule.scheduleName}" condition="canEdit">
                            <label type="p" text="Local times in ${schedule.timeZone}. An end at or before the start ends the next day, as a night shift does; the hours count on the day it starts."/>
                            <form-single name="AddLine" transition="storeLine" map="lineValues">
                                <field name="workingScheduleId"><default-field><hidden/></default-field></field>
                                <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                <field name="isoDay">
                                    <default-field title="Day"><drop-down><list-options list="dayOptions" key="${key}" text="${text}"/></drop-down></default-field>
                                </field>
                                <field name="startTime"><default-field title="Start"><date-time type="time" format="HH:mm"/></default-field></field>
                                <field name="endTime"><default-field title="End"><date-time type="time" format="HH:mm"/></default-field></field>
                                <field name="breakMinutes"><default-field title="Break (minutes)"><text-line size="4" input-type="number"/></default-field></field>
                                <field name="fromDate"><default-field title="From" tooltip="Today, or the schedule's start when later, when empty"><date-time type="date"/></default-field></field>
                                <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                                <field-layout>
                                    <field-row><field-ref name="isoDay"/><field-ref name="fromDate"/></field-row>
                                    <field-row><field-ref name="startTime"/><field-ref name="endTime"/></field-row>
                                    <field-ref name="breakMinutes"/>
                                    <field-ref name="submitButton"/>
                                </field-layout>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body-nopad>
                        <form-list name="Lines" list="lines" skip-form="true" paginate="false" condition="lines.length">
                            <field name="dayText"><default-field title="Day"><display/></default-field></field>
                            <field name="startTime"><default-field title="Start"><display/></default-field></field>
                            <field name="endTime"><default-field title="End"><display text="${endTime}${nextDay ? ' (next day)' : ''}"/></default-field></field>
                            <field name="breakMinutes" align="right"><default-field title="Break (min)"><display/></default-field></field>
                            <field name="hours" align="right"><default-field title="Hours"><display format="#,##0.##"/></default-field></field>
                            <field name="fromDateText"><default-field title="From"><display/></default-field></field>
                            <field name="thruDateText"><default-field title="Through"><display/></default-field></field>
                            <field name="stateText">
                                <default-field title="State">
                                    <render-mode>
                                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColors[state] || 'grey-8'}">${
                                            WebUtilities.encodeHtml(stateText)}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateText})}]]></text>
                                        <text type="html">${stateText}</text>
                                    </render-mode>
                                </default-field>
                            </field>
                            <field name="actions" hide="!canEdit">
                                <conditional-field condition="canEdit &amp;&amp; state !== 'ended'" title="">
                                    <container-dialog id="ChangeLine_${workingScheduleLineId}" button-text="Change" icon="sym_o_edit" type="default"
                                            width="560" title="Change ${dayText} ${startTime}–${endTime}">
                                        <label type="p" text="From the date given; the weeks before it keep their hours."/>
                                        <form-single name="ChangeLine" transition="storeLine"
                                                map="{workingScheduleId:schedule.workingScheduleId, expectedRevision:schedule.revision,
                                                    workingScheduleLineId:workingScheduleLineId, startTime:startTime, endTime:endTime, breakMinutes:breakMinutes}">
                                            <field name="workingScheduleId"><default-field><hidden/></default-field></field>
                                            <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                            <field name="workingScheduleLineId"><default-field><hidden/></default-field></field>
                                            <field name="startTime"><default-field title="Start"><date-time type="time" format="HH:mm"/></default-field></field>
                                            <field name="endTime"><default-field title="End"><date-time type="time" format="HH:mm"/></default-field></field>
                                            <field name="breakMinutes"><default-field title="Break (minutes)"><text-line size="4" input-type="number"/></default-field></field>
                                            <field name="fromDate"><default-field title="From" tooltip="Today when empty"><date-time type="date"/></default-field></field>
                                            <field name="submitButton"><default-field title="Change"><submit/></default-field></field>
                                        </form-single>
                                    </container-dialog>
                                    <container-dialog id="EndLine_${workingScheduleLineId}" button-text="End" icon="sym_o_event_busy" type="default"
                                            width="520" title="End ${dayText} ${startTime}–${endTime}">
                                        <form-single name="EndLine" transition="storeLine"
                                                map="{workingScheduleId:schedule.workingScheduleId, expectedRevision:schedule.revision,
                                                    workingScheduleLineId:workingScheduleLineId, end:'true'}">
                                            <field name="workingScheduleId"><default-field><hidden/></default-field></field>
                                            <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                            <field name="workingScheduleLineId"><default-field><hidden/></default-field></field>
                                            <field name="end"><default-field><hidden/></default-field></field>
                                            <field name="fromDate"><default-field title="Ends on" tooltip="Today when empty"><date-time type="date"/></default-field></field>
                                            <field name="submitButton">
                                                <default-field title="End">
                                                    <submit type="danger" confirmation="End ${dayText} ${startTime}–${endTime} on the date given?"/></default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                </conditional-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="dayText"/><field-ref name="startTime"/></column>
                                <column><field-ref name="hours"/><field-ref name="stateText"/></column>
                            </columns>
                        </form-list>
                        <label type="p" style="q-pa-md m-muted" condition="!lines.length"
                                text="This schedule has no working hours yet.${canEdit ? ' Add them with Add working hours.' : ''}"/>
                    </box-body-nopad>
                </container-box>

                <section name="AssignmentRows" condition="assignmentsShown">
                    <widgets>
                        <container-box>
                            <box-header title="Assignments"/>
                            <box-body-nopad>
                                <form-list name="Assignments" list="assignments" skip-form="true" paginate="false" condition="assignments.length">
                                    <field name="personName">
                                        <default-field title="Employee">
                                            <link url="${sharedLinks['Employees/Employee360']}" text="${personName}" link-type="anchor"
                                                    parameter-map="{partyId:partyId}"/>
                                        </default-field>
                                    </field>
                                    <field name="fromDateText"><default-field title="From"><display/></default-field></field>
                                    <field name="thruDateText"><default-field title="Through"><display/></default-field></field>
                                    <field name="holidayCalendarName"><default-field title="Holiday calendar"><display text="${holidayCalendarName || 'The schedule\'s'}"/></default-field></field>
                                    <field name="stateText">
                                        <default-field title="State">
                                            <render-mode>
                                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColors[state] || 'grey-8'}">${
                                                    WebUtilities.encodeHtml(stateText)}</q-chip>]]></text>
                                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateText})}]]></text>
                                                <text type="html">${stateText}</text>
                                            </render-mode>
                                        </default-field>
                                    </field>
                                    <field name="actions" hide="!canAssign">
                                        <conditional-field condition="canAssign &amp;&amp; !thruDateText" title="">
                                            <container-dialog id="Release_${employmentAssignmentId}" button-text="End for employee" icon="sym_o_event_busy"
                                                    type="default" width="520" title="End ${schedule.scheduleName} for ${personName}">
                                                <label type="p" text="From the date given ${personName} follows no schedule: their own working hours or the timesheet policy's week apply again."/>
                                                <form-single name="ReleaseSchedule" transition="assignSchedule"
                                                        map="{workingScheduleId:schedule.workingScheduleId, partyRelationshipId:partyRelationshipId,
                                                            expectedRevision:revision, release:'true'}">
                                                    <field name="workingScheduleId"><default-field><hidden/></default-field></field>
                                                    <field name="partyRelationshipId"><default-field><hidden/></default-field></field>
                                                    <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                                    <field name="release"><default-field><hidden/></default-field></field>
                                                    <field name="fromDate"><default-field title="From" tooltip="Today when empty"><date-time type="date"/></default-field></field>
                                                    <field name="reason"><default-field title="Reason"><text-line size="50"/></default-field></field>
                                                    <field name="submitButton">
                                                        <default-field title="End for employee">
                                                            <submit type="danger" confirmation="End ${schedule.scheduleName} for ${personName} from the date given?"/></default-field>
                                                    </field>
                                                </form-single>
                                            </container-dialog>
                                        </conditional-field>
                                    </field>
                                    <columns type="mobile">
                                        <column><field-ref name="personName"/><field-ref name="fromDateText"/></column>
                                        <column><field-ref name="stateText"/><field-ref name="actions"/></column>
                                    </columns>
                                </form-list>
                                <label type="p" style="q-pa-md m-muted" condition="!assignments.length"
                                        text="Nobody follows this schedule now or later.${canAssign ? ' Assign it to employees with Assign.' : ''}"/>
                            </box-body-nopad>
                        </container-box>
                    </widgets>
                </section>

                <container-box>
                    <box-header title="Capacity preview"/>
                    <box-body>
                        <label type="p" style="text-caption m-muted"
                                text="A person's days as Projects and timesheets read them: the planned hours, less holidays and leave."/>
                        <form-single name="PreviewCapacity" transition="." map="previewValues">
                            <field name="workingScheduleId"><default-field><hidden/></default-field></field>
                            <field name="previewPartyId">
                                <default-field title="Person">
                                    <drop-down allow-empty="true">
                                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                                parameter-map="{choice:'employees', choiceOrganizationPartyId:schedule.organizationPartyId, selected:previewParty}"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="previewFromDate"><default-field title="From" tooltip="Today when empty"><date-time type="date"/></default-field></field>
                            <field name="previewThruDate"><default-field title="Through" tooltip="Two weeks when empty; at most 62 days"><date-time type="date"/></default-field></field>
                            <field name="submitButton"><default-field title="Preview"><submit/></default-field></field>
                            <field-layout>
                                <field-row-big>
                                    <field-ref name="previewPartyId"/>
                                    <field-ref name="previewFromDate"/>
                                    <field-ref name="previewThruDate"/>
                                    <field-ref name="submitButton"/>
                                </field-row-big>
                            </field-layout>
                        </form-single>
                        <label type="p" condition="previewShown"
                                text="${preview.personName}: ${preview.sourceText}, ${preview.base} h planned, ${preview.capacity} h available."/>
                        <label type="p" style="m-muted" condition="!previewShown" text="Choose a person to preview their days."/>
                    </box-body>
                    <box-body-nopad>
                        <form-list name="PreviewDays" list="previewDays" skip-form="true" paginate="false" condition="previewDays.length">
                            <field name="day"><default-field title="Day"><display/></default-field></field>
                            <field name="weekdayText"><default-field title="Weekday"><display/></default-field></field>
