<!-- People › Time & leave › Hours for pay (design-people §6 HoursForPay; style-guide §3.6 Task; impl-people P24): a pay group's prepared
    period reconciled employment by employment from mantle.humanres.PayrollInputServices.get#Reconciliation: hours scheduled, present
    (attendance), submitted and approved (timesheets), payable by the group's time basis (the other stream is comparison evidence),
    paid and unpaid leave, pieces and the claims reserved for payroll, what is prepared and what blocks it; hours and counts only,
    never an amount. Reconciliation (the list, an employment opened with its days, its timesheets, attendance to resolve, leave
    and inputs, each source linked); PrepareInputs (the one primary, payroll's: prepare#Inputs for the period, previewed first,
    with a source cutoff and some employees); ResolveInput (payroll's: the hours of a day recorded as an adjustment,
    store#Adjustment, which a payroll approver approves, and the day's stream then pays nothing more). Payroll's (the payroll
    operator and approver) and the managers' (their reports' rows, read only), BOSS_PPL_HOURS_FOR_PAY; Mantle checks every read and
    change. Preparing changes no money. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Hours for pay" default-menu-index="13" menu-image="sym_o_more_time" menu-image-type="icon">
    <parameter name="payrollGroupId"/>
    <parameter name="timePeriodId"/>
    <parameter name="partyRelationshipId"/>
    <parameter name="state"/>
    <parameter name="term"/>
    <parameter name="pageIndex"/>
    <transition-include name="choices" location="component://mr-boss/template/PeopleParts.xml"/>
    <!-- the period prepared, or previewed: each employment on its own, a block named and the rest going on -->
    <transition name="prepareInputs">
        <actions>
            <service-call name="mantle.humanres.PayrollInputServices.prepare#Inputs" out-map="prepared"
                    in-map="{payrollGroupId:payrollGroupId, timePeriodId:timePeriodId,
                        partyRelationshipIds:(partyRelationshipIds ? (Array.isArray(partyRelationshipIds) ? partyRelationshipIds.join(',') : String(partyRelationshipIds)) : null),
                        cutoffDate:(cutoffDate || null), preview:(preview == 'Y')}"/>
            <script><![CDATA[
                if (!ec.message.hasError() && prepared) {
                    const preparedRows = Array.from(prepared.rows || [])
                    const blocked = preparedRows.filter(row => row.outcome === 'blocked' || row.outcome === 'refused')
                    const made = preparedRows.reduce((sum, row) => sum + (blocked.includes(row) ? 0 : Number(row.createdCount || 0)), 0)
                    const voided = preparedRows.reduce((sum, row) => sum + (blocked.includes(row) ? 0 : Number(row.voidedCount || 0)), 0)
                    const text = made + ' input' + (made == 1 ? '' : 's') + (voided ? ', ' + voided + ' voided and made again' : '')
                    if (preview == 'Y') ec.message.addMessage('Preview, nothing prepared: ' + text + ' would be made', 'info')
                    else ec.message.addMessage('Prepared: ' + text, 'success')
                    if (blocked.length) ec.message.addMessage('Not prepared: ' + blocked.map(row => row.personName + ' (' + row.message + ')').join('; '), 'warning')
                }
            ]]></script>
        </actions>
        <default-response url="."><parameter name="payrollGroupId"/><parameter name="timePeriodId"/></default-response>
        <error-response url="."><parameter name="payrollGroupId"/><parameter name="timePeriodId"/></error-response>
    </transition>
    <!-- the hours or pieces of a day payroll resolves: an adjustment waiting for a payroll approver -->
    <transition name="resolveInput">
        <actions>
            <service-call name="mantle.humanres.PayrollInputServices.store#Adjustment" out-map="stored"
                    in-map="{partyRelationshipId:partyRelationshipId, inputTypeEnumId:(inputTypeEnumId || 'PitWorked'), inputDate:(inputDate || null),
                        quantity:(quantity || null), reason:(reason || null), evidence:(evidence || null)}"/>
            <if condition="!ec.message.hasError()"><message type="success">Recorded; it waits for a payroll approver</message></if>
        </actions>
        <default-response url="."><parameter name="payrollGroupId"/><parameter name="timePeriodId"/><parameter name="partyRelationshipId"/></default-response>
        <error-response url="."><parameter name="payrollGroupId"/><parameter name="timePeriodId"/><parameter name="partyRelationshipId"/></error-response>
    </transition>
    <actions>
        <if condition="payrollGroupId &amp;&amp; timePeriodId">
            <service-call name="mantle.humanres.PayrollInputServices.get#Reconciliation" out-map="found" transaction="force-new" ignore-error="true"
                    in-map="{payrollGroupId:payrollGroupId, timePeriodId:timePeriodId, partyRelationshipId:(partyRelationshipId || null),
                        state:(state || null), term:(term || null), pageIndex:(pageIndex || 0)}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <script><![CDATA[
            chosen = !!(payrollGroupId && timePeriodId)
            reconciled = !!found?.group
            canPrepare = !!found?.canPrepare
            stateColors = {ready: 'primary', blocked: 'negative', prepared: 'positive', changed: 'orange-9', nothing: 'grey-8', failed: 'negative'}
            employmentRows = Array.from(found?.employments || [])
            employmentsCount = found?.employmentsCount || 0
            employmentsPageIndex = found?.employmentsPageIndex || 0
            employmentsPageSize = found?.employmentsPageSize || 20
            employmentsPageMaxIndex = found?.employmentsPageMaxIndex || 0
            employmentsPageRangeLow = found?.employmentsPageRangeLow || 0
            employmentsPageRangeHigh = found?.employmentsPageRangeHigh || 0
            group = found?.group || null
            period = found?.period || null
            counts = found?.counts || {}
            findValues = {payrollGroupId: payrollGroupId || null, timePeriodId: timePeriodId || null, state: state || null, term: term || null}
            employment = found?.employment || null
            dayRows = Array.from(employment?.days || [])
            sheetRows = Array.from(employment?.timesheets || [])
            leaveRows = Array.from(employment?.leave || [])
            inputRows = Array.from(employment?.inputs || [])
            employmentProblems = Array.from(employment?.problems || []).concat(Array.from(employment?.notes || [])).map(row => row.text)
            timesheetUrl = sharedLinks?.['Time/TimesheetDetail'] || null
            leaveUrl = sharedLinks?.['Time/LeaveRequestDetail'] || null
            attendanceUrl = sharedLinks?.['Time/Attendance'] || null
            adjustmentsUrl = sharedLinks?.['Payroll/PayAdjustments'] || null
        ]]></script>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm">
            <container style="col">
                <label text="Hours for pay" type="h5"/>
                <label text="${group.groupName} · ${period.text} · ${group.basisText}" type="div" style="text-caption m-muted" condition="reconciled"/>
            </container>
            <container style="col-auto row q-gutter-sm">
                <container-dialog id="PrepareInputsDialog" button-text="Prepare inputs" icon="sym_o_playlist_add_check" type="primary" width="620"
                        title="Prepare the period's pay inputs" condition="reconciled &amp;&amp; canPrepare">
                    <label type="p" text="Each employee's approved hours, leave, pieces and payroll claims for ${period.text} become pay inputs once; what changed since is prepared again. An employee with time to approve or attendance to resolve is left out and named. Preview first to see what would be made."/>
                    <form-single name="PrepareInputs" transition="prepareInputs" map="{payrollGroupId:payrollGroupId, timePeriodId:timePeriodId}">
                        <field name="payrollGroupId"><default-field><hidden/></default-field></field>
                        <field name="timePeriodId"><default-field><hidden/></default-field></field>
                        <field name="partyRelationshipIds">
                            <default-field title="Only these employees" tooltip="Every employee of the group when empty">
                                <drop-down allow-multiple="true" allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0"
                                            parameter-map="{choice:'payEmployments', choiceOrganizationPartyId:group.organizationPartyId}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="cutoffDate">
                            <default-field title="Source cutoff" tooltip="Time and leave approved after this wait for the next preparation; now when empty">
                                <date-time type="timestamp"/></default-field>
                        </field>
                        <field name="preview">
                            <default-field title=" "><check><option key="Y" text="Preview only: prepare nothing"/></check></default-field>
                        </field>
                        <field name="submitButton">
                            <default-field title="Prepare inputs"><submit confirmation="Prepare the pay inputs of ${period.text}?"/></default-field>
                        </field>
                    </form-single>
                </container-dialog>
                <link url="${adjustmentsUrl}" url-type="plain" text="Pay adjustments" icon="sym_o_tune" link-type="anchor-button"
                        condition="adjustmentsUrl &amp;&amp; canPrepare"/>
            </container>
        </container>

        <form-single name="FindReconciliation" transition="." map="findValues">
            <field name="payrollGroupId">
                <default-field title="Pay group">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'hoursGroups', selected:findValues.payrollGroupId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="timePeriodId">
                <default-field title="Period">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'payPeriods', selected:findValues.timePeriodId}">
                            <depends-on field="payrollGroupId" parameter="choicePayrollGroupId"/>
                        </dynamic-options>
                    </drop-down>
                </default-field>
            </field>
            <field name="state">
                <default-field title="State">
                    <drop-down allow-empty="true">
                        <option key="blocked" text="Blocked"/>
                        <option key="ready" text="Ready to prepare"/>
                        <option key="changed" text="Changed since prepared"/>
                        <option key="prepared" text="Prepared"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="term"><default-field title="Name"><text-find size="16" hide-options="true"/></default-field></field>
            <field name="submitButton"><default-field title="Reconcile"><submit/></default-field></field>
            <field-layout>
                <field-row-big><field-ref name="payrollGroupId"/><field-ref name="timePeriodId"/><field-ref name="state"/>
                    <field-ref name="term"/><field-ref name="submitButton"/></field-row-big>
            </field-layout>
        </form-single>

        <section name="ChooseFirst" condition="!chosen">
            <widgets>
                <label text="Choose a pay group and one of its prepared periods to reconcile its hours before a pay run." type="p" style="m-muted"/>
            </widgets>
        </section>
        <section name="NotOpen" condition="chosen &amp;&amp; !reconciled">
            <widgets>
                <label text="This pay group's hours are not available to you. Hours for pay are open to payroll, and to managers for their reports." type="p" style="m-muted"/>
            </widgets>
        </section>
        <section name="Reconciliation" condition="reconciled">
            <widgets>
                <dashboard min-width="150" style="q-mb-sm">
                    <number-card title="Ready to prepare" value="${counts.ready || 0}" icon="sym_o_playlist_add" size="sm"/>
                    <number-card title="Blocked" value="${counts.blocked || 0}" icon="sym_o_block" size="sm"/>
                    <number-card title="Changed since prepared" value="${counts.changed || 0}" icon="sym_o_sync_problem" size="sm"/>
                    <number-card title="Prepared" value="${counts.prepared || 0}" icon="sym_o_task_alt" size="sm"/>
                </dashboard>
                <label text="Payable hours come from ${group.basisText.toLowerCase()}; the other stream is shown only to compare. Hours, never amounts."
                        type="p" style="text-caption m-muted"/>
                <container-box>
                    <box-body-nopad>
                        <form-list name="ReconciliationList" list="employmentRows" skip-form="true" paginate="true" condition="employmentRows.length">
                            <field name="personName">
                                <default-field title="Employee">
                                    <link url="." text="${personName}" link-type="anchor"
                                            parameter-map="{payrollGroupId:payrollGroupId, timePeriodId:timePeriodId, partyRelationshipId:partyRelationshipId}"/>
                                </default-field>
                            </field>
                            <field name="scheduledText" align="right"><default-field title="Scheduled"><display/></default-field></field>
                            <field name="presentText" align="right"><default-field title="Present"><display/></default-field></field>
                            <field name="submittedText" align="right"><default-field title="Submitted"><display/></default-field></field>
                            <field name="approvedText" align="right"><default-field title="Approved"><display/></default-field></field>
                            <field name="payableText" align="right"><default-field title="Payable"><display/></default-field></field>
                            <field name="paidLeaveText" align="right"><default-field title="Paid leave"><display/></default-field></field>
                            <field name="unpaidLeaveText" align="right"><default-field title="Unpaid leave"><display/></default-field></field>
                            <field name="piecesText" align="right"><default-field title="Pieces"><display/></default-field></field>
                            <field name="claimCount" align="right"><default-field title="Claims"><display/></default-field></field>
                            <field name="differenceText"><default-field title="Other stream"><display/></default-field></field>
                            <field name="stateText">
                                <default-field title="State">
                                    <render-mode>
                                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColors[state] || 'grey-8'}">${
                                            WebUtilities.encodeHtml(stateText)}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateText})}]]></text>
                                        <text type="html">${stateText}</text>
                                    </render-mode>
                                </default-field>
                            </field>
                            <field name="problemsText"><default-field title="What stops it"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="personName"/><field-ref name="payableText"/></column>
                                <column><field-ref name="stateText"/><field-ref name="problemsText"/></column>
                            </columns>
                        </form-list>
                        <label type="p" style="q-pa-md m-muted" condition="!employmentRows.length"
                                text="No employee of this group matches. Employees join a pay group through their pay assignment."/>
                    </box-body-nopad>
                </container-box>

                <section name="OpenedEmployment" condition="employment">
                    <widgets>
                        <container-box>
                            <box-header title="Hours of ${employment.personName}"/>
                            <box-toolbar>
                                <container-dialog id="ResolveInputDialog" button-text="Resolve a day" icon="sym_o_edit_calendar" width="560"
                                        title="Resolve a day of ${employment.personName}" condition="canPrepare">
                                    <label type="p" text="Record the hours or pieces payroll pays for a day, with the reason and its evidence. A payroll approver approves it; the day's time is then paid by it alone, and the time records stay as they are."/>
                                    <form-single name="ResolveInput" transition="resolveInput"
                                            map="{payrollGroupId:payrollGroupId, timePeriodId:timePeriodId, partyRelationshipId:employment.partyRelationshipId, inputTypeEnumId:'PitWorked'}">
                                        <field name="payrollGroupId"><default-field><hidden/></default-field></field>
                                        <field name="timePeriodId"><default-field><hidden/></default-field></field>
                                        <field name="partyRelationshipId"><default-field><hidden/></default-field></field>
                                        <field name="inputDate"><default-field title="Day"><date-time type="date"/></default-field></field>
                                        <field name="inputTypeEnumId">
                                            <default-field title="What">
                                                <drop-down>
                                                    <option key="PitWorked" text="Worked hours"/>
                                                    <option key="PitPaidLeave" text="Paid leave hours"/>
                                                    <option key="PitUnpaidLeave" text="Unpaid leave hours"/>
                                                    <option key="PitPieces" text="Pieces"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="quantity"><default-field title="Hours or pieces"><text-line size="8" input-type="number"/></default-field></field>
                                        <field name="reason"><default-field title="Reason"><text-line size="50"/></default-field></field>
                                        <field name="evidence"><default-field title="Evidence" tooltip="What it rests on: a note, a badge log, a call"><text-line size="50"/></default-field></field>
                                        <field name="submitButton"><default-field title="Record for approval"><submit/></default-field></field>
                                        <field-layout>
                                            <field-row><field-ref name="inputDate"/><field-ref name="inputTypeEnumId"/></field-row>
                                            <field-ref name="quantity"/>
                                            <field-ref name="reason"/>
                                            <field-ref name="evidence"/>
                                            <field-ref name="submitButton"/>
                                        </field-layout>
                                    </form-single>
                                </container-dialog>
                                <link url="." text="Close" icon="sym_o_close" link-type="anchor-button" btn-type="default"
                                        parameter-map="{payrollGroupId:payrollGroupId, timePeriodId:timePeriodId, partyRelationshipId:''}"/>
                            </box-toolbar>
                            <box-body>
                                <label text="${employmentProblems.join('; ')}" type="p" style="text-warning" condition="employmentProblems.length"/>
                                <form-list name="DayRows" list="dayRows" skip-form="true" paginate="false" condition="dayRows.length">
                                    <field name="day"><default-field title="Day"><display/></default-field></field>
                                    <field name="approvedText" align="right"><default-field title="Approved time"><display/></default-field></field>
                                    <field name="presentText" align="right"><default-field title="Attendance"><display/></default-field></field>
                                    <field name="leaveText" align="right"><default-field title="Leave"><display/></default-field></field>
                                    <field name="inputsText"><default-field title="Prepared"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="day"/><field-ref name="approvedText"/></column>
                                        <column><field-ref name="leaveText"/><field-ref name="inputsText"/></column>
                                    </columns>
                                </form-list>
                                <label text="No time, attendance or leave in this period." type="p" style="m-muted" condition="!dayRows.length"/>
                                <form-list name="SheetRows" list="sheetRows" skip-form="true" paginate="false" condition="sheetRows.length">
                                    <field name="weekText">
                                        <default-field title="Timesheet">
                                            <link url="${timesheetUrl}" url-type="plain" text="${weekText}" link-type="anchor"
                                                    parameter-map="{timesheetId:timesheetId}" condition="timesheetUrl"/>
                                            <label text="${weekText}" type="span" condition="!timesheetUrl"/>
                                        </default-field>
                                    </field>
                                    <field name="statusText"><default-field title="State"><display/></default-field></field>
                                </form-list>
                                <form-list name="LeaveRows" list="leaveRows" skip-form="true" paginate="false" condition="leaveRows.length">
                                    <field name="text">
                                        <default-field title="Leave">
                                            <link url="${leaveUrl}" url-type="plain" text="${text}" link-type="anchor"
                                                    parameter-map="{leaveRequestId:leaveRequestId}" condition="leaveUrl"/>
                                            <label text="${text}" type="span" condition="!leaveUrl"/>
                                        </default-field>
                                    </field>
                                    <field name="stateText"><default-field title="State"><display/></default-field></field>
                                </form-list>
                                <link url="${attendanceUrl}" url-type="plain" text="Resolve attendance" icon="sym_o_fact_check" link-type="anchor-button"
                                        condition="attendanceUrl &amp;&amp; employment.unresolvedDays?.length"/>
                                <form-list name="InputRows" list="inputRows" skip-form="true" paginate="false" condition="inputRows.length">
                                    <field name="inputDateText"><default-field title="Day"><display/></default-field></field>
                                    <field name="typeText"><default-field title="Input"><display/></default-field></field>
                                    <field name="quantityText" align="right"><default-field title="Quantity"><display/></default-field></field>
                                    <field name="stateText"><default-field title="State"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="typeText"/><field-ref name="inputDateText"/></column>
                                        <column><field-ref name="quantityText"/><field-ref name="stateText"/></column>
                                    </columns>
                                </form-list>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
