<!-- People › Settings › Settings (design-people §12 Settings; style-guide §3.9 Settings; impl-people P1): SetupReadiness, the
    checks of what is built for each employer in the People administrator's scope that has employees (a department set up,
    every employee with a manager), over mantle.humanres.PeopleServices.get#Readiness, the same checks Admin's Health shows
    from its readiness registry (people.setup). An employer with no employees has no check yet. P29: every phase's checks (payroll,
    positions, the approval rules' HR fallback, an onboarding checklist, a working schedule, a leave policy, the confidential case
    intake), each linking the place that sets it up; PeoplePreferences is the Preferences tab. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Settings" default-menu-index="1">
    <parameter name="organizationPartyId"/>
    <transition-include name="choices" location="component://mr-boss/template/PeopleParts.xml"/>
    <actions>
        <if condition="people.capabilities.configure">
            <service-call name="mantle.humanres.PeopleServices.get#Readiness" out-map="readiness" transaction="force-new"
                    ignore-error="true" in-map="{providerKey:'people.setup', organizationPartyId:(organizationPartyId || null)}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="readinessFound" from="!!readiness?.checks"/>
        <set field="stateNames" from="{ready: 'Ready', warning: 'Warning', failed: 'Failed', unavailable: 'Unavailable'}"/>
        <set field="stateColors" from="{ready: 'positive', warning: 'warning', failed: 'negative', unavailable: 'grey-8'}"/>
        <!-- P29: each check opens the place that sets it up (its fixRoute, the key Admin's Health resolves too) -->
        <set field="fixPaths" from="{peopleSettings: 'Settings', peoplePayAssignments: 'Payroll/PayAssignments', peoplePayGroups: 'Payroll/PayGroups',
                peoplePositions: 'Staffing/Positions', peopleApprovalRules: 'Settings/ApprovalPolicies', peopleChecklists: 'Employees/ChecklistTemplates',
                peopleWorkingSchedules: 'Time/WorkingSchedules', peopleLeavePolicies: 'Time/LeavePolicies', peoplePreferences: 'Settings/Preferences'}"/>
        <set field="checkRows" from="(readiness?.checks || []).map(row =&gt; Object.assign({}, row, {
                stateName: stateNames[row.state] || stateNames.unavailable, stateColor: stateColors[row.state] || stateColors.unavailable,
                fixUrl: row.fixRoute &amp;&amp; fixPaths[row.fixRoute] &amp;&amp; row.fixRoute !== 'peopleSettings' ? sharedLinks?.[fixPaths[row.fixRoute]] || null : null}))"/>
        <set field="findValues" from="{organizationPartyId: organizationPartyId || null}"/>
    </actions>
    <widgets>
        <label text="People settings" type="h5"/>
        <label text="People's setup checks are the People administrator's." type="p" style="m-muted"
                condition="!people.capabilities.configure"/>
        <section name="SetupReadiness" condition="people.capabilities.configure">
            <widgets>
                <form-single name="ReadinessFind" transition="." map="findValues">
                    <field name="organizationPartyId">
                        <default-field title="Employer">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'employers', selected:findValues.organizationPartyId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="submitButton"><default-field title="Check"><submit/></default-field></field>
                    <field-layout><field-row><field-ref name="organizationPartyId"/><field-ref name="submitButton"/></field-row></field-layout>
                </form-single>
                <label text="This employer is not available to you." type="p" style="text-negative"
                        condition="organizationPartyId &amp;&amp; !readinessFound"/>
                <label text="Setup readiness is not available just now." type="p" style="m-muted"
                        condition="!organizationPartyId &amp;&amp; !readinessFound"/>
                <label text="No employer you administer has employees yet, so there is nothing to check." type="p" style="m-muted"
                        condition="readinessFound &amp;&amp; !checkRows.length"/>
                <section name="ReadinessRows" condition="checkRows.length">
                    <widgets>
                        <container-box>
                            <box-header title="Setup readiness"/>
                            <box-body>
                                <form-list name="SetupReadinessRows" list="checkRows" skip-form="true" paginate="false">
                                    <field name="organizationName"><default-field title="Employer"><display/></default-field></field>
                                    <field name="title"><default-field title="Check"><display/></default-field></field>
                                    <field name="stateName"><default-field title="State">
                                        <render-mode>
                                            <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${
                                                WebUtilities.encodeHtml(stateName)}</q-chip>]]></text>
                                            <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateName})}]]></text>
                                            <text type="html">${stateName}</text>
                                        </render-mode>
                                    </default-field></field>
                                    <field name="message"><default-field title="Explanation"><display/></default-field></field>
                                    <field name="fixUrl">
                                        <default-field title="">
                                            <link url="${fixUrl}" text="Set up" link-type="anchor" condition="fixUrl"/>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column><field-ref name="title"/><field-ref name="organizationName"/><field-ref name="message"/></column>
                                        <column><field-ref name="stateName"/><field-ref name="fixUrl"/></column>
                                    </columns>
                                </form-list>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
