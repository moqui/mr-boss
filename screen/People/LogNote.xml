<!-- LogNote (design-people §1.4 Assist "Log as note"; impl-people P29): the People root's response-action opens it in the shell's
    quick-create frame from an Assist answer on an application's page (ApplicantDetail), with the page's record (entityName,
    recordId) and the answer's text in noteText. The application is checked as People checks it (a recruiter of its employer:
    PEOPLE_RECRUIT_VIEW and RecruitingServices.get#Application; its notes are the recruiters'); the user reads and edits the text,
    then files it as a note on it (mantle.party.CommunicationServices.log#RecordNote), seen in its notes by those who may see them.
    No other People record takes a note from Assist: an employment's notes are HR's on Employee360, and a confidential case's,
    a review's or a qualification's are never written from an Assist answer. Nothing is filed until the user submits. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Log as note" default-menu-include="false">
    <parameter name="entityName"/>
    <parameter name="recordId"/>
    <transition name="logNote">
        <actions>
            <if condition="entityName != 'mantle.humanres.employment.EmploymentApplication' || !recordId">
                <return error="true" message="Open an application to log a note on it"/></if>
            <if condition="!people?.capabilities?.recruitView"><return error="true" message="An application's notes are the recruiters'"/></if>
            <service-call name="mantle.humanres.RecruitingServices.get#Application" in-map="{employmentApplicationId:recordId}"/>
            <if condition="!ec.message.hasError()">
                <service-call name="mantle.party.CommunicationServices.log#RecordNote"
                        in-map="{recordEntityName:entityName, recordId:recordId, body:noteText, subject:'Assist note'}"/>
            </if>
            <if condition="!ec.message.hasError()"><message type="success">Note logged</message></if>
        </actions>
        <default-response url="."><parameter name="entityName"/><parameter name="recordId"/></default-response>
        <error-response url="."><parameter name="entityName"/><parameter name="recordId"/></error-response>
    </transition>
    <actions>
        <set field="noteRecord" from="entityName == 'mantle.humanres.employment.EmploymentApplication' &amp;&amp; recordId &amp;&amp;
                people?.capabilities?.recruitView ? recordId : null"/>
        <set field="noteValues" from="{entityName:entityName, recordId:noteRecord, noteText:''}"/>
    </actions>
    <widgets>
        <label text="Log as note" type="h6"/>
        <section name="NoRecord" condition="!noteRecord">
            <widgets><label type="p" style="m-muted" text="Open an application to log a note on it."/></widgets>
        </section>
        <section name="LogNoteFormShown" condition="noteRecord"><widgets>
            <form-single name="LogNoteForm" transition="logNote" map="noteValues">
                <field name="entityName"><default-field><hidden/></default-field></field>
                <field name="recordId"><default-field title="Application"><display/></default-field></field>
                <field name="noteText">
                    <default-field title="Note" tooltip="A note on the application, seen by its recruiters">
                        <text-area rows="8" cols="60"/>
                    </default-field>
                </field>
                <field name="submitButton"><default-field title="Log the note"><submit/></default-field></field>
            </form-single>
        </widgets></section>
    </widgets>
</screen>
