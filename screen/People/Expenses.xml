<!-- People › Expenses (design-people §1.2, §9; impl-people P15): expense claims (ExpenseClaims, the default, with ExpenseClaimDetail
    and its print out of the menu) and employee advances (EmployeeAdvances). Every People user's through the root, and a self-service
    employee's without the launcher by the area's own grant (BOSS_PPL_EXPENSES, as Time & leave's), to claim their own expenses and
    ask their own advances: what each user reads, changes and decides is Mantle's ExpenseServices' check (the claimant, their
    manager, an approver of the step waiting, HR and payroll of the employer). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Expenses" default-menu-index="11" menu-image="sym_o_receipt_long" menu-image-type="icon">
    <subscreens default-item="ExpenseClaims"/>
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
