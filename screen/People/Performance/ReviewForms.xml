<!-- People › Reviews & goals › Review forms (design-people §11 ReviewDetail, §13 Forms; impl-people P20): the review forms a
    review template names for its self assessment, reviewer's assessment and feedback, built by the review administrator. The survey
    builder's shared screens (List: Shared/SurveyForms, FormDetail: Shared/SurveyFormDetail) with People's Performance mount of its
    registration (service/ironstone/shared/SurveyApps.js: the review purpose alone, edited with PEOPLE_DEVELOP_EDIT or
    PEOPLE_CONFIGURE, which Mantle's purpose registration admits and mantle.party.FormDefinitionServices checks again). The review
    administrator's and the People administrator's (BOSS_PPL_REVIEW_ADMIN: ALWAYS for BOSS_PEOPLE_DEVELOP, denied to the root user
    group and self-service; the People administrator and ADMIN through the root's ALWAYS). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Review forms" default-menu-index="4" menu-image="sym_o_quiz" menu-image-type="icon">
    <always-actions>
        <!-- the survey builder's screens below take People's Performance mount of its registration -->
        <set field="surveyMount" value="Performance"/>
    </always-actions>
    <subscreens default-item="List" always-use-full-path="true">
        <subscreens-item name="List" location="component://mr-boss/screen/Shared/SurveyForms.xml" menu-include="false"/>
        <subscreens-item name="FormDetail" location="component://mr-boss/screen/Shared/SurveyFormDetail.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
