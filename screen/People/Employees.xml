<!-- People › Employees (design-people §4 Employees, Employee360, OrgStructure and OrgChart, §1.2; impl-people P2, P3): the
    directory, the employee record and the organization. The menu group of design §1.2: Employees (the list, the default
    subscreen Employees/List, so /qapps/People/Employees is the list), Organization (OrgStructure, P3) and Org chart (OrgChart,
    P3); Employee360 (the shared record, Shared/Employee360.xml, with People's context) is opened from a person. Every People user
    opens them: what each sees is what Mantle's services admit (a staff reader the employers they read, a manager their reports
    in the directory, HR the HR columns and regions and the changes to units, memberships and reporting lines). P6: HireEmployee and
    EmploymentChange (wizards under Employees/, HR's by their grant BOSS_PPL_EMPLOYMENT), out of the menu, opened from the directory,
    the quick create and Employee360. P7: EquipmentDetail (the shared equipment detail, Shared/EquipmentDetail.xml, with People's
    context: custody and the return at a separation), out of the menu, opened from Employee360's equipment and a return task;
    Checklists (ChecklistTemplates) and Employee import (EmployeeImport, the shared import wizard for the `employees` target), files
    under Employees/, HR's by their grant BOSS_PPL_HR_AREA (moved out of Settings by the user's call of Nov 11). P21: Grievances (menu
    index 4, a file under Employees/: the user's confidential cases, every People user's and a self-service employee's by its own
    grant, BOSS_PPL_CASES_SELF) and RequestDetail (the shared request detail, Shared/RequestDetail.xml, with People's branch: a
    confidential case for its people alone; any other request is not available here), out of the menu. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Employees" default-menu-index="4" menu-image="sym_o_badge" menu-image-type="icon">
    <subscreens default-item="List">
        <subscreens-item name="Employee360" location="component://mr-boss/screen/Shared/Employee360.xml" menu-include="false"/>
        <subscreens-item name="EquipmentDetail" location="component://mr-boss/screen/Shared/EquipmentDetail.xml" menu-include="false"/>
        <!-- P21: a confidential case (People's branch of the shared request detail) -->
        <subscreens-item name="RequestDetail" location="component://mr-boss/screen/Shared/RequestDetail.xml" menu-include="false"/>
        <!-- P3: OrgStructure (menu index 2) and OrgChart (3) are files under Employees/ -->
    </subscreens>
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
