<!-- People › Time & leave (design-people §6, §7, §1.2; impl-people P9): the menu group of time and leave. P9 builds Working
    schedules (the default subscreen, Time/WorkingSchedules) with WorkingScheduleDetail opened from a row, and Holidays
    (Time/HolidayCalendars, HR's own editor here rather than in Settings, as the user's call of Nov 11 put HR's editors out of the
    People administrator's Settings); attendance, the shift roster, timesheets, hours for pay and leave join with their phases.
    The area is HR's and the managers' (BOSS_PPL_TIME: denied to the root user group; Holidays HR's alone, BOSS_PPL_HOLIDAYS), and
    what each sees is what Mantle's ScheduleServices admit: the schedules of the employers an HR officer reads, those a manager's
    reports follow. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Time &amp; leave" default-menu-index="7" menu-image="sym_o_schedule" menu-image-type="icon">
    <subscreens default-item="WorkingSchedules">
        <!-- WorkingSchedules (menu index 2) and HolidayCalendars (9) are files under Time/, with WorkingScheduleDetail out of the
            menu -->
    </subscreens>
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
