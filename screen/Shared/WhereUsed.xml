<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Where used" default-menu-include="false">
    <parameter name="appRoot" />
    <parameter name="productId" />
    <parameter name="productBomId" />
    <parameter name="organizationPartyId" />
    <parameter name="workEffortId" />
    <parameter name="asOfDate" />
    <parameter name="quantity" />
    <parameter name="quantityUomId" />
    <parameter name="facilityId" />
    <parameter name="leftDate" />
    <parameter name="rightDate" />
    <always-actions>
        <service-call name="ironstone.products.CatalogServices.get#SharedContext" in-map="{appRoot:appRoot}" out-map="sharedMountContext"/>
        <script>if(!sharedMountContext.capabilities.read)throw new Error('Catalog read access is required')</script>
        <set field="appRoot" from="sharedMountContext.appRoot"/>
        <set field="sharedLinks" from="sharedMountContext.sharedLinks"/>
        <set field="printBase" from="sharedMountContext.printBase"/>
    </always-actions>
    <actions>
        <service-call name="ironstone.products.MethodServices.get#BomWhereUsed" in-map="context" out-map="context" />
        <set field="kitComponentsUrl" from="sharedLinks['Products/Product360'] + '/KitComponents'"/>
    </actions>
    <widgets>
        <label text="Where used" type="h5"/>
        <form-single name="WhereUsedParameters" transition=".">
            <field name="productId" from="productId || null">
                <default-field>
                    <hidden />
                </default-field>
            </field>
            <field name="productBomId" from="productBomId || null">
                <default-field>
                    <hidden />
                </default-field>
            </field>
            <field name="organizationPartyId" from="organizationPartyId || null">
                <default-field>
                    <hidden />
                </default-field>
            </field>
            <field name="asOfDate">
                <default-field title="As of date">
                    <date-time />
                </default-field>
            </field>
            <field name="submitButton">
                <default-field title="Show report">
                    <submit />
                </default-field>
            </field>
            <field-layout>
                <field-row-big><field-ref name="asOfDate"/><field-ref name="submitButton"/></field-row-big>
                <fields-not-referenced/>
            </field-layout>
        </form-single>
        <label text="${reportMessage || &quot;&quot;}" type="p" />
        <form-list name="WhereUsedFindings" list="findings || []" skip-form="true" paginate="false" show-csv-button="true">
            <field name="recordId">
                <default-field title="Record">
                    <display />
                </default-field>
            </field>
            <field name="message">
                <default-field title="Finding">
                    <display />
                </default-field>
            </field>
        </form-list>
        <form-list name="WhereUsedRows" list="whereUsedRows || []" skip-form="true" paginate="false" show-csv-button="true" views="tree,list">
            <view-tree parent-field="parentPath" key-fields="path" />
            <field name="productId">
                <!-- a kit's usage is read only here: its link opens Products' Kit components pane of the kit (D15) -->
                <default-field title="Parent product">
                    <link url="${kitComponentsUrl}" text="${productId}" link-type="anchor" condition="readOnly"
                            parameter-map="{productId:productId}"/>
                    <label text="${productId}" condition="!readOnly"/>
                </default-field>
            </field>
            <field name="depth">
                <default-field title="Level">
                    <display />
                </default-field>
            </field>
            <field name="kind">
                <default-field title="Usage">
                    <display />
                </default-field>
            </field>
            <field name="quantity">
                <default-field title="Quantity">
                    <display />
                </default-field>
            </field>
            <field name="quantityUomId">
                <default-field title="Unit">
                    <display-entity entity-name="moqui.basic.Uom"/>
                </default-field>
            </field>
            <field name="productBomId">
                <default-field title="Method">
                    <display />
                </default-field>
            </field>
            <field name="readOnly">
                <default-field title="Read only">
                    <display />
                </default-field>
            </field>
        </form-list>
    </widgets>
</screen>
