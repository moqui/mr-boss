<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Explain price" default-menu-index="4">
    <parameter name="appRoot" />
    <parameter name="productId" />
    <parameter name="organizationPartyId" />
    <parameter name="direction" />
    <parameter name="vendorPartyId" />
    <parameter name="customerPartyId" />
    <parameter name="priceUomId" />
    <parameter name="quantity" />
    <parameter name="quantityUomId" />
    <parameter name="validDate" />
    <parameter name="priceListId" />
    <parameter name="agreementId" />
    <parameter name="agreementItemSeqId" />
    <parameter name="productStoreId" />
    <parameter name="termUomId" />
    <parameter name="shipToCountryGeoId" />
    <parameter name="billToCountryGeoId" />
    <!-- Sales (impl-sales P7): the quote line whose price is explained -->
    <parameter name="orderId" />
    <parameter name="orderItemSeqId" />
    <always-actions>
        <service-call name="ironstone.products.CatalogServices.get#SharedContext" in-map="{appRoot:appRoot}" out-map="sharedMountContext"/>
        <script>if(!sharedMountContext.capabilities.read)throw new Error('Catalog read access is required')</script>
        <set field="appRoot" from="sharedMountContext.appRoot"/>
        <set field="sharedLinks" from="sharedMountContext.sharedLinks"/>
        <set field="printBase" from="sharedMountContext.printBase"/>
    </always-actions>
    <!-- in Purchasing (impl-purchasing P2, crosscut §3.21) the purchase direction only, for a supplier-price reader; in
        Customer Service (impl-customer-service P3, crosscut §3.5) the sales direction only, for a price reader -->
    <condition>
        <expression>(appRoot != 'Purchasing' || !!sharedMountContext.capabilities.supplierPriceRead)
            &amp;&amp; (appRoot != 'CustomerService' || !!sharedMountContext.capabilities.priceRead)</expression>
    </condition>
    <actions>
        <!-- Sales (impl-sales P7, F67; design-sales §7, crosscut §3.21's Sales row): a quote line's safe explanation for anyone who sees
            the quote (mantle.order.SalesQuoteServices.explain#QuoteLinePrice: the selected price, its source, the entered price and
            its reason, never a cost), and the full trace below only for a price reader (PRICE_VIEW), on the line's own context -->
        <set field="salesReader" from="appRoot == 'Sales' &amp;&amp; !sharedMountContext.capabilities.priceRead"/>
        <if condition="appRoot == 'Sales' &amp;&amp; orderId &amp;&amp; orderItemSeqId">
            <service-call name="mantle.order.SalesQuoteServices.explain#QuoteLinePrice" in-map="{orderId:orderId, orderItemSeqId:orderItemSeqId}"
                    out-map="salesExplained" transaction="force-new" ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
            <set field="salesExplanation" from="salesExplained?.explanation || null"/>
            <if condition="salesExplanation">
                <set field="productId" from="salesExplanation.productId"/>
                <set field="organizationPartyId" from="salesExplanation.organizationPartyId"/>
                <set field="customerPartyId" from="salesExplanation.customerPartyId"/>
                <set field="priceUomId" from="salesExplanation.currencyUomId"/>
                <set field="quantity" from="salesExplanation.quantityText"/>
                <!-- P15: the customer agreement whose negotiated price the line took, for a price reader's trace too -->
                <set field="agreementId" from="salesExplanation.agreementId || agreementId"/>
                <set field="agreementItemSeqId" from="salesExplanation.agreementItemSeqId || agreementItemSeqId"/>
            </if>
        </if>
        <if condition="salesReader">
            <set field="traceRows" from="[]"/>
            <return/>
        </if>
        <service-call name="ironstone.products.PriceListServices.get#PriceListOptions" out-map="context" />
        <set field="organizationPartyId" from="organizationPartyId || defaultOrganizationPartyId" />
        <set field="direction" from="appRoot == 'Purchasing' ? 'purchase' : appRoot == 'CustomerService' || appRoot == 'Sales' ? 'sales' : direction || (pricingAccess.canPriceRead ? 'sales' : 'purchase')" />
        <set field="priceUomId" from="priceUomId || 'USD'" />
        <set field="quantity" from="quantity || '1'" />
        <set field="vendorPartyId" from="vendorPartyId || (direction === 'sales' ? organizationPartyId : null)" />
        <set field="customerPartyId" from="customerPartyId || (direction === 'purchase' ? organizationPartyId : null)" />
        <set field="traceRows" from="[]" />
        <!-- a purchase explanation needs its supplier (the external vendor); Purchasing asks for one first -->
        <set field="supplierNeeded" from="appRoot == 'Purchasing' &amp;&amp; productId &amp;&amp; !vendorPartyId"/>
        <if condition="productId &amp;&amp; !supplierNeeded">
            <service-call name="ironstone.products.PriceListServices.get#PriceExplanation" in-map="context" out-map="context" />
        </if>
    </actions>
    <widgets>
        <!-- Sales (impl-sales P7): the quote line's selected price, for anyone who sees the quote -->
        <section name="SalesQuotePrice" condition="appRoot == 'Sales'">
            <widgets>
                <section name="SalesQuotePriceFound" condition="salesExplanation">
                    <widgets>
                        <container-box>
                            <box-header title="Price of quote ${salesExplanation.orderId} line ${salesExplanation.orderItemSeqId}"/>
                            <box-body>
                                <label type="h6" text="${salesExplanation.productName} · ${salesExplanation.quantityText} at ${salesExplanation.unitText}"/>
                                <label type="p" text="${salesExplanation.overridden ? 'Entered price' : salesExplanation.priceSourceText}${salesExplanation.customerPrice ? ' · the customer’s own price' : ''}${salesExplanation.priceListName ? ' · price list ' + salesExplanation.priceListName : ''}"/>
                                <label type="p" text="The negotiated price of agreement ${salesExplanation.agreementName} (${salesExplanation.agreementId}), in effect ${salesExplanation.agreementIntervalText}: it applies while the agreement is active."
                                        condition="salesExplanation.agreementId"/>
                                <label type="p" text="Calculated price: ${salesExplanation.calculatedText}${salesExplanation.listText ? ' · list price ' + salesExplanation.listText : ''}"/>
                                <label type="p" text="Entered because: ${salesExplanation.overrideReason}" condition="salesExplanation.overridden"/>
                                <label type="p" style="text-warning" text="Today's price is ${salesExplanation.currentText}; the line keeps the price it was given."
                                        condition="salesExplanation.currentChanged"/>
                                <link url="${sharedLinks['Orders/OrderDetail'] || '//Sales/Orders/OrderDetail'}" text="Back to the quote" link-type="anchor"
                                        parameter-map="{orderId:salesExplanation.orderId}"/>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
                <label type="p" text="Open a quote line's price to see where it came from." condition="!salesExplanation &amp;&amp; salesReader"/>
                <label type="p" style="m-muted" text="The full price trace is for price readers." condition="salesReader"/>
            </widgets>
        </section>
        <section name="ExplainContextControls" condition="sri.getRenderMode() !== 'html-print' &amp;&amp; !salesReader">
            <widgets>
                <container-box>
                    <box-header title="Transaction price context" />
                    <box-body>
                        <form-single name="PriceContext" transition=".">
                            <field name="productId">
                                <default-field title="Product ID">
                                    <text-line />
                                </default-field>
                            </field>
                            <field name="organizationPartyId">
                                <default-field title="Organization">
                                    <drop-down allow-empty="false">
                                        <list-options list="pricingOptions.organizations" key="${value}" text="${label}" />
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="direction">
                                <default-field title="Direction">
                                    <drop-down allow-empty="false">
                                        <option key="sales" text="Sales" />
                                        <option key="purchase" text="Supplier offers" />
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="vendorPartyId">
                                <default-field title="Vendor ID">
                                    <text-line />
                                </default-field>
                            </field>
                            <field name="customerPartyId">
                                <default-field title="Customer ID">
                                    <text-line />
                                </default-field>
                            </field>
                            <field name="priceUomId">
                                <default-field title="Currency">
                                    <drop-down allow-empty="false">
                                        <list-options list="pricingOptions.currencies" key="${value}" text="${label}" />
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="quantity">
                                <default-field title="Quantity">
                                    <text-line input-type="number" />
                                </default-field>
                            </field>
                            <field name="quantityUomId">
                                <default-field title="Quantity unit">
                                    <drop-down allow-empty="true">
                                        <list-options list="pricingOptions.units" key="${value}" text="${label}" />
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="validDate">
                                <default-field title="Effective date" tooltip="Leave empty to start now">
                                    <date-time />
                                </default-field>
                            </field>
                            <field name="priceListId">
                                <default-field title="Explicit price list">
                                    <drop-down allow-empty="true">
                                        <list-options list="pricingOptions.lists" key="${value}" text="${label}" />
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="agreementId">
                                <default-field title="Agreement ID">
                                    <text-line />
                                </default-field>
                            </field>
                            <field name="agreementItemSeqId">
                                <default-field title="Agreement item">
                                    <text-line />
                                </default-field>
                            </field>
                            <field name="productStoreId">
                                <default-field title="Store ID">
                                    <text-line />
                                </default-field>
                            </field>
                            <field name="termUomId">
                                <default-field title="Term unit ID">
                                    <text-line />
                                </default-field>
                            </field>
                            <field name="shipToCountryGeoId">
                                <default-field title="Ship-to country ID">
                                    <text-line />
                                </default-field>
                            </field>
                            <field name="billToCountryGeoId">
                                <default-field title="Bill-to country ID">
                                    <text-line />
                                </default-field>
                            </field>
                            <field name="submitButton">
                                <default-field title="Calculate price">
                                    <submit />
                                </default-field>
                            </field>
                            <field-layout>
                                <field-row>
                                    <field-ref name="productId" />
                                    <field-ref name="organizationPartyId" />
                                    <field-ref name="direction" />
                                </field-row>
                                <field-row>
                                    <field-ref name="vendorPartyId" />
                                    <field-ref name="customerPartyId" />
                                    <field-ref name="priceUomId" />
                                </field-row>
                                <field-row>
                                    <field-ref name="quantity" />
                                    <field-ref name="quantityUomId" />
                                    <field-ref name="validDate" />
                                </field-row>
                                <field-row>
                                    <field-ref name="priceListId" />
                                    <field-ref name="agreementId" />
                                    <field-ref name="agreementItemSeqId" />
                                </field-row>
                                <field-row>
                                    <field-ref name="productStoreId" />
                                    <field-ref name="termUomId" />
                                    <field-ref name="shipToCountryGeoId" />
                                </field-row>
                                <field-row>
                                    <field-ref name="billToCountryGeoId" />
                                    <field-ref name="submitButton" />
                                </field-row>
                            </field-layout>
                        </form-single>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <label condition="!salesReader" text="Product ${productId || &quot;not selected&quot;} · Organization ${organizationPartyId} · Quantity ${quantity} ${quantityUomId || &quot;stock units&quot;} · ${direction}" type="p" />
        <label text="Choose the supplier whose offer to explain." type="p" condition="supplierNeeded" />
        <section name="ResolvedPriceAvailable" condition="!!priceResult">
            <widgets>
                <container-box>
                    <box-header title="Resolved price" />
                    <box-body>
                        <form-single name="PriceResult" transition="." map="priceResult">
                            <field name="priceAvailable">
                                <default-field title="Available">
                                    <display />
                                </default-field>
                            </field>
                            <field name="price">
                                <default-field title="Unit price">
                                    <display />
                                </default-field>
                            </field>
                            <field name="priceUomId">
                                <default-field title="Currency">
                                    <display />
                                </default-field>
                            </field>
                            <field name="listPrice">
                                <default-field title="List price">
                                    <display />
                                </default-field>
                            </field>
                            <field name="priceSource">
                                <default-field title="Source">
                                    <display />
                                </default-field>
                            </field>
                            <field name="productPriceId">
                                <default-field title="Base price row">
                                    <display />
                                </default-field>
                            </field>
                            <field name="priceListId">
                                <default-field title="Price list">
                                    <display />
                                </default-field>
                            </field>
                            <field name="priceRuleId">
                                <default-field title="Dated rule">
                                    <display />
                                </default-field>
                            </field>
                            <field name="taxInPrice">
                                <default-field title="Tax included">
                                    <display />
                                </default-field>
                            </field>
                                            <field name="standardCostAmount">
                                <conditional-field condition="pricingAccess.canCostRead &amp;&amp; pricingAccess.canPriceRead" title="Standard estimate">
                                    <display />
                                </conditional-field>
                            </field>
                    <field name="marginAmount">
                                <conditional-field condition="pricingAccess.canCostRead &amp;&amp; pricingAccess.canPriceRead" title="Margin">
                                    <display />
                                </conditional-field>
                            </field>
                    <field name="marginPercent">
                                <conditional-field condition="pricingAccess.canCostRead &amp;&amp; pricingAccess.canPriceRead" title="Margin %">
                                    <display />
                                </conditional-field>
                            </field>
</form-single>
                    </box-body>
                </container-box>
                <label text="Order promotions and final tax calculation are excluded." type="p" />
                <container-box>
                    <box-header title="Price explanation" />
                    <box-body>
                        <form-list show-csv-button="true" name="PriceTrace" list="traceRows" skip-form="true" paginate="false">
                            <field name="sequence">
                                <default-field title="Step">
                                    <display />
                                </default-field>
                            </field>
                            <field name="kind">
                                <default-field title="Action">
                                    <display />
                                </default-field>
                            </field>
                            <field name="sourceId">
                                <default-field title="Source">
                                    <display />
                                </default-field>
                            </field>
                            <field name="eligibleText">
                                <default-field title="Eligible">
                                    <display />
                                </default-field>
                            </field>
                            <field name="reason">
                                <default-field title="Reason">
                                    <display />
                                </default-field>
                            </field>
                            <field name="quantity">
                                <default-field title="Quantity">
                                    <display />
                                </default-field>
                            </field>
                            <field name="quantityUomId">
                                <default-field title="Unit">
                                    <display-entity entity-name="moqui.basic.Uom"/>
                                </default-field>
                            </field>
                            <field name="priceUomId">
                                <default-field title="Currency">
                                    <display />
                                </default-field>
                            </field>
                            <field name="beforeText">
                                <default-field title="Before">
                                    <display />
                                </default-field>
                            </field>
                            <field name="operation">
                                <default-field title="Operation">
                                    <display />
                                </default-field>
                            </field>
                            <field name="operandText">
                                <default-field title="Operand">
                                    <display />
                                </default-field>
                            </field>
                            <field name="afterText">
                                <default-field title="After">
                                    <display />
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="sequence"/></column>
                                <column><field-ref name="quantity"/></column>
                            </columns>
                        </form-list>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
    <fail-widgets>
        <label text="Supplier prices are not available to you." type="p" condition="appRoot == 'Purchasing'"/>
    </fail-widgets>
</screen>
