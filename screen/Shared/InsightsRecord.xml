<!-- The Insights context of a tabbed shared record screen (Customer360, Supplier360, Product360, FacilityDetail, EquipmentDetail;
    design-insights §10, impl-insights P6): the one subscreen such a screen shows when it is mounted under Insights/Records, in place of the
    owners' tabs; Insights' links name it (Insights.js sharedLinks), since a default tab is chosen before the app is known. The parent sets insightsRecordType and
    insightsRecordId in its always-actions; the content is template/InsightsRecord.xml, read only. Under any other app it
    shows nothing. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Record" default-menu-include="false">
    <condition><expression>appRoot == 'Insights' &amp;&amp; !!insightsRecordType</expression></condition>
    <widgets>
        <section-include name="InsightsRecord" location="component://mr-boss/template/InsightsRecord.xml"/>
    </widgets>
</screen>
