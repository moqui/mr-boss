<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Kit components" default-menu-include="false" default-menu-index="9">
    <transition name="storeRow">
        <actions>
            <service-call name="ironstone.products.CatalogServices.store#CatalogRow" in-map="Object.assign({},context,{kind:'kit'})"/>
        </actions>
        <default-response url=".">
            <parameter name="productId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <condition><expression>!Array.isArray(product360Tabs) || product360Tabs.includes('KitComponents')</expression></condition>
    <widgets>
        <section name="RowsAvailable" condition="productFound &amp;&amp; product.productTypeEnumId === 'PtPickAssembly'">
            <widgets>
                <container-box>
                    <box-header title="Kit components"/>
                    <box-body>
                        <label text="Available kits: ${detail.kitAvailable}" type="p"/>
                        <form-list name="KitComponentsRows" list="detail.kitRows" skip-form="true" paginate="false">
                            <field name="toProductId">
                                <header-field title="Component"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="fromDate">
                                <header-field title="From"/>
                                <default-field>
                                    <display text="${fromDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="thruDate">
                                <header-field title="Through"/>
                                <default-field>
                                    <display text="${thruDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="quantity">
                                <header-field title="Quantity"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="sequenceNum">
                                <header-field title="Sequence"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="rowActions">
                                <default-field title="">
                                    <container-dialog condition="canEdit" id="EditKitComponents" button-text="Edit" icon="sym_o_edit" title="Edit kit component" width="640">
                                        <form-single name="EditKitComponents" transition="storeRow">
                                            <field name="productId">
                                                <default-field>
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="toProductId">
                                                <default-field>
                                                    <hidden/>
                                                    <display/>
                                                </default-field>
                                            </field>
                                            <field name="fromDate">
                                                <default-field>
                                                    <hidden/>
                                                    <display text="${fromDateText || ''}"/>
                                                </default-field>
                                            </field>
                                            <field name="thruDate">
                                                <default-field title="Through">
                                                    <date-time/>
                                                </default-field>
                                            </field>
                                            <field name="quantity">
                                                <default-field title="Quantity">
                                                    <text-line input-type="number"/>
                                                </default-field>
                                            </field>
                                            <field name="sequenceNum">
                                                <default-field title="Sequence">
                                                    <text-line input-type="number"/>
                                                </default-field>
                                            </field>
                                            <field name="submitButton">
                                                <default-field title="Save">
                                                    <submit/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="toProductId"/></column>
                                <column><field-ref name="quantity"/></column>
                            </columns>
                        </form-list>
                        <section name="KitComponentsEditor" condition="canEdit">
                            <widgets>
                                <container-dialog id="AddKitComponents" button-text="Add component" icon="sym_o_add" title="Add a kit component" width="640">
                                    <form-single name="AddKitComponents" transition="storeRow">
                                        <field name="productId">
                                            <default-field>
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="toProductId">
                                            <default-field title="Component">
                                                <drop-down allow-empty="true">
                                                    <dynamic-options transition="../choices" server-search="true" min-length="0" parameter-map="{choice:'products'}"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="fromDate">
                                            <default-field title="From">
                                                <date-time/>
                                            </default-field>
                                        </field>
                                        <field name="thruDate">
                                            <default-field title="Through">
                                                <date-time/>
                                            </default-field>
                                        </field>
                                        <field name="quantity">
                                            <default-field title="Quantity">
                                                <text-line input-type="number"/>
                                            </default-field>
                                        </field>
                                        <field name="sequenceNum">
                                            <default-field title="Sequence">
                                                <text-line input-type="number"/>
                                            </default-field>
                                        </field>
                                        <field name="submitButton">
                                            <default-field title="Save">
                                                <submit/>
                                            </default-field>
                                        </field>
                                    </form-single>
                                </container-dialog>
                            </widgets>
                        </section>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
