<!-- LocalMap (design-crosscut §3.32; mr-moqui docs/tools/Maps.md "The local-map dialog", "Under an app's route"): the framework's
    local-map dialog under a BOSS app's own route, by the thin-wrapper rule (mr-moqui docs/dev/Practices-App-Dev.md "A framework
    screen under an app's root"). Each app root with a View map mounts this file hidden as its LocalMap subscreen (Commons,
    Sales, Marketing, Customer Service, Maintenance, Warehouse, Manufacturing, Accounting, Purchasing, Commerce, People and
    Admin: the contact record's addresses, FacilityDetail, the equipment headers, Customer360, Supplier360, Employee360,
    StoreDetail, OrganizationDetail and the order, invoice and shipment details; design-crosscut §3.32 lists them), and View map
    is a dynamic-dialog loading //<appRoot>/LocalMap with a Mantle adapter's key and the record's key (mr-mantle
    docs/MapAdapters.md: postalAddress {contactMechId}, party {partyId}, facility {facilityId}, asset {assetId}, and the read-only
    transactionAddress {orderId} | {shipmentId} | {invoiceId}). It is reached by the app root's own grant (no row names this file
    or the framework's LocalMap.xml); the framework's MAPS_DIALOG gives every signed-in user the services the dialog calls, and
    the adapter checks the caller on every read and save (Choose location only for a holder of the record's edit permission:
    PARTY_LOCATION_EDIT or Sales' SALES_ACCOUNT_EDIT for its accounts, FACILITY_EDIT, MAINTENANCE_RESOURCE_EDIT), so the mount
    narrows nothing and grants nothing.
    Taken in: getConfig (the basemap and layers) and storeLocation (Save location, which calls the adapter's
    store#RecordLocation; on success the dialog closes and the host screen reloads in place). Not taken in: source, since the
    effective configuration hands a map the framework's own archive path (/apps/maps/LocalMap/source), which checks every
    caller. Open in Maps shows only to a user whose own grants open the framework's Maps app (MAPS_APP).
    What BOSS adds under the dialog: the record's links (an answer's route keys partyDetail, facilityDetail and assetDetail)
    resolved to the BOSS screen of the record the user may open (service/ironstone/shared/MapLinks.js: the host app's own first,
    Maintenance's facility and equipment, else ironstone.commons.PaletteServices.get#RecordLink's); a link to the record the dialog
    shows is left out. The wrapper sets routeLinks false before the include, so the framework's own section of a record's links
    (MapRoute rows of the host app, then of no app) is not shown beside MapLinks.js's, and routeApp boss, which Open in Maps
    carries to Browse, whose links then prefer BOSS's MapRoute rows (none yet). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Map" default-menu-include="false" history="false">

    <transition-include name="getConfig" location="component://tools/screen/Maps/LocalMap.xml"/>
    <transition-include name="storeLocation" location="component://tools/screen/Maps/LocalMap.xml"/>

    <actions>
        <!-- BOSS resolves a record's links itself (MapLinks.js below): the framework's section of them is not shown; routeApp
            names the host app for the framework's links elsewhere (Browse, from Open in Maps) (mr-moqui docs/tools/Maps.md
            "Record links") -->
        <set field="routeLinks" value="false"/>
        <set field="routeApp" value="boss"/>
    </actions>
    <widgets>
        <include-screen location="component://tools/screen/Maps/LocalMap.xml" share-scope="true"/>
        <!-- the record's links (route keys) to BOSS screens, read after the included screen read the record -->
        <section name="LocalMapLinks">
            <actions>
                <set field="recordLinks" from="ec.resource.script('component://mr-boss/service/ironstone/shared/MapLinks.js')
                        .recordLinks(record, recordKey, appRoot)"/>
            </actions>
            <widgets>
                <container id="LocalMapLinkList" style="row q-gutter-sm q-mt-xs">
                    <section-iterate name="LocalMapLink" list="recordLinks" entry="recordLink">
                        <widgets>
                            <link url="${recordLink.url}" url-type="plain" text="${recordLink.label}" link-type="anchor" icon="sym_o_open_in_new"/>
                        </widgets>
                    </section-iterate>
                </container>
            </widgets>
        </section>
    </widgets>
</screen>
