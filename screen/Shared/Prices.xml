<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Prices" default-menu-index="1">
    <parameter name="appRoot"/>
    <parameter name="productId"/>
    <parameter name="direction"/>
    <parameter name="organizationPartyId"/>
    <parameter name="priceTypeEnumId"/>
    <parameter name="pricePurposeEnumId"/>
    <parameter name="priceUomId"/>
    <parameter name="vendorPartyId"/>
    <parameter name="customerPartyId"/>
    <parameter name="productStoreId"/>
    <parameter name="agreementId"/>
    <parameter name="asOfDate"/>
    <parameter name="includeHistory"/>
    <parameter name="pageIndex"/>
    <parameter name="pageSize"/>
    <always-actions>
        <service-call name="ironstone.products.CatalogServices.get#SharedContext" in-map="{appRoot:appRoot}" out-map="sharedMountContext"/>
        <script>if(!sharedMountContext.capabilities.read)throw new Error('Catalog read access is required')</script>
        <set field="appRoot" from="sharedMountContext.appRoot"/>
        <set field="sharedLinks" from="sharedMountContext.sharedLinks"/>
        <set field="printBase" from="sharedMountContext.printBase"/>
    </always-actions>
    <transition name="store">
        <actions>
            <service-call name="ironstone.products.CatalogServices.store#ProductPrice" in-map="context" out-map="answer"/>
        </actions>
        <default-response url=".">
            <parameter name="productId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="replace">
        <actions>
            <service-call name="ironstone.products.CatalogServices.replace#ProductPrice" in-map="context" out-map="answer"/>
        </actions>
        <default-response url=".">
            <parameter name="productId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="expire">
        <actions>
            <service-call name="ironstone.products.CatalogServices.expire#ProductPrice" in-map="context" out-map="answer"/>
        </actions>
        <default-response url=".">
            <parameter name="productId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="history">
        <default-response url="${sharedLinks['Prices/PriceHistory']}"/>
    </transition>
    <transition name="bulk">
        <default-response url="${sharedLinks['Products/BulkPrice']}"/>
    </transition>
    <transition-include name="choices" location="component://mr-boss/template/CatalogChoiceTransitions.xml"/>
    <condition>
        <expression>!Array.isArray(product360Tabs) || product360Tabs.includes('Prices')</expression>
    </condition>
    <actions>
        <set field="access" from="sharedMountContext"/>
        <service-call name="ironstone.products.CatalogServices.get#PriceOptions" out-map="context"/>
        <service-call name="ironstone.products.CatalogServices.find#ProductPrices" in-map="context" out-map="context"/>
        <script><![CDATA[
priceRowsPageIndex=pageIndex;priceRowsPageSize=pageSize;priceRowsPageMaxIndex=Math.max(0,Math.ceil(priceRowsCount/pageSize)-1);priceRowsPageRangeLow=priceRows.length?pageIndex*pageSize+1:0;priceRowsPageRangeHigh=pageIndex*pageSize+priceRows.length
newSales={productId:productId||null,vendorPartyId:defaultOrganizationPartyId,priceTypeEnumId:'PptCurrent',pricePurposeEnumId:pricingDefaults.defaultPurposeEnumId||'PppPurchase',priceUomId:pricingDefaults.defaultCurrencyUomId||'USD',quantityUomId:'OTH_ea',minQuantity:'0'}
newSupplier={productId:productId||null,customerPartyId:defaultOrganizationPartyId,priceTypeEnumId:'PptCurrent',pricePurposeEnumId:pricingDefaults.defaultPurposeEnumId||'PppPurchase',priceUomId:pricingDefaults.defaultCurrencyUomId||'USD',quantityUomId:'OTH_ea',minQuantity:'0'}
]]></script>
    </actions>
    <widgets>
        <link text="Explain price" url="${sharedLinks['Prices/PriceExplain']}">
            <parameter name="productId"/>
        </link>
        <container-box>
            <box-header title="Price scope"/>
            <box-body>
                <form-single name="PriceFind" transition=".">
                    <field name="productId">
                        <default-field title="Product">
                            <drop-down allow-empty="true">
                                <dynamic-options parameter-map="{choice:'products',selected:productId}" transition="choices" server-search="true" min-length="0"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="direction">
                        <default-field title="Direction">
                            <drop-down allow-empty="true">
                                <option key="sales" text="Sales"/>
                                <option key="purchase" text="Supplier offers"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="organizationPartyId">
                        <default-field title="Organization">
                            <drop-down allow-empty="true">
                                <list-options list="priceOptions.organizations" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="priceTypeEnumId">
                        <default-field title="Type">
                            <drop-down allow-empty="true">
                                <list-options list="priceOptions.types" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="pricePurposeEnumId">
                        <default-field title="Purpose">
                            <drop-down allow-empty="true">
                                <list-options list="priceOptions.purposes" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="priceUomId">
                        <default-field title="Currency">
                            <drop-down allow-empty="true">
                                <list-options list="priceOptions.currencies" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="asOfDate">
                        <default-field title="Effective as of">
                            <date-time/>
                        </default-field>
                    </field>
                    <field name="includeHistory">
                        <default-field title="Rows">
                            <drop-down>
                                <option key="false" text="Effective rows"/>
                                <option key="true" text="Include scheduled and ended rows"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="submitButton">
                        <default-field title="Find prices">
                            <submit/>
                        </default-field>
                    </field>
                </form-single>
            </box-body>
        </container-box>
        <section name="NewSalesPriceAllowed" condition="canPriceEdit">
            <widgets>
                <container-dialog id="NewSalesPriceDialog" title="New sales price" button-text="New sales price" width="960">
                    <form-single name="NewSalesPrice" transition="store" map="newSales">
                        <field name="productId">
                            <default-field title="Product">
                                <drop-down allow-empty="false">
                                    <dynamic-options parameter-map="{choice:'products',selected:productId}" transition="choices" server-search="true" min-length="0"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="vendorPartyId">
                            <default-field title="Selling organization">
                                <drop-down allow-empty="false">
                                    <list-options list="priceOptions.organizations" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="customerPartyId">
                            <default-field title="Customer">
                                <drop-down allow-empty="true">
                                    <list-options list="priceOptions.customers" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="priceTypeEnumId">
                            <default-field title="Type">
                                <drop-down allow-empty="false">
                                    <list-options list="priceOptions.types" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="pricePurposeEnumId">
                            <default-field title="Purpose">
                                <drop-down allow-empty="true">
                                    <list-options list="priceOptions.purposes" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="price">
                            <default-field title="Unit price">
                                <text-line input-type="number"/>
                            </default-field>
                        </field>
                        <field name="priceUomId">
                            <default-field title="Currency">
                                <drop-down allow-empty="false">
                                    <list-options list="priceOptions.currencies" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="minQuantity">
                            <default-field title="Minimum quantity">
                                <text-line input-type="number"/>
                            </default-field>
                        </field>
                        <field name="quantityUomId">
                            <default-field title="Quantity unit">
                                <drop-down allow-empty="true">
                                    <list-options list="priceOptions.units" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="fromDate">
                            <default-field title="Effective from" tooltip="Leave empty to start now">
                                <date-time/>
                            </default-field>
                        </field>
                        <field name="thruDate">
                            <default-field title="Through">
                                <date-time/>
                            </default-field>
                        </field>
                        <field name="productStoreId">
                            <default-field title="Store">
                                <drop-down allow-empty="true">
                                    <list-options list="priceOptions.stores" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="agreementId">
                            <default-field title="Agreement ID">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="agreementItemSeqId">
                            <default-field title="Agreement item">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="termUomId">
                            <default-field title="Term unit">
                                <drop-down allow-empty="true">
                                    <list-options list="priceOptions.units" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="taxInPrice">
                            <default-field title="Tax included">
                                <drop-down allow-empty="true">
                                    <option key="Y" text="Yes"/>
                                    <option key="N" text="No"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="taxAuthorityId">
                            <default-field title="Tax authority ID">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="taxPercentage">
                            <default-field title="Tax percent">
                                <text-line input-type="number"/>
                            </default-field>
                        </field>
                        <field name="changeReason">
                            <default-field title="Reason">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="submitButton">
                            <default-field title="Create price">
                                <submit/>
                            </default-field>
                        </field>
                    </form-single>
                </container-dialog>
            </widgets>
        </section>
        <section name="NewSupplierPriceAllowed" condition="canSupplierPriceEdit">
            <widgets>
                <container-dialog id="NewSupplierPriceDialog" title="New supplier price" button-text="New supplier price" width="960">
                    <form-single name="NewSupplierPrice" transition="store" map="newSupplier">
                        <field name="productId">
                            <default-field title="Product">
                                <drop-down allow-empty="false">
                                    <dynamic-options parameter-map="{choice:'products',selected:productId}" transition="choices" server-search="true" min-length="0"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="vendorPartyId">
                            <default-field title="Supplier">
                                <drop-down allow-empty="false">
                                    <list-options list="priceOptions.suppliers" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="customerPartyId">
                            <default-field title="Buying organization">
                                <drop-down allow-empty="false">
                                    <list-options list="priceOptions.organizations" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="priceTypeEnumId">
                            <default-field title="Type">
                                <drop-down allow-empty="false">
                                    <list-options list="priceOptions.types" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="pricePurposeEnumId">
                            <default-field title="Purpose">
                                <drop-down allow-empty="true">
                                    <list-options list="priceOptions.purposes" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="price">
                            <default-field title="Unit price">
                                <text-line input-type="number"/>
                            </default-field>
                        </field>
                        <field name="priceUomId">
                            <default-field title="Currency">
                                <drop-down allow-empty="false">
                                    <list-options list="priceOptions.currencies" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="minQuantity">
                            <default-field title="Minimum quantity">
                                <text-line input-type="number"/>
                            </default-field>
                        </field>
                        <field name="quantityUomId">
                            <default-field title="Quantity unit">
                                <drop-down allow-empty="true">
                                    <list-options list="priceOptions.units" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="fromDate">
                            <default-field title="Effective from" tooltip="Leave empty to start now">
                                <date-time/>
                            </default-field>
                        </field>
                        <field name="thruDate">
                            <default-field title="Through">
                                <date-time/>
                            </default-field>
                        </field>
                        <field name="productStoreId">
                            <default-field title="Store">
                                <drop-down allow-empty="true">
                                    <list-options list="priceOptions.stores" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="agreementId">
                            <default-field title="Agreement ID">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="agreementItemSeqId">
                            <default-field title="Agreement item">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="termUomId">
                            <default-field title="Term unit">
                                <drop-down allow-empty="true">
                                    <list-options list="priceOptions.units" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="taxInPrice">
                            <default-field title="Tax included">
                                <drop-down allow-empty="true">
                                    <option key="Y" text="Yes"/>
                                    <option key="N" text="No"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="taxAuthorityId">
                            <default-field title="Tax authority ID">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="taxPercentage">
                            <default-field title="Tax percent">
                                <text-line input-type="number"/>
                            </default-field>
                        </field>
                        <field name="otherPartyItemId">
                            <default-field title="Supplier item code">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="otherPartyItemName">
                            <default-field title="Supplier item name">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="standardLeadTimeDays">
                            <default-field title="Lead time in days">
                                <text-line input-type="number"/>
                            </default-field>
                        </field>
                        <field name="quantityIncrement">
                            <default-field title="Order increment">
                                <text-line input-type="number"/>
                            </default-field>
                        </field>
                        <field name="quantityIncluded">
                            <default-field title="Quantity included">
                                <text-line input-type="number"/>
                            </default-field>
                        </field>
                        <field name="changeReason">
                            <default-field title="Reason">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="submitButton">
                            <default-field title="Create price">
                                <submit/>
                            </default-field>
                        </field>
                    </form-single>
                </container-dialog>
            </widgets>
        </section>
        <container-box>
            <box-header title="Price rows"/>
            <box-body>
                <form-list name="Prices" list="priceRows" skip-form="true" paginate="true" saved-finds="true" header-dialog="false" show-csv-button="true" show-xlsx-button="true" select-columns="true">
                    <row-selection id-field="productPriceId" parameter="productPriceIds" list-mode="true" condition="(canPriceEdit || canSupplierPriceEdit) &amp;&amp; !!sharedLinks['Products/BulkPrice']">
                        <action>
                            <dialog button-text="Review bulk change" title="Review selected prices"/>
                            <form-single name="SelectedPriceChanges" transition="bulk">
                                <field name="organizationPartyId">
                                    <default-field title="Organization">
                                        <drop-down allow-empty="false">
                                            <list-options list="priceOptions.organizations" key="${value}" text="${label}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="direction">
                                    <default-field title="Direction">
                                        <drop-down>
                                            <option key="sales" text="Sales"/>
                                            <option key="purchase" text="Supplier offers"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="submitButton">
                                    <default-field title="Review price changes">
                                        <submit/>
                                    </default-field>
                                </field>
                            </form-single>
                        </action>
                    </row-selection>
                    <field name="productId">
                        <default-field title="Product">
                            <display/>
                        </default-field>
                    </field>
                    <field name="productName">
                        <default-field title="Name">
                            <display/>
                        </default-field>
                    </field>
                    <field name="direction">
                        <default-field title="Direction">
                            <display/>
                        </default-field>
                    </field>
                    <field name="priceType">
                        <default-field title="Type">
                            <display/>
                        </default-field>
                    </field>
                    <field name="price" align="right">
                        <default-field title="Price">
                            <display currency-unit-field="priceUomId"/>
                        </default-field>
                    </field>
                    <field name="priceUomId">
                        <default-field title="Currency">
                            <display/>
                        </default-field>
                    </field>
                    <field name="minQuantity">
                        <default-field title="Minimum quantity">
                            <display/>
                        </default-field>
                    </field>
                    <field name="quantityUomId">
                        <default-field title="Quantity unit">
                            <display-entity entity-name="moqui.basic.Uom"/>
                        </default-field>
                    </field>
                    <field name="vendorPartyId">
                        <default-field title="Vendor">
                            <display-entity entity-name="mantle.party.PartyDetail" text="PartyNameTemplate"/>
                        </default-field>
                    </field>
                    <field name="customerPartyId">
                        <default-field title="Customer">
                            <display-entity entity-name="mantle.party.PartyDetail" text="PartyNameTemplate"/>
                        </default-field>
                    </field>
                    <field name="productStoreId">
                        <default-field title="Store">
                            <display-entity entity-name="mantle.product.store.ProductStore" text="${storeName}"/>
                        </default-field>
                    </field>
                    <field name="agreementId">
                        <default-field title="Agreement">
                            <display/>
                        </default-field>
                    </field>
                    <field name="fromDateText">
                        <default-field title="Effective from">
                            <display/>
                        </default-field>
                    </field>
                    <field name="thruDateText">
                        <default-field title="Through">
                            <display/>
                        </default-field>
                    </field>
                    <field name="state">
                        <conditional-field condition="!['qvt','tui'].includes(sri.getRenderMode())" title="State">
                            <display/>
                        </conditional-field>
                        <default-field title="State">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${({effective:'positive',published:'positive',approved:'positive',active:'positive',scheduled:'info',draft:'warning',pending:'warning',ended:'grey-7',retired:'grey-7',superseded:'grey-7'})[String(state ?? '').toLowerCase()] || 'primary'}">${WebUtilities.encodeHtml(String(state ?? ''))}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: String(state ?? "")})}]]></text>
                            </render-mode>
                        </default-field>
                    </field>
                    <field name="history" hide="['csv','xlsx'].includes(sri.getRenderMode())">
                        <default-field title="History">
                            <!-- an app with no price history route (Commerce, impl-commerce F48) shows none -->
                            <link url="history" text="History" parameter-map="{productId:productId,productPriceId:productPriceId}" condition="!!sharedLinks['Prices/PriceHistory']"/>
                        </default-field>
                    </field>
                    <field name="standardCostAmount">
                        <conditional-field condition="access.capabilities.marginRead" title="Standard estimate">
                            <display/>
                        </conditional-field>
                    </field>
                    <field name="marginAmount">
                        <conditional-field condition="access.capabilities.marginRead" title="Margin">
                            <display/>
                        </conditional-field>
                    </field>
                    <field name="marginPercent">
                        <conditional-field condition="access.capabilities.marginRead" title="Margin %">
                            <display/>
                        </conditional-field>
                    </field>
                    <field name="rowActions" hide="['csv','xlsx'].includes(sri.getRenderMode())">
                        <default-field title="">
                            <container-dialog condition="canEdit" id="ChangePrice" button-text="Schedule" icon="sym_o_event_repeat" title="Schedule a successor price" width="720">
                                <form-single name="ChangePrice" transition="replace">
                                    <field name="productPriceId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="productId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="expectedLastUpdatedStamp" from="lastUpdatedStamp">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="price" from="String(price)">
                                        <default-field title="Successor unit price">
                                            <text-line input-type="number"/>
                                        </default-field>
                                    </field>
                                    <field name="effectiveDate">
                                        <default-field title="Effective date">
                                            <date-time/>
                                        </default-field>
                                    </field>
                                    <field name="changeReason" from="''">
                                        <default-field title="Reason">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="submitButton">
                                        <default-field title="Schedule change">
                                            <submit/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </container-dialog>
                            <container-dialog id="CorrectPrice" condition="canEdit &amp;&amp; canCorrect" button-text="Correct" icon="sym_o_edit" title="Correct unreferenced price" width="720">
                                <form-single name="CorrectPrice" transition="store">
                                    <field name="productPriceId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="productId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="expectedLastUpdatedStamp" from="lastUpdatedStamp">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="price" from="String(price)">
                                        <default-field title="Corrected unit price">
                                            <text-line input-type="number"/>
                                        </default-field>
                                    </field>
                                    <field name="minQuantity" from="String(minQuantity || 0)">
                                        <default-field title="Minimum quantity">
                                            <text-line input-type="number"/>
                                        </default-field>
                                    </field>
                                    <field name="fromDate">
                                        <default-field title="Effective from">
                                            <hidden/>
                                            <display text="${fromDateText}"/>
                                        </default-field>
                                    </field>
                                    <field name="thruDate" from="thruDateText">
                                        <default-field title="Through">
                                            <date-time/>
                                        </default-field>
                                    </field>
                                    <field name="changeReason" from="''">
                                        <default-field title="Reason">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="submitButton">
                                        <default-field title="Save correction">
                                            <submit/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </container-dialog>
                            <container-dialog condition="canEdit" id="EndPrice" button-text="End" icon="sym_o_event_busy" title="End price interval" width="720">
                                <form-single name="EndPrice" transition="expire">
                                    <field name="productPriceId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="productId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="expectedLastUpdatedStamp" from="lastUpdatedStamp">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="thruDate" from="''">
                                        <default-field title="End date" tooltip="Leave empty to end it now">
                                            <date-time/>
                                        </default-field>
                                    </field>
                                    <field name="changeReason" from="''">
                                        <default-field title="Reason">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="submitButton">
                                        <default-field title="End price">
                                            <submit type="danger" confirmation="End this row? It stays in the history and stops applying from the end date."/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </container-dialog>
                        </default-field>
                    </field>
                    <columns>
                        <column><field-ref name="productId"/><field-ref name="productName"/></column>
                        <column><field-ref name="direction"/><field-ref name="priceType"/></column>
                        <column><field-ref name="price"/><field-ref name="priceUomId"/></column>
                        <column><field-ref name="minQuantity"/><field-ref name="quantityUomId"/></column>
                        <column><field-ref name="vendorPartyId"/><field-ref name="customerPartyId"/></column>
                        <column><field-ref name="productStoreId"/><field-ref name="agreementId"/></column>
                        <column><field-ref name="fromDateText"/><field-ref name="thruDateText"/></column>
                        <column><field-ref name="state"/></column>
                        <column><field-ref name="standardCostAmount"/><field-ref name="marginAmount"/><field-ref name="marginPercent"/></column>
                        <column><field-ref name="history"/><field-ref name="rowActions"/></column>
                    </columns>
                    <columns type="mobile">
                        <column>
                            <field-ref name="productId"/>
                            <field-ref name="priceType"/>
                            <field-ref name="history"/>
                        </column>
                        <column>
                            <field-ref name="price"/>
                            <field-ref name="state"/>
                            <field-ref name="rowActions"/>
                        </column>
                    </columns>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
