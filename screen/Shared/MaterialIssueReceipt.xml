<!-- MaterialIssueReceipt (design-crosscut §3.9; design-warehouse §6), the shared task screen of material issued to and received
    from a work effort. Each mounting app's context gives the sources it opens: Warehouse (impl-warehouse P12) mounts it at
    Warehouse/Inventory/MaterialIssueReceipt with sourceType and sourceId. The screen is driven by its source's entry in
    ironstone.warehouse.PackingServices (Packing.js sources: get#MaterialSource gives the header, links, lines and words;
    get#MaterialAction the record, capability and Mantle entry point of a line's posting, which materialAction runs after
    check#Record). The shipment assembly source (a shipment's pick assembly work effort) shows each component's needed,
    packed and left quantities, packs a component (mantle.shipment.WarehouseTaskServices.pack#ShipmentAssembly: the kit is
    made, at its components' cost when the organization says so, F41) and lists the issues and kit receipts (value only
    with financial read). The production run source (P16, Production.js over Mantle's get#ProductionOrder) adds the run's
    output lines with Receive (receive#ProductionOutput: the frozen standard cost, quarantine and an inspection when one
    applies, serials generated from a first value), Tracking (the output's serials, lots, status and inspection), Unused
    returns with Return (return#UnusedMaterial) and the run's files; its lines issue from a chosen asset
    (issue#ProductionMaterial). Manufacturing (impl-manufacturing P5b) mounts it as WorkOrderDetail's Materials tab, at
    Manufacturing/WorkOrders/WorkOrderDetail/MaterialIssueReceipt with the run's workEffortId: the same run source read with
    the Manufacturing scope (ironstone.manufacturing.MaterialServices.get#MaterialSource after its check#Record), its lines'
    required, issued, returned and left apart with what is short or held, Stage (Warehouse's Move with the run fixed, for
    STOCK_MOVE holders) and, when the run's policy backflushes, the backflush preview with its lots and Confirm
    (backflush#ProductionMaterials); its postings run after Manufacturing's check#Record of the run with issue
    (STOCK_ISSUE). Maintenance adds its context. Any other app sees "not available". -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Material issue and receipt" default-menu-include="false">
    <parameter name="sourceType"/>
    <parameter name="sourceId"/>
    <!-- a line's posting: the source's entry names the record to check, the capability and the Mantle entry point -->
    <transition name="materialAction">
        <actions>
            <if condition="appRoot != 'Warehouse' &amp;&amp; appRoot != 'Manufacturing'">
                <return error="true" message="This material work is not available here"/>
            </if>
            <if condition="appRoot == 'Manufacturing'">
                <service-call name="ironstone.manufacturing.MaterialServices.get#MaterialAction" out-map="action"
                        in-map="{workEffortId:workEffortId || sourceId, lineKey:lineKey || null, quantity:quantity || null,
                            operationKey:operationKey, actionKind:actionKind || null, assetId:assetId || null,
                            toLocationSeqId:toLocationSeqId || null, firstSerialNumber:firstSerialNumber || null,
                            lotNumber:lotNumber || null, previewKey:previewKey || null}"/>
                <service-call name="ironstone.manufacturing.AccessServices.check#Record"
                        in-map="{appRoot:appRoot, recordType:action.recordType, recordId:action.recordId,
                            capability:action.capability}"/>
                <else>
                    <service-call name="ironstone.warehouse.PackingServices.get#MaterialAction" out-map="action"
                            in-map="{sourceType:sourceType || 'shipmentAssembly', sourceId:sourceId, lineKey:lineKey,
                                assemblyProductId:assemblyProductId || null, quantity:quantity, operationKey:operationKey,
                                shipmentPackageSeqId:shipmentPackageSeqId || null, actionKind:actionKind || null,
                                assetId:assetId || null, toLocationSeqId:toLocationSeqId || null,
                                firstSerialNumber:firstSerialNumber || null, lotNumber:lotNumber || null}"/>
                    <service-call name="ironstone.warehouse.AccessServices.check#Record"
                            in-map="{recordType:action.recordType, recordId:action.recordId, capability:action.capability}"/>
                </else>
            </if>
            <script>ec.service.sync().name(action.serviceName).parameters(action.parameters).call()</script>
            <if condition="!ec.message.hasError()">
                <message type="success">${action.doneText}</message>
            </if>
        </actions>
        <default-response url=".">
            <parameter name="sourceType"/>
            <parameter name="sourceId"/>
            <parameter name="workEffortId"/>
        </default-response>
        <error-response url=".">
            <parameter name="workEffortId"/>
        </error-response>
    </transition>
    <actions>
        <set field="material" from="null"/>
        <if condition="appRoot == 'Warehouse'">
            <service-call name="ironstone.warehouse.PackingServices.get#MaterialSource" out-map="material"
                    transaction="force-new" ignore-error="true"
                    in-map="{sourceType:sourceType || 'shipmentAssembly', sourceId:sourceId || null}"/>
        </if>
        <!-- Manufacturing: WorkOrderDetail's run, checked again here for a tab rendered on its own -->
        <if condition="appRoot == 'Manufacturing' &amp;&amp; workEffortId">
            <service-call name="ironstone.manufacturing.AccessServices.check#Record" out-map="materialRunCheck"
                    transaction="force-new" ignore-error="true"
                    in-map="{appRoot:appRoot, recordType:'run', recordId:workEffortId}"/>
            <if condition="materialRunCheck?.recordId">
                <service-call name="ironstone.manufacturing.MaterialServices.get#MaterialSource" out-map="material"
                        transaction="force-new" ignore-error="true" in-map="{workEffortId:workEffortId}"/>
            </if>
        </if>
        <set field="manufacturingRoot" from="appRoot == 'Manufacturing'"/>
        <set field="backflush" from="material?.backflush || null"/>
        <set field="backflushRows" from="backflush?.lineRows || []"/>
        <set field="recordFound" from="!!material?.found"/>
        <set field="materialRows" from="material?.materialRows || []"/>
        <set field="movementRows" from="material?.movementRows || []"/>
        <set field="outputRows" from="material?.outputRows || []"/>
        <set field="returnRows" from="material?.returnRows || []"/>
        <set field="trackingRows" from="material?.trackingRows || []"/>
        <set field="words" from="material?.source?.words || {}"/>
        <set field="actionField" from="material?.source?.actionField || 'package'"/>
        <set field="packageOptions" from="material?.packageOptions || []"/>
        <set field="sourceLinks" from="material?.source?.links || []"/>
        <set field="financialRead" from="!!material?.financialRead"/>
        <set field="pageKey" from="'material-' + ec.user.randomString(24)"/>
    </actions>
    <widgets>
        <section name="MaterialNotAvailable" condition="!recordFound">
            <widgets>
                <label text="This material work is not available." type="p"/>
                <link url="${sharedLinks['Shipping/Pack']}" text="Open Pack" link-type="anchor-button" icon="sym_o_inventory_2"
                        condition="appRoot == 'Warehouse'"/>
                <link url="${sharedLinks['WorkOrders/Find']}" text="Back to the work orders" link-type="anchor"
                        condition="appRoot == 'Manufacturing'"/>
            </widgets>
        </section>
        <section name="MaterialWork" condition="recordFound">
            <widgets>
                <container style="m-record-header">
                    <!-- in Manufacturing, WorkOrderDetail's header names the run; the policy shows here -->
                    <label text="${material.source.policyText}" type="p" style="text-caption m-muted"
                            condition="manufacturingRoot &amp;&amp; material.source.policyText"/>
                    <section name="SourceTitle" condition="!manufacturingRoot">
                        <widgets>
                            <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                                <container style="col-12 col-md m-record-title">
                                    <label text="${material.source.title}" type="h5"/>
                                    <label text="${material.source.caption}" type="p" style="text-caption m-muted"/>
                                    <label text="${material.source.detailText}" type="p" style="text-caption"
                                            condition="material.source.detailText"/>
                                </container>
                                <container style="col-12 col-md-auto m-record-status">
                                    <label text="${material.source.statusText}" type="span" style="text-weight-medium"/>
                                </container>
                            </container>
                        </widgets>
                    </section>
                    <container style="row items-center q-gutter-sm m-record-foot">
                        <section-iterate name="SourceLinks" list="sourceLinks" entry="sourceLink">
                            <widgets>
                                <link url="${sharedLinks[sourceLink.path]}" text="${sourceLink.text}" link-type="anchor-button"
                                        btn-type="primary" icon="${sourceLink.icon}" parameter-map="sourceLink.parameters"
                                        condition="sourceLink.primary"/>
                                <link url="${sharedLinks[sourceLink.path]}" text="${sourceLink.text}" link-type="anchor-button"
                                        icon="${sourceLink.icon}" parameter-map="sourceLink.parameters"
                                        condition="!sourceLink.primary &amp;&amp; !sourceLink.url"/>
                                <!-- another app's screen (Manufacturing's Stage opens Warehouse's Move) -->
                                <link url="${sourceLink.url}" url-type="plain" text="${sourceLink.text}" link-type="anchor-button"
                                        icon="${sourceLink.icon}" parameter-map="sourceLink.parameters"
                                        condition="!sourceLink.primary &amp;&amp; sourceLink.url"/>
                            </widgets>
                        </section-iterate>
                    </container>
                </container>
                <container-box>
                    <box-header title="Components · ${materialRows.length}"/>
                    <box-body-nopad>
                        <label text="${material.source.emptyText}" type="p" style="q-pa-md m-muted"
                                condition="!materialRows.length"/>
                        <form-list name="MaterialLines" list="materialRows" skip-form="true" paginate="false">
                            <field name="productName">
                                <default-field title="Component">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="assemblyName">
                                <default-field title="${words.groupTitle || 'Kit'}">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="required" align="right">
                                <default-field title="Needed">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="issued" align="right">
                                <default-field title="${words.doneTitle || 'Packed'}">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="returned" align="right" hide="!manufacturingRoot">
                                <default-field title="Returned">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="left" align="right">
                                <default-field title="Left">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="stockText" hide="!manufacturingRoot">
                                <default-field title="Stock">
                                    <display text="${[shortText, heldText, stagedText].filter(Boolean).join(' · ')}"/>
                                </default-field>
                            </field>
                            <field name="packComponent">
                                <conditional-field condition="!canAct" title="">
                                    <ignored/>
                                </conditional-field>
                                <default-field title="">
                                    <container-dialog id="MaterialAction_${lineKey}" button-text="${material.source.actionText}"
                                            icon="sym_o_inventory_2" title="${material.source.actionText} ${lineTitle}"
                                            width="480">
                                        <form-single name="MaterialActionForm" transition="materialAction"
                                                map="{sourceId:material.source.sourceId, lineKey:lineKey,
                                                    assemblyProductId:assemblyProductId, quantity:left,
                                                    sourceType:material.sourceType,
                                                    operationKey:'material-' + lineKey + '-' + pageKey,
                                                    shipmentPackageSeqId:material.activePackageSeqId,
                                                    workEffortId:workEffortId || null}">
                                            <!-- Manufacturing: WorkOrderDetail's run -->
                                            <field name="workEffortId">
                                                <default-field>
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="sourceId">
                                                <default-field>
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="lineKey">
                                                <default-field>
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="assemblyProductId">
                                                <default-field>
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="sourceType">
                                                <default-field>
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="operationKey">
                                                <default-field>
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="assetId">
                                                <conditional-field condition="actionField != 'asset'">
                                                    <ignored/>
                                                </conditional-field>
                                                <default-field title="From stock">
                                                    <drop-down>
                                                        <list-options list="assetOptions" key="${value}" text="${label}"/>
                                                    </drop-down>
                                                </default-field>
                                            </field>
                                            <field name="quantity">
                                                <default-field title="Quantity">
                                                    <text-line size="6" input-type="number"/>
                                                </default-field>
                                            </field>
                                            <field name="shipmentPackageSeqId">
                                                <conditional-field condition="actionField != 'package'">
                                                    <ignored/>
                                                </conditional-field>
                                                <default-field title="Package" tooltip="Empty starts the first package">
                                                    <drop-down allow-empty="true">
                                                        <list-options list="packageOptions" key="${value}" text="${label}"/>
                                                    </drop-down>
                                                </default-field>
                                            </field>
                                            <field name="submit">
                                                <default-field title="">
                                                    <submit text="${material.source.submitText}"/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="productName"/>
                                    <field-ref name="assemblyName"/>
                                </column>
                                <column>
                                    <field-ref name="left"/>
                                    <field-ref name="packComponent"/>
                                </column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
                <!-- Manufacturing: the backflush the run's policy issues, its lines and lots, and Confirm through the issue guard -->
                <section name="Backflush" condition="manufacturingRoot &amp;&amp; backflush">
                    <widgets>
                        <container-box>
                            <box-header title="Backflush · ${backflushRows.length}"/>
                            <box-toolbar>
                                <container-dialog id="ConfirmBackflush" button-text="Backflush" icon="sym_o_playlist_add_check"
                                        title="Backflush the material of work order ${material.source.sourceId}" width="520"
                                        condition="backflush.canConfirm">
                                    <label text="Issues each line's remaining quantity from the lots shown, once. If any line cannot be issued, nothing is."
                                            type="p"/>
                                    <!-- the page's key, not the preview's: a later backflush (after a return) can show the
                                        same preview and must not answer the first one's result -->
                                    <form-single name="ConfirmBackflushForm" transition="materialAction"
                                            map="{workEffortId:material.source.sourceId, actionKind:'backflush',
                                                previewKey:backflush.previewKey, operationKey:'backflush-' + pageKey}">
                                        <field name="workEffortId"><default-field><hidden/></default-field></field>
                                        <field name="actionKind"><default-field><hidden/></default-field></field>
                                        <field name="previewKey"><default-field><hidden/></default-field></field>
                                        <field name="operationKey"><default-field><hidden/></default-field></field>
                                        <field name="submit">
                                            <default-field title="">
                                                <submit text="Confirm backflush"
                                                        confirmation="Issue the material of work order ${material.source.sourceId} from these lots?"/>
                                            </default-field>
                                        </field>
                                    </form-single>
                                </container-dialog>
                            </box-toolbar>
                            <box-body-nopad>
                                <label text="${backflush.findingText}" type="p" style="q-pa-md m-muted"
                                        condition="backflush.findingText"/>
                                <form-list name="BackflushLines" list="backflushRows" skip-form="true" paginate="false">
                                    <field name="productName">
                                        <default-field title="Component">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="quantity" align="right">
                                        <default-field title="Issues">
                                            <display format="#,##0.###"/>
                                        </default-field>
                                    </field>
                                    <field name="pickText">
                                        <default-field title="From">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="shortText">
                                        <default-field title="Short">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column>
                                            <field-ref name="productName"/>
                                            <field-ref name="pickText"/>
                                        </column>
                                        <column>
                                            <field-ref name="quantity"/>
                                            <field-ref name="shortText"/>
                                        </column>
                                    </columns>
                                </form-list>
                            </box-body-nopad>
                        </container-box>
                    </widgets>
                </section>
                <section name="ProductionOutput" condition="material.sourceType == 'productionRun'">
                    <widgets>
                        <container-box>
                            <box-header title="Output · ${outputRows.length}"/>
                            <box-body-nopad>
                                <form-list name="OutputLines" list="outputRows" skip-form="true" paginate="false">
                                    <field name="productName">
                                        <default-field title="Product">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="roleText">
                                        <default-field title="Role">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="required" align="right">
                                        <default-field title="Planned">
                                            <display format="#,##0.###"/>
                                        </default-field>
                                    </field>
                                    <field name="received" align="right">
                                        <default-field title="Received">
                                            <display format="#,##0.###"/>
                                        </default-field>
                                    </field>
                                    <field name="left" align="right">
                                        <default-field title="Left">
                                            <display format="#,##0.###"/>
                                        </default-field>
                                    </field>
                                    <field name="receiveOutput">
                                        <conditional-field condition="!canReceive" title="">
                                            <ignored/>
                                        </conditional-field>
                                        <default-field title="">
                                            <container-dialog id="ReceiveOutput_${lineKey}" button-text="Receive"
                                                    icon="sym_o_move_to_inbox" title="Receive ${productName}" width="480">
                                                <form-single name="ReceiveOutputForm" transition="materialAction"
                                                        map="{sourceId:material.source.sourceId, sourceType:material.sourceType,
                                                            lineKey:lineKey, actionKind:'receive', quantity:left,
                                                            operationKey:'output-' + lineKey + '-' + pageKey,
                                                            workEffortId:workEffortId || null}">
                                                    <field name="workEffortId"><default-field><hidden/></default-field></field>
                                                    <field name="sourceId"><default-field><hidden/></default-field></field>
                                                    <field name="sourceType"><default-field><hidden/></default-field></field>
                                                    <field name="lineKey"><default-field><hidden/></default-field></field>
                                                    <field name="actionKind"><default-field><hidden/></default-field></field>
                                                    <field name="operationKey"><default-field><hidden/></default-field></field>
                                                    <field name="quantity">
                                                        <default-field title="Quantity">
                                                            <text-line size="6" input-type="number"/>
                                                        </default-field>
                                                    </field>
                                                    <field name="firstSerialNumber">
                                                        <default-field title="First serial"
                                                                tooltip="Serials count up from it, one a unit">
                                                            <text-line size="16"/>
                                                        </default-field>
                                                    </field>
                                                    <field name="lotNumber">
                                                        <default-field title="Lot">
                                                            <text-line size="16"/>
                                                        </default-field>
                                                    </field>
                                                    <field name="toLocationSeqId">
                                                        <default-field title="Location"
                                                                tooltip="Empty: quarantine when inspected, else putaway">
                                                            <text-line size="12"/>
                                                        </default-field>
                                                    </field>
                                                    <field name="submit">
                                                        <default-field title="">
                                                            <submit text="Receive output"/>
                                                        </default-field>
                                                    </field>
                                                </form-single>
                                            </container-dialog>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column>
                                            <field-ref name="productName"/>
                                            <field-ref name="roleText"/>
                                        </column>
                                        <column>
                                            <field-ref name="left"/>
                                            <field-ref name="receiveOutput"/>
                                        </column>
                                    </columns>
                                </form-list>
                            </box-body-nopad>
                        </container-box>
                        <container-box>
                            <box-header title="Tracking · ${trackingRows.length}"/>
                            <box-body-nopad>
                                <label text="No output is received yet." type="p" style="q-pa-md m-muted"
                                        condition="!trackingRows.length"/>
                                <form-list name="OutputTracking" list="trackingRows" skip-form="true" paginate="false">
                                    <field name="assetId">
                                        <default-field title="Asset">
                                            <link url="${sharedLinks['Inventory/AssetDetail']}" text="${assetId}"
                                                    link-type="anchor" parameter-map="{assetId:assetId}"/>
                                        </default-field>
                                    </field>
                                    <field name="serialNumber">
                                        <default-field title="Serial">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="lotId">
                                        <default-field title="Lot">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="quantity" align="right">
                                        <default-field title="Quantity">
                                            <display format="#,##0.###"/>
                                        </default-field>
                                    </field>
                                    <field name="statusText">
                                        <default-field title="Status">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="costText">
                                        <default-field title="Cost">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="qualityInspectionId">
                                        <conditional-field condition="!qualityInspectionId" title="Inspection">
                                            <display text=""/>
                                        </conditional-field>
                                        <default-field title="Inspection">
                                            <link url="${sharedLinks['QualityInspection']}" text="${qualityInspectionId}"
                                                    link-type="anchor" parameter-map="{qualityInspectionId:qualityInspectionId}"/>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column>
                                            <field-ref name="assetId"/>
                                            <field-ref name="serialNumber"/>
                                        </column>
                                        <column>
                                            <field-ref name="statusText"/>
                                            <field-ref name="qualityInspectionId"/>
                                        </column>
                                    </columns>
                                </form-list>
                            </box-body-nopad>
                        </container-box>
                        <container-box>
                            <box-header title="Unused returns · ${returnRows.length}"/>
                            <box-body-nopad>
                                <label text="Nothing issued is left to return." type="p" style="q-pa-md m-muted"
                                        condition="!returnRows.length"/>
                                <form-list name="UnusedReturns" list="returnRows" skip-form="true" paginate="false">
                                    <field name="productName">
                                        <default-field title="Component">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="assetId">
                                        <default-field title="Issued from">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="operationName">
                                        <default-field title="Operation">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="returnable" align="right">
                                        <default-field title="Returnable">
                                            <display format="#,##0.###"/>
                                        </default-field>
                                    </field>
                                    <field name="returnUnused">
                                        <conditional-field condition="!canReturn" title="">
                                            <ignored/>
                                        </conditional-field>
                                        <default-field title="">
                                            <container-dialog id="ReturnUnused_${assetIssuanceId}" button-text="Return"
                                                    icon="sym_o_undo" title="Return ${productName}" width="480">
                                                <form-single name="ReturnUnusedForm" transition="materialAction"
                                                        map="{sourceId:material.source.sourceId, sourceType:material.sourceType,
                                                            lineKey:assetIssuanceId, actionKind:'return', quantity:returnable,
                                                            operationKey:'return-' + assetIssuanceId + '-' + pageKey,
                                                            workEffortId:workEffortId || null}">
                                                    <field name="workEffortId"><default-field><hidden/></default-field></field>
                                                    <field name="sourceId"><default-field><hidden/></default-field></field>
                                                    <field name="sourceType"><default-field><hidden/></default-field></field>
                                                    <field name="lineKey"><default-field><hidden/></default-field></field>
                                                    <field name="actionKind"><default-field><hidden/></default-field></field>
                                                    <field name="operationKey"><default-field><hidden/></default-field></field>
                                                    <field name="quantity">
                                                        <default-field title="Quantity">
                                                            <text-line size="6" input-type="number"/>
                                                        </default-field>
                                                    </field>
                                                    <field name="toLocationSeqId">
                                                        <default-field title="Location"
                                                                tooltip="Empty returns it into the asset it was issued from">
                                                            <text-line size="12"/>
                                                        </default-field>
                                                    </field>
                                                    <field name="submit">
                                                        <default-field title="">
                                                            <submit text="Return unused"/>
                                                        </default-field>
                                                    </field>
                                                </form-single>
                                            </container-dialog>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column>
                                            <field-ref name="productName"/>
                                            <field-ref name="assetId"/>
                                        </column>
                                        <column>
                                            <field-ref name="returnable"/>
                                            <field-ref name="returnUnused"/>
                                        </column>
                                    </columns>
                                </form-list>
                            </box-body-nopad>
                        </container-box>
                    </widgets>
                </section>
                <container-box>
                    <box-header title="${words.historyTitle || 'Issues and kit receipts'} · ${movementRows.length}"/>
                    <box-body-nopad>
                        <label text="${words.historyEmpty || 'Nothing is issued to this kit yet.'}" type="p"
                                style="q-pa-md m-muted" condition="!movementRows.length"/>
                        <form-list name="MaterialHistory" list="movementRows" skip-form="true" paginate="false">
                            <field name="kind">
                                <default-field title="Movement">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="productName">
                                <default-field title="Product">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="assetId">
                                <default-field title="Asset">
                                    <link url="${sharedLinks['Inventory/AssetDetail']}" text="${assetId}" link-type="anchor"
                                            parameter-map="{assetId:assetId}"/>
                                </default-field>
                            </field>
                            <field name="lotId">
                                <default-field title="Lot">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="quantity" align="right">
                                <default-field title="Quantity">
                                    <display format="#,##0.###"/>
                                </default-field>
                            </field>
                            <field name="dateText">
                                <default-field title="Date">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="valueText" align="right" hide="!financialRead">
                                <default-field title="Value">
                                    <display/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="kind"/>
                                    <field-ref name="productName"/>
                                </column>
                                <column>
                                    <field-ref name="quantity"/>
                                    <field-ref name="dateText"/>
                                </column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
                <section name="MaterialFiles" condition="material.filesRecordId">
                    <widgets>
                        <container-box>
                            <box-header title="Files"/>
                            <box-body>
                                <record-files id="MaterialFiles" record-entity="mantle.work.effort.WorkEffort"
                                        record-id="${material.filesRecordId}"/>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
