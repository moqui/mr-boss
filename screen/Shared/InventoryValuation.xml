<!-- InventoryValuation (design-accounting §10): Products mounts it for the revaluation of an approved estimate (its P9
    dialogs, ValuationAdjustment and PostRevaluation, over mantle.ledger.AssetBookServices preview#/post#Revaluation).
    Accounting mounts it at Accounting/Inventory/InventoryValuation (appRoot Accounting): the organization's stock valued
    at each asset's current cost beside its inventory and WIP accounts, by product, with the movements that explain a
    difference and the open WIP of each run (mantle.product.InventoryReportServices.run#InventoryValuation); a product's
    Revalue opens the same dialogs, and Repair product cost (finance administration) rewrites a product's acquire cost
    through AssetBookServices.repair#ProductAcquireCost. Mantle checks the organization and the permissions. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Inventory valuation"
        default-menu-include="false">
    <parameter name="appRoot"/>
    <parameter name="productStandardCostId"/>
    <parameter name="productId"/>
    <parameter name="organizationPartyId"/>
    <parameter name="facilityId"/>
    <parameter name="asOfDate"/>
    <parameter name="previewId"/>
    <parameter name="operationKey"/>
    <parameter name="pageIndex"/>
    <always-actions>
        <!-- the Accounting root has checked Accounting's access and set its links; another mount is Products' catalog -->
        <if condition="appRoot != 'Accounting'">
            <service-call name="ironstone.products.CatalogServices.get#SharedContext"
                    in-map="{appRoot:appRoot}"
                    out-map="sharedMountContext"/>
            <script>if(!sharedMountContext.capabilities.read)throw new Error('Catalog read access is required')</script>
            <set field="appRoot" from="sharedMountContext.appRoot"/>
            <set field="sharedLinks" from="sharedMountContext.sharedLinks"/>
            <set field="printBase" from="sharedMountContext.printBase"/>
        </if>
    </always-actions>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition-include name="repairCost" location="component://mr-boss/template/AccountingInventory.xml"/>
    <transition name="preview">
        <actions>
            <service-call name="mantle.ledger.AssetBookServices.preview#Revaluation" in-map="context" out-map="result"/>
            <set field="previewId" from="result.previewId"/>
        </actions>
        <default-response url=".">
            <parameter name="productStandardCostId"/>
            <parameter name="previewId"/>
            <parameter name="operationKey"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="post">
        <actions>
            <service-call name="mantle.ledger.AssetBookServices.post#Revaluation" in-map="context" out-map="result"/>
        </actions>
        <default-response url=".">
            <parameter name="productStandardCostId"/>
            <parameter name="previewId"/>
            <parameter name="operationKey"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <actions>
        <if condition="appRoot == 'Accounting'">
            <set field="summary" from="null"/>
            <if condition="organizationPartyId">
                <service-call name="mantle.product.InventoryReportServices.run#InventoryValuation"
                        in-map="{organizationPartyId:organizationPartyId, facilityId:facilityId, productId:productId,
                            asOfDate:asOfDate, pageIndex:pageIndex}"
                        out-map="context"/>
            </if>
            <set field="money" from="summary ? Object.fromEntries(['stockValue', 'inventoryBalance', 'wipBalance',
                    'difference'].map((name) =&gt; [name, ec.l10n.formatCurrency(toDecimal(summary[name]),
                    summary.currency)])) : {}"/>
            <set field="options" from="{organizationPartyId:organizationPartyId, facilityId:facilityId, productId:productId,
                    asOfDate:asOfDate}"/>
            <set field="repairKey" from="ec.resource.script('component://mr-boss/service/ironstone/accounting/AccountingLib.js')
                    .operationKey('repair')"/>
        </if>
        <set field="bookAccess" from="{}"/>
        <if condition="appRoot != 'Accounting' || productStandardCostId">
            <service-call name="mantle.ledger.AssetBookServices.get#RevaluationContext" in-map="context" out-map="context"/>
        </if>
    </actions>
    <widgets>
        <section-include name="AccountingInventoryValuation" location="component://mr-boss/template/AccountingInventory.xml"/>
        <label text="Inventory revaluation" type="h5" condition="appRoot != 'Accounting' || productStandardCostId"/>
        <label text="${bookMessage || &quot;&quot;}" type="p" condition="appRoot != 'Accounting' || productStandardCostId"/>
        <section name="FinanceRevaluation" condition="bookAccess.glPost">
            <widgets>
                <label text="Approved estimate ${standardCost.productStandardCostId} · ${standardCost.productId}" type="h6"/>
                <label text="Review the current owned stock position. Posting records a value adjustment and its ledger entries." type="p"/>
                <container-dialog id="ValuationAdjustmentDialog" condition="revaluationEnabled" button-text="Preview revaluation" title="Valuation adjustment" width="640">
                    <form-single name="ValuationAdjustment" transition="preview">
                        <field name="productStandardCostId">
                            <default-field>
                                <hidden/>
                            </default-field>
                        </field>
                        <field name="organizationPartyId">
                            <default-field>
                                <hidden/>
                            </default-field>
                        </field>
                        <field name="productId">
                            <default-field>
                                <hidden/>
                            </default-field>
                        </field>
                        <field name="facilityId">
                            <default-field title="Facility">
                                <drop-down allow-empty="true">
                                    <list-options list="facilityOptions" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="eventDate">
                            <default-field title="Effective date" tooltip="Blank means now">
                                <date-time/>
                            </default-field>
                        </field>
                        <field name="changeReason">
                            <default-field title="Reason">
                                <text-area/>
                            </default-field>
                        </field>
                        <field name="submitButton">
                            <default-field title="Preview owned inventory">
                                <submit/>
                            </default-field>
                        </field>
                    </form-single>
                </container-dialog>
                <section name="RevaluationReview" condition="!!previewId">
                    <widgets>
                        <label text="Affected quantity ${quantity} · value adjustment ${totalAmount} ${amountUomId}" type="h6"/>
                        <label text="${stale ? &quot;Inputs changed or the review expired. Preview again.&quot; : complete ? &quot;Reviewed inputs are complete.&quot; : &quot;Resolve the findings before posting.&quot;}" type="p"/>
                        <form-list name="RevaluationFindings" list="findings" skip-form="true" paginate="false" show-csv-button="true">
                            <field name="recordId">
                                <default-field title="Asset">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="message">
                                <default-field title="Finding">
                                    <display/>
                                </default-field>
                            </field>
                        </form-list>
                        <form-list name="RevaluationRows" list="bookRows" skip-form="true" paginate="false" show-csv-button="true">
                            <field name="assetId">
                                <default-field title="Asset">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="quantity">
                                <default-field title="Quantity">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="quantityUomId">
                                <default-field title="Unit">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="previousUnitCost">
                                <default-field title="Current unit cost">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="newUnitCost">
                                <default-field title="Forward unit cost">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="unitCostUomId">
                                <default-field title="Cost currency">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="amount">
                                <default-field title="Adjustment">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="amountUomId">
                                <default-field title="Currency">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="assetGlAccountId">
                                <default-field title="Inventory account">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="offsetGlAccountId">
                                <default-field title="Offset account">
                                    <display/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="assetId"/></column>
                                <column><field-ref name="amount"/></column>
                            </columns>
                        </form-list>
                        <container-dialog id="PostRevaluationDialog" button-text="Post reviewed revaluation" title="Post revaluation" condition="complete &amp;&amp; !posted" width="640">
                            <label text="Post ${totalAmount} ${amountUomId} for ${quantity} units? This creates balanced ledger entries and linked book events." type="p"/>
                            <form-single name="PostRevaluation" transition="post">
                                <field name="productStandardCostId">
                                    <default-field>
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="previewId">
                                    <default-field>
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="inputFingerprint">
                                    <default-field>
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="operationKey">
                                    <default-field>
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="changeReason">
                                    <default-field title="Reviewed reason">
                                        <display/>
                                    </default-field>
                                </field>
                                <field name="eventDate">
                                    <default-field>
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="eventDateText">
                                    <default-field title="Effective date">
                                        <display/>
                                    </default-field>
                                </field>
                                <field name="submitButton">
                                    <default-field title="Confirm and post">
                                        <submit/>
                                    </default-field>
                                </field>
                            </form-single>
                        </container-dialog>
                        <section name="PostedRevaluation" condition="!!posted">
                            <widgets>
                                <label text="Posted accounting transaction ${acctgTransId}" type="p"
                                        condition="appRoot != 'Accounting'"/>
                                <link url="${sharedLinks['GeneralLedger/JournalEntryDetail']}"
                                        text="Posted accounting transaction ${acctgTransId}"
                                        link-type="anchor"
                                        condition="appRoot == 'Accounting'"
                                        parameter-map="{recordId:acctgTransId, organizationPartyId:organizationPartyId}"/>
                                <form-list name="RevaluationLedgerEntries" list="ledgerRows || []" skip-form="true" paginate="false">
                                    <field name="glAccountId">
                                        <default-field title="Account">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="debitCreditFlag">
                                        <default-field title="Debit / credit">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="amount">
                                        <default-field title="Amount">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="assetId">
                                        <default-field title="Asset">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column><field-ref name="glAccountId"/></column>
                                        <column><field-ref name="amount"/></column>
                                    </columns>
                                </form-list>
                            </widgets>
                        </section>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
