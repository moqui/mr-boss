<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Feature defaults" default-menu-index="4">
    <transition name="storeFeatureDefaultsRows">
        <actions>
            <service-call name="ironstone.products.CategoryServices.store#CategoryRow" in-map="Object.assign({},context,{rowKind:'categoryGroup'})"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <!-- Products' own: feature defaults are catalog setup, not a store's (Commerce's mount leaves the tab out) -->
    <condition>
        <expression>appRoot != 'Commerce'</expression>
    </condition>
    <widgets>
        <section name="Available" condition="recordFound">
            <widgets>
                <container-box>
                    <box-header title="Feature defaults"/>
                    <box-body>
                        <form-list name="FeatureDefaultsRowsList" list="detail.groups" skip-form="true" paginate="false">
                            <field name="productFeatureGroupId">
                                <header-field title="Feature group"/>
                                <default-field>
                                    <link url="//Products/Features/FeatureGroups/FeatureGroupDetail" text="${productFeatureGroupId}" parameter-map="{productFeatureGroupId:productFeatureGroupId}" link-type="anchor"/>
                                </default-field>
                            </field>
                            <field name="fromDate">
                                <header-field title="From"/>
                                <default-field>
                                    <display text="${fromDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="thruDate">
                                <header-field title="Through"/>
                                <default-field>
                                    <display text="${thruDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="applTypeEnumId">
                                <header-field title="Application"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="rowActions">
                                <default-field title="">
                                    <container-dialog condition="canEdit" id="EditFeatureDefaultsRows" button-text="Edit" icon="sym_o_edit" title="Edit default feature" width="640">
                                        <form-single name="EditFeatureDefaultsRows" transition="storeFeatureDefaultsRows">
                                            <field name="productCategoryId">
                                                <default-field title="Category">
                                                    <hidden/>
                                                    <display-entity entity-name="mantle.product.category.ProductCategory" text="${categoryName}"/>
                                                </default-field>
                                            </field>
                                            <field name="productFeatureGroupId">
                                                <default-field title="Feature group">
                                                    <hidden/>
                                                    <display/>
                                                </default-field>
                                            </field>
                                            <field name="fromDate">
                                                <default-field title="From">
                                                    <hidden/>
                                                    <display/>
                                                </default-field>
                                            </field>
                                            <field name="thruDate">
                                                <default-field title="Through">
                                                    <date-time/>
                                                </default-field>
                                            </field>
                                            <field name="applTypeEnumId">
                                                <default-field title="Application">
                                                    <drop-down allow-empty="true">
                                                        <option key="PfatStandard" text="Standard"/>
                                                        <option key="PfatSelectable" text="Selectable"/>
                                                        <option key="PfatDistinguishing" text="Distinguishing"/>
                                                    </drop-down>
                                                </default-field>
                                            </field>
                                            <field name="submitButton">
                                                <default-field title="Save">
                                                    <submit/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="productFeatureGroupId"/></column>
                                <column><field-ref name="fromDate"/></column>
                            </columns>
                        </form-list>
                        <section name="FeatureDefaultsRowsEditor" condition="canEdit">
                            <widgets>
                                <container-dialog id="AddFeatureDefaultsRows" button-text="Add default feature" icon="sym_o_add" title="Add a default feature" width="640">
                                    <form-single name="AddFeatureDefaultsRows" transition="storeFeatureDefaultsRows">
                                        <field name="productCategoryId">
                                            <default-field title="Category">
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="productFeatureGroupId">
                                            <default-field title="Feature group">
                                                <drop-down allow-empty="true">
                                                    <list-options list="options.groups" key="${value}" text="${label}"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="fromDate">
                                            <default-field title="From">
                                                <date-time/>
                                            </default-field>
                                        </field>
                                        <field name="thruDate">
                                            <default-field title="Through">
                                                <date-time/>
                                            </default-field>
                                        </field>
                                        <field name="applTypeEnumId">
                                            <default-field title="Application">
                                                <drop-down allow-empty="true">
                                                    <option key="PfatStandard" text="Standard"/>
                                                    <option key="PfatSelectable" text="Selectable"/>
                                                    <option key="PfatDistinguishing" text="Distinguishing"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="submitButton">
                                            <default-field title="Save">
                                                <submit/>
                                            </default-field>
                                        </field>
                                    </form-single>
                                </container-dialog>
                            </widgets>
                        </section>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
