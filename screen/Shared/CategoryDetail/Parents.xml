<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Parents &amp; children" default-menu-index="2">
    <transition name="storeParents">
        <actions>
            <service-call name="ironstone.products.CategoryServices.store#CategoryParent" in-map="context"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="storeChildren">
        <actions>
            <service-call name="ironstone.products.CategoryServices.store#CategoryParent" in-map="{productCategoryId:childProductCategoryId,parentProductCategoryId:productCategoryId,fromDate:fromDate,thruDate:thruDate,sequenceNum:sequenceNum}"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="moveParent">
        <actions>
            <service-call name="ironstone.products.CategoryServices.move#CategoryParent" in-map="context"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="endParent">
        <actions>
            <service-call name="ironstone.products.CategoryServices.expire#CategoryParent" in-map="context"/>
        </actions>
        <default-response url=".">
            <parameter name="productCategoryId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <actions>
        <set field="childRows" from="detail ? detail.children.map(row =&gt; Object.assign({},row,{childProductCategoryId:row.productCategoryId})) : []"/>
    </actions>
    <widgets>
        <section name="Available" condition="recordFound">
            <widgets>
                <container-box>
                    <box-header title="Parents"/>
                    <box-body>
                        <form-list name="ParentsList" list="detail.parents" skip-form="true" paginate="false">
                            <field name="parentProductCategoryId">
                                <header-field title="Parent"/>
                                <default-field>
                                    <link url="${sharedLinks['Categories/CategoryDetail']}" text="${parentProductCategoryId}" parameter-map="{productCategoryId:parentProductCategoryId}" link-type="anchor"/>
                                </default-field>
                            </field>
                            <field name="fromDate">
                                <header-field title="From"/>
                                <default-field>
                                    <display text="${fromDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="thruDate">
                                <header-field title="Through"/>
                                <default-field>
                                    <display text="${thruDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="sequenceNum">
                                <header-field title="Sequence"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="rowActions">
                                <default-field title="">
                                    <container-dialog condition="canEdit" id="EditParents" button-text="Edit" icon="sym_o_edit" title="Edit parent edge" width="640">
                                        <form-single name="EditParents" transition="storeParents">
                                            <field name="productCategoryId">
                                                <default-field title="Category">
                                                    <hidden/>
                                                    <display-entity entity-name="mantle.product.category.ProductCategory" text="${categoryName}"/>
                                                </default-field>
                                            </field>
                                            <field name="parentProductCategoryId">
                                                <default-field title="Parent">
                                                    <hidden/>
                                                    <display-entity entity-name="mantle.product.category.ProductCategory" text="${categoryName}"/>
                                                </default-field>
                                            </field>
                                            <field name="fromDate">
                                                <default-field title="From">
                                                    <hidden/>
                                                    <display/>
                                                </default-field>
                                            </field>
                                            <field name="thruDate">
                                                <default-field title="Through">
                                                    <date-time/>
                                                </default-field>
                                            </field>
                                            <field name="sequenceNum">
                                                <default-field title="Sequence">
                                                    <text-line input-type="number"/>
                                                </default-field>
                                            </field>
                                            <field name="submitButton">
                                                <default-field title="Save">
                                                    <submit/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                    <container-dialog condition="canEdit" id="MoveParent" button-text="Move" icon="sym_o_drive_file_move" title="Move this parent edge; other parents stay" width="640">
                                        <form-single name="MoveCategoryParent" transition="moveParent">
                                            <field name="productCategoryId">
                                                <default-field>
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="originalParentProductCategoryId" from="parentProductCategoryId">
                                                <default-field>
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="fromDate">
                                                <default-field>
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="parentProductCategoryId">
                                                <default-field title="New parent">
                                                    <drop-down allow-empty="true">
                                                        <list-options list="options.categories" key="${value}" text="${label}"/>
                                                    </drop-down>
                                                </default-field>
                                            </field>
                                            <field name="effectiveDate">
                                                <default-field title="Effective date">
                                                    <date-time/>
                                                </default-field>
                                            </field>
                                            <field name="submitButton">
                                                <default-field title="Move selected edge">
                                                    <submit/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                    <button-menu text="" icon="more_vert" condition="canEdit">
                                        <link url="endParent" text="End this edge" icon="sym_o_event_busy" link-type="hidden-form-link" btn-type="danger" confirmation="End this category parent edge now?" parameter-map="{productCategoryId:productCategoryId,parentProductCategoryId:parentProductCategoryId,fromDate:fromDate}" condition="Number(fromDate) &lt; Number(ec.user.nowTimestamp) &amp;&amp; (!thruDate || Number(thruDate) &gt; Number(ec.user.nowTimestamp))"/>
                                        <link url="endParent" text="Remove future edge" icon="sym_o_delete" link-type="hidden-form-link" btn-type="danger" confirmation="Remove this future category edge?" parameter-map="{productCategoryId:productCategoryId,parentProductCategoryId:parentProductCategoryId,fromDate:fromDate,operation:'delete'}" condition="Number(fromDate) &gt; Number(ec.user.nowTimestamp)"/>
                                    </button-menu>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="parentProductCategoryId"/></column>
                                <column><field-ref name="fromDate"/></column>
                            </columns>
                        </form-list>
                        <section name="ParentsEditor" condition="canEdit">
                            <widgets>
                                <container-dialog id="AddParents" button-text="Add parent" icon="sym_o_add" title="Place the category under a parent" width="640">
                                    <form-single name="AddParents" transition="storeParents">
                                        <field name="productCategoryId">
                                            <default-field title="Category">
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="parentProductCategoryId">
                                            <default-field title="Parent">
                                                <drop-down allow-empty="true">
                                                    <list-options list="options.categories" key="${value}" text="${label}"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="fromDate">
                                            <default-field title="From">
                                                <date-time/>
                                            </default-field>
                                        </field>
                                        <field name="thruDate">
                                            <default-field title="Through">
                                                <date-time/>
                                            </default-field>
                                        </field>
                                        <field name="sequenceNum">
                                            <default-field title="Sequence">
                                                <text-line input-type="number"/>
                                            </default-field>
                                        </field>
                                        <field name="submitButton">
                                            <default-field title="Save">
                                                <submit/>
                                            </default-field>
                                        </field>
                                    </form-single>
                                </container-dialog>
                            </widgets>
                        </section>
                    </box-body>
                </container-box>
                <container-box>
                    <box-header title="Children"/>
                    <box-body>
                        <form-list name="ChildrenList" list="childRows" skip-form="true" paginate="false">
                            <field name="childProductCategoryId">
                                <header-field title="Child"/>
                                <default-field>
                                    <link url="${sharedLinks['Categories/CategoryDetail']}" text="${childProductCategoryId}" parameter-map="{productCategoryId:childProductCategoryId}" link-type="anchor"/>
                                </default-field>
                            </field>
                            <field name="fromDate">
                                <header-field title="From"/>
                                <default-field>
                                    <display text="${fromDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="thruDate">
                                <header-field title="Through"/>
                                <default-field>
                                    <display text="${thruDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="sequenceNum">
                                <header-field title="Sequence"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="rowActions">
                                <default-field title="">
                                    <container-dialog condition="canEdit" id="EditChildren" button-text="Edit" icon="sym_o_edit" title="Children" width="640">
                                        <form-single name="EditChildren" transition="storeChildren">
                                            <field name="childProductCategoryId">
                                                <default-field title="Child">
                                                    <hidden/>
                                                    <display/>
                                                </default-field>
                                            </field>
                                            <field name="fromDate">
                                                <default-field title="From">
                                                    <hidden/>
                                                    <display/>
                                                </default-field>
                                            </field>
                                            <field name="thruDate">
                                                <default-field title="Through">
                                                    <date-time/>
                                                </default-field>
                                            </field>
                                            <field name="sequenceNum">
                                                <default-field title="Sequence">
                                                    <text-line input-type="number"/>
                                                </default-field>
                                            </field>
                                            <field name="submitButton">
                                                <default-field title="Save">
                                                    <submit/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="childProductCategoryId"/></column>
                                <column><field-ref name="fromDate"/></column>
                            </columns>
                        </form-list>
                        <section name="ChildrenEditor" condition="canEdit">
                            <widgets>
                                <container-dialog id="AddChildren" button-text="Add child" icon="sym_o_add" title="Place a category under this one" width="640">
                                    <form-single name="AddChildren" transition="storeChildren">
                                        <field name="childProductCategoryId">
                                            <default-field title="Child">
                                                <drop-down allow-empty="true">
                                                    <list-options list="options.categories" key="${value}" text="${label}"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="fromDate">
                                            <default-field title="From">
                                                <date-time/>
                                            </default-field>
                                        </field>
                                        <field name="thruDate">
                                            <default-field title="Through">
                                                <date-time/>
                                            </default-field>
                                        </field>
                                        <field name="sequenceNum">
                                            <default-field title="Sequence">
                                                <text-line input-type="number"/>
                                            </default-field>
                                        </field>
                                        <field name="submitButton">
                                            <default-field title="Save">
                                                <submit/>
                                            </default-field>
                                        </field>
                                    </form-single>
                                </container-dialog>
                            </widgets>
                        </section>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
