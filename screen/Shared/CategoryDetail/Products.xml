<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Products" default-menu-index="3">
    <transition name="storeProductsRows">
        <actions>
            <service-call name="ironstone.products.CategoryServices.store#CategoryRow" in-map="Object.assign({},context,{rowKind:'member'})"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <widgets>
        <section name="Available" condition="recordFound">
            <widgets>
                <container-box>
                    <box-header title="Products"/>
                    <box-body>
                        <form-list name="ProductsRowsList" list="detail.products" skip-form="true" paginate="false">
                            <field name="productId">
                                <header-field title="Product"/>
                                <default-field>
                                    <link url="${sharedLinks['Products/Product360']}" text="${productId}" parameter-map="{productId:productId}" link-type="anchor"/>
                                </default-field>
                            </field>
                            <field name="fromDate">
                                <header-field title="From"/>
                                <default-field>
                                    <display text="${fromDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="thruDate">
                                <header-field title="Through"/>
                                <default-field>
                                    <display text="${thruDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="sequenceNum">
                                <header-field title="Sequence"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="comments">
                                <header-field title="Notes"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="rowActions">
                                <default-field title="">
                                    <container-dialog condition="canEdit" id="EditProductsRows" button-text="Edit" icon="sym_o_edit" title="Edit product membership" width="640">
                                        <form-single name="EditProductsRows" transition="storeProductsRows">
                                            <field name="productCategoryId">
                                                <default-field title="Category">
                                                    <hidden/>
                                                    <display-entity entity-name="mantle.product.category.ProductCategory" text="${categoryName}"/>
                                                </default-field>
                                            </field>
                                            <field name="productId">
                                                <default-field title="Product">
                                                    <hidden/>
                                                    <display/>
                                                </default-field>
                                            </field>
                                            <field name="fromDate">
                                                <default-field title="From">
                                                    <hidden/>
                                                    <display/>
                                                </default-field>
                                            </field>
                                            <field name="thruDate">
                                                <default-field title="Through">
                                                    <date-time/>
                                                </default-field>
                                            </field>
                                            <field name="sequenceNum">
                                                <default-field title="Sequence">
                                                    <text-line input-type="number"/>
                                                </default-field>
                                            </field>
                                            <field name="comments">
                                                <default-field title="Notes">
                                                    <text-line/>
                                                </default-field>
                                            </field>
                                            <field name="submitButton">
                                                <default-field title="Save">
                                                    <submit/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="productId"/></column>
                                <column><field-ref name="fromDate"/></column>
                            </columns>
                        </form-list>
                        <section name="ProductsRowsEditor" condition="canEdit">
                            <widgets>
                                <container-dialog id="AddProductsRows" button-text="Add product" icon="sym_o_add" title="Add a product to the category" width="640">
                                    <form-single name="AddProductsRows" transition="storeProductsRows">
                                        <field name="productCategoryId">
                                            <default-field title="Category">
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="productId">
                                            <default-field title="Product">
                                                <drop-down allow-empty="true">
                                                    <dynamic-options transition="../choices" server-search="true" min-length="0" parameter-map="{choice:'products'}"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="fromDate">
                                            <default-field title="From">
                                                <date-time/>
                                            </default-field>
                                        </field>
                                        <field name="thruDate">
                                            <default-field title="Through">
                                                <date-time/>
                                            </default-field>
                                        </field>
                                        <field name="sequenceNum">
                                            <default-field title="Sequence">
                                                <text-line input-type="number"/>
                                            </default-field>
                                        </field>
                                        <field name="comments">
                                            <default-field title="Notes">
                                                <text-line/>
                                            </default-field>
                                        </field>
                                        <field name="submitButton">
                                            <default-field title="Save">
                                                <submit/>
                                            </default-field>
                                        </field>
                                    </form-single>
                                </container-dialog>
                            </widgets>
                        </section>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
