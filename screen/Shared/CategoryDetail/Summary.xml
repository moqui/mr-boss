<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Summary" default-menu-index="1">
    <widgets>
        <section name="Available" condition="recordFound">
            <widgets>
                <container-box>
                    <box-header title="Category"/>
                    <box-body>
                        <!-- one layout for every user: an editor edits the fields a reader sees as text (style-guide §3.3) -->
                        <form-single name="Category" transition="../save" map="master">
                            <field name="productCategoryId">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="expectedLastUpdatedStamp" from="master.lastUpdatedStamp">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="categoryName">
                                <conditional-field condition="canEdit" title="Name">
                                    <text-line/>
                                </conditional-field>
                                <default-field title="Name">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="productCategoryTypeEnumId">
                                <conditional-field condition="canEdit" title="Type">
                                    <drop-down allow-empty="true">
                                        <list-options list="options.categoryTypes" key="${value}" text="${label}"/>
                                    </drop-down>
                                </conditional-field>
                                <default-field title="Type">
                                    <display-entity entity-name="moqui.basic.Enumeration"/>
                                </default-field>
                            </field>
                            <field name="description">
                                <conditional-field condition="canEdit" title="Description">
                                    <text-area rows="3"/>
                                </conditional-field>
                                <default-field title="Description">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="submitButton">
                                <conditional-field condition="canEdit" title="Save">
                                    <submit/>
                                </conditional-field>
                            </field>
                        </form-single>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
