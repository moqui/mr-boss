<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Supplier" default-menu-include="false">
    <parameter name="appRoot"/>
    <parameter name="vendorPartyId"/>
    <parameter name="organizationPartyId"/>
    <always-actions>
        <!-- Manufacturing's mount (Manufacturing/Subcontracting/Supplier360, crosscut §3.3 Manufacturing row, impl-manufacturing
            P14) has its own read: contact and the supplier's subcontract orders, their price only for a buyer
            (ironstone.manufacturing.SubcontractServices.get#SupplierContext over find#SubcontractOperations) -->
        <if condition="appRoot == 'Manufacturing'">
            <then>
                <service-call name="ironstone.manufacturing.AccessServices.get#SharedContext" in-map="{appRoot:appRoot}"
                        out-map="sharedMountContext"/>
                <set field="sharedLinks" from="sharedMountContext.sharedLinks"/>
                <service-call name="ironstone.manufacturing.SubcontractServices.get#SupplierContext"
                        in-map="{vendorPartyId:vendorPartyId}" out-map="context"/>
            </then>
            <else>
                <service-call name="ironstone.products.CatalogServices.get#SharedContext" in-map="{appRoot:appRoot}" out-map="sharedMountContext"/>
                <script>if(!sharedMountContext.capabilities.read)throw new Error('Catalog read access is required')</script>
                <set field="appRoot" from="sharedMountContext.appRoot"/>
                <set field="sharedLinks" from="sharedMountContext.sharedLinks"/>
                <set field="printBase" from="sharedMountContext.printBase"/>
                <!-- Warehouse's mount (Warehouse/Receiving/Supplier360, crosscut §3.3 Warehouse row) has its own read: contact,
                    orders, receipts, rejections and returns, no price (ironstone.warehouse.ReceiptServices.get#SupplierReceiving) -->
                <if condition="appRoot == 'Warehouse'">
                    <then>
                        <service-call name="ironstone.warehouse.ReceiptServices.get#SupplierReceiving"
                                in-map="{vendorPartyId:vendorPartyId}" out-map="context"/>
                    </then>
                    <else>
                        <service-call name="ironstone.products.SupplierServices.get#SupplierDetail" in-map="context" out-map="context"/>
                    </else>
                </if>
            </else>
        </if>
    </always-actions>
    <subscreens default-item="Overview">
        <subscreens-item name="Prices" menu-index="2" location="component://mr-boss/screen/Shared/SupplierPrices.xml" menu-title="Products &amp; prices"/>
    </subscreens>
    <actions>
        <entity-find-one entity-name="mantle.party.Organization" value-field="buyerOrganization" cache="true">
            <field-map field-name="partyId" from="organizationPartyId"/>
        </entity-find-one>
        <set field="canOffer" from="appRoot != 'Manufacturing' &amp;&amp; !!sharedMountContext.capabilities.supplierPriceEdit"/>
        <set field="subcontractSummary" from="appRoot == 'Manufacturing' ? (subcontractRows?.length ? subcontractRows.length
                + ' outside-processing operations' : 'No outside processing yet') : ''"/>
        <set field="receivingSummary" from="[orderRows?.length ? orderRows.length + ' open orders' : 'No open order',
                receiptRows?.length ? receiptRows.length + ' receipt lines' : '',
                rejectionRows?.length ? rejectionRows.length + ' with rejections' : ''].filter(Boolean).join(' · ')"/>
    </actions>
    <widgets>
        <context record-entity="mantle.party.Party" record-id="${vendorPartyId}" title="${supplier.supplierName}"/>
        <!-- the header card (style-guide §3.4): the supplier and the buying organization, with a new offer as the primary action -->
        <container style="m-record-header">
            <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                <container style="col-12 col-md m-record-title">
                    <label text="${supplier.supplierName}" type="h5"/>
                    <label text="Supplier to ${buyerOrganization?.organizationName || organizationPartyId}" type="p"
                            style="text-caption m-muted q-mb-none" condition="appRoot != 'Warehouse' &amp;&amp; appRoot != 'Manufacturing'"/>
                    <label text="${subcontractSummary}" type="p" style="text-caption m-muted q-mb-none"
                            condition="appRoot == 'Manufacturing'"/>
                    <label text="${receivingSummary}" type="p" style="text-caption m-muted q-mb-none"
                            condition="appRoot == 'Warehouse'"/>
                </container>
                <container style="col-12 col-md-auto row items-center q-gutter-y-xs m-record-actions">
                    <link url="Prices" text="New supplier offer" link-type="anchor-button" btn-type="primary" icon="sym_o_add" condition="canOffer"
                            parameter-map="{vendorPartyId:vendorPartyId,organizationPartyId:organizationPartyId,_openDialog:'NewSupplierOfferDialog'}"/>
                </container>
            </container>
        </container>
        <subscreens-panel id="SupplierTabs" type="tab"/>
    </widgets>
</screen>
