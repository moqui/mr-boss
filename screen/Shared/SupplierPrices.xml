<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Supplier prices" default-menu-index="1">
    <parameter name="appRoot"/>
    <parameter name="organizationPartyId"/>
    <parameter name="vendorPartyId"/>
    <parameter name="productId"/>
    <parameter name="priceUomId"/>
    <parameter name="supplierItemCode"/>
    <parameter name="preferredOrderEnumId"/>
    <parameter name="asOfDate"/>
    <parameter name="includeHistory"/>
    <parameter name="groupBy"/>
    <parameter name="pageIndex"/>
    <parameter name="pageSize"/>
    <always-actions>
        <service-call name="ironstone.products.CatalogServices.get#SharedContext" in-map="{appRoot:appRoot}" out-map="sharedMountContext"/>
        <script>if(!sharedMountContext.capabilities.read)throw new Error('Catalog read access is required')</script>
        <set field="appRoot" from="sharedMountContext.appRoot"/>
        <set field="sharedLinks" from="sharedMountContext.sharedLinks"/>
        <set field="printBase" from="sharedMountContext.printBase"/>
    </always-actions>
    <transition name="store">
        <actions>
            <service-call name="ironstone.products.SupplierServices.store#SupplierPrice" in-map="context"/>
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId"/>
            <parameter name="vendorPartyId"/>
            <parameter name="productId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="replace">
        <actions>
            <service-call name="ironstone.products.SupplierServices.replace#SupplierPrice" in-map="context"/>
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId"/>
            <parameter name="vendorPartyId"/>
            <parameter name="productId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="expire">
        <actions>
            <service-call name="ironstone.products.SupplierServices.expire#SupplierPrice" in-map="context"/>
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId"/>
            <parameter name="vendorPartyId"/>
            <parameter name="productId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition-include name="choices" location="component://mr-boss/template/CatalogChoiceTransitions.xml"/>
    <transition name="bulk">
        <default-response url="${sharedLinks['Products/BulkPrice']}">
            <parameter name="direction" value="purchase"/>
            <parameter name="organizationPartyId"/>
            <parameter name="vendorPartyId"/>
            <parameter name="productPriceIds"/>
        </default-response>
    </transition>
    <condition>
        <!-- not in Warehouse's Supplier360, which shows no price (crosscut §3.3 Warehouse row), nor in Manufacturing's, whose
            subcontract orders show their price to a buyer only (§3.3 Manufacturing row) -->
        <!-- in Purchasing (impl-purchasing P2) for a supplier-price reader only -->
        <expression>appRoot != 'Warehouse' &amp;&amp; appRoot != 'Manufacturing'
            &amp;&amp; (!Array.isArray(product360Tabs) || product360Tabs.includes('Suppliers'))
            &amp;&amp; (appRoot != 'Purchasing' || !!sharedMountContext.capabilities.supplierPriceRead)</expression>
    </condition>
    <actions>
        <service-call name="ironstone.products.SupplierServices.get#SupplierOptions" in-map="context" out-map="context"/>
        <service-call name="ironstone.products.SupplierServices.find#SupplierPrices" in-map="context" out-map="context"/>
        <script>offerRowsPageIndex=pageIndex;offerRowsPageSize=pageSize;offerRowsPageMaxIndex=Math.max(0,Math.ceil(offerRowsCount/pageSize)-1);offerRowsPageRangeLow=offerRows.length?pageIndex*pageSize+1:0;offerRowsPageRangeHigh=pageIndex*pageSize+offerRows.length;newOffer={organizationPartyId:organizationPartyId,productId:productId||null,vendorPartyId:vendorPartyId||null,customerPartyId:organizationPartyId,priceTypeEnumId:'PptCurrent',pricePurposeEnumId:'PppPurchase',priceUomId:pricingDefaults.defaultCurrencyUomId||'USD',quantityUomId:'OTH_ea',minQuantity:'0'}</script>
    </actions>
    <widgets>
        <container-box>
            <box-header title="Supplier offers"/>
            <box-body>
                <label text="Supplier is the vendor; the internal buying organization is the customer. A case or pallet offer prices the pack product." type="p"/>
                <form-single name="SupplierPriceFind" transition=".">
                    <field name="organizationPartyId">
                        <default-field title="Buying organization">
                            <drop-down allow-empty="true">
                                <list-options list="priceOptions.organizations" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="vendorPartyId">
                        <default-field title="Supplier">
                            <drop-down allow-empty="true">
                                <list-options list="priceOptions.suppliers" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="productId">
                        <default-field title="Product or base product">
                            <drop-down allow-empty="true">
                                <dynamic-options parameter-map="{choice:'products',selected:productId}" transition="choices" server-search="true" min-length="0"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="supplierItemCode">
                        <default-field title="Supplier item code">
                            <text-line/>
                        </default-field>
                    </field>
                    <field name="priceUomId">
                        <default-field title="Currency">
                            <drop-down allow-empty="true">
                                <list-options list="priceOptions.currencies" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="preferredOrderEnumId">
                        <default-field title="Preference">
                            <drop-down allow-empty="true">
                                <list-options list="preferenceOptions" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="asOfDate">
                        <default-field title="Offer date">
                            <date-time/>
                        </default-field>
                    </field>
                    <field name="includeHistory">
                        <default-field title="Show ended and scheduled offers">
                            <drop-down allow-empty="true">
                                <option key="true" text="Yes"/>
                                <option key="false" text="No"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="groupBy">
                        <default-field title="Group order">
                            <drop-down>
                                <option key="supplier" text="Supplier"/>
                                <option key="product" text="Product"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="submitButton">
                        <default-field title="Find offers">
                            <submit/>
                        </default-field>
                    </field>
                </form-single>
            </box-body>
        </container-box>
        <section name="NewOfferAllowed" condition="canSupplierPriceEdit">
            <widgets>
                <container-dialog id="NewSupplierOfferDialog" button-text="New supplier offer" title="New supplier offer" width="960">
                    <form-single name="NewSupplierOffer" transition="store" map="newOffer">
                        <field name="organizationPartyId">
                            <default-field title="">
                                <hidden/>
                            </default-field>
                        </field>
                        <field name="productId">
                            <default-field title="Product or pack product">
                                <drop-down allow-empty="false">
                                    <dynamic-options parameter-map="{choice:'products',selected:productId}" transition="choices" server-search="true" min-length="0"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="vendorPartyId">
                            <default-field title="Supplier">
                                <drop-down allow-empty="true">
                                    <list-options list="priceOptions.suppliers" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="customerPartyId">
                            <default-field title="Buying organization">
                                <display also-hidden="true"/>
                            </default-field>
                        </field>
                        <field name="priceTypeEnumId">
                            <default-field title="Price type">
                                <drop-down allow-empty="true">
                                    <list-options list="priceOptions.types" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="pricePurposeEnumId">
                            <default-field title="Purpose">
                                <drop-down allow-empty="true">
                                    <list-options list="priceOptions.purposes" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="otherPartyItemId">
                            <default-field title="Supplier item code">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="otherPartyItemName">
                            <default-field title="Supplier item name">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="price">
                            <default-field title="Unit price">
                                <text-line input-type="number"/>
                            </default-field>
                        </field>
                        <field name="priceUomId">
                            <default-field title="Currency">
                                <drop-down allow-empty="true">
                                    <list-options list="priceOptions.currencies" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="minQuantity">
                            <default-field title="Minimum quantity">
                                <text-line input-type="number"/>
                            </default-field>
                        </field>
                        <field name="quantityIncrement">
                            <default-field title="Order increment">
                                <text-line input-type="number"/>
                            </default-field>
                        </field>
                        <field name="quantityUomId">
                            <default-field title="Quantity unit">
                                <drop-down allow-empty="true">
                                    <list-options list="priceOptions.units" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="quantityIncluded">
                            <default-field title="Offer included quantity">
                                <text-line input-type="number"/>
                            </default-field>
                        </field>
                        <field name="standardLeadTimeDays">
                            <default-field title="Lead time" tooltip="Days">
                                <text-line input-type="number"/>
                            </default-field>
                        </field>
                        <field name="preferredOrderEnumId">
                            <default-field title="Preference">
                                <drop-down allow-empty="true">
                                    <list-options list="preferenceOptions" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="supplierRatingTypeEnumId">
                            <default-field title="Recorded supplier rating">
                                <drop-down allow-empty="true">
                                    <list-options list="ratingOptions" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="canDropShip">
                            <default-field title="Dropship">
                                <drop-down allow-empty="true">
                                    <option key="Y" text="Yes"/>
                                    <option key="N" text="No"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="agreementId">
                            <default-field title="Agreement">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="agreementItemSeqId">
                            <default-field title="Agreement item">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="fromDate">
                            <default-field title="Effective from" tooltip="Leave empty to start now">
                                <date-time/>
                            </default-field>
                        </field>
                        <field name="thruDate">
                            <default-field title="Through">
                                <date-time/>
                            </default-field>
                        </field>
                        <field name="changeReason">
                            <default-field title="Reason">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="submitButton">
                            <default-field title="Create offer">
                                <submit/>
                            </default-field>
                        </field>
                    </form-single>
                </container-dialog>
            </widgets>
        </section>
        <container-box>
            <box-header title="Comparable supplier prices"/>
            <box-body>
                <form-list show-csv-button="true" show-xlsx-button="true" name="SupplierOffers" list="offerRows" paginate="true" skip-form="true" select-columns="true">
                    <row-selection id-field="productPriceId" parameter="productPriceIds" list-mode="true" condition="canSupplierPriceEdit">
                        <action>
                            <form-single name="SupplierBulkSelection" transition="bulk">
                                <field name="organizationPartyId">
                                    <default-field title="">
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="vendorPartyId">
                                    <default-field title="">
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="submitButton">
                                    <default-field title="Review supplier price changes">
                                        <submit/>
                                    </default-field>
                                </field>
                            </form-single>
                        </action>
                    </row-selection>
                    <field name="productId">
                        <default-field title="Priced product">
                            <link url="${sharedLinks['Products/Product360']}" text="${productId}" link-type="anchor" parameter-map="{productId:productId}"/>
                        </default-field>
                    </field>
                    <field name="productName">
                        <default-field title="Product">
                            <display/>
                        </default-field>
                    </field>
                    <field name="supplierName">
                        <default-field title="Supplier">
                            <link url="${sharedLinks['SupplierPrices/Supplier360']}" text="${supplierName}" link-type="anchor" parameter-map="{vendorPartyId:vendorPartyId,organizationPartyId:organizationPartyId}"/>
                        </default-field>
                    </field>
                    <field name="vendorPartyId">
                        <default-field title="Vendor role">
                            <display-entity entity-name="mantle.party.PartyDetail" text="PartyNameTemplate"/>
                        </default-field>
                    </field>
                    <field name="buyerName">
                        <default-field title="Buyer">
                            <display/>
                        </default-field>
                    </field>
                    <field name="customerPartyId">
                        <default-field title="Customer role">
                            <display-entity entity-name="mantle.party.PartyDetail" text="PartyNameTemplate"/>
                        </default-field>
                    </field>
                    <field name="otherPartyItemId">
                        <default-field title="Supplier item code">
                            <display/>
                        </default-field>
                    </field>
                    <field name="otherPartyItemName">
                        <default-field title="Supplier item name">
                            <display/>
                        </default-field>
                    </field>
                    <field name="price" align="right">
                        <default-field title="Unit price">
