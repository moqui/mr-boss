                                        <default-field title="">
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="thruDate">
                                        <default-field title="End at" tooltip="Leave empty to end it now">
                                            <date-time/>
                                        </default-field>
                                    </field>
                                    <field name="changeReason">
                                        <default-field title="Reason">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="submitButton">
                                        <default-field title="End offer">
                                            <submit type="danger" confirmation="End this row? It stays in the history and stops applying from the end date."/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </container-dialog>
                        </default-field>
                    </field>
                    <columns>
                        <column><field-ref name="productId"/><field-ref name="productName"/></column>
                        <column><field-ref name="supplierName"/><field-ref name="otherPartyItemId"/><field-ref name="otherPartyItemName"/></column>
                        <column><field-ref name="buyerName"/></column>
                        <column><field-ref name="price"/><field-ref name="priceUomId"/></column>
                        <column><field-ref name="minQuantity"/><field-ref name="quantityIncrement"/><field-ref name="quantityUomId"/></column>
                        <column><field-ref name="packSize"/><field-ref name="packQuantityUomId"/><field-ref name="baseProductId"/></column>
                        <column><field-ref name="standardLeadTimeDays"/><field-ref name="preferredOrderEnumId"/><field-ref name="supplierRatingTypeEnumId"/></column>
                        <column><field-ref name="canDropShip"/><field-ref name="agreementId"/><field-ref name="agreementItemSeqId"/></column>
                        <column><field-ref name="fromDateText"/><field-ref name="thruDateText"/></column>
                        <column><field-ref name="state"/></column>
                        <column><field-ref name="rowActions"/></column>
                    </columns>
                    <columns type="mobile">
                        <column>
                            <field-ref name="productId"/>
                            <field-ref name="supplierName"/>
                        </column>
                        <column>
                            <field-ref name="price"/>
                            <field-ref name="state"/>
                            <field-ref name="rowActions"/>
                        </column>
                    </columns>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
    <fail-widgets>
        <label text="Supplier prices are not available to you." type="p" condition="appRoot == 'Purchasing'"/>
    </fail-widgets>
</screen>
