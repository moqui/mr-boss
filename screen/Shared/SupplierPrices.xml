                    <field name="packQuantityUomId">
                        <default-field title="Contained quantity unit">
                            <display-entity entity-name="moqui.basic.Uom"/>
                        </default-field>
                    </field>
                    <field name="baseProductId">
                        <default-field title="Contained product">
                            <display/>
                        </default-field>
                    </field>
                    <field name="standardLeadTimeDays">
                        <default-field title="Lead days">
                            <display/>
                        </default-field>
                    </field>
                    <field name="preferredOrderEnumId">
                        <default-field title="Preference">
