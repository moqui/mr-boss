                        </default-field>
                    </field>
                    <field name="supplierRatingTypeEnumId">
                        <default-field title="Recorded rating">
                            <display-entity entity-name="moqui.basic.Enumeration"/>
                        </default-field>
                    </field>
                    <field name="canDropShip">
                        <default-field title="Dropship">
                            <display/>
                        </default-field>
                    </field>
                    <field name="agreementId">
                        <default-field title="Agreement">
