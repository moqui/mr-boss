<!-- A category's identity, parents and children, members, identifiers, feature defaults and content (design-products §5;
    crosscut §2 Shared/CategoryDetail, made shared Nov 5, impl-commerce P3, F5). Mounted at Products/Categories/CategoryDetail
    (Products' context) and Commerce/Merchandising/CategoryDetail (Commerce's: the stores showing the category in the header,
    no feature defaults or delete; store choices narrowed to the user's stores, F47), each through
    ironstone.products.CatalogServices.get#SharedContext; writes need the catalog edit permission, checked again in the
    services. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Category" default-menu-include="false">
    <parameter name="appRoot"/>
    <parameter name="productCategoryId" required="true"/>
    <always-actions>
        <service-call name="ironstone.products.CatalogServices.get#SharedContext" in-map="{appRoot:appRoot}" out-map="sharedMountContext"/>
        <script>if(!sharedMountContext.capabilities.read)throw new Error('Catalog read access is required')</script>
        <set field="appRoot" from="sharedMountContext.appRoot"/>
        <set field="sharedLinks" from="sharedMountContext.sharedLinks"/>
        <service-call name="ironstone.products.CatalogServices.get#CatalogRecord" in-map="{recordEntityName:'mantle.product.category.ProductCategory',recordId:productCategoryId,checkOnly:true,appRoot:appRoot}" out-map="catalog"/>
        <set field="recordFound" from="!!catalog.record"/>
        <if condition="recordFound">
            <service-call name="ironstone.products.CategoryServices.get#CategoryDetail" in-map="context" out-map="context"/>
            <service-call name="ironstone.products.CategoryServices.get#CategoryOptions" in-map="{appRoot:appRoot}" out-map="context"/>
            <set field="master" from="detail.master"/>
            <set field="canEdit" from="detail.canEdit"/>
        </if>
    </always-actions>
    <transition-include name="choices" location="component://mr-boss/template/CatalogChoiceTransitions.xml"/>
    <transition name="save">
        <actions>
            <service-call name="ironstone.products.CategoryServices.store#Category" in-map="context"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="delete">
        <actions>
            <service-call name="ironstone.products.CategoryServices.delete#UnusedCategory" in-map="context"/>
        </actions>
        <default-response url="../List"/>
        <error-response url="."/>
    </transition>
    <subscreens default-item="Summary"/>
    <actions>
        <if condition="recordFound">
            <!-- the header's facts: the type and the owner by name -->
            <entity-find-one entity-name="moqui.basic.Enumeration" value-field="masterType" cache="true">
                <field-map field-name="enumId" from="master.productCategoryTypeEnumId"/>
            </entity-find-one>
            <entity-find-one entity-name="mantle.party.Organization" value-field="ownerOrganization" cache="true">
                <field-map field-name="partyId" from="master.ownerPartyId"/>
            </entity-find-one>
            <set field="factsText" from="[masterType?.description, master.ownerPartyId === '_NA_' || !master.ownerPartyId ? ec.l10n.localize('Shared catalog') : (ownerOrganization?.organizationName || master.ownerPartyId)].filter(Boolean).join(' · ')"/>
            <!-- Commerce: the user's stores that show the category, before anyone changes the taxonomy (design-commerce §10) -->
            <if condition="appRoot == 'Commerce'">
                <service-call name="mantle.product.StoreMerchandisingServices.get#CategoryStores" in-map="{productCategoryId:productCategoryId}" out-map="categoryStores" transaction="force-new" ignore-error="true"/>
                <set field="storesText" from="(categoryStores?.affectedStores || []).map(row => row.storeName).join(', ') + ((categoryStores?.otherStoreCount || 0) ? ' and ' + categoryStores.otherStoreCount + ' other stores' : '')"/>
            </if>
        </if>
    </actions>
    <widgets>
        <section name="Record" condition="recordFound">
            <widgets>
                <context record-entity="mantle.product.category.ProductCategory" record-id="${productCategoryId}" title="${master.categoryName}"/>
                <!-- the header card (style-guide §3.3): the ID and name, then the type and owner with the actions at their right -->
                <container style="m-record-header">
                    <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                        <container style="col-12 col-md m-record-title">
                            <container style="row items-center no-wrap">
                                <render-mode>
                                    <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none q-mr-sm text-mono">${WebUtilities.encodeHtml(productCategoryId)}</q-chip>]]></text>
                                    <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong", text: productCategoryId})}]]></text>
                                </render-mode>
                                <label text="${master.categoryName}" type="h5"/>
                            </container>
                            <label text="${factsText}" type="p" style="text-caption m-muted q-mb-none"/>
                            <label text="Shown in ${storesText}" type="p" style="text-caption q-mb-none" condition="appRoot == 'Commerce' &amp;&amp; storesText"/>
                            <label text="No store of yours shows this category." type="p" style="text-caption m-muted q-mb-none" condition="appRoot == 'Commerce' &amp;&amp; !storesText"/>
                        </container>
                        <container style="col-12 col-md-auto row items-center q-gutter-y-xs m-record-actions">
                            <button-menu text="More" icon="more_horiz" condition="canEdit &amp;&amp; appRoot != 'Commerce'">
                                <link url="delete" text="Delete unused category" link-type="hidden-form-link" icon="sym_o_delete" btn-type="danger"
                                        confirmation="Delete the unused category ${master.categoryName}?" parameter-map="{productCategoryId:productCategoryId}"/>
                            </button-menu>
                        </container>
                    </container>
                </container>
                <subscreens-panel id="CategoryTabs" type="tab"/>
            </widgets>
        </section>
        <section name="Unavailable" condition="!recordFound">
            <widgets>
                <container-box type="warning">
                    <box-header title="Not available"/>
                    <box-body>
                        <label text="This category is not available: it does not exist, or it belongs to an organization you are not in." type="p"/>
                        <link url=".." text="Back to the list" link-type="anchor"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
