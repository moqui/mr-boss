<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Product" default-menu-include="false">
    <parameter name="appRoot"/>
    <parameter name="productId" required="true"/>
    <parameter name="organizationPartyId"/>
    <always-actions>
        <!-- Accounting's mount (appRoot Accounting, Accounting/Records/Product360) has its own context and no catalog tabs:
            its root checked Accounting's access, and the product is read in actions (template/AccountingInventory.xml) -->
        <if condition="appRoot == 'Accounting'">
            <set field="product360Tabs" from="[]"/>
            <return/>
        </if>
        <service-call name="ironstone.products.CatalogServices.get#SharedContext" in-map="{appRoot:appRoot}" out-map="sharedMountContext"/>
        <script>if(!sharedMountContext.capabilities.read)throw new Error('Catalog read access is required')</script>
        <set field="appRoot" from="sharedMountContext.appRoot"/>
        <set field="sharedLinks" from="sharedMountContext.sharedLinks"/>
        <set field="printBase" from="sharedMountContext.printBase"/>
        <set field="product360Tabs" from="sharedMountContext.productTabs"/>
        <service-call name="ironstone.products.CatalogServices.get#CatalogRecord" in-map="{recordId:productId,checkOnly:true,appRoot:appRoot}" out-map="catalog"/>
        <set field="productFound" from="!!catalog.record"/>
        <!-- always-actions, as a tab renders standalone (the terminal, a reloaded tab) without this screen's actions;
            the costly reads (connections, stock, prices) are each tab's own -->
        <if condition="productFound">
            <service-call name="ironstone.products.CatalogServices.get#ProductDetail" in-map="{productId:productId,appRoot:appRoot}" out-map="context"/>
            <service-call name="ironstone.products.CatalogServices.get#CatalogOptions" out-map="context"/>
            <set field="product" from="detail.product"/>
            <set field="canEdit" from="detail.canEdit"/>
        </if>
    </always-actions>
    <transition-include name="choices" location="component://mr-boss/template/CatalogChoiceTransitions.xml"/>
    <transition-include name="storeProductGl" location="component://mr-boss/template/AccountingInventory.xml"/>
    <transition name="save">
        <actions>
            <service-call name="ironstone.products.CatalogServices.store#Product" in-map="context"/>
        </actions>
        <default-response url=".">
            <parameter name="productId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="status">
        <actions>
            <service-call name="ironstone.products.CatalogServices.transition#ProductStatus" in-map="context"/>
        </actions>
        <default-response url=".">
            <parameter name="productId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="clone">
        <actions>
            <service-call name="ironstone.products.CatalogServices.clone#Product" in-map="Object.assign({},context,{baseProductId:productId,productId:newProductId,productName:newProductName})" out-map="cloned"/>
            <if condition="!ec.message.hasError()">
                <set field="productId" from="cloned.productId"/>
            </if>
        </actions>
        <default-response url=".">
            <parameter name="productId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="deleteDraft">
        <actions>
            <service-call name="ironstone.products.CatalogServices.delete#UnusedDraft" in-map="{productId:productId,appRoot:appRoot}"/>
        </actions>
        <default-response url="../List"/>
        <error-response url="."/>
    </transition>
    <!-- the tabs in design-products §3 order; each tab screen also checks product360Tabs, the server-derived list -->
    <subscreens default-item="Summary">
        <subscreens-item name="Summary" menu-index="1" menu-include="true" location="component://mr-boss/screen/Shared/Product360/Summary.xml"/>
        <subscreens-item name="Features" menu-index="2" menu-include="true" location="component://mr-boss/screen/Shared/Product360/Features.xml"/>
        <subscreens-item name="Categories" menu-index="3" menu-include="true" location="component://mr-boss/screen/Shared/Product360/Categories.xml"/>
        <subscreens-item name="Identifiers" menu-index="4" menu-include="true" location="component://mr-boss/screen/Shared/Product360/Identifiers.xml"/>
        <subscreens-item name="Dimensions" menu-index="5" menu-include="true" location="component://mr-boss/screen/Shared/Product360/Dimensions.xml"/>
        <subscreens-item name="Packaging" menu-index="6" menu-include="true" location="component://mr-boss/screen/Shared/Packaging.xml"/>
        <subscreens-item name="Documents" menu-index="7" menu-include="true" location="component://mr-boss/screen/Shared/Product360/Documents.xml"/>
        <subscreens-item name="Prices" menu-index="8" menu-include="true" location="component://mr-boss/screen/Shared/Prices.xml"/>
        <subscreens-item name="Suppliers" menu-title="Suppliers" menu-index="9" menu-include="true" location="component://mr-boss/screen/Shared/SupplierPrices.xml"/>
        <subscreens-item name="Costs" menu-title="Costs" menu-index="10" menu-include="true" location="component://mr-boss/screen/Shared/StandardCosts.xml"/>
        <subscreens-item name="Stock" menu-index="11" menu-include="true" location="component://mr-boss/screen/Shared/InventoryAvailability.xml"/>
        <subscreens-item name="BOM" menu-title="BOM" menu-index="12" menu-include="true" location="component://mr-boss/screen/Shared/BillOfMaterialsDetail.xml"/>
        <subscreens-item name="KitComponents" menu-title="Kit components" menu-index="13" menu-include="true" location="component://mr-boss/screen/Shared/Product360/KitComponents.xml"/>
        <subscreens-item name="Equipment" menu-title="Equipment" menu-index="14" menu-include="true" location="component://mr-boss/screen/Shared/Product360/Equipment.xml"/>
        <subscreens-item name="Associations" menu-index="15" menu-include="true" location="component://mr-boss/screen/Shared/Product360/Associations.xml"/>
        <subscreens-item name="Parties" menu-index="16" menu-include="true" location="component://mr-boss/screen/Shared/Product360/Parties.xml"/>
        <subscreens-item name="Connections" menu-index="17" menu-include="true" location="component://mr-boss/screen/Shared/Product360/Connections.xml"/>
        <subscreens-item name="History" menu-index="18" menu-include="true" location="component://mr-boss/screen/Shared/Product360/History.xml"/>
    </subscreens>
    <actions>
        <if condition="appRoot == 'Accounting'">
            <set field="productFound" from="false"/>
            <service-call name="mantle.product.InventoryReportServices.get#ProductAccounting"
                    in-map="{productId:productId, organizationPartyId:organizationPartyId}"
                    out-map="context"
                    transaction="force-new"
                    ignore-error="true"/>
            <if condition="productFound">
                <script><![CDATA[
                    const quantityText = ec.l10n.format(summary.quantity, '#,##0.###')
                    const money = (value) => value == null ? '—' : ec.l10n.formatCurrency(toDecimal(value), summary.currency)
                    productMoney = {quantity: quantityText, stockValue: money(summary.stockValue),
                        ledgerBalance: money(summary.ledgerBalance), standard: money(summary.standardUnitCost)}
                    productFacts = ['On hand ' + quantityText, 'stock value ' + productMoney.stockValue,
                        'inventory account ' + productMoney.ledgerBalance].join(' · ')
                ]]></script>
            </if>
            <return/>
        </if>
        <if condition="productFound">
            <!-- the header's facts: the type and owner by name, and the key numbers -->
            <entity-find-one entity-name="moqui.basic.Enumeration" value-field="productType" cache="true">
                <field-map field-name="enumId" from="product.productTypeEnumId"/>
            </entity-find-one>
            <entity-find-one entity-name="mantle.party.Organization" value-field="ownerOrganization" cache="true">
                <field-map field-name="partyId" from="product.ownerPartyId"/>
            </entity-find-one>
            <script><![CDATA[
                ownerText = product.ownerPartyId === '_NA_' ? ec.l10n.localize('Shared catalog') : (ownerOrganization?.organizationName || product.ownerPartyId)
                factsText = [productType?.description || product.productTypeEnumId, ownerText].filter(Boolean).join(' · ')
                const now = ec.user.nowTimestamp, current = row => (!row.fromDate || row.fromDate <= now) && (!row.thruDate || row.thruDate > now)
                keyNumbers = {variants: (detail.variantRows || []).length, categories: (detail.categoryRows || []).filter(current).length,
                    identifiers: (detail.identifierRows || []).length, documents: (detail.contentRows || []).length}
                virtualProduct = product.productTypeEnumId === 'PtVirtual'
                kitProduct = product.productTypeEnumId === 'PtPickAssembly'
            ]]></script>
        </if>
    </actions>
    <widgets>
        <section-include name="AccountingProduct" location="component://mr-boss/template/AccountingInventory.xml"/>
        <section name="Available" condition="appRoot != 'Accounting' &amp;&amp; productFound">
            <widgets>
                <context record-entity="mantle.product.Product" record-id="${productId}" title="${product.productName}"/>
                <!-- the header card (style-guide §3.3, §3.4): the ID and name with the lifecycle at their right, then the tags with
                    the actions at their right; a reader sees the same card without the actions -->
                <container style="m-record-header">
                    <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                        <container style="col-12 col-md m-record-title">
                            <container style="row items-center no-wrap">
                                <render-mode>
                                    <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none q-mr-sm text-mono">${WebUtilities.encodeHtml(productId)}</q-chip>]]></text>
                                    <text type="tui"><![CDATA[${JSON.stringify({t: "text", id: "ProductKey", style: "strong", text: productId})}]]></text>
                                </render-mode>
                                <label text="${product.productName}" type="h5"/>
                            </container>
                            <label text="${factsText}" type="p" style="text-caption m-muted q-mb-none"/>
                        </container>
                        <container style="col-12 col-md-auto m-record-status">
                            <status-bar id="ProductStatus" status-id="${detail.effectiveStatusId}" status-flow-id="Default" stages="PrdDraft,PrdActive,PrdDiscontinued,PrdObsolete" read-only="true"/>
                        </container>
                    </container>
                    <container style="row items-center q-col-gutter-x-md q-col-gutter-y-sm m-record-foot">
                        <container style="col-12 col-md row q-gutter-xs">
                            <section-iterate name="Tags" list="detail.tagRows" entry="tag">
                                <widgets>
                                    <link url="${sharedLinks['Categories/CategoryDetail']}" text="${tag.categoryName}" link-type="anchor-button" icon="sym_o_sell" parameter-map="{productCategoryId:tag.productCategoryId}"/>
                                </widgets>
                            </section-iterate>
                        </container>
                        <container style="col-12 col-md-auto row items-center q-gutter-y-xs m-record-actions">
                            <section name="PrimaryStatus" condition="canEdit &amp;&amp; ['PrdDraft','PrdDiscontinued'].includes(detail.effectiveStatusId)">
                                <widgets>
                                    <link url="status" text="Activate" link-type="hidden-form" btn-type="primary" icon="sym_o_check_circle" confirmation="Activate ${product.productName}? Its required data is checked first."
                                            parameter-map="{productId:productId,statusId:'PrdActive',expectedStatusId:detail.effectiveStatusId}"/>
                                </widgets>
                            </section>
                            <link url="${sharedLinks['Products/VariantBuilder']}" text="Build variants" link-type="anchor-button" icon="sym_o_grid_view" condition="canEdit &amp;&amp; virtualProduct" parameter-map="{productId:productId}"/>
                            <button-menu text="More" icon="more_horiz" style="q-ml-xs">
                                <link url="${sharedLinks['Units/Labels']}" text="Product labels" icon="sym_o_qr_code_2" parameter-map="{productId:productId}"/>
                                <link url="status" text="Discontinue" link-type="hidden-form-link" icon="sym_o_event_busy" condition="canEdit &amp;&amp; detail.effectiveStatusId === 'PrdActive'"
                                        confirmation="Discontinue ${product.productName}?" parameter-map="{productId:productId,statusId:'PrdDiscontinued',expectedStatusId:detail.effectiveStatusId}"/>
                                <link url="status" text="Make obsolete" link-type="hidden-form-link" icon="sym_o_block" condition="canEdit &amp;&amp; detail.effectiveStatusId === 'PrdDiscontinued'"
                                        confirmation="Make ${product.productName} obsolete? New order lines will be refused." parameter-map="{productId:productId,statusId:'PrdObsolete',expectedStatusId:detail.effectiveStatusId}"/>
                                <container-dialog id="CloneProductDialog" condition="canEdit" button-text="Clone" icon="sym_o_content_copy" title="Clone ${product.productName}" width="640">
                                    <form-single name="CloneProduct" transition="clone">
                                        <field name="productId">
                                            <default-field>
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="newProductId">
                                            <default-field title="New ID" tooltip="Leave empty to have one generated">
                                                <text-line/>
                                            </default-field>
                                        </field>
                                        <field name="newProductName">
                                            <default-field title="New name">
                                                <text-line/>
                                            </default-field>
                                        </field>
                                        <field name="ownerPartyId">
                                            <default-field title="Owner">
                                                <drop-down allow-empty="true">
                                                    <list-options list="options.owners" key="${value}" text="${label}"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="copyCategories">
                                            <default-field title="">
                                                <check>
                                                    <option key="true" text="Categories"/>
                                                </check>
                                            </default-field>
                                        </field>
                                        <field name="copyFeatures">
                                            <default-field title="">
                                                <check>
                                                    <option key="true" text="Features"/>
                                                </check>
                                            </default-field>
                                        </field>
                                        <field name="copyDimensions">
                                            <default-field title="">
                                                <check>
                                                    <option key="true" text="Dimensions"/>
                                                </check>
                                            </default-field>
                                        </field>
                                        <field name="copyParties">
                                            <default-field title="">
                                                <check>
                                                    <option key="true" text="Parties"/>
                                                </check>
                                            </default-field>
                                        </field>
                                        <field name="copyAssociations">
                                            <default-field title="">
                                                <check>
                                                    <option key="true" text="Substitutes"/>
                                                </check>
                                            </default-field>
                                        </field>
                                        <field name="copyEquipment">
                                            <default-field title="">
                                                <check>
                                                    <option key="true" text="Equipment templates"/>
                                                </check>
                                            </default-field>
                                        </field>
                                        <field name="copyIdentifiers">
                                            <default-field title="">
                                                <check>
                                                    <option key="true" text="New internal identifiers (external codes require reassignment)"/>
                                                </check>
                                            </default-field>
                                        </field>
                                        <field name="copyContent">
                                            <default-field title="">
                                                <check>
                                                    <option key="true" text="Documents"/>
                                                </check>
                                            </default-field>
                                        </field>
                                        <field name="submitButton">
                                            <default-field title="Clone">
                                                <submit/>
                                            </default-field>
                                        </field>
                                        <field-layout>
                                            <field-row>
                                                <field-ref name="newProductId"/>
                                                <field-ref name="newProductName"/>
                                            </field-row>
                                            <field-ref name="ownerPartyId"/>
                                            <field-group title="Copy">
                                                <field-ref name="copyCategories"/>
                                                <field-ref name="copyFeatures"/>
                                                <field-ref name="copyDimensions"/>
                                                <field-ref name="copyParties"/>
                                                <field-ref name="copyAssociations"/>
                                                <field-ref name="copyEquipment"/>
                                                <field-ref name="copyIdentifiers"/>
                                                <field-ref name="copyContent"/>
                                            </field-group>
                                            <field-ref name="submitButton"/>
                                        </field-layout>
                                    </form-single>
                                </container-dialog>
                                <link url="deleteDraft" text="Delete unused draft" link-type="hidden-form-link" icon="sym_o_delete" btn-type="danger" condition="canEdit &amp;&amp; detail.effectiveStatusId === 'PrdDraft'"
                                        confirmation="Delete the unused draft ${product.productName} and its catalog rows?" parameter-map="{productId:productId}"/>
                            </button-menu>
                        </container>
                    </container>
                </container>
                <dashboard min-width="140" style="q-mb-sm">
                    <number-card title="Variants" value="${keyNumbers.variants}" icon="sym_o_grid_view" size="sm" link="Features?productId=${productId}" condition="virtualProduct"/>
                    <number-card title="Available kits" value="${detail.kitAvailable == null ? '—' : detail.kitAvailable}" icon="sym_o_package_2" size="sm" link="KitComponents?productId=${productId}" condition="kitProduct"/>
                    <number-card title="Categories" value="${keyNumbers.categories}" icon="sym_o_category" size="sm" link="Categories?productId=${productId}"/>
                    <number-card title="Identifiers" value="${keyNumbers.identifiers}" icon="sym_o_barcode" size="sm" link="Identifiers?productId=${productId}"/>
                    <number-card title="Documents" value="${keyNumbers.documents}" icon="sym_o_description" size="sm" link="Documents?productId=${productId}"/>
                </dashboard>
                <subscreens-panel id="ProductTabs" type="tab"/>
            </widgets>
        </section>
        <section name="Unavailable" condition="appRoot != 'Accounting' &amp;&amp; !productFound">
            <widgets>
                <container-box type="warning">
                    <box-header title="Not available"/>
                    <box-body>
                        <label text="Product ${productId} is not available: it does not exist, or it belongs to an organization you are not in." type="p"/>
                        <link url=".." text="Back to the product list" link-type="anchor"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
