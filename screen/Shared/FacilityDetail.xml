<!-- FacilityDetail (design-crosscut §3.10; design-warehouse §12 FacilityDetail; style-guide §3.3 Detail): one facility,
    mounted by Warehouse at Warehouse/Locations/FacilityDetail with the Warehouse context only
    (ironstone.warehouse.FacilityServices.get#FacilityDetail, which checks the user's facility scope). The header names the
    facility, its type, owner and state, with Edit facility (Mantle's store#Facility) for a facility administrator.
    Each tab is a file in FacilityDetail/ that reads what it shows when it renders alone, in the design's order by its
    menu index: Overview 1, Children 2, Locations 3, Products 4, Box types 5, Printers 6, Policies 7, Schedules 8,
    Files 9, Conversation 10. A tab added later (Policies, Box types, Printers) is a new file there with its menu index
    and its own transitions; it needs no change here. Manufacturing mounts it at Manufacturing/WorkCenters/FacilityDetail
    (impl-manufacturing P3) with its context (ironstone.manufacturing.WorkCenterServices.get#FacilityDetail): the same header
    without Edit facility, Overview, its own Work center tab (the WorkCenter extension, capacities, alternates, the rate
    with cost read only, and the load), Files and Conversation; the Warehouse tabs are Warehouse's only. The tab bar draws
    facilityTabs, the app's tabs, since a menu lists every subscreen. Maintenance mounts it at Maintenance/Facilities/FacilityDetail
    (design-maintenance §6, crosscut §3.10's Maintenance row; impl-maintenance P2, F22) with its context
    (ironstone.maintenance.FacilityServices.get#FacilityDetail): the header with Edit facility for a holder of FACILITY_EDIT
    (the time zone, capacity and booking too), Overview, Children, Rooms (with their dated features), Equipment, Certifications,
    Files and Conversation; Work orders join with P3 and Schedules with P15, and the Warehouse tabs are Warehouse's only. Edit
    facility checks the mounting app's own record check (Warehouse's or Maintenance's), then Mantle's store#Facility checks
    FACILITY_EDIT. Other apps add their contexts when they are built. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Facility"
        default-menu-include="false">
    <parameter name="facilityId" required="true"/>
    <!-- Maintenance (impl-maintenance P2): the parent a move under another facility would give it, whose effect is shown first -->
    <parameter name="moveToParentId"/>
    <!-- Insights (impl-insights P6): the record its InsightsRecord subscreen shows -->
    <always-actions><if condition="appRoot == 'Insights'"><set field="insightsRecordType" value="FacilityDetail"/><set field="insightsRecordId" from="facilityId"/></if></always-actions>
    <transition-include name="facilityChoices" location="component://mr-boss/template/WarehouseFacilityParts.xml"/>
    <!-- Maintenance's drop-downs (the parent, owner, type and time zone of Edit facility under Maintenance) -->
    <transition-include name="choices" location="component://mr-boss/template/MaintenanceParts.xml"/>
    <!-- the facility's identity and contact (Mantle's store#Facility checks FACILITY_EDIT, the owner and the parent cycle) -->
    <transition name="updateFacility">
        <actions>
            <!-- the mounting app's own record check (impl-maintenance F22): Maintenance's under Maintenance, Warehouse's otherwise -->
            <if condition="appRoot == 'Maintenance'"><then>
                <service-call name="ironstone.maintenance.AccessServices.check#Record"
                        in-map="{appRoot:appRoot, recordType:'facility', recordId:facilityId, capability:'facilityEdit'}"/>
            </then><else>
                <service-call name="ironstone.warehouse.AccessServices.check#Record"
                        in-map="{recordType:'facility', recordId:facilityId, capability:'facilityEdit'}"/>
            </else></if>
            <!-- the parent is removed only when the user emptied it; one left as it was (even one the user may not see) stays -->
            <set field="clearParent" from="!parentFacilityId &amp;&amp; !!originalParentFacilityId"/>
            <service-call name="mantle.facility.FacilityServices.store#Facility" in-map="context"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <subscreens default-item="Overview">
        <subscreens-item name="InsightsRecord" location="component://mr-boss/screen/Shared/InsightsRecord.xml" menu-include="false"/>
    </subscreens>
    <!-- Insights (appRoot Insights, mounted at Insights/Records/FacilityDetail; design-insights §10, crosscut's Insights row, impl-insights
        P6): read only, in place of the owners' contexts. The condition fails for Insights, so none of the actions and widgets
        below runs, and the fail-widgets show the InsightsRecord subscreen (template/InsightsRecord.xml): the record as the admitted datasets the viewer reads
        show it, the owners' screens of it that open to them, and the return to the report; no action. -->
    <condition><expression>appRoot != 'Insights'</expression></condition>
    <actions>
        <set field="detail" from="null"/>
        <if condition="appRoot == 'Warehouse'">
            <service-call name="ironstone.warehouse.FacilityServices.get#FacilityDetail"
                    in-map="{facilityId:facilityId}"
                    out-map="detail"
                    transaction="force-new"
                    ignore-error="true"/>
        </if>
        <if condition="appRoot == 'Manufacturing'">
            <service-call name="ironstone.manufacturing.WorkCenterServices.get#FacilityDetail"
                    in-map="{facilityId:facilityId}"
                    out-map="detail"
                    transaction="force-new"
                    ignore-error="true"/>
        </if>
        <if condition="appRoot == 'Maintenance'">
            <service-call name="ironstone.maintenance.FacilityServices.get#FacilityDetail"
                    in-map="{facilityId:facilityId}"
                    out-map="detail"
                    transaction="force-new"
                    ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <!-- the tabs of the app's context, in menu order: a Moqui Java menu lists every subscreen, so the tab bar draws this
            list; each tab screen's condition admits the same tabs by appRoot -->
        <set field="facilityTabs" from="appRoot == 'Manufacturing' ? ['Overview', 'WorkCenter', 'Files', 'Conversation']
                : appRoot == 'Maintenance' ? ['Overview', 'Children', 'Rooms', 'Equipment', 'Certifications', 'WorkOrders', 'Files', 'Conversation']
                : ['Overview', 'Children', 'Locations', 'Products', 'BoxTypes', 'Printers', 'Policies', 'Schedules', 'Files', 'Conversation']"/>
        <set field="recordFound" from="!!detail?.facility"/>
        <!-- Maintenance: what moving it under another facility changes, before Edit facility's store#Facility makes the move -->
        <set field="moveEffect" from="null"/>
        <if condition="appRoot == 'Maintenance' &amp;&amp; recordFound &amp;&amp; detail.canEdit &amp;&amp; moveToParentId">
            <service-call name="mantle.product.MaintenanceResourceServices.preview#MaintenanceFacilityChange" out-map="movePreview"
                    in-map="{facilityId:facilityId, parentFacilityId:moveToParentId}" transaction="force-new" ignore-error="true"/>
            <set field="moveRefusal" from="ec.message.hasError() ? ec.message.getErrorsString() : null"/>
            <script>ec.message.clearErrors()</script>
            <set field="moveEffect" from="movePreview?.effect || null"/>
        </if>
        <set field="moveRows" from="moveEffect ? [['Organization', moveEffect.organizationChanges ? moveEffect.organizationBefore + ' to ' +
                moveEffect.organizationAfter : moveEffect.organizationAfter], ['Time zone', moveEffect.timeZoneBefore == moveEffect.timeZoneAfter ?
                (moveEffect.timeZoneAfter || 'none') : (moveEffect.timeZoneBefore || 'none') + ' to ' + (moveEffect.timeZoneAfter || 'none')],
                ['Facilities inside that move with it', String(moveEffect.insideCount)], ['Equipment there', String(moveEffect.equipmentCount)],
                ['Bookings to come', String(moveEffect.bookingCount)]].map((r) =&gt; ({label: r[0], value: r[1]})) : []"/>
        <set field="moveValues" from="{facilityId: facilityId, parentFacilityId: moveToParentId || null,
                originalParentFacilityId: detail?.facility?.storedParentFacilityId || null}"/>
        <set field="facility" from="detail?.facility || {}"/>
        <set field="contact" from="detail?.contact || {}"/>
        <set field="editDefaults" from="Object.assign({}, contact, {facilityName: facility.facilityName,
                facilityTypeEnumId: facility.facilityTypeEnumId, parentFacilityId: facility.storedParentFacilityId,
                ownerPartyId: facility.ownerPartyId, description: facility.description,
                openedDate: facility.openedDate ? ec.l10n.format(facility.openedDate, 'yyyy-MM-dd') : null,
                closedDate: facility.closedDate ? ec.l10n.format(facility.closedDate, 'yyyy-MM-dd') : null,
                defaultDaysToShip: facility.defaultDaysToShip, timeZone: facility.storedTimeZone || null,
                capacity: facility.capacity, bookable: facility.bookableFlag || null})"/>
    </actions>
    <widgets>
        <section name="FacilityNotAvailable" condition="!recordFound">
            <widgets>
                <container-box type="warning">
                    <box-body>
                        <label text="This facility is not available in this app." type="p"/>
                        <link url="${sharedLinks['Locations/Facilities']}"
                                text="Facilities"
                                link-type="anchor"
                                icon="arrow_back"
                                condition="appRoot == 'Warehouse'"/>
                        <link url="${sharedLinks['WorkCenters/Centers']}"
                                text="Work centers"
                                link-type="anchor"
                                icon="arrow_back"
                                condition="appRoot == 'Manufacturing'"/>
                        <link url="${sharedLinks['Facilities/Find']}"
                                text="Facilities"
                                link-type="anchor"
                                icon="arrow_back"
                                condition="appRoot == 'Maintenance'"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="FacilityFound" condition="recordFound">
            <widgets>
                <context record-entity="mantle.facility.Facility" record-id="${facilityId}" title="${facility.facilityName}"/>
                <link url="${sharedLinks['Locations/Facilities']}" text="Facilities" link-type="anchor" icon="arrow_back"
                        condition="appRoot == 'Warehouse'"/>
                <link url="${sharedLinks['WorkCenters/Centers']}" text="Work centers" link-type="anchor" icon="arrow_back"
                        condition="appRoot == 'Manufacturing'"/>
                <link url="${sharedLinks['Facilities/Find']}" text="Facilities" link-type="anchor" icon="arrow_back"
                        condition="appRoot == 'Maintenance'"/>
                <container style="m-record-header">
                    <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                        <container style="col-12 col-md m-record-title">
                            <container style="row items-center no-wrap">
                                <render-mode>
                                    <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none q-mr-sm text-mono">${
                                        WebUtilities.encodeHtml(facility.facilityId)}</q-chip>]]></text>
                                    <text type="tui"><![CDATA[${JSON.stringify({t: "text", id: "FacilityKey", style: "strong",
                                        text: facility.facilityId})}]]></text>
                                </render-mode>
                                <label text="${facility.facilityName}" type="h5"/>
                            </container>
                            <label text="${[facility.typeText, facility.ownerName, facility.parentName ? 'inside ' +
                                facility.parentName : ''].filter(Boolean).join(' · ')}"
                                    type="p"
                                    style="text-caption q-mb-none"/>
                        </container>
                        <container style="col-12 col-md-auto m-record-status">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                                    facility.stateColor}">${facility.stateText}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", id: "FacilityState", style: "strong",
                                    text: facility.stateText})}]]></text>
                                <text type="html">${facility.stateText}</text>
                            </render-mode>
                        </container>
                    </container>
                    <container style="row items-center q-col-gutter-x-md q-col-gutter-y-sm m-record-foot">
                        <container style="col-12 col-md">
                            <label text="${[contact.addressText, facility.locationCount == null ? '' : facility.locationCount +
                                ' open locations', facility.isWorkCenter ? 'Work center' : '', facility.timeZoneText,
                                facility.capacity != null &amp;&amp; appRoot == 'Maintenance' ? 'holds ' + String(facility.capacity) : '',
                                facility.bookableText].filter(Boolean).join(' · ')}"
                                    type="p"
                                    style="q-mb-none"/>
                            <!-- Maintenance (impl-maintenance P5): its current state, from its one open outage -->
                            <link url="${sharedLinks['Equipment/Downtime']}" text="${facility.outage?.text}" link-type="anchor"
                                    style="text-negative" condition="appRoot == 'Maintenance' &amp;&amp; facility.outage"
                                    parameter-map="{resourceUnavailabilityId:facility.outage?.resourceUnavailabilityId}"/>
                        </container>
                        <container style="col-12 col-md-auto row items-center q-gutter-sm m-record-actions">
                            <!-- Maintenance (impl-maintenance P2): Move under another facility, its effect shown before it is made -->
                            <container-dialog id="MoveFacilityDialog" button-text="Move" title="${ec.l10n.localize('Move')} ${facility.facilityName}"
                                    icon="sym_o_drive_file_move" width="600" condition="appRoot == 'Maintenance' &amp;&amp; detail.canEdit">
                                <label text="Choose the facility it goes inside; what the move changes is shown before it is made." type="p"/>
                                <form-single name="MoveFacilityPreview" transition=".">
                                    <field name="facilityId" from="facilityId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="moveToParentId">
                                        <default-field title="Inside">
                                            <drop-down allow-empty="false">
                                                <dynamic-options transition="choices"
                                                        server-search="true"
                                                        min-length="0"
                                                        parameter-map="{choice:'parentFacilities', choiceFacilityId:facilityId,
                                                            selected:moveToParentId}"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="submitButton">
                                        <default-field title="">
                                            <submit text="Show what changes"/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </container-dialog>
                            <container-dialog id="EditFacilityDialog"
                                    button-text="Edit facility"
                                    title="${ec.l10n.localize('Edit')} ${facility.facilityName}"
                                    icon="sym_o_edit"
                                    width="760"
                                    type="primary"
                                    condition="detail.canEdit">
                                <form-single name="EditFacility" transition="updateFacility" map="editDefaults">
                                    <field name="facilityId" from="facilityId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="originalParentFacilityId" from="facility.storedParentFacilityId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="facilityName">
                                        <default-field title="Name">
                                            <text-line required="true"/>
                                        </default-field>
                                    </field>
                                    <field name="facilityTypeEnumId">
                                        <conditional-field condition="appRoot == 'Maintenance'" title="Type">
                                            <drop-down allow-empty="true">
                                                <dynamic-options transition="choices"
                                                        server-search="true"
                                                        min-length="0"
                                                        parameter-map="{choice:'facilityTypes', selected:facilityTypeEnumId}"/>
                                            </drop-down>
                                        </conditional-field>
                                        <default-field title="Type">
                                            <drop-down allow-empty="true">
                                                <dynamic-options transition="facilityChoices"
                                                        server-search="true"
                                                        min-length="0"
                                                        parameter-map="{choice:'facilityTypes', selected:facilityTypeEnumId}"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="parentFacilityId">
                                        <conditional-field condition="appRoot == 'Maintenance'" title="Inside"
                                                tooltip="Never itself or a facility inside it; Facilities shows what a move changes">
                                            <drop-down allow-empty="true">
                                                <dynamic-options transition="choices"
                                                        server-search="true"
                                                        min-length="0"
                                                        parameter-map="{choice:'parentFacilities', choiceFacilityId:facilityId,
                                                            selected:parentFacilityId}"/>
                                            </drop-down>
                                        </conditional-field>
                                        <default-field title="Inside" tooltip="Never itself or a facility inside it">
                                            <drop-down allow-empty="true">
                                                <dynamic-options transition="facilityChoices"
                                                        server-search="true"
                                                        min-length="0"
                                                        parameter-map="{choice:'parents', facilityId:facilityId,
                                                            selected:parentFacilityId}"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="ownerPartyId">
                                        <conditional-field condition="appRoot == 'Maintenance'" title="Owner">
                                            <drop-down allow-empty="false">
                                                <dynamic-options transition="choices"
                                                        server-search="true"
                                                        min-length="0"
                                                        parameter-map="{choice:'organizations', selected:ownerPartyId}"/>
                                            </drop-down>
                                        </conditional-field>
                                        <default-field title="Owner">
                                            <drop-down allow-empty="false">
                                                <dynamic-options transition="facilityChoices"
                                                        server-search="true"
                                                        min-length="0"
                                                        parameter-map="{choice:'owners', selected:ownerPartyId}"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <!-- Maintenance (impl-maintenance P2, F16): the time zone, people capacity and booking -->
                                    <field name="timeZone">
                                        <conditional-field condition="appRoot == 'Maintenance'" title="Time zone"
                                                tooltip="Empty takes the facility it is inside's">
                                            <drop-down allow-empty="true">
                                                <dynamic-options transition="choices"
                                                        server-search="true"
                                                        min-length="1"
                                                        parameter-map="{choice:'timeZones', selected:timeZone}"/>
                                            </drop-down>
                                        </conditional-field>
                                        <default-field>
                                            <ignored/>
                                        </default-field>
                                    </field>
                                    <field name="capacity">
                                        <conditional-field condition="appRoot == 'Maintenance'" title="Holds" tooltip="How many people it holds">
                                            <text-line size="5"/>
                                        </conditional-field>
                                        <default-field>
                                            <ignored/>
                                        </default-field>
                                    </field>
                                    <field name="bookable">
                                        <conditional-field condition="appRoot == 'Maintenance'" title="Bookable">
                                            <drop-down allow-empty="true">
                                                <option key="Y" text="Can be booked"/>
                                                <option key="N" text="Not bookable"/>
                                            </drop-down>
                                        </conditional-field>
                                        <default-field>
                                            <ignored/>
                                        </default-field>
                                    </field>
                                    <field name="openedDate">
                                        <default-field title="Opened">
                                            <date-time type="date"/>
                                        </default-field>
                                    </field>
                                    <field name="closedDate">
                                        <default-field title="Closed">
                                            <date-time type="date"/>
                                        </default-field>
                                    </field>
                                    <field name="defaultDaysToShip">
                                        <default-field title="Days to ship" tooltip="The default for its products">
                                            <text-line size="4"/>
                                        </default-field>
                                    </field>
                                    <field name="description">
                                        <default-field title="Description">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="address1">
                                        <default-field title="Address">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="address2">
                                        <default-field title="Address line 2">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="city">
                                        <default-field title="City">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="postalCode">
                                        <default-field title="Postal code">
                                            <text-line size="10"/>
                                        </default-field>
                                    </field>
                                    <field name="contactNumber">
                                        <default-field title="Phone">
                                            <text-line size="16"/>
                                        </default-field>
                                    </field>
                                    <field name="emailAddress">
                                        <default-field title="Email">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="changeReason">
                                        <default-field title="Reason" tooltip="Needed for a change of owner">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="submit">
                                        <default-field title="">
                                            <submit text="Save facility"/>
                                        </default-field>
                                    </field>
                                    <field-layout>
                                        <field-row>
                                            <field-ref name="facilityName"/>
                                            <field-ref name="facilityTypeEnumId"/>
                                        </field-row>
                                        <field-row>
                                            <field-ref name="ownerPartyId"/>
                                            <field-ref name="parentFacilityId"/>
                                        </field-row>
                                        <field-row>
                                            <field-ref name="openedDate"/>
                                            <field-ref name="closedDate"/>
                                        </field-row>
                                        <field-row>
                                            <field-ref name="defaultDaysToShip"/>
                                            <field-ref name="description"/>
                                        </field-row>
                                        <field-row>
                                            <field-ref name="timeZone"/>
                                            <field-ref name="capacity"/>
                                            <field-ref name="bookable"/>
                                        </field-row>
                                        <field-row>
                                            <field-ref name="address1"/>
                                            <field-ref name="address2"/>
                                        </field-row>
                                        <field-row>
                                            <field-ref name="city"/>
                                            <field-ref name="postalCode"/>
                                        </field-row>
                                        <field-row>
                                            <field-ref name="contactNumber"/>
                                            <field-ref name="emailAddress"/>
                                        </field-row>
                                        <field-ref name="changeReason"/>
                                        <field-ref name="submit"/>
                                    </field-layout>
                                </form-single>
                            </container-dialog>
                        </container>
                    </container>
                </container>
                <!-- Maintenance: the effect of the move asked for, and its confirmation (Edit facility's transition, store#Facility) -->
                <section name="MoveFacilityEffect" condition="appRoot == 'Maintenance' &amp;&amp; moveToParentId">
                    <widgets>
                        <container-box type="warning">
                            <box-header title="Move ${facility.facilityName}"/>
                            <box-body>
                                <label text="${moveRefusal}" type="p" style="text-negative" condition="moveRefusal"/>
                                <form-list name="MoveFacilityRows" list="moveRows" skip-form="true" skip-header="true" paginate="false"
                                        condition="moveRows.length">
                                    <field name="label">
                                        <default-field>
                                            <display style="m-muted"/>
                                        </default-field>
                                    </field>
                                    <field name="value">
                                        <default-field>
                                            <display/>
                                        </default-field>
                                    </field>
                                </form-list>
                                <form-single name="MoveFacility" transition="updateFacility" map="moveValues" condition="moveEffect">
                                    <field name="facilityId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="parentFacilityId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="originalParentFacilityId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="submitButton">
                                        <default-field title="">
                                            <submit text="Move it" confirmation="Move ${facility.facilityName}?"/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
                <!-- As in Moqui Java a menu lists every subscreen; the tabs here are facilityTabs, the app's. -->
                <section name="FacilityTabBar">
                    <actions>
                        <set field="facilityTabItems" from="Array.from(sri.getMenuItems() || []).filter(item =&gt; facilityTabs.includes(item.name))"/>
                    </actions>
                    <widgets>
                        <render-mode>
                            <text type="qvt"><![CDATA[<div id="FacilityTabs"><q-tabs dense no-caps align="left" narrow-indicator inline-label class="text-grey-7" active-color="primary" indicator-color="primary" :model-value="$root.currentPathList[$root.currentPathList.lastIndexOf('FacilityDetail') + 1]">${facilityTabItems.map(item => '<q-tab name="' + WebUtilities.encodeHtml(item.name) + '" label="' + WebUtilities.encodeHtml(item.title || item.name) + '" @click.prevent="$root.setUrl($root.getLinkPath(' + WebUtilities.encodeHtml(JSON.stringify(item.url)) + '))"></q-tab>').join('')}</q-tabs><q-separator class="q-mb-md"></q-separator></div>]]></text>
                        </render-mode>
                        <section name="FacilityTabLinks" condition="sri.getRenderMode() !== 'qvt'">
                            <widgets>
                                <container id="FacilityTabs" style="row q-gutter-xs q-mb-sm">
                                    <section-iterate name="FacilityTab" list="facilityTabItems" entry="tab">
                                        <widgets>
                                            <section name="FacilityTabActive" condition="tab.inPath">
                                                <widgets><link url="${tab.url}" url-type="plain" link-type="anchor-button" btn-type="primary" text="${tab.title || tab.name}"/></widgets>
                                                <fail-widgets><link url="${tab.url}" url-type="plain" link-type="anchor-button" text="${tab.title || tab.name}"/></fail-widgets>
                                            </section>
                                        </widgets>
                                    </section-iterate>
                                </container>
                            </widgets>
                        </section>
                    </widgets>
                </section>
                <subscreens-active/>
            </widgets>
        </section>
    </widgets>
