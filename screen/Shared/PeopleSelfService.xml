<!-- SelfService (design-people §3 SelfService, §1.2; style-guide §3.1 Landing; impl-people P8): an employee's own People page,
    one definition mounted at People/SelfService and at Commons/People/SelfService (out of both menus, reached from People Home,
    Commons Home's People card and Today). It fixes the current user's party: mantle.humanres.PeopleServices.get#SelfService takes
    no party, so nothing supplied here reads another person. MySummary: the user's current and coming employments (employer, job
    title, department, manager, work location, dates, state) and the counts of their open requests and People tasks; My tasks: the
    open People tasks assigned to them (find#DueWork's myTask, a protected task about them left out); MyRequests: the People
    requests they made, with their state, who decides next and a refusal's reason (find#MyRequests); Emergency contacts: theirs,
    added, changed and ended here (template/PeopleEmergencyContacts.xml). Open my employee record is the primary action (their
    Employee360 under People for a People user, else under Commons). A self-service employee without People opens it under either
    root by its own grant (BOSS_PPL_SELF, non-inheritable, data/BossSetupData.xml); every other People screen stays refused to them.
    P10: My time (the user's own week, People's time area) and the missing-week card, the user's own weeks to submit
    (get#SelfService's weeksToSubmit, the rule of Projects' Today), opening the oldest in My time. P11: My leave balances, the user's own
    (mantle.humanres.LeaveServices.get#MyBalances, which takes no party), each leave type's balance and what is available, by the
    policy in effect. P12: My leave requests, the user's own newest (mantle.humanres.LeaveServices.find#Requests with mine: days, leave
    type, what each charges and its state, never a reason), each opening LeaveRequestDetail, and Request leave (People's Leave
    requests, when the time area opens to them). P13: the Clock (template/PeopleClock.xml: the user's own employments with clocking
    on, mantle.humanres.AttendanceServices get#MyClock and record#Punch, which take no party; the worker is the session's), shown only
    where an employment has clocking on, and then the page's primary action in place of Open my employee record (design §3
    SelfService); My attendance links People's Attendance. P14: My shifts, the user's own published shifts of the next two weeks
    (mantle.humanres.ScheduleServices.get#MyShifts, which takes no party), shown when they have any, linking the team calendar.
    P15: My expenses and My advances link People's Expense claims and Advances (the expenses area's own grant). P16 review (the
    user's call of Nov 12, 2026): My interviews, the interviews the user is on the panel of (mantle.humanres.RecruitingServices
    find#MyInterviews, which takes no party), shown when they have any, each opening MyInterview beside this screen, where they read
    the applicant's name, the opening and what the recruiter shared with the panel and answer their scorecard; the scorecards to
    submit counted in the summary. P18: My qualifications links People's Qualifications (their own, when the Skills and training
    area opens to them), where they submit a certificate or document for verification; P19 review: My training links People's
    Training (their own places, the same area). P17 review (the user's call of Nov 12, 2026):
    My letters, the issued lifecycle letters addressed to the user (a hire's confirmation, a transfer, a separation and the like:
    mantle.humanres.PeopleServices find#MyLetters, which takes no party), shown when they have any, each opened as it was stored,
    whole, pay included (get#MyLetter refuses another person's letter as a missing one). P30 review (the user's call of Nov 12,
    2026): My clocking badge, the user's own badges in use (mantle.humanres.AttendanceServices get#MyKioskBadges, which takes no
    party), shown when they have any, where they set their own PIN (set#MyKioskPin: the one-time PIN HR gave, if any, or the PIN they
    have) before the badge works at a kiosk, and change it any time; HR never learns it. P26: My payslips, the user's own issued slips
    (mantle.humanres.PayrollResultServices find#Payslips with mine: never a preview, a slip not issued or another person's), shown
    when they have any, each opening MyPayslip beside this screen (none in this build outside a live payroll: pay groups are in preview
    mode, design §5 Q3); the net is opted out of AI. P26 review (the user's call of Nov 12, 2026): their own legacy pay history in the
    same list, labelled historical, opening the record read only by its key (MyPayslip with legacyKey). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Self-service" default-menu-include="false" menu-image="sym_o_person" menu-image-type="icon">

    <transition-include name="storeEmergencyContact" location="component://mr-boss/template/PeopleEmergencyContacts.xml"/>
    <!-- P13: the clock (record#Punch, the user's own) -->
    <transition-include name="clock" location="component://mr-boss/template/PeopleClock.xml"/>
    <!-- P17 review: one of the user's own issued letters, as it was stored (Mantle admits the caller's own alone) -->
    <transition name="myLetter" read-only="true">
        <parameter name="employmentLetterId"/>
        <actions>
            <service-call name="mantle.humanres.PeopleServices.get#MyLetter" out-map="letterFound"
                    in-map="{employmentLetterId:employmentLetterId}"/>
            <!-- the file is read as Mantle admitted it: the self-service grant does not reach the content store -->
            <script>if (!ec.message.hasError()) {
                const was = ec.artifactExecution.disableAuthz()
                try { ec.web.sendResourceResponse(letterFound.letter.location, true, letterFound.letter.fileName) } finally { if (!was) ec.artifactExecution.enableAuthz() }
            }</script>
        </actions>
        <default-response type="none"/>
        <error-response url="."/>
    </transition>

    <!-- P30 review: the user's own badge PIN, set or changed (Mantle admits the caller's own badge alone and asks the PIN they have);
        both fields are named with "password", which the framework never echoes or keeps after an error -->
    <transition name="setMyPin">
        <actions>
            <service-call name="mantle.humanres.AttendanceServices.set#MyKioskPin"
                    in-map="{kioskBadgeId:kioskBadgeId, currentPin:(currentPassword || null), newPin:(newPassword || null)}"/>
            <if condition="!ec.message.hasError()"><message type="success">Your clocking PIN is set</message></if>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <service-call name="ironstone.people.ContextServices.get#SelfServiceContext" out-map="links" transaction="force-new"
                ignore-error="true" in-map="{appRoot:appRoot}"/>
        <service-call name="mantle.humanres.PeopleServices.get#SelfService" out-map="self" transaction="force-new"
                ignore-error="true" in-map="{checkOnly:true}"/>
        <script>ec.message.clearErrors()</script>
        <set field="available" from="!!self?.available"/>
        <if condition="available">
            <service-call name="mantle.humanres.PeopleServices.find#MyRequests" out-map="requestsFound" transaction="force-new"
                    ignore-error="true" in-map="{pageSize:10}"/>
            <service-call name="mantle.humanres.PeopleServices.find#DueWork" out-map="tasksFound" transaction="force-new"
                    ignore-error="true" in-map="{kinds:'myTask', pageSize:20}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <script><![CDATA[
            employmentRows = Array.from(self?.employments || [])
            stateColors = {current: 'positive', future: 'primary', ended: 'grey-8'}
            requestRows = Array.from(requestsFound?.requests || [])
            requestMoreText = requestsFound && requestsFound.requestsCount > requestRows.length
                ? 'The newest ' + requestRows.length + ' of ' + requestsFound.requestsCount + '.' : ''
            requestColors = {PapPending: 'warning', PapApproved: 'positive', PapRefused: 'negative', PapSuperseded: 'grey-8'}
            taskRows = Array.from(tasksFound?.dueWork || [])
            openRequestText = String(self?.openRequestCount || 0)
            openTaskText = String(self?.openTaskCount || 0)
            // P10: the user's own weeks to submit, the oldest opened in My time
            weekRows = Array.from(self?.weeksToSubmit || [])
            weeksText = String(weekRows.length)
            weekLink = links?.myTimeUrl ? links.myTimeUrl + (weekRows.length ? '?weekDate=' + encodeURIComponent(weekRows[0].weekStart) : '') : null
            // the emergency contacts: the user's own, which they change here (Mantle checks again)
            contactOwnerPartyId = self?.partyId || null
            contactOwnerName = self?.personName || ''
            contactOpenedEmploymentId = null
            contactRows = Array.from(self?.emergencyContacts || [])
            canEditContacts = available
            titleText = self?.preferredName ? self.personName + ' (' + self.preferredName + ')' : (self?.personName || '')
        ]]></script>
        <!-- P11: the user's own leave balances (self scope: get#MyBalances takes no party) -->
        <if condition="available">
            <service-call name="mantle.humanres.LeaveServices.get#MyBalances" out-map="leaveFound" transaction="force-new" ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="leaveRows" from="Array.from(leaveFound?.balances || [])"/>
        <!-- P12: the user's own leave requests, newest first -->
        <if condition="available">
            <service-call name="mantle.humanres.LeaveServices.find#Requests" out-map="leaveRequestsFound" transaction="force-new"
                    ignore-error="true" in-map="{mine:true, pageSize:5}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="leaveRequestRows" from="Array.from(leaveRequestsFound?.requests || [])"/>
        <set field="leaveRequestColors" from="{LrsRequested: 'warning', LrsApproved: 'positive', LrsRefused: 'negative', LrsWithdrawn: 'grey-8',
                LrsCancelRequested: 'warning', LrsCancelled: 'grey-8'}"/>
        <set field="leaveEmployers" from="new Set(leaveRows.map(row => row.organizationPartyId)).size"/>
        <!-- P13: the user's own clock (get#MyClock takes no party); clocking makes the clock the primary action -->
        <if condition="available">
            <service-call name="mantle.humanres.AttendanceServices.get#MyClock" out-map="myClock" transaction="force-new" ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="clocking" from="!!myClock?.clocking"/>
        <!-- P14: the user's own published shifts of the next two weeks (get#MyShifts takes no party) -->
        <if condition="available">
            <service-call name="mantle.humanres.ScheduleServices.get#MyShifts" out-map="myShifts" transaction="force-new" ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="shiftRows" from="Array.from(myShifts?.shifts || [])"/>
        <set field="shiftEmployers" from="new Set(shiftRows.map(row => row.organizationPartyId)).size"/>
        <!-- P16 review: the interviews the user is on the panel of (find#MyInterviews takes no party) -->
        <if condition="available">
            <service-call name="mantle.humanres.RecruitingServices.find#MyInterviews" out-map="myInterviews" transaction="force-new" ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="interviewRows" from="Array.from(myInterviews?.interviews || [])"/>
        <!-- P17 review: the user's own issued lifecycle letters (find#MyLetters takes no party) -->
        <if condition="available">
            <service-call name="mantle.humanres.PeopleServices.find#MyLetters" out-map="myLetters" transaction="force-new" ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="letterRows" from="Array.from(myLetters?.letters || [])"/>
        <set field="letterEmployers" from="new Set(letterRows.map(row => row.organizationPartyId)).size"/>
        <set field="scorecardsText" from="String(myInterviews?.toAnswerCount || 0)"/>
        <!-- P26: the user's own issued payslips, newest first (find#Payslips with mine never widens past them) -->
        <if condition="available">
            <service-call name="mantle.humanres.PayrollResultServices.find#Payslips" out-map="myPayslips" transaction="force-new"
                    ignore-error="true" in-map="{mine:true, pageSize:6}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="payslipRows" from="Array.from(myPayslips?.payslips || [])"/>
        <set field="payslipEmployers" from="new Set(payslipRows.map(row => row.organizationPartyId)).size"/>
        <!-- P30 review: the user's own clocking badges (get#MyKioskBadges takes no party) -->
        <if condition="available">
            <service-call name="mantle.humanres.AttendanceServices.get#MyKioskBadges" out-map="myBadges" transaction="force-new" ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <script><![CDATA[
            badgeRows = Array.from(myBadges?.badges || [])
            badgeEmployers = new Set(badgeRows.map(row => row.organizationPartyId)).size
            badgeChoices = badgeRows.map(row => ({kioskBadgeId: row.kioskBadgeId, text: row.organizationName + ': ' + (row.pinSet ? 'change my PIN' : 'set my PIN')}))
            badgeNeedsPin = badgeRows.some(row => !row.pinSet)
            pinValues = {kioskBadgeId: badgeRows.find(row => !row.pinSet)?.kioskBadgeId || badgeRows[0]?.kioskBadgeId || null}
        ]]></script>
    </actions>

    <widgets>
        <section name="SelfServiceMissing" condition="!available">
            <widgets>
                <container-box type="warning">
                    <box-header title="Not available"/>
                    <box-body>
                        <label type="p" text="Self-service is not available to you: it is for employees whose account has People self-service."/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="SelfServicePage" condition="available">
            <widgets>
                <container style="m-record-header">
                    <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                        <container style="col-12 col-md m-record-title">
                            <label text="${titleText}" type="h5"/>
                            <label text="Your employment, your requests and the people to call in an emergency." type="p"
                                    style="text-caption m-muted q-mb-none"/>
                        </container>
                        <container style="col-12 col-md-auto row items-center q-gutter-sm m-record-actions">
                            <link url="${links.employee360Url}" url-type="plain" text="Open my employee record" link-type="anchor-button"
                                    btn-type="primary" icon="sym_o_badge" condition="links?.employee360Url &amp;&amp; !clocking"/>
                            <!-- P13: with clocking on the clock below is the primary action -->
                            <link url="${links.employee360Url}" url-type="plain" text="Open my employee record" link-type="anchor-button"
                                    icon="sym_o_badge" condition="links?.employee360Url &amp;&amp; clocking"/>
                            <link url="${links.approvalsUrl}" url-type="plain" text="Approvals" link-type="anchor-button"
                                    icon="sym_o_approval" condition="links?.approvalsUrl"/>
                            <link url="${links.myTimeUrl}" url-type="plain" text="My time" link-type="anchor-button"
                                    icon="sym_o_schedule" condition="links?.myTimeUrl"/>
                            <!-- P12 -->
                            <link url="${links.leaveRequestsUrl}?request=Y" url-type="plain" text="Request leave" link-type="anchor-button"
                                    icon="sym_o_event_busy" condition="links?.leaveRequestsUrl"/>
                            <!-- P13 -->
                            <link url="${links.attendanceUrl}" url-type="plain" text="My attendance" link-type="anchor-button"
                                    icon="sym_o_fact_check" condition="links?.attendanceUrl"/>
                            <!-- P15: their expense claims and advances (People's expenses area) -->
                            <link url="${links.expenseClaimsUrl}" url-type="plain" text="My expenses" link-type="anchor-button"
                                    icon="sym_o_receipt_long" condition="links?.expenseClaimsUrl"/>
                            <link url="${links.advancesUrl}" url-type="plain" text="My advances" link-type="anchor-button"
                                    icon="sym_o_payments" condition="links?.advancesUrl"/>
                            <!-- P18 -->
                            <link url="${links.qualificationsUrl}" url-type="plain" text="My qualifications" link-type="anchor-button"
                                    icon="sym_o_workspace_premium" condition="links?.qualificationsUrl"/>
                            <!-- P19 review: their own training places (Training's Mine) -->
                            <link url="${links.trainingUrl}" url-type="plain" text="My training" link-type="anchor-button"
                                    icon="sym_o_school" condition="links?.trainingUrl"/>
                            <!-- P21: their confidential cases, and filing one -->
                            <link url="${links.grievancesUrl}" url-type="plain" text="Raise a concern" link-type="anchor-button"
                                    icon="sym_o_shield_person" condition="links?.grievancesUrl"/>
                            <!-- P20: their own reviews and goals -->
                            <link url="${links.reviewsUrl}" url-type="plain" text="My reviews" link-type="anchor-button"
                                    icon="sym_o_rate_review" condition="links?.reviewsUrl"/>
                            <link url="${links.goalsUrl}" url-type="plain" text="My goals" link-type="anchor-button"
                                    icon="sym_o_flag" condition="links?.goalsUrl"/>
                        </container>
                    </container>
                </container>

                <!-- P13: the Clock, where an employment has clocking on -->
                <section-include name="Clock" location="component://mr-boss/template/PeopleClock.xml"/>

                <!-- MySummary: the counts, and each employment the user has (several need a visible choice) -->
                <dashboard min-width="160">
                    <number-card title="Open requests" value="${openRequestText}" icon="sym_o_pending_actions" size="sm"/>
                    <number-card title="My People tasks" value="${openTaskText}" icon="sym_o_task_alt" size="sm"/>
                    <!-- P10: the missing-week card -->
                    <number-card title="Weeks to submit" value="${weeksText}" icon="sym_o_schedule_send" size="sm" link="${weekLink}"
                            condition="weekLink"/>
                    <number-card title="Weeks to submit" value="${weeksText}" icon="sym_o_schedule_send" size="sm" condition="!weekLink &amp;&amp; weekRows.length"/>
                    <!-- P16 review: the interview scorecards the user has to submit -->
                    <number-card title="Scorecards to submit" value="${scorecardsText}" icon="sym_o_rate_review" size="sm"
                            condition="interviewRows.length"/>
                </dashboard>
                <container-box>
                    <box-header title="My employment"/>
                    <box-body-nopad>
                        <form-list name="MyEmployments" list="employmentRows" skip-form="true" paginate="false" condition="employmentRows.length">
                            <field name="organizationName"><default-field title="Employer"><display/></default-field></field>
                            <field name="jobTitle"><default-field title="Job title"><display/></default-field></field>
                            <field name="departmentName"><default-field title="Department"><display/></default-field></field>
                            <field name="managerName"><default-field title="Manager"><display/></default-field></field>
                            <field name="workLocation"><default-field title="Work location"><display/></default-field></field>
                            <field name="fromDateText"><default-field title="Since"><display/></default-field></field>
                            <field name="stateText">
                                <default-field title="State">
                                    <render-mode>
                                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColors[state] || 'grey-8'}">${
                                            WebUtilities.encodeHtml(onLeave ? 'On leave' : stateText)}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: onLeave ? "On leave" : stateText})}]]></text>
                                        <text type="html">${onLeave ? 'On leave' : stateText}</text>
                                    </render-mode>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="organizationName"/><field-ref name="jobTitle"/></column>
                                <column><field-ref name="stateText"/><field-ref name="managerName"/></column>
                            </columns>
                        </form-list>
                        <label text="You have no current employment." type="p" style="m-muted q-pa-md" condition="!employmentRows.length"/>
                    </box-body-nopad>
                </container-box>

                <!-- P16 review: My interviews, those the user is on the panel of, each opening their interview and scorecard -->
                <section name="MyInterviewsSection" condition="interviewRows.length">
                    <widgets>
                        <container-box>
                            <box-header title="My interviews"/>
                            <box-body-nopad>
                                <form-list name="MyInterviews" list="interviewRows" skip-form="true" paginate="false">
                                    <field name="whenText">
                                        <default-field title="When">
                                            <link url="../MyInterview" text="${whenText}" link-type="anchor" parameter-map="{workEffortId:workEffortId}"/>
                                        </default-field>
                                    </field>
                                    <field name="applicantName"><default-field title="Applicant"><display/></default-field></field>
                                    <field name="openingTitle"><default-field title="Opening"><display/></default-field></field>
                                    <field name="scorecardText">
                                        <conditional-field condition="toAnswer" title="Scorecard"><label text="${scorecardText}" style="text-warning text-no-wrap"/></conditional-field>
                                        <default-field title="Scorecard"><label text="${scorecardText}" style="text-no-wrap"/></default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column><field-ref name="whenText"/><field-ref name="applicantName"/></column>
                                        <column><field-ref name="scorecardText"/></column>
                                    </columns>
                                </form-list>
                            </box-body-nopad>
                        </container-box>
                    </widgets>
                </section>

                <!-- My tasks: the open People tasks assigned to the user, each opened as a task in Commons -->
                <container-box>
                    <box-header title="My People tasks"/>
                    <box-body-nopad>
                        <form-list name="MyTasks" list="taskRows" skip-form="true" paginate="false" condition="taskRows.length">
                            <field name="title">
                                <default-field title="Task">
                                    <link url="/qapps/Commons/Tasks/TaskDetail" url-type="plain" text="${title}" link-type="anchor"
                                            parameter-map="{workEffortId:workEffortId}"/>
                                </default-field>
                            </field>
                            <field name="personName"><default-field title="For"><display/></default-field></field>
                            <field name="whenText">
                                <conditional-field condition="overdue" title="Due"><label text="${whenText}" style="text-warning text-no-wrap"/></conditional-field>
                                <default-field title="Due"><label text="${whenText}" style="text-no-wrap"/></default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="title"/><field-ref name="personName"/></column>
                                <column><field-ref name="whenText"/></column>
                            </columns>
                        </form-list>
                        <label text="No People task is yours to do." type="p" style="m-muted q-pa-md" condition="!taskRows.length"/>
                    </box-body-nopad>
                </container-box>

                <!-- MyRequests: the requests the user made in People -->
                <container-box>
                    <box-header title="My requests"/>
                    <box-body-nopad>
                        <form-list name="MyRequests" list="requestRows" skip-form="true" paginate="false" condition="requestRows.length">
                            <field name="summary"><default-field title="Request"><display/></default-field></field>
                            <field name="kindText"><default-field title="Kind"><display/></default-field></field>
                            <field name="requestedDateText"><default-field title="Asked"><display/></default-field></field>
                            <field name="statusText">
                                <default-field title="State">
                                    <render-mode>
                                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${requestColors[statusId] || 'grey-8'}">${
                                            WebUtilities.encodeHtml(statusText)}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: statusText})}]]></text>
                                        <text type="html">${statusText}</text>
                                    </render-mode>
                                </default-field>
                            </field>
                            <field name="nextApproverText"><default-field title="Waiting for"><display/></default-field></field>
                            <field name="returnReason"><default-field title="Reason"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="summary"/><field-ref name="requestedDateText"/></column>
                                <column><field-ref name="statusText"/><field-ref name="nextApproverText"/></column>
                            </columns>
                        </form-list>
                        <label text="${requestMoreText}" type="p" style="text-caption m-muted q-px-md" condition="requestMoreText"/>
                        <label text="Requests you make in People show here with their state." type="p" style="m-muted q-pa-md"
                                condition="!requestRows.length"/>
                    </box-body-nopad>
                </container-box>

                <!-- P11: My leave balances: each leave type's balance and what is available now, by the policy in effect -->
                <container-box>
                    <box-header title="My leave balances"/>
                    <box-body-nopad>
                        <form-list name="MyLeaveBalances" list="leaveRows" skip-form="true" paginate="false" condition="leaveRows.length">
                            <field name="leaveTypeText"><default-field title="Leave"><display/></default-field></field>
                            <field name="organizationName" hide="leaveEmployers &lt; 2"><default-field title="Employer"><display/></default-field></field>
                            <field name="available" align="right">
                                <default-field title="Available"><display text="${available} ${unitText.toLowerCase()}"/></default-field>
                            </field>
                            <field name="balance" align="right">
                                <default-field title="Balance" tooltip="Granted, accrued and adjusted, less what was taken and what expired">
                                    <display text="${balance} ${unitText.toLowerCase()}"/></default-field>
                            </field>
                            <field name="policyName"><default-field title="Policy"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="leaveTypeText"/><field-ref name="policyName"/></column>
                                <column><field-ref name="available"/></column>
                            </columns>
                        </form-list>
                        <label text="No leave policy applies to you yet: HR assigns one with your entitlement." type="p" style="m-muted q-pa-md"
                                condition="!leaveRows.length"/>
                    </box-body-nopad>
                </container-box>

                <!-- P12: My leave requests, the newest, each opening the request -->
                <container-box>
                    <box-header title="My leave requests"/>
                    <box-toolbar>
                        <link url="${links.leaveRequestsUrl}" url-type="plain" text="All my requests" link-type="anchor"
                                condition="links?.leaveRequestsUrl"/>
                    </box-toolbar>
                    <box-body-nopad>
                        <form-list name="MyLeaveRequests" list="leaveRequestRows" skip-form="true" paginate="false" condition="leaveRequestRows.length">
                            <field name="datesText">
                                <conditional-field condition="links?.leaveRequestsUrl" title="Days">
                                    <link url="/qapps/People/Time/LeaveRequestDetail" url-type="plain" link-type="anchor"
                                            text="${datesText}${partText ? ' (' + partText.toLowerCase() + ')' : ''}" parameter-map="{leaveRequestId:leaveRequestId}"/>
                                </conditional-field>
                                <default-field title="Days"><display text="${datesText}${partText ? ' (' + partText.toLowerCase() + ')' : ''}"/></default-field>
                            </field>
                            <field name="leaveTypeText"><default-field title="Leave"><display/></default-field></field>
                            <field name="chargedText" align="right"><default-field title="Charged"><display/></default-field></field>
                            <field name="statusText">
                                <default-field title="State">
                                    <render-mode>
                                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${leaveRequestColors[statusEnumId] || 'grey-8'}">${
                                            WebUtilities.encodeHtml(statusText)}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: statusText})}]]></text>
                                        <text type="html">${statusText}</text>
                                    </render-mode>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="datesText"/><field-ref name="leaveTypeText"/></column>
                                <column><field-ref name="statusText"/></column>
                            </columns>
                        </form-list>
                        <label text="No leave asked for yet." type="p" style="m-muted q-pa-md" condition="!leaveRequestRows.length"/>
                    </box-body-nopad>
                </container-box>

                <!-- P14: My shifts, the user's published shifts of the next two weeks, shown when they have any -->
                <section name="MyShiftsSection" condition="shiftRows.length">
                    <widgets>
                        <container-box>
                            <box-header title="My shifts"/>
                            <box-toolbar>
                                <link url="${links.teamCalendarUrl}" url-type="plain" text="Team calendar" link-type="anchor"
                                        condition="links?.teamCalendarUrl"/>
                            </box-toolbar>
                            <box-body-nopad>
                                <form-list name="MyShifts" list="shiftRows" skip-form="true" paginate="false">
                                    <field name="whenText"><default-field title="When"><display/></default-field></field>
                                    <field name="hoursText" align="right"><default-field title="Hours"><display/></default-field></field>
                                    <field name="organizationName" hide="shiftEmployers &lt; 2"><default-field title="Employer"><display/></default-field></field>
                                    <field name="facilityName"><default-field title="Work location"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="whenText"/><field-ref name="facilityName"/></column>
                                        <column><field-ref name="hoursText"/></column>
                                    </columns>
                                </form-list>
                            </box-body-nopad>
                        </container-box>
                    </widgets>
                </section>

                <!-- P17 review: My letters, the user's own issued lifecycle letters, shown when they have any -->
                <section name="MyLettersSection" condition="letterRows.length">
                    <widgets>
                        <container-box>
                            <box-header title="My letters"/>
                            <box-body-nopad>
                                <form-list name="MyLetters" list="letterRows" skip-form="true" paginate="false">
                                    <field name="title">
                                        <default-field title="Letter">
                                            <link url="myLetter" text="${title}" link-type="anchor" target-window="_blank"
                                                    parameter-map="{employmentLetterId:employmentLetterId}"/>
                                        </default-field>
                                    </field>
                                    <field name="organizationName" hide="letterEmployers &lt; 2"><default-field title="Employer"><display/></default-field></field>
                                    <field name="issuedDateText"><default-field title="Issued"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="title"/></column>
                                        <column><field-ref name="issuedDateText"/></column>
                                    </columns>
                                </form-list>
                            </box-body-nopad>
                        </container-box>
                    </widgets>
                </section>

                <!-- P26: My payslips, the user's own issued slips, shown when they have any, each opening their payslip -->
                <section name="MyPayslipsSection" condition="payslipRows.length">
                    <widgets>
                        <container-box>
                            <box-header title="My payslips"/>
                            <box-body-nopad>
                                <form-list name="MyPayslips" list="payslipRows" skip-form="true" paginate="false">
                                    <field name="payDateText">
                                        <default-field title="Pay date">
                                            <link url="../MyPayslip" text="${payDateText}" link-type="anchor" parameter-map="{payslipId:payslipId, legacyKey:legacyKey}"/>
                                        </default-field>
                                    </field>
                                    <field name="periodText"><default-field title="Period"><display/></default-field></field>
                                    <field name="kindText">
                                        <conditional-field condition="correctsPayslipId" title="Kind"><display text="Correction"/></conditional-field>
                                        <conditional-field condition="historical" title="Kind"><display text="Historical (read only)"/></conditional-field>
                                        <default-field title="Kind"><display/></default-field>
                                    </field>
                                    <field name="organizationName" hide="payslipEmployers &lt; 2"><default-field title="Employer"><display/></default-field></field>
                                    <field name="netText" align="right" ai-opt-out="true"><default-field title="Net"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="payDateText"/><field-ref name="periodText"/></column>
                                        <column><field-ref name="netText"/></column>
                                    </columns>
                                </form-list>
                            </box-body-nopad>
                        </container-box>
                    </widgets>
                </section>

                <!-- P30 review: My clocking badge, the user's own badges in use, shown when they have any: their PIN set or changed here -->
                <section name="MyBadgeSection" condition="badgeRows.length">
                    <widgets>
                        <container-box>
                            <box-header title="My clocking badge"/>
                            <box-toolbar>
                                <container-dialog id="SetMyPinDialog" button-text="${badgeNeedsPin ? 'Set my PIN' : 'Change my PIN'}" icon="sym_o_password"
                                        width="480" title="My clocking badge PIN">
                                    <label type="p" text="Your PIN is yours alone: 4 to 8 digits you type with your badge at a clocking kiosk. HR never sees it."/>
                                    <form-single name="SetMyPin" transition="setMyPin" map="pinValues">
                                        <field name="kioskBadgeId">
                                            <conditional-field condition="badgeRows.length &gt; 1" title="Badge">
                                                <drop-down allow-empty="false"><list-options list="badgeChoices" key="${kioskBadgeId}" text="${text}"/></drop-down>
                                            </conditional-field>
                                            <default-field><hidden/></default-field>
                                        </field>
                                        <field name="currentPassword">
                                            <default-field title="Current PIN" tooltip="The PIN you use now, or the one-time PIN HR gave you; empty if HR gave you none and you have not set one">
                                                <password size="8" maxlength="8"/></default-field>
                                        </field>
                                        <field name="newPassword">
                                            <default-field title="New PIN" tooltip="4 to 8 digits, not the one-time PIN HR gave you"><password size="8" maxlength="8"/></default-field>
                                        </field>
                                        <field name="submitButton"><default-field title=""><submit text="Save my PIN"/></default-field></field>
                                    </form-single>
                                </container-dialog>
                            </box-toolbar>
                            <box-body-nopad>
                                <form-list name="MyBadges" list="badgeRows" skip-form="true" paginate="false">
                                    <field name="organizationName" hide="badgeEmployers &lt; 2"><default-field title="Employer"><display/></default-field></field>
                                    <field name="stateText"><default-field title="State"><display/></default-field></field>
                                    <field name="pinSetText"><default-field title="PIN set"><display/></default-field></field>
                                    <field name="lastUsedText"><default-field title="Last used"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="stateText"/><field-ref name="organizationName"/></column>
                                        <column><field-ref name="lastUsedText"/></column>
                                    </columns>
                                </form-list>
                            </box-body-nopad>
                        </container-box>
                    </widgets>
                </section>

                <section-include name="EmergencyContacts" location="component://mr-boss/template/PeopleEmergencyContacts.xml"/>
            </widgets>
        </section>
    </widgets>
</screen>
