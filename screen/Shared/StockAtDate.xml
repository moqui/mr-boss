<!-- StockAtDate (design-warehouse §14 StockAtDate, design-crosscut §3.26; style-guide §3.12 Report): the stock on hand at
    the end of a past day, kept apart from today's availability and from promises. StockDateFind chooses the cut-off and
    opening days (calendar days in the user's zone), product, facility, location, lot and owner; the Places tab (StockRows)
    gives each place's opening, receipts, issues, adjustments, moves and closing with the totals of each unit; the History tab
    (StockHistory) the movements of the period with their effective and recorded dates, source document and the place's
    balance after each. History from before a facility's first movement is labelled incomplete, its quantities unknown,
    never zero. Both tabs export with the find's filters. No quantity change, cost or promise. Its one service is Mantle's
    mantle.product.InventoryReportServices.get#InventoryAtDate; Warehouse mounts it at Warehouse/Reports/StockAtDate with the
    Warehouse context (ironstone.warehouse.ReportServices.get#StockAtDate: the user's facilities, Warehouse links). Customer
    Service adds its context when it is built. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Stock at date"
        default-menu-index="2">
    <parameter name="asOfDate"/>
    <parameter name="fromDate"/>
    <parameter name="productId"/>
    <parameter name="facilityId"/>
    <parameter name="locationSeqId"/>
    <parameter name="lotId"/>
    <parameter name="ownerPartyId"/>
    <always-actions>
        <!-- the selected facility until the find names one or clears it (every facility); each tab reads the report -->
        <set field="reportFacilityId" from="facilityId == null ? (warehouse?.facilityId || null) : (facilityId || null)"/>
    </always-actions>
    <transition-include name="choices" location="component://mr-boss/template/WarehouseParts.xml"/>
    <transition-include name="inventoryChoices" location="component://mr-boss/template/WarehouseInventoryParts.xml"/>
    <transition-include name="reportChoices" location="component://mr-boss/template/WarehouseReportParts.xml"/>
    <subscreens default-item="Places"/>
    <actions>
        <set field="options" from="{asOfDate:asOfDate, fromDate:fromDate, productId:productId, facilityId:reportFacilityId,
                    locationSeqId:locationSeqId, lotId:lotId, ownerPartyId:ownerPartyId}"/>
    </actions>
    <widgets>
        <container style="m-record-header">
            <container style="m-record-title">
                <label text="Stock at date" type="h5"/>
                <label text="What was on hand at the end of a day: each place's opening, receipts, issues, adjustments and
                            closing. Days are in your time zone (${ec.user.timeZone || 'the server zone'})."
                        type="p" style="text-caption m-muted q-mb-none"/>
            </container>
        </container>
        <section name="StockAtDateNotMounted" condition="appRoot != 'Warehouse'">
            <widgets>
                <label text="Stock at date is not available in this app." type="p"/>
            </widgets>
            <fail-widgets>
                <form-single name="StockDateFind" transition="." map="options">
                    <field name="productId">
                        <default-field title="Product">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="inventoryChoices" server-search="true" min-length="0"
                                        parameter-map="{choice:'products', selected:productId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="facilityId">
                        <default-field title="Facility" tooltip="Every facility of yours when empty">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'facilities', selected:reportFacilityId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="locationSeqId">
                        <default-field title="Location">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="inventoryChoices" server-search="true" min-length="0"
                                        parameter-map="{choice:'locations', selected:locationSeqId}">
                                    <depends-on field="facilityId"/>
                                </dynamic-options>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="lotId">
                        <default-field title="Lot">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="inventoryChoices" server-search="true" min-length="0"
                                        parameter-map="{choice:'lots', selected:lotId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="ownerPartyId">
                        <default-field title="Owner">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="reportChoices" server-search="true" min-length="0"
                                        parameter-map="{choice:'owners', selected:ownerPartyId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="fromDate">
                        <default-field title="From" tooltip="The first of the cut-off's month when empty">
                            <date-time type="date"/>
                        </default-field>
                    </field>
                    <field name="asOfDate">
                        <default-field title="As of" tooltip="The end of this day; today when empty">
                            <date-time type="date"/>
                        </default-field>
                    </field>
                    <field name="submit">
                        <default-field title="">
                            <submit text="Show stock" type="primary"/>
                        </default-field>
                    </field>
                    <field-layout>
                        <field-row-big>
                            <field-ref name="productId"/>
                            <field-ref name="facilityId"/>
                            <field-ref name="locationSeqId"/>
                        </field-row-big>
                        <field-row-big>
                            <field-ref name="lotId"/>
                            <field-ref name="ownerPartyId"/>
                            <field-ref name="fromDate"/>
                            <field-ref name="asOfDate"/>
                        </field-row-big>
                        <field-ref name="submit"/>
                    </field-layout>
                </form-single>
                <subscreens-panel id="StockAtDatePanel" type="tab"/>
            </fail-widgets>
        </section>
    </widgets>
</screen>
