<!-- ShipmentDetail (design-crosscut §3.8; style-guide §3.3 Detail): one shipment, mounted by Accounting at
    Accounting/Records/ShipmentDetail with the Accounting context only (design-accounting §14 ShipmentDetail): its items
    with their order sources and what was received, accepted, rejected and billed, and the invoices of its items; for a
    delivered receipt, Bill accepted receipts (mantle.account.InvoiceServices.create#InvoiceFromSource on the received
    basis). Finance reads the physical facts and does not change them. Warehouse mounts it at Warehouse/Receiving/ReceiptDetail
    (crosscut §3.8 receipt row, impl-warehouse P7): an incoming shipment received at the user's facilities, its lines and
    receipts, Receive, Finish receipt (close or backorder the remainder, ironstone's closeRemainder over
    mantle.shipment.WarehouseTaskServices.close#ReceiptRemainder), Receive all as expected, the receipt documents, files and
    conversation (ironstone.warehouse.ReceiptServices.get#ReceiptDetail; template/WarehouseReceiptDetail.xml); and at
    Warehouse/Shipping/ShipmentDetail (crosscut §3.8 outbound row, impl-warehouse P11) an outgoing shipment leaving the user's
    facilities: its lines with reserved, picked, packed, short and put back, Pick, packages, routes, files and conversation,
    prices and freight only with financial read (ironstone.warehouse.PickingServices.get#OutboundDetail;
    template/WarehouseShipmentDetail.xml); and at Warehouse/Transfers/TransferShipmentDetail and SubcontractShipmentDetail
    (crosscut §3.8 transfer and subcontract rows, impl-warehouse P15) a transfer from or to the user's facilities: its lines with
    sent, in transit and received, the origin's pick, send and ship, transit, the destination's receipt, a subcontract
    dispatch's custody at supplier, files and conversation (ironstone.warehouse.TransferServices.get#TransferDetail;
    template/WarehouseTransferDetail.xml). At Warehouse/Returns/ReturnReceipt and SupplierReturnShipment (crosscut §3.8 return
    receipt and supplier return rows, impl-warehouse P14) a return's shipment: its return items, Receive into quarantine or
    Send back the stock each item names, Ship, receipts or issues, inspections, packages and tracking
    (ironstone.warehouse.ReturnServices.get#ReturnShipmentDetail; template/WarehouseReturnDetail.xml). The Warehouse branches
    are tried in one order: transfer, return, receipt, outbound. Manufacturing mounts it at
    Manufacturing/Subcontracting/ShipmentDetail (crosscut §3.8 Manufacturing row, impl-manufacturing P14), read only: a
    subcontract dispatch or return of the user's work orders with its lines, run and operation, vendor-custody facility,
    custodian and owner (mantle.work.ProductionServices.get#SubcontractShipment; template/ManufacturingSubcontractParts.xml);
    dispatch and return happen at Warehouse's SubcontractShipmentDetail. Purchasing mounts it at Purchasing/Receiving/ShipmentDetail
    (crosscut §3.8 Purchasing row, impl-purchasing P5): a purchase receipt of the user's orders with its lines (expected,
    received, accepted, rejected, held and due), receipts, inspections, files and conversation; Receive per line, Finish
    receipt and Receive all as expected for a holder of Warehouse's receive permission through Warehouse's receive guard,
    Create draft bill for AP intake, progress only for others (ironstone.purchasing.ReceiptServices.get#ReceiptDetail;
    template/PurchasingReceiptDetail.xml). Customer Service mounts it at CustomerService/Orders/ShipmentDetail (crosscut §3.8
    Customer Service row, impl-customer-service P3), read only: a shipment to or a return from a customer the user serves, its
    items, tracking, packages, orders, returns, cases and a delivery update to copy, no stock action
    (ironstone.customerservice.OrderServices.get#ShipmentDetail; template/CustomerServiceShipmentDetail.xml). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Shipment"
        default-menu-include="false">
    <parameter name="shipmentId" required="true"/>
    <parameter name="organizationPartyId"/>
    <transition-include name="invoiceFromSource" location="component://mr-boss/template/AccountingRecords.xml"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition-include name="closeRemainder" location="component://mr-boss/template/WarehouseReceiptParts.xml"/>
    <transition-include name="receiveAll" location="component://mr-boss/template/WarehouseReceiptParts.xml"/>
    <!-- P14: a return's shipment -->
    <transition-include name="returnChoices" location="component://mr-boss/template/WarehouseReturnParts.xml"/>
    <transition-include name="receiveReturn" location="component://mr-boss/template/WarehouseReturnParts.xml"/>
    <transition-include name="issueSupplierReturn" location="component://mr-boss/template/WarehouseReturnParts.xml"/>
    <transition-include name="shipSupplierReturn" location="component://mr-boss/template/WarehouseReturnParts.xml"/>
    <!-- P15: the transfer branch's transitions -->
    <transition-include name="transferChoices" location="component://mr-boss/template/WarehouseTransferParts.xml"/>
    <transition-include name="pickTransferLine" location="component://mr-boss/template/WarehouseTransferParts.xml"/>
    <transition-include name="issueTransferLine" location="component://mr-boss/template/WarehouseTransferParts.xml"/>
    <transition-include name="shipTransfer" location="component://mr-boss/template/WarehouseTransferParts.xml"/>
    <transition-include name="receiveTransferLine" location="component://mr-boss/template/WarehouseTransferParts.xml"/>
    <transition-include name="dispatchTransferLine" location="component://mr-boss/template/WarehouseTransferParts.xml"/>
    <transition-include name="receiveSubcontractOutput" location="component://mr-boss/template/WarehouseTransferParts.xml"/>
    <!-- Purchasing (impl-purchasing P5): a purchase receipt's actions -->
    <transition-include name="purchaseReceiptChoices" location="component://mr-boss/template/PurchasingReceiptDetail.xml"/>
    <transition-include name="purchaseReceive" location="component://mr-boss/template/PurchasingReceiptDetail.xml"/>
    <transition-include name="purchaseFinishReceipt" location="component://mr-boss/template/PurchasingReceiptDetail.xml"/>
    <transition-include name="purchaseReceiveAll" location="component://mr-boss/template/PurchasingReceiptDetail.xml"/>
    <transition-include name="purchaseBillReceipt" location="component://mr-boss/template/PurchasingReceiptDetail.xml"/>
    <!-- Purchasing (impl-purchasing P14b): reserve received stock for the customer order line it was bought for -->
    <transition-include name="purchaseReservePeg" location="component://mr-boss/template/PurchasingReceiptPegs.xml"/>
    <!-- Insights (appRoot Insights, mounted at Insights/Records/ShipmentDetail; design-insights §10, crosscut's Insights row, impl-insights
        P6): read only, in place of the owners' contexts. The condition fails for Insights, so none of the actions and widgets
        below runs, and the fail-widgets show template/InsightsRecord.xml: the record as the admitted datasets the viewer reads
        show it, the owners' screens of it that open to them, and the return to the report; no action. -->
    <condition><expression>appRoot != 'Insights'</expression></condition>
    <actions>
        <if condition="appRoot == 'Accounting'">
            <service-call name="ironstone.accounting.PayableScreenServices.get#ShipmentContext"
                    in-map="{shipmentId:shipmentId, organizationPartyId:organizationPartyId}"
                    out-map="context"
                    transaction="force-new"
                    ignore-error="true"/>
        </if>
        <!-- the Warehouse branches in one order: a transfer or subcontract dispatch (P15), a customer or supplier return's
            shipment (P14), a receipt (P7), an outgoing shipment (P11); each is tried only when no earlier one found it -->
        <if condition="appRoot == 'Warehouse'">
            <service-call name="ironstone.warehouse.TransferServices.get#TransferDetail" in-map="{shipmentId:shipmentId}"
                    out-map="context" transaction="force-new" ignore-error="true"/>
            <set field="transferFound" from="!!transferFound"/>
            <set field="returnShipmentFound" from="false"/>
            <set field="receiptFound" from="false"/>
            <set field="outboundFound" from="false"/>
            <if condition="!transferFound">
                <service-call name="ironstone.warehouse.ReturnServices.get#ReturnShipmentDetail"
                        in-map="{shipmentId:shipmentId}" out-map="context" transaction="force-new" ignore-error="true"/>
                <set field="returnShipmentFound" from="!!returnShipmentFound"/>
            </if>
            <if condition="!transferFound &amp;&amp; !returnShipmentFound">
                <service-call name="ironstone.warehouse.ReceiptServices.get#ReceiptDetail" in-map="{shipmentId:shipmentId}"
                        out-map="context" transaction="force-new" ignore-error="true"/>
                <set field="receiptFound" from="!!receiptFound"/>
            </if>
            <if condition="!transferFound &amp;&amp; !returnShipmentFound &amp;&amp; !receiptFound">
                <service-call name="ironstone.warehouse.PickingServices.get#OutboundDetail" in-map="{shipmentId:shipmentId}"
                        out-map="context" transaction="force-new" ignore-error="true"/>
                <set field="outboundFound" from="!!outboundFound"/>
            </if>
        </if>
        <!-- Manufacturing (crosscut §3.8 Manufacturing row, impl-manufacturing P14): a subcontract dispatch or return, read only -->
        <if condition="appRoot == 'Manufacturing'">
            <service-call name="mantle.work.ProductionServices.get#SubcontractShipment" in-map="{shipmentId:shipmentId}"
                    out-map="manufacturingShipmentOut" transaction="force-new" ignore-error="true"/>
            <set field="manufacturingShipment" from="manufacturingShipmentOut?.subcontractShipment || null"/>
        </if>
        <!-- Purchasing (crosscut §3.8 Purchasing row, impl-purchasing P5): a purchase receipt of the user's orders -->
        <if condition="appRoot == 'Purchasing'">
            <service-call name="ironstone.purchasing.ReceiptServices.get#ReceiptDetail"
                    in-map="{appRoot:appRoot, shipmentId:shipmentId}" out-map="purchaseReceiptOut" transaction="force-new"
                    ignore-error="true"/>
            <set field="purchaseReceipt" from="purchaseReceiptOut?.receiptFound ? purchaseReceiptOut : null"/>
        </if>
        <!-- Customer Service (crosscut §3.8 Customer Service row, impl-customer-service P3): a customer's shipment, read only -->
        <if condition="appRoot == 'CustomerService'">
            <service-call name="ironstone.customerservice.OrderServices.get#ShipmentDetail"
                    in-map="{appRoot:appRoot, shipmentId:shipmentId}" out-map="serviceShipmentOut" transaction="force-new"
                    ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
            <set field="serviceShipment" from="serviceShipmentOut?.detail || null"/>
        </if>
    </actions>
    <widgets>
        <section-include name="AccountingShipment" location="component://mr-boss/template/AccountingRecords.xml"/>
        <section-include name="WarehouseReceipt" location="component://mr-boss/template/WarehouseReceiptDetail.xml"/>
        <section-include name="WarehouseOutbound" location="component://mr-boss/template/WarehouseShipmentDetail.xml"/>
        <section-include name="WarehouseReturnShipment" location="component://mr-boss/template/WarehouseReturnDetail.xml"/>
        <section-include name="WarehouseTransfer" location="component://mr-boss/template/WarehouseTransferDetail.xml"/>
        <section-include name="ManufacturingShipment" location="component://mr-boss/template/ManufacturingSubcontractParts.xml"/>
        <section-include name="PurchasingReceipt" location="component://mr-boss/template/PurchasingReceiptDetail.xml"/>
        <section-include name="CustomerServiceShipment" location="component://mr-boss/template/CustomerServiceShipmentDetail.xml"/>
        <label text="This shipment is not available in this app." type="p"
                condition="appRoot != 'Accounting' &amp;&amp; appRoot != 'Warehouse' &amp;&amp; appRoot != 'Manufacturing'
                    &amp;&amp; appRoot != 'Purchasing' &amp;&amp; appRoot != 'CustomerService'"/>
    </widgets>
    <fail-widgets>
        <section name="InsightsContext">
            <actions>
                <set field="insightsRecordType" value="ShipmentDetail"/>
                <set field="insightsRecordId" from="shipmentId"/>
            </actions>
            <widgets><section-include name="InsightsRecord" location="component://mr-boss/template/InsightsRecord.xml"/></widgets>
        </section>
    </fail-widgets>
</screen>
