<!-- InventoryAvailability's Locations tab, in the Warehouse context only (crosscut §3.7 Warehouse row, Locations/lots): the
    product's stock in the user's facilities by facility, location, lot and status, held stock apart from available
    (ironstone.warehouse.InventoryServices.get#ProductStock). Relocate (impl-warehouse P5) moves the selected rows' assets to
    one location of the facility, each with its own result (template/WarehouseMoveParts.xml relocateAssets). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Locations and lots" default-menu-index="2">
    <transition-include name="facilityChoices" location="component://mr-boss/template/WarehouseFacilityParts.xml"/>
    <transition-include name="relocateAssets" location="component://mr-boss/template/WarehouseMoveParts.xml"/>
    <condition><expression>appRoot == 'Warehouse'</expression></condition>
    <actions>
        <service-call name="ironstone.warehouse.InventoryServices.get#ProductStock"
                in-map="{productId:productId, facilityId:facilityId, part:'locations'}" out-map="context"
                transaction="force-new" ignore-error="true"/>
        <set field="locationRows" from="locationRows || []"/>
        <!-- Relocate: to a location of the chosen facility, for a user with move; the operation key is a token -->
        <set field="relocateFacilityId" from="facilityId || warehouse?.facilityId"/>
        <set field="canRelocate" from="!!(warehouse?.capabilities?.move &amp;&amp; relocateFacilityId)"/>
        <set field="relocateOperationKey" from="'relocate-' + ec.user.randomString(24)"/>
    </actions>
    <widgets>
        <container-box>
            <box-header title="Stock by location and lot"/>
            <box-body-nopad>
                <label text="No stock of this product is in the facility." type="p" style="q-pa-sm"
                        condition="!locationRows.length"/>
                <form-list name="ProductLocations" list="locationRows" skip-form="true" paginate="false" show-csv-button="true">
                    <row-selection id-field="assetIds" parameter="assetIdList" list-mode="true" condition="canRelocate">
                        <action>
                            <dialog button-text="Relocate" title="Move the selected stock to one location"/>
                            <form-single name="RelocateStock" transition="relocateAssets"
                                    map="{operationKey:relocateOperationKey}">
                                <field name="operationKey">
                                    <default-field>
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="toLocationSeqId">
                                    <default-field title="To location">
                                        <drop-down allow-empty="false">
                                            <dynamic-options transition="facilityChoices" server-search="true" min-length="0"
                                                    parameter-map="{choice:'locations', facilityId:relocateFacilityId}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="reason">
                                    <default-field title="Reason">
                                        <text-line size="40"/>
                                    </default-field>
                                </field>
                                <field name="submit">
                                    <default-field title="">
                                        <submit text="Relocate"/>
                                    </default-field>
                                </field>
                            </form-single>
                        </action>
                    </row-selection>
                    <field name="facilityName">
                        <default-field title="Facility">
                            <display/>
                        </default-field>
                    </field>
                    <field name="locationSeqId">
                        <default-field title="Location">
                            <display/>
                        </default-field>
                    </field>
                    <field name="lotNumber">
                        <conditional-field condition="lotLink" title="Lot">
                            <link url="${lotLink}" text="${lotNumber}" link-type="anchor" url-type="plain"/>
                        </conditional-field>
                        <default-field title="Lot">
                            <display/>
                        </default-field>
                    </field>
                    <field name="expiryText">
                        <default-field title="Expiry">
                            <display/>
                        </default-field>
                    </field>
                    <field name="statusText">
                        <default-field title="Status">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                                    statusColor}">${WebUtilities.encodeHtml(statusText)}</q-chip>]]></text>
                                <text
                                        type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong",
                                            text: statusText})}]]></text>
                                <text type="html">${statusText}</text>
                            </render-mode>
                        </default-field>
                    </field>
                    <field name="quantityOnHand" align="right">
                        <default-field title="On hand">
                            <display format="#,##0.###"/>
                        </default-field>
                    </field>
                    <field name="availableToPromise" align="right">
                        <default-field title="Available to promise">
                            <display format="#,##0.###"/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="locationSeqId"/>
                            <field-ref name="lotNumber"/>
                        </column>
                        <column>
                            <field-ref name="statusText"/>
                            <field-ref name="quantityOnHand"/>
                        </column>
                    </columns>
                </form-list>
            </box-body-nopad>
        </container-box>
    </widgets>
</screen>
