<!-- FacilityDetail's Schedules tab: the events that book the facility in the next two weeks on the Commons calendar
    (design-drawers-commons §7; ironstone.warehouse.FacilityServices.get#FacilitySchedule over
    mantle.work.EventServices.get#FullCalendarData). Bookings are made in Commons. Under Maintenance (impl-maintenance P15; design
    §6 FacilityDetail's Schedules, §7.1): the facility's booking policy in words and its availability for two weeks
    (mantle.work.ResourceBookingServices.get#ResourceAvailability: bookings, blackouts, its own and those above it, and outages kept
    apart, an event the user may not see named Busy), after Maintenance's record check, linking its policy and Blackouts. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Schedules"
        default-menu-index="8">
    <parameter name="facilityId"/>
    <!-- Warehouse's tab: the Manufacturing context has its own Work center tab -->
    <condition><expression>appRoot != 'Manufacturing'</expression></condition>
    <actions>
        <set field="schedule" from="null"/>
        <if condition="appRoot == 'Warehouse'">
            <service-call name="ironstone.warehouse.FacilityServices.get#FacilitySchedule"
                    in-map="{facilityId:facilityId}"
                    out-map="schedule"
                    transaction="force-new"
                    ignore-error="true"/>
        </if>
        <set field="maintenanceSchedule" from="false"/>
        <if condition="appRoot == 'Maintenance'">
            <service-call name="ironstone.maintenance.AccessServices.check#Record" out-map="maintenanceRecord"
                    in-map="{appRoot:appRoot, recordType:'facility', recordId:facilityId}" transaction="force-new" ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
            <if condition="maintenanceRecord?.recordId">
                <service-call name="mantle.work.ResourceBookingServices.get#ResourceAvailability" out-map="availability"
                        transaction="force-new" ignore-error="true" in-map="{facilityId:facilityId}"/>
                <script>ec.message.clearErrors()</script>
                <set field="maintenanceSchedule" from="availability?.intervalList != null"/>
                <set field="scheduleRows" from="availability?.intervalList || []"/>
                <set field="schedulePolicyText" from="availability?.policyText"/>
                <set field="scheduleResource" from="{facilityId:facilityId}"/>
                <set field="scheduleReadsPolicy" from="!!(maintenance?.capabilities?.policyView || maintenance?.capabilities?.policyEdit
                        || maintenance?.capabilities?.resourceRead)"/>
            </if>
        </if>
        <set field="recordFound" from="schedule?.bookingList != null"/>
        <set field="bookingList" from="schedule?.bookingList || []"/>
    </actions>
    <widgets>
        <section name="MaintenanceFacilitySchedule" condition="maintenanceSchedule">
            <widgets>
                <section-include name="ResourceSchedule" location="component://mr-boss/template/MaintenanceSchedulingParts.xml"/>
            </widgets>
        </section>
        <section name="FacilitySchedule" condition="recordFound">
            <widgets>
                <container-box>
                    <box-header title="Bookings in the next ${schedule.scheduleDays} days"/>
                    <box-body-nopad>
                        <form-list name="FacilityBookings" list="bookingList" skip-form="true" paginate="false">
                            <field name="title">
                                <default-field title="Event">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="whenText">
                                <default-field title="When">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="ownerName">
                                <default-field title="Organizer">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="statusText">
                                <default-field title="Status">
                                    <display/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="title"/>
                                    <field-ref name="whenText"/>
                                </column>
                                <column>
                                    <field-ref name="statusText"/>
                                </column>
                            </columns>
                        </form-list>
                        <label text="Nothing books this facility in the next ${schedule.scheduleDays} days. Bookings are made on
                            the Commons calendar."
                                type="p"
                                style="q-pa-md m-muted"
                                condition="!bookingList.length &amp;&amp; schedule.scheduleAvailable"/>
                        <label text="The calendar could not be read just now." type="p" style="q-pa-md m-muted"
                                condition="!schedule.scheduleAvailable"/>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
