<!-- FacilityDetail's Conversation tab: the facility's messages and activity log (chatter on the Facility record). It
    reads the facility when the client loads the tab alone. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Conversation"
        default-menu-index="10"
        server-static="qvt">
    <parameter name="facilityId"/>
    <actions>
        <!-- FacilityDetail's actions read the facility when it renders with the tab -->
        <if condition="detail == null">
            <set field="detail" from="null"/>
            <if condition="appRoot == 'Warehouse'">
                <service-call name="ironstone.warehouse.FacilityServices.get#FacilityDetail"
                        in-map="{facilityId:facilityId}"
                        out-map="detail"
                        transaction="force-new"
                        ignore-error="true"/>
            </if>
            <set field="recordFound" from="!!detail?.facility"/>
        </if>
    </actions>
    <widgets>
        <section name="FacilityConversation" condition="recordFound">
            <widgets>
                <label text="Conversation" type="h6"/>
                <chatter id="WarehouseFacilityConversation"
                        record-entity="mantle.facility.Facility"
                        record-id="${facilityId}"
                        default-tab="log"/>
            </widgets>
        </section>
    </widgets>
</screen>
