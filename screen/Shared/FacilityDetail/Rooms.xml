<!-- FacilityDetail's Rooms tab, Maintenance's (design-maintenance §6 Facilities, crosscut §3.10 "Rooms/features"; impl-maintenance
    P2, F16): the rooms inside the facility with their people capacity, booking and current features, and the facility's own room
    features with their dates; Add feature and End for a holder of FACILITY_EDIT (store#FacilityFeature: rows are ended, never
    deleted). People capacity here is not a location's bin capacity. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Rooms &amp; features"
        default-menu-index="3">
    <parameter name="facilityId"/>
    <transition-include name="choices" location="component://mr-boss/template/MaintenanceParts.xml"/>
    <transition-include name="storeFeature" location="component://mr-boss/template/MaintenanceParts.xml"/>
    <condition><expression>appRoot == 'Maintenance'</expression></condition>
    <actions>
        <!-- FacilityDetail's actions read the facility when it renders with the tab -->
        <if condition="detail == null">
            <set field="detail" from="null"/>
            <service-call name="ironstone.maintenance.FacilityServices.get#FacilityDetail"
                    in-map="{facilityId:facilityId}"
                    out-map="detail"
                    transaction="force-new"
                    ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
            <set field="recordFound" from="!!detail?.facility"/>
        </if>
        <set field="roomList" from="detail?.roomList || []"/>
        <set field="featureList" from="detail?.featureList || []"/>
        <set field="canEdit" from="!!detail?.canEdit"/>
        <set field="featureValues" from="{facilityId: facilityId, roomFacilityId: facilityId}"/>
    </actions>
    <widgets>
        <section name="FacilityRooms" condition="recordFound">
            <widgets>
                <container-box>
                    <box-header title="Rooms inside"/>
                    <box-body-nopad>
                        <form-list name="FacilityRoomRows" list="roomList" skip-form="true" paginate="false">
                            <field name="facilityName">
                                <default-field title="Room">
                                    <link url="${sharedLinks['Facilities/FacilityDetail']}" text="${facilityName}" link-type="anchor"
                                            parameter-map="{facilityId:facilityId}"/>
                                </default-field>
                            </field>
                            <field name="capacity" align="right">
                                <default-field title="Holds">
                                    <display format="#,##0"/>
                                </default-field>
                            </field>
                            <field name="bookableText"><default-field title="Booking"><display/></default-field></field>
                            <field name="featuresText"><default-field title="Features"><display/></default-field></field>
                            <field name="stateText"><default-field title="State"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="facilityName"/><field-ref name="featuresText"/></column>
                                <column><field-ref name="capacity"/><field-ref name="bookableText"/></column>
                            </columns>
                        </form-list>
                        <label text="No room is inside this facility." type="p" style="q-pa-md m-muted" condition="!roomList.length"/>
                    </box-body-nopad>
                </container-box>
                <container-box>
                    <box-header title="Its features"/>
                    <box-toolbar>
                        <container-dialog id="AddFeatureDialog" button-text="Add feature" title="Add a feature" icon="sym_o_add"
                                width="560" type="primary" condition="canEdit">
                            <form-single name="AddFeature" transition="storeFeature" map="featureValues">
                                <field name="facilityId"><default-field><hidden/></default-field></field>
                                <field name="roomFacilityId"><default-field><hidden/></default-field></field>
                                <field name="featureEnumId">
                                    <default-field title="Feature">
                                        <drop-down allow-empty="false">
                                            <dynamic-options transition="choices" server-search="true" min-length="0"
                                                    parameter-map="{choice:'roomFeatures', selected:featureEnumId}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="comments"><default-field title="Note"><text-line/></default-field></field>
                                <field name="submitButton"><default-field title=""><submit text="Add feature"/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body-nopad>
                        <form-list name="FacilityFeatureRows" list="featureList" skip-form="true" paginate="false">
                            <field name="featureText"><default-field title="Feature"><display/></default-field></field>
                            <field name="fromDateText"><default-field title="From"><display/></default-field></field>
                            <field name="thruDateText"><default-field title="Through"><display/></default-field></field>
                            <field name="comments"><default-field title="Note"><display/></default-field></field>
                            <field name="end">
                                <default-field title="">
                                    <link url="storeFeature" text="End" btn-type="danger"
                                            condition="canEdit &amp;&amp; current"
                                            parameter-map="{facilityId:facilityId, roomFacilityId:facilityId, featureEnumId:featureEnumId, end:'true'}"
                                            confirmation="End ${featureText} from now?"/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="featureText"/><field-ref name="fromDateText"/></column>
                                <column><field-ref name="thruDateText"/><field-ref name="end"/></column>
                            </columns>
                        </form-list>
                        <label text="No feature is recorded." type="p" style="q-pa-md m-muted" condition="!featureList.length"/>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
