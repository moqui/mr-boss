<!-- A customer of the organization (style-guide §3.4 360), mounted in Accounting at Receivables/Customer360: the header with
    the customer's name, Customer statement and the More menu, its key numbers in each currency (open receivable, overdue,
    billed this year, last payment), each linking to the invoices, and the tabs, each of which reads the customer itself
    when the client loads it alone (ironstone.accounting.ReceivableServices.get#CustomerContext). A customer the user may not
    see is "not available".
    Customer Service (appRoot CustomerService, mounted at CustomerService/Customers/Customer360; crosscut §3.2 Customer
    Service row, impl-customer-service P3): a customer the user serves, read in always-actions so a tab rendered alone has it
    (ironstone.customerservice.CustomerServices.get#Customer360; a shared customer's records only of the user's
    organizations, F74); its header and key numbers (template/CustomerServiceCustomer360.xml) and its own tabs, Overview and
    contacts, Cases, Orders and shipments, Billing (amounts for a finance reader, the credit status for a credit reader, read
    only) and Files; the Accounting tabs are Accounting's alone, and payment details never show here.
    Commerce (appRoot Commerce, mounted at Commerce/Customers/Customer360; crosscut §3.2, design-commerce §10, impl-commerce P8):
    a customer of the user's stores, read in always-actions (mantle.order.StoreOperationsServices.get#StoreCustomer), on one
    page (template/CommerceCustomer360.xml) with no tabs: its stores, PASS account state, addresses, masked payment methods,
    orders, carts, cases and returns.
    Sales (appRoot Sales, mounted at Sales/Accounts/Customer360; crosscut §3.2 Sales row, design-sales §4, impl-sales P3): an
    account of the user's sales scope, read in always-actions (mantle.sales.SalesWorkspaceServices.get#CustomerSales; a shared
    account's documents only of the user's organizations), its header and key numbers (template/SalesCustomer360.xml) and its own
    tabs, Overview, Contacts, Orders (an organization reader's), Invoices (a finance reader's) and Files; Opportunities, RFQs,
    Quotes and Agreements join with their phases (P4, P8, P7, P15). The Accounting tabs are Accounting's alone. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Customer"
        default-menu-include="false">
    <parameter name="organizationPartyId"/>
    <parameter name="customerPartyId"/>
    <parameter name="appRoot"/>
    <always-actions>
        <!-- Insights (impl-insights P6): the record its InsightsRecord subscreen shows -->
        <if condition="appRoot == 'Insights'"><set field="insightsRecordType" value="Customer360"/><set field="insightsRecordId" from="customerPartyId"/></if>
        <!-- Customer Service (impl-customer-service P3): its read of the customer, which its tabs use -->
        <if condition="appRoot == 'CustomerService'">
            <service-call name="ironstone.customerservice.CustomerServices.get#Customer360" out-map="serviceCustomer"
                    in-map="{appRoot:appRoot, customerPartyId:customerPartyId}" transaction="force-cache" ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
            <set field="customerFound" from="!!serviceCustomer?.customerFound"/>
            <set field="customerDetail" from="serviceCustomer?.customerDetail || {}"/>
        </if>
        <!-- Sales (impl-sales P3): an account of the user's sales scope, which its tabs use -->
        <if condition="appRoot == 'Sales'">
            <service-call name="mantle.sales.SalesWorkspaceServices.get#CustomerSales" out-map="salesCustomer"
                    in-map="{customerPartyId:customerPartyId}" transaction="force-cache" ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
            <set field="customerFound" from="!!salesCustomer?.customerFound"/>
            <set field="customerDetail" from="salesCustomer?.customerDetail || {}"/>
        </if>
        <!-- Commerce (impl-commerce P8): a customer of the user's stores, read only -->
        <if condition="appRoot == 'Commerce'">
            <service-call name="mantle.order.StoreOperationsServices.get#StoreCustomer" out-map="commerceCustomer"
                    in-map="{customerPartyId:customerPartyId}" transaction="force-new" ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
            <set field="commerceCustomer" from="commerceCustomer?.customer ? commerceCustomer : null"/>
            <service-call name="ironstone.commerce.ContextServices.get#OperationLinks" out-map="linksOut" transaction="force-new" ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
            <set field="operationLinks" from="linksOut?.links || {}"/>
        </if>
    </always-actions>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition-include name="selectOrganization" location="component://mr-boss/template/AccountingParts.xml"/>
    <subscreens default-item="Contact" always-use-full-path="true">
        <conditional-default condition="appRoot == 'CustomerService'" item="ServiceOverview"/>
        <conditional-default condition="appRoot == 'Sales'" item="SalesOverview"/>
        <subscreens-item name="InsightsRecord" location="component://mr-boss/screen/Shared/InsightsRecord.xml" menu-include="false"/>
    </subscreens>
    <!-- Insights (appRoot Insights, mounted at Insights/Records/Customer360; design-insights §10, crosscut's Insights row, impl-insights
        P6): read only, in place of the owners' contexts. The condition fails for Insights, so none of the actions and widgets
        below runs, and the fail-widgets show the InsightsRecord subscreen (template/InsightsRecord.xml): the record as the admitted datasets the viewer reads
        show it, the owners' screens of it that open to them, and the return to the report; no action. -->
    <condition><expression>appRoot != 'Insights'</expression></condition>
    <actions>
        <if condition="organizationPartyId &amp;&amp; appRoot != 'CustomerService' &amp;&amp; appRoot != 'Commerce' &amp;&amp; appRoot != 'Sales'">
            <service-call name="ironstone.accounting.ReceivableServices.get#CustomerContext"
                    in-map="context"
                    out-map="context"
                    transaction="force-new"
                    ignore-error="true"/>
        </if>
        <set field="invoicesPath" from="sharedLinks['Receivables/Invoices']"/>
        <set field="invoicesQuery"
                from="'customerPartyId=' + encodeURIComponent(customerPartyId || '') + '&amp;organizationPartyId='
                    + encodeURIComponent(organizationPartyId || '')"/>
    </actions>
    <widgets>
        <section-include name="CustomerServiceCustomer" location="component://mr-boss/template/CustomerServiceCustomer360.xml"/>
        <section-include name="CommerceCustomer" location="component://mr-boss/template/CommerceCustomer360.xml"/>
        <section-include name="SalesCustomer" location="component://mr-boss/template/SalesCustomer360.xml"/>
        <section name="CustomerOrganizationPrompt" condition="!organizationPartyId &amp;&amp; appRoot != 'CustomerService' &amp;&amp; appRoot != 'Commerce' &amp;&amp; appRoot != 'Sales'">
            <widgets>
                <section-include name="OrganizationPicker" location="component://mr-boss/template/AccountingParts.xml"/>
                <label text="Choose an organization to see this customer." type="p"/>
            </widgets>
        </section>
        <section name="CustomerMissing" condition="organizationPartyId &amp;&amp; !customerFound &amp;&amp; appRoot != 'CustomerService' &amp;&amp; appRoot != 'Commerce' &amp;&amp; appRoot != 'Sales'">
            <widgets>
                <container-box type="warning">
                    <box-header title="Customer not available"/>
                    <box-body>
                        <label type="p" text="The customer does not exist, or you may not see it."/>
                        <link url="${sharedLinks['Receivables/Invoices']}"
                                text="Back to invoices"
                                link-type="anchor"
                                parameter-map="{organizationPartyId:organizationPartyId}"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="CustomerRecord" condition="customerFound &amp;&amp; appRoot != 'CustomerService' &amp;&amp; appRoot != 'Commerce' &amp;&amp; appRoot != 'Sales'">
            <widgets>
                <context record-entity="mantle.party.Party"
                        record-id="${customerPartyId}"
                        title="${customerDetail.customerName}"/>
                <container style="m-record-header">
                    <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                        <container style="col-12 col-md m-record-title">
                            <label text="${customerDetail.customerName}" type="h5"/>
                            <label text="Customer" type="p" style="text-caption m-muted"/>
                        </container>
                        <container style="col-12 col-md-auto row items-center q-gutter-sm m-record-actions">
                            <link url="${sharedLinks['Receivables/Statements']}"
                                    text="Customer statement"
                                    link-type="anchor-button"
                                    btn-type="primary"
                                    parameter-map="customerLinkParameters"
                                    condition="accounting.capabilities.arEdit"/>
                            <button-menu text="More" icon="more_horiz">
                                <link url="//Commons/Contacts/ContactDetail"
                                        text="Maintain contact"
                                        parameter-map="{partyId:customerPartyId}"
                                        condition="customerDetail.capabilities.partyEdit"/>
                                <link url="${sharedLinks['Receivables/Invoices']}"
                                        text="Customer invoices"
                                        parameter-map="customerLinkParameters"/>
                            </button-menu>
                        </container>
                    </container>
                </container>
                <label type="p"
                        style="text-warning"
                        condition="customerDetail.incomplete"
                        text="The key numbers are not complete. Open the customer's invoices to narrow the selection."/>
                <section-iterate name="CustomerKeyNumbers" list="customerDetail.summaryRows" entry="summaryRow">
                    <widgets>
                        <dashboard min-width="180">
                            <number-card title="Open receivable"
                                    value="${summaryRow.openReceivableText}"
                                    size="sm"
                                    link="${invoicesPath}?queue=unpaid&amp;${invoicesQuery}"/>
                            <number-card title="Overdue"
                                    value="${summaryRow.overdueText}"
                                    size="sm"
                                    link="${invoicesPath}?queue=overdue&amp;${invoicesQuery}"/>
                            <number-card title="Billed this year"
                                    value="${summaryRow.billedThisYearText}"
                                    size="sm"
                                    link="${invoicesPath}?${invoicesQuery}"/>
                            <number-card title="Last payment${summaryRow.lastPaymentDateText ? ' · '
                                        + summaryRow.lastPaymentDateText : ''}"
                                    value="${summaryRow.lastPaymentText}"
                                    size="sm"/>
                        </dashboard>
                    </widgets>
                </section-iterate>
                <subscreens-panel id="AccountingCustomerTabs" type="tab"/>
            </widgets>
        </section>
    </widgets>
    <fail-widgets><subscreens-active/></fail-widgets>
</screen>
