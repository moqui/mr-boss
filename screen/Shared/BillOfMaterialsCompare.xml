<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Compare method dates" default-menu-include="false">
    <parameter name="appRoot" />
    <parameter name="productId" />
    <parameter name="productBomId" />
    <parameter name="organizationPartyId" />
    <parameter name="workEffortId" />
    <parameter name="asOfDate" />
    <parameter name="quantity" />
    <parameter name="quantityUomId" />
    <parameter name="facilityId" />
    <parameter name="leftReleaseId" />
    <parameter name="rightReleaseId" />
    <parameter name="leftDate" />
    <parameter name="rightDate" />
    <parameter name="manualLeftDate" />
    <parameter name="manualRightDate" />
    <always-actions>
        <service-call name="ironstone.products.CatalogServices.get#SharedContext" in-map="{appRoot:appRoot}" out-map="sharedMountContext"/>
        <script>if(!sharedMountContext.capabilities.read)throw new Error('Catalog read access is required')</script>
        <set field="appRoot" from="sharedMountContext.appRoot"/>
        <set field="sharedLinks" from="sharedMountContext.sharedLinks"/>
        <set field="printBase" from="sharedMountContext.printBase"/>
    </always-actions>
    <actions>
        <service-call name="ironstone.products.MethodServices.compare#BomDates" in-map="context" out-map="context" />
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm">
            <container style="col">
                <label text="Compare method dates" type="h5"/>
            </container>
            <container style="col-auto">
                <link url="." text="Print" icon="sym_o_print" target-window="_blank" condition="!!productBomId &amp;&amp; sri.getRenderMode() !== 'html-print'"
                        parameter-map="{productId:productId,productBomId:productBomId,leftReleaseId:leftReleaseId || '',rightReleaseId:rightReleaseId || '',renderMode:'html-print'}"/>
            </container>
        </container>
        <form-single name="BillOfMaterialsCompareParameters" transition=".">
            <field name="productId" from="productId || null">
                <default-field>
                    <hidden />
                </default-field>
            </field>
            <field name="productBomId" from="productBomId || null">
                <default-field>
                    <hidden />
                </default-field>
            </field>
            <field name="organizationPartyId" from="organizationPartyId || null">
                <default-field>
                    <hidden />
                </default-field>
            </field>
            <field name="leftReleaseId">
                <default-field title="Before approval">
                    <drop-down allow-empty="true">
                        <list-options list="releaseOptions" key="${value}" text="${label}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="rightReleaseId">
                <default-field title="After approval">
                    <drop-down allow-empty="true">
                        <list-options list="releaseOptions" key="${value}" text="${label}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="manualLeftDate">
                <default-field title="Before date override" tooltip="Optional">
                    <date-time />
                </default-field>
            </field>
            <field name="manualRightDate">
                <default-field title="After date override" tooltip="Optional">
                    <date-time />
                </default-field>
            </field>
            <field name="submitButton">
                <default-field title="Show report">
                    <submit />
                </default-field>
            </field>
            <field-layout>
                <field-row-big><field-ref name="leftReleaseId"/><field-ref name="rightReleaseId"/><field-ref name="manualLeftDate"/><field-ref name="manualRightDate"/><field-ref name="submitButton"/></field-row-big>
                <fields-not-referenced/>
            </field-layout>
        </form-single>
        <label text="${reportMessage || &quot;&quot;}" type="p" />
        <form-list name="BillOfMaterialsCompareFindings" list="findings || []" skip-form="true" paginate="false" show-csv-button="true">
            <field name="recordId">
                <default-field title="Record">
                    <display />
                </default-field>
            </field>
            <field name="message">
                <default-field title="Finding">
                    <display />
                </default-field>
            </field>
        </form-list>
        <form-list name="BillOfMaterialsCompareRows" list="comparisonRows || []" skip-form="true" paginate="false" show-csv-button="true">
            <field name="lineageId">
                <default-field title="Line lineage">
                    <display />
                </default-field>
            </field>
            <field name="changeType">
                <default-field title="Change">
                    <display />
                </default-field>
            </field>
            <field name="fields">
                <default-field title="Changed fields">
                    <display />
                </default-field>
            </field>
            <field name="beforeProductId">
                <default-field title="Before product">
                    <display />
                </default-field>
            </field>
            <field name="beforeQuantity">
                <default-field title="Before quantity">
                    <display />
                </default-field>
            </field>
            <field name="afterProductId">
                <default-field title="After product">
                    <display />
                </default-field>
            </field>
            <field name="afterQuantity">
                <default-field title="After quantity">
                    <display />
                </default-field>
            </field>
            <columns type="mobile">
                <column><field-ref name="lineageId"/></column>
                <column><field-ref name="changeType"/></column>
            </columns>
        </form-list>
        <form-list name="BomHeaderChanges" list="headerChanges || []" skip-form="true" paginate="false" show-csv-button="true">
            <field name="field">
                <default-field title="Header field">
                    <display />
                </default-field>
            </field>
            <field name="left">
                <default-field title="Before">
                    <display />
                </default-field>
            </field>
            <field name="right">
                <default-field title="After">
                    <display />
                </default-field>
            </field>
            <columns type="mobile">
                <column><field-ref name="field"/></column>
                <column><field-ref name="left"/></column>
            </columns>
        </form-list>
        <form-list name="BomOperationChanges" list="operationChanges || []" skip-form="true" paginate="false" show-csv-button="true">
            <field name="workEffortId">
                <default-field title="Changed operation">
                    <display />
                </default-field>
            </field>
        </form-list>
        <!-- Manufacturing P9: the released work orders of the product, each with its Request amendment (the Changes tab's remap to
            the method as of the later date, amend#ProductionOrder), for production readers in the Manufacturing context; the
            Manufacturing context adds the action, the Mantle verbs check the authority -->
        <section name="ReleasedRunAmendments" condition="appRoot == 'Manufacturing' &amp;&amp; (productId || productBomId)">
            <actions>
                <service-call name="ironstone.manufacturing.AccessServices.get#SharedContext" out-map="manufacturingContext"
                        transaction="force-new" ignore-error="true" in-map="{appRoot:'Manufacturing'}"/>
                <set field="amendProductId" from="productId || ec.entity.find('mantle.product.bom.ProductBom')
                        .condition('productBomId', productBomId).one()?.productId"/>
                <if condition="manufacturingContext?.capabilities?.productionRead &amp;&amp; amendProductId">
                    <service-call name="mantle.work.ProductionServices.find#ProductionOrders" out-map="amendRuns"
                            transaction="force-new" ignore-error="true"
                            in-map="{productId:amendProductId, statusId:'WeApproved,WeInProgress,WeOnHold', pageSize:50}"/>
                </if>
                <set field="amendRunRows" from="(amendRuns?.orderRows || []).filter((row) =&gt; !productBomId ||
                        ec.entity.find('mantle.work.effort.WorkEffort').condition('workEffortId', row.workEffortId).one()?.productBomId == productBomId)"/>
                <set field="canRequestAmendment" from="!!(manufacturingContext?.capabilities?.plan || manufacturingContext?.capabilities?.methodEdit)"/>
                <set field="amendLink" from="manufacturingContext?.sharedLinks?.['WorkOrders/WorkOrderDetail/Changes'] || ''"/>
                <set field="amendDate" from="rightDate || manualRightDate || ''"/>
            </actions>
            <widgets>
                <container-box>
                    <box-header title="Released work orders · ${amendRunRows.length}"/>
                    <box-body-nopad>
                        <label text="No released work order makes this product; a new release reaches only new work orders."
                                type="p" style="q-pa-md m-muted" condition="!amendRunRows.length"/>
                        <form-list name="AmendableRuns" list="amendRunRows" skip-form="true" paginate="false">
                            <field name="workEffortId">
                                <default-field title="Work order"><display text="${workEffortId} · ${workEffortName || ''}"/></default-field>
                            </field>
                            <field name="statusText"><default-field title="Status"><display/></default-field></field>
                            <field name="remaining" align="right"><default-field title="Remaining"><display/></default-field></field>
                            <field name="actions">
                                <default-field title="">
                                    <link url="${amendLink}" text="Request amendment" icon="sym_o_published_with_changes"
                                            link-type="anchor" condition="canRequestAmendment &amp;&amp; amendLink"
                                            parameter-map="{workEffortId:workEffortId, methodDate:amendDate}"/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="workEffortId"/></column>
                                <column><field-ref name="statusText"/><field-ref name="actions"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
