<!-- EquipmentDetail's Maintenance tab under Maintenance (design-maintenance §6 shared records, the Maintenance history pane;
    impl-maintenance P3): the equipment's work orders (Mantle's find#MaintenanceWorkOrders, every status) and its maintenance records,
    each with its work order or, for an open record with none (Manufacturing's request, the baseline's), Adopt for a planner or
    supervisor (adopt#MaintenanceRecord: once; completed history stays as it is); Create work opens New work order for the equipment.
    Renders nothing outside Maintenance. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Maintenance" default-menu-index="6">
    <parameter name="assetId"/>
    <transition-include name="adoptRecord" location="component://mr-boss/template/MaintenanceWorkOrderParts.xml"/>
    <actions>
        <!-- EquipmentDetail's actions read the equipment when it renders with the tab; alone (a reloaded tab, the terminal) it
            reads it here, under Maintenance only -->
        <if condition="appRoot == 'Maintenance' &amp;&amp; maintenanceEquipment == null">
            <service-call name="ironstone.maintenance.EquipmentServices.get#Equipment" in-map="{assetId:assetId}"
                    out-map="maintenanceEquipment" transaction="force-new" ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="found" from="appRoot == 'Maintenance' ? maintenanceEquipment : null"/>
        <if condition="found?.asset &amp;&amp; maintenance.capabilities.workRead">
            <service-call name="ironstone.maintenance.WorkOrderServices.find#WorkOrderRows" out-map="workOrdersFound"
                    transaction="force-new" ignore-error="true" in-map="{assetId:assetId, statusId:'all', pageSize:20}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="equipmentWorkOrders" from="workOrdersFound?.workOrderList || []"/>
        <set field="recordRows" from="found?.maintenanceRecords || []"/>
        <set field="canPlan" from="!!(maintenance?.capabilities?.plan || maintenance?.capabilities?.supervise)"/>
    </actions>
    <widgets>
        <section name="EquipmentMaintenance" condition="found?.asset">
            <widgets>
                <container-box>
                    <box-header title="Work orders"/>
                    <box-toolbar>
                        <link url="${sharedLinks['WorkOrders/NewWorkOrder']}" text="Create work" icon="sym_o_add" link-type="anchor-button"
                                btn-type="primary" parameter-map="{assetId:assetId}" condition="canPlan"/>
                    </box-toolbar>
                    <box-body-nopad>
                        <label text="No work order is open to you for this equipment." type="p" style="m-muted q-pa-sm" condition="!equipmentWorkOrders.length"/>
                        <form-list name="EquipmentWorkOrders" list="equipmentWorkOrders" skip-form="true" paginate="false">
                            <field name="workEffortId">
                                <default-field title="Work order">
                                    <link url="${sharedLinks['WorkOrders/WorkOrderDetail']}" text="${workEffortId}" link-type="anchor"
                                            parameter-map="{workEffortId:workEffortId}"/>
                                </default-field>
                            </field>
                            <field name="workEffortName"><default-field title="Name"><display/></default-field></field>
                            <field name="kindText"><default-field title="Kind"><display/></default-field></field>
                            <field name="dueText"><default-field title="Due"><display/></default-field></field>
                            <field name="statusText"><default-field title="State"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="workEffortId"/><field-ref name="workEffortName"/></column>
                                <column><field-ref name="statusText"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
                <section name="EquipmentRecords" condition="recordRows.length">
                    <widgets>
                        <container-box>
                            <box-header title="Maintenance records"/>
                            <box-body-nopad>
                                <form-list name="EquipmentMaintenanceRecords" list="recordRows" skip-form="true" paginate="false">
                                    <field name="maintenanceDateText"><default-field title="Date"><display/></default-field></field>
                                    <field name="typeText"><default-field title="Type"><display/></default-field></field>
                                    <field name="comments"><default-field title="Notes"><display/></default-field></field>
                                    <field name="statusText"><default-field title="State"><display/></default-field></field>
                                    <field name="workEffortId">
                                        <default-field title="Work order">
                                            <link url="${sharedLinks['WorkOrders/WorkOrderDetail']}" text="${workEffortId}" link-type="anchor"
                                                    parameter-map="{workEffortId:workEffortId}" condition="workEffortId"/>
                                            <link url="adoptRecord" text="Adopt" link-type="hidden-form-link" icon="sym_o_handyman"
                                                    parameter-map="{assetMaintenanceId:assetMaintenanceId}" condition="adoptable &amp;&amp; canPlan"
                                                    confirmation="Make this maintenance record a work order?"/>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column><field-ref name="maintenanceDateText"/><field-ref name="comments"/></column>
                                        <column><field-ref name="statusText"/><field-ref name="workEffortId"/></column>
                                    </columns>
                                </form-list>
                            </box-body-nopad>
                        </container-box>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
