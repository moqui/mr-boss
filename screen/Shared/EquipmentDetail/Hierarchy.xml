<!-- EquipmentDetail's Hierarchy tab under Maintenance (impl-maintenance P2): the equipment it is part of and its parts, those the
    user's maintenance scope reads. Its parent is changed with Edit equipment (a cycle refused in Mantle). Renders nothing outside
    Maintenance. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Hierarchy" default-menu-index="2">
    <parameter name="assetId"/>
    <actions>
        <!-- EquipmentDetail's actions read the equipment when it renders with the tab; alone (a reloaded tab, the terminal) it
            reads it here, under Maintenance only -->
        <if condition="appRoot == 'Maintenance' &amp;&amp; maintenanceEquipment == null">
            <service-call name="ironstone.maintenance.EquipmentServices.get#Equipment" in-map="{assetId:assetId}"
                    out-map="maintenanceEquipment" transaction="force-new" ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="found" from="appRoot == 'Maintenance' ? maintenanceEquipment : null"/>
    </actions>
    <widgets>
        <section name="EquipmentHierarchy" condition="found?.asset">
            <widgets>
                <container-box>
                    <box-header title="Part of"/>
                    <box-body>
                        <link url="${sharedLinks['Equipment/EquipmentDetail']}" text="${found.asset.parentName}" link-type="anchor"
                                parameter-map="{assetId:found.asset.parentAssetId}" condition="found.asset.parentAssetId"/>
                        <label text="It is not part of other equipment you can see." type="p" style="m-muted"
                                condition="!found.asset.parentAssetId"/>
                    </box-body>
                </container-box>
                <container-box>
                    <box-header title="Its parts"/>
                    <box-body-nopad>
                        <form-list name="EquipmentParts" list="found.children" skip-form="true" paginate="false">
                            <field name="assetName">
                                <default-field title="Equipment">
                                    <link url="${sharedLinks['Equipment/EquipmentDetail']}" text="${assetName}" link-type="anchor"
                                            parameter-map="{assetId:assetId}"/>
                                </default-field>
                            </field>
                            <field name="serialNumber"><default-field title="Serial"><display/></default-field></field>
                            <field name="statusText"><default-field title="Status"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="assetName"/></column>
                                <column><field-ref name="statusText"/></column>
                            </columns>
                        </form-list>
                        <label text="No parts are recorded under it." type="p" style="m-muted q-pa-md" condition="!found.children?.length"/>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
