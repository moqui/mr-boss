<!-- ReturnDetail (design-crosscut §3.18; style-guide §3.3 Detail): one return, mounted by Accounting at
    Accounting/Records/ReturnDetail with the Accounting context only (design-accounting §14 ReturnDetail): its items with
    what was authorized, received, accepted, rejected, settled and is eligible now, its credits and refunds, and Settle
    (mantle.order.ReturnServices.settle#Return after its preview), with a credit without receipt for an approver.
    Physical receipt stays Warehouse's. Warehouse mounts it at Warehouse/Returns/ReturnDetail (crosscut §3.18 Warehouse
    row, impl-warehouse P14): a return of the user's facilities, its items with authorized, received or sent, accepted,
    rejected and settled quantity, the items it may still take, its shipments, inspections, settlement read only, files and
    conversation (ironstone.warehouse.ReturnServices.get#ReturnDetail; template/WarehouseReturnDetail.xml). Purchasing mounts
    it at Purchasing/Returns/ReturnDetail (crosscut §3.18 Purchasing row, impl-purchasing P8): a supplier return of the user's
    organizations, authorized with the supplier's RMA, its eligible receipts by receipt and lot, items, outbound shipment,
    replacement orders and the credit read only (ironstone.purchasing.ReturnServices.get#ReturnDetail;
    template/PurchasingReturnDetail.xml). Customer Service mounts it at CustomerService/Returns/ReturnDetail (crosscut §3.18
    Customer Service row, impl-customer-service P9): a customer return of the user's organizations and customers, authorized,
    labelled, closed or cancelled there, received for W and settled for F (ironstone.customerservice.ReturnServices
    get#ReturnDetail; template/CustomerServiceReturnDetail.xml). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Return"
        default-menu-include="false">
    <parameter name="returnId" required="true"/>
    <parameter name="organizationPartyId"/>
    <transition-include name="settleReturn" location="component://mr-boss/template/AccountingRecords.xml"/>
    <transition-include name="returnChoices" location="component://mr-boss/template/WarehouseReturnParts.xml"/>
    <transition-include name="addReturnItem" location="component://mr-boss/template/WarehouseReturnParts.xml"/>
    <transition-include name="requestReturn" location="component://mr-boss/template/WarehouseReturnParts.xml"/>
    <transition-include name="createReturnShipment" location="component://mr-boss/template/WarehouseReturnParts.xml"/>
    <!-- Purchasing (impl-purchasing P8): the supplier return's actions -->
    <transition-include name="purchasingReturnChoices" location="component://mr-boss/template/PurchasingReturnDetail.xml"/>
    <transition-include name="purchasingAddReceipt" location="component://mr-boss/template/PurchasingReturnDetail.xml"/>
    <transition-include name="purchasingAuthorizeReturn" location="component://mr-boss/template/PurchasingReturnDetail.xml"/>
    <transition-include name="purchasingCancelReturn" location="component://mr-boss/template/PurchasingReturnDetail.xml"/>
    <transition-include name="purchasingReplaceReturn" location="component://mr-boss/template/PurchasingReturnDetail.xml"/>
    <!-- Customer Service (impl-customer-service P9): the customer return's actions -->
    <transition-include name="csReturnChoices" location="component://mr-boss/template/CustomerServiceReturnDetail.xml"/>
    <transition-include name="csAuthorizeReturn" location="component://mr-boss/template/CustomerServiceReturnDetail.xml"/>
    <transition-include name="csRequestException" location="component://mr-boss/template/CustomerServiceReturnDetail.xml"/>
    <transition-include name="csDecideException" location="component://mr-boss/template/CustomerServiceReturnDetail.xml"/>
    <transition-include name="csSaveReturnLine" location="component://mr-boss/template/CustomerServiceReturnDetail.xml"/>
    <transition-include name="csAssignReturn" location="component://mr-boss/template/CustomerServiceReturnDetail.xml"/>
    <transition-include name="csIssueLabel" location="component://mr-boss/template/CustomerServiceReturnDetail.xml"/>
    <transition-include name="csCloseRemainder" location="component://mr-boss/template/CustomerServiceReturnDetail.xml"/>
    <transition-include name="csCancelReturn" location="component://mr-boss/template/CustomerServiceReturnDetail.xml"/>
    <transition-include name="csReceiveReturn" location="component://mr-boss/template/CustomerServiceReturnDetail.xml"/>
    <transition-include name="csSettleReturn" location="component://mr-boss/template/CustomerServiceReturnDetail.xml"/>
    <transition-include name="csSendRma" location="component://mr-boss/template/CustomerServiceReturnDetail.xml"/>
    <actions>
        <if condition="appRoot == 'Accounting'">
            <service-call name="ironstone.accounting.ReturnScreenServices.get#ReturnContext"
                    in-map="{returnId:returnId, organizationPartyId:organizationPartyId}"
                    out-map="context"
                    transaction="force-new"
                    ignore-error="true"/>
        </if>
        <if condition="appRoot == 'Warehouse'">
            <service-call name="ironstone.warehouse.ReturnServices.get#ReturnDetail" in-map="{returnId:returnId}"
                    out-map="context" transaction="force-new" ignore-error="true"/>
            <set field="returnFound" from="!!returnFound"/>
        </if>
        <if condition="appRoot == 'CustomerService'">
            <service-call name="ironstone.customerservice.ReturnServices.get#ReturnDetail"
                    in-map="{appRoot:appRoot, returnId:returnId}" out-map="context" transaction="force-new" ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
            <set field="returnFound" from="!!returnFound"/>
        </if>
        <if condition="appRoot == 'Purchasing'">
            <service-call name="ironstone.purchasing.ReturnServices.get#ReturnDetail"
                    in-map="{appRoot:appRoot, returnId:returnId}" out-map="context" transaction="force-new" ignore-error="true"/>
            <set field="returnFound" from="!!returnFound"/>
        </if>
    </actions>
    <widgets>
        <section-include name="AccountingReturn" location="component://mr-boss/template/AccountingRecords.xml"/>
        <section-include name="WarehouseReturn" location="component://mr-boss/template/WarehouseReturnDetail.xml"/>
        <section-include name="PurchasingReturn" location="component://mr-boss/template/PurchasingReturnDetail.xml"/>
        <section-include name="CustomerServiceReturn" location="component://mr-boss/template/CustomerServiceReturnDetail.xml"/>
        <label text="This return is not available in this app." type="p"
                condition="appRoot != 'Accounting' &amp;&amp; appRoot != 'Warehouse' &amp;&amp; appRoot != 'Purchasing'
                    &amp;&amp; appRoot != 'CustomerService'"/>
    </widgets>
</screen>
