<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Agreements"
        default-menu-index="5">
    <parameter name="organizationPartyId"/>
    <parameter name="customerPartyId"/>
    <parameter name="appRoot"/>
    <actions>
        <!-- Customer360's actions read the customer when it renders with the tab -->
        <if condition="customerDetail == null &amp;&amp; organizationPartyId">
            <service-call name="ironstone.accounting.ReceivableServices.get#CustomerContext"
                    in-map="context"
                    out-map="context"
                    transaction="force-new"
                    ignore-error="true"/>
        </if>
    </actions>
    <widgets>
        <section name="CustomerTabAgreements" condition="customerFound">
            <widgets>
                <label text="Agreements" type="h6"/>
                <form-list name="CustomerAgreements" list="customerDetail.agreements" skip-form="true" paginate="false">
                    <field name="agreementId">
                        <header-field title="Agreement"/>
                        <default-field>
                            <display/>
                        </default-field>
                    </field>
                    <field name="description">
                        <header-field title="Description"/>
                        <default-field>
                            <display/>
                        </default-field>
                    </field>
                    <field name="fromDate">
                        <header-field title="From"/>
                        <default-field>
                            <display text="${fromDateText || ''}"/>
                        </default-field>
                    </field>
                    <field name="thruDate">
                        <header-field title="Through"/>
                        <default-field>
                            <display text="${thruDateText || ''}"/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="agreementId"/>
                            <field-ref name="description"/>
                        </column>
                        <column>
                            <field-ref name="fromDate"/>
                            <field-ref name="thruDate"/>
                        </column>
                    </columns>
                </form-list>
                <label text="No agreements are linked to this customer and organization."
                        type="p"
                        style="m-muted"
                        condition="!customerDetail.agreements.length"/>
            </widgets>
        </section>
    </widgets>
</screen>
