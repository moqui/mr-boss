<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Files"
        default-menu-index="8">
    <parameter name="organizationPartyId"/>
    <parameter name="customerPartyId"/>
    <parameter name="appRoot"/>
    <actions>
        <!-- Customer360's actions read the customer when it renders with the tab -->
        <if condition="customerDetail == null &amp;&amp; organizationPartyId">
            <service-call name="ironstone.accounting.ReceivableServices.get#CustomerContext"
                    in-map="context"
                    out-map="context"
                    transaction="force-new"
                    ignore-error="true"/>
        </if>
    </actions>
    <widgets>
        <section name="CustomerTabFiles" condition="customerFound">
            <widgets>
                <label text="Files" type="h6"/>
                <record-files id="AccountingCustomerFiles" record-entity="mantle.party.Party" record-id="${customerPartyId}"/>
            </widgets>
        </section>
    </widgets>
</screen>
