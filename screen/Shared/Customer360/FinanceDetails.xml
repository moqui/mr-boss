<!-- Customer360's Finance details tab: the customer's bank accounts, identifications and tax registrations
    (template/AccountingFinanceDetails.xml, shared with Supplier360). It reads the customer when the client loads the tab
    alone. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Finance details"
        default-menu-index="7">
    <parameter name="organizationPartyId"/>
    <parameter name="customerPartyId"/>
    <parameter name="appRoot"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition-include name="saveIdentification" location="component://mr-boss/template/AccountingFinanceDetails.xml"/>
    <transition-include name="saveTaxRegistration" location="component://mr-boss/template/AccountingFinanceDetails.xml"/>
    <transition-include name="saveFinanceBank" location="component://mr-boss/template/AccountingFinanceDetails.xml"/>
    <actions>
        <!-- Customer360's actions read the customer when it renders with the tab -->
        <if condition="customerDetail == null &amp;&amp; organizationPartyId">
            <service-call name="ironstone.accounting.ReceivableServices.get#CustomerContext"
                    in-map="context"
                    out-map="context"
                    transaction="force-new"
                    ignore-error="true"/>
        </if>
        <set field="financeDetail" from="Object.assign({}, customerDetail ?? {}, {partyName:customerDetail?.customerName})"/>
        <set field="financePartyId" from="customerPartyId"/>
        <set field="financeSide" value="customer"/>
        <set field="financeFound" from="customerFound"/>
    </actions>
    <widgets>
        <section-include name="FinanceDetails" location="component://mr-boss/template/AccountingFinanceDetails.xml"/>
    </widgets>
</screen>
