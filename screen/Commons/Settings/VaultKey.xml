<!-- Settings › Vault key (mr-moqui plans/Vault-Instances.md §3.5, §5): the user's personal vault key, set up here with its recovery
    code (shown once, part of it typed back), unlocked, its passphrase changed, opened with the recovery code, or made again when
    both are lost; its fingerprint; the keys this user compared with their owners; and the devices that remember the key (the
    desktop and mobile apps, none in a browser). The component is Commons/Vault.qvue in its keyView: the same session and the
    same transitions as Commons › Vault, taken in here. Making, fetching or changing the key needs a strong, recent sign-in (a
    password and a second factor, SSO or a paired device): the framework's vault services refuse otherwise, and the page asks the
    user to confirm who they are (moqui.reauth) or to set up a second factor in Account. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Vault key" default-menu-index="7" render-modes="vue,qvue,tui" server-static="vue,qvue" menu-image="sym_o_key" menu-image-type="icon">


    <transition-include name="setup" location="component://mr-boss/screen/Commons/Vault.xml"/>
    <transition-include name="userChoices" location="component://mr-boss/screen/Commons/Vault.xml"/>
    <transition-include name="userNames" location="component://mr-boss/screen/Commons/Vault.xml"/>

    <widgets>
        <render-mode><text type="qvue" location="component://mr-boss/screen/Commons/Vault.qvue" template="false"/>
            <text type="tui" location="component://mr-boss/screen/Commons/Settings/VaultKey.tui.json" template="false"/></render-mode>
    </widgets>
</screen>
