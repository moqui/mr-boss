<!-- Preferences (design-drawers-commons.md §11; style-guide §3.9 Settings): Appearance (dark mode QUASAR_DARK, the app menu
    QUASAR_LEFT_OPEN, density SHELL_DENSITY, the start app SHELL_START_APP; ironstone.commons.CommonsServices.set#Appearance) and the
    Keymap: every binding of the shell and of the keymap providers of the apps the user may open, as editable rows whose
    keys change the KEYMAP preference (JSON {scope: {action or keys: keys}}, set#KeymapOverride), which the shell reads when
    a page loads; and CalendarDefaults: how the calendar opens and new events start (the default view, the first day of the week, the
    working days and hours, the length and reminder of a new event, the default calendar, declined events and week numbers;
    ironstone.commons.CalendarServices.set#CalendarDefaults, which Calendar.qvue reads); and MailDefaults: where the reading pane goes,
    whether archive opens the next conversation, when an open message is marked read, how long Undo send waits, whether
    pictures in mail show at once, threads or messages, the default account, where the signature goes and the two phone
    swipe actions (org.moqui.comms.MailSettingsServices.set#MailDefaults, the preferences the Inbox and Compose read). Sound
    defaults come later. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Preferences" default-menu-index="2" server-static="qvt" menu-image="sym_o_tune" menu-image-type="icon">

    <!-- the page loads again, so the shell takes dark mode and the menu -->
    <transition name="saveAppearance">
        <actions><script><![CDATA[
            ec.service.sync().name('ironstone.commons.CommonsServices.set#Appearance').parameters({darkMode: darkMode, leftOpen: leftOpen,
                density: density, startApp: startApp}).call()
            ec.web.sendJsonResponse(ec.message.hasError() ? {} : {redirectUrl: '/qapps/Commons/Settings/Preferences',
                messageInfos: [{type: 'success', message: ec.l10n.localize('Appearance saved')}]})
        ]]></script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="saveCalendarDefaults">
        <actions>
            <service-call name="ironstone.commons.CalendarServices.set#CalendarDefaults" out-map="calendarOut" in-map="{view:view, weekStart:weekStart, workStart:workStart,
                    workEnd:workEnd, workDays:(workDays ?? null), defaultDuration:defaultDuration, defaultReminder:(defaultReminder ?? null),
                    showDeclined:(view != null ? (showDeclined || 'N') : null), showWeekNumbers:(view != null ? (showWeekNumbers || 'N') : null),
                    defaultCalendarId:(defaultCalendarId || null)}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(calendarOut.message, 'success')</script></if>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="saveMailDefaults">
        <service-call name="org.moqui.comms.MailSettingsServices.set#MailDefaults" in-map="{readingPane:readingPane, archiveOpensNext:(archiveOpensNext == 'Y' ? 'Y' : 'N'),
                markReadSeconds:markReadSeconds, undoSeconds:undoSeconds, remoteImages:(remoteImages == 'always' ? 'always' : 'ask'),
                conversationView:conversationView, defaultAccountId:defaultAccountId, signaturePlacement:signaturePlacement,
                swipeLeft:swipeLeft, swipeRight:swipeRight}"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">Mail settings saved</message></if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="setKey">
        <service-call name="ironstone.commons.CommonsServices.set#KeymapOverride" in-map="{scope:scope, id:id, keys:keys, defaultKeys:defaultKeys}"/>
        <actions><message type="success">Saved; the keys apply when the next page loads</message></actions>
        <default-response url="."/>
    </transition>
    <transition name="resetKey">
        <service-call name="ironstone.commons.CommonsServices.set#KeymapOverride" in-map="{scope:scope, id:id, keys:''}"/>
        <default-response url="."/>
    </transition>

    <actions>
        <script><![CDATA[
            const shellData = sri.getShellData()
            const apps = shellData && Array.isArray(shellData.apps) ? shellData.apps : []
            const keymaps = []
            for (const app of apps) for (const map of (app.providers && app.providers.keymaps) || [])
                keymaps.push(Object.assign({}, map, {appTitle: app.title || app.name}))
            appKeymaps = keymaps
            appOptions = apps.map((app) => ({name: app.name, title: app.title || app.name}))
            appearance = {darkMode: ec.user.getPreference('QUASAR_DARK') == 'true' ? 'Y' : 'N',
                leftOpen: ec.user.getPreference('QUASAR_LEFT_OPEN') == 'true' ? 'Y' : 'N',
                density: ec.user.getPreference('SHELL_DENSITY') || 'comfortable', startApp: ec.user.getPreference('SHELL_START_APP') || ''}
        ]]></script>
        <service-call name="ironstone.commons.CommonsServices.get#KeymapRows" in-map="{keymaps:appKeymaps}" out-map="context"/>
        <!-- the calendar defaults and the user's own personal calendars, one of which is the default -->
        <service-call name="ironstone.commons.CalendarServices.get#CalendarDefaults" out-map="calendarDefaultsOut"/>
        <service-call name="mantle.work.CalendarServices.get#UserCalendars" out-map="userCalendarsOut"/>
        <service-call name="org.moqui.comms.MailSettingsServices.get#MailDefaults" out-map="mailDefaultsOut"/>
        <script><![CDATA[
            const defaults = calendarDefaultsOut.defaults || {}
            calendarDefaults = {view: defaults.view, weekStart: String(defaults.weekStart ?? 0), workStart: defaults.workStart, workEnd: defaults.workEnd,
                workDays: (defaults.workDays || []).map(String), defaultDuration: String(defaults.defaultDuration || 60), defaultReminder: defaults.defaultReminder || '',
                showDeclined: defaults.showDeclined ? 'Y' : 'N', showWeekNumbers: defaults.showWeekNumbers ? 'Y' : 'N',
                defaultCalendarId: userCalendarsOut.defaultCalendarId || ''}
            personalCalendarOptions = Array.from(userCalendarsOut.calendarList || []).filter((calendar) => calendar.isOwner && calendar.calendarKindEnumId === 'CalkPersonal')
                    .map((calendar) => ({key: calendar.calendarId, text: calendar.calendarName}))
        ]]></script>
    </actions>

    <widgets>
        <label type="h5" text="Preferences" style="q-mt-none q-mb-sm"/>
        <container-row>
            <row-col lg="5" md="6">
                <container-box><box-header title="Appearance"/><box-body>
                    <form-single name="Appearance" transition="saveAppearance" map="appearance">
                        <field name="darkMode"><default-field title="Theme"><check><option key="Y" text="Dark mode"/></check></default-field></field>
                        <field name="leftOpen"><default-field title="App menu"><check><option key="Y" text="Keep it open"/></check></default-field></field>
                        <field name="density"><default-field title="Density"><radio>
                            <option key="comfortable" text="Comfortable"/><option key="compact" text="Compact"/></radio></default-field></field>
                        <field name="startApp"><default-field title="Start in">
                            <drop-down allow-empty="true"><list-options list="appOptions" key="${name}" text="${title}"/></drop-down></default-field></field>
                        <field name="saveButton"><default-field title="Save"><submit/></default-field></field>
                    </form-single>
                    <label type="p" text="Dark mode, the menu and density apply when saved; the app to start in applies the next time you open the apps. For the color scheme, fonts, text sizes and the rest, open Appearance in the account menu." style="text-caption m-muted q-mb-none"/>
                </box-body></container-box>
                <container-box><box-header title="Calendar"/><box-body>
                    <form-single name="CalendarDefaults" transition="saveCalendarDefaults" map="calendarDefaults">
                        <field name="view"><default-field title="Opens in"><drop-down>
                            <option key="day" text="Day"/><option key="workweek" text="Work week"/><option key="week" text="Week"/><option key="month" text="Month"/>
                            <option key="agenda" text="Agenda"/></drop-down></default-field></field>
                        <field name="weekStart"><default-field title="Week starts on"><drop-down>
                            <option key="0" text="Sunday"/><option key="1" text="Monday"/><option key="6" text="Saturday"/></drop-down></default-field></field>
                        <field name="workDays"><default-field title="Working days"><check>
                            <option key="1" text="Mon"/><option key="2" text="Tue"/><option key="3" text="Wed"/><option key="4" text="Thu"/><option key="5" text="Fri"/>
                            <option key="6" text="Sat"/><option key="0" text="Sun"/></check></default-field></field>
                        <field name="workStart"><default-field title="Work starts"><date-time type="time" format="HH:mm"/></default-field></field>
                        <field name="workEnd"><default-field title="Work ends"><date-time type="time" format="HH:mm"/></default-field></field>
                        <field name="defaultDuration"><default-field title="A new event lasts"><drop-down>
                            <option key="15" text="15 minutes"/><option key="30" text="30 minutes"/><option key="45" text="45 minutes"/><option key="60" text="1 hour"/>
                            <option key="90" text="1½ hours"/><option key="120" text="2 hours"/></drop-down></default-field></field>
                        <field name="defaultReminder"><default-field title="Remind me"><drop-down allow-empty="true">
                            <option key="0" text="At the start"/><option key="5" text="5 minutes before"/><option key="10" text="10 minutes before"/>
                            <option key="15" text="15 minutes before"/><option key="30" text="30 minutes before"/><option key="60" text="1 hour before"/>
                            <option key="1440" text="1 day before"/></drop-down></default-field></field>
                        <field name="defaultCalendarId"><default-field title="New events go in">
                            <drop-down><list-options list="personalCalendarOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                        <field name="showDeclined"><default-field title=""><check><option key="Y" text="Show the events I declined"/></check></default-field></field>
                        <field name="showWeekNumbers"><default-field title=""><check><option key="Y" text="Show week numbers"/></check></default-field></field>
                        <field name="saveButton"><default-field title="Save"><submit/></default-field></field>
                        <field-layout>
                            <field-row><field-ref name="view"/><field-ref name="weekStart"/></field-row>
                            <field-ref name="workDays"/>
                            <field-row><field-ref name="workStart"/><field-ref name="workEnd"/></field-row>
                            <field-row><field-ref name="defaultDuration"/><field-ref name="defaultReminder"/></field-row>
                            <field-ref name="defaultCalendarId"/>
                            <field-row><field-ref name="showDeclined"/><field-ref name="showWeekNumbers"/></field-row>
                            <field-ref name="saveButton"/>
                        </field-layout>
                    </form-single>
                    <label type="p" text="Your time zone is on your Account; the calendar shows every time in it." style="text-caption m-muted q-mb-none q-mt-sm"/>
                </box-body></container-box>
                <container-box><box-header title="Mail"/><box-body>
                    <form-single name="MailDefaults" transition="saveMailDefaults" map="mailDefaultsOut.mailDefaults">
                        <field name="readingPane"><default-field title="Reading pane"><radio>
                            <option key="right" text="On the right"/><option key="bottom" text="Below the list"/><option key="off" text="Off: open a message on its own"/></radio></default-field></field>
                        <field name="markReadSeconds"><default-field title="Mark a message read"><drop-down>
                            <option key="0" text="As soon as it opens"/><option key="2" text="After 2 seconds"/><option key="5" text="After 5 seconds"/>
                            <option key="10" text="After 10 seconds"/><option key="30" text="After 30 seconds"/></drop-down></default-field></field>
                        <field name="undoSeconds"><default-field title="Undo send"><drop-down>
                            <option key="0" text="Off: send at once"/><option key="5" text="5 seconds"/><option key="10" text="10 seconds"/>
                            <option key="20" text="20 seconds"/><option key="30" text="30 seconds"/></drop-down></default-field></field>
                        <field name="archiveOpensNext"><default-field title=""><check><option key="Y" text="After archive or delete, open the next conversation"/></check></default-field></field>
                        <field name="remoteImages"><default-field title="Pictures in mail"><radio>
                            <option key="ask" text="Ask first (senders can tell when you read their mail)"/><option key="always" text="Always show them"/></radio></default-field></field>
                        <field name="conversationView"><default-field title="Conversation view"><radio>
                            <option key="threads" text="Threads"/><option key="messages" text="Messages"/></radio></default-field></field>
                        <field name="defaultAccountId"><default-field title="Default account"><drop-down allow-empty="true">
                            <list-options list="mailDefaultsOut.accountOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                        <field name="signaturePlacement"><default-field title="Signature"><radio>
                            <option key="above" text="Above the quote"/><option key="below" text="Below the quote"/></radio></default-field></field>
                        <field name="swipeLeft"><default-field title="Swipe left"><drop-down>
                            <option key="archive" text="Archive"/><option key="trash" text="Delete"/><option key="read" text="Mark read"/>
                            <option key="unread" text="Mark unread"/><option key="flag" text="Flag"/><option key="spam" text="Report spam"/></drop-down></default-field></field>
                        <field name="swipeRight"><default-field title="Swipe right"><drop-down>
                            <option key="archive" text="Archive"/><option key="trash" text="Delete"/><option key="read" text="Mark read"/>
                            <option key="unread" text="Mark unread"/><option key="flag" text="Flag"/><option key="spam" text="Report spam"/></drop-down></default-field></field>
                        <field name="saveButton"><default-field title="Save"><submit/></default-field></field>
                        <field-layout>
                            <field-ref name="readingPane"/><field-ref name="conversationView"/>
                            <field-row><field-ref name="markReadSeconds"/><field-ref name="undoSeconds"/></field-row>
                            <field-ref name="archiveOpensNext"/><field-ref name="remoteImages"/>
                            <field-ref name="defaultAccountId"/><field-ref name="signaturePlacement"/>
                            <field-row><field-ref name="swipeLeft"/><field-ref name="swipeRight"/></field-row>
                            <field-ref name="saveButton"/>
                        </field-layout>
                    </form-single>
                    <label type="p" text="Accounts, signatures, rules and the automatic reply are in Comms settings." style="text-caption m-muted q-mb-none q-mt-sm"/>
                </box-body></container-box>
            </row-col>
            <row-col lg="7" md="6">
                <container-box><box-header title="Keyboard shortcuts"/><box-body-nopad>
                    <label type="p" text="Keys like Mod+K (Ctrl, or Cmd on a Mac), Ctrl+Shift+A, ? or a chord such as g c. A changed key applies when the next page loads; ? shows the keys on now." style="text-caption m-muted q-pa-sm q-mb-none"/>
                    <form-list name="Keymap" list="keyRows" transition="setKey" paginate="false">
                        <field name="scope"><default-field><hidden/></default-field></field>
                        <field name="id"><default-field><hidden/></default-field></field>
                        <field name="defaultKeys"><default-field><hidden/></default-field></field>
                        <field name="label"><default-field title="Action"><display/></default-field></field>
                        <field name="where"><default-field title="From"><display/></default-field></field>
                        <field name="keys"><header-field title="Keys"/><default-field title=""><text-line size="10"/></default-field></field>
                        <field name="saveButton"><default-field title=""><submit text="Save"/></default-field></field>
                        <field name="resetKey"><conditional-field condition="overridden" title="">
                            <link url="resetKey" link-type="hidden-form-link" text="Reset to ${defaultKeys}" parameter-map="{scope:scope, id:id}"/></conditional-field>
                            <default-field title=""><label text="Default" style="m-muted"/></default-field></field>
                        <columns type="mobile">
                            <column><field-ref name="label"/><field-ref name="where"/></column>
                            <column><field-ref name="keys"/><field-ref name="saveButton"/></column>
                        </columns>
                    </form-list>
                </box-body-nopad></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
