    return rows.slice(1).map((r) => {
        const get = (i) => (i >= 0 && r[i] != null ? r[i] : '');
        const group = get(at.group);
        return toEntry(get(at.title), get(at.username), get(at.password), get(at.url), get(at.notes), get(at.totp), group && group !== 'Root' ? [group] : []);
