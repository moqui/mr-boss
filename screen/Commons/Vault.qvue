    const header = rows[0].map((name) => name.trim().toLowerCase());
    const col = (...names) => header.findIndex((name) => names.includes(name));
    const at = { title: col('title', 'account', 'name', 'entry'), username: col('username', 'user name', 'login name', 'login', 'login_username'),
        password: col('password', 'login_password'), url: col('url', 'web site', 'website', 'login_uri'), notes: col('notes', 'comments', 'comment'),
        totp: col('totp', 'otp', 'login_totp'), group: col('group', 'folder') };
