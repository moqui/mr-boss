function parseImport(text) {
    const trimmed = String(text || '').replace(/^﻿/, '').trim();
    if (trimmed.startsWith('{')) {
        let json;
        try { json = JSON.parse(trimmed); } catch (err) { throw new Error(t('The file is not JSON')); }
        if (json.format === 'moqui-vault-export') return { format: 'export', label: t('Encrypted vault export'), export: json, items: [] };
        if (json.encrypted) throw new Error(t('This Bitwarden export is encrypted. Export from Bitwarden again as JSON, not encrypted, to import it here.'));
        if (Array.isArray(json.items)) return { format: 'bitwarden', label: 'Bitwarden (JSON)', items: fromBitwarden(json) };
