<!-- Commons Vault (Vault.xml; mr-moqui plans/Vault-Instances.md §3.1 to §3.12, V3), and the user's vault key under Settings
    (Settings/VaultKey.xml shows this component too: keyView). The vaults of both locks in a column (a locked one shows its lock
    and its item count, which is all the server knows), the open vault's items by type with a client-side search over names,
    websites, tags and the fields that are not masked, and an item's page: its fields, a masked value shown only when asked for
    (Show) or copied (cleared from the clipboard after boss/vault@clipboard-seconds), its websites, tags and notes, its history,
    Edit, Send a copy, Copy to another vault and Delete. New vault asks for the lock: shared-key (opened by the user's vault
    key, can be shared) or single-secret (§3.11: the warning in its exact words, how to keep the password or key, a password
    typed twice and checked here, or a generated key whose last 8 characters are typed back, and the box "I have stored it
    outside this server"). Members shows each member's key fingerprint (six words, computed in the worker from the key the
    server gave), which the user compares by another channel before adding someone, before giving a member's changed key access
    again, and before trusting a vault another user made. Removing a member rotates the vault key (and offers to re-encrypt every
    item now). Items sent to the user are filed into a vault here. Import reads a Bitwarden JSON export, a KeePass XML or CSV
    export, or an encrypted vault export, in the browser; Export writes an encrypted export file made here.

    The session (window.BossVaultSession, one per page) holds the vault module's client and what is shown of the open vaults:
    names, types, websites, tags and the fields that are not masked. Masked values are opened from the worker one item at a
    time when asked for. Commons › Contacts reads the session's open contact items (Contacts/VaultContacts.qvue). Lock, the
    idle time (boss/vault@idle-minutes, any use of this page counts) and closing the tab drop every key and all of it.
    Inputs are plain q-inputs: no draft of a value is kept. -->
<template><div class="boss-vault">
    <div v-if="S.failed && !S.config" class="q-pa-lg text-center">
        <q-icon name="sym_o_error" size="40px" color="negative"></q-icon>
        <div class="text-h6 q-mt-sm">{{t('The vault could not start')}}</div>
        <div class="text-body2 m-muted">{{S.failed}}</div>
        <q-btn flat no-caps color="primary" class="q-mt-sm" :label="t('Try again')" @click="start"></q-btn>
    </div>
    <div v-else-if="!S.config || !S.personal" class="q-pa-md">
        <q-skeleton type="text" width="30%" class="text-h5"></q-skeleton>
        <q-skeleton type="rect" height="200px" class="q-mt-md"></q-skeleton>
    </div>

    <!-- ===== Admin › Security › Recovery keys ===== -->
    <template v-else-if="recoveryView">
        <div class="row items-center q-mb-sm q-gutter-x-sm">
            <div class="col text-h5">{{t('Recovery keys')}}</div>
            <q-chip v-if="S.personal.hasKey" dense square :class="S.unlocked ? 'm-tonal text-positive' : 'm-tonal text-grey-8'" :icon="S.unlocked ? 'sym_o_lock_open' : 'sym_o_lock'">{{S.unlocked ? t('Your vault key is unlocked') : t('Your vault key is locked')}}</q-chip>
            <q-btn v-if="anyUnlocked" unelevated no-caps class="m-btn-tonal" icon="sym_o_lock" :label="t('Lock')" @click="lockNow"></q-btn>
            <q-btn unelevated no-caps color="primary" icon="sym_o_add" :label="t('New recovery key')" :disable="!S.config.recoveryHolder || !S.personal.hasKey" @click="openMakeKey">
                <q-tooltip v-if="!S.config.recoveryHolder">{{t('Making a recovery key needs the vault recovery permission, which an administrator grants through a group.')}}</q-tooltip></q-btn>
        </div>
        <div class="text-body2 m-muted q-mb-md">{{t('The organization\'s recovery keys give a member of a shared vault with recovery on their vault back after they lost both their key passphrase and their recovery code. Each key is split among its holders: a recovery takes as many of them as the key needs, each in their own browser. A key used for a recovery was rebuilt whole in one browser, so it is replaced.')}}</div>
        <div v-if="!S.recoveryKeys.length" class="text-body2 m-muted q-pa-md">{{t('No recovery keys yet.')}}</div>
        <q-list v-else bordered separator class="rounded-borders boss-vault-recovery-keys">
            <q-item v-for="key in S.recoveryKeys" :key="key.recoveryKeyId" :data-key="key.recoveryKeyId">
                <q-item-section>
                    <q-item-label class="row items-center q-gutter-x-sm">
                        <span class="text-weight-medium">{{fill(t('{k} of {n} holders'), {k: key.record.k, n: key.record.n})}}</span>
                        <q-chip v-if="key.used" dense square icon="sym_o_warning" class="m-tonal text-warning q-my-none">{{t('Used, replace')}}</q-chip>
                        <q-chip v-else dense square class="m-tonal text-positive q-my-none">{{t('Active')}}</q-chip>
                    </q-item-label>
                    <q-item-label caption>{{keptFor(key)}} · {{fill(t('Made by {name}'), {name: nameOf(key.record.maker_user_id)})}}<span v-if="key.usedDate"> · {{t('Used')}} {{dateText(key.usedDate)}}</span></q-item-label>
                    <q-item-label caption>{{t('Holders')}}: <span v-for="(holder, i) in key.holders" :key="holder.userId">{{i ? ', ' : ''}}{{nameOf(holder.userId)}}<span v-if="!holder.keyActive" class="text-warning"> ({{t('key replaced: their share no longer opens')}})</span></span></q-item-label>
                    <q-item-label caption class="m-muted">{{key.recoveryKeyId}}</q-item-label>
                </q-item-section>
                <q-item-section side>
                    <q-btn flat dense no-caps size="sm" color="primary" :label="t('Start a recovery')" :disable="key.used || !holdsShare(key)" @click="openStartRecovery(key)"></q-btn>
                </q-item-section>
            </q-item>
        </q-list>
        <div class="text-subtitle1 text-weight-medium q-mt-lg">{{t('Recoveries')}}</div>
        <div v-if="!S.config.recoveryHolder" class="text-body2 m-muted">{{t('The recoveries in progress show to the holders of a recovery key.')}}</div>
        <div v-else-if="!S.recoverySessions.length" class="text-body2 m-muted">{{t('No recovery is in progress.')}}</div>
        <q-list v-else bordered separator class="rounded-borders boss-vault-recoveries">
            <q-item v-for="row in S.recoverySessions" :key="row.recoverySessionId" :data-session="row.recoverySessionId">
                <q-item-section>
                    <q-item-label>{{fill(t('{member}\'s new key, for vault {vault}'), {member: nameOf(row.session.subject_user_id), vault: row.vaultName || row.session.vault_id})}}</q-item-label>
                    <q-item-label caption>{{fill(t('Started by {name}'), {name: nameOf(row.session.holder_user_id)})}} · {{t('New key')}} <span class="boss-vault-words">{{row.subjectFingerprint}}</span></q-item-label>
                    <q-item-label caption>{{t('Shares sealed')}}: {{(row.deliveredBy || []).map((id) => nameOf(id)).join(', ') || t('none yet')}}</q-item-label>
                </q-item-section>
                <q-item-section side><div class="row no-wrap q-gutter-x-xs">
                    <q-btn v-if="row.session.holder_user_id !== S.personal.userId && !(row.deliveredBy || []).includes(S.personal.userId)" unelevated dense no-caps size="sm" color="primary"
                            :label="t('Seal my share')" :loading="recovery.busy === row.recoverySessionId" @click="submitShare(row)"></q-btn>
                    <q-btn v-if="row.session.holder_user_id === S.personal.userId" unelevated dense no-caps size="sm" color="primary" :label="t('Finish')"
                            :loading="recovery.busy === row.recoverySessionId" @click="submitFinish(row)"></q-btn>
                    <q-btn flat dense no-caps size="sm" color="negative" :label="t('Cancel')" @click="submitCancelRecovery(row)"></q-btn>
                </div></q-item-section>
            </q-item>
        </q-list>
        <div v-if="recovery.error" class="text-negative text-body2 q-mt-sm">{{recovery.error}}</div>
        <div v-if="recovery.check.length" class="q-mt-sm">
            <div class="text-body2">{{t('Compare the key of one of the vault\'s managers first: it anchors the vault\'s member list in your browser.')}}</div>
            <q-btn v-for="userId in recovery.check" :key="userId" flat no-caps color="primary" :label="fill(t('Compare {name}\'s key'), {name: nameOf(userId)})" @click="openCheck(userId, null)"></q-btn>
        </div>
    </template>

    <!-- ===== Settings › Vault key ===== -->
    <template v-else-if="keyView">
        <div class="row items-center q-mb-sm">
            <div class="col text-h5">{{t('Vault key')}}</div>
            <q-btn flat no-caps color="primary" icon="sym_o_encrypted" :label="t('Open the vault')" @click="go('/Commons/Vault')"></q-btn>
        </div>
        <div class="row q-col-gutter-md">
            <div class="col-12 col-md-6"><q-card flat bordered><q-card-section>
                <div class="text-subtitle1 text-weight-medium">{{t('Your vault key')}}</div>
                <template v-if="!S.personal.hasKey">
                    <div class="text-body2 q-mt-sm">{{t('Your vault key opens the vaults you share with others and lets people send you items. It is made in this browser under a key passphrase, which is not your sign-in password and never reaches the server.')}}</div>
                    <q-btn unelevated no-caps color="primary" class="q-mt-md" icon="sym_o_key" :label="t('Set up your vault key')" @click="openSetup('new')"></q-btn>
                </template>
                <template v-else>
                    <div class="text-caption m-muted q-mt-sm">{{t('Fingerprint')}}</div>
                    <div class="text-h6 boss-vault-words">{{myWords || '…'}}</div>
                    <div class="text-caption m-muted">{{t('Others compare these words with you before they share a vault with you or send you an item.')}}</div>
                    <div class="row items-center q-gutter-sm q-mt-md">
                        <q-chip dense square :class="S.unlocked ? 'm-tonal text-positive' : 'm-tonal text-grey-8'" :icon="S.unlocked ? 'sym_o_lock_open' : 'sym_o_lock'">{{S.unlocked ? t('Unlocked') : t('Locked')}}</q-chip>
                        <q-btn v-if="!S.unlocked" unelevated no-caps color="primary" :label="t('Unlock')" @click="openUnlock(null)"></q-btn>
                        <q-btn v-else unelevated no-caps class="m-btn-tonal" icon="sym_o_lock" :label="t('Lock')" @click="lockNow"></q-btn>
                        <q-btn flat no-caps color="primary" :label="t('Change the passphrase')" @click="openChange"></q-btn>
                        <q-btn flat dense round icon="more_horiz" :aria-label="t('More')"><q-menu auto-close><q-list dense style="min-width:240px">
                            <q-item clickable @click="openRecover"><q-item-section avatar><q-icon name="sym_o_password"></q-icon></q-item-section><q-item-section>{{t('Use the recovery code')}}</q-item-section></q-item>
                            <q-item clickable class="text-negative" @click="openSetup('replace')"><q-item-section avatar><q-icon name="sym_o_key_off" color="negative"></q-icon></q-item-section><q-item-section>{{t('Make a new key')}}</q-item-section></q-item>
                        </q-list></q-menu></q-btn>
                    </div>
                </template>
                <q-banner v-if="needsFactor" dense rounded class="q-mt-md m-tonal text-warning">{{t('Your vault key needs a sign-in with a second factor.')}}
                    <template v-slot:action><q-btn flat dense no-caps color="primary" :label="t('Set one up in Account')" @click="go('/Commons/Settings/Account')"></q-btn></template></q-banner>
            </q-card-section></q-card></div>

            <div class="col-12 col-md-6"><q-card flat bordered><q-card-section>
                <div class="text-subtitle1 text-weight-medium">{{t('Keys you checked')}}</div>
                <div class="text-caption m-muted">{{t('The people whose key fingerprint you compared with them. A key that changes is compared again.')}}</div>
                <div v-if="!S.unlocked && S.personal.hasKey" class="text-body2 m-muted q-mt-sm">{{t('Unlock your vault key to see them.')}}</div>
                <q-list v-else-if="S.keyChecks.length" dense separator class="q-mt-sm">
                    <q-item v-for="row in S.keyChecks" :key="row.keyCheckId || row.checked_key_id">
                        <q-item-section><q-item-label>{{nameOf(row.checked_user_id)}}</q-item-label>
                            <q-item-label caption class="boss-vault-words">{{checksWords[row.checked_key_id] || '…'}}</q-item-label></q-item-section>
                        <q-item-section side><q-item-label caption>{{dateText(row.checked_at)}}</q-item-label></q-item-section>
                    </q-item>
                </q-list>
                <div v-else class="text-body2 m-muted q-mt-sm">{{t('None yet.')}}</div>
            </q-card-section></q-card></div>

            <div class="col-12 col-md-6"><q-card flat bordered><q-card-section>
                <div class="text-subtitle1 text-weight-medium">{{t('Devices that remember your key')}}</div>
                <div class="text-body2 m-muted q-mt-sm">{{t('No device remembers your key. In the browser it stays open only in this tab, until the vault locks or the tab closes.')}}</div>
            </q-card-section></q-card></div>
        </div>
    </template>

    <!-- ===== the vault ===== -->
    <template v-else>
        <div class="row items-center no-wrap q-mb-sm q-gutter-x-sm">
            <div class="col text-h5">{{t('Vault')}}</div>
            <q-input v-if="openVaults.length && !phone" dense outlined clearable v-model="search" :placeholder="t('Search the open vaults')" style="width:280px" autocomplete="off">
                <template v-slot:prepend><q-icon name="sym_o_search"></q-icon></template></q-input>
            <q-btn unelevated no-caps :color="current && current.open && writable(current) ? 'primary' : undefined" :class="current && current.open && writable(current) ? '' : 'm-btn-tonal'"
                    icon="sym_o_add" :label="current && current.open && writable(current) ? t('New item') : t('New vault')"
                    @click="current && current.open && writable(current) ? openEdit(null) : openMake()"></q-btn>
            <q-btn flat dense round icon="more_horiz" :aria-label="t('More')"><q-menu auto-close><q-list dense style="min-width:240px">
                <q-item v-if="current && current.open && writable(current)" clickable @click="openMake"><q-item-section avatar><q-icon name="sym_o_add_box"></q-icon></q-item-section><q-item-section>{{t('New vault')}}</q-item-section></q-item>
                <q-item clickable :disable="!writableOpen.length" @click="openImport"><q-item-section avatar><q-icon name="sym_o_upload_file"></q-icon></q-item-section><q-item-section>{{t('Import')}}</q-item-section></q-item>
                <q-item clickable :disable="!openVaults.length" @click="openExport"><q-item-section avatar><q-icon name="sym_o_download"></q-icon></q-item-section><q-item-section>{{t('Export, encrypted')}}</q-item-section></q-item>
                <q-item clickable @click="openDeliveries"><q-item-section avatar><q-icon name="sym_o_inbox"></q-icon></q-item-section><q-item-section>{{t('Sent to you')}}</q-item-section>
                    <q-item-section v-if="S.deliveries.length" side><q-badge color="primary">{{S.deliveries.length}}</q-badge></q-item-section></q-item>
                <q-item clickable @click="go('/Commons/Settings/VaultKey')"><q-item-section avatar><q-icon name="sym_o_key"></q-icon></q-item-section><q-item-section>{{t('Vault key')}}</q-item-section></q-item>
                <q-item clickable @click="about = true"><q-item-section avatar><q-icon name="sym_o_info"></q-icon></q-item-section><q-item-section>{{t('What the server sees')}}</q-item-section></q-item>
            </q-list></q-menu></q-btn>
            <q-btn v-if="anyUnlocked" unelevated no-caps class="m-btn-tonal boss-vault-lock" icon="sym_o_lock" :label="phone ? '' : t('Lock')" @click="lockNow"><q-tooltip>{{t('Lock: forget every key in this tab')}}</q-tooltip></q-btn>
        </div>
        <q-input v-if="openVaults.length && phone" dense outlined clearable v-model="search" class="q-mb-sm" :placeholder="t('Search the open vaults')" autocomplete="off">
            <template v-slot:prepend><q-icon name="sym_o_search"></q-icon></template></q-input>

        <q-banner v-if="S.idleLocked" dense rounded class="q-mb-sm m-tonal text-grey-9 boss-vault-idle">
            <template v-slot:avatar><q-icon name="sym_o_lock_clock"></q-icon></template>{{fill(t('The vault locked after {minutes} minutes without use.'), {minutes: S.config.idleMinutes})}}</q-banner>
        <q-banner v-if="S.deliveries.length" dense rounded class="q-mb-sm m-tonal text-primary">
            <template v-slot:avatar><q-icon name="sym_o_inbox"></q-icon></template>{{fill(t('{count} sent to you, to file into a vault'), {count: S.deliveries.length})}}
            <template v-slot:action><q-btn flat dense no-caps color="primary" :label="t('See them')" @click="openDeliveries"></q-btn></template></q-banner>

        <div class="row no-wrap items-start">
            <!-- the vaults -->
            <div v-if="wide || !current" :class="wide ? 'col-auto q-pr-md' : 'col-12'" :style="wide ? {width: '280px'} : {}">
                <q-list bordered separator class="rounded-borders">
                    <q-item v-for="v in S.vaults" :key="v.vaultId" clickable :class="current && current.vaultId === v.vaultId ? (dark ? 'bg-grey-9' : 'bg-blue-1') : ''" @click="selectVault(v.vaultId)">
                        <q-item-section avatar><q-icon :name="v.open ? 'sym_o_lock_open' : 'sym_o_lock'" :color="v.open ? 'positive' : undefined"></q-icon></q-item-section>
                        <q-item-section>
                            <q-item-label class="ellipsis">{{v.open ? (v.name || t('Vault')) : t('Locked vault')}}</q-item-label>
                            <q-item-label caption>{{lockText(v)}} · {{itemsText(itemCount(v))}}<span v-if="v.recoveryOn === 'Y'"> · {{t('recovery on')}}</span></q-item-label>
                            <q-item-label v-if="reminder(v)" caption class="text-warning">{{t('Open it once to show its password is still kept')}}</q-item-label>
                        </q-item-section>
                    </q-item>
                </q-list>
                <div v-if="!S.vaults.length" class="text-center q-pa-lg">
                    <q-icon name="sym_o_encrypted" size="40px" class="m-muted"></q-icon>
                    <div class="text-body2 m-muted q-mt-sm">{{t('No vaults yet. A vault keeps passwords, notes, cards and private contacts under a key the server does not hold.')}}</div>
                    <q-btn unelevated no-caps color="primary" class="q-mt-sm" :label="t('New vault')" @click="openMake"></q-btn>
                </div>
            </div>

            <!-- the vault chosen -->
            <div v-if="wide || current" class="col" style="min-width:0">
                <div v-if="search && openVaults.length" class="boss-vault-results">
                    <div class="text-subtitle2 q-mb-xs">{{fill(t('{count} found'), {count: results.length})}}</div>
                    <q-list bordered separator class="rounded-borders">
                        <q-item v-for="hit in results" :key="hit.vaultId + hit.item.id" clickable @click="selectItem(hit.vaultId, hit.item.id)">
                            <q-item-section avatar><q-icon :name="iconOf(hit.item.type)"></q-icon></q-item-section>
                            <q-item-section><q-item-label>{{hit.item.name}}</q-item-label><q-item-label caption>{{subtitle(hit.item)}} · {{vault(hit.vaultId).name}}</q-item-label></q-item-section>
                        </q-item>
                    </q-list>
                    <div v-if="!results.length" class="text-body2 m-muted q-pa-md">{{t('Nothing matches in the open vaults')}}</div>
                </div>
                <div v-else-if="!current" class="text-center q-pa-xl m-muted">
                    <q-icon name="sym_o_encrypted" size="48px"></q-icon>
                    <div class="text-body1 q-mt-sm">{{S.vaults.length ? t('Choose a vault') : t('Make your first vault')}}</div>
                </div>

                <!-- locked -->
                <div v-else-if="!current.open" class="boss-vault-locked q-pa-md">
                    <q-btn v-if="!wide" flat dense round icon="arrow_back" class="q-mb-sm" @click="selectVault(null)"></q-btn>
                    <div class="row items-center q-gutter-sm">
                        <q-icon name="sym_o_lock" size="32px"></q-icon>
                        <div class="text-h6">{{t('This vault is locked')}}</div>
                    </div>
                    <div class="text-body2 m-muted q-mt-xs">{{lockText(current)}} · {{itemsText(itemCount(current))}}</div>
                    <div style="max-width:420px" class="q-mt-md">
                        <template v-if="current.lockEnumId === SINGLE">
                            <q-input :key="'secret-' + current.vaultId" v-model="unlockForm.secret" outlined dense :type="unlockForm.show ? 'text' : 'password'" autocomplete="off"
                                    :label="current.secretKindEnumId === 'VsGenerated' ? t('The vault key') : t('The vault password')" @keyup.enter="openCurrent">
                                <template v-slot:append><q-icon :name="unlockForm.show ? 'sym_o_visibility_off' : 'sym_o_visibility'" class="cursor-pointer" @click="unlockForm.show = !unlockForm.show"></q-icon></template></q-input>
                        </template>
                        <template v-else-if="!S.personal.hasKey">
                            <div class="text-body2">{{t('A shared vault opens with your vault key. Set it up first.')}}</div>
                            <q-btn flat no-caps color="primary" class="q-mt-xs" :label="t('Set up your vault key')" @click="go('/Commons/Settings/VaultKey')"></q-btn>
                        </template>
                        <template v-else-if="!S.unlocked">
                            <q-input :key="'pass-' + current.vaultId" v-model="unlockForm.passphrase" outlined dense type="password" autocomplete="off" :label="t('Your vault key passphrase')" @keyup.enter="openCurrent"></q-input>
                        </template>
                        <div v-if="unlockForm.error" class="text-negative text-body2 q-mt-xs">{{unlockForm.error}}</div>
                        <div v-if="unlockForm.check.length" class="q-mt-sm">
                            <div class="text-body2">{{t('This vault\'s member list is signed by people whose key you have not compared yet. Compare one of them:')}}</div>
                            <q-btn v-for="userId in unlockForm.check" :key="userId" flat no-caps color="primary" :label="fill(t('Compare {name}\'s key'), {name: nameOf(userId)})" @click="openCheck(userId, openCurrent)"></q-btn>
                        </div>
                        <q-btn v-if="current.lockEnumId === SINGLE || S.personal.hasKey" unelevated no-caps color="primary" class="q-mt-sm" :loading="unlockForm.busy" :label="t('Open')" @click="openCurrent"></q-btn>
                    </div>
                </div>

                <!-- an item -->
                <div v-else-if="currentItem" class="boss-vault-item">
                    <div class="row items-start no-wrap q-mb-sm">
                        <q-btn flat dense round icon="arrow_back" class="q-mr-xs" @click="selectItem(current.vaultId, null)"><q-tooltip>{{t('All items')}}</q-tooltip></q-btn>
                        <q-icon :name="iconOf(currentItem.type)" size="28px" class="q-mr-sm q-mt-xs"></q-icon>
                        <div class="col" style="min-width:0">
                            <div class="text-h5 ellipsis">{{currentItem.name || t('Untitled')}}</div>
                            <div class="text-caption m-muted">{{typeLabel(currentItem.type)}} · {{current.name}}<span v-if="currentItem.changed"> · {{t('Changed')}} {{dateText(currentItem.changed)}}</span></div>
                        </div>
                        <q-btn v-if="writable(current) && !currentItem.broken" unelevated dense no-caps class="m-btn-tonal q-px-sm" icon="sym_o_edit" :label="t('Edit')" @click="openEdit(currentItem)"></q-btn>
                        <q-btn flat dense round icon="more_horiz" :aria-label="t('More')"><q-menu auto-close><q-list dense style="min-width:220px">
                            <q-item clickable @click="openHistory"><q-item-section avatar><q-icon name="sym_o_history"></q-icon></q-item-section><q-item-section>{{t('History')}}</q-item-section></q-item>
                            <q-item clickable :disable="!S.personal.hasKey || currentItem.broken" @click="openSend"><q-item-section avatar><q-icon name="sym_o_send"></q-icon></q-item-section><q-item-section>{{t('Send a copy')}}</q-item-section></q-item>
                            <q-item clickable :disable="writableOpen.length < 2 || currentItem.broken" @click="openCopyTo"><q-item-section avatar><q-icon name="sym_o_content_copy"></q-icon></q-item-section><q-item-section>{{t('Copy to another vault')}}</q-item-section></q-item>
                            <q-separator></q-separator>
                            <q-item clickable :disable="!writable(current)" class="text-negative" @click="confirmDeleteItem"><q-item-section avatar><q-icon name="sym_o_delete" color="negative"></q-icon></q-item-section><q-item-section>{{t('Delete')}}</q-item-section></q-item>
                        </q-list></q-menu></q-btn>
                    </div>
                    <q-banner v-if="currentItem.broken" dense rounded class="m-tonal text-negative q-mb-sm">{{t('This item does not open with this vault\'s key')}}: {{currentItem.broken}}</q-banner>
                    <q-list v-else bordered separator class="rounded-borders">
                        <q-item v-for="field in fieldsOf(currentItem)" :key="field.name" class="boss-vault-field" :data-field="field.name">
                            <q-item-section>
                                <q-item-label caption>{{field.label}}</q-item-label>
                                <q-item-label v-if="!field.masked" :class="field.kind === 'multi-line' ? 'boss-vault-pre' : ''">
                                    <a v-if="field.kind === 'url'" :href="safeUrl(field.value)" target="_blank" rel="noopener noreferrer">{{field.value}}</a><span v-else>{{field.value}}</span></q-item-label>
                                <q-item-label v-else class="boss-vault-value" :class="field.kind === 'multi-line' && revealed[field.name] != null ? 'boss-vault-pre' : ''">{{revealed[field.name] != null ? revealed[field.name] : '••••••••••'}}</q-item-label>
                            </q-item-section>
                            <q-item-section side><div class="row no-wrap">
                                <q-btn v-if="field.masked" flat dense round :icon="revealed[field.name] != null ? 'sym_o_visibility_off' : 'sym_o_visibility'" class="boss-vault-show"
                                        :aria-label="revealed[field.name] != null ? t('Hide') : t('Show')" @click="toggleReveal(field)"><q-tooltip>{{revealed[field.name] != null ? t('Hide') : t('Show')}}</q-tooltip></q-btn>
                                <q-btn flat dense round icon="sym_o_content_copy" :aria-label="t('Copy')" @click="copyField(field)"><q-tooltip>{{t('Copy')}}</q-tooltip></q-btn>
                            </div></q-item-section>
                        </q-item>
                        <q-item v-if="currentItem.uris.length"><q-item-section><q-item-label caption>{{t('Websites')}}</q-item-label>
                            <q-item-label v-for="uri in currentItem.uris" :key="uri"><a :href="safeUrl(uri)" target="_blank" rel="noopener noreferrer">{{uri}}</a></q-item-label></q-item-section></q-item>
                        <q-item v-if="detail && detail.notes"><q-item-section><q-item-label caption>{{t('Notes')}}</q-item-label>
                            <q-item-label class="boss-vault-pre">{{detail.notes}}</q-item-label></q-item-section></q-item>
                    </q-list>
                    <div v-if="currentItem.tags.length" class="row q-gutter-xs q-mt-sm">
                        <q-chip v-for="tag in currentItem.tags" :key="tag" dense square icon="sym_o_label" class="m-tonal text-primary">{{tag}}</q-chip>
                    </div>
                </div>

                <!-- the items of the vault -->
                <div v-else class="boss-vault-items">
                    <div class="row items-center no-wrap q-mb-sm">
                        <q-btn v-if="!wide" flat dense round icon="arrow_back" class="q-mr-xs" @click="selectVault(null)"></q-btn>
                        <div class="col" style="min-width:0">
                            <div class="text-h6 ellipsis">{{current.name || t('Vault')}}</div>
                            <div class="text-caption m-muted">{{lockText(current)}}<span v-if="current.lockEnumId === SHARED"> · {{current.memberList.length === 1 ? t('1 member') : fill(t('{count} members'), {count: current.memberList.length})}} · {{roleText(current.roleEnumId)}}</span></div>
                        </div>
                        <q-btn v-if="current.lockEnumId === SHARED" unelevated dense no-caps class="m-btn-tonal q-px-sm" icon="sym_o_group" :label="t('Members')" @click="openMembers"></q-btn>
                        <q-btn flat dense round icon="more_horiz" :aria-label="t('More')"><q-menu auto-close><q-list dense style="min-width:220px">
                            <q-item clickable :disable="!manages(current)" class="text-negative" @click="confirmDeleteVault"><q-item-section avatar><q-icon name="sym_o_delete" color="negative"></q-icon></q-item-section><q-item-section>{{t('Delete the vault')}}</q-item-section></q-item>
                        </q-list></q-menu></q-btn>
                    </div>
                    <q-banner v-if="current.warning" dense rounded class="m-tonal text-warning q-mb-sm">{{current.warning}}</q-banner>
                    <div v-if="current.items.length" class="row q-gutter-xs q-mb-sm">
                        <q-chip dense square clickable :class="!typeFilter ? 'm-tonal text-primary' : ''" @click="typeFilter = ''">{{t('All')}} · {{current.items.length}}</q-chip>
                        <q-chip v-for="entry in typeCounts" :key="entry.id" dense square clickable :icon="iconOf(entry.id)" :class="typeFilter === entry.id ? 'm-tonal text-primary' : ''"
                                @click="typeFilter = entry.id">{{entry.label}} · {{entry.count}}</q-chip>
                    </div>
                    <q-list v-if="shownItems.length" bordered separator class="rounded-borders">
                        <q-item v-for="item in shownItems" :key="item.id" clickable class="boss-vault-row" :data-item="item.id" @click="selectItem(current.vaultId, item.id)">
                            <q-item-section avatar><q-icon :name="iconOf(item.type)"></q-icon></q-item-section>
                            <q-item-section><q-item-label class="ellipsis">{{item.name || t('Untitled')}}</q-item-label><q-item-label caption class="ellipsis">{{subtitle(item)}}</q-item-label></q-item-section>
                        </q-item>
                    </q-list>
                    <div v-else class="text-center q-pa-lg">
                        <q-icon name="sym_o_key" size="40px" class="m-muted"></q-icon>
                        <div class="text-body2 m-muted q-mt-sm">{{t('No items yet. New item adds a login, a note, a card or a private contact; Import brings in an export of another password manager.')}}</div>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!-- ===== dialogs ===== -->
    <!-- a new item, or an item edited: the fields of its type -->
    <m-dialog v-model="edit.open" :title="edit.item ? t('Edit the item') : t('New item')" width="620">
        <div class="q-gutter-y-sm">
            <q-select v-if="!edit.item" v-model="edit.type" outlined dense emit-value map-options :options="typeOptions" :label="t('Type')"></q-select>
            <q-input v-model="edit.name" outlined dense autocomplete="off" :label="t('Name')"></q-input>
            <template v-for="field in (typeOf(edit.type) || {fields: []}).fields" :key="field.name">
                <q-input v-if="field.kind === 'multi-line'" v-model="edit.fields[field.name]" outlined dense autogrow autocomplete="off" type="textarea" :label="field.label"
                        :input-class="field.masked && !edit.show[field.name] ? 'boss-vault-masked' : ''">
                    <template v-if="field.masked" v-slot:append><q-icon :name="edit.show[field.name] ? 'sym_o_visibility_off' : 'sym_o_visibility'" class="cursor-pointer" @click="edit.show[field.name] = !edit.show[field.name]"></q-icon></template></q-input>
                <q-input v-else v-model="edit.fields[field.name]" outlined dense autocomplete="off" :type="field.masked && !edit.show[field.name] ? 'password' : (field.kind === 'date' ? 'date' : 'text')" :label="field.label">
                    <template v-if="field.masked" v-slot:append>
                        <q-icon :name="edit.show[field.name] ? 'sym_o_visibility_off' : 'sym_o_visibility'" class="cursor-pointer" @click="edit.show[field.name] = !edit.show[field.name]"></q-icon>
                        <q-btn v-if="field.kind === 'secret'" flat dense no-caps size="sm" color="primary" :label="t('Generate')" @click="generateFor(field)"></q-btn>
                    </template></q-input>
            </template>
            <q-input v-model="edit.uris" outlined dense autogrow type="textarea" autocomplete="off" :label="t('Websites, one a line')"></q-input>
            <q-input v-model="edit.tags" outlined dense autocomplete="off" :label="t('Tags, separated by commas')"></q-input>
            <q-input v-model="edit.notes" outlined dense autogrow type="textarea" autocomplete="off" :label="t('Notes')"></q-input>
            <div class="row justify-end q-gutter-sm">
                <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
                <q-btn unelevated no-caps color="primary" :label="t('Save')" :loading="edit.busy" :disable="!String(edit.name || '').trim()" @click="saveEdit"></q-btn>
            </div>
        </div>
    </m-dialog>

    <!-- a new vault: the lock, then for a single-secret vault §3.11's steps -->
    <m-dialog v-model="make.open" :title="t('New vault')" width="640">
        <div v-if="make.step === 'choose'" class="q-gutter-y-sm">
            <q-input v-model="make.name" outlined dense autocomplete="off" :label="t('Name')"></q-input>
            <div class="text-caption m-muted">{{t('The name is sealed with the vault: the server does not see it.')}}</div>
            <q-option-group v-model="make.lock" :options="lockOptions" type="radio"></q-option-group>
            <q-input v-if="make.lock === SHARED && S.personal.hasKey && !S.unlocked" v-model="make.passphrase" outlined dense type="password" autocomplete="off" :label="t('Your vault key passphrase')"></q-input>
            <div v-if="make.lock === SHARED && !S.personal.hasKey" class="text-body2 text-warning">{{t('A shared vault needs your vault key. Set it up in Settings › Vault key first.')}}</div>
            <div class="text-caption m-muted">{{t('The lock is chosen now and never changes.')}}</div>
            <div v-if="make.error" class="text-negative text-body2">{{make.error}}</div>
            <div class="row justify-end q-gutter-sm">
                <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
                <q-btn v-if="make.lock === SINGLE" unelevated no-caps color="primary" :label="t('Next')" :disable="!String(make.name || '').trim()" @click="make.step = 'warn'"></q-btn>
                <q-btn v-else unelevated no-caps color="primary" :label="t('Make the vault')" :loading="make.busy" :disable="!String(make.name || '').trim() || !S.personal.hasKey" @click="submitMake"></q-btn>
            </div>
        </div>
        <div v-else-if="make.step === 'warn'" class="q-gutter-y-sm boss-vault-warning">
            <q-banner rounded class="m-tonal text-negative">{{SINGLE_WARNING}}</q-banner>
            <div class="text-subtitle2">{{t('How to keep the password or key safely')}}</div>
            <ul class="q-my-none q-pl-lg text-body2">
                <li>{{t('Keep it in a password manager you already trust that is not on this server, or write it down and keep the paper with your important papers (a safe, a safe-deposit box).')}}</li>
                <li>{{t('Keep two copies in two places. Never keep the only copy inside this vault, or anywhere on this server.')}}</li>
                <li>{{t('A generated key is long and random, so it cannot be guessed. Download or print it, then keep it as above.')}}</li>
            </ul>
            <div class="row justify-end q-gutter-sm">
                <q-btn flat no-caps :label="t('Back')" @click="make.step = 'choose'"></q-btn>
                <q-btn unelevated no-caps color="primary" :label="t('I understand')" @click="make.step = 'secret'"></q-btn>
            </div>
        </div>
        <div v-else class="q-gutter-y-sm">
            <q-option-group v-model="make.kind" :options="secretOptions" type="radio" inline @update:model-value="secretKindChanged"></q-option-group>
            <template v-if="make.kind === 'VsPassword'">
                <q-input v-model="make.password" outlined dense type="password" autocomplete="new-password" :label="t('Password')"></q-input>
                <q-input v-model="make.password2" outlined dense type="password" autocomplete="new-password" :label="t('The password again')"></q-input>
                <div v-if="make.password && passwordProblem(make.password)" class="text-warning text-body2">{{passwordProblem(make.password)}}</div>
                <div v-else-if="make.password2 && make.password !== make.password2" class="text-warning text-body2">{{t('The two passwords differ')}}</div>
            </template>
            <template v-else>
                <div class="text-caption m-muted">{{t('Your generated key')}}</div>
                <div class="text-h6 boss-vault-words boss-vault-generated">{{make.key}}</div>
                <div class="row q-gutter-sm">
                    <q-btn unelevated dense no-caps class="m-btn-tonal q-px-sm" icon="sym_o_download" :label="t('Download')" @click="downloadKey(make.key, 'vault-key')"></q-btn>
                    <q-btn unelevated dense no-caps class="m-btn-tonal q-px-sm" icon="sym_o_print" :label="t('Print')" @click="printKey(make.key, t('Vault key') + ': ' + make.name)"></q-btn>
                </div>
                <q-input v-model="make.typed" outlined dense autocomplete="off" :label="t('Type the last 8 characters of the key, from your printed or saved copy')"></q-input>
            </template>
            <q-checkbox v-model="make.stored" :label="t('I have stored it outside this server.')"></q-checkbox>
            <div v-if="make.error" class="text-negative text-body2">{{make.error}}</div>
            <div class="row justify-end q-gutter-sm">
                <q-btn flat no-caps :label="t('Back')" @click="make.step = 'warn'"></q-btn>
                <q-btn unelevated no-caps color="primary" :label="t('Make the vault')" :loading="make.busy" :disable="!secretReady" @click="submitMake"></q-btn>
            </div>
        </div>
    </m-dialog>

    <!-- the personal key opened, when an action needs it -->
    <m-dialog v-model="unlockDialog.open" :title="t('Unlock your vault key')" width="480">
        <div class="q-gutter-y-sm">
            <q-input v-model="unlockDialog.passphrase" outlined dense type="password" autocomplete="off" :label="t('Your vault key passphrase')" @keyup.enter="submitUnlock"></q-input>
            <div v-if="unlockDialog.error" class="text-negative text-body2">{{unlockDialog.error}}</div>
            <div class="row items-center q-gutter-sm">
                <q-btn flat dense no-caps color="primary" :label="t('Use the recovery code')" @click="unlockDialog.open = false; openRecover()"></q-btn>
                <div class="col"></div>
                <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
                <q-btn unelevated no-caps color="primary" :label="t('Unlock')" :loading="unlockDialog.busy" @click="submitUnlock"></q-btn>
            </div>
        </div>
    </m-dialog>

    <!-- a key's fingerprint compared with its owner -->
    <m-dialog v-model="check.open" :title="fill(t('Compare {name}\'s key'), {name: check.name})" width="520">
        <div class="q-gutter-y-sm">
            <div v-if="check.key && !check.key.hasKey" class="text-body2">{{t('They have no vault key yet. Ask them to set one up in Settings › Vault key.')}}</div>
            <template v-else>
                <div class="text-body2">{{fill(t('Ask {name} to read their fingerprint to you, on a call or in person, not by email or chat. It must be exactly these words:'), {name: check.name})}}</div>
                <div class="text-h5 boss-vault-words text-center q-py-sm">{{check.words || '…'}}</div>
                <q-checkbox v-model="check.match" :label="t('The words match')"></q-checkbox>
            </template>
            <div v-if="check.error" class="text-negative text-body2">{{check.error}}</div>
            <div class="row justify-end q-gutter-sm">
                <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
                <q-btn unelevated no-caps color="primary" :label="t('They match')" :loading="check.busy" :disable="!check.match || !check.words" @click="submitCheck"></q-btn>
            </div>
        </div>
    </m-dialog>

    <!-- members of a shared vault -->
    <m-dialog v-model="members.open" :title="t('Members') + (current ? ': ' + (current.name || t('Vault')) : '')" width="720">
        <div v-if="current" class="q-gutter-y-sm">
            <q-list bordered separator class="rounded-borders">
                <q-item v-for="member in memberRows.filter((row) => !row.recovery)" :key="member.userId">
                    <q-item-section>
                        <q-item-label>{{nameOf(member.userId)}}<span v-if="member.me" class="m-muted"> ({{t('you')}})</span></q-item-label>
                        <q-item-label caption class="boss-vault-words">{{member.words || '…'}}</q-item-label>
                        <q-item-label v-if="member.changed" caption class="text-warning">{{t('Their vault key changed: compare the new one, then give it access')}}</q-item-label>
                    </q-item-section>
                    <q-item-section side><div class="row items-center no-wrap q-gutter-x-xs">
                        <q-chip dense square class="m-tonal">{{roleText(member.roleEnumId)}}</q-chip>
                        <q-chip v-if="!member.me && member.checked" dense square icon="sym_o_verified" class="m-tonal text-positive">{{t('Compared')}}</q-chip>
                        <q-btn v-else-if="!member.me" flat dense no-caps size="sm" color="primary" :label="t('Compare')" @click="openCheck(member.userId, loadMemberKeys)"></q-btn>
                        <q-btn v-if="member.changed && manages(current)" flat dense no-caps size="sm" color="primary" :label="t('Give access')" @click="regrant(member)"></q-btn>
                        <q-btn v-if="!member.me && manages(current)" flat dense round size="sm" icon="sym_o_person_remove" color="negative" :aria-label="t('Remove')" @click="members.remove = member"></q-btn>
                    </div></q-item-section>
                </q-item>
            </q-list>
            <template v-if="manages(current)">
                <div class="text-subtitle2 q-mt-md">{{t('Add a member')}}</div>
                <div class="row q-col-gutter-sm items-start">
                    <div class="col-12 col-sm-7"><m-drop-down id="boss-vault-member" name="memberUserId" :model-value="members.add.userId" server-search :server-min-length="0" allow-empty
                            :options-url="url('userChoices')" :label="t('Person (people with a vault key)')" @update:model-value="memberChosen"></m-drop-down></div>
                    <div class="col-12 col-sm-5"><q-select v-model="members.add.role" outlined dense emit-value map-options :options="roleOptions" :label="t('Role')"></q-select></div>
                </div>
                <template v-if="members.add.key">
                    <div class="text-body2">{{fill(t('Ask {name} to read their fingerprint to you, on a call or in person, not by email or chat. It must be exactly these words:'), {name: nameOf(members.add.userId)})}}</div>
                    <div class="text-h6 boss-vault-words">{{members.add.words || '…'}}</div>
                    <q-checkbox v-model="members.add.match" :label="t('The words match')"></q-checkbox>
                </template>
                <div class="row justify-end"><q-btn unelevated no-caps color="primary" :label="t('Add')" :loading="members.busy" :disable="!members.add.key || !members.add.match" @click="submitAddMember"></q-btn></div>
            </template>
            <div class="text-subtitle2 q-mt-md">{{t('Organization recovery')}}</div>
            <template v-if="recoveryMember">
                <div class="text-body2">{{t('On: the organization\'s recovery key can give a member who lost their key and recovery code their access again. Every member is told of a recovery.')}}
                    <span v-if="recoveryKeyRow(recoveryMember) && recoveryKeyRow(recoveryMember).used" class="text-warning">{{t('Its key was used for a recovery: replace it.')}}</span></div>
            </template>
            <div v-else class="text-body2">{{t('Off: only the members can give a member who lost their key access again.')}}</div>
            <div v-if="manages(current)" class="row q-col-gutter-sm items-center">
                <div class="col-12 col-sm-7"><q-select v-model="members.recoveryKeyId" outlined dense emit-value map-options :options="recoveryOptions"
                        :label="recoveryMember ? t('Replace it with') : t('Recovery key')"></q-select></div>
                <div class="col-12 col-sm-5"><q-btn unelevated no-caps color="primary" :label="recoveryMember ? t('Replace the recovery key') : t('Turn recovery on')"
                        :disable="!members.recoveryKeyId" :loading="members.busy" @click="submitRecoveryOn"></q-btn></div>
            </div>
            <div class="text-caption m-muted">{{t('A recovery holder needs this vault\'s id')}}: <span class="boss-vault-words">{{current.vaultId}}</span></div>
            <q-banner v-if="members.remove" rounded class="m-tonal text-negative">
                {{fill(t('Remove {name}? The vault gets a new key, which they never receive, and every item key is wrapped again. A copy they made of an item before stays theirs: change those passwords at their source.'), {name: nameOf(members.remove.userId)})}}
                <div><q-checkbox v-model="members.reencrypt" :label="t('Also encrypt every item again now, with new item keys')"></q-checkbox></div>
                <template v-slot:action>
                    <q-btn flat no-caps :label="t('Cancel')" @click="members.remove = null"></q-btn>
                    <q-btn unelevated no-caps color="negative" :label="t('Remove')" :loading="members.busy" @click="submitRemoveMember"></q-btn>
                </template>
            </q-banner>
            <div v-if="members.error" class="text-negative text-body2">{{members.error}}</div>
        </div>
    </m-dialog>

    <!-- items sent to the user -->
    <m-dialog v-model="deliveries.open" :title="t('Sent to you')" width="640">
        <div class="q-gutter-y-sm">
            <div v-if="!S.deliveries.length" class="text-body2 m-muted">{{t('Nothing is waiting.')}}</div>
            <template v-else>
                <q-select v-model="deliveries.vaultId" outlined dense emit-value map-options :options="writableOptions" :label="t('File into')"></q-select>
                <div v-if="!writableOpen.length" class="text-body2 text-warning">{{t('Open a vault you may add to first.')}}</div>
                <q-list bordered separator class="rounded-borders">
                    <q-item v-for="d in S.deliveries" :key="d.deliveryId">
                        <q-item-section><q-item-label>{{fill(t('From {name}'), {name: nameOf(d.delivery.sender_id)})}}</q-item-label><q-item-label caption>{{dateText(d.sentDate)}}</q-item-label></q-item-section>
                        <q-item-section side><div class="row no-wrap q-gutter-x-xs">
                            <q-btn flat dense no-caps size="sm" color="primary" :label="t('Compare their key')" @click="openCheck(d.delivery.sender_id, null)"></q-btn>
                            <q-btn unelevated dense no-caps size="sm" color="primary" :label="t('File')" :loading="deliveries.busy === d.deliveryId" :disable="!deliveries.vaultId" @click="submitFile(d)"></q-btn>
                        </div></q-item-section>
                    </q-item>
                </q-list>
                <div class="text-caption m-muted">{{t('An item opens only when its sender\'s key is one you compared with them.')}}</div>
            </template>
            <div v-if="deliveries.error" class="text-negative text-body2">{{deliveries.error}}</div>
        </div>
    </m-dialog>

    <!-- a copy of an item sent to someone -->
    <m-dialog v-model="send.open" :title="t('Send a copy')" width="560">
        <div class="q-gutter-y-sm">
            <div class="text-body2">{{t('A copy sealed to their vault key, which only they open. They file it into a vault of their own.')}}</div>
            <m-drop-down id="boss-vault-send" name="sendUserId" :model-value="send.userId" server-search :server-min-length="0" allow-empty
                    :options-url="url('userChoices')" :label="t('Person (people with a vault key)')" @update:model-value="sendChosen"></m-drop-down>
            <template v-if="send.key && !send.checked">
                <div class="text-body2">{{fill(t('Ask {name} to read their fingerprint to you, on a call or in person, not by email or chat. It must be exactly these words:'), {name: nameOf(send.userId)})}}</div>
                <div class="text-h6 boss-vault-words">{{send.words || '…'}}</div>
                <q-checkbox v-model="send.match" :label="t('The words match')"></q-checkbox>
            </template>
            <div v-if="send.error" class="text-negative text-body2">{{send.error}}</div>
            <div class="row justify-end q-gutter-sm">
                <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
                <q-btn unelevated no-caps color="primary" :label="t('Send')" :loading="send.busy" :disable="!send.key || (!send.checked && !send.match)" @click="submitSend"></q-btn>
            </div>
        </div>
    </m-dialog>

    <m-dialog v-model="copyTo.open" :title="t('Copy to another vault')" width="480">
        <div class="q-gutter-y-sm">
            <q-select v-model="copyTo.vaultId" outlined dense emit-value map-options :options="writableOptions.filter((o) => !current || o.value !== current.vaultId)" :label="t('Vault')"></q-select>
            <div class="row justify-end q-gutter-sm">
                <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
                <q-btn unelevated no-caps color="primary" :label="t('Copy')" :loading="copyTo.busy" :disable="!copyTo.vaultId" @click="submitCopyTo"></q-btn>
            </div>
        </div>
    </m-dialog>

    <!-- an item's earlier revisions -->
    <m-dialog v-model="history.open" :title="t('History') + (currentItem ? ': ' + currentItem.name : '')" width="720">
        <div v-if="history.busy" class="q-gutter-y-sm"><q-skeleton v-for="n in 3" :key="n" type="text"></q-skeleton></div>
        <div v-else-if="!history.rows.length" class="text-body2 m-muted">{{t('No earlier versions.')}}</div>
        <q-list v-else bordered separator class="rounded-borders">
            <q-item v-for="row in history.rows" :key="row.revision">
                <q-item-section>
                    <q-item-label>{{fill(t('Version {n}'), {n: row.revision})}} · {{dateText(row.changedDate)}}</q-item-label>
                    <q-item-label v-if="history.shown[row.revision]" class="boss-vault-pre text-body2">{{history.shown[row.revision]}}</q-item-label>
                </q-item-section>
                <q-item-section side><q-btn flat dense no-caps size="sm" color="primary" :label="history.shown[row.revision] ? t('Hide') : t('Show')" @click="toggleHistory(row)"></q-btn></q-item-section>
            </q-item>
        </q-list>
    </m-dialog>

    <!-- import, read in the browser -->
    <m-dialog v-model="importer.open" :title="t('Import')" width="640">
        <div class="q-gutter-y-sm">
            <div class="text-body2">{{t('A Bitwarden export (JSON, not encrypted), a KeePass export (XML or CSV), or an encrypted vault export. The file is read here in your browser and never sent to the server. Delete an export file that is not encrypted once it is imported: it holds your passwords in the clear.')}}</div>
            <q-select v-model="importer.vaultId" outlined dense emit-value map-options :options="writableOptions" :label="t('Into the vault')"></q-select>
            <input type="file" class="boss-vault-file" accept=".json,.xml,.csv,.txt" @change="importFile">
            <template v-if="importer.parsed">
                <div class="text-body2">{{importer.parsed.label}} · {{importer.fileName}}</div>
                <q-input v-if="importer.parsed.format === 'export'" v-model="importer.password" outlined dense type="password" autocomplete="off" :label="t('The export\'s password')"></q-input>
                <div v-else class="text-body2">{{importSummary}}</div>
            </template>
            <q-linear-progress v-if="importer.busy && importer.total" :value="importer.progress / importer.total" color="primary" size="8px" rounded></q-linear-progress>
            <div v-if="importer.result" class="text-body2 text-positive">{{importer.result}}</div>
            <div v-if="importer.error" class="text-negative text-body2">{{importer.error}}</div>
            <div class="row justify-end q-gutter-sm">
                <q-btn flat no-caps :label="t('Close')" @click="closeImport"></q-btn>
                <q-btn unelevated no-caps color="primary" :label="t('Import')" :loading="importer.busy" :disable="!importer.parsed || !importer.vaultId" @click="submitImport"></q-btn>
            </div>
        </div>
    </m-dialog>

    <!-- an encrypted export, made in the browser -->
    <m-dialog v-model="exporter.open" :title="t('Export, encrypted')" width="560">
        <div class="q-gutter-y-sm">
            <div class="text-body2">{{t('A file of the vault\'s items, encrypted here under a password of its own: your own backup, which this vault and the moqui vault command open with that password. The server cannot open it, and cannot restore a vault without it.')}}</div>
            <q-select v-model="exporter.vaultId" outlined dense emit-value map-options :options="openOptions" :label="t('Vault')"></q-select>
            <q-input v-model="exporter.password" outlined dense type="password" autocomplete="new-password" :label="t('A password for the file')"></q-input>
            <q-input v-model="exporter.password2" outlined dense type="password" autocomplete="new-password" :label="t('The password again')"></q-input>
            <div v-if="exporter.password && passwordProblem(exporter.password)" class="text-warning text-body2">{{passwordProblem(exporter.password)}}</div>
            <div v-else-if="exporter.password2 && exporter.password !== exporter.password2" class="text-warning text-body2">{{t('The two passwords differ')}}</div>
            <div v-if="exporter.error" class="text-negative text-body2">{{exporter.error}}</div>
            <div class="row justify-end q-gutter-sm">
                <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
                <q-btn unelevated no-caps color="primary" :label="t('Export')" :loading="exporter.busy"
                        :disable="!exporter.vaultId || !!passwordProblem(exporter.password) || exporter.password !== exporter.password2" @click="submitExport"></q-btn>
            </div>
        </div>
    </m-dialog>

    <!-- the limits (§3.12) -->
    <m-dialog v-model="about" :title="t('What the server sees')" width="640">
        <div class="text-body2 q-gutter-y-sm">
            <div>{{t('The server keeps each vault\'s id, lock, owner, members and roles, item counts, sizes and dates, and ciphertext. It never sees an item\'s name, type or value, your key passphrase, a vault password or key, or your vault key.')}}</div>
            <ul class="q-my-none q-pl-lg">
                <li>{{t('This page runs code the server sends. A server that was changed could send code that takes your passphrase; the desktop and mobile apps carry their own code.')}}</li>
                <li>{{t('While a vault is open, a script on any page of this server could ask this tab for its items. Lock the vault when you are done.')}}</li>
                <li>{{t('The server could hold back an item or give an older copy of it. This browser warns when an item comes back older than it saw before.')}}</li>
                <li>{{t('The server cannot search your vault, sync it to a phone\'s contacts, or restore it without your keys. Your own backup is an encrypted export.')}}</li>
                <li>{{t('Someone with a copy of the database can try to guess a vault password offline. Use a long one, or a generated key.')}}</li>
            </ul>
        </div>
    </m-dialog>

    <!-- the vault key set up, or made again: passphrase, recovery code, part of it typed back -->
    <m-dialog v-model="setup.open" :title="setup.mode === 'replace' ? t('Make a new vault key') : t('Set up your vault key')" width="600" persistent>
        <div v-if="setup.step === 'passphrase'" class="q-gutter-y-sm">
            <q-banner v-if="setup.mode === 'replace'" rounded class="m-tonal text-warning">{{t('Only if you lost both your passphrase and your recovery code. Your shared vaults stay closed to the new key until another member compares it and gives it access again; your single-secret vaults are not changed.')}}</q-banner>
            <div class="text-body2">{{t('Your key passphrase is not your sign-in password, and it never leaves this browser. Choose a long one, such as a few unusual words.')}}</div>
            <q-input v-model="setup.passphrase" outlined dense type="password" autocomplete="new-password" :label="t('Key passphrase')"></q-input>
            <q-input v-model="setup.passphrase2" outlined dense type="password" autocomplete="new-password" :label="t('The passphrase again')"></q-input>
            <div v-if="setup.passphrase && passwordProblem(setup.passphrase)" class="text-warning text-body2">{{passwordProblem(setup.passphrase)}}</div>
            <div v-else-if="setup.passphrase2 && setup.passphrase !== setup.passphrase2" class="text-warning text-body2">{{t('The two passphrases differ')}}</div>
            <div v-if="setup.error" class="text-negative text-body2">{{setup.error}}</div>
            <div class="row justify-end q-gutter-sm">
                <q-btn flat no-caps :label="t('Cancel')" @click="cancelSetup"></q-btn>
                <q-btn unelevated no-caps color="primary" :label="t('Next')" :loading="setup.busy" :disable="!!passwordProblem(setup.passphrase) || setup.passphrase !== setup.passphrase2" @click="setupMake"></q-btn>
            </div>
        </div>
        <div v-else-if="setup.step === 'code'" class="q-gutter-y-sm">
            <div class="text-body2">{{t('Print or save this recovery code and keep it with your important papers. It opens your vault key if you forget the passphrase. Nobody else has it, and it is not shown again.')}}</div>
            <div class="text-h6 boss-vault-words boss-vault-code">{{setup.code}}</div>
            <div class="row q-gutter-sm">
                <q-btn unelevated dense no-caps class="m-btn-tonal q-px-sm" icon="sym_o_download" :label="t('Download')" @click="downloadKey(setup.code, 'vault-recovery-code')"></q-btn>
                <q-btn unelevated dense no-caps class="m-btn-tonal q-px-sm" icon="sym_o_print" :label="t('Print')" @click="printKey(setup.code, t('Vault key recovery code'))"></q-btn>
            </div>
            <div class="row justify-end q-gutter-sm">
                <q-btn flat no-caps :label="t('Cancel')" @click="cancelSetup"></q-btn>
                <q-btn unelevated no-caps color="primary" :label="t('I have kept it')" @click="setup.step = 'confirm'"></q-btn>
            </div>
        </div>
        <div v-else-if="setup.step === 'confirm'" class="q-gutter-y-sm">
            <div class="text-body2">{{fill(t('Type group {n} of your recovery code (the groups are separated by dashes), from your printed or saved copy.'), {n: setup.group + 1})}}</div>
            <q-input v-model="setup.typed" outlined dense autocomplete="off" :label="fill(t('Group {n}'), {n: setup.group + 1})" @keyup.enter="setupSave"></q-input>
            <div v-if="setup.error" class="text-negative text-body2">{{setup.error}}</div>
            <div class="row justify-end q-gutter-sm">
                <q-btn flat no-caps :label="t('Back')" @click="setup.step = 'code'"></q-btn>
                <q-btn unelevated no-caps color="primary" :label="t('Finish')" :loading="setup.busy" @click="setupSave"></q-btn>
            </div>
        </div>
        <div v-else class="q-gutter-y-sm">
            <div class="text-body2">{{t('Your vault key is ready. Its fingerprint:')}}</div>
            <div class="text-h6 boss-vault-words">{{setup.fingerprint}}</div>
            <div class="row justify-end"><q-btn unelevated no-caps color="primary" :label="t('Done')" @click="setup.open = false"></q-btn></div>
        </div>
    </m-dialog>

    <m-dialog v-model="recover.open" :title="t('Use the recovery code')" width="560">
        <div class="q-gutter-y-sm">
            <q-input v-model="recover.code" outlined dense autocomplete="off" :label="t('Recovery code')"></q-input>
            <q-input v-model="recover.passphrase" outlined dense type="password" autocomplete="new-password" :label="t('A new key passphrase')"></q-input>
            <q-input v-model="recover.passphrase2" outlined dense type="password" autocomplete="new-password" :label="t('The passphrase again')"></q-input>
            <div v-if="recover.passphrase && passwordProblem(recover.passphrase)" class="text-warning text-body2">{{passwordProblem(recover.passphrase)}}</div>
            <div v-if="recover.error" class="text-negative text-body2">{{recover.error}}</div>
            <div class="row justify-end q-gutter-sm">
                <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
                <q-btn unelevated no-caps color="primary" :label="t('Unlock')" :loading="recover.busy"
                        :disable="!recover.code || !!passwordProblem(recover.passphrase) || recover.passphrase !== recover.passphrase2" @click="submitRecover"></q-btn>
            </div>
        </div>
    </m-dialog>

    <m-dialog v-model="change.open" :title="t('Change the passphrase')" width="520">
        <div class="q-gutter-y-sm">
            <q-input v-if="!S.unlocked" v-model="change.current" outlined dense type="password" autocomplete="off" :label="t('The current passphrase')"></q-input>
            <q-input v-model="change.passphrase" outlined dense type="password" autocomplete="new-password" :label="t('A new key passphrase')"></q-input>
            <q-input v-model="change.passphrase2" outlined dense type="password" autocomplete="new-password" :label="t('The passphrase again')"></q-input>
            <div v-if="change.passphrase && passwordProblem(change.passphrase)" class="text-warning text-body2">{{passwordProblem(change.passphrase)}}</div>
            <div v-if="change.error" class="text-negative text-body2">{{change.error}}</div>
            <div class="row justify-end q-gutter-sm">
                <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
                <q-btn unelevated no-caps color="primary" :label="t('Change')" :loading="change.busy"
                        :disable="!!passwordProblem(change.passphrase) || change.passphrase !== change.passphrase2 || (!S.unlocked && !change.current)" @click="submitChange"></q-btn>
            </div>
        </div>
    </m-dialog>

    <!-- a recovery key made: its holders, each key compared, and how many a recovery takes -->
    <m-dialog v-model="makeKey.open" :title="t('New recovery key')" width="640">
        <div class="q-gutter-y-sm">
            <div class="text-body2">{{t('Made in this browser: split among its holders, one share sealed to each one\'s vault key, and then forgotten here. The holders hold the vault recovery permission; you compare each one\'s key fingerprint with them first.')}}</div>
            <m-drop-down id="boss-vault-holder" name="holderUserId" :model-value="makeKey.pick" server-search :server-min-length="0" allow-empty
                    :options-url="url('userChoices') + '?holders=true'" :label="t('Add a holder')" @update:model-value="holderChosen"></m-drop-down>
            <q-list v-if="makeKey.holders.length" bordered separator class="rounded-borders">
                <q-item v-for="holder in makeKey.holders" :key="holder.userId">
                    <q-item-section><q-item-label>{{nameOf(holder.userId)}}<span v-if="holder.userId === S.personal.userId" class="m-muted"> ({{t('you')}})</span></q-item-label>
                        <q-item-label caption class="boss-vault-words">{{holder.words}}</q-item-label></q-item-section>
                    <q-item-section side><div class="row no-wrap items-center q-gutter-x-xs">
                        <q-chip v-if="holder.checked" dense square icon="sym_o_verified" class="m-tonal text-positive">{{t('Compared')}}</q-chip>
                        <q-btn v-else flat dense no-caps size="sm" color="primary" :label="t('Compare')" @click="openCheck(holder.userId, refreshHolders)"></q-btn>
                        <q-btn flat dense round size="sm" icon="close" :aria-label="t('Remove')" @click="makeKey.holders = makeKey.holders.filter((h) => h !== holder)"></q-btn>
                    </div></q-item-section>
                </q-item>
            </q-list>
            <div class="row q-col-gutter-sm">
                <div class="col-6"><q-input v-model.number="makeKey.k" type="number" outlined dense :label="t('Holders a recovery takes')" :min="2" :max="makeKey.holders.length || 2"></q-input></div>
                <div class="col-6"><m-drop-down id="boss-vault-group" name="userGroupId" v-model="makeKey.userGroupId" server-search :server-min-length="0" allow-empty
                        :options-url="url('groupChoices')" :label="t('Kept for the group')"></m-drop-down></div>
            </div>
            <div v-if="makeKey.error" class="text-negative text-body2">{{makeKey.error}}</div>
            <div class="row justify-end q-gutter-sm">
                <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
                <q-btn unelevated no-caps color="primary" :label="t('Make the recovery key')" :loading="makeKey.busy"
                        :disable="makeKey.holders.length < 2 || makeKey.k < 2 || makeKey.k > makeKey.holders.length || makeKey.holders.some((h) => !h.checked)" @click="submitMakeKey"></q-btn>
            </div>
        </div>
    </m-dialog>

    <!-- a recovery started: the vault, the member and their new key, compared first -->
    <m-dialog v-model="startRec.open" :title="t('Start a recovery')" width="600">
        <div class="q-gutter-y-sm">
            <div class="text-body2">{{t('The member made a new vault key after losing their passphrase and recovery code. Ask them for the vault\'s id, compare their new key with them, and keep this tab open until the recovery is finished: the other holders seal their shares to it.')}}</div>
            <q-input v-model="startRec.vaultId" outlined dense autocomplete="off" :label="t('Vault id')"></q-input>
            <m-drop-down id="boss-vault-subject" name="subjectUserId" :model-value="startRec.userId" server-search :server-min-length="0" allow-empty
                    :options-url="url('userChoices')" :label="t('The member')" @update:model-value="subjectChosen"></m-drop-down>
            <template v-if="startRec.key">
                <div class="text-body2">{{fill(t('Ask {name} to read their fingerprint to you, on a call or in person, not by email or chat. It must be exactly these words:'), {name: nameOf(startRec.userId)})}}</div>
                <div class="text-h6 boss-vault-words">{{startRec.words || '…'}}</div>
                <q-checkbox v-if="!startRec.checked" v-model="startRec.match" :label="t('The words match')"></q-checkbox>
            </template>
            <div v-if="startRec.error" class="text-negative text-body2">{{startRec.error}}</div>
            <div class="row justify-end q-gutter-sm">
                <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
                <q-btn unelevated no-caps color="primary" :label="t('Start')" :loading="startRec.busy"
                        :disable="!startRec.key || !String(startRec.vaultId || '').trim() || (!startRec.checked && !startRec.match)" @click="submitStartRecovery"></q-btn>
            </div>
        </div>
    </m-dialog>
</div></template>

<script>
const t = (text) => (moqui.l10n && moqui.l10n.localize ? moqui.l10n.localize(text) : text);
const fill = (text, values) => String(text).replace(/\{(\w+)\}/g, (match, key) => (values[key] == null ? '' : String(values[key])));
const REST = '/rest/s1/vault';
// the name item of the vaults Commons made before vault headers (a vault-info item): read for its name, never listed
const INFO_TYPE = 'vault-info';
const SINGLE = 'VlSingleSecret';
const SHARED = 'VlSharedKey';
const DAY = 86400000;
// a tab hidden this long locks the vault (or sooner, at the idle time)
const HIDDEN_LOCK_MS = 5 * 60000;
// an import file larger than this is refused before it is read
const IMPORT_MAX_BYTES = 10 * 1024 * 1024;
const RECOVERY_PREFIX = 'recovery:';
const EXPORT_ID = /^export-[0-9a-f]{24}$/;
const ROLE_OF = { VrManage: 'manage', VrWrite: 'write', VrRead: 'read' };
const ICONS = { login: 'sym_o_key', note: 'sym_o_sticky_note_2', card: 'sym_o_credit_card', identity: 'sym_o_badge', contact: 'sym_o_person',
    'ssh-key': 'sym_o_terminal', 'api-key': 'sym_o_api', 'database-credential': 'sym_o_database', 'tls-key-pair': 'sym_o_verified_user',
    'registry-login': 'sym_o_inventory_2', 'recovery-code': 'sym_o_password', 'recovery-share': 'sym_o_vpn_key' };
// plans/Vault-Instances.md §3.11, in its exact words
const SINGLE_WARNING = 'Only this password opens this vault. It is never sent to the server and it is not stored anywhere. Nobody can open the vault without it: not an administrator, not your organization, not the makers of this software. If you lose it, everything in the vault is lost for good.';
const COMMON = ['password', 'passw0rd', 'p@ssw0rd', '123456', '12345678', '123456789', '1234567890', 'qwerty', 'qwertyuiop', 'asdfgh', 'letmein',
    'welcome', 'iloveyou', 'admin', 'monkey', 'dragon', 'football', 'baseball', 'sunshine', 'princess', 'abc123', '111111', '000000',
    'trustno1', 'changeme', 'secret', 'master', 'starwars', 'whatever', 'superman', 'correcthorsebatterystaple', 'moqui'];

const hexOf = (bytes) => Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
const randomBytes = (n) => { const b = new Uint8Array(n); crypto.getRandomValues(b); return b; };
const randomId = (prefix) => prefix + '-' + hexOf(randomBytes(12));
const arr = (value) => (Array.isArray(value) ? value.filter((v) => v != null && v !== '').map((v) => String(v)) : []);
const reasonOf = (message) => { const m = /reasonCode (\w+)/.exec(String(message || '')); return m ? m[1] : ''; };
const plainMessage = (message) => String(message || '').replace(/\s*\(reasonCode \w+\)/g, '').trim();
const messageOf = (err) => (err && err.reasonCode === 'cancelled' ? t('Not confirmed, so nothing was done')
    : plainMessage(err && err.message ? err.message : (err && err.errors) || String(err)));
const local = {
    get(key) { try { return JSON.parse(window.localStorage.getItem(key) || 'null'); } catch (err) { return null; } },
    set(key, value) { try { window.localStorage.setItem(key, JSON.stringify(value)); } catch (err) { /* a private window keeps nothing */ } }
};
const isRecoveryMember = (userId) => String(userId || '').startsWith(RECOVERY_PREFIX);

/** A generated key as it was made, from what the user typed: upper case, the look-alikes read as Crockford does, grouped. */
function keyText(typed) {
    const plain = String(typed || '').toUpperCase().replace(/O/g, '0').replace(/[IL]/g, '1').replace(/[^0-9A-Z]/g, '');
    return (plain.match(/.{1,4}/g) || []).join('-');
}
function generatePassword(length) {
    const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789-_.!@#%+=';
    const limit = 256 - (256 % alphabet.length);
    const out = [];
    while (out.length < length) for (const b of randomBytes(length * 2)) { if (b < limit && out.length < length) out.push(alphabet[b % alphabet.length]); }
    return out.join('');
}
/** What is wrong with a password or passphrase, in the user's words; empty when it passes (§3.5, §3.11: length and common words). */
function passwordProblem(value, username) {
    const text = String(value || '');
    if (!text) return t('Enter one');
    if (text.length < 12) return t('Use at least 12 characters');
    const lower = text.toLowerCase();
    if (new Set(text).size < 6) return t('Use more different characters');
    if (COMMON.some((word) => lower.includes(word))) return t('Do not use a common password or word in it');
    if (username && String(username).length > 2 && lower.includes(String(username).toLowerCase())) return t('Do not use your username in it');
    const classes = [/[a-z]/, /[A-Z]/, /[0-9]/, /[^A-Za-z0-9]/].filter((re) => re.test(text)).length;
    if (text.length < 16 && classes < 3) return t('Use 16 or more characters, or mix letters, digits and symbols');
    return '';
}

// ===== import: read in the browser, never sent =====
const clean = (fields) => {
    const out = {};
    for (const [name, value] of Object.entries(fields)) if (value != null && String(value) !== '') out[name] = String(value);
    return out;
};
// a field another password manager kept hidden: kept as a field of its own, which the page shows masked
const customName = (name) => 'custom: ' + String(name || '').trim();
function toEntry(title, username, password, url, notes, totp, tags, hidden) {
    const extra = hidden || {};
    if (!username && !password && !url && !Object.keys(extra).length) return { v: 1, type: 'note', name: title || t('Untitled'), fields: clean({ text: notes }), notes: '', tags, uris: [] };
