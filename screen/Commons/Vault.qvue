        if (v.lockEnumId === SINGLE) {
            if (!opened.has(slot(vaultId, 1))) {
                if (!secret) throw new Error(v.secretKindEnumId === 'VsGenerated' ? t('Enter the vault key') : t('Enter the vault password'));
                await openSingle(c, v, got, secret);
                opened.add(slot(vaultId, 1));
            }
            local.set(keyOf('opened', vaultId), Date.now());
        } else {
            requireUnlocked();
            const wraps = (got.wraps || []).slice().sort((a, b) => a.key_version - b.key_version);
            if (!wraps.some((wrap) => wrap.key_version === v.keyVersion)) throw new Error(t('You have no access to this vault\'s current key'));
            const recoveryKeys = recoveryKeysFor(got.entries);
            for (const wrap of wraps) {
                if (opened.has(slot(vaultId, wrap.key_version))) continue;
                // only through the member list's chain, back to a signer whose key this user compared
                const out = await c.vaultKeyOpen({ entries: got.entries, key_checks: S.keyChecks, recovery_keys: recoveryKeys, wrap, remembered: remembered(vaultId) });
                opened.add(slot(vaultId, wrap.key_version));
                remember(vaultId, out.remembered);
            }
            if (wraps.some((wrap) => wrap.key_version < v.keyVersion)) api('POST', '/vaults/' + enc(vaultId) + '/ack', { keyVersion: v.keyVersion }, { quiet: true }).catch(() => {});
        }
        await loadItems(v);
        v.open = true;
        await names(v.memberList.map((m) => m.userId).concat(v.entries.map((entry) => entry.signer_user_id)));
        return v;
    }
    /** A single-secret vault's key: a generated key by HKDF, a password by Argon2id. A wrap the open raised to the Argon2id target,
     * and a generated key a page wrapped as a password before, are stored again (update#VaultSecretWrap) when this sign-in may. */
    async function openSingle(c, v, got, secret) {
        const vaultId = v.vaultId;
        const wrap = got.secretWrap || {};
        const store = (secretWrap, kind) => api('PUT', '/vaults/' + enc(vaultId) + '/secretWrap', Object.assign({ expectedRevision: v.revision, secretWrap },
            kind ? { secretKindEnumId: kind } : {}), { quiet: true }).then((out) => { if (out.revision) v.revision = out.revision; }, (err) => {
            console.info('Vault: the vault\'s wrap is kept as it was until a strong sign-in: ' + messageOf(err));
        });
        if (v.secretKindEnumId === 'VsGenerated') {
            const generated = keyText(secret);
            if (wrap.m_kib == null) {
                await c.vaultKeyGeneratedOpen({ vault_id: vaultId, key_version: 1, wrap, generated });
                return;
            }
            // made by this page before the module had the generated-key wrap: opened as a password, then wrapped as it should be
            await c.vaultKeyPasswordOpen({ vault_id: vaultId, key_version: 1, wrap, password: generated });
            const again = await c.vaultKeyGeneratedWrap({ vault_id: vaultId, key_version: 1, generated });
            await store(again.wrap, 'VsGenerated');
            return;
        }
        const out = await c.vaultKeyPasswordOpen({ vault_id: vaultId, key_version: 1, wrap, password: secret });
        if (out.rewrapped) await store(out.rewrapped, null);
    }
    async function loadItems(v) {
        const c = await ensureClient();
        const out = await api('GET', '/vaults/' + enc(v.vaultId) + '/items');
        if (out.keyVersion) v.keyVersion = out.keyVersion;
        // the vault's name, from its header (sealed under the current key version)
        if (v.headerCipher) {
            try {
                const header = (await c.headerOpen({ vault_id: v.vaultId, key_version: v.keyVersion, header_cipher: v.headerCipher })).header;
                let parsed = null;
                try { parsed = JSON.parse(header); } catch (err) { parsed = null; }
                v.name = String(parsed && typeof parsed === 'object' ? parsed.name || '' : header);
            } catch (err) {
                v.name = '';
                console.warn('Vault: the header does not open: ' + messageOf(err));
            }
        }
        // the highest revision this browser saw of each item: an older one coming back is told (§3.12)
        const seen = local.get(keyOf('revisions', v.vaultId)) || {};
        let older = false;
        const items = [];
        v.info = null;
        for (const row of out.itemList || []) {
            const raw = Vue.markRaw(row);
            if ((seen[row.vaultItemId] || 0) > (row.revision || 0)) older = true;
            seen[row.vaultItemId] = Math.max(seen[row.vaultItemId] || 0, row.revision || 0);
            try {
                // the masked names of every type: the summary leaves them out whatever the item's type says it is
                const masked = ((S.config && S.config.itemTypes) || []).flatMap((type) => type.fields.filter((field) => field.masked).map((field) => field.name));
                const summary = await c.itemSummary(Object.assign(openArgs(v.vaultId, row), { masked: Array.from(new Set(masked)) }));
                if (summary.type === INFO_TYPE) {
                    v.info = raw;
                    if (!v.headerCipher) v.name = String(summary.name || '');
                    continue;
                }
                items.push(headerOf(raw, summary));
            } catch (err) {
                items.push({ id: row.vaultItemId, row: raw, type: '', name: t('An item that does not open'), uris: [], tags: [], shown: {}, changed: null, broken: messageOf(err) });
            }
        }
        local.set(keyOf('revisions', v.vaultId), seen);
        items.sort((a, b) => a.name.localeCompare(b.name));
        v.items = items;
        v.itemCount = (out.itemList || []).length;
        v.warning = older ? t('The server gave an older copy of an item than this browser saw before. Someone may have put back old data.') : '';
    }
    async function itemBody(vaultId, itemId) {
        const v = vault(vaultId);
        const item = v && v.items.find((entry) => entry.id === itemId);
        if (!item) throw new Error(t('No such item'));
        return parseBody(await openRow(vaultId, item.row));
    }
    /**
     * An item sealed in the worker and stored. Its item key is used again only when it was made at the current key version
     * (itemKeyVersion): the first write after a rotation makes a new one, which the update says (decision (c)); fresh makes a
     * new one in any case.
     */
    async function saveItem(vaultId, item, body, fresh) {
        const v = vault(vaultId);
        const c = await ensureClient();
        const row = item ? item.row : null;
        const id = row ? row.vaultItemId : randomId('vi');
        const args = { vault_id: vaultId, item_id: id, key_version: v.keyVersion, body: JSON.stringify(body) };
        if (row && !fresh) Object.assign(args, { wrapped_item_key: row.wrappedItemKey, wrapped_key_version: row.keyVersion, item_key_version: row.itemKeyVersion });
        const sealed = await c.itemSeal(args);
        const stored = { keyVersion: v.keyVersion, wrappedItemKey: sealed.wrapped_item_key, bodyCipher: sealed.sealed_body };
        if (row) await api('PUT', '/items/' + enc(id), Object.assign({ expectedRevision: row.revision, newItemKey: !!sealed.new_item_key }, stored));
        else await api('POST', '/vaults/' + enc(vaultId) + '/items', Object.assign({ vaultItemId: id }, stored));
        return id;
    }
    async function deleteItem(vaultId, itemId) {
        await api('DELETE', '/items/' + enc(itemId));
        await loadItems(vault(vaultId));
    }
    /** A generated key for a new single-secret vault, made in the module with the vault key: shown once, wrapped by HKDF. */
    async function prepareGenerated() {
        const c = await ensureClient();
        const vaultId = randomId('v');
        await c.vaultKeyNew({ vault_id: vaultId, key_version: 1 });
        opened.add(slot(vaultId, 1));
        const made = await c.vaultKeyGeneratedWrap({ vault_id: vaultId, key_version: 1 });
        return { vaultId, generated: made.generated, wrap: made.wrap };
    }
    async function discardPrepared(prepared) {
        if (!prepared || !client) return;
        opened.delete(slot(prepared.vaultId, 1));
        await client.vaultKeyForget({ vault_id: prepared.vaultId, key_version: 1 }).catch(() => {});
    }
    /** A vault made: its name sealed in its header; single-secret by a password (secret) or the generated key prepared. */
    async function makeVault(name, lockId, secretKind, secret, prepared) {
        const c = await ensureClient();
        const header = JSON.stringify({ v: 1, name });
        let id;
        if (lockId === SINGLE) {
            let secretWrap;
            if (secretKind === 'VsGenerated') {
                if (!prepared) throw new Error(t('Make the generated key again'));
                id = prepared.vaultId;
                secretWrap = prepared.wrap;
            } else {
                id = randomId('v');
                await c.vaultKeyNew({ vault_id: id, key_version: 1 });
                opened.add(slot(id, 1));
                secretWrap = await c.vaultKeyPasswordWrap({ vault_id: id, key_version: 1, password: secret });
            }
            const headerCipher = (await c.headerSeal({ vault_id: id, key_version: 1, header })).header_cipher;
            await api('POST', '/vaults', { vaultId: id, vaultKindEnumId: 'VkPersonal', lockEnumId: SINGLE, secretKindEnumId: secretKind, secretWrap, headerCipher });
            local.set(keyOf('opened', id), Date.now());
        } else {
            requireUnlocked();
            id = randomId('v');
            const me = S.personal;
            const members = [{ user_id: me.userId, role: 'manage', key_id: me.personalKeyId, public: me.public }];
            const entry = await c.keyVersionFirst({ vault_id: id, members, key_checks: S.keyChecks });
            await c.vaultKeyNew({ vault_id: id, key_version: 1 });
            opened.add(slot(id, 1));
            const wrap = await c.vaultKeyWrapMember({ vault_id: id, key_version: 1, member_user_id: me.userId, member_key_id: me.personalKeyId,
                member_public: me.public, key_checks: S.keyChecks });
            const headerCipher = (await c.headerSeal({ vault_id: id, key_version: 1, header })).header_cipher;
            await api('POST', '/vaults', { vaultId: id, vaultKindEnumId: 'VkPersonal', lockEnumId: SHARED, recoveryOn: 'N', entry, memberWraps: [wrap], headerCipher });
            remember(id, await c.chainVerify({ entries: [entry], key_checks: S.keyChecks, remembered: null }));
        }
        await refreshVaults();
        const v = vault(id);
        const got = await api('GET', '/vaults/' + enc(id));
        Object.assign(v, { entries: (got.entries || []).map((entry) => Vue.markRaw(entry)), memberList: got.memberList || [] });
        await loadItems(v);
        v.open = true;
        return id;
    }
    async function deleteVault(vaultId) {
        await api('DELETE', '/vaults/' + enc(vaultId));
        await refreshVaults();
    }

    // ----- members (§3.9) and recovery on a vault (§3.10) -----
    async function afterMembers(vaultId) {
        const v = vault(vaultId);
        const got = await api('GET', '/vaults/' + enc(vaultId));
        remember(vaultId, await client.chainVerify({ entries: got.entries, key_checks: S.keyChecks, recovery_keys: recoveryKeysFor(got.entries),
            remembered: remembered(vaultId) }));
        Object.assign(v, { keyVersion: got.vault.keyVersion, revision: got.vault.revision, recoveryOn: got.vault.recoveryOn, headerCipher: got.vault.headerCipher || '',
            entries: (got.entries || []).map((entry) => Vue.markRaw(entry)), memberList: got.memberList || [] });
        await names(v.memberList.map((m) => m.userId));
    }
    /**
     * The next member list at the same key version, with `member` (a person's key or a recovery key) in it at `role`, and the vault
     * key wrapped to them. When the change leaves a wrap of this key version without a manager's signature (a manager's key
     * changed or a manager demoted), the server names the member whose wrap to remake: each is wrapped again here, to their key
     * in the list, and the change is sent again with them (rewraps), at most once a member.
     */
    async function changeMembers(vaultId, member, recoveryKeys) {
        requireUnlocked();
        const c = await ensureClient();
        const got = await api('GET', '/vaults/' + enc(vaultId));
        const latest = got.entries[got.entries.length - 1];
        const keys = recoveryKeysFor(got.entries).concat(recoveryKeys || []);
        const members = latest.members.filter((m) => m.user_id !== member.user_id).concat([member]);
        const entry = await c.keyVersionNext({ entries: got.entries, key_checks: S.keyChecks, recovery_keys: keys, members, version: latest.version,
            revision: latest.revision + 1, remembered: remembered(vaultId) });
        const wrap = await c.vaultKeyWrapMember({ vault_id: vaultId, key_version: latest.version, member_user_id: member.user_id, member_key_id: member.key_id,
            member_public: member.public, key_checks: S.keyChecks, recovery_keys: keys });
        const rewraps = [];
        for (let tries = 0; tries <= members.length; tries++) {
            try {
                await api('POST', '/vaults/' + enc(vaultId) + '/members', Object.assign({ expectedRevision: got.vault.revision, entry, wrap },
                    rewraps.length ? { rewraps } : {}));
                break;
            } catch (err) {
                const named = /Remake (\S+?)'s wrap/.exec(String(err.message || ''));
                const listed = named && members.find((m) => m.user_id === named[1]);
                if (!listed || rewraps.some((w) => w.member_user_id === listed.user_id)) throw err;
                rewraps.push(await c.vaultKeyWrapMember({ vault_id: vaultId, key_version: latest.version, member_user_id: listed.user_id,
                    member_key_id: listed.key_id, member_public: listed.public, key_checks: S.keyChecks, recovery_keys: keys }));
            }
        }
        await afterMembers(vaultId);
        return rewraps.map((w) => w.member_user_id);
    }
    /** A member added, or a member's changed key given access (§3.10: another member gives a member's new key the vault key). */
    const setMember = (vaultId, key, role) => changeMembers(vaultId, { user_id: key.userId, role, key_id: key.personalKeyId, public: key.public });
    /** Recovery turned on: the organization's recovery key listed as a manager, its maker's key checked here first. */
    async function recoveryOn(vaultId, keyRow) {
        requireUnlocked();
        const c = await ensureClient();
        const record = { record: keyRow.record, maker_public: keyRow.makerPublic };
        const member = await c.recoveryMember(Object.assign({ key_checks: S.keyChecks }, record));
        return changeMembers(vaultId, member, [record]);
    }
    /**
     * A rotation: the next key version without `dropUserId` (and with `add`, a recovery key that replaces a used one), every item
     * key wrapped again, every remaining member's wrap remade and the header sealed again, sent in one change. When the server
     * refuses it, the new key version is forgotten here, so nothing of it is used.
     */
    async function rotate(vaultId, dropUserId, add, recoveryKeys) {
        requireUnlocked();
        const c = await ensureClient();
        const v = vault(vaultId);
        const got = await api('GET', '/vaults/' + enc(vaultId));
        const listed = (await api('GET', '/vaults/' + enc(vaultId) + '/items')).itemList || [];
        const latest = got.entries[got.entries.length - 1];
        const keys = recoveryKeysFor(got.entries).concat(recoveryKeys || []);
        const members = latest.members.filter((m) => m.user_id !== dropUserId).concat(add ? [add] : []);
        const rotated = await c.vaultRotate({ entries: got.entries, key_checks: S.keyChecks, recovery_keys: keys, members,
            items: listed.map((row) => ({ item_id: row.vaultItemId, wrapped_item_key: row.wrappedItemKey })), header_cipher: got.vault.headerCipher || null,
            remembered: remembered(vaultId) });
        try {
            await api('POST', '/vaults/' + enc(vaultId) + '/removeMember', Object.assign({ userId: dropUserId, expectedRevision: got.vault.revision,
                entry: rotated.entry, itemKeys: rotated.item_keys, memberWraps: rotated.member_wraps }, rotated.header_cipher ? { headerCipher: rotated.header_cipher } : {}));
        } catch (err) {
            await c.vaultKeyForget({ vault_id: vaultId, key_version: rotated.key_version }).catch(() => {});
            throw err;
        }
        opened.add(slot(vaultId, rotated.key_version));
        v.keyVersion = rotated.key_version;
        await afterMembers(vaultId);
        await loadItems(v);
    }
    /** A member removed: the vault key rotated; with reencrypt, every item sealed again under a new item key now (decision (c)). */
    async function removeMember(vaultId, userId, reencrypt) {
        await rotate(vaultId, userId, null, null);
        if (reencrypt) {
            const v = vault(vaultId);
            const rows = v.items.filter((item) => !item.broken).concat(v.info ? [{ row: v.info }] : []);
            for (const item of rows) await saveItem(vaultId, item, parseBody(await openRow(vaultId, item.row)), true);
            await loadItems(v);
        }
    }
    /** A used recovery key replaced by another in one rotation, so the vault key the recovering browser saw is replaced too. */
    async function replaceRecovery(vaultId, oldMemberId, keyRow) {
        requireUnlocked();
        const c = await ensureClient();
        const record = { record: keyRow.record, maker_public: keyRow.makerPublic };
        const member = await c.recoveryMember(Object.assign({ key_checks: S.keyChecks }, record));
        await rotate(vaultId, oldMemberId, member, [record]);
    }

    // ----- deliveries -----
    async function fileDelivery(delivery, vaultId) {
        requireUnlocked();
        const c = await ensureClient();
        const out = await c.deliveryOpen({ delivery: delivery.delivery, sender_public: delivery.senderPublic, key_checks: S.keyChecks });
        let body = null;
        try { body = parseBody(out.value); } catch (err) { body = null; }
        if (!body || !body.type || body.type === INFO_TYPE) body = { v: 1, type: 'note', name: t('Sent to you'), fields: { text: String(out.value) } };
        await saveItem(vaultId, null, body);
        await api('POST', '/deliveries/' + enc(delivery.deliveryId) + '/file', {});
        await loadItems(vault(vaultId));
        await refreshDeliveries();
    }
    async function sendItem(vaultId, itemId, key) {
        requireUnlocked();
        const c = await ensureClient();
        const body = await itemBody(vaultId, itemId);
        const sent = await c.deliverySend({ delivery_id: randomId('dl'), to_user_id: key.userId, to_key_id: key.personalKeyId, to_public: key.public,
            purpose: 'item', value: JSON.stringify(body), key_checks: S.keyChecks });
        await api('POST', '/deliveries', { delivery: sent });
    }

    // ----- export and import -----
    async function exportVault(vaultId, password) {
        const c = await ensureClient();
        const v = vault(vaultId);
        const exportId = randomId('export');
        await c.vaultKeyNew({ vault_id: exportId, key_version: 1 });
        try {
            const wrap = await c.vaultKeyPasswordWrap({ vault_id: exportId, key_version: 1, password });
            const rows = v.items.filter((item) => !item.broken).map((item) => item.row);
            const items = [];
            for (const row of rows) {
                const itemId = exportId + '-' + (items.length + 1);
                const sealed = await c.itemSeal({ vault_id: exportId, item_id: itemId, key_version: 1, body: await openRow(vaultId, row) });
                items.push({ item_id: itemId, wrapped_item_key: sealed.wrapped_item_key, sealed_body: sealed.sealed_body });
            }
            return JSON.stringify({ format: 'moqui-vault-export', v: 1, export_id: exportId, key_version: 1, created: Date.now(), wrap, items });
        } finally {
            await c.vaultKeyForget({ vault_id: exportId, key_version: 1 }).catch(() => {});
        }
    }
    /** An encrypted export's items, opened with its password. Its id is an export's, never a vault's this page knows, and its key
     * is opened for this read only. */
    async function readExport(json, password) {
        const c = await ensureClient();
        const exportId = String(json.export_id || '');
        if (!EXPORT_ID.test(exportId) || vault(exportId) || opened.has(slot(exportId, 1))) throw new Error(t('This file is not an export this page can read'));
        // a key of that id left open by anything before is dropped first, so only this password opens it
        await c.vaultKeyForget({ vault_id: exportId, key_version: 1 }).catch(() => {});
        try {
            await c.vaultKeyPasswordOpen({ vault_id: exportId, key_version: 1, wrap: json.wrap, password });
            const out = [];
            for (const row of json.items || []) {
                const body = parseBody((await c.itemOpen({ vault_id: exportId, item_id: String(row.item_id), key_version: 1, wrapped_item_key: row.wrapped_item_key,
                    sealed_body: row.sealed_body })).body);
                if (body.type !== INFO_TYPE) out.push(body);
            }
            return out;
        } finally {
            await c.vaultKeyForget({ vault_id: exportId, key_version: 1 }).catch(() => {});
        }
    }
    async function importItems(vaultId, items, progress) {
        let done = 0;
        let failed = 0;
        for (const body of items) {
            try { await saveItem(vaultId, null, body); done++; } catch (err) { failed++; console.warn('Vault import: an item was not stored: ' + messageOf(err)); }
            if (progress) progress(done + failed);
        }
        await loadItems(vault(vaultId));
        return { done, failed };
    }

    // ----- organization recovery (§3.10; Admin › Security › Recovery keys) -----
    const myHolder = (keyRow) => keyRow.holders.find((h) => h.userId === (S.personal && S.personal.userId)) || null;
    /** A recovery key made here, split k of the holders (each key checked here), its shares sealed to them, then forgotten here. */
    async function makeRecoveryKey(k, holders, userGroupId) {
        requireUnlocked();
        const c = await ensureClient();
        const made = await c.recoveryMake({ recovery_key_id: randomId('rk'), k, key_checks: S.keyChecks,
            holders: holders.map((h) => ({ user_id: h.userId, key_id: h.personalKeyId, public: h.public })) });
        await api('POST', '/recoveryKeys', Object.assign({ record: made.record, shares: made.shares }, userGroupId ? { userGroupId } : {}));
        await refreshRecoveryKeys();
    }
    /** A recovery started by this holder for a member's new key (checked here): its ephemeral key stays in this tab's worker. */
    async function startRecovery(keyRow, vaultId, subjectKey) {
        requireUnlocked();
        const c = await ensureClient();
        const held = myHolder(keyRow);
        if (!held || !held.held) throw new Error(t('You hold no share of this recovery key'));
        const session = await c.recoverySessionStart({ session_id: randomId('rs'), record: keyRow.record, maker_public: keyRow.makerPublic, held: held.held,
            vault_id: vaultId, subject_user_id: subjectKey.userId, subject_key_id: subjectKey.personalKeyId, subject_public: subjectKey.public, key_checks: S.keyChecks });
        await api('POST', '/recoveries', { session });
        await refreshRecoverySessions();
    }
    /** This holder's share sealed to another holder's recovery: the starter's and the member's new keys checked here first. */
    async function deliverShare(row) {
        requireUnlocked();
        const c = await ensureClient();
        const keyRow = S.recoveryKeys.find((k) => k.recoveryKeyId === row.session.recovery_key_id);
        const held = keyRow && myHolder(keyRow);
        if (!held || !held.held) throw new Error(t('You hold no share of this recovery key'));
        const share = await c.recoveryShareDeliver({ record: keyRow.record, maker_public: keyRow.makerPublic, held: held.held, session: row.session,
            session_holder_public: row.holderPublic, session_holder: row.holderShare, key_checks: S.keyChecks });
        await api('POST', '/recoveries/' + enc(row.recoverySessionId) + '/shares', { share });
        await refreshRecoverySessions();
    }
    /** The starter ends the recovery: the shares combined here, the vault key opened through the recovery key's wrap, and the next
     * member list signed by the recovery key giving the member their new key; the module keeps nothing of it after. */
    async function finishRecovery(row) {
        requireUnlocked();
        const c = await ensureClient();
        const sessionId = row.recoverySessionId;
        const open = await api('GET', '/recoveries/' + enc(sessionId));
        const keys = recoveryKeysFor(open.entries);
        // a holder who is also a member may have that key version open: the module opens it again through the recovery key only
        // with no copy of it held, so the member's copy is forgotten first, before the combine (any call between the combine and
        // the rekey drops the combined key); the vault opens again from the member's own wrap
        const wrapVersion = open.recoveryWrap && open.recoveryWrap.key_version;
        if (wrapVersion != null && opened.has(slot(open.session.vault_id, wrapVersion))) {
            await c.vaultKeyForget({ vault_id: open.session.vault_id, key_version: wrapVersion });
            opened.delete(slot(open.session.vault_id, wrapVersion));
            const v = vault(open.session.vault_id);
            if (v) Object.assign(v, blank());
        }
        await c.recoveryCombine({ session_id: sessionId, record: open.record, maker_public: open.makerPublic, held: open.held, deliveries: open.deliveries,
            key_checks: S.keyChecks });
        await c.recoveryOpenVault({ entries: open.entries, key_checks: S.keyChecks, recovery_keys: keys, session_id: sessionId, wrap: open.recoveryWrap });
        const rekeyed = await c.recoveryRekey({ session_id: sessionId, entries: open.entries, key_checks: S.keyChecks, recovery_keys: keys });
        await api('POST', '/recoveries/' + enc(sessionId) + '/complete', { expectedRevision: open.revision, entry: rekeyed.entry, wrap: rekeyed.wrap,
            rewraps: rekeyed.rewraps || [] });
        await refreshRecoverySessions();
        await refreshRecoveryKeys();
    }
    async function cancelRecovery(row) {
        await api('POST', '/recoveries/' + enc(row.recoverySessionId) + '/cancel', {});
        await refreshRecoverySessions();
    }

    async function lock() {
        locking = true;
        try {
            if (client) await client.lock();
            else forget(false);
        } finally {
            locking = false;
        }
    }
    const touch = () => { if (client && (S.unlocked || opened.size)) client.touch(); };
    const copy = async (text) => (await ensureClient()).copy(text);
    const anyOpen = () => opened.size > 0;
    const lastOpened = (vaultId) => local.get(keyOf('opened', vaultId));
    // a tab hidden a while locks; on its return, a lost sign-in locks at the first answer
    let hiddenTimer = null;
    document.addEventListener('visibilitychange', () => {
        clearTimeout(hiddenTimer);
        if (!anyOpen() && !S.unlocked) return;
        if (document.visibilityState === 'hidden') {
            const idle = S.config && S.config.idleMinutes > 0 ? S.config.idleMinutes * 60000 : HIDDEN_LOCK_MS;
            hiddenTimer = setTimeout(() => lock(), Math.min(HIDDEN_LOCK_MS, idle));
        } else api('GET', '/personalKey', null, { quiet: true }).catch(() => {});
    });

    return { S, api, init, refresh, refreshVaults, refreshDeliveries, refreshChecks, refreshRecoveryKeys, refreshRecoverySessions, names, unlock,
        changePassphrase, unlockWithCode, strongReady, makeKey, saveKey, discardKey, checked, publicKeyOf, fingerprintOf, storeCheck, openVault, loadItems,
        itemBody, saveItem, deleteItem, prepareGenerated, discardPrepared, makeVault, deleteVault, setMember, recoveryOn, removeMember, replaceRecovery,
        fileDelivery, sendItem, exportVault, readExport, importItems, makeRecoveryKey, startRecovery, deliverShare, finishRecovery, cancelRecovery, myHolder,
        lock, touch, copy, typeOf, vault, anyOpen, lastOpened, openRow, parseBody, INFO_TYPE };
}
const session = window.BossVaultSession || (window.BossVaultSession = makeSession());

const blankMake = () => ({ open: false, step: 'choose', name: '', lock: SHARED, passphrase: '', kind: 'VsPassword', password: '', password2: '', key: '',
    typed: '', stored: false, busy: false, error: '' });
const blankMembers = () => ({ open: false, keys: {}, words: {}, busy: false, error: '', remove: null, reencrypt: true, recoveryKeyId: null,
    add: { userId: null, key: null, words: '', match: false, role: 'write' } });
// a generated key prepared for New vault, outside Vue's data: its vault key is in the worker until the vault is made or the dialog closes
let prepared = null;

module.exports = {
    name: 'BossVault',
    data() {
        return {
            S: session.S, SINGLE, SHARED, SINGLE_WARNING, search: '', typeFilter: '', revealed: {}, detail: null, myWords: '', checksWords: {},
            unlockForm: { passphrase: '', secret: '', show: false, busy: false, error: '', check: [] },
            unlockDialog: { open: false, passphrase: '', busy: false, error: '', then: null },
            edit: { open: false, item: null, type: 'login', name: '', fields: {}, show: {}, uris: '', tags: '', notes: '', busy: false },
            make: blankMake(),
            check: { open: false, userId: '', name: '', key: null, words: '', match: false, busy: false, error: '', then: null },
            members: blankMembers(),
            recovery: { busy: '', error: '', check: [] },
            makeKey: { open: false, pick: null, holders: [], k: 2, userGroupId: null, busy: false, error: '' },
            startRec: { open: false, keyRow: null, vaultId: '', userId: null, key: null, words: '', checked: false, match: false, busy: false, error: '' },
            seq: 0,
            deliveries: { open: false, vaultId: null, busy: '', error: '' },
            send: { open: false, userId: null, key: null, words: '', checked: false, match: false, busy: false, error: '' },
            copyTo: { open: false, vaultId: null, busy: false },
            history: { open: false, busy: false, rows: [], shown: {} },
            importer: { open: false, vaultId: null, fileName: '', parsed: null, password: '', busy: false, progress: 0, total: 0, result: '', error: '' },
            exporter: { open: false, vaultId: null, password: '', password2: '', busy: false, error: '' },
            about: false,
            setup: { open: false, mode: 'new', step: 'passphrase', passphrase: '', passphrase2: '', code: '', group: 0, typed: '', fingerprint: '', busy: false, error: '' },
            recover: { open: false, code: '', passphrase: '', passphrase2: '', busy: false, error: '' },
            change: { open: false, current: '', passphrase: '', passphrase2: '', busy: false, error: '' }
        };
    },
    computed: {
        phone() { return this.$q.screen.lt.sm; },
        wide() { return this.$q.screen.gt.sm; },
        dark() { return this.$q.dark.isActive; },
        pathList() { return this.$root.currentPathList || []; },
        keyView() { return this.pathList.includes('VaultKey'); },
        recoveryView() { return this.pathList.includes('RecoveryKeys'); },
        screenIndex() { return this.pathList.lastIndexOf(this.recoveryView ? 'RecoveryKeys' : (this.keyView ? 'VaultKey' : 'Vault')); },
        screenPath() { return this.$root.basePath + '/' + (this.screenIndex >= 0 ? this.pathList.slice(0, this.screenIndex + 1) : ['Commons', 'Vault']).join('/'); },
        linkPath() { return this.$root.linkBasePath + '/' + (this.screenIndex >= 0 ? this.pathList.slice(0, this.screenIndex + 1) : ['Commons', 'Vault']).join('/'); },
        params() { return this.$root.currentParameters || {}; },
        current() { return this.params.vaultId ? session.vault(this.params.vaultId) : null; },
        currentItem() { return this.current && this.current.open && this.params.itemId ? this.current.items.find((item) => item.id === this.params.itemId) || null : null; },
        needsFactor() { return this.S.needsFactor; },
        anyUnlocked() { return this.S.unlocked || this.S.vaults.some((v) => v.open); },
        openVaults() { return this.S.vaults.filter((v) => v.open); },
        writableOpen() { return this.openVaults.filter((v) => this.writable(v)); },
        writableOptions() { return this.writableOpen.map((v) => ({ value: v.vaultId, label: v.name || t('Vault') })); },
        openOptions() { return this.openVaults.map((v) => ({ value: v.vaultId, label: v.name || t('Vault') })); },
        typeOptions() { return ((this.S.config && this.S.config.itemTypes) || []).map((type) => ({ value: type.id, label: type.label })); },
        roleOptions() { return [{ value: 'read', label: t('Read') }, { value: 'write', label: t('Write') }, { value: 'manage', label: t('Manage') }]; },
        lockOptions() {
            return [{ value: SHARED, label: t('Shared key: opened by your vault key. You can share it, and each member keeps access of their own.') },
                { value: SINGLE, label: t('Single secret: one password or generated key, yours only. It cannot be shared, and nobody can recover it for you.') }];
        },
        secretOptions() { return [{ value: 'VsPassword', label: t('A password') }, { value: 'VsGenerated', label: t('A generated key') }]; },
        secretReady() {
            const m = this.make;
            if (!m.stored) return false;
            if (m.kind === 'VsGenerated') return m.typed.length > 0 && keyText(m.typed).replace(/-/g, '').slice(-8) === m.key.replace(/-/g, '').slice(-8) && keyText(m.typed).replace(/-/g, '').length >= 8;
            return !passwordProblem(m.password, this.S.config && this.S.config.username) && m.password === m.password2;
        },
        typeCounts() {
            if (!this.current) return [];
            const counts = new Map();
            for (const item of this.current.items) counts.set(item.type, (counts.get(item.type) || 0) + 1);
            return Array.from(counts.entries()).map(([id, count]) => ({ id, count, label: this.typeLabel(id) })).sort((a, b) => a.label.localeCompare(b.label));
        },
        shownItems() { return this.current ? this.current.items.filter((item) => !this.typeFilter || item.type === this.typeFilter) : []; },
        results() {
            const text = String(this.search || '').trim().toLowerCase();
            if (!text) return [];
            const hits = [];
            for (const v of this.openVaults) for (const item of v.items) {
                const hay = [item.name, this.typeLabel(item.type)].concat(item.uris, item.tags, Object.values(item.shown)).join('\n').toLowerCase();
                if (hay.includes(text)) hits.push({ vaultId: v.vaultId, item });
            }
            return hits.slice(0, 200);
        },
        memberRows() {
            const v = this.current;
            if (!v) return [];
            const latest = v.entries.length ? v.entries[v.entries.length - 1] : { members: [] };
            return v.memberList.map((m) => {
                const listed = latest.members.find((entry) => entry.user_id === m.userId) || {};
                const active = this.members.keys[m.userId];
                return { userId: m.userId, roleEnumId: m.roleEnumId, me: m.userId === this.S.personal.userId, public: listed.public || '', recovery: isRecoveryMember(m.userId),
                    words: this.members.words[m.userId] || '', checked: !!listed.public && session.checked(m.userId, listed.public),
                    changed: !!(active && active.hasKey && listed.public && active.public !== listed.public) };
            });
        },
        recoveryMember() {
            const v = this.current;
            const latest = v && v.entries.length ? v.entries[v.entries.length - 1] : null;
            const member = latest ? latest.members.find((m) => isRecoveryMember(m.user_id)) : null;
            return member ? member.user_id : null;
        },
        recoveryOptions() {
            const now = this.recoveryMember ? this.recoveryMember.slice(RECOVERY_PREFIX.length) : null;
            return this.S.recoveryKeys.filter((key) => !key.used && key.recoveryKeyId !== now).map((key) => ({ value: key.recoveryKeyId,
                label: this.keptFor(key) + ' · ' + fill(t('{k} of {n} holders'), { k: key.record.k, n: key.record.n }) + ' · ' + fill(t('made by {name}'), { name: this.nameOf(key.record.maker_user_id) }) }));
        },
        importSummary() {
            const parsed = this.importer.parsed;
            if (!parsed) return '';
            const counts = new Map();
            for (const item of parsed.items) counts.set(item.type, (counts.get(item.type) || 0) + 1);
            return this.itemsText(parsed.items.length) + ': ' + Array.from(counts.entries()).map(([type, count]) => this.typeLabel(type) + ' ' + count).join(', ');
        }
    },
    watch: {
        'S.lockCount'() { this.forgetShown(); },
        'make.open'(open) { if (!open) this.dropPrepared(); },
        'params.itemId'() { this.revealed = {}; this.detail = null; this.loadDetail(); },
        'params.vaultId'() { this.unlockForm.error = ''; this.unlockForm.check = []; this.unlockForm.secret = ''; this.typeFilter = ''; },
        'S.unlocked'(open) { if (open) this.loadKeyWords(); },
        'S.keyChecks'() { this.loadKeyWords(); },
        'S.personal'() { this.loadKeyWords(); }
    },
    methods: {
        t, fill,
        passwordProblem(value) { return passwordProblem(value, this.S.config && this.S.config.username); },
        url(name) { return this.screenPath + '/' + name; },
        go(path) { this.$root.setUrl(this.$root.linkBasePath + path); },
        nameOf(userId) { return this.S.names[userId] || userId || ''; },
        vault(vaultId) { return session.vault(vaultId) || {}; },
        typeOf(id) { return session.typeOf(id); },
        typeLabel(id) { const type = session.typeOf(id); return type ? type.label : (id || t('Item')); },
        iconOf(id) { return ICONS[id] || 'sym_o_lock'; },
        writable(v) { return !!v && (v.lockEnumId === SINGLE || v.roleEnumId === 'VrManage' || v.roleEnumId === 'VrWrite'); },
        manages(v) { return !!v && (v.lockEnumId === SINGLE || v.roleEnumId === 'VrManage'); },
        roleText(roleId) { return { VrManage: t('Manage'), VrWrite: t('Write'), VrRead: t('Read') }[roleId] || roleId || ''; },
        lockText(v) { return v.lockEnumId === SINGLE ? (v.secretKindEnumId === 'VsGenerated' ? t('Single secret, a generated key') : t('Single secret, a password')) : t('Shared key'); },
        keptFor(key) { return key.userGroupId ? fill(t('For {group}'), { group: key.userGroupId }) : (key.instanceId ? fill(t('For instance {id}'), { id: key.instanceId }) : t('For the organization')); },
        recoveryKeyRow(memberId) { const id = String(memberId || '').slice(RECOVERY_PREFIX.length); return this.S.recoveryKeys.find((key) => key.recoveryKeyId === id) || null; },
        holdsShare(key) { const held = session.myHolder(key); return !!(held && held.held && held.keyActive); },
        itemsText(count) { return count === 1 ? t('1 item') : fill(t('{count} items'), { count }); },
        itemCount(v) { return v.open ? v.items.length : (v.itemCount || 0); },
        reminder(v) {
            if (v.lockEnumId !== SINGLE) return false;
            const last = session.lastOpened(v.vaultId) || (v.createdDate ? new Date(v.createdDate).getTime() : Date.now());
            return Date.now() - Number(last) > 30 * DAY;
        },
        subtitle(item) { return item.shown.username || item.shown.email || item.shown.organization || item.shown.cardholder || item.uris[0] || this.typeLabel(item.type); },
        dateText(value) {
            if (value == null || value === '') return '';
            const date = new Date(typeof value === 'number' || /^\d+$/.test(String(value)) ? Number(value) : value);
            return isNaN(date.getTime()) ? String(value) : date.toLocaleDateString();
        },
        safeUrl(value) { const text = String(value || '').trim(); return /^https?:\/\//i.test(text) ? text : (/^[\w.-]+\.[a-z]{2,}(\/|$)/i.test(text) ? 'https://' + text : null); },
        fieldsOf(item) {
            const type = session.typeOf(item.type);
            const out = [];
            for (const field of type ? type.fields : []) {
                if (field.masked) out.push(Object.assign({}, field, { value: null }));
                else if (item.shown[field.name] != null) out.push(Object.assign({}, field, { value: item.shown[field.name] }));
            }
            // a field the type does not name (another password manager's hidden field) is shown masked
            for (const name of (this.detail && this.detail.extra) || []) out.push({ name, label: name.replace(/^custom: /, ''), kind: 'secret', masked: true, value: null });
            return out;
        },
        notify(message) { moqui.notifyMessages([{ type: 'success', message }]); },
        fail(err) { moqui.notifyMessages(null, messageOf(err)); },
        touch() { session.touch(); },
        start() { return session.init(this.screenPath); },
        setParams(params) { this.$root.setUrl(this.linkPath + (Object.keys(params).length ? '?' + moqui.objToSearch(params) : '')); },
        selectVault(vaultId) { this.search = ''; this.setParams(vaultId ? { vaultId } : {}); },
        selectItem(vaultId, itemId) { this.search = ''; this.setParams(itemId ? { vaultId, itemId } : { vaultId }); },
        /** What a lock drops from this page too: shown values, every form that holds a value or a secret, and every dialog. */
        forgetShown() {
            this.revealed = {};
            this.detail = null;
            this.history = { open: false, busy: false, rows: [], shown: {} };
            this.edit = { open: false, item: null, type: 'login', name: '', fields: {}, show: {}, uris: '', tags: '', notes: '', busy: false };
            this.importer = { open: false, vaultId: null, fileName: '', parsed: null, password: '', busy: false, progress: 0, total: 0, result: '', error: '' };
            this.exporter = { open: false, vaultId: null, password: '', password2: '', busy: false, error: '' };
            this.make = blankMake();
            this.members = blankMembers();
            this.send = { open: false, userId: null, key: null, words: '', checked: false, match: false, busy: false, error: '' };
            this.copyTo = { open: false, vaultId: null, busy: false };
            this.unlockForm = { passphrase: '', secret: '', show: false, busy: false, error: '', check: [] };
            this.unlockDialog = { open: false, passphrase: '', busy: false, error: '', then: null };
            this.check = { open: false, userId: '', name: '', key: null, words: '', match: false, busy: false, error: '', then: null };
            this.setup = { open: false, mode: 'new', step: 'passphrase', passphrase: '', passphrase2: '', code: '', group: 0, typed: '', fingerprint: '', busy: false, error: '' };
            this.recover = { open: false, code: '', passphrase: '', passphrase2: '', busy: false, error: '' };
            this.change = { open: false, current: '', passphrase: '', passphrase2: '', busy: false, error: '' };
            this.makeKey = { open: false, pick: null, holders: [], k: 2, userGroupId: null, busy: false, error: '' };
            this.startRec = { open: false, keyRow: null, vaultId: '', userId: null, key: null, words: '', checked: false, match: false, busy: false, error: '' };
            this.checksWords = {};
            this.myWords = '';
            prepared = null;
        },
        // any use of the page counts: dialogs render outside this component's element, so the document is listened to
        onActivity() { session.touch(); },
        async loadKeyWords() {
            const p = this.S.personal;
            if (!p || !p.hasKey || !this.keyView) return;
            try {
                this.myWords = await session.fingerprintOf(p.public);
                const words = {};
                for (const row of this.S.keyChecks) words[row.checked_key_id] = await session.fingerprintOf(String(row.checked_encrypt) + String(row.checked_verify));
                this.checksWords = words;
                await session.names(this.S.keyChecks.map((row) => row.checked_user_id));
            } catch (err) { this.fail(err); }
        },
        async loadDetail() {
            const item = this.currentItem;
            if (!item || item.broken) return;
            try {
                const body = await session.itemBody(this.current.vaultId, item.id);
                const type = session.typeOf(body.type);
                const extra = Object.keys(body.fields || {}).filter((name) => !(type && type.fields.some((field) => field.name === name)));
                if (this.currentItem === item) this.detail = { notes: String(body.notes || ''), extra };
            } catch (err) { this.fail(err); }
        },
        // ----- opening -----
        async openCurrent() {
            const v = this.current;
            if (!v || this.unlockForm.busy) return;
            this.unlockForm.busy = true;
            this.unlockForm.error = '';
            this.unlockForm.check = [];
            try {
                if (v.lockEnumId === SHARED && !this.S.unlocked) {
                    await session.unlock(this.unlockForm.passphrase);
                    this.unlockForm.passphrase = '';
                }
                await session.openVault(v.vaultId, this.unlockForm.secret);
                this.unlockForm.secret = '';
                this.loadDetail();
            } catch (err) {
                const message = messageOf(err);
                this.unlockForm.error = /does not open/.test(message) ? (v.lockEnumId === SINGLE ? t('That does not open this vault') : t('That passphrase does not open your vault key')) : message;
                if (/has been checked|has not been checked/.test(message)) {
                    const me = this.S.personal.userId;
                    this.unlockForm.check = Array.from(new Set((v.entries || []).map((entry) => entry.signer_user_id).filter((id) => id && id !== me)));
                    await session.names(this.unlockForm.check);
                }
            } finally {
                this.unlockForm.busy = false;
            }
        },
        openUnlock(then) { this.unlockDialog = { open: true, passphrase: '', busy: false, error: '', then }; },
        async submitUnlock() {
            const d = this.unlockDialog;
            d.busy = true;
            d.error = '';
            try {
                await session.unlock(d.passphrase);
                d.open = false;
                d.passphrase = '';
                if (d.then) d.then();
            } catch (err) {
                d.error = /does not open/.test(messageOf(err)) ? t('That passphrase does not open your vault key') : messageOf(err);
            } finally { d.busy = false; }
        },
        async needUnlocked(then) {
            if (this.S.unlocked) return true;
            if (!this.S.personal.hasKey) { this.fail(t('Set up your vault key first, in Settings › Vault key')); return false; }
            this.openUnlock(then);
            return false;
        },
        lockNow() { session.lock().then(() => this.notify(t('Locked'))); },
        // ----- an item -----
        async toggleReveal(field) {
            if (this.revealed[field.name] != null) { delete this.revealed[field.name]; this.revealed = Object.assign({}, this.revealed); return; }
            try {
                const body = await session.itemBody(this.current.vaultId, this.currentItem.id);
                const value = body.fields && body.fields[field.name] != null ? String(body.fields[field.name]) : '';
                this.revealed = Object.assign({}, this.revealed, { [field.name]: value });
            } catch (err) { this.fail(err); }
        },
        async copyField(field) {
            try {
                let value = field.value;
                if (field.masked) {
                    const body = await session.itemBody(this.current.vaultId, this.currentItem.id);
                    value = body.fields && body.fields[field.name] != null ? String(body.fields[field.name]) : '';
                }
                await session.copy(value);
                this.notify(field.masked ? fill(t('Copied; cleared from the clipboard in {seconds} s'), { seconds: this.S.config.clipboardSeconds }) : t('Copied'));
            } catch (err) { this.fail(err); }
        },
        async openEdit(item) {
            const v = this.current;
            if (!v || !v.open) return;
            const e = { open: true, item, type: 'login', name: '', fields: {}, show: {}, uris: '', tags: '', notes: '', busy: false };
            if (item) {
                try {
                    const body = await session.itemBody(v.vaultId, item.id);
                    Object.assign(e, { type: String(body.type || 'note'), name: String(body.name || ''), fields: Object.assign({}, body.fields || {}),
                        uris: arr(body.uris).join('\n'), tags: arr(body.tags).join(', '), notes: String(body.notes || '') });
                } catch (err) { this.fail(err); return; }
            } else if (this.typeFilter && session.typeOf(this.typeFilter)) e.type = this.typeFilter;
            this.edit = e;
        },
        generateFor(field) { this.edit.fields[field.name] = generatePassword(20); this.edit.show[field.name] = true; },
        async saveEdit() {
            const e = this.edit;
            const v = this.current;
            if (!v || e.busy) return;
            e.busy = true;
            try {
                const type = session.typeOf(e.type);
                const fields = {};
                for (const field of type ? type.fields : []) if (e.fields[field.name] != null && String(e.fields[field.name]) !== '') fields[field.name] = String(e.fields[field.name]);
                // a field an import brought that the type does not know is kept as it was
                for (const [name, value] of Object.entries(e.fields)) if (!(name in fields) && !(type && type.fields.some((f) => f.name === name)) && value != null && value !== '') fields[name] = String(value);
                const body = { v: 1, type: e.type, name: String(e.name).trim(), fields, notes: String(e.notes || ''),
                    tags: String(e.tags || '').split(',').map((tag) => tag.trim()).filter((tag) => tag),
                    uris: String(e.uris || '').split(/\r?\n/).map((uri) => uri.trim()).filter((uri) => uri) };
                const id = await session.saveItem(v.vaultId, e.item, body);
                await session.loadItems(v);
                this.edit = Object.assign(e, { open: false, fields: {}, notes: '' });
                this.selectItem(v.vaultId, id);
                this.revealed = {};
                this.loadDetail();
                this.notify(t('Saved'));
            } catch (err) {
                if (/changed since|stale|revision/i.test(messageOf(err))) { await session.loadItems(v).catch(() => {}); this.fail(t('The item was changed elsewhere: open it again and make your change there')); }
                else this.fail(err);
            } finally { e.busy = false; }
        },
        confirmDeleteItem() {
            const v = this.current;
            const item = this.currentItem;
            this.$q.dialog({ title: t('Delete the item'), message: fill(t('Delete {name}? Its history goes too.'), { name: item.name || t('Untitled') }),
                ok: { label: t('Delete'), color: 'negative', unelevated: true, noCaps: true }, cancel: { label: t('Cancel'), flat: true, noCaps: true } })
                .onOk(() => session.deleteItem(v.vaultId, item.id).then(() => { this.selectItem(v.vaultId, null); this.notify(t('Deleted')); }, (err) => this.fail(err)));
        },
        async openHistory() {
            const item = this.currentItem;
            this.history = { open: true, busy: true, rows: [], shown: {} };
            try {
                this.history.rows = (await session.api('GET', '/items/' + encodeURIComponent(item.id) + '/history')).historyList || [];
            } catch (err) { this.fail(err); }
            this.history.busy = false;
        },
        async toggleHistory(row) {
            if (this.history.shown[row.revision]) { this.history.shown = Object.assign({}, this.history.shown, { [row.revision]: '' }); return; }
            try {
                const body = session.parseBody(await session.openRow(this.current.vaultId, row));
                const type = session.typeOf(body.type);
                const lines = [String(body.name || '')].concat(Object.entries(body.fields || {}).map(([name, value]) => {
                    const def = type ? type.fields.find((f) => f.name === name) : null;
                    return (def ? def.label : name) + ': ' + value;
                }));
                if (body.notes) lines.push(t('Notes') + ': ' + body.notes);
                this.history.shown = Object.assign({}, this.history.shown, { [row.revision]: lines.join('\n') });
            } catch (err) { this.fail(/locked/.test(messageOf(err)) ? t('That version is under a key this browser no longer holds') : err); }
        },
        openCopyTo() { this.copyTo = { open: true, vaultId: null, busy: false }; },
        async submitCopyTo() {
            this.copyTo.busy = true;
            try {
                const body = await session.itemBody(this.current.vaultId, this.currentItem.id);
                const id = await session.saveItem(this.copyTo.vaultId, null, body);
                await session.loadItems(session.vault(this.copyTo.vaultId));
                this.copyTo.open = false;
                this.selectItem(this.copyTo.vaultId, id);
                this.notify(t('Copied to the vault'));
            } catch (err) { this.fail(err); }
            this.copyTo.busy = false;
        },
        // ----- vaults -----
        openMake() {
            this.dropPrepared();
            this.make = Object.assign(blankMake(), { open: true, lock: this.S.personal.hasKey ? SHARED : SINGLE });
        },
        async secretKindChanged(kind) {
            this.make.stored = false;
            this.make.typed = '';
            if (kind !== 'VsGenerated' || this.make.key) return;
            try {
                prepared = await session.prepareGenerated();
                this.make.key = prepared.generated;
            } catch (err) { this.make.error = messageOf(err); }
        },
        dropPrepared() {
            const was = prepared;
            prepared = null;
            if (was) session.discardPrepared(was);
            if (this.make.key) this.make.key = '';
        },
        async submitMake() {
            const m = this.make;
            if (m.busy) return;
            m.busy = true;
            m.error = '';
            try {
                if (m.lock === SHARED && !this.S.unlocked) { await session.unlock(m.passphrase); m.passphrase = ''; }
                const secret = m.lock === SINGLE && m.kind === 'VsPassword' ? m.password : null;
                const id = await session.makeVault(String(m.name).trim(), m.lock, m.kind, secret, m.kind === 'VsGenerated' ? prepared : null);
                prepared = null;
                this.make = blankMake();
                this.selectVault(id);
                this.notify(t('The vault is made'));
            } catch (err) {
                m.error = /does not open/.test(messageOf(err)) ? t('That passphrase does not open your vault key') : messageOf(err);
            } finally { m.busy = false; }
        },
        confirmDeleteVault() {
            const v = this.current;
            this.$q.dialog({ title: t('Delete the vault'), message: fill(t('Delete {name} and its {count} items, for every member? This cannot be undone.'), { name: v.name || t('the vault'), count: v.items.length }),
                ok: { label: t('Delete'), color: 'negative', unelevated: true, noCaps: true }, cancel: { label: t('Cancel'), flat: true, noCaps: true } })
                .onOk(() => session.deleteVault(v.vaultId).then(() => { this.selectVault(null); this.notify(t('Deleted')); }, (err) => this.fail(err)));
        },
        downloadKey(text, name) { moqui.saveBlob(name + '.txt', new Blob([text + '\n'], { type: 'text/plain' })); },
        printKey(text, title) {
            const win = window.open('', '_blank', 'noopener=no,width=640,height=400');
            if (!win) { this.fail(t('The print window was blocked: download the file and print it instead')); return; }
            const doc = win.document;
            doc.title = title;
            const heading = doc.createElement('h2');
            heading.textContent = title;
            const pre = doc.createElement('pre');
            pre.style.fontSize = '20px';
            pre.textContent = text;
            doc.body.appendChild(heading);
            doc.body.appendChild(pre);
            win.focus();
            win.print();
        },
        // ----- key checks -----
        async openCheck(userId, then) {
            await session.names([userId]);
            this.check = { open: true, userId, name: this.nameOf(userId), key: null, words: '', match: false, busy: false, error: '', then };
            if (!(await this.needUnlocked(() => this.openCheck(userId, then)))) { this.check.open = false; return; }
            try {
                const key = await session.publicKeyOf(userId);
                this.check.key = key;
                if (key.hasKey) this.check.words = await session.fingerprintOf(key.public);
            } catch (err) { this.check.error = messageOf(err); }
        },
        async submitCheck() {
            const c = this.check;
            c.busy = true;
            try {
                await session.storeCheck(c.key, c.words);
                c.open = false;
                this.notify(fill(t('{name}\'s key is compared'), { name: c.name }));
                if (c.then) c.then();
            } catch (err) { c.error = messageOf(err); }
            c.busy = false;
        },
        // ----- members -----
        async openMembers() {
            if (!(await this.needUnlocked(() => this.openMembers()))) return;
            this.members = Object.assign(blankMembers(), { open: true });
            session.refreshRecoveryKeys().catch(() => {});
            this.loadMemberKeys();
        },
        async loadMemberKeys() {
            const v = this.current;
            if (!v) return;
            const latest = v.entries.length ? v.entries[v.entries.length - 1] : { members: [] };
            for (const m of latest.members.filter((member) => !isRecoveryMember(member.user_id))) {
                try { this.members.words = Object.assign({}, this.members.words, { [m.user_id]: await session.fingerprintOf(m.public) }); } catch (err) { /* left blank */ }
                if (m.user_id === this.S.personal.userId) continue;
                try { this.members.keys = Object.assign({}, this.members.keys, { [m.user_id]: await session.publicKeyOf(m.user_id) }); } catch (err) { /* not shown as changed */ }
            }
        },
        async memberChosen(userId) {
            const seq = ++this.seq;
            this.members.add = { userId, key: null, words: '', match: false, role: this.members.add.role };
            if (!userId) return;
            try {
                await session.names([userId]);
                const key = await session.publicKeyOf(userId);
                const words = key.hasKey ? await session.fingerprintOf(key.public) : '';
                // an answer for a person chosen before is dropped
                if (seq !== this.seq || this.members.add.userId !== userId || key.userId !== userId) return;
                if (!key.hasKey) { this.members.error = t('They have no vault key yet. Ask them to set one up in Settings › Vault key.'); return; }
                this.members.error = '';
                Object.assign(this.members.add, { key, words, match: session.checked(userId, key.public) });
            } catch (err) { if (seq === this.seq) this.members.error = messageOf(err); }
        },
        async submitAddMember() {
            const add = this.members.add;
            this.members.busy = true;
            this.members.error = '';
            try {
                if (!session.checked(add.userId, add.key.public)) await session.storeCheck(add.key, add.words);
                await session.setMember(this.current.vaultId, add.key, add.role);
                this.members.add = { userId: null, key: null, words: '', match: false, role: add.role };
                await this.loadMemberKeys();
                this.notify(t('Added'));
            } catch (err) { this.members.error = messageOf(err); }
            this.members.busy = false;
        },
        /** A member whose vault key changed: their new key, once compared, given access at their role (§3.10 for a shared vault). */
        async regrant(member) {
            const key = this.members.keys[member.userId];
            if (!key || !session.checked(member.userId, key.public)) { this.openCheck(member.userId, () => this.regrant(member)); return; }
            this.members.busy = true;
            this.members.error = '';
            try {
                await session.setMember(this.current.vaultId, key, ROLE_OF[member.roleEnumId] || 'read');
                await this.loadMemberKeys();
                this.notify(fill(t('{name}\'s new key has access'), { name: this.nameOf(member.userId) }));
            } catch (err) { this.members.error = messageOf(err); }
            this.members.busy = false;
        },
        /** Recovery turned on with the key chosen (its maker's key compared first), or a used recovery key replaced by it. */
        async submitRecoveryOn() {
            const keyRow = this.S.recoveryKeys.find((key) => key.recoveryKeyId === this.members.recoveryKeyId);
            if (!keyRow) return;
            const maker = keyRow.record.maker_user_id;
            if (maker !== this.S.personal.userId && !session.checked(maker, keyRow.makerPublic)) { this.openCheck(maker, () => this.submitRecoveryOn()); return; }
            this.members.busy = true;
            this.members.error = '';
            try {
                if (this.recoveryMember) await session.replaceRecovery(this.current.vaultId, this.recoveryMember, keyRow);
                else await session.recoveryOn(this.current.vaultId, keyRow);
                this.members.recoveryKeyId = null;
                this.notify(t('Organization recovery is on'));
            } catch (err) { this.members.error = messageOf(err); }
            this.members.busy = false;
        },
        async submitRemoveMember() {
            const member = this.members.remove;
            this.members.busy = true;
            this.members.error = '';
            try {
                await session.removeMember(this.current.vaultId, member.userId, this.members.reencrypt);
                this.members.remove = null;
                await this.loadMemberKeys();
                this.notify(fill(t('{name} is removed and the vault has a new key'), { name: this.nameOf(member.userId) }));
            } catch (err) {
                const message = messageOf(err);
                this.members.error = /has not been checked/.test(message) ? t('Compare the key of every member who stays first') : message;
            }
            this.members.busy = false;
        },
        // ----- deliveries and sending -----
        async openDeliveries() {
            if (!(await this.needUnlocked(() => this.openDeliveries()))) return;
            this.deliveries = { open: true, vaultId: this.writableOpen.length ? (this.current && this.writable(this.current) && this.current.open ? this.current.vaultId : this.writableOpen[0].vaultId) : null, busy: '', error: '' };
            session.refreshDeliveries().catch((err) => { this.deliveries.error = messageOf(err); });
        },
        async submitFile(d) {
            this.deliveries.busy = d.deliveryId;
            this.deliveries.error = '';
            try { await session.fileDelivery(d, this.deliveries.vaultId); this.notify(t('Filed')); } catch (err) {
                const message = messageOf(err);
                this.deliveries.error = /has not been checked|key changed/.test(message) ? fill(t('Compare {name}\'s key first'), { name: this.nameOf(d.delivery.sender_id) }) : message;
            }
            this.deliveries.busy = '';
        },
        async openSend() {
            if (!(await this.needUnlocked(() => this.openSend()))) return;
            this.send = { open: true, userId: null, key: null, words: '', checked: false, match: false, busy: false, error: '' };
        },
        async sendChosen(userId) {
            const seq = ++this.seq;
            Object.assign(this.send, { userId, key: null, words: '', checked: false, match: false, error: '' });
            if (!userId) return;
            try {
                await session.names([userId]);
                const key = await session.publicKeyOf(userId);
                const words = key.hasKey ? await session.fingerprintOf(key.public) : '';
                // an answer for a person chosen before is dropped
                if (seq !== this.seq || this.send.userId !== userId || key.userId !== userId) return;
                if (!key.hasKey) { this.send.error = t('They have no vault key yet. Ask them to set one up in Settings › Vault key.'); return; }
                Object.assign(this.send, { key, words, checked: session.checked(userId, key.public) });
            } catch (err) { if (seq === this.seq) this.send.error = messageOf(err); }
        },
        async submitSend() {
            const s = this.send;
            s.busy = true;
            s.error = '';
            try {
                if (!s.checked) await session.storeCheck(s.key, s.words);
                await session.sendItem(this.current.vaultId, this.currentItem.id, s.key);
                s.open = false;
                this.notify(fill(t('Sent to {name}'), { name: this.nameOf(s.userId) }));
            } catch (err) { s.error = messageOf(err); }
            s.busy = false;
        },
        // ----- import and export -----
        openImport() {
            this.importer = { open: true, vaultId: this.current && this.current.open && this.writable(this.current) ? this.current.vaultId : (this.writableOpen[0] || {}).vaultId || null,
                fileName: '', parsed: null, password: '', busy: false, progress: 0, total: 0, result: '', error: '' };
        },
        importFile(event) {
            const file = event.target.files && event.target.files[0];
            Object.assign(this.importer, { parsed: null, result: '', error: '', fileName: file ? file.name : '' });
            if (!file) return;
            if (file.size > IMPORT_MAX_BYTES) { this.importer.error = t('The file is larger than 10 MB: export a smaller part'); return; }
            const reader = new FileReader();
            reader.onload = () => {
                // the parsed items hold values: kept out of Vue's reactivity, and dropped on Close and Lock
                try { this.importer.parsed = Vue.markRaw(parseImport(reader.result)); } catch (err) { this.importer.error = messageOf(err); }
            };
            reader.onerror = () => { this.importer.error = t('The file could not be read'); };
            reader.readAsText(file);
        },
        async submitImport() {
            const im = this.importer;
            im.busy = true;
            im.error = '';
            im.result = '';
            try {
                const items = im.parsed.format === 'export' ? await session.readExport(im.parsed.export, im.password) : im.parsed.items;
                im.total = items.length;
                im.progress = 0;
                const out = await session.importItems(im.vaultId, items, (n) => { im.progress = n; });
                im.result = fill(t('{done} imported'), { done: out.done }) + (out.failed ? ', ' + fill(t('{failed} not imported'), { failed: out.failed }) : '');
                im.parsed = null;
                im.password = '';
            } catch (err) {
                im.error = /does not open/.test(messageOf(err)) ? t('That password does not open the export') : messageOf(err);
            }
            im.password = '';
            im.busy = false;
        },
        closeImport() {
            this.importer = { open: false, vaultId: null, fileName: '', parsed: null, password: '', busy: false, progress: 0, total: 0, result: '', error: '' };
        },
        openExport() {
            this.exporter = { open: true, vaultId: this.current && this.current.open ? this.current.vaultId : (this.openVaults[0] || {}).vaultId || null, password: '', password2: '', busy: false, error: '' };
        },
        async submitExport() {
            const ex = this.exporter;
            ex.busy = true;
            ex.error = '';
            try {
                const text = await session.exportVault(ex.vaultId, ex.password);
                const name = (session.vault(ex.vaultId).name || 'vault').replace(/[^\w.-]+/g, '-');
                moqui.saveBlob(name + '-' + new Date().toLocaleDateString('en-CA') + '.moquivault.json', new Blob([text], { type: 'application/json' }));
                this.exporter = { open: false, vaultId: null, password: '', password2: '', busy: false, error: '' };
                this.notify(t('Exported'));
            } catch (err) { ex.error = messageOf(err); ex.busy = false; }
        },
        // ----- the vault key -----
        openSetup(mode) {
            this.setup = { open: true, mode, step: 'passphrase', passphrase: '', passphrase2: '', code: '', group: 0, typed: '', fingerprint: '', busy: false, error: '' };
        },
        async setupMake() {
            const s = this.setup;
            s.busy = true;
            s.error = '';
            try {
                await session.strongReady();
                const made = await session.makeKey(s.passphrase);
                const groups = made.recoveryCode.split('-');
                Object.assign(s, { step: 'code', code: made.recoveryCode, fingerprint: made.fingerprint, passphrase: '', passphrase2: '',
                    group: 1 + Math.floor(Math.random() * Math.max(1, groups.length - 1)) % groups.length });
            } catch (err) { s.error = messageOf(err); }
            s.busy = false;
        },
        async setupSave() {
            const s = this.setup;
            const groups = s.code.split('-');
            if (String(s.typed || '').trim().toUpperCase() !== String(groups[s.group] || '').toUpperCase()) { s.error = t('That is not that group of the code. Check your copy.'); return; }
            s.busy = true;
            s.error = '';
            try {
                await session.saveKey();
                Object.assign(s, { step: 'done', code: '', typed: '' });
                this.loadKeyWords();
            } catch (err) { s.error = messageOf(err); }
            s.busy = false;
        },
        cancelSetup() {
            session.discardKey();
            this.setup = { open: false, mode: 'new', step: 'passphrase', passphrase: '', passphrase2: '', code: '', group: 0, typed: '', fingerprint: '', busy: false, error: '' };
        },
        // ----- organization recovery (Admin › Security › Recovery keys) -----
        openMakeKey() {
            if (!this.S.unlocked) { this.openUnlock(() => this.openMakeKey()); return; }
            const me = this.S.personal;
            this.makeKey = { open: true, pick: null, holders: [{ userId: me.userId, personalKeyId: me.personalKeyId, public: me.public, words: this.myWords, checked: true }],
                k: 2, userGroupId: null, busy: false, error: '' };
            if (!this.myWords) session.fingerprintOf(me.public).then((words) => { this.myWords = words; this.makeKey.holders[0].words = words; }, () => {});
        },
        async holderChosen(userId) {
            this.makeKey.pick = null;
            if (!userId || this.makeKey.holders.some((h) => h.userId === userId)) return;
            try {
                await session.names([userId]);
                const key = await session.publicKeyOf(userId);
                if (!key.hasKey || key.userId !== userId) { this.makeKey.error = t('They have no vault key yet. Ask them to set one up in Settings › Vault key.'); return; }
                this.makeKey.error = '';
                this.makeKey.holders.push({ userId, personalKeyId: key.personalKeyId, public: key.public, words: await session.fingerprintOf(key.public),
                    checked: session.checked(userId, key.public) });
            } catch (err) { this.makeKey.error = messageOf(err); }
        },
        refreshHolders() { for (const h of this.makeKey.holders) h.checked = h.userId === this.S.personal.userId || session.checked(h.userId, h.public); },
        async submitMakeKey() {
            const mk = this.makeKey;
            mk.busy = true;
            mk.error = '';
            try {
                await session.makeRecoveryKey(Number(mk.k), mk.holders, mk.userGroupId || null);
                this.makeKey = { open: false, pick: null, holders: [], k: 2, userGroupId: null, busy: false, error: '' };
                this.notify(t('The recovery key is made and split among its holders'));
            } catch (err) { mk.error = messageOf(err); }
            mk.busy = false;
        },
        openStartRecovery(keyRow) {
            if (!this.S.unlocked) { this.openUnlock(() => this.openStartRecovery(keyRow)); return; }
            this.startRec = { open: true, keyRow, vaultId: '', userId: null, key: null, words: '', checked: false, match: false, busy: false, error: '' };
        },
        async subjectChosen(userId) {
            const seq = ++this.seq;
            Object.assign(this.startRec, { userId, key: null, words: '', checked: false, match: false, error: '' });
            if (!userId) return;
            try {
                await session.names([userId]);
                const key = await session.publicKeyOf(userId);
                const words = key.hasKey ? await session.fingerprintOf(key.public) : '';
                if (seq !== this.seq || this.startRec.userId !== userId || key.userId !== userId) return;
                if (!key.hasKey) { this.startRec.error = t('They have no vault key yet: they make a new one in Settings › Vault key first.'); return; }
                Object.assign(this.startRec, { key, words, checked: session.checked(userId, key.public) });
            } catch (err) { if (seq === this.seq) this.startRec.error = messageOf(err); }
        },
        async submitStartRecovery() {
            const r = this.startRec;
            r.busy = true;
            r.error = '';
            try {
                if (!r.checked) await session.storeCheck(r.key, r.words);
                await session.startRecovery(r.keyRow, String(r.vaultId).trim(), r.key);
                r.open = false;
                this.notify(t('The recovery is started: keep this tab open while the other holders seal their shares'));
            } catch (err) { r.error = messageOf(err); }
            r.busy = false;
        },
        /** This holder's share sealed to a recovery: the starter's key and the member's new key compared first. */
        async submitShare(row) {
            if (!this.S.unlocked) { this.openUnlock(() => this.submitShare(row)); return; }
            for (const [userId, publicHex] of [[row.session.holder_user_id, row.holderPublic], [row.session.subject_user_id, row.session.subject_public]]) {
                if (!session.checked(userId, publicHex)) { this.openCheck(userId, () => this.submitShare(row)); return; }
            }
            this.recovery = { busy: row.recoverySessionId, error: '', check: [] };
            try { await session.deliverShare(row); this.notify(t('Your share is sealed to the recovery')); } catch (err) { this.recovery.error = messageOf(err); }
            this.recovery.busy = '';
        },
        async submitFinish(row) {
            if (!this.S.unlocked) { this.openUnlock(() => this.submitFinish(row)); return; }
            this.recovery = { busy: row.recoverySessionId, error: '', check: [] };
            try {
                await session.finishRecovery(row);
                this.notify(t('The member\'s new key has the vault: every member is told. Replace the recovery key now.'));
            } catch (err) {
                const message = messageOf(err);
                this.recovery.error = /was not started here/.test(message) ? t('This recovery was started in another tab, or before this tab locked: cancel it and start it again') : message;
                if (/has been checked|has not been checked/.test(message)) {
                    const open = await session.api('GET', '/recoveries/' + encodeURIComponent(row.recoverySessionId)).catch(() => null);
                    const ids = Array.from(new Set(((open && open.entries) || []).map((entry) => entry.signer_user_id).filter((id) => id && !isRecoveryMember(id) && id !== this.S.personal.userId)));
                    await session.names(ids);
                    this.recovery.check = ids;
                }
            }
            this.recovery.busy = '';
        },
        submitCancelRecovery(row) {
            this.$q.dialog({ title: t('Cancel the recovery'), message: fill(t('Cancel the recovery of {name}\'s access? The shares sealed to it are dropped.'), { name: this.nameOf(row.session.subject_user_id) }),
                ok: { label: t('Cancel the recovery'), color: 'negative', unelevated: true, noCaps: true }, cancel: { label: t('Keep it'), flat: true, noCaps: true } })
                .onOk(() => session.cancelRecovery(row).then(() => this.notify(t('Cancelled')), (err) => this.fail(err)));
        },
        openRecover() { this.recover = { open: true, code: '', passphrase: '', passphrase2: '', busy: false, error: '' }; },
        async submitRecover() {
            const r = this.recover;
            r.busy = true;
            r.error = '';
            try {
                await session.unlockWithCode(r.code, r.passphrase);
                this.recover = { open: false, code: '', passphrase: '', passphrase2: '', busy: false, error: '' };
                this.notify(t('Unlocked, with your new passphrase'));
            } catch (err) { r.error = /does not open/.test(messageOf(err)) ? t('That recovery code does not open your vault key') : messageOf(err); r.busy = false; }
        },
        openChange() { this.change = { open: true, current: '', passphrase: '', passphrase2: '', busy: false, error: '' }; },
        async submitChange() {
            const c = this.change;
            c.busy = true;
            c.error = '';
            try {
                if (!this.S.unlocked) await session.unlock(c.current);
                await session.changePassphrase(c.passphrase);
                this.change = { open: false, current: '', passphrase: '', passphrase2: '', busy: false, error: '' };
                this.notify(t('The passphrase is changed'));
            } catch (err) { c.error = /does not open/.test(messageOf(err)) ? t('That passphrase does not open your vault key') : messageOf(err); c.busy = false; }
        }
    },
    mounted() {
        document.addEventListener('keydown', this.onActivity, true);
        document.addEventListener('pointerdown', this.onActivity, true);
        this.start().then(() => {
            this.loadKeyWords();
            this.loadDetail();
            if (this.recoveryView) session.refreshRecoverySessions().catch((err) => { this.recovery.error = messageOf(err); });
        });
    },
    beforeUnmount() {
        document.removeEventListener('keydown', this.onActivity, true);
        document.removeEventListener('pointerdown', this.onActivity, true);
        this.dropPrepared();
    }
};

</script>

<style>
.boss-vault-words { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; letter-spacing: 0.02em; word-break: break-word; }
.boss-vault-pre { white-space: pre-wrap; word-break: break-word; }
.boss-vault-value { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; word-break: break-all; }
.boss-vault-masked { -webkit-text-security: disc; }
</style>
