                out.push(toEntry(strings.Title, strings.UserName, strings.Password, strings.URL, allNotes, strings.otp || '', here.length > 1 ? [here.slice(1).join(' / ')] : [], hidden));
            }
        }
    };
    const root = doc.getElementsByTagName('Root')[0];
    for (const group of Array.from(root ? root.children : []).filter((c) => c.tagName === 'Group')) walk(group, []);
