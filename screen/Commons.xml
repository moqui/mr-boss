<!-- IronStone Commons, the shared things people work on: root of the app (design-drawers-commons.md §2.1). Authorized
    for BOSS_USERS (every internal user, not ALL_USERS) and ADMIN by BOSS_COMMONS in data/BossSetupData.xml. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Commons" menu-image="sym_o_hub" menu-image-type="icon">

    <!-- The record-link resolver of the notification links (impl-people P10, the user's call of Nov 11, 2026: the timesheet topics):
        a record (recordEntityName or docType, and id) opens where ironstone.commons.PaletteServices.get#RecordLink sends this user,
        People's or Projects' screen for whichever they may open, as the tray does; with no screen for them, the Notifications
        center. A notification's link is its /apps path (a browser's GET there runs the transition and redirects to the /qapps
        screen); the tray resolves the same link itself (CommonsServices.decorate#Notifications). Every BOSS user opens Commons;
        the screen it goes to checks the user again. -->
    <transition name="openRecord" method="get" read-only="true">
        <parameter name="docType"/>
        <parameter name="recordEntityName"/>
        <parameter name="id"/>
        <actions>
            <set field="recordUrl" from="null"/>
            <if condition="id">
                <service-call name="ironstone.commons.PaletteServices.get#RecordLink" out-map="recordLink" ignore-error="true"
                        in-map="{docType:(docType || null), recordEntityName:(recordEntityName || null), id:id}"/>
                <script>ec.message.clearErrors(); recordUrl = recordLink?.url || null</script>
            </if>
        </actions>
        <default-response url="${recordUrl || '/qapps/Commons/Notifications'}" url-type="plain"/>
    </transition>

    <always-actions>
        <set field="appRoot" value="Commons"/>

        <!-- the search settings Search uses -->
        <set field="searchIndexName" value="mantle"/>
        <set field="searchLinkSets" value="boss"/>
        <set field="searchProductDocType" value="MantleProduct"/>
        <set field="searchPartyDocType" value="MantleParty"/>

        <service-call name="mantle.party.PartyServices.setup#UserOrganizationInfo" out-map="context"/>
    </always-actions>

    <subscreens default-item="Home" always-use-full-path="true">
        <!-- the record panels the chatter and record-files elements load under this app root, hidden from the menu
            (the theme values STRT_CHATTER_SCREEN and STRT_RECORD_FILES_SCREEN; impl-drawers-commons.md R5) -->
        <subscreens-item name="Chatter" location="component://mr-boss/screen/Shared/Chatter.xml" menu-include="false"/>
        <subscreens-item name="RecordFiles" location="component://mr-boss/screen/Shared/RecordFiles.xml" menu-include="false"/>
    </subscreens>

    <!-- What Commons offers the suite shell (design-drawers-commons.md §1.2, §1.5, §1.7; impl R3): the + menu kinds (each
        opens the theme's STRT_QUICK_CREATE screen, Commons/QuickCreate, with its kind and the record of the screen context), the
        document types and groups of
        the palette (service/ironstone/commons/PaletteServices.xml), the go-to keys, the account menu's Preferences and Account,
        and the notification topics whose messages the Notifications tab lists. Screen paths are under the apps root. -->
    <shell-providers>
        <quick-create kind="task" label="Task" icon="sym_o_task_alt" sequence="10"/>
        <!-- an activity (a call, email, to-do or meeting) is always on a record: offered while the screen context has one -->
        <quick-create kind="activity" label="Activity" icon="sym_o_pending_actions" requires-record="true" sequence="15"/>
        <quick-create kind="event" label="Event" icon="sym_o_event" sequence="20"/>
        <quick-create kind="note" label="Note" icon="sym_o_sticky_note_2" sequence="30"/>
        <quick-create kind="contact" label="Contact" icon="sym_o_person" sequence="40"/>
        <quick-create kind="request" label="Request" icon="sym_o_support" sequence="50"/>

        <palette-type doc-type="MantleParty"/>
        <palette-type doc-type="MantleTask"/>
        <palette-type doc-type="MantleEvent"/>
        <palette-type doc-type="MantleRequest"/>
        <palette-type doc-type="MantleProject"/>
        <palette-type doc-type="MantleWikiPage"/>
        <palette-type doc-type="MantleCommunicationEvent"/>
        <!-- an id (with a digit and no spaces, or an upper case id such as BOSS_DEMO_REQUEST) goes to its record first -->
        <palette-source group="IdLookup" label="Go to id" icon="sym_o_tag" service="ironstone.commons.PaletteServices.lookup#Id"
                id-pattern="\S*\d\S*|[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+" sequence="5"/>
        <palette-source group="Records" label="Records" icon="sym_o_search" service="ironstone.commons.PaletteServices.search#Records" sequence="10"/>
        <palette-source group="People" label="People" icon="sym_o_person" prefix="@" service="ironstone.commons.PaletteServices.search#People" sequence="20"/>
        <palette-source group="Pages" label="Pages and files" icon="sym_o_description" service="ironstone.commons.PaletteServices.search#Pages" sequence="40"/>
        <palette-source group="Files" label="Files" icon="sym_o_folder" service="ironstone.commons.DriveServices.search#PaletteFiles" sequence="45"/>
        <palette-source group="Events" label="Events" icon="sym_o_event" service="ironstone.commons.PaletteServices.search#Events" sequence="50"/>

        <!-- Today: the requests assigned to the user with a response due, beside the tasks, activities and events -->
        <today-source service="mantle.request.RequestServices.get#UserTodayRequests" label="Requests"/>
        <!-- People's Today source (owner contract, impl-people P8, F64): declared here too, since a self-service employee opens no
            People root and the shell gathers sources from the roots a user may open; Home and the panel take it once -->
        <today-source service="ironstone.people.ContextServices.get#TodayItems" label="People"/>

        <notification-topic topic="ChatterMention"/>
        <notification-topic topic="RecordFollow"/>
        <notification-topic topic="WorkEffortReminder"/>
        <notification-topic topic="EventInvitation"/>
        <notification-topic topic="EventInvitationResponse"/>
        <notification-topic topic="WikiPageReview"/>
        <notification-topic topic="WikiPageReviewDecision"/>
        <notification-topic topic="FileShare"/>

        <keymap>
            <key keys="g h" label="Commons home" screen="Commons/Home"/>
            <key keys="g c" label="Contacts" screen="Commons/Contacts"/>
            <key keys="g k" label="Tasks" screen="Commons/Tasks"/>
            <key keys="g l" label="Calendar" screen="Commons/Calendar"/>
            <key keys="g f" label="Files" screen="Commons/Files"/>
            <key keys="g n" label="Notes" screen="Commons/Notes"/>
        </keymap>

        <account-menu-item label="Preferences" icon="sym_o_tune" screen="Commons/Settings/Preferences" sequence="10"/>
        <account-menu-item label="Account" icon="sym_o_manage_accounts" screen="Commons/Settings/Account" sequence="20"/>
    </shell-providers>

    <widgets><subscreens-panel id="commons-panel" type="popup"/></widgets>
</screen>
