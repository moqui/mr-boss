<!-- The Mail and protocols area of IronStone Admin (design-admin §1.2, §9; impl-admin P11): MailRelays, the outgoing mail
    servers no mail account owns (the default until ProtocolsHome is built, P12), and MailRelayDetail, one relay's
    configuration, test and uses (contextual). The protocols' readiness, the server configuration and the mail queue join it
    later (P12). For the integration administrator and the administrator (BOSS_ADM_PROTOCOLS): the framework's services
    check ADMIN_CONNECTION_VIEW and ADMIN_CONNECTION_MANAGE whatever opens the screens. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Mail and protocols" default-menu-index="7" menu-image="sym_o_mail" menu-image-type="icon">
    <subscreens default-item="MailRelays" always-use-full-path="true">
        <subscreens-item name="MailRelays" location="component://mr-boss/screen/Admin/Protocols/MailRelays.xml" menu-title="Mail relays"
                menu-index="2"/>
        <subscreens-item name="MailRelayDetail" location="component://mr-boss/screen/Admin/Protocols/MailRelayDetail.xml"
                menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="AdminProtocolsPanel" type="tab"/>
    </widgets>
</screen>
