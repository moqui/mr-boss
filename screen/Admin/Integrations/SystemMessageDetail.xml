<!-- SystemMessageDetail (design-admin §8 SystemMessageDetail, §8.1, §15.3; mr-moqui plans/archive/Admin-Screens-Down.md): the
    framework's System › Integrations system message screen at this location (BOSS_ADM_INTEGRATIONS_OPS), with the one
    transition an operator uses: recoverMessage, through org.moqui.admin.OperationServices.execute#Recovery, which checks
    ADMIN_OPERATION_MANAGE and what the message's owner registered. The System screen's own part for the instance
    administrator (the stored record, its text edited, a send, a consume, a reset, a cancel past any registration) is not
    shown under a mount, its transitions are not taken in and its EditMessageText subscreen is not here, so they do not
    exist on this route. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="System message" default-menu-include="false">
    <parameter name="systemMessageId" required="true"/>
    <parameter name="showContent"/>

    <transition-include name="recoverMessage" location="component://tools/screen/System/Integrations/SystemMessageDetail.xml"/>

    <widgets>
        <include-screen location="component://tools/screen/System/Integrations/SystemMessageDetail.xml" share-scope="true"/>
    </widgets>
</screen>
