<!-- MessageTypes (design-admin §8 MessageTypes, §14; mr-moqui plans/Admin-Screens-Down.md): the framework's System ›
    Integrations message types at this location, for the integration administrator. Reading needs ADMIN_CONNECTION_VIEW,
    checked by the service. The System screen's own part for the instance administrator (a type created directly) is not
    shown under a mount and its transition is not taken in, so it does not exist on this route: no type is started here. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Message types" menu-image="sym_o_schema" menu-image-type="icon">
    <parameter name="term"/>
    <parameter name="direction"/>
    <parameter name="pageIndex"/>

    <widgets>
        <include-screen location="component://tools/screen/System/Integrations/MessageTypes.xml" share-scope="true"/>
    </widgets>
</screen>
