<!-- Connections (design-admin §8.1, §8 Connections; style-guide §3.2 List; impl-admin P11; mr-moqui
    plans/archive/Admin-Screens-Down.md): the framework's System › Integrations connections list, as Admin's own screen for what
    Admin adds: the organizations a payment gateway is permitted for, as a filter (the organizations the administrator
    administers, ironstone.admin.ContextServices.get#Choices) and a column. The connections are read here from
    org.moqui.admin.ConfigurationServices.find#Connections with the organization; the display values, the heading with
    NewConnection, the find form and the list are the System screen's (ConnectionsPrepare, ConnectionsHeader, and
    ConnectionFind and ConnectionList extended here), and createConnection is taken in from it. Mail relays are Mail and
    protocols' (MailRelays). Reading needs ADMIN_CONNECTION_VIEW and starting one ADMIN_CONNECTION_MANAGE, checked by the
    services. No secret is shown or listed. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Connections" menu-image="sym_o_hub" menu-image-type="icon">
    <parameter name="text"/>
    <parameter name="adapterKey"/>
    <parameter name="state"/>
    <parameter name="organizationPartyId"/>
    <parameter name="pageIndex"/>

    <transition name="choices" read-only="true">
        <actions>
            <service-call name="ironstone.admin.ContextServices.get#Choices" in-map="context" out-map="found"/>
            <script>ec.web.sendJsonResponse(found.options)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition-include name="createConnection" location="component://tools/screen/System/Integrations/Connections.xml"/>

    <actions>
        <service-call name="org.moqui.admin.ConfigurationServices.find#Connections" out-map="found" transaction="force-new" ignore-error="true"
                in-map="{adapterGroup:'integration', text:(text || null), adapterKey:(adapterKey || null), state:(state || null),
                    organizationPartyId:(organizationPartyId || null), pageIndex:(pageIndex || 0), pageSize:50}"/>
        <set field="filtered" from="!!(text || adapterKey || state || organizationPartyId)"/>
        <set field="findValues" from="{text:text, adapterKey:adapterKey, state:state, organizationPartyId:organizationPartyId}"/>
    </actions>
    <widgets>
        <section-include name="ConnectionsPrepare" location="component://tools/screen/System/Integrations/Connections.xml"/>
        <section-include name="ConnectionsHeader" location="component://tools/screen/System/Integrations/Connections.xml"/>
        <section name="ConnectionSection" condition="available">
            <widgets>
                <form-single name="ConnectionFind" extends="component://tools/screen/System/Integrations/Connections.xml#ConnectionFind"
                        transition="." map="findValues">
                    <field name="organizationPartyId">
                        <default-field title="Permitted for" tooltip="Payment gateways an organization may use">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'organizations'}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field-layout>
                        <field-row-big><field-ref name="text"/><field-ref name="adapterKey"/><field-ref name="organizationPartyId"/><field-ref name="state"/><field-ref name="submitButton"/></field-row-big>
                    </field-layout>
                </form-single>
                <label type="p" style="m-muted" condition="!connections.length &amp;&amp; !filtered" text="No connection yet. Start one with New connection."/>
                <label type="p" style="m-muted" condition="!connections.length &amp;&amp; filtered" text="No connection matches."/>
                <form-list name="ConnectionList" extends="component://tools/screen/System/Integrations/Connections.xml#ConnectionList"
                        list="connections" skip-form="true" paginate="true">
                    <field name="organizationText"><default-field title="Organizations"><display/></default-field></field>
                    <columns>
                        <column><field-ref name="name"/></column>
                        <column><field-ref name="kindText"/></column>
                        <column><field-ref name="endpointSummary"/></column>
                        <column><field-ref name="organizationText"/></column>
                        <column><field-ref name="checkText"/></column>
                        <column><field-ref name="stateText"/></column>
                    </columns>
                </form-list>
            </widgets>
        </section>
    </widgets>
</screen>
