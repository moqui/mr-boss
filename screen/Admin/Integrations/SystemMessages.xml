<!-- SystemMessages (design-admin §8 SystemMessages, §8.1, §15.3; mr-moqui plans/archive/Admin-Screens-Down.md): the framework's
    System › Integrations system messages at this location, which BOSS_ADM_INTEGRATIONS_OPS opens to the operations operator
    beside the integration administrator, with the one transition an operator uses: recoverMessages, through
    org.moqui.admin.OperationServices.execute#Recovery, which checks ADMIN_OPERATION_MANAGE and what each message's owner
    registered. A message's owner is linked by the mount's routes (Admin.js mountRoutes: Commerce's store integration). The
    System screen's own part for the instance administrator (send all, consume all, a message typed in) is not shown under
    a mount and its transitions are not taken in, so they do not exist on this route. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="System messages" menu-image="sym_o_swap_horiz" menu-image-type="icon">
    <parameter name="state"/>
    <parameter name="systemMessageTypeId"/>
    <parameter name="systemMessageRemoteId"/>
    <parameter name="direction"/>
    <parameter name="reference"/>
    <parameter name="fromDate"/>
    <parameter name="thruDate"/>
    <parameter name="pageIndex"/>
    <parameter name="bulkIds"/>
    <parameter name="bulkAction"/>
    <parameter name="bulkReason"/>

    <transition-include name="recoverMessages" location="component://tools/screen/System/Integrations/SystemMessages.xml"/>

    <widgets>
        <include-screen location="component://tools/screen/System/Integrations/SystemMessages.xml" share-scope="true"/>
    </widgets>
</screen>
