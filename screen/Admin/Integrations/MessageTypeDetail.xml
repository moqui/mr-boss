<!-- MessageTypeDetail (design-admin §8 MessageTypeDetail, §14; mr-moqui plans/Admin-Screens-Down.md): the framework's
    System › Integrations message type screen at this location, with the one transition an integration administrator
    uses: saveType, through org.moqui.admin.ConfigurationServices.store#MessageType, which checks ADMIN_CONNECTION_MANAGE
    and what the type's owner registered. The System screen's own part for the instance administrator (any field of the
    type, its service names typed) is not shown under a mount and its transition is not taken in, so it does not exist on
    this route. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Message type" default-menu-include="false">
    <parameter name="systemMessageTypeId" required="true"/>

    <transition-include name="saveType" location="component://tools/screen/System/Integrations/MessageTypeDetail.xml"/>

    <widgets>
        <include-screen location="component://tools/screen/System/Integrations/MessageTypeDetail.xml" share-scope="true"/>
    </widgets>
</screen>
