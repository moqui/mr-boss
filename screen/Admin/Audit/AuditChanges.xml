<!-- AuditChanges (design-admin §12 AuditChanges, §16 "Audit evidence"; style-guide §3.2 List; impl-admin P17): the changes
    the audit log recorded of the registered administrative records, newest first, through
    ironstone.admin.AuditServices.find#ChangeEvidence over the framework's org.moqui.admin.AuditServices.find#Changes.
    AuditFind: the area, what changed (a registered projection, never an entity or a field), whether a data load's own
    changes are listed beside people's, and a range of dates; a row's own links narrow to its actor, its record or its
    session. AuditList: when, who, what changed, the record, the values
    before and after where the registration shows them (a credential and anything not registered to be shown reads "not
    shown"), the reason given and the session. A user's, a membership's and an organization's changes are those of the
    organizations the user administers; the rest belong to the whole instance. The print (this screen in html-print) and
    the CSV (the list's export) are the same projection, one bounded page of it. Reading needs ADMIN_AUDIT_VIEW, checked by
    the services; the instance administrator's unfiltered audit log stays System › Audit log. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Changes" menu-image="sym_o_history_edu" menu-image-type="icon">
    <parameter name="category"/>
    <parameter name="auditProjectionId"/>
    <parameter name="changedByUserId"/>
    <parameter name="recordKey"/>
    <parameter name="correlation"/>
    <parameter name="fromDate"/>
    <parameter name="thruDate"/>
    <parameter name="madeBy"/>
    <parameter name="pageIndex"/>
    <parameter name="pageNoLimit"/>

    <actions>
        <set field="renderMode" from="sri.getRenderMode()"/>
        <set field="printing" from="renderMode === 'html-print'"/>
        <!-- the print and the file are one bounded page of the same projection -->
        <set field="exporting" from="printing || pageNoLimit === 'true' || ['csv', 'xlsx', 'text'].includes(renderMode)"/>
        <set field="findValues" from="{category:category, auditProjectionId:auditProjectionId, changedByUserId:changedByUserId,
            recordKey:recordKey, correlation:correlation, fromDate:fromDate, thruDate:thruDate, madeBy:(madeBy || 'people')}"/>
        <service-call name="ironstone.admin.AuditServices.find#ChangeEvidence" out-map="found" transaction="force-new" ignore-error="true"
                in-map="Object.assign({}, findValues, {pageIndex:(pageIndex || 0), forExport:exporting})"/>
        <!-- ignore-error clears a refusal's message: a list answered is the sign it was read -->
        <set field="available" from="!!found?.changeList"/>
        <script><![CDATA[
            ec.message.clearErrors()
            changeList = Array.from(found?.changeList || []).map(row => Object.assign({}, row, {
                whatText: row.description,
                sessionText: row.correlation || ''}))
            // the list's paging is the service's (changeListCount and its page fields)
            changeListCount = Number(found?.changeListCount || 0)
            changeListPageIndex = Number(found?.changeListPageIndex || 0)
            changeListPageSize = Number(found?.changeListPageSize || 50)
            changeListPageMaxIndex = Number(found?.changeListPageMaxIndex || 0)
            changeListPageRangeLow = Number(found?.changeListPageRangeLow || 0)
            changeListPageRangeHigh = Number(found?.changeListPageRangeHigh || 0)
            categoryOptions = Array.from(found?.categoryOptions || [])
            projectionOptions = Array.from(found?.projectionOptions || [])
            narrowed = [changedByUserId && 'one user', recordKey && 'one record', correlation && 'one session'].filter(Boolean).join(', ')
            clearValues = {category: category, auditProjectionId: auditProjectionId, fromDate: fromDate, thruDate: thruDate, madeBy: madeBy}
            madeByOptions = [{value: 'people', label: 'People'}, {value: 'all', label: 'Anyone, data loads too'}]
            problemText = Array.from(found?.sourceProblems || []).join(', ')
        ]]></script>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Changes" type="h5"/>
                <label type="p" style="text-caption m-muted q-mb-none" condition="available"
                        text="Who changed what, when and why, for the records registered as administrative evidence. ${found?.scopeText}. A credential, and any value not registered to be shown, reads as not shown. Prepared ${ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd HH:mm')} by ${ec.user.username}."/>
            </container>
            <container style="col-auto">
                <link url="." text="Print" icon="sym_o_print" target-window="_blank" condition="available &amp;&amp; !printing"
                        parameter-map="Object.assign({}, findValues, {renderMode:'html-print'})"/>
            </container>
        </container>
        <label type="p" style="text-negative" condition="!available" text="Changes are not available to you: reading them needs ADMIN_AUDIT_VIEW."/>
        <section name="ChangesSection" condition="available">
            <widgets>
                <section name="AuditFindSection" condition="!printing">
                    <widgets>
                        <form-single name="AuditFind" transition="." map="findValues">
                            <field name="changedByUserId"><default-field><hidden/></default-field></field>
                            <field name="recordKey"><default-field><hidden/></default-field></field>
                            <field name="correlation"><default-field><hidden/></default-field></field>
                            <field name="category">
                                <default-field title="Area"><drop-down allow-empty="true"><list-options list="categoryOptions" key="${value}" text="${label}"/></drop-down></default-field>
                            </field>
                            <field name="auditProjectionId">
                                <default-field title="What changed"><drop-down allow-empty="true"><list-options list="projectionOptions" key="${value}" text="${label}"/></drop-down></default-field>
                            </field>
                            <field name="madeBy">
                                <default-field title="Changed by" tooltip="A data load's own changes name no user"><drop-down><list-options list="madeByOptions" key="${value}" text="${label}"/></drop-down></default-field>
                            </field>
                            <field name="fromDate"><default-field title="From"><date-time type="date"/></default-field></field>
                            <field name="thruDate"><default-field title="Before"><date-time type="date"/></default-field></field>
                            <field name="submitButton"><default-field title="Find"><submit/></default-field></field>
                            <field-layout>
                                <field-row-big><field-ref name="category"/><field-ref name="auditProjectionId"/><field-ref name="madeBy"/><field-ref name="fromDate"/><field-ref name="thruDate"/><field-ref name="submitButton"/></field-row-big>
                            </field-layout>
                        </form-single>
                    </widgets>
                </section>
                <container style="row items-center q-gutter-sm" condition="!!narrowed">
                    <label type="span" text="Narrowed to ${narrowed}."/>
                    <link url="." text="Show all" link-type="anchor" condition="!printing" parameter-map="clearValues"/>
                </container>
                <label type="p" style="text-warning" condition="!!found.notice" text="${found.notice}"/>
                <label type="p" style="text-warning" condition="!!problemText" text="Not answered just now, so not listed: ${problemText}."/>
                <label type="p" style="text-warning" condition="found.truncated" text="Only the newest ${found.exportRows} changes are in this print or file: narrow the dates for the rest."/>
                <label type="p" style="m-muted" condition="!changeList.length &amp;&amp; !found.notice" text="No change matches."/>
                <form-list name="AuditList" list="changeList" skip-form="true" paginate="true" show-csv-button="true">
                    <field name="changedDateText"><default-field title="When"><display/></default-field></field>
                    <field name="actorName">
                        <conditional-field condition="!!changedByUserId &amp;&amp; !exporting" title="Who">
                            <link url="." text="${actorName}" link-type="anchor" tooltip="Only this user's changes"
                                    parameter-map="Object.assign({}, clearValues, {changedByUserId:changedByUserId})"/>
                        </conditional-field>
                        <default-field title="Who"><display/></default-field>
                    </field>
                    <field name="categoryLabel"><default-field title="Area"><display/></default-field></field>
                    <field name="whatText"><default-field title="What changed"><display/></default-field></field>
                    <field name="recordText">
                        <conditional-field condition="!!recordUrl &amp;&amp; !exporting" title="Record">
                            <link url="${recordUrl}" url-type="plain" text="${recordText}" link-type="anchor"/>
                        </conditional-field>
                        <default-field title="Record"><display/></default-field>
                    </field>
                    <field name="beforeText"><default-field title="Before"><display/></default-field></field>
                    <field name="afterText"><default-field title="After"><display/></default-field></field>
                    <field name="reason"><default-field title="Reason"><display/></default-field></field>
                    <field name="sessionText">
                        <conditional-field condition="!!correlation &amp;&amp; !exporting" title="Session">
                            <link url="." text="${sessionText}" link-type="anchor" tooltip="Everything changed in this session"
                                    parameter-map="Object.assign({}, clearValues, {correlation:correlation})"/>
                        </conditional-field>
                        <default-field title="Session"><display/></default-field>
                    </field>
                    <columns type="mobile">
                        <column><field-ref name="changedDateText"/><field-ref name="whatText"/><field-ref name="recordText"/></column>
                        <column><field-ref name="actorName"/><field-ref name="afterText"/><field-ref name="reason"/></column>
                    </columns>
                </form-list>
            </widgets>
        </section>
    </widgets>
</screen>
