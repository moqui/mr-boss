<!-- The Operations area of IronStone Admin (design-admin §1.2, §10): Health, the readiness checks (P2, the default), and
    Monitoring, the landing that opens the framework's Monitor and Dashboards under their own grants (P1); Jobs, JobRuns and Topics
    (P14) are added by their phase. For the administrative reader, the operations operator and the administrator
    (BOSS_ADM_OPERATIONS). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Operations" default-menu-index="8" menu-image="sym_o_monitor_heart" menu-image-type="icon">
    <subscreens default-item="Health" always-use-full-path="true">
        <subscreens-item name="Health" location="component://mr-boss/screen/Admin/Operations/Health.xml" menu-title="Health" menu-index="1"/>
        <subscreens-item name="Monitoring" location="component://mr-boss/screen/Admin/Operations/Monitoring.xml" menu-title="Monitoring" menu-index="3"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="AdminOperationsPanel" type="tab"/>
    </widgets>
</screen>
