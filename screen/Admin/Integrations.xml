<!-- The Integrations area of IronStone Admin (design-admin §1.2, §8; impl-admin P11, P13): Connections, the infrastructure
    connections of the registered kinds (the default), and ConnectionDetail, one connection's configuration, organizations,
    test and uses (contextual); MessageTypes, the message contracts, and MessageTypeDetail, one type's contract and use
    (contextual); SystemMessages, the transport outcomes of the instance's messages with their recovery, and
    SystemMessageDetail, one message's evidence (contextual). For the integration administrator and the administrator
    (BOSS_ADM_INTEGRATIONS, the whole area) and, for SystemMessages and SystemMessageDetail only, the operations operator
    (BOSS_ADM_INTEGRATIONS_OPS), who lands on SystemMessages. The grants open navigation: the framework's services check
    ADMIN_CONNECTION_VIEW and ADMIN_CONNECTION_MANAGE (connections, message types), ADMIN_OPERATION_VIEW and
    ADMIN_OPERATION_MANAGE (system messages and their recovery) whatever opens the screens, and Mantle's
    store#PaymentGatewayOrganization the organization too. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Integrations" default-menu-index="6" menu-image="sym_o_hub" menu-image-type="icon">
    <subscreens default-item="Connections" always-use-full-path="true">
        <!-- the operations operator opens no connection: the area starts at the messages -->
        <conditional-default condition="ec.user.userId &amp;&amp; !ec.user.hasPermission('ADMIN_CONNECTION_VIEW') &amp;&amp; ec.user.hasPermission('ADMIN_OPERATION_VIEW')"
                item="SystemMessages"/>
        <subscreens-item name="Connections" location="component://mr-boss/screen/Admin/Integrations/Connections.xml" menu-title="Connections"
                menu-index="1"/>
        <subscreens-item name="ConnectionDetail" location="component://mr-boss/screen/Admin/Integrations/ConnectionDetail.xml"
                menu-include="false"/>
        <subscreens-item name="MessageTypes" location="component://mr-boss/screen/Admin/Integrations/MessageTypes.xml" menu-title="Message types"
                menu-index="2"/>
        <subscreens-item name="MessageTypeDetail" location="component://mr-boss/screen/Admin/Integrations/MessageTypeDetail.xml"
                menu-include="false"/>
        <subscreens-item name="SystemMessages" location="component://mr-boss/screen/Admin/Integrations/SystemMessages.xml" menu-title="System messages"
                menu-index="3"/>
        <subscreens-item name="SystemMessageDetail" location="component://mr-boss/screen/Admin/Integrations/SystemMessageDetail.xml"
                menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="AdminIntegrationsPanel" type="tab"/>
    </widgets>
</screen>
