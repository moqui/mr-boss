<!-- Users (design-admin §4 Users; style-guide §3.2 List): the staff identities of the organizations the user administers, from
    Mantle's mantle.party.IdentityServices.find#Users (ADMIN_IDENTITY_VIEW). UserFind narrows by name, username or email, an
    organization of theirs, a group and the account's state; UserList shows each identity's organizations in scope (others
    counted, never named), state and last sign-in, and opens UserDetail. NewStaffAccount (create#StaffAccount,
    ADMIN_IDENTITY_MANAGE) is the exception to invitations (P5): a person, an organization of the user's, and the access it starts
    with as registered bundles the user may assign (BOSS_USERS first, impl-admin §4), the reset password mailed for the user to
    set their own. No password is chosen here. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Users" menu-image="sym_o_person" menu-image-type="icon">
    <parameter name="text"/>
    <parameter name="organizationPartyId"/>
    <parameter name="state"/>
    <parameter name="pageIndex"/>

    <transition name="choices" read-only="true">
        <actions>
            <service-call name="ironstone.admin.ContextServices.get#Choices" out-map="found"
                    in-map="{appRoot:appRoot, choice:choice, term:term, selected:selected}"/>
            <script>ec.web.sendJsonResponse(found.options)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition name="createStaffAccount">
        <actions>
            <set field="bundleIds" from="Array.from(typeof bundleGroupIdList === 'string' ? bundleGroupIdList.split(',') : (bundleGroupIdList || []))
                    .map(id => String(id).trim()).filter(Boolean)"/>
            <service-call name="mantle.party.IdentityServices.create#StaffAccount" out-map="created"
                    in-map="{firstName:firstName, lastName:lastName, username:(username || null), emailAddress:emailAddress,
                        organizationPartyId:organizationPartyId, relationshipTypeEnumId:(relationshipTypeEnumId || null),
                        bundleGroupIdList:(bundleIds.includes('BOSS_USERS') ? bundleIds : ['BOSS_USERS'].concat(bundleIds)),
                        reason:(reason || null)}"/>
            <if condition="!ec.message.hasError() &amp;&amp; !created.applied">
                <script>ec.message.addMessage(created.reason, 'warning')</script>
            </if>
            <if condition="!ec.message.hasError() &amp;&amp; created.applied">
                <message type="success">Account created; a reset password was mailed for the user to set their own</message>
            </if>
        </actions>
        <conditional-response url="../UserDetail" condition="created?.applied">
            <parameter name="userId" from="created.userId"/></conditional-response>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <service-call name="mantle.party.IdentityServices.find#Users" out-map="found" transaction="force-new" ignore-error="true"
                in-map="{text:(text || null), organizationPartyId:(organizationPartyId || null), state:(state || null),
                    pageIndex:(pageIndex || 0), pageSize:50}"/>
        <set field="failure" from="ec.message.hasError() ? ec.message.getErrorsString() : null"/>
        <script>ec.message.clearErrors()</script>
        <set field="users" from="(found?.userList || []).map(row => Object.assign({}, row, {
                lastLoginText: row.lastLoginDate ? ec.l10n.format(Number(row.lastLoginDate), 'yyyy-MM-dd HH:mm') : 'Never',
                organizationsText: row.organizations + (row.otherOrganizationCount ? ' (+' + row.otherOrganizationCount + ' other)' : '')}))"/>
        <set field="userListCount" from="found?.userListCount || 0"/>
        <set field="canCreate" from="!!admin?.capabilities?.identityManage"/>
        <set field="filtered" from="!!(text || organizationPartyId || state)"/>
        <set field="findValues" from="{text:text, organizationPartyId:organizationPartyId, state:state}"/>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Users" type="h5"/>
                <label text="The staff of the organizations you administer. An identity that also works elsewhere shows only your organizations; account-wide changes to it need identity-global authority."
                        type="p" style="text-caption m-muted q-mb-none"/>
            </container>
            <container style="col-auto">
                <container-dialog id="NewStaffAccountDialog" button-text="New staff account" icon="sym_o_person_add" width="600"
                        title="New staff account" condition="canCreate">
                    <label type="p" text="Invitations are the usual way to add staff. A direct account gets no password: a reset password is mailed so the person sets their own. IronStone BOSS users is always included."/>
                    <form-single name="NewStaffAccount" transition="createStaffAccount" focus-field="firstName">
                        <field name="firstName"><default-field title="First name"><text-line size="25"/></default-field></field>
                        <field name="lastName"><default-field title="Last name"><text-line size="25"/></default-field></field>
                        <field name="emailAddress"><default-field title="Email"><text-line size="40"/></default-field></field>
                        <field name="username"><default-field title="Username" tooltip="Empty uses the email address"><text-line size="30"/></default-field></field>
                        <field name="organizationPartyId">
                            <default-field title="Organization">
                                <drop-down>
                                    <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'organizations'}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="relationshipTypeEnumId">
                            <default-field title="Works as">
                                <drop-down><option key="PrtEmployee" text="Employee"/><option key="PrtAgent" text="Agent"/>
                                    <option key="PrtMember" text="Member"/></drop-down>
                            </default-field>
                        </field>
                        <field name="bundleGroupIdList">
                            <default-field title="Access" tooltip="Registered bundles you may assign">
                                <drop-down allow-multiple="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'bundles'}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="reason"><default-field title="Reason"><text-line size="50"/></default-field></field>
                        <field name="submitButton"><default-field title="Create account"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </container>
        </container>
        <form-single name="UserFind" transition="." map="findValues">
            <field name="text"><default-field title="Name or email"><text-find size="20" hide-options="true"/></default-field></field>
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'organizations'}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="state">
                <default-field title="State">
                    <drop-down allow-empty="true">
                        <option key="active" text="Active"/><option key="ending" text="Access ends"/><option key="locked" text="Locked"/>
                        <option key="disabled" text="Disabled"/><option key="terminated" text="Ended"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="submitButton"><default-field title="Find"><submit/></default-field></field>
            <field-layout>
                <field-row-big>
                    <field-ref name="text"/>
                    <field-ref name="organizationPartyId"/>
                    <field-ref name="state"/>
                    <field-ref name="submitButton"/>
                </field-row-big>
            </field-layout>
        </form-single>
        <label type="p" style="text-negative" condition="failure" text="${failure}"/>
        <container-box>
            <box-body-nopad>
                <form-list name="UserList" list="users" skip-form="true" paginate="true">
                    <field name="userFullName">
                        <default-field title="User">
                            <link url="../UserDetail" text="${userFullName}" link-type="anchor" parameter-map="{userId:userId}"/>
                        </default-field>
                    </field>
                    <field name="username"><default-field title="Username"><display/></default-field></field>
                    <field name="emailAddress"><default-field title="Email"><display/></default-field></field>
                    <field name="organizationsText"><default-field title="Organizations"><display/></default-field></field>
                    <field name="stateText"><default-field title="State"><display/></default-field></field>
                    <field name="lastLoginText"><default-field title="Last sign-in"><display/></default-field></field>
                    <columns type="mobile">
                        <column><field-ref name="userFullName"/><field-ref name="username"/></column>
                        <column><field-ref name="stateText"/><field-ref name="lastLoginText"/></column>
                    </columns>
                </form-list>
                <label type="p" style="q-pa-md m-muted" condition="!users.length &amp;&amp; filtered" text="No user matches."/>
                <label type="p" style="q-pa-md m-muted" condition="!users.length &amp;&amp; !filtered &amp;&amp; !failure" text="No staff in the organizations you administer."/>
                <label type="p" style="q-px-md q-pb-md m-muted" condition="userListCount &gt; users.length" text="Showing ${users.length} of ${userListCount}; narrow the search to see others."/>
            </box-body-nopad>
        </container-box>
    </widgets>
</screen>
