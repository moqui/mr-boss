<!-- IdentityProviders (design-admin §6 IdentityProviders; style-guide §3.2 List; impl-admin P10): the sign-in providers people
    may sign in through (the framework's moqui.security.sso.AuthFlow), read from
    org.moqui.admin.ConfigurationServices.find#IdentityProviders. ProviderList shows each with its type, whether it is enabled,
    its readiness and the callback URL to register at the provider; NewProvider starts an OpenID Connect or OAuth provider,
    saved disabled, and opens its detail (store#IdentityProvider). Reading needs ADMIN_CONNECTION_VIEW or ADMIN_ACCESS_VIEW and
    starting one ADMIN_CONNECTION_MANAGE, checked by the services. SAML sign-in is not available in this build: a SAML row an
    instance administrator made is listed as such. No secret is shown or listed. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Identity providers" menu-image="sym_o_passkey" menu-image-type="icon">
    <parameter name="text"/>
    <parameter name="authFlowTypeEnumId"/>
    <parameter name="state"/>

    <transition name="createProvider">
        <actions>
            <service-call name="org.moqui.admin.ConfigurationServices.store#IdentityProvider" out-map="stored"
                    in-map="{authFlowId:(newProviderId || null), authFlowTypeEnumId:newTypeEnumId, description:newDescription}"/>
            <if condition="!ec.message.hasError()">
                <script>ec.message.addMessage(stored.applied ? 'Provider started. It stays disabled until it is configured, tested and enabled.' : stored.reason,
                    stored.applied ? 'success' : 'warning')</script>
                <set field="authFlowId" from="stored.applied ? stored.authFlowId : null"/>
            </if>
        </actions>
        <conditional-response url="../IdentityProviderDetail"><condition><expression>!!authFlowId</expression></condition>
            <parameter name="authFlowId"/></conditional-response>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <service-call name="org.moqui.admin.ConfigurationServices.find#IdentityProviders" out-map="found" transaction="force-new" ignore-error="true"
                in-map="{text:(text || null), authFlowTypeEnumId:(authFlowTypeEnumId || null), state:(state || null)}"/>
        <!-- ignore-error clears a refusal's message -->
        <set field="available" from="!!found?.providerList"/>
        <set field="providers" from="(found?.providerList || []).map(row => Object.assign({}, row, {
                stateColor: row.readiness === 'enabled' ? 'positive' : row.readiness === 'untested' ? 'warning' : row.readiness === 'tested' ? 'primary' : 'grey-7',
                typeText: [row.typeName, row.clientTypeName].filter(Boolean).join(' · ')}))"/>
        <set field="filtered" from="!!(text || authFlowTypeEnumId || state)"/>
        <set field="findValues" from="{text:text, authFlowTypeEnumId:authFlowTypeEnumId, state:state}"/>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Identity providers" type="h5"/>
                <label text="The providers people may sign in through instead of a password here. A provider is configured, tested and then enabled; a sign-in gives only the groups its role mappings name."
                        type="p" style="text-caption m-muted q-mb-none"/>
            </container>
            <container style="col-auto">
                <section name="NewProviderSection" condition="found?.canConfigure">
                    <widgets>
                        <container-dialog id="NewProvider" button-text="New provider" type="primary" icon="sym_o_add" title="Start a sign-in provider">
                            <form-single name="NewProvider" transition="createProvider">
                                <field name="newDescription"><default-field title="Name" tooltip="What people see on the sign-in page"><text-line size="40"/></default-field></field>
                                <field name="newTypeEnumId">
                                    <default-field title="Type">
                                        <drop-down><list-options list="found?.typeOptions || []" key="${value}" text="${label}"/></drop-down>
                                    </default-field>
                                </field>
                                <field name="newProviderId">
                                    <default-field title="Id" tooltip="Optional: letters, digits and underscores; it is part of the provider's sign-in link">
                                        <text-line size="30"/>
                                    </default-field>
                                </field>
                                <field name="submitButton"><default-field title="Start provider"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </widgets>
                </section>
            </container>
        </container>
        <label type="p" style="text-negative" condition="!available" text="Identity providers are not available to you."/>
        <section name="ProviderSection" condition="available">
            <widgets>
                <form-single name="ProviderFind" transition="." map="findValues">
                    <field name="text"><default-field title="Provider"><text-line size="30"/></default-field></field>
                    <field name="authFlowTypeEnumId">
                        <default-field title="Type">
                            <drop-down allow-empty="true">
                                <option key="AftOidc" text="OpenID Connect"/><option key="AftOauth" text="OAuth"/><option key="AftSaml" text="SAML"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="state">
                        <default-field title="State">
                            <drop-down allow-empty="true"><option key="enabled" text="Enabled"/><option key="disabled" text="Not enabled"/></drop-down>
                        </default-field>
                    </field>
                    <field name="submitButton"><default-field title="Find"><submit/></default-field></field>
                    <field-layout>
                        <field-row-big><field-ref name="text"/><field-ref name="authFlowTypeEnumId"/><field-ref name="state"/><field-ref name="submitButton"/></field-row-big>
                    </field-layout>
                </form-single>
                <label type="p" style="m-muted" condition="!providers.length &amp;&amp; !filtered"
                        text="No sign-in provider yet: everyone signs in with a password here. Start one with New provider."/>
                <label type="p" style="m-muted" condition="!providers.length &amp;&amp; filtered" text="No provider matches."/>
                <form-list name="ProviderList" list="providers" skip-form="true" paginate="false">
                    <field name="description">
                        <default-field title="Provider">
                            <link url="../IdentityProviderDetail" text="${description}" link-type="anchor" parameter-map="{authFlowId:authFlowId}"/>
                        </default-field>
                    </field>
                    <field name="typeText"><default-field title="Type"><display/></default-field></field>
                    <field name="readinessText">
                        <default-field title="State">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${readinessText}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: readinessText})}]]></text>
                                <text type="html">${readinessText}</text>
                            </render-mode>
                        </default-field>
                    </field>
                    <field name="callbackUrl"><default-field title="Callback URL"><display/></default-field></field>
                    <field name="roleMapCount"><default-field title="Role mappings" align="right"><display/></default-field></field>
                    <columns type="mobile">
                        <column><field-ref name="description"/><field-ref name="typeText"/></column>
                        <column><field-ref name="readinessText"/></column>
                    </columns>
                </form-list>
            </widgets>
        </section>
    </widgets>
</screen>
