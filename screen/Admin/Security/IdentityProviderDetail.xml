<!-- IdentityProviderDetail (design-admin §6 IdentityProviderDetail, §8.1; style-guide §3.3 Detail; impl-admin P10): one
    sign-in provider, read from org.moqui.admin.ConfigurationServices.find#IdentityProviders and changed through
    store#IdentityProvider at the revision read. ProviderConfiguration is the type's own form (OpenID Connect, OAuth or SAML):
    a secret is entered, never shown (only whether one is set); a change of the client, the issuer or an endpoint needs the
    secret entered again, else the stored one is cleared, and either way the provider is disabled until a test passes.
    IdentityMappings maps a claim onto an account field (never an expression) and holds the rule that links existing
    accounts. RoleMappings maps a remote role to a registered bundle the administrator may assign, never a privileged group or
    one granting a sealed permission; a refused row is named with its reason. ProviderCheck tests the provider as configured
    (test#IdentityProvider: no account is made, nobody is signed in) and shows what a test identity's roles would give. The
    configuration needs ADMIN_CONNECTION_MANAGE; the role mappings, the link rule, the default group and enabling
    ADMIN_ACCESS_MANAGE; the service checks each, and every refusal comes back as a reason shown here. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Identity provider" default-menu-include="false">
    <parameter name="authFlowId" required="true"/>

    <transition name="storeConfiguration">
        <actions>
            <service-call name="org.moqui.admin.ConfigurationServices.store#IdentityProvider" out-map="stored"
                    in-map="{authFlowId:authFlowId, expectedRevision:expectedRevision, description:(description ?? null),
                        sequenceNum:(sequenceNum ?? null), clientTypeEnumId:(clientTypeEnumId ?? null), clientId:(clientId ?? null),
                        secret:(secret || null), discoveryUri:(discoveryUri ?? null), realm:(realm ?? null), baseUri:(baseUri ?? null),
                        preferredJwsAlgorithmEnumId:(preferredJwsAlgorithmEnumId ?? null), useNonce:(useNonce ?? null),
                        appleTeamId:(appleTeamId ?? null), appleKeyId:(appleKeyId ?? null), authorizeUrl:(authorizeUrl ?? null),
                        tokenUrl:(tokenUrl ?? null), userInfoUrl:(userInfoUrl ?? null), scope:(scope ?? null),
                        serviceProviderEntityId:(serviceProviderEntityId ?? null),
                        identityProviderMetadataLocation:(identityProviderMetadataLocation ?? null), forceAuth:(forceAuth ?? null),
                        passive:(passive ?? null), keystorePassword:(keystorePassword || null),
                        privateKeyPassword:(privateKeyPassword || null), reason:(reason || null)}"/>
            <if condition="!ec.message.hasError()">
                <script>ec.message.addMessage(stored.applied ? (stored.reason || 'Configuration saved') : stored.reason,
                    !stored.applied || stored.reason ? 'warning' : 'success')</script>
            </if>
        </actions>
        <default-response url="."><parameter name="authFlowId"/></default-response>
        <error-response url="."><parameter name="authFlowId"/></error-response>
    </transition>
    <transition name="storeAccess">
        <actions>
            <service-call name="org.moqui.admin.ConfigurationServices.store#IdentityProvider" out-map="stored"
                    in-map="{authFlowId:authFlowId, expectedRevision:expectedRevision, accountLinkEnumId:(accountLinkEnumId ?? null),
                        defaultUserGroupId:(defaultUserGroupId ?? null), reason:(reason || null)}"/>
            <if condition="!ec.message.hasError()">
                <script>ec.message.addMessage(stored.applied ? 'Saved' : stored.reason, stored.applied ? 'success' : 'warning')</script>
            </if>
        </actions>
        <default-response url="."><parameter name="authFlowId"/></default-response>
        <error-response url="."><parameter name="authFlowId"/></error-response>
    </transition>
    <!-- the mappings change as one list at the revision read: the stored rows, with the row added or without the row removed -->
    <transition name="changeFieldMap">
        <actions>
            <service-call name="org.moqui.admin.ConfigurationServices.find#IdentityProviders" out-map="found" in-map="{authFlowId:authFlowId}"/>
            <if condition="!ec.message.hasError() &amp;&amp; found.provider">
                <set field="fieldMapList" from="found.provider.fieldMapList.filter(row => !row.advanced &amp;&amp; row.dstFieldName !== (removeField || dstFieldName))
                        .map(row => ({srcFieldName: row.srcFieldName, dstFieldName: row.dstFieldName}))
                        .concat(removeField ? [] : [{srcFieldName: String(srcFieldName || '').trim(), dstFieldName: dstFieldName}])"/>
                <service-call name="org.moqui.admin.ConfigurationServices.store#IdentityProvider" out-map="stored"
                        in-map="{authFlowId:authFlowId, expectedRevision:expectedRevision, fieldMapList:fieldMapList, reason:(reason || null)}"/>
            </if>
            <if condition="!ec.message.hasError() &amp;&amp; stored">
                <script>ec.message.addMessage(stored.applied ? 'Identity mappings saved' : stored.reason, stored.applied ? 'success' : 'warning')</script>
            </if>
        </actions>
        <default-response url="."><parameter name="authFlowId"/></default-response>
        <error-response url="."><parameter name="authFlowId"/></error-response>
    </transition>
    <transition name="changeRoleMap">
        <actions>
            <service-call name="org.moqui.admin.ConfigurationServices.find#IdentityProviders" out-map="found" in-map="{authFlowId:authFlowId}"/>
            <if condition="!ec.message.hasError() &amp;&amp; found.provider">
                <set field="roleMapList" from="found.provider.roleMapList.filter(row => row.roleName !== (removeRole || String(roleName || '').trim()))
                        .map(row => ({roleName: row.roleName, userGroupId: row.userGroupId}))
                        .concat(removeRole ? [] : [{roleName: String(roleName || '').trim(), userGroupId: userGroupId}])"/>
                <service-call name="org.moqui.admin.ConfigurationServices.store#IdentityProvider" out-map="stored"
                        in-map="{authFlowId:authFlowId, expectedRevision:expectedRevision, roleMapList:roleMapList, reason:(reason || null)}"/>
            </if>
            <if condition="!ec.message.hasError() &amp;&amp; stored">
                <script>ec.message.addMessage(stored.applied ? 'Role mappings saved' : stored.reason, stored.applied ? 'success' : 'warning')</script>
            </if>
        </actions>
        <default-response url="."><parameter name="authFlowId"/></default-response>
        <error-response url="."><parameter name="authFlowId"/></error-response>
    </transition>
    <transition name="testProvider">
        <actions>
            <service-call name="org.moqui.admin.ConfigurationServices.test#IdentityProvider" out-map="tested"
                    in-map="{authFlowId:authFlowId, testRoles:(testRoles || null)}"/>
            <if condition="!ec.message.hasError()">
                <script><![CDATA[
                    if (tested.applied === false) ec.message.addMessage(tested.reason, 'warning')
                    else {
                        ec.message.addMessage(tested.passed ? 'The test passed' + (tested.enabled ? '' : ': the provider can be enabled')
                            : 'The test did not pass', tested.passed ? 'success' : 'warning')
                        for (const row of Array.from(tested.checkList || []))
                            ec.message.addMessage(row.check + ': ' + row.text, row.state === 'ok' ? 'info' : 'warning')
                        for (const row of Array.from(tested.grantPreview || []))
                            ec.message.addMessage('A test identity with the role ' + row.roleName + ': ' + row.text, row.given ? 'info' : 'warning')
                    }
                ]]></script>
            </if>
        </actions>
        <default-response url="."><parameter name="authFlowId"/></default-response>
        <error-response url="."><parameter name="authFlowId"/></error-response>
    </transition>
    <transition name="setEnabled">
        <actions>
            <service-call name="org.moqui.admin.ConfigurationServices.store#IdentityProvider" out-map="stored"
                    in-map="{authFlowId:authFlowId, expectedRevision:expectedRevision, enabled:(enable === 'Y'), reason:(reason || null)}"/>
            <if condition="!ec.message.hasError()">
                <script>ec.message.addMessage(stored.applied ? (stored.enabled ? 'The provider is enabled: people can sign in through it'
                    : 'The provider is disabled: nobody signs in through it') : stored.reason, stored.applied ? 'success' : 'warning')</script>
            </if>
        </actions>
        <default-response url="."><parameter name="authFlowId"/></default-response>
        <error-response url="."><parameter name="authFlowId"/></error-response>
    </transition>

    <actions>
        <service-call name="org.moqui.admin.ConfigurationServices.find#IdentityProviders" out-map="found" transaction="force-new" ignore-error="true"
                in-map="{authFlowId:authFlowId}"/>
        <!-- ignore-error clears a refusal's message: a provider that is not answered is not available -->
        <set field="provider" from="found?.provider || null"/>
        <set field="recordFound" from="!!provider"/>
        <if condition="recordFound">
            <set field="configuration" from="provider.configuration || {}"/>
            <set field="kind" from="provider.authFlowTypeEnumId"/>
            <set field="editable" from="!provider.inbound &amp;&amp; ['AftOidc', 'AftOauth', 'AftSaml'].includes(kind)"/>
            <set field="canConfigure" from="editable &amp;&amp; !!found.canConfigure"/>
            <set field="canGrant" from="editable &amp;&amp; !!found.canMap"/>
            <set field="canTest" from="editable &amp;&amp; (!!found.canConfigure || !!found.canMap)"/>
            <set field="enableOffered" from="canGrant &amp;&amp; !provider.enabled &amp;&amp; provider.readiness === 'tested'"/>
            <set field="discoveryText" from="configuration.discoveryUri || configuration.baseUri || 'the one of its provider type'"/>
            <set field="endpointText" from="[configuration.authorizeUrl, configuration.tokenUrl, configuration.userInfoUrl].filter(Boolean).join(', ') || 'those of its provider type'"/>
            <set field="stateColor" from="provider.readiness === 'enabled' ? 'positive' : provider.readiness === 'untested' ? 'warning' : provider.readiness === 'tested' ? 'primary' : 'grey-7'"/>
            <set field="secretText" from="configuration.secretSet ? 'A secret is stored. Leave empty to keep it.' : 'No secret is stored.'"/>
            <set field="configurationValues" from="Object.assign({}, configuration, {authFlowId: authFlowId, expectedRevision: provider.revision,
                    description: provider.description, sequenceNum: provider.sequenceNum, useNonce: configuration.useNonce ? 'Y' : 'N',
                    forceAuth: configuration.forceAuth ? 'Y' : 'N', passive: configuration.passive ? 'Y' : 'N', secret: '',
                    keystorePassword: '', privateKeyPassword: ''})"/>
            <set field="accessValues" from="{authFlowId: authFlowId, expectedRevision: provider.revision, accountLinkEnumId: provider.accountLinkEnumId,
                    defaultUserGroupId: provider.defaultUserGroupId}"/>
            <set field="keyValues" from="{authFlowId: authFlowId, expectedRevision: provider.revision}"/>
            <set field="fieldMaps" from="provider.fieldMapList.map(row => Object.assign({}, row, {
                    targetText: row.advanced ? 'By an expression or a mapping service (changed in Tools)' : row.dstFieldLabel}))"/>
            <set field="roleMaps" from="provider.roleMapList.map(row => Object.assign({}, row, {
                    groupText: [row.appName, row.groupName].filter(Boolean).join(': '),
                    stateText: row.allowed ? 'Given at sign-in' : 'Not given: ' + (row.reason || 'not available')}))"/>
            <set field="testedText" from="provider.tested ? 'Tested ' + (provider.testedDate ? ec.l10n.format(Date.parse(provider.testedDate), 'yyyy-MM-dd HH:mm') : '') + (provider.testedByName ? ' by ' + provider.testedByName : '') + ', as it is configured now'
                    : 'Not tested as it is configured now'"/>
            <set field="defaultGroupText" from="provider.defaultGroup ? (provider.defaultGroup.allowed ? provider.defaultGroup.description : provider.defaultUserGroupId + ' (not given: ' + provider.defaultGroup.reason + ')') : 'None'"/>
        </if>
    </actions>
    <widgets>
        <section name="ProviderUnavailable" condition="!recordFound">
            <widgets>
                <label text="Identity provider" type="h5"/>
                <label type="p" text="This provider is not available to you, or it does not exist."/>
                <link url="../IdentityProviders" text="Identity providers" link-type="anchor"/>
            </widgets>
        </section>
        <section name="ProviderFound" condition="recordFound">
            <widgets>
                <container style="m-record-header">
                    <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                        <container style="col-12 col-md m-record-title">
                            <label text="${provider.description}" type="h5"/>
                            <label text="${authFlowId} · ${provider.typeName}${provider.clientTypeName ? ' · ' + provider.clientTypeName : ''}" type="p" style="text-caption m-muted"/>
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${provider.readinessText}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", id: "ProviderState", text: provider.readinessText})}]]></text>
                                <text type="html">${provider.readinessText}</text>
                            </render-mode>
                        </container>
                        <container style="col-12 col-md-auto m-record-actions">
                            <!-- one primary action by state: Test until a test passes, then Enable -->
                            <section name="TestAction" condition="canTest &amp;&amp; !enableOffered">
                                <widgets>
                                    <container-dialog id="TestProvider" button-text="Test" icon="sym_o_network_check" title="Test ${provider.description}" type="primary">
                                        <label type="p" style="m-muted" text="Checks the configuration, the role mappings and that a sign-in can start at the provider. No account is made and nobody is signed in."/>
                                        <form-single name="TestProvider" transition="testProvider" map="keyValues">
                                            <field name="authFlowId"><default-field><hidden/></default-field></field>
                                            <field name="testRoles">
                                                <default-field title="Roles of a test identity" tooltip="Optional: the remote roles of someone who would sign in, separated by commas, to see which groups they would be given">
                                                    <text-line size="50"/>
                                                </default-field>
                                            </field>
                                            <field name="submitButton"><default-field title="Run the test"><submit/></default-field></field>
                                        </form-single>
                                    </container-dialog>
                                </widgets>
                            </section>
                            <section name="TestAgainAction" condition="canTest &amp;&amp; enableOffered">
                                <widgets>
                                    <container-dialog id="TestProviderAgain" button-text="Test" icon="sym_o_network_check" title="Test ${provider.description}">
                                        <label type="p" style="m-muted" text="Checks the configuration, the role mappings and that a sign-in can start at the provider. No account is made and nobody is signed in."/>
                                        <form-single name="TestProviderAgain" transition="testProvider" map="keyValues">
                                            <field name="authFlowId"><default-field><hidden/></default-field></field>
                                            <field name="testRoles">
                                                <default-field title="Roles of a test identity" tooltip="Optional: the remote roles of someone who would sign in, separated by commas, to see which groups they would be given">
                                                    <text-line size="50"/>
                                                </default-field>
                                            </field>
                                            <field name="submitButton"><default-field title="Run the test"><submit/></default-field></field>
                                        </form-single>
                                    </container-dialog>
                                </widgets>
                            </section>
                            <section name="EnableAction" condition="enableOffered">
                                <widgets>
                                    <link url="setEnabled" text="Enable" btn-type="primary" icon="sym_o_toggle_on" link-type="hidden-form-link"
                                            confirmation="Enable ${provider.description}? People can then sign in through it, and a sign-in gives the groups its role mappings name."
                                            parameter-map="{authFlowId:authFlowId, expectedRevision:provider.revision, enable:'Y'}"/>
                                </widgets>
                            </section>
                            <section name="DisableAction" condition="(canGrant || canConfigure) &amp;&amp; provider.enabled">
                                <widgets>
                                    <button-menu text="More" icon="more_horiz">
                                        <link url="setEnabled" text="Disable" btn-type="danger" icon="sym_o_toggle_off" link-type="hidden-form-link"
                                                confirmation="Disable ${provider.description}? Nobody signs in through it until it is enabled again; people with no password here cannot sign in."
                                                parameter-map="{authFlowId:authFlowId, expectedRevision:provider.revision, enable:'N'}"/>
                                    </button-menu>
                                </widgets>
                            </section>
                        </container>
                    </container>
                    <label type="p" style="text-caption text-warning q-mt-sm q-mb-none" condition="provider.inbound"
                            text="An inbound flow is a remote system's, not a sign-in: an instance administrator changes it in Tools."/>
                    <label type="p" style="text-caption text-warning q-mt-sm q-mb-none" condition="kind === 'AftSaml'"
                            text="SAML sign-in is not available in this build: the provider is kept and cannot be enabled."/>
                    <label type="p" style="text-caption text-warning q-mt-sm q-mb-none" condition="editable &amp;&amp; provider.problem" text="${provider.problem}."/>
                </container>

                <container-box>
                    <box-header title="Configuration"/>
                    <box-body>
                        <label type="p" style="m-muted" condition="editable"
                                text="Changing the client, the issuer or an endpoint needs the secret entered again: otherwise the stored secret is cleared. Either way the provider is disabled until a test against it passes."/>
                        <section name="ConfigurationRead" condition="!canConfigure">
                            <widgets>
                                <label type="p" text="Client: ${configuration.clientId || 'none'} · secret ${configuration.secretSet ? 'stored' : 'not stored'}" condition="kind !== 'AftSaml'"/>
                                <label type="p" text="Discovery: ${discoveryText}" condition="kind === 'AftOidc'"/>
                                <label type="p" text="Endpoints: ${endpointText}" condition="kind === 'AftOauth'"/>
                                <label type="p" text="Metadata: ${configuration.identityProviderMetadataLocation || 'none'}" condition="kind === 'AftSaml'"/>
                                <label type="p" style="text-caption m-muted" condition="editable" text="An integration administrator changes the configuration."/>
                            </widgets>
                        </section>
                        <section name="OidcConfigurationSection" condition="canConfigure &amp;&amp; kind === 'AftOidc'">
                            <widgets>
                                <form-single name="OidcConfiguration" transition="storeConfiguration" map="configurationValues">
                                    <field name="authFlowId"><default-field><hidden/></default-field></field>
                                    <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                    <field name="description"><default-field title="Name"><text-line size="40"/></default-field></field>
                                    <field name="sequenceNum"><default-field title="Order" tooltip="Where it is listed on the sign-in page"><text-line size="6"/></default-field></field>
                                    <field name="clientTypeEnumId">
                                        <default-field title="Provider">
                                            <drop-down allow-empty="true"><list-options list="found.clientTypeOptions || []" key="${value}" text="${label}"/></drop-down>
                                        </default-field>
                                    </field>
                                    <field name="clientId"><default-field title="Client ID"><text-line size="50"/></default-field></field>
                                    <field name="secret"><default-field title="Client secret" tooltip="${secretText} For Apple, the private key."><password size="50"/></default-field></field>
                                    <field name="discoveryUri"><default-field title="Discovery URL" tooltip="The issuer's .well-known/openid-configuration; empty for Google, Apple and Azure AD, which have their own"><text-line size="70"/></default-field></field>
                                    <field name="baseUri"><default-field title="Keycloak base URL"><text-line size="50"/></default-field></field>
                                    <field name="realm"><default-field title="Keycloak realm"><text-line size="30"/></default-field></field>
                                    <field name="preferredJwsAlgorithmEnumId">
                                        <default-field title="Token signature">
                                            <drop-down allow-empty="true"><list-options list="found.algorithmOptions || []" key="${value}" text="${label}"/></drop-down>
                                        </default-field>
                                    </field>
                                    <field name="useNonce">
                                        <default-field title="Nonce"><drop-down><option key="N" text="Not used"/><option key="Y" text="Used"/></drop-down></default-field>
                                    </field>
                                    <field name="appleTeamId"><default-field title="Apple team ID"><text-line size="20"/></default-field></field>
                                    <field name="appleKeyId"><default-field title="Apple key ID"><text-line size="20"/></default-field></field>
                                    <field name="reason"><default-field title="Reason" tooltip="Kept in the audit log beside the change"><text-line size="50"/></default-field></field>
                                    <field name="submitButton"><default-field title="Save configuration"><submit/></default-field></field>
                                    <field-layout>
                                        <field-row><field-ref name="description"/><field-ref name="sequenceNum"/></field-row>
                                        <field-row><field-ref name="clientTypeEnumId"/><field-ref name="clientId"/></field-row>
                                        <field-ref name="secret"/>
                                        <field-ref name="discoveryUri"/>
                                        <field-row><field-ref name="baseUri"/><field-ref name="realm"/></field-row>
                                        <field-row><field-ref name="preferredJwsAlgorithmEnumId"/><field-ref name="useNonce"/></field-row>
                                        <field-row><field-ref name="appleTeamId"/><field-ref name="appleKeyId"/></field-row>
                                        <field-ref name="reason"/>
                                        <field-ref name="submitButton"/>
                                    </field-layout>
                                </form-single>
                            </widgets>
                        </section>
                        <section name="OauthConfigurationSection" condition="canConfigure &amp;&amp; kind === 'AftOauth'">
                            <widgets>
                                <form-single name="OauthConfiguration" transition="storeConfiguration" map="configurationValues">
                                    <field name="authFlowId"><default-field><hidden/></default-field></field>
                                    <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                    <field name="description"><default-field title="Name"><text-line size="40"/></default-field></field>
                                    <field name="sequenceNum"><default-field title="Order" tooltip="Where it is listed on the sign-in page"><text-line size="6"/></default-field></field>
                                    <field name="clientTypeEnumId">
                                        <default-field title="Provider">
                                            <drop-down allow-empty="true"><list-options list="found.clientTypeOptions || []" key="${value}" text="${label}"/></drop-down>
                                        </default-field>
                                    </field>
                                    <field name="clientId"><default-field title="Client ID"><text-line size="50"/></default-field></field>
                                    <field name="secret"><default-field title="Client secret" tooltip="${secretText}"><password size="50"/></default-field></field>
                                    <field name="authorizeUrl"><default-field title="Authorization endpoint" tooltip="Empty takes the named provider's own"><text-line size="70"/></default-field></field>
                                    <field name="tokenUrl"><default-field title="Token endpoint"><text-line size="70"/></default-field></field>
                                    <field name="userInfoUrl"><default-field title="User info endpoint"><text-line size="70"/></default-field></field>
                                    <field name="scope"><default-field title="Scope" tooltip="Space separated; empty takes the provider's default"><text-line size="50"/></default-field></field>
                                    <field name="reason"><default-field title="Reason" tooltip="Kept in the audit log beside the change"><text-line size="50"/></default-field></field>
                                    <field name="submitButton"><default-field title="Save configuration"><submit/></default-field></field>
                                    <field-layout>
                                        <field-row><field-ref name="description"/><field-ref name="sequenceNum"/></field-row>
                                        <field-row><field-ref name="clientTypeEnumId"/><field-ref name="clientId"/></field-row>
                                        <field-ref name="secret"/>
                                        <field-ref name="authorizeUrl"/>
                                        <field-ref name="tokenUrl"/>
                                        <field-ref name="userInfoUrl"/>
                                        <field-ref name="scope"/>
                                        <field-ref name="reason"/>
                                        <field-ref name="submitButton"/>
                                    </field-layout>
                                </form-single>
                            </widgets>
                        </section>
                        <section name="SamlConfigurationSection" condition="canConfigure &amp;&amp; kind === 'AftSaml'">
                            <widgets>
                                <form-single name="SamlConfiguration" transition="storeConfiguration" map="configurationValues">
                                    <field name="authFlowId"><default-field><hidden/></default-field></field>
                                    <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                    <field name="description"><default-field title="Name"><text-line size="40"/></default-field></field>
                                    <field name="serviceProviderEntityId"><default-field title="Our entity ID"><text-line size="60"/></default-field></field>
                                    <field name="identityProviderMetadataLocation"><default-field title="Provider metadata URL"><text-line size="70"/></default-field></field>
                                    <field name="forceAuth">
                                        <default-field title="Sign in again each time"><drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down></default-field>
                                    </field>
                                    <field name="passive">
                                        <default-field title="Passive"><drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down></default-field>
                                    </field>
                                    <field name="keystorePassword"><default-field title="Keystore password" tooltip="${configuration.keystorePasswordSet ? 'One is stored. Leave empty to keep it.' : 'None is stored.'}"><password size="40"/></default-field></field>
                                    <field name="privateKeyPassword"><default-field title="Private key password" tooltip="${configuration.privateKeyPasswordSet ? 'One is stored. Leave empty to keep it.' : 'None is stored.'}"><password size="40"/></default-field></field>
                                    <field name="reason"><default-field title="Reason" tooltip="Kept in the audit log beside the change"><text-line size="50"/></default-field></field>
                                    <field name="submitButton"><default-field title="Save configuration"><submit/></default-field></field>
                                </form-single>
                            </widgets>
                        </section>
                        <label type="p" style="text-caption m-muted q-mt-sm" condition="editable"
                                text="Callback URL to register at the provider: ${provider.callbackUrl}"/>
                    </box-body>
                </container-box>

                <container-box>
                    <box-header title="Identity mappings"/>
                    <box-toolbar>
                        <section name="AddFieldMapSection" condition="canConfigure &amp;&amp; !provider.fieldMapsAdvanced">
                            <widgets>
                                <container-dialog id="AddFieldMap" button-text="Add mapping" icon="sym_o_add" title="Map a claim onto an account field">
                                    <form-single name="AddFieldMap" transition="changeFieldMap" map="keyValues">
                                        <field name="authFlowId"><default-field><hidden/></default-field></field>
                                        <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                        <field name="srcFieldName"><default-field title="Claim" tooltip="The name of a claim the provider sends, such as name or email"><text-line size="30"/></default-field></field>
                                        <field name="dstFieldName">
                                            <default-field title="Account field">
                                                <drop-down><list-options list="found.localFieldOptions || []" key="${value}" text="${label}"/></drop-down>
                                            </default-field>
                                        </field>
                                        <field name="submitButton"><default-field title="Add mapping"><submit/></default-field></field>
                                    </form-single>
                                </container-dialog>
                            </widgets>
                        </section>
                    </box-toolbar>
                    <box-body>
                        <label type="p" text="Existing accounts are linked: ${provider.accountLinkName}." condition="!canGrant"/>
                        <section name="LinkRuleSection" condition="canGrant">
                            <widgets>
                                <form-single name="LinkRule" transition="storeAccess" map="accessValues">
                                    <field name="authFlowId"><default-field><hidden/></default-field></field>
                                    <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                    <field name="defaultUserGroupId"><default-field><hidden/></default-field></field>
                                    <field name="accountLinkEnumId">
                                        <default-field title="Linking existing accounts" tooltip="How a first sign-in finds an account that already exists here. A provider's username alone links nothing, and an account in a privileged group is linked by an administrator only.">
                                            <drop-down><list-options list="found.accountLinkOptions || []" key="${value}" text="${label}"/></drop-down>
                                        </default-field>
                                    </field>
                                    <field name="submitButton"><default-field title="Save rule"><submit/></default-field></field>
                                    <field-layout><field-row-big><field-ref name="accountLinkEnumId"/><field-ref name="submitButton"/></field-row-big></field-layout>
                                </form-single>
                            </widgets>
                        </section>
                        <label type="p" style="m-muted" condition="!fieldMaps.length" text="No claim is mapped: a new account takes its sign-in name from the provider and nothing else."/>
                        <form-list name="IdentityMappings" list="fieldMaps" skip-form="true" paginate="false">
                            <field name="srcFieldName"><default-field title="Remote claim"><display text="${advanced ? (srcFieldName || 'An expression') : srcFieldName}"/></default-field></field>
                            <field name="targetText"><default-field title="Account field"><display/></default-field></field>
                            <field name="remove">
                                <conditional-field condition="canConfigure &amp;&amp; !provider.fieldMapsAdvanced" title="">
                                    <link url="changeFieldMap" text="Remove" btn-type="danger" icon="sym_o_delete" link-type="hidden-form-link"
                                            confirmation="Remove the mapping of ${srcFieldName} onto ${targetText}?"
                                            parameter-map="{authFlowId:authFlowId, expectedRevision:provider.revision, removeField:dstFieldName}"/>
                                </conditional-field>
                                <default-field title=""><display text=""/></default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="srcFieldName"/></column>
                                <column><field-ref name="targetText"/><field-ref name="remove"/></column>
                            </columns>
                        </form-list>
                    </box-body>
                </container-box>

                <container-box>
                    <box-header title="Role mappings"/>
                    <box-toolbar>
                        <section name="AddRoleMapSection" condition="canGrant">
                            <widgets>
                                <container-dialog id="AddRoleMap" button-text="Add role mapping" icon="sym_o_add" title="Give a group to a remote role">
                                    <label type="p" style="m-muted" text="Only bundles you may assign are offered. A sign-in never gives a privileged group or one that grants a sealed permission."/>
                                    <form-single name="AddRoleMap" transition="changeRoleMap" map="keyValues">
                                        <field name="authFlowId"><default-field><hidden/></default-field></field>
                                        <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                        <field name="roleName"><default-field title="Remote role" tooltip="A role or group name the provider sends for the person"><text-line size="40"/></default-field></field>
                                        <field name="userGroupId">
                                            <default-field title="Group">
                                                <drop-down><list-options list="found.groupOptions || []" key="${value}" text="${label}"/></drop-down>
                                            </default-field>
                                        </field>
                                        <field name="reason"><default-field title="Reason"><text-line size="50"/></default-field></field>
                                        <field name="submitButton"><default-field title="Add role mapping"><submit/></default-field></field>
                                    </form-single>
                                </container-dialog>
                            </widgets>
                        </section>
                    </box-toolbar>
                    <box-body>
                        <label type="p" text="Default group for a sign-in with no mapped role: ${defaultGroupText}." condition="!canGrant"/>
                        <section name="DefaultGroupSection" condition="canGrant">
                            <widgets>
                                <form-single name="DefaultGroup" transition="storeAccess" map="accessValues">
                                    <field name="authFlowId"><default-field><hidden/></default-field></field>
                                    <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                    <field name="accountLinkEnumId"><default-field><hidden/></default-field></field>
                                    <field name="defaultUserGroupId">
                                        <default-field title="Default group" tooltip="Given to a sign-in that has no group at all; empty for none. Now: ${defaultGroupText}">
                                            <drop-down allow-empty="true"><list-options list="found.groupOptions || []" key="${value}" text="${label}"/></drop-down>
                                        </default-field>
                                    </field>
                                    <field name="submitButton"><default-field title="Save default"><submit/></default-field></field>
                                    <field-layout><field-row-big><field-ref name="defaultUserGroupId"/><field-ref name="submitButton"/></field-row-big></field-layout>
                                </form-single>
                            </widgets>
                        </section>
                        <label type="p" style="m-muted" condition="!roleMaps.length" text="No remote role is mapped: a sign-in gives no group but the default."/>
                        <form-list name="RoleMappings" list="roleMaps" skip-form="true" paginate="false">
                            <field name="roleName"><default-field title="Remote role"><display/></default-field></field>
                            <field name="groupText"><default-field title="Group"><display/></default-field></field>
                            <field name="stateText">
                                <default-field title="At sign-in">
                                    <render-mode>
                                        <text type="qvt"><![CDATA[<span class="${allowed ? '' : 'text-negative'}">${WebUtilities.encodeHtml(stateText)}</span>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateText})}]]></text>
                                        <text type="html">${stateText}</text>
                                    </render-mode>
                                </default-field>
                            </field>
                            <field name="remove">
                                <conditional-field condition="canGrant" title="">
                                    <link url="changeRoleMap" text="Remove" btn-type="danger" icon="sym_o_delete" link-type="hidden-form-link"
                                            confirmation="Remove the mapping of ${roleName}? People who already hold ${groupText} keep it until an access administrator ends it."
                                            parameter-map="{authFlowId:authFlowId, expectedRevision:provider.revision, removeRole:roleName}"/>
                                </conditional-field>
                                <default-field title=""><display text=""/></default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="roleName"/><field-ref name="groupText"/></column>
                                <column><field-ref name="stateText"/><field-ref name="remove"/></column>
                            </columns>
                        </form-list>
                    </box-body>
                </container-box>

                <container-box>
                    <box-header title="Check"/>
                    <box-body>
                        <label type="p" text="${testedText}."/>
                        <label type="p" style="m-muted" condition="editable &amp;&amp; kind !== 'AftSaml'"
                                text="A provider is enabled only after a test of its configuration as it is now passes. The test reads an OpenID provider's discovery document and builds the sign-in as a real one starts; it makes no account, signs nobody in and proves no secret: the first real sign-in does."/>
                        <label type="p" style="text-caption m-muted" condition="editable &amp;&amp; !canGrant &amp;&amp; !provider.enabled"
                                text="An access administrator enables the provider once it is tested."/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
