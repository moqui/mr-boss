<!-- MailQueue (design-admin §9 MailQueue, §15.3; mr-moqui plans/archive/Admin-Screens-Down.md): the framework's System › Mail and
    protocols mail queue at this location, which BOSS_ADM_PROTOCOLS_OPS opens to the operations operator beside the
    integration administrator, with its two transitions: retryOutcome and settleOutcome, through
    org.moqui.admin.OperationServices, which check ADMIN_OPERATION_MANAGE and what each message's owner allows. A mail
    account's message links Comms' mail accounts by the mount's routes (Admin.js mountRoutes). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Mail queue" menu-image="sym_o_outbox" menu-image-type="icon">
    <parameter name="state"/>
    <parameter name="binding"/>
    <parameter name="emailServerId"/>
    <parameter name="fromDate"/>
    <parameter name="thruDate"/>
    <parameter name="pageIndex"/>

    <transition-include name="retryOutcome" location="component://tools/screen/System/Protocols/MailQueue.xml"/>
    <transition-include name="settleOutcome" location="component://tools/screen/System/Protocols/MailQueue.xml"/>

    <widgets>
        <include-screen location="component://tools/screen/System/Protocols/MailQueue.xml" share-scope="true"/>
    </widgets>
</screen>
