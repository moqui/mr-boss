<!-- MailQueue (design-admin §9 MailQueue, §15.3 "Unknown provider outcome"; style-guide §3.2 List; impl-admin P12): the send
    outcomes of the instance's stored mail, from the framework's org.moqui.admin.OperationServices.find#MailOutcomes, for
    reconciling a transport failure without opening anyone's mailbox. MailQueueFind narrows by state, binding (the
    instance's own mail or a mail account's), mail server and dates; there is no search of subjects, addresses or mailboxes.
    MailQueueList shows each message's id, time, server and template, the number of its recipients, the outcome, the error
    with every address struck out, its owner and the next step; never a subject, a body or an address, which the service
    does not return. A row's actions are what its owner allows: Send again for a message known not sent that is the mail
    service's own (the same stored message, never a new one); Settle for one that may have been sent, which records what
    a person found in the mail server's own log (reported delivered, or reported not delivered) with the reason, their name
    and the time, beside the message: it never marks the message sent (Sent is only what a send succeeded in), sends
    nothing, and takes the message out of Needs attention into Settled, where one reported not delivered may be sent again;
    or Close for a failed one. A mail account's
    message is its sender's, in Comms; a registered owner's (the delivery ledger's) is retried and reconciled by that owner.
    Reading needs ADMIN_OPERATION_VIEW (the integration administrator, with ADMIN_CONNECTION_VIEW alone, reads the mail the
    instance itself sent through its relays, never a mail account's) and an action ADMIN_OPERATION_MANAGE, checked by the
    services; every refusal comes back as a reason shown here. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Mail queue" menu-image="sym_o_outbox" menu-image-type="icon">
    <parameter name="state"/>
    <parameter name="binding"/>
    <parameter name="emailServerId"/>
    <parameter name="fromDate"/>
    <parameter name="thruDate"/>
    <parameter name="pageIndex"/>

    <transition name="retryOutcome">
        <actions>
            <!-- the list's filters come back as one value, so the page returns to the list as it was (a form's own field named
                state or binding would take the row's) -->
            <script><![CDATA[
                let filters = {}
                try { filters = JSON.parse(filterJson || '{}') } catch (error) { filters = {} }
                ec.context.putAll(Object.fromEntries(['state', 'binding', 'emailServerId', 'fromDate', 'thruDate', 'pageIndex']
                    .map(name => [name, filters[name] == null ? null : String(filters[name])])))
            ]]></script>
            <service-call name="org.moqui.admin.OperationServices.retry#MailOutcome" out-map="done"
                    in-map="{emailMessageId:emailMessageId, expectedRevision:expectedRevision, operationKey:operationKey}"/>
            <if condition="!ec.message.hasError()">
                <script>ec.message.addMessage(done.applied ? 'Sent' : done.reason, done.applied ? 'success' : 'warning')</script>
            </if>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="settleOutcome">
        <actions>
            <!-- the list's filters come back as one value, so the page returns to the list as it was (a form's own field named
                state or binding would take the row's) -->
            <script><![CDATA[
                let filters = {}
                try { filters = JSON.parse(filterJson || '{}') } catch (error) { filters = {} }
                ec.context.putAll(Object.fromEntries(['state', 'binding', 'emailServerId', 'fromDate', 'thruDate', 'pageIndex']
                    .map(name => [name, filters[name] == null ? null : String(filters[name])])))
            ]]></script>
            <service-call name="org.moqui.admin.OperationServices.reconcile#MailOutcome" out-map="done"
                    in-map="{emailMessageId:emailMessageId, resolution:resolution, reason:reason, expectedRevision:expectedRevision,
                        operationKey:operationKey}"/>
            <if condition="!ec.message.hasError()">
                <script>ec.message.addMessage(!done.applied ? done.reason : done.resolution === 'delivered'
                    ? 'Settled as reported delivered. The message is not marked sent.' : done.resolution === 'notDelivered'
                    ? 'Settled as reported not delivered. It can be sent again from the Settled list.' : 'Closed', done.applied ? 'success' : 'warning')</script>
            </if>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <service-call name="org.moqui.admin.OperationServices.find#MailOutcomes" out-map="found" transaction="force-new" ignore-error="true"
                in-map="{state:(state || null), binding:(binding || null), emailServerId:(emailServerId || null), fromDate:(fromDate || null),
                    thruDate:(thruDate || null), pageIndex:(pageIndex || 0), pageSize:50}"/>
        <!-- ignore-error clears a refusal's message -->
        <set field="available" from="!!found?.outcomeList"/>
        <script><![CDATA[
            ec.message.clearErrors()
            const colors = {retryable: 'warning', permanent: 'negative', bounced: 'negative', uncertain: 'deep-orange', settled: 'blue-grey', sending: 'info', sent: 'positive', cancelled: 'grey-7'}
            const relays = !!admin.capabilities.connectionView
            // a settlement is what a person reports, kept beside the message: neither marks it sent
            const settleOptions = [{value: 'delivered', label: 'Reported delivered (the mail server shows it went)'},
                {value: 'notDelivered', label: 'Reported not delivered (it may then be sent again)'}]
            const closeOptions = [{value: 'abandon', label: 'Close it: it is not to be sent'}]
            const templateOf = row => row.binding === 'account' ? '' : row.emailTemplateId
            outcomes = Array.from(found?.outcomeList || []).map(row => Object.assign({}, row, {
                stateColor: colors[row.state] || 'grey-7',
                timeText: row.outcomeDate ? ec.l10n.format(Date.parse(row.outcomeDate), 'yyyy-MM-dd HH:mm') : '',
                transportText: [row.emailServerId, templateOf(row)].filter(Boolean).join(' · ') || 'None',
                // the owner's own place: Comms for a mail account's message, the relay for the instance's own
                ownerUrl: row.ownerKind === 'mailAccount' ? '/qapps/Comms/Settings/MailAccounts'
                    : row.ownerKind === 'mailService' && row.emailServerId && relays
                        ? '/qapps/Admin/Protocols/MailRelayDetail?connectionKey=' + encodeURIComponent(row.emailServerId) : '',
                ownerText: row.ownerKind === 'mailAccount' ? 'Mail account, in Comms'
                    : [row.ownerTitle, row.ownerRef, row.ownerStateText].filter(Boolean).join(' · '),
                settledText: row.settlement ? [row.settledByName, row.settledDate ? ec.l10n.format(Date.parse(row.settledDate), 'yyyy-MM-dd HH:mm') : '',
                    row.settledReason].filter(Boolean).join(' · ') : '',
                resolutionOptions: (row.reconcileEligible ? settleOptions : []).concat(row.abandonEligible ? closeOptions : []),
                operationKey: (row.emailMessageId + '.' + row.revision).replace(/[^\w.-]/g, '_').slice(0, 56),
                dialogKey: String(row.emailMessageId).replace(/\W/g, '_')}))
            outcomesCount = Number(found?.outcomeCount || 0)
            outcomesPageIndex = Number(found?.pageIndex || 0)
            outcomesPageSize = Number(found?.pageSize || 50)
            outcomesPageMaxIndex = Math.max(Math.ceil(outcomesCount / outcomesPageSize) - 1, 0)
            outcomesPageRangeLow = outcomesCount ? outcomesPageIndex * outcomesPageSize + 1 : 0
            outcomesPageRangeHigh = Math.min((outcomesPageIndex + 1) * outcomesPageSize, outcomesCount)
            stateOptions = Array.from(found?.stateList || []).map(row => ({value: row.state, label: row.text}))
            unansweredText = Array.from(found?.unansweredOwnerList || []).join(', ')
            findValues = {state: state || 'attention', binding: binding, emailServerId: emailServerId, fromDate: fromDate, thruDate: thruDate}
            filterJson = JSON.stringify({state: state, binding: binding, emailServerId: emailServerId, fromDate: fromDate, thruDate: thruDate, pageIndex: pageIndex})
        ]]></script>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Mail queue" type="h5"/>
                <label text="What became of the mail this instance sent: what was not sent, what a server refused, and what may or may not have gone. Sent is only what a send succeeded in; what a person reported of an uncertain one is shown as Settled. A message's subject, text and addresses are not shown here."
                        type="p" style="text-caption m-muted q-mb-none"/>
            </container>
        </container>
        <label type="p" style="text-negative" condition="!available" text="The mail queue is not available to you."/>
        <section name="QueueSection" condition="available">
            <widgets>
                <form-single name="MailQueueFind" transition="." map="findValues">
                    <field name="state">
                        <default-field title="State"><drop-down><list-options list="stateOptions" key="${value}" text="${label}"/></drop-down></default-field>
                    </field>
                    <field name="binding">
                        <default-field title="Sent by">
                            <drop-down allow-empty="true">
                                <option key="instance" text="The instance"/><option key="account" text="A mail account"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="emailServerId"><default-field><hidden/></default-field></field>
                    <field name="fromDate"><default-field title="From" tooltip="Empty shows the last ${found.defaultDays} days"><date-time type="date"/></default-field></field>
                    <field name="thruDate"><default-field title="Before"><date-time type="date"/></default-field></field>
                    <field name="submitButton"><default-field title="Find"><submit/></default-field></field>
                    <field-layout>
                        <field-row-big>
                            <field-ref name="state"/><field-ref name="binding"/><field-ref name="fromDate"/><field-ref name="thruDate"/>
                            <field-ref name="submitButton"/>
                        </field-row-big>
                    </field-layout>
                </form-single>
                <section name="ServerFilter" condition="emailServerId">
                    <widgets>
                        <container style="q-mb-sm">
                            <label text="Sent through ${emailServerId}." style="q-mr-sm"/>
                            <link url="." text="Every server" link-type="anchor" parameter-map="{state:state, binding:binding, fromDate:fromDate, thruDate:thruDate, emailServerId:''}"/>
                        </container>
                    </widgets>
                </section>
                <label type="p" style="m-muted" condition="found.instanceOnly === true"
                        text="You see the mail the instance itself sent through its relays. A mail account's messages are its owner's."/>
                <label type="p" style="text-warning" condition="unansweredText"
                        text="An owner of mail could not be asked which messages are its own (${unansweredText}), so nothing is sent again from here until it answers."/>
                <label type="p" style="m-muted" condition="!outcomes.length" text="No message matches."/>
                <form-list name="MailQueueList" list="outcomes" skip-form="true" paginate="true">
                    <field name="emailMessageId"><default-field title="Message"><display/></default-field></field>
                    <field name="timeText"><default-field title="Time"><display/></default-field></field>
                    <field name="transportText">
                        <default-field title="Server and template">
                            <link url="." text="${transportText}" link-type="anchor" condition="emailServerId"
                                    parameter-map="{emailServerId:emailServerId, state:(ec.web.parameters.state || ''), binding:(ec.web.parameters.binding || '')}"/>
                            <label text="${transportText}" condition="!emailServerId"/>
                        </default-field>
                    </field>
                    <field name="recipientCount"><default-field title="Recipients" align="right"><display/></default-field></field>
                    <field name="stateText">
                        <default-field title="Outcome">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${stateText}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateText})}]]></text>
                                <text type="html">${stateText}</text>
                            </render-mode>
                        </default-field>
                    </field>
                    <field name="errorText"><default-field title="What the server said"><display/></default-field></field>
                    <field name="settledText"><default-field title="Settled by"><display/></default-field></field>
                    <field name="owner">
                        <default-field title="Owner">
                            <link url="${ownerUrl}" url-type="plain" text="${ownerText}" link-type="anchor" condition="ownerUrl"/>
                            <label text="${ownerText}" condition="!ownerUrl"/>
                        </default-field>
                    </field>
                    <field name="nextStep"><default-field title="Next step"><display/></default-field></field>
                    <field name="actions">
                        <default-field title="">
                            <link url="retryOutcome" text="Send again" icon="sym_o_send" link-type="hidden-form-link" condition="retryEligible"
                                    confirmation="Send message ${emailMessageId} again to its ${recipientCount} ${recipientCount === 1 ? 'recipient' : 'recipients'}? The same message goes out; no new one is made."
                                    parameter-map="{emailMessageId:emailMessageId, expectedRevision:revision, operationKey:'retry.' + operationKey, filterJson:filterJson}"/>
                            <container-dialog id="Settle_${dialogKey}" button-text="${reconcileEligible ? 'Settle' : 'Close'}" icon="sym_o_rule" width="560"
                                    title="${reconcileEligible ? 'Settle' : 'Close'} message ${emailMessageId}" condition="resolutionOptions.length">
                                <label type="p" condition="reconcileEligible"
                                        text="This message may or may not have been sent. Look in the mail server's own log for it, then record what you found. The record is kept beside the message with your name, the time and the reason. It does not mark the message sent, and nothing is sent by this."/>
                                <label type="p" condition="!reconcileEligible" text="A closed message is not offered again and is not sent. Nothing is sent by this."/>
                                <form-single name="SettleOutcome" transition="settleOutcome"
                                        map="{emailMessageId:emailMessageId, expectedRevision:revision, operationKey:'settle.' + operationKey, filterJson:filterJson}">
                                    <field name="emailMessageId"><default-field><hidden/></default-field></field>
                                    <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                    <field name="operationKey"><default-field><hidden/></default-field></field>
                                    <field name="filterJson"><default-field><hidden/></default-field></field>
                                    <field name="resolution">
                                        <default-field title="What was found">
                                            <drop-down><list-options list="resolutionOptions" key="${value}" text="${label}"/></drop-down>
                                        </default-field>
                                    </field>
                                    <field name="reason"><default-field title="Reason" tooltip="Kept with the record and in the audit log"><text-line size="50"/></default-field></field>
                                    <field name="submitButton"><default-field title="Record"><submit/></default-field></field>
                                </form-single>
                            </container-dialog>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column><field-ref name="emailMessageId"/><field-ref name="transportText"/><field-ref name="nextStep"/></column>
                        <column><field-ref name="stateText"/><field-ref name="settledText"/><field-ref name="actions"/></column>
                    </columns>
                </form-list>
            </widgets>
        </section>
    </widgets>
</screen>
