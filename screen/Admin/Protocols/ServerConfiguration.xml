<!-- ServerConfiguration (design-admin §9 ServerConfiguration; mr-moqui plans/Admin-Screens-Down.md): the framework's
    System › Mail and protocols server configuration at this location (BOSS_ADM_PROTOCOLS_OPS), with its one transition:
    runCheck, through org.moqui.admin.ConfigurationServices.test#Protocol, which checks ADMIN_CONNECTION_MANAGE. The
    readiness and support summary (Operations › SupportSummary, P19) is linked by the mount's routes (Admin.js
    mountRoutes), for a reader of the overview. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Server configuration" menu-image="sym_o_dns" menu-image-type="icon">
    <parameter name="protocolKey"/>

    <transition-include name="runCheck" location="component://tools/screen/System/Protocols/ServerConfiguration.xml"/>

    <widgets>
        <include-screen location="component://tools/screen/System/Protocols/ServerConfiguration.xml" share-scope="true"/>
    </widgets>
</screen>
