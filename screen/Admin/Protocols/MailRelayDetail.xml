<!-- MailRelayDetail (design-admin §9 MailRelayDetail, §8.1; style-guide §3.3 Detail; impl-admin P11): one outgoing mail
    relay, an EmailServer no mail account owns. RelayConfiguration is its SMTP host, port, TLS and sign-in, the password
    entered and never shown; a change of the host, the port, TLS or the user needs the password entered again, else the stored
    one is cleared, and either way the relay sends nothing until RelayTest passes against the new host, which enables it.
    RelayTest connects and signs in (the framework's test#EmailServer) and, when asked, sends one fixed message to the
    administrator's own address. RelayConsumers lists the email templates sent through it. The server of a mail account never
    opens here: the service answers it as not available on every path. The same record, forms and transitions as
    ConnectionDetail (template/AdminConnectionParts.xml), for the kind relay alone. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Mail relay" default-menu-include="false">
    <parameter name="connectionKey" required="true"/>

    <transition-include name="storeConnection" location="component://mr-boss/template/AdminConnectionParts.xml"/>
    <transition-include name="testConnection" location="component://mr-boss/template/AdminConnectionParts.xml"/>
    <transition-include name="setEnabled" location="component://mr-boss/template/AdminConnectionParts.xml"/>

    <!-- this screen is the relay kind's alone, whatever a request names -->
    <always-actions><set field="adapterKey" value="relay"/></always-actions>
    <actions>
        <set field="kindTitle" value="Mail relay"/>
        <set field="listPath" value="../MailRelays"/>
        <set field="listTitle" value="Mail relays"/>
        <set field="detailPath" value="../../Integrations/ConnectionDetail"/>
    </actions>
    <widgets>
        <section-include name="ConnectionPrepare" location="component://mr-boss/template/AdminConnectionParts.xml"/>
        <section-include name="ConnectionUnavailable" location="component://mr-boss/template/AdminConnectionParts.xml"/>
        <section-include name="ConnectionHeader" location="component://mr-boss/template/AdminConnectionParts.xml"/>
        <section-include name="NativeConnectionBox" location="component://mr-boss/template/AdminConnectionParts.xml"/>
        <section-include name="ConnectionChecksBox" location="component://mr-boss/template/AdminConnectionParts.xml"/>
        <section-include name="ConnectionConsumersBox" location="component://mr-boss/template/AdminConnectionParts.xml"/>
    </widgets>
</screen>
