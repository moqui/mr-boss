<!-- MailRelays (design-admin §9 MailRelays, §8.1; style-guide §3.2 List; impl-admin P11): the outgoing mail servers of the
    instance, an EmailServer no mail account owns (SYSTEM and the relays registered here), listed by
    org.moqui.admin.ConfigurationServices.find#Connections for the mail kinds. The server of a personal, hosted or shared mail
    account belongs to that account, carries its password and token, and is never listed, opened, tested or changed here.
    RelayList shows each relay's host, transport and state; NewRelay starts one, saved disabled, and opens its detail. Reading
    needs ADMIN_CONNECTION_VIEW and starting one ADMIN_CONNECTION_MANAGE, checked by the services. No password is shown or
    listed. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Mail relays" menu-image="sym_o_outgoing_mail" menu-image-type="icon">
    <parameter name="text"/>

    <transition name="createRelay">
        <actions>
            <service-call name="org.moqui.admin.ConfigurationServices.store#Connection" out-map="stored"
                    in-map="{adapterKey:'relay', values:{connectionId:(newRelayId || ''), smtpHost:(newSmtpHost || ''), smtpPort:(newSmtpPort || ''),
                        smtpSsl:(newTlsMode === 'ssl' ? 'Y' : 'N'), smtpStartTls:(newTlsMode === 'starttls' ? 'Y' : 'N')}}"/>
            <if condition="!ec.message.hasError()">
                <script>ec.message.addMessage(stored.applied ? 'Relay started. It sends nothing until its sign-in is entered and a test of it passes.' : stored.reason,
                    stored.applied ? 'success' : 'warning')</script>
                <set field="connectionKey" from="stored.applied ? stored.connectionKey : null"/>
            </if>
        </actions>
        <conditional-response url="../MailRelayDetail"><condition><expression>!!connectionKey</expression></condition>
            <parameter name="connectionKey"/></conditional-response>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <service-call name="org.moqui.admin.ConfigurationServices.find#Connections" out-map="found" transaction="force-new" ignore-error="true"
                in-map="{adapterGroup:'mail', text:(text || null), pageSize:100}"/>
        <!-- ignore-error clears a refusal's message -->
        <set field="available" from="!!found?.connectionList"/>
        <set field="relays" from="(found?.connectionList || []).map(row =&gt; Object.assign({}, row, {
                stateColor: row.state === 'ready' ? 'positive' : ['untested', 'needsTest', 'incomplete'].includes(row.state) ? 'warning' : 'grey-7',
                checkText: !row.lastCheckDate ? 'Not tested' : ec.l10n.format(Date.parse(row.lastCheckDate), 'yyyy-MM-dd HH:mm') + (row.lastCheckPassed ? ', passed' : ', did not pass')}))"/>
        <set field="findValues" from="{text:text}"/>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Mail relays" type="h5"/>
                <label text="The servers this instance sends its own mail through: notices, templates and what an app sends for an organization. A person's or a team's mail account has its own server, set up in that account."
                        type="p" style="text-caption m-muted q-mb-none"/>
            </container>
            <container style="col-auto">
                <section name="NewRelaySection" condition="found?.canManage">
                    <widgets>
                        <container-dialog id="NewRelay" button-text="New relay" type="primary" icon="sym_o_add" title="Start a mail relay">
                            <form-single name="NewRelay" transition="createRelay">
                                <field name="newRelayId">
                                    <default-field title="Id" tooltip="Letters, digits and underscores, starting with a letter; email templates name it">
                                        <text-line size="30"/>
                                    </default-field>
                                </field>
                                <field name="newSmtpHost"><default-field title="SMTP host"><text-line size="40"/></default-field></field>
                                <field name="newSmtpPort"><default-field title="Port" tooltip="465 for TLS from the start, 587 for STARTTLS"><text-line size="6"/></default-field></field>
                                <field name="newTlsMode">
                                    <default-field title="TLS">
                                        <drop-down>
                                            <option key="ssl" text="TLS from the start"/><option key="starttls" text="STARTTLS"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="submitButton"><default-field title="Start relay"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </widgets>
                </section>
            </container>
        </container>
        <label type="p" style="text-negative" condition="!available" text="Mail relays are not available to you."/>
        <section name="RelaySection" condition="available">
            <widgets>
                <form-single name="RelayFind" transition="." map="findValues">
                    <field name="text"><default-field title="Relay"><text-line size="30"/></default-field></field>
                    <field name="submitButton"><default-field title="Find"><submit/></default-field></field>
                    <field-layout><field-row-big><field-ref name="text"/><field-ref name="submitButton"/></field-row-big></field-layout>
                </form-single>
                <label type="p" style="m-muted" condition="!relays.length" text="No relay matches."/>
                <form-list name="RelayList" list="relays" skip-form="true" paginate="false">
                    <field name="name">
                        <default-field title="Relay">
                            <link url="../MailRelayDetail" text="${name}" link-type="anchor" parameter-map="{connectionKey:connectionKey}"/>
                        </default-field>
                    </field>
                    <field name="endpointSummary"><default-field title="Host and transport"><display text="${endpointSummary || 'Not set'}"/></default-field></field>
                    <field name="checkText"><default-field title="Last test"><display/></default-field></field>
                    <field name="stateText">
                        <default-field title="State">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${stateText}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateText})}]]></text>
                                <text type="html">${stateText}</text>
                            </render-mode>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column><field-ref name="name"/><field-ref name="endpointSummary"/></column>
                        <column><field-ref name="stateText"/></column>
                    </columns>
                </form-list>
            </widgets>
        </section>
    </widgets>
</screen>
