<!-- ProtocolsHome (design-admin §9 ProtocolsHome, §15.3 "Protocol readiness"; style-guide §3.1 Landing; impl-admin P12): what
    each protocol of the server is doing, from the framework's org.moqui.admin.ConfigurationServices.get#ProtocolReadiness: a
    protocol this build leaves out, one the conf keeps off, one that did not start, one that runs without its trust and one
    that is ready read apart, each with the reason the server gives, where it listens and the link to its owner. Nothing is
    configured here: outgoing mail is MailRelays', its send outcomes MailQueue's, the configuration the protocols run with and
    their checks ServerConfiguration's; a person's or a team's mail accounts and text blocks are Comms', and the phone system
    is Voice's (BasicComms' System › Voice, linked when the viewer opens it, from the settings index). TransportHealth is
    the Transport checks of ironstone.admin.RegistryServices.get#Readiness the viewer may read (the same providers Health
    shows). A protocol that is not built is never shown as something that works. Reading needs ADMIN_CONNECTION_VIEW,
    ADMIN_SETTINGS_VIEW or ADMIN_OPERATION_VIEW, checked by the service. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Protocols" menu-image="sym_o_lan" menu-image-type="icon">

    <actions>
        <service-call name="org.moqui.admin.ConfigurationServices.get#ProtocolReadiness" out-map="found" transaction="force-new" ignore-error="true"/>
        <!-- ignore-error clears a refusal's message -->
        <set field="available" from="!!found?.protocolList"/>
        <service-call name="ironstone.admin.RegistryServices.get#Readiness" out-map="health" transaction="force-new" ignore-error="true"
                in-map="{healthGroupEnumId:'AdmHgTransport'}"/>
        <service-call name="ironstone.admin.RegistryServices.find#Settings" out-map="index" transaction="force-new" ignore-error="true"
                in-map="{ownerApp:'Voice'}"/>
        <script><![CDATA[
            ec.message.clearErrors()
            const colors = {ready: 'positive', failing: 'negative', untrusted: 'warning', notStarted: 'info', disabled: 'grey-7', absent: 'grey-6'}
            const voice = Array.from(index?.entries || []).find(entry => entry.settingsKey === 'voice.system')
            // the owner a protocol's row links: a screen of this area, Comms' own settings, or Voice when the viewer opens it
            const owners = {
                mailRelays: {url: '/qapps/Admin/Protocols/MailRelays', text: 'Mail relays'},
                mailAccounts: {url: '/qapps/Comms/Settings/MailAccounts', text: 'Mail accounts in Comms'},
                voice: voice ? {url: voice.url, text: 'Voice'} : null
            }
            protocols = Array.from(found?.protocolList || []).map(row => Object.assign({}, row, {
                stateColor: colors[row.state] || 'grey-7',
                detailText: [row.reason, row.listener ? 'Listening on ' + row.listener : '', row.trustText || ''].filter(Boolean).join(' · '),
                // plain URLs: an owner may be another app
                ownerUrl: owners[row.ownerKey]?.url
                    || (row.settingGroup || row.checkList.length ? '/qapps/Admin/Protocols/ServerConfiguration?protocolKey=' + encodeURIComponent(row.protocolKey) : ''),
                ownerText: owners[row.ownerKey]?.text || (row.settingGroup || row.checkList.length ? 'Configuration and checks' : '')
            }))
            const count = states => protocols.filter(row => states.includes(row.state)).length
            counts = {ready: count(['ready']), attention: count(['failing', 'untrusted']), off: count(['disabled', 'notStarted']), absent: count(['absent'])}
            checkedText = found?.checkedDate ? ec.l10n.format(Date.parse(found.checkedDate), 'yyyy-MM-dd HH:mm') : ''
            transportChecks = Array.from(health?.checks || []).map(row => Object.assign({}, row, {
                stateColor: row.state === 'ready' ? 'positive' : row.state === 'warning' ? 'warning' : row.state === 'failed' ? 'negative' : 'grey-7'}))
            voiceUrl = voice?.url || ''
        ]]></script>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Mail and protocols" type="h5"/>
                <label text="What this server speaks besides the web: mail, calendars and files for other apps, SSH and Git, chat, calls and phones. Each is turned on in the deployment's configuration; this page says what each is doing. Checked ${checkedText}."
                        type="p" style="text-caption m-muted q-mb-none"/>
            </container>
            <container style="col-auto">
                <link url="../ServerConfiguration" text="Configuration and checks" link-type="anchor-button" btn-type="primary"
                        icon="sym_o_fact_check" condition="available"/>
            </container>
        </container>
        <label type="p" style="text-negative" condition="!available" text="The protocols are not available to you."/>
        <section name="ProtocolSection" condition="available">
            <widgets>
                <dashboard min-width="160">
                    <number-card title="Ready" value="${counts.ready}" icon="sym_o_check_circle" size="sm"/>
                    <number-card title="Failing or not trusted" value="${counts.attention}" icon="sym_o_error" size="sm"
                            link="../ServerConfiguration"/>
                    <number-card title="Off" value="${counts.off}" icon="sym_o_toggle_off" size="sm"/>
                    <number-card title="Not in this build" value="${counts.absent}" icon="sym_o_block" size="sm"/>
                </dashboard>
                <label type="p" style="m-muted q-mt-sm" condition="found.serverStarted !== true"
                        text="This process opened no listeners, so a protocol that is turned on is shown as configured, not as running."/>
                <container-box>
                    <box-header title="Protocols"/>
                    <box-toolbar>
                        <link url="../MailQueue" text="Mail queue" link-type="anchor-button" icon="sym_o_outbox"/>
                        <link url="/qapps/Comms/Settings/MailAccounts" url-type="plain" text="Mail accounts in Comms" link-type="anchor-button" icon="sym_o_alternate_email"
                                tooltip="A person's or a team's mail account, with its own server, is set up in that account"/>
                        <link url="/qapps/Comms/Settings/TextBlocks" url-type="plain" text="Text blocks in Comms" link-type="anchor-button" icon="sym_o_notes"
                                tooltip="The reusable texts of the mail a person writes"/>
                        <link url="${voiceUrl}" url-type="plain" text="Voice" link-type="anchor-button" icon="sym_o_call" condition="voiceUrl"
                                tooltip="Trunks, numbers, ring groups, menus and queues: the phone system's own screens"/>
                    </box-toolbar>
                    <box-body-nopad>
                        <form-list name="ProtocolReadiness" list="protocols" skip-form="true" paginate="false">
                            <field name="title"><default-field title="Protocol"><display/></default-field></field>
                            <field name="description"><default-field title="What it is"><display/></default-field></field>
                            <field name="stateText">
                                <default-field title="State">
                                    <render-mode>
                                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${stateText}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateText})}]]></text>
                                        <text type="html">${stateText}</text>
                                    </render-mode>
                                </default-field>
                            </field>
                            <field name="detailText"><default-field title="Why, and where"><display/></default-field></field>
                            <field name="source"><default-field title="Known from"><display/></default-field></field>
                            <field name="owner">
                                <default-field title="Opens">
                                    <link url="${ownerUrl}" url-type="plain" text="${ownerText}" link-type="anchor" condition="ownerUrl"/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="title"/><field-ref name="detailText"/></column>
                                <column><field-ref name="stateText"/><field-ref name="owner"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
        <section name="TransportHealthSection" condition="transportChecks.length">
            <widgets>
                <container-box>
                    <box-header title="Transport health"/>
                    <box-toolbar>
                        <link url="${sharedLinks['Operations/Health']}" text="Open Health" link-type="anchor-button" icon="sym_o_monitor_heart"
                                parameter-map="{healthGroupEnumId:'AdmHgTransport'}" condition="admin.capabilities.operations"/>
                    </box-toolbar>
                    <box-body-nopad>
                        <form-list name="TransportHealth" list="transportChecks" skip-form="true" paginate="false">
                            <field name="title"><default-field title="Check"><display/></default-field></field>
                            <field name="message"><default-field title="Finding"><display/></default-field></field>
                            <field name="state">
                                <default-field title="State">
                                    <render-mode>
                                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${state}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: state})}]]></text>
                                        <text type="html">${state}</text>
                                    </render-mode>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="title"/><field-ref name="message"/></column>
                                <column><field-ref name="state"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
