<!-- ProtocolsHome (design-admin §9 ProtocolsHome, §15.3 "Protocol readiness"; style-guide §3.1 Landing; impl-admin P12;
    mr-moqui plans/Admin-Screens-Down.md): the framework's System › Mail and protocols home, as Admin's own screen for what
    Admin adds around it. The protocols are read here from org.moqui.admin.ConfigurationServices.get#ProtocolReadiness; the
    display values, the heading and the protocol list are the System screen's (ProtocolsPrepare, ProtocolsHeader,
    ProtocolSection), whose rows link a mail account's and the phone system's own screens by the mount's routes: Comms' mail
    accounts (Admin.js mountRoutes) and Voice (BasicComms' System › Voice, from the settings index, set here when the
    viewer opens it). Admin adds: OwnerLinks, a person's or a team's mail accounts and text blocks in Comms and the phone
    system's own screens; TransportHealth, the Transport checks of org.moqui.admin.ReadinessServices.get#Readiness the
    viewer may read (the same providers Health shows). Nothing is configured here. Reading needs ADMIN_CONNECTION_VIEW,
    ADMIN_SETTINGS_VIEW or ADMIN_OPERATION_VIEW, checked by the service. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Protocols" menu-image="sym_o_lan" menu-image-type="icon">

    <actions>
        <service-call name="org.moqui.admin.ConfigurationServices.get#ProtocolReadiness" out-map="found" transaction="force-new" ignore-error="true"/>
        <set field="registry" from="ec.resource.script('component://mr-boss/template/AdminRegistry.js')"/>
        <set field="health" from="registry.readiness({healthGroupEnumId:'AdmHgTransport'}).out"/>
        <set field="index" from="registry.settings({ownerApp:'Voice'}).out"/>
        <script><![CDATA[
            ec.message.clearErrors()
            const voice = Array.from(index?.entries || []).find(entry => entry.settingsKey === 'voice.system')
            voiceUrl = voice?.url || ''
            // where the framework's protocol list links under Admin: the mount's routes, with the phone system's own screens
            // only when the viewer opens them (the settings index lists its entry to such a viewer alone)
            const standing = ec.resource.script('component://tools/template/AdminMount.js').state()
            if (!voiceUrl) delete standing.routes.voice
            mount = standing
            transportChecks = Array.from(health?.checks || []).map(row => Object.assign({}, row, {
                stateColor: row.state === 'ready' ? 'positive' : row.state === 'warning' ? 'warning' : row.state === 'failed' ? 'negative' : 'grey-7'}))
        ]]></script>
    </actions>
    <widgets>
        <section-include name="ProtocolsPrepare" location="component://tools/screen/System/Protocols/Home.xml"/>
        <section-include name="ProtocolsHeader" location="component://tools/screen/System/Protocols/Home.xml"/>
        <section name="OwnerLinks" condition="available">
            <widgets>
                <container style="q-mb-sm">
                    <link url="/qapps/Comms/Settings/MailAccounts" url-type="plain" text="Mail accounts in Comms" link-type="anchor-button" icon="sym_o_alternate_email"
                            tooltip="A person's or a team's mail account, with its own server, is set up in that account"/>
                    <link url="/qapps/Comms/Settings/TextBlocks" url-type="plain" text="Text blocks in Comms" link-type="anchor-button" icon="sym_o_notes"
                            tooltip="The reusable texts of the mail a person writes"/>
                    <link url="${voiceUrl}" url-type="plain" text="Voice" link-type="anchor-button" icon="sym_o_call" condition="voiceUrl"
                            tooltip="Trunks, numbers, ring groups, menus and queues: the phone system's own screens"/>
                </container>
            </widgets>
        </section>
        <section-include name="ProtocolSection" location="component://tools/screen/System/Protocols/Home.xml"/>
        <section name="TransportHealthSection" condition="transportChecks.length">
            <widgets>
                <container-box>
                    <box-header title="Transport health"/>
                    <box-toolbar>
                        <link url="${sharedLinks['Operations/Health']}" text="Open Health" link-type="anchor-button" icon="sym_o_monitor_heart"
                                parameter-map="{healthGroupEnumId:'AdmHgTransport'}" condition="admin.capabilities.operations"/>
                    </box-toolbar>
                    <box-body-nopad>
                        <form-list name="TransportHealth" list="transportChecks" skip-form="true" paginate="false">
                            <field name="title"><default-field title="Check"><display/></default-field></field>
                            <field name="message"><default-field title="Finding"><display/></default-field></field>
                            <field name="state">
                                <default-field title="State">
                                    <render-mode>
                                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${state}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: state})}]]></text>
                                        <text type="html">${state}</text>
                                    </render-mode>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="title"/><field-ref name="message"/></column>
                                <column><field-ref name="state"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
