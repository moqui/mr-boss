<!-- JobRuns (design-admin §10 JobRuns; style-guide §3.2 List; impl-admin P14): the outcomes of job runs, newest first, from the
    framework's org.moqui.admin.OperationServices.find#JobRuns. RunFind: job, state (all, failed, running or not ended, ended
    without an error) and a bounded range of dates (by default the last week, at most 92 days). RunList: each run with its job,
    its start in the machine's time zone, its duration, its state, the class of its failure with one masked line, and the
    numbers among its results; a run that ended without an error while its results count failed items is "ended with failed
    items", never a success. A run opens JobRunDetail. No message, result text or parameter is listed, and a job run carries no
    organization. Reading needs ADMIN_OPERATION_VIEW, checked by the service. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Job runs" menu-image="sym_o_history" menu-image-type="icon">
    <parameter name="jobName"/>
    <parameter name="state"/>
    <parameter name="fromDate"/>
    <parameter name="thruDate"/>
    <parameter name="pageIndex"/>

    <actions>
        <service-call name="org.moqui.admin.OperationServices.find#JobRuns" out-map="found" transaction="force-new" ignore-error="true"
                in-map="{jobName:(jobName || null), state:(state || null), fromDate:(fromDate || null), thruDate:(thruDate || null),
                    pageIndex:(pageIndex || 0), pageSize:50}"/>
        <!-- ignore-error clears a refusal's message -->
        <set field="available" from="!!found?.runList"/>
        <script><![CDATA[
            ec.message.clearErrors()
            const colors = {failed: 'negative', itemsFailed: 'deep-orange', stopped: 'deep-orange', running: 'info', waiting: 'info', succeeded: 'positive'}
            const duration = value => value == null ? '' : value < 1000 ? value + ' ms' : value < 120000 ? Math.round(value / 1000) + ' s' : Math.round(value / 60000) + ' min'
            runs = Array.from(found?.runList || []).map(row => Object.assign({}, row, {
                stateColor: colors[row.state] || 'grey-7',
                durationText: duration(row.durationMs),
                problemText: [row.errorClass, row.errorText].filter(Boolean).join(': '),
                countText: Array.from(row.countList || []).map(count => count.name + ' ' + count.value).join(' · ')}))
            runsCount = Number(found?.runCount || 0)
            runsPageIndex = Number(found?.pageIndex || 0)
            runsPageSize = Number(found?.pageSize || 50)
            runsPageMaxIndex = Math.max(Math.ceil(runsCount / runsPageSize) - 1, 0)
            runsPageRangeLow = runsCount ? runsPageIndex * runsPageSize + 1 : 0
            runsPageRangeHigh = Math.min((runsPageIndex + 1) * runsPageSize, runsCount)
            stateOptions = Array.from(found?.stateList || []).map(row => ({value: row.state, label: row.text}))
            findValues = {jobName: jobName, state: state || 'all', fromDate: fromDate, thruDate: thruDate}
        ]]></script>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Job runs" type="h5"/>
                <label text="What each run of a job came to. Times are in ${found?.timeZone || 'the server time zone'}. A run's messages, its results as text and its parameters are not listed here."
                        type="p" style="text-caption m-muted q-mb-none"/>
            </container>
            <container style="col-auto"><link url="../Jobs" text="Jobs" icon="sym_o_schedule"/></container>
        </container>
        <label type="p" style="text-negative" condition="!available" text="Job runs are not available to you."/>
        <section name="RunsSection" condition="available">
            <widgets>
                <form-single name="RunFind" transition="." map="findValues">
                    <field name="jobName"><default-field title="Job" tooltip="A job's whole name"><text-line size="36"/></default-field></field>
                    <field name="state">
                        <default-field title="State"><drop-down><list-options list="stateOptions" key="${value}" text="${label}"/></drop-down></default-field>
                    </field>
                    <field name="fromDate"><default-field title="From" tooltip="Empty shows the last ${found.defaultDays} days; at most ${found.rangeDays} days at a time"><date-time type="date"/></default-field></field>
                    <field name="thruDate"><default-field title="Before"><date-time type="date"/></default-field></field>
                    <field name="submitButton"><default-field title="Find"><submit/></default-field></field>
                    <field-layout>
                        <field-row-big><field-ref name="jobName"/><field-ref name="state"/><field-ref name="fromDate"/><field-ref name="thruDate"/><field-ref name="submitButton"/></field-row-big>
                    </field-layout>
                </form-single>
                <label type="p" style="m-muted" condition="!runs.length" text="No run matches."/>
                <form-list name="RunList" list="runs" skip-form="true" paginate="true">
                    <field name="jobRunId">
                        <default-field title="Run">
                            <link url="../JobRunDetail" text="${jobRunId}" link-type="anchor" parameter-map="{jobRunId:jobRunId}"/>
                        </default-field>
                    </field>
                    <field name="jobName">
                        <default-field title="Job">
                            <link url="../JobDetail" text="${jobName}" link-type="anchor" parameter-map="{jobName:jobName}"/>
                        </default-field>
                    </field>
                    <field name="startText"><default-field title="Started"><display/></default-field></field>
                    <field name="durationText"><default-field title="Took"><display/></default-field></field>
                    <field name="stateText">
                        <default-field title="State">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${stateText}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateText})}]]></text>
                                <text type="html">${stateText}</text>
                            </render-mode>
                        </default-field>
                    </field>
                    <field name="problemText"><default-field title="Failure"><display/></default-field></field>
                    <field name="countText"><default-field title="Result counts"><display/></default-field></field>
                    <columns type="mobile">
                        <column><field-ref name="jobRunId"/><field-ref name="jobName"/><field-ref name="startText"/></column>
                        <column><field-ref name="stateText"/><field-ref name="problemText"/></column>
                    </columns>
                </form-list>
            </widgets>
        </section>
    </widgets>
</screen>
