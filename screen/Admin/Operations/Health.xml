<!-- Health (design-admin §10 Health; style-guide §3.2 List; mr-moqui plans/archive/Admin-Screens-Down.md A6): the framework's System ›
    Operations › Health (the readiness checks the user may read, from every registered provider, over
    org.moqui.admin.ReadinessServices) with what is Admin's around its sections: the organization as a filter (ReadinessFind
    extended; choices), sent as the scope the providers of an organization or a store take, an organization the user does
    not administer refused first (check#Record); a fix link only where its place opens to the user's own groups
    (template/AdminRegistry.js); and requestRefresh, Admin's own, which refuses an organization outside the user's scope
    before the framework's request#Refresh runs the registered operation. For the reader, the operations operator and the
    administrator (BOSS_ADM_OPERATIONS). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Health" menu-image="sym_o_health_and_safety" menu-image-type="icon">
    <parameter name="organizationPartyId"/>
    <parameter name="healthGroupEnumId"/>
    <parameter name="state"/>
    <parameter name="ownerApp"/>
    <parameter name="providerKey"/>

    <transition name="choices" read-only="true">
        <actions>
            <service-call name="ironstone.admin.ContextServices.get#Choices" out-map="found"
                    in-map="{appRoot:appRoot, choice:choice, term:term, selected:selected}"/>
            <script>ec.web.sendJsonResponse(found.options)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition name="requestRefresh">
        <actions>
            <set field="refreshScope" from="ec.resource.script('component://tools/template/AdminReadiness.js').scopeOf(scopeJson)"/>
            <!-- an organization the refresh is for is one the user administers -->
            <if condition="refreshScope.organizationPartyId">
                <service-call name="ironstone.admin.ContextServices.check#Record"
                        in-map="{appRoot:appRoot, recordType:'organization', recordId:refreshScope.organizationPartyId}"/>
            </if>
            <if condition="!ec.message.hasError()">
                <service-call name="org.moqui.admin.ReadinessServices.request#Refresh" out-map="refreshed"
                        in-map="{refreshKey:refreshKey, scopeParameters:refreshScope, reason:(reason || null), operationKey:(operationKey || null)}"/>
            </if>
            <if condition="!ec.message.hasError()">
                <script>ec.message.addMessage(refreshed.message, refreshed.state === 'failed' ? 'warning' : 'success')</script>
            </if>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <set field="findValues" from="{organizationPartyId:organizationPartyId, healthGroupEnumId:healthGroupEnumId, state:state,
                ownerApp:ownerApp, providerKey:providerKey}"/>
        <set field="filtered" from="!!(organizationPartyId || healthGroupEnumId || state || ownerApp || providerKey)"/>
        <!-- an organization outside the user's scope is refused before any provider is asked (a refusal shown as its reason) -->
        <set field="scopeRefusal" from="organizationPartyId ? ec.resource.script('component://framework/service/org/moqui/admin/AdminCalls.js').read('ironstone.admin.ContextServices.check#Record', {appRoot:appRoot, recordType:'organization', recordId:organizationPartyId}, 'The checks are not available to you.').failure : null"/>
        <set field="health" from="scopeRefusal ? {checks: [], failure: scopeRefusal, failedText: '', checkedText: '', ownerOptions: [], groupOptions: []}
                : ec.resource.script('component://tools/template/AdminReadiness.js').health(findValues, organizationPartyId ? {organizationPartyId: organizationPartyId} : null)"/>
        <set field="checks" from="ec.resource.script('component://mr-boss/template/AdminRegistry.js').openFixes(health.checks)"/>
        <set field="failure" from="health.failure"/>
        <set field="failedText" from="health.failedText"/>
        <set field="checkedText" from="health.checkedText"/>
        <set field="ownerOptions" from="health.ownerOptions"/>
        <set field="groupOptions" from="health.groupOptions"/>
    </actions>
    <widgets>
        <section-include name="ReadinessHeader" location="component://tools/screen/System/Operations/Health.xml"/>
        <form-single name="ReadinessFind" extends="component://tools/screen/System/Operations/Health.xml#ReadinessFind" transition="."
                map="findValues">
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'organizations', selected:organizationPartyId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field-layout>
                <field-row-big>
                    <field-ref name="organizationPartyId"/>
                    <field-ref name="healthGroupEnumId"/>
                    <field-ref name="state"/>
                    <field-ref name="ownerApp"/>
                    <field-ref name="submitButton"/>
                </field-row-big>
            </field-layout>
        </form-single>
        <section-include name="ReadinessChecks" location="component://tools/screen/System/Operations/Health.xml"/>
    </widgets>
</screen>
