<!-- Health (design-admin §10 Health; style-guide §3.2 List): the readiness checks the user may read, from every registered
    provider (ironstone.admin.RegistryServices.get#Readiness: Admin's own checks, Accounting's setup, Products' catalog quality,
    Commerce's stores, the Constitution), narrowed by organization, group, state and owner (ReadinessFind). Each check (Readiness)
    shows its state, explanation, checked time, the freshness of a data source and the owner's fix link when the user opens it;
    Check again reads its provider again (nonmutating), and Request refresh runs the refresh operation registered for it
    (request#Refresh, its own permission). A provider that could not be checked is named; one the user may not read is left
    out, and nothing unavailable shows as ready. For the reader, the operations operator and the administrator
    (BOSS_ADM_OPERATIONS). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Health" menu-image="sym_o_health_and_safety" menu-image-type="icon">
    <parameter name="organizationPartyId"/>
    <parameter name="healthGroupEnumId"/>
    <parameter name="state"/>
    <parameter name="ownerApp"/>
    <parameter name="providerKey"/>

    <transition name="choices" read-only="true">
        <actions>
            <service-call name="ironstone.admin.ContextServices.get#Choices" out-map="found"
                    in-map="{appRoot:appRoot, choice:choice, term:term, selected:selected}"/>
            <script>ec.web.sendJsonResponse(found.options)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition name="requestRefresh">
        <actions>
            <service-call name="ironstone.admin.RegistryServices.request#Refresh" out-map="refreshed"
                    in-map="{refreshKey:refreshKey, organizationPartyId:(refreshOrganizationPartyId || null), reason:(reason || null),
                        operationKey:(operationKey || null)}"/>
            <if condition="!ec.message.hasError()">
                <script>ec.message.addMessage(refreshed.message, refreshed.state === 'failed' ? 'warning' : 'success')</script>
            </if>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <!-- a refusal is shown as its reason (AdminCalls.read; ignore-error would clear it, F129) -->
        <set field="called" from="ec.resource.script('component://mr-boss/service/ironstone/admin/AdminCalls.js').read('ironstone.admin.RegistryServices.get#Readiness', {organizationPartyId:(organizationPartyId || null), healthGroupEnumId:(healthGroupEnumId || null),
                    state:(state || null), ownerApp:(ownerApp || null), providerKey:(providerKey || null)}, 'The checks are not available to you.')"/>
        <set field="found" from="called.out"/>
        <set field="failure" from="called.failure"/>
        <set field="checks" from="found?.checks || []"/>
        <set field="failedText" from="(found?.failedProviders || []).join(', ')"/>
        <set field="checkedText" from="found?.checkedText || ''"/>
        <set field="filtered" from="!!(organizationPartyId || healthGroupEnumId || state || ownerApp || providerKey)"/>
        <set field="findValues" from="{organizationPartyId:organizationPartyId, healthGroupEnumId:healthGroupEnumId, state:state,
                ownerApp:ownerApp, providerKey:providerKey}"/>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Health" type="h5"/>
                <label text="Checked ${checkedText}" type="p" style="text-caption m-muted q-mb-none" condition="checkedText"/>
            </container>
            <container style="col-auto">
                <!-- P19: the readiness and support summary (design §16): print and redacted JSON -->
                <link url="../SupportSummary" text="Support summary" icon="sym_o_summarize" link-type="anchor-button"/>
            </container>
        </container>
        <form-single name="ReadinessFind" transition="." map="findValues">
            <field name="providerKey"><default-field><hidden/></default-field></field>
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'organizations', selected:organizationPartyId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="healthGroupEnumId">
                <default-field title="Area">
                    <drop-down allow-empty="true">
                        <entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration">
                                <econdition field-name="enumTypeId" value="AdminHealthGroup"/>
                                <order-by field-name="sequenceNum"/>
                            </entity-find>
                        </entity-options>
                    </drop-down>
                </default-field>
            </field>
            <field name="state">
                <default-field title="State">
                    <drop-down allow-empty="true">
                        <option key="failed" text="Failed"/><option key="unavailable" text="Unavailable"/>
                        <option key="warning" text="Warning"/><option key="ready" text="Ready"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="ownerApp">
                <default-field title="Owner">
                    <drop-down allow-empty="true">
                        <entity-options key="${ownerApp}" text="${ownerApp}">
                            <entity-find entity-name="ironstone.admin.ReadinessProvider" distinct="true">
                                <select-field field-name="ownerApp"/>
                                <order-by field-name="ownerApp"/>
                            </entity-find>
                        </entity-options>
                    </drop-down>
                </default-field>
            </field>
            <field name="submitButton"><default-field title="Find"><submit/></default-field></field>
            <field-layout>
                <field-row-big>
                    <field-ref name="organizationPartyId"/>
                    <field-ref name="healthGroupEnumId"/>
                    <field-ref name="state"/>
                    <field-ref name="ownerApp"/>
                    <field-ref name="submitButton"/>
                </field-row-big>
            </field-layout>
        </form-single>
        <label type="p" style="text-negative" condition="failure" text="${failure}"/>
        <label type="p" style="text-warning" condition="failedText" text="Could not be checked: ${failedText}"/>
        <container-box>
            <box-body-nopad>
                <form-list name="Readiness" list="checks" skip-form="true" paginate="false">
                    <field name="title">
                        <default-field title="Check">
                            <display text="${title}"/>
                        </default-field>
                    </field>
                    <field name="subject"><default-field title="For"><display/></default-field></field>
                    <field name="groupName"><default-field title="Area"><display/></default-field></field>
                    <field name="stateName">
                        <default-field title="Result">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${
                                    WebUtilities.encodeHtml(stateName)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateName})}]]></text>
                                <text type="html">${stateName}</text>
                            </render-mode>
                        </default-field>
                    </field>
                    <field name="message"><default-field title="Explanation"><display/></default-field></field>
                    <field name="freshnessText">
                        <default-field title="Freshness">
                            <display text="${watermarkText ? 'Last ' + watermarkText + (lagText ? ', ' + lagText + ' ago' : '') : ''}${expectedFrequencyText ? (watermarkText ? '; ' : '') + 'every ' + expectedFrequencyText : ''}"/>
                        </default-field>
                    </field>
                    <field name="checkedText"><default-field title="Checked"><display/></default-field></field>
                    <field name="actions">
                        <default-field title="">
                            <link url="${fixUrl}" url-type="plain" text="Fix" link-type="anchor-button" icon="sym_o_build" condition="fixUrl"/>
                            <link url="." text="Check again" link-type="anchor-button" icon="sym_o_refresh"
                                    parameter-map="{providerKey:providerKey, organizationPartyId:(organizationPartyId || null)}"/>
                            <container-dialog id="RequestRefresh_${providerKey}_${checkKey}_${organizationPartyId || 'all'}" button-text="Request refresh"
                                    icon="sym_o_sync" width="520" title="Request ${refreshTitle}" condition="refreshKey">
                                <label type="p" text="Runs ${refreshTitle} for ${subject}. The check shows the new state once it is done."/>
                                <form-single name="RequestRefreshForm" transition="requestRefresh"
                                        map="{refreshKey:refreshKey, refreshOrganizationPartyId:organizationPartyId, operationKey:'refresh-' + ec.user.randomString(24)}">
                                    <field name="refreshKey"><default-field><hidden/></default-field></field>
                                    <field name="refreshOrganizationPartyId"><default-field><hidden/></default-field></field>
                                    <field name="operationKey"><default-field><hidden/></default-field></field>
                                    <field name="reason"><default-field title="Reason"><text-line size="40"/></default-field></field>
                                    <field name="submitButton"><default-field title="Request refresh"><submit/></default-field></field>
                                </form-single>
                            </container-dialog>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column><field-ref name="title"/><field-ref name="subject"/><field-ref name="message"/></column>
                        <column><field-ref name="stateName"/><field-ref name="actions"/></column>
                    </columns>
                </form-list>
                <label type="p" style="q-pa-md m-muted" condition="!checks.length &amp;&amp; filtered" text="No check matches."/>
                <label type="p" style="q-pa-md m-muted" condition="!checks.length &amp;&amp; !filtered &amp;&amp; !failure"
                        text="No check is open to you. Each app's checks are shown to those who may read them."/>
            </box-body-nopad>
        </container-box>
    </widgets>
</screen>
