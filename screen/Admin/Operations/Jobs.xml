<!-- Jobs (design-admin §10 Jobs, §15.3 "Monitor reuse"; style-guide §3.2 List; impl-admin P14): the instance's scheduled
    jobs for the operations operator, from the framework's org.moqui.admin.OperationServices.find#Jobs. JobFind: state (all,
    failing or late, failing, late, paused, running), owner and a term. JobList: each job with its owner (or "Not
    registered": its owner's deployment, read only here), its schedule in words, its state, its next run in the machine's time
    zone (the zone a schedule is read in, named in the heading) and its last run; a job opens JobDetail and its runs JobRuns.
    Queued calls are counted, never listed. Failing jobs alert through the shipped alert template "Failing job runs"
    (report/admin-job-runs.json, on job-run telemetry), which runs once copied to an owner in Dashboards › Alerts: the link is
    shown only to a user Dashboards' own grant opens. A job run carries no organization, so there is no organization filter.
    Reading needs ADMIN_OPERATION_VIEW, checked by the service; the Operations area's other readers are told it is not
    available to them. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Jobs" menu-image="sym_o_schedule" menu-image-type="icon">
    <parameter name="state"/>
    <parameter name="ownerApp"/>
    <parameter name="term"/>
    <parameter name="pageIndex"/>

    <actions>
        <service-call name="org.moqui.admin.OperationServices.find#Jobs" out-map="found" transaction="force-new" ignore-error="true"
                in-map="{state:(state || null), ownerApp:(ownerApp || null), term:(term || null), pageIndex:(pageIndex || 0), pageSize:50}"/>
        <!-- ignore-error clears a refusal's message -->
        <set field="available" from="!!found?.jobList"/>
        <script>ec.message.clearErrors()</script>
        <service-call name="ironstone.admin.ContextServices.get#AppAccess" in-map="{appRoot:appRoot}" out-map="appAccess"/>
        <script><![CDATA[
            const colors = {failing: 'negative', late: 'deep-orange', invalid: 'negative', running: 'info', requested: 'info', due: 'info', scheduled: 'positive'}
            jobs = Array.from(found?.jobList || []).map(row => Object.assign({}, row, {
                stateColor: colors[row.state] || 'grey-7',
                nameText: row.title && row.title !== row.jobName ? row.title : (row.description || ''),
                lastText: [row.lastRunText, row.lastRunFailed ? 'failed' + (row.lastErrorClass ? ' (' + row.lastErrorClass + ')' : '') : ''].filter(Boolean).join(' · ')}))
            jobsCount = Number(found?.jobCount || 0)
            jobsPageIndex = Number(found?.pageIndex || 0)
            jobsPageSize = Number(found?.pageSize || 50)
            jobsPageMaxIndex = Math.max(Math.ceil(jobsCount / jobsPageSize) - 1, 0)
            jobsPageRangeLow = jobsCount ? jobsPageIndex * jobsPageSize + 1 : 0
            jobsPageRangeHigh = Math.min((jobsPageIndex + 1) * jobsPageSize, jobsCount)
            stateOptions = Array.from(found?.stateList || []).map(row => ({value: row.state, label: row.text}))
            ownerOptions = Array.from(found?.ownerList || []).map(name => ({value: name, label: name})).concat([{value: '_none', label: 'Not registered'}])
            findValues = {state: state || 'all', ownerApp: ownerApp, term: term}
            summaryText = available ? [found.failingCount + ' failing', found.lateCount + ' late', found.pausedCount + ' paused',
                found.queuedCallCount ? found.queuedCallCount + ' queued calls waiting' : ''].filter(Boolean).join(' · ') : ''
            alertsOpen = !!appAccess?.apps?.dashboards
        ]]></script>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Jobs" type="h5"/>
                <label text="The work this instance does on a schedule: what runs when, what is failing or late, and what is paused. Times are in ${found?.timeZone || 'the server time zone'}, the zone schedules are read in. A job its owner registered may be changed here; the others are their owner's deployment."
                        type="p" style="text-caption m-muted q-mb-none"/>
            </container>
            <container style="col-auto"><link url="../JobRuns" text="Job runs" icon="sym_o_history"/></container>
        </container>
        <label type="p" style="text-negative" condition="!available" text="Jobs are not available to you."/>
        <section name="JobsSection" condition="available">
            <widgets>
                <label type="p" text="${summaryText}"/>
                <container style="q-mb-sm">
                    <label style="m-muted" text="Failing jobs alert through the shipped alert template “Failing job runs”, once it is copied to an owner. "/>
                    <link url="/qapps/dashboards/Alerts" url-type="plain" text="Alerts" link-type="anchor" condition="alertsOpen"/>
                    <label style="m-muted" condition="!alertsOpen" text="Alerts are in Dashboards, which opens by its own grant."/>
                </container>
                <form-single name="JobFind" transition="." map="findValues">
                    <field name="state">
                        <default-field title="State"><drop-down><list-options list="stateOptions" key="${value}" text="${label}"/></drop-down></default-field>
                    </field>
                    <field name="ownerApp">
                        <default-field title="Owner"><drop-down allow-empty="true"><list-options list="ownerOptions" key="${value}" text="${label}"/></drop-down></default-field>
                    </field>
                    <field name="term"><default-field title="Name"><text-line size="24"/></default-field></field>
                    <field name="submitButton"><default-field title="Find"><submit/></default-field></field>
                    <field-layout>
                        <field-row-big><field-ref name="state"/><field-ref name="ownerApp"/><field-ref name="term"/><field-ref name="submitButton"/></field-row-big>
                    </field-layout>
                </form-single>
                <label type="p" style="m-muted" condition="!jobs.length" text="No job matches."/>
                <form-list name="JobList" list="jobs" skip-form="true" paginate="true">
                    <field name="jobName">
                        <default-field title="Job">
                            <link url="../JobDetail" text="${jobName}" link-type="anchor" parameter-map="{jobName:jobName}"/>
                            <label text="${nameText}" type="p" style="text-caption m-muted q-mb-none" condition="nameText"/>
                        </default-field>
                    </field>
                    <field name="ownerText"><default-field title="Owner"><display/></default-field></field>
                    <field name="scheduleText"><default-field title="Schedule"><display/></default-field></field>
                    <field name="stateText">
                        <default-field title="State">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${stateText}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateText})}]]></text>
                                <text type="html">${stateText}</text>
                            </render-mode>
                        </default-field>
                    </field>
                    <field name="nextRunText"><default-field title="Next run"><display/></default-field></field>
                    <field name="lastText">
                        <default-field title="Last run">
                            <link url="../JobRuns" text="${lastText || 'Runs'}" link-type="anchor" parameter-map="{jobName:jobName}"/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column><field-ref name="jobName"/><field-ref name="scheduleText"/></column>
                        <column><field-ref name="stateText"/><field-ref name="nextRunText"/></column>
                    </columns>
                </form-list>
            </widgets>
        </section>
    </widgets>
</screen>
