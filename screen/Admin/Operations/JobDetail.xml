<!-- JobDetail (design-admin §10 JobDetail, §14 "Operational recovery"; style-guide §3.3 Detail; impl-admin P14): one job, from
    the framework's org.moqui.admin.OperationServices.get#Job. JobExecution: a run outside the schedule, only where the job's
    owner registered one (execute#Recovery, targetKind ServiceJob), in a dialog that says what it does, with a reason and the
    revision read: the job is marked due and the scheduler starts it at its next pass, under the job's own lock and as the
    scheduler runs it, never as the person who asked and never beside a run under way; when it may not be asked for, why (a
    running job's lock is not cleared here). JobConfiguration: the schedule, pause, priority and wait after an error, each
    changed only where the owner registered it (store#Job), with the next run in the machine's time zone; the job's service,
    lock expiry and time limit are shown and never changed. JobParameters: the parameters the owner registered as safe, each
    an editable row with its type and bounds; the others by name. JobNotifications: who is told when a run ends: added by
    username, only an account that holds the permission the owner registered for recipients. Reading needs
    ADMIN_OPERATION_VIEW and a change ADMIN_OPERATION_MANAGE (and the owner's permission where it registered one), checked by
    the services; every refusal comes back as a reason shown here. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Job" default-menu-include="false">
    <parameter name="jobName" required="true"/>

    <transition name="saveJob">
        <actions>
            <service-call name="org.moqui.admin.OperationServices.store#Job" out-map="done"
                    in-map="{jobName:jobName, expectedRevision:expectedRevision, cronExpression:cronExpression, paused:paused, priority:priority,
                        minRetryTime:minRetryTime, parameterName:parameterName, parameterValue:(parameterName ? (parameterValue || '') : null),
                        recipientUsername:recipientUsername, recipientAction:recipientAction, reason:reason}"/>
            <if condition="!ec.message.hasError()">
                <script><![CDATA[
                    ec.message.addMessage(done.applied
                        ? (Array.from(done.changedList || []).length ? 'Saved. ' + (done.stateText || '') + (done.nextRunText ? '. Next run: ' + done.nextRunText : '') : 'Nothing changed')
                        : (done.reason || 'Not saved'), done.applied ? 'success' : 'warning')
                ]]></script>
            </if>
        </actions>
        <default-response url="."><parameter name="jobName"/></default-response>
        <error-response url="."><parameter name="jobName"/></error-response>
    </transition>
    <transition name="runJob">
        <actions>
            <service-call name="org.moqui.admin.OperationServices.execute#Recovery" out-map="done"
                    in-map="{targetKind:'ServiceJob', action:'retry', targetId:jobName, expectedRevision:expectedRevision, reason:reason,
                        operationKey:operationKey}"/>
            <if condition="!ec.message.hasError()">
                <script><![CDATA[
                    const result = Array.from(done.resultList || [])[0] || {}
                    ec.message.addMessage(done.applied ? (done.repeated ? 'Already asked for. ' : 'Asked for. ') + (result.stateText || '')
                        : (result.reason || done.reason || 'Not done'), done.applied ? 'success' : 'warning')
                ]]></script>
            </if>
        </actions>
        <default-response url="."><parameter name="jobName"/></default-response>
        <error-response url="."><parameter name="jobName"/></error-response>
    </transition>

    <actions>
        <service-call name="org.moqui.admin.OperationServices.get#Job" out-map="found" transaction="force-new" ignore-error="true"
                in-map="{jobName:jobName}"/>
        <!-- ignore-error clears a refusal's message -->
        <set field="recordFound" from="!!found?.job"/>
        <script><![CDATA[
            ec.message.clearErrors()
            const colors = {failing: 'negative', late: 'deep-orange', invalid: 'negative', running: 'info', requested: 'info', due: 'info', scheduled: 'positive'}
            job = found?.job || {}
            stateColor = colors[job.state] || 'grey-7'
            facts = recordFound ? [
                {label: 'Owner', value: job.ownerText},
                {label: 'What it does', value: job.purpose || job.description},
                {label: 'Service', value: job.serviceName ? job.serviceName + ' (its owner\u2019s: not changed here)' : ''},
                {label: 'Schedule', value: job.cronExpression ? job.scheduleText + ' (' + job.cronExpression + ', in ' + job.timeZone + ')' : 'None: started by its owner'},
                {label: 'Next run', value: job.nextRunText ? job.nextRunText + ' (' + job.timeZone + ')' : ''},
                {label: 'Last run', value: job.lastRunText ? job.lastRunText + (job.lastRunFailed ? ' · failed' + (job.lastErrorClass ? ' (' + job.lastErrorClass + ')' : '') : '') : ''},
                {label: 'Priority', value: job.priority == null ? '' : String(job.priority)},
                {label: 'Wait after an error', value: job.minRetryTime + ' minutes'},
                {label: 'Lock expiry', value: job.expireLockTime + ' minutes: only then, or when its server is gone, does the scheduler take over the lock of a run that never ended'},
                {label: 'Time limit', value: job.transactionTimeout ? job.transactionTimeout + ' seconds' : ''},
                {label: 'Notification topic', value: job.topic}
            ].filter(row => row.value) : []
            configurable = recordFound && (job.scheduleEditable || job.pauseEditable || job.priorityEditable || job.retryEditable)
            configValues = {jobName: job.jobName, expectedRevision: job.revision, cronExpression: job.cronExpression, paused: job.paused ? 'Y' : 'N',
                priority: job.priority, minRetryTime: job.minRetryTime}
            parameters = Array.from(found?.parameterList || []).map(row => Object.assign({}, row, {jobName: job.jobName, expectedRevision: job.revision,
                parameterValue: row.value, canEdit: row.editable && job.parametersEditable,
                optionChoices: (row.valueType === 'boolean' ? ['true', 'false'] : Array.from(row.optionList || [])).map(option => ({value: option, label: option}))}))
            recipients = Array.from(found?.recipientList || []).map(row => Object.assign({}, row, {jobName: job.jobName, expectedRevision: job.revision,
                recipientUsername: row.username,
                stateText: [row.receiveNotifications ? 'Notified' : 'Muted', row.open ? '' : 'cannot sign in', row.eligible ? '' : 'no longer holds the permission a recipient needs']
                    .filter(Boolean).join(' · ')}))
            recipientValues = {jobName: job.jobName, expectedRevision: job.revision, recipientAction: 'add'}
            const offered = Array.from(found?.actionList || [])
            const keyOf = name => (name + '.' + job.jobName + '.' + job.runRevision).replace(/[^\w.-]/g, '_').slice(0, 60)
            runActions = offered.filter(row => row.eligible).map(row => Object.assign({}, row, {
                values: {jobName: job.jobName, expectedRevision: job.runRevision, operationKey: keyOf(row.action)}}))
            refusedActions = offered.filter(row => !row.eligible)
        ]]></script>
    </actions>
    <widgets>
        <section name="JobUnavailable" condition="!recordFound">
            <widgets>
                <label type="p" style="text-negative" text="This job is not available to you, or there is no such job."/>
                <link url="../Jobs" text="Jobs" link-type="anchor"/>
            </widgets>
        </section>
        <section name="JobFound" condition="recordFound">
            <widgets>
                <container style="row items-center q-col-gutter-sm q-mb-sm">
                    <container style="col">
                        <label text="${job.title}" type="h5"/>
                        <label text="${job.jobName}" type="p" style="text-caption m-muted q-mb-none"/>
                    </container>
                    <container style="col-auto">
                        <render-mode>
                            <text type="qvt"><![CDATA[<q-chip square class="q-ma-none m-tonal text-${stateColor}">${job.stateText}</q-chip>]]></text>
                            <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: job.stateText})}]]></text>
                            <text type="html">${job.stateText}</text>
                        </render-mode>
                    </container>
                    <container style="col-auto">
                        <link url="../JobRuns" text="Runs" icon="sym_o_history" parameter-map="{jobName:jobName}"/>
                        <link url="../Jobs" text="Jobs" icon="sym_o_arrow_back"/>
                    </container>
                </container>

                <container-box>
                    <box-header title="Run"/>
                    <box-body>
                        <link url="../JobRunDetail" text="Running now: run ${job.activeJobRunId}" link-type="anchor" condition="job.activeJobRunId"
                                parameter-map="{jobRunId:job.activeJobRunId}"/>
                        <label type="p" style="m-muted" condition="found.registration?.idempotencyNote" text="${found.registration?.ownerApp}: ${found.registration?.idempotencyNote}"/>
                        <section-iterate name="JobExecutionActions" list="runActions" entry="offer">
                            <widgets>
                                <container-dialog id="Run_${offer.action}" button-text="${offer.label}" icon="sym_o_play_arrow" width="600"
                                        title="${offer.label}: ${job.jobName}">
                                    <label type="p" text="${offer.consequence}"/>
                                    <form-single name="JobExecution" transition="runJob" map="offer.values">
                                        <field name="jobName"><default-field><hidden/></default-field></field>
                                        <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                        <field name="operationKey"><default-field><hidden/></default-field></field>
                                        <field name="reason"><default-field title="Reason" tooltip="Kept in the audit log"><text-line size="50"/></default-field></field>
                                        <field name="submitButton"><default-field title="${offer.label}"><submit/></default-field></field>
                                    </form-single>
                                </container-dialog>
                            </widgets>
                        </section-iterate>
                        <section-iterate name="RefusedRunActions" list="refusedActions" entry="held">
                            <widgets><label type="p" style="text-caption m-muted q-mb-none" text="${held.label}: ${held.reason}"/></widgets>
                        </section-iterate>
                    </box-body>
                </container-box>

                <container-box>
                    <box-header title="Configuration"/>
                    <box-body>
                        <form-list name="JobFacts" list="facts" skip-form="true" paginate="false">
                            <field name="label"><default-field title=""><display/></default-field></field>
                            <field name="value"><default-field title=""><display/></default-field></field>
                        </form-list>
                        <label type="p" style="m-muted q-mt-sm" condition="job.readOnlyReason" text="${job.readOnlyReason}."/>
                        <section name="JobConfigurationSection" condition="configurable">
                            <widgets>
                                <form-single name="JobConfiguration" transition="saveJob" map="configValues">
                                        <field name="jobName"><default-field><hidden/></default-field></field>
                                        <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                    <field name="cronExpression">
                                        <conditional-field condition="job.scheduleEditable" title="Schedule"
                                                tooltip="A cron expression with seconds first, read in ${job.timeZone}; at most every ${job.minIntervalMinutes} minutes">
                                            <text-line size="24"/>
                                        </conditional-field>
                                        <default-field><ignored/></default-field>
                                    </field>
                                    <field name="paused">
                                        <conditional-field condition="job.pauseEditable" title="Paused">
                                            <drop-down><option key="N" text="No: it runs on its schedule"/><option key="Y" text="Yes: paused"/></drop-down>
                                        </conditional-field>
                                        <default-field><ignored/></default-field>
                                    </field>
                                    <field name="priority">
                                        <conditional-field condition="job.priorityEditable" title="Priority" tooltip="Lower runs first among the jobs that are due">
                                            <text-line size="4"/>
                                        </conditional-field>
                                        <default-field><ignored/></default-field>
                                    </field>
                                    <field name="minRetryTime">
                                        <conditional-field condition="job.retryEditable" title="Minutes to wait after an error"><text-line size="4"/></conditional-field>
                                        <default-field><ignored/></default-field>
                                    </field>
                                    <field name="reason"><default-field title="Reason" tooltip="Kept in the audit log"><text-line size="40"/></default-field></field>
                                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                                </form-single>
                            </widgets>
                        </section>
                    </box-body>
                </container-box>

                <container-box>
                    <box-header title="Parameters"/>
                    <box-body>
                        <label type="p" style="m-muted" condition="!parameters.length" text="It runs with its service's defaults."/>
                        <form-list name="JobParameters" list="parameters" transition="saveJob" paginate="false">
                                        <field name="jobName"><default-field><hidden/></default-field></field>
                                        <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                        <field name="parameterName"><default-field><hidden/></default-field></field>
                            <field name="title">
                                <default-field title="Parameter">
                                    <label text="${title}"/>
                                    <label text="${boundsText}" type="p" style="text-caption m-muted q-mb-none" condition="boundsText"/>
                                </default-field>
                            </field>
                            <field name="parameterValue">
                                <conditional-field condition="canEdit &amp;&amp; optionChoices.length" title="Value">
                                    <drop-down allow-empty="true"><list-options list="optionChoices" key="${value}" text="${label}"/></drop-down>
                                </conditional-field>
                                <conditional-field condition="canEdit" title="Value"><text-line size="20"/></conditional-field>
                                <default-field title="Value"><display text="${valueText}"/></default-field>
                            </field>
                            <field name="sourceText"><default-field title="Set by"><display/></default-field></field>
                            <field name="submitButton">
                                <conditional-field condition="canEdit" title="Save"><submit/></conditional-field>
                                <default-field title=""><display text=""/></default-field>
                            </field>
                        </form-list>
                    </box-body>
                </container-box>

                <container-box>
                    <box-header title="Notifications"/>
                    <box-toolbar>
                        <section name="AddRecipientSection" condition="job.recipientsEditable"><widgets>
                        <container-dialog id="AddRecipientDialog" button-text="Add a recipient" icon="sym_o_person_add" width="500">
                            <label type="p" text="A recipient is told when a run ends with an error, with the run's errors, parameters and results, so only an account that holds ${job.recipientPermission} may be one."/>
                            <form-single name="AddRecipient" transition="saveJob" map="recipientValues">
                                        <field name="jobName"><default-field><hidden/></default-field></field>
                                        <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                        <field name="recipientAction"><default-field><hidden/></default-field></field>
                                <field name="recipientUsername"><default-field title="Username"><text-line size="30"/></default-field></field>
                                <field name="reason"><default-field title="Reason"><text-line size="40"/></default-field></field>
                                <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                        </widgets></section>
                    </box-toolbar>
                    <box-body>
                        <label type="p" style="m-muted" condition="!recipients.length" text="Nobody is told when its runs end."/>
                        <label type="p" style="text-caption m-muted" condition="recipients.length"
                                text="A recipient receives a failed run's notification only with a setting of their own on the Service Job Error topic (Notification topics): its default is not to notify."/>
                        <label type="p" style="m-muted" condition="!job.recipientsEditable &amp;&amp; job.registered &amp;&amp; !job.recipientPermission"
                                text="Its owner registered nobody as its recipients here."/>
                        <form-list name="JobNotifications" list="recipients" skip-form="true" paginate="false">
                            <field name="name"><default-field title="User"><display text="${name} (${username})"/></default-field></field>
                            <field name="stateText"><default-field title="Notifications"><display/></default-field></field>
                            <field name="actions">
                                <default-field title="">
                                    <link url="saveJob" text="Mute" condition="job.recipientsEditable &amp;&amp; receiveNotifications"
                                            parameter-map="{jobName:jobName, expectedRevision:expectedRevision, recipientUsername:username, recipientAction:'mute'}"/>
                                    <link url="saveJob" text="Notify" condition="job.recipientsEditable &amp;&amp; !receiveNotifications"
                                            parameter-map="{jobName:jobName, expectedRevision:expectedRevision, recipientUsername:username, recipientAction:'add'}"/>
                                    <link url="saveJob" text="Remove" condition="job.recipientsEditable" confirmation="Remove ${name} from this job's recipients?"
                                            parameter-map="{jobName:jobName, expectedRevision:expectedRevision, recipientUsername:username, recipientAction:'remove'}"/>
                                </default-field>
                            </field>
                        </form-list>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
