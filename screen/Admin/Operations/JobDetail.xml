<!-- JobDetail (design-admin §10 JobDetail; mr-moqui plans/archive/Admin-Screens-Down.md): the framework's System › Operations job
    screen at this location, with the two transitions an operations operator uses: saveJob and runJob, each through
    org.moqui.admin.OperationServices, which check ADMIN_OPERATION_MANAGE and what the job's owner registered. The System
    screen's own parts for the instance administrator (any field, any parameter, a direct run) are not shown under a mount
    and their transitions are not taken in, so they do not exist on this route. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Job" default-menu-include="false">
    <parameter name="jobName" required="true"/>

    <transition-include name="saveJob" location="component://tools/screen/System/Operations/JobDetail.xml"/>
    <transition-include name="runJob" location="component://tools/screen/System/Operations/JobDetail.xml"/>

    <widgets>
        <include-screen location="component://tools/screen/System/Operations/JobDetail.xml" share-scope="true"/>
    </widgets>
</screen>
