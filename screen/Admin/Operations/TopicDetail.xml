<!-- TopicDetail (design-admin §10 TopicDetail; mr-moqui plans/Admin-Screens-Down.md): the framework's System › Operations
    notification topic at this location (BOSS_ADM_OPERATIONS_TOPICS), with its two transitions: saveDefaults for the
    configuration administrator (ADMIN_SETTINGS_MANAGE) and saveSubscription for the operations operator
    (ADMIN_OPERATION_MANAGE), each checked by its service. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Notification topic" default-menu-include="false">
    <parameter name="topic" required="true"/>

    <transition-include name="saveDefaults" location="component://tools/screen/System/Operations/TopicDetail.xml"/>
    <transition-include name="saveSubscription" location="component://tools/screen/System/Operations/TopicDetail.xml"/>

    <widgets>
        <include-screen location="component://tools/screen/System/Operations/TopicDetail.xml" share-scope="true"/>
    </widgets>
</screen>
