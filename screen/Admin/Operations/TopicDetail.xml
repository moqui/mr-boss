<!-- TopicDetail (design-admin §10 TopicDetail; style-guide §3.3 Detail; impl-admin P14): one notification topic, from the
    framework's org.moqui.admin.OperationServices.get#Topic. TopicDefaults: its delivery settings, of which only those its owner
    registered are changed, by the configuration administrator (store#TopicDefaults, ADMIN_SETTINGS_MANAGE); whether it is
    private, its templates, its approval services and its inbox are never changed here. TopicSubscriptions: the settings of the
    users of the topic's registered audience, by name, for the operations operator, who sets a user's in-app, email, push and
    digest choices by username (store#TopicSubscription, ADMIN_OPERATION_MANAGE): only for an account in the audience its owner
    registered, so nobody is subscribed to a private topic outside it; receiving every message of the topic is never set here,
    only ended. The settings of everyone else are each person's own and are counted. Every refusal comes back as a reason
    shown here. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Notification topic" default-menu-include="false">
    <parameter name="topic" required="true"/>

    <transition name="saveDefaults">
        <actions>
            <service-call name="org.moqui.admin.OperationServices.store#TopicDefaults" out-map="done"
                    in-map="{topic:topic, expectedRevision:expectedRevision, description:description, showAlert:showAlert, alertNoAutoHide:alertNoAutoHide,
                        persistOnSend:persistOnSend, receiveNotifications:receiveNotifications, emailNotifications:emailNotifications,
                        pushNotifications:pushNotifications, digestDefault:digestDefault, reason:reason}"/>
            <if condition="!ec.message.hasError()">
                <script>ec.message.addMessage(done.applied ? (Array.from(done.changedList || []).length ? 'Saved' : 'Nothing changed') : (done.reason || 'Not saved'), done.applied ? 'success' : 'warning')</script>
            </if>
        </actions>
        <default-response url="."><parameter name="topic"/></default-response>
        <error-response url="."><parameter name="topic"/></error-response>
    </transition>
    <transition name="saveSubscription">
        <actions>
            <service-call name="org.moqui.admin.OperationServices.store#TopicSubscription" out-map="done"
                    in-map="{topic:topic, username:username, expectedRevision:(expectedRevision || ''), receiveNotifications:receiveNotifications,
                        emailNotifications:emailNotifications, pushNotifications:pushNotifications, digest:digest,
                        endAllNotifications:(endAllNotifications === 'Y'), remove:(remove === 'Y'), reason:reason}"/>
            <if condition="!ec.message.hasError()">
                <script>ec.message.addMessage(done.applied ? (Array.from(done.changedList || []).length ? 'Saved' : 'Nothing changed') : (done.reason || 'Not saved'), done.applied ? 'success' : 'warning')</script>
            </if>
        </actions>
        <default-response url="."><parameter name="topic"/></default-response>
        <error-response url="."><parameter name="topic"/></error-response>
    </transition>

    <actions>
        <service-call name="org.moqui.admin.OperationServices.get#Topic" out-map="found" transaction="force-new" ignore-error="true"
                in-map="{topic:topic}"/>
        <!-- ignore-error clears a refusal's message -->
        <set field="recordFound" from="!!found?.topic"/>
        <script><![CDATA[
            ec.message.clearErrors()
            record = found?.topic || {}
            const fieldList = Array.from(found?.fieldList || [])
            editable = Object.fromEntries(fieldList.map(row => [row.field, row.editable === true]))
            anyEditable = fieldList.some(row => row.editable)
            settings = fieldList.map(row => ({title: row.title, valueText: row.valueText, editableText: row.editable ? 'Changed here' : 'Its owner\u2019s'}))
            defaultValues = Object.assign({topic: record.topic, expectedRevision: record.revision},
                Object.fromEntries(fieldList.map(row => [row.field, row.field === 'pushNotifications' ? (row.value || 'default') : row.value])))
            facts = recordFound ? [
                {label: 'Owner', value: record.ownerText},
                {label: 'Purpose', value: record.purpose},
                {label: 'Kind', value: [record.isPrivate ? 'Private: only those a notification is sent to receive it' : 'Open', record.inboxText,
                    record.actionable ? 'asks its recipients for a decision' : ''].filter(Boolean).join(' · ')},
                {label: 'Audience', value: record.audiencePermission ? 'Accounts that hold ' + record.audiencePermission : ''},
                {label: 'Users with a setting', value: String(record.subscriptionCount)},
                {label: 'Receive every message', value: record.allNotificationsCount ? record.allNotificationsCount + (found.allNotificationsOutsideCount
                    ? ', of whom ' + found.allNotificationsOutsideCount + ' outside its audience: an instance administrator reviews those in Tools' : '') : ''}
            ].filter(row => row.value) : []
            const choice = [{value: 'default', label: 'The topic\u2019s default'}, {value: 'Y', label: 'Yes'}, {value: 'N', label: 'No'}]
            choiceOptions = choice
            subscriptions = Array.from(found?.subscriptionList || []).map(row => Object.assign({}, row, {topic: record.topic, expectedRevision: row.revision,
                nameText: row.name + ' (' + row.username + ')' + (row.open ? '' : ' · cannot sign in'),
                choicesText: ['In app: ' + row.receiveText, 'Email: ' + row.emailText, 'Push: ' + row.pushText, 'Digest: ' + row.digestText].join(' · '),
                everyText: row.allNotifications ? 'Receives every message of the topic' : ''}))
            subscribable = recordFound && found.canManageSubscriptions && !record.subscriptionsReadOnlyReason
            subscribeValues = {topic: record.topic, expectedRevision: '', receiveNotifications: 'Y', emailNotifications: 'default', pushNotifications: 'default', digest: 'default'}
        ]]></script>
    </actions>
    <widgets>
        <section name="TopicUnavailable" condition="!recordFound">
            <widgets>
                <label type="p" style="text-negative" text="This topic is not available to you, or there is no such topic."/>
                <link url="../Topics" text="Notification topics" link-type="anchor"/>
            </widgets>
        </section>
        <section name="TopicFound" condition="recordFound">
            <widgets>
                <container style="row items-center q-col-gutter-sm q-mb-sm">
                    <container style="col">
                        <label text="${record.description}" type="h5"/>
                        <label text="${record.topic}" type="p" style="text-caption m-muted q-mb-none"/>
                    </container>
                    <container style="col-auto"><link url="../Topics" text="Topics" icon="sym_o_arrow_back"/></container>
                </container>

                <container-box>
                    <box-header title="Delivery defaults"/>
                    <box-body>
                        <form-list name="TopicFacts" list="facts" skip-form="true" paginate="false">
                            <field name="label"><default-field title=""><display/></default-field></field>
                            <field name="value"><default-field title=""><display/></default-field></field>
                        </form-list>
                        <label type="p" style="m-muted q-mt-sm" condition="record.defaultsReadOnlyReason" text="${record.defaultsReadOnlyReason}."/>
                        <section name="TopicDefaultsRead" condition="!anyEditable">
                            <widgets>
                                <form-list name="TopicSettings" list="settings" skip-form="true" paginate="false">
                                    <field name="title"><default-field title="Setting"><display/></default-field></field>
                                    <field name="valueText"><default-field title="Value"><display/></default-field></field>
                                </form-list>
                            </widgets>
                            <fail-widgets>
                                <label type="p" style="text-caption m-muted" text="What a person receives when they chose nothing themselves. Whether the topic is private, its wording and what a decision does are its owner's and are not changed here."/>
                                <form-single name="TopicDefaults" transition="saveDefaults" map="defaultValues">
                                        <field name="topic"><default-field><hidden/></default-field></field>
                                        <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                    <field name="description">
                                        <conditional-field condition="editable.description" title="Description"><text-line size="50"/></conditional-field>
                                        <default-field><ignored/></default-field>
                                    </field>
                                    <field name="showAlert">
                                        <conditional-field condition="editable.showAlert" title="Shown as an alert"><drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></conditional-field>
                                        <default-field><ignored/></default-field>
                                    </field>
                                    <field name="alertNoAutoHide">
                                        <conditional-field condition="editable.alertNoAutoHide" title="The alert stays until dismissed"><drop-down allow-empty="true"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></conditional-field>
                                        <default-field><ignored/></default-field>
                                    </field>
                                    <field name="persistOnSend">
                                        <conditional-field condition="editable.persistOnSend" title="Kept in the notification list"><drop-down><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></conditional-field>
                                        <default-field><ignored/></default-field>
                                    </field>
                                    <field name="receiveNotifications">
                                        <conditional-field condition="editable.receiveNotifications" title="In app, by default"><drop-down allow-empty="true"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></conditional-field>
                                        <default-field><ignored/></default-field>
                                    </field>
                                    <field name="emailNotifications">
                                        <conditional-field condition="editable.emailNotifications" title="By email, by default"><drop-down allow-empty="true"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></conditional-field>
                                        <default-field><ignored/></default-field>
                                    </field>
                                    <field name="pushNotifications">
                                        <conditional-field condition="editable.pushNotifications" title="By push, by default"><drop-down><option key="default" text="By its inbox"/><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></conditional-field>
                                        <default-field><ignored/></default-field>
                                    </field>
                                    <field name="digestDefault">
                                        <conditional-field condition="editable.digestDefault" title="In the daily digest, by default"><drop-down allow-empty="true"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></conditional-field>
                                        <default-field><ignored/></default-field>
                                    </field>
                                    <field name="reason"><default-field title="Reason" tooltip="Kept in the audit log"><text-line size="40"/></default-field></field>
                                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                                </form-single>
                                <form-list name="TopicSettingsOwned" list="settings" skip-form="true" paginate="false">
                                    <field name="title"><default-field title="Setting"><display/></default-field></field>
                                    <field name="valueText"><default-field title="Value"><display/></default-field></field>
                                    <field name="editableText"><default-field title=""><display/></default-field></field>
                                </form-list>
                            </fail-widgets>
                        </section>
                    </box-body>
                </container-box>

                <container-box>
                    <box-header title="Subscriptions"/>
                    <box-toolbar>
                        <section name="SubscribeSection" condition="subscribable"><widgets>
                        <container-dialog id="SubscribeDialog" button-text="Set a user's subscription" icon="sym_o_person_add" width="520">
                            <label type="p" text="Only an account that signs in and holds ${record.audiencePermission}, this topic's audience, is given a subscription here. Receiving every message of the topic is not set here."/>
                            <form-single name="TopicSubscribe" transition="saveSubscription" map="subscribeValues">
                                        <field name="topic"><default-field><hidden/></default-field></field>
                                        <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                <field name="username"><default-field title="Username"><text-line size="30"/></default-field></field>
                                <field name="receiveNotifications"><default-field title="In app"><drop-down><list-options list="choiceOptions" key="${value}" text="${label}"/></drop-down></default-field></field>
                                <field name="emailNotifications"><default-field title="Email"><drop-down><list-options list="choiceOptions" key="${value}" text="${label}"/></drop-down></default-field></field>
                                <field name="pushNotifications"><default-field title="Push"><drop-down><list-options list="choiceOptions" key="${value}" text="${label}"/></drop-down></default-field></field>
                                <field name="digest"><default-field title="Daily digest"><drop-down><list-options list="choiceOptions" key="${value}" text="${label}"/></drop-down></default-field></field>
                                <field name="reason"><default-field title="Reason"><text-line size="40"/></default-field></field>
                                <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                        </widgets></section>
                    </box-toolbar>
                    <box-body>
                        <label type="p" style="m-muted" condition="record.subscriptionsReadOnlyReason" text="${record.subscriptionsReadOnlyReason}."/>
                        <label type="p" style="m-muted" condition="found.otherSubscriptionCount"
                                text="${found.otherSubscriptionCount} ${found.otherSubscriptionCount === 1 ? 'setting is a person\'s own choice, or of a user' : 'settings are people\'s own choices, or of users'} outside what is listed here."/>
                        <form-list name="TopicSubscriptions" list="subscriptions" transition="saveSubscription" paginate="false">
                                        <field name="topic"><default-field><hidden/></default-field></field>
                                        <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                        <field name="username"><default-field><hidden/></default-field></field>
                            <field name="nameText"><default-field title="User"><display/></default-field></field>
                            <field name="receiveNotifications">
                                <conditional-field condition="subscribable" title="In app"><drop-down><list-options list="choiceOptions" key="${value}" text="${label}"/></drop-down></conditional-field>
                                <default-field title="In app"><display text="${receiveText}"/></default-field>
                            </field>
                            <field name="emailNotifications">
                                <conditional-field condition="subscribable" title="Email"><drop-down><list-options list="choiceOptions" key="${value}" text="${label}"/></drop-down></conditional-field>
                                <default-field title="Email"><display text="${emailText}"/></default-field>
                            </field>
                            <field name="digest">
                                <conditional-field condition="subscribable" title="Digest"><drop-down><list-options list="choiceOptions" key="${value}" text="${label}"/></drop-down></conditional-field>
                                <default-field title="Digest"><display text="${digestText}"/></default-field>
                            </field>
                            <field name="everyText">
                                <default-field title="Every message">
                                    <label text="${everyText}"/>
                                    <link url="saveSubscription" text="End" condition="subscribable &amp;&amp; allNotifications"
                                            confirmation="${name} then receives only what is sent to them. End receiving every message of this topic?"
                                            parameter-map="{topic:topic, username:username, expectedRevision:expectedRevision, endAllNotifications:'Y'}"/>
                                </default-field>
                            </field>
                            <field name="submitButton">
                                <conditional-field condition="subscribable" title="Save"><submit/></conditional-field>
                                <default-field title=""><display text=""/></default-field>
                            </field>
                            <field name="removeLink">
                                <default-field title="">
                                    <link url="saveSubscription" text="Remove" condition="subscribable" confirmation="Remove the setting of ${name}? The topic's defaults then apply."
                                            parameter-map="{topic:topic, username:username, expectedRevision:expectedRevision, remove:'Y'}"/>
                                </default-field>
                            </field>
                        </form-list>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
