<!-- Topics (design-admin §10 Topics; mr-moqui plans/archive/Admin-Screens-Down.md): the framework's System › Operations notification
    topics at this location, which BOSS_ADM_OPERATIONS_TOPICS opens to the configuration administrator beside the operations
    operator. Reading needs ADMIN_OPERATION_VIEW or ADMIN_SETTINGS_VIEW, checked by the service. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Notification topics" menu-image="sym_o_notifications" menu-image-type="icon">
    <parameter name="term"/>
    <parameter name="pageIndex"/>

    <widgets>
        <include-screen location="component://tools/screen/System/Operations/Topics.xml" share-scope="true"/>
    </widgets>
</screen>
