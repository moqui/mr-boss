<!-- GroupDetail (design-admin §5 GroupDetail; style-guide §3.3 Detail; mr-moqui plans/Admin-Screens-Down.md): one group, as
    Admin's own screen for what Admin adds to the framework's System › Access group screen: the organization scope of its
    members. The group is checked as an Admin record first (check#Record) and read with
    org.moqui.admin.AccessServices.get#Group; GroupMembers names only the users of the organizations the user administers
    (get#MemberScope: the others are counted, never named), a member is chosen among them (get#Choices) and each is
    checked as an Admin member record before the framework's store#Membership and end#Membership. The rest is the System
    screen's (GroupPrepare, GroupMissing, GroupHeader, GroupProfileBox, GroupCapabilitiesBox and GroupPreferencesBox, with
    AddMember and GroupMembers extended here), and grantItems, storeGroup, applyGrants and storePreference are taken in
    from it. The System screen's part for the instance administrator (the group's records changed directly) is not here:
    its transitions do not exist on this route; a group that is neither a registered bundle nor a custom group has the
    System screen's "Open in System" link in its header, to that page. Every change the framework refuses (an unregistered bundle, a sealed
    permission the user does not hold, a privileged group the user is not in, a stale revision, the last administration
    path) is shown as its reason, never written. For the access administrator and the administrator (BOSS_ADM_ACCESS). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Group" default-menu-include="false">
    <parameter name="userGroupId" required="true"/>
    <!-- a grant change to preview (GroupCapabilities): add or end a bundle, one of its permissions or one of its bindings -->
    <parameter name="grantAction"/>
    <parameter name="grantBundleGroupId"/>
    <parameter name="grantItem"/>

    <transition name="choices" read-only="true">
        <actions>
            <service-call name="ironstone.admin.ContextServices.get#Choices" out-map="found"
                    in-map="{appRoot:appRoot, choice:choice, term:term, selected:selected}"/>
            <script>ec.web.sendJsonResponse(found.options)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition-include name="grantItems" location="component://tools/screen/System/Access/GroupDetail.xml"/>
    <transition-include name="storeGroup" location="component://tools/screen/System/Access/GroupDetail.xml"/>
    <transition name="addMember">
        <actions>
            <service-call name="ironstone.admin.ContextServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'member', recordId:memberUserId, capability:'accessManage'}"/>
            <if condition="!ec.message.hasError()">
                <service-call name="org.moqui.admin.AccessServices.store#Membership" out-map="stored"
                        in-map="{userGroupId:userGroupId, userId:memberUserId, fromDate:(fromDate || null), thruDate:(thruDate || null),
                            reason:(reason || null)}"/>
            </if>
            <if condition="!ec.message.hasError()">
                <script>ec.message.addMessage(stored.applied ? 'Member added' : stored.reason, stored.applied ? 'success' : 'warning')</script>
            </if>
        </actions>
        <default-response url="."><parameter name="userGroupId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="endMember">
        <actions>
            <service-call name="ironstone.admin.ContextServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'member', recordId:memberUserId, capability:'accessManage'}"/>
            <if condition="!ec.message.hasError()">
                <service-call name="org.moqui.admin.AccessServices.end#Membership" out-map="ended"
                        in-map="{userGroupId:userGroupId, userId:memberUserId, fromDate:memberFromDate, expectedRevision:expectedRevision,
                            thruDate:(thruDate || null), reason:(reason || null)}"/>
            </if>
            <if condition="!ec.message.hasError()">
                <script>ec.message.addMessage(ended.applied ? 'Membership ended' : ended.reason, ended.applied ? 'success' : 'warning')</script>
            </if>
        </actions>
        <default-response url="."><parameter name="userGroupId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition-include name="applyGrants" location="component://tools/screen/System/Access/GroupDetail.xml"/>
    <transition-include name="storePreference" location="component://tools/screen/System/Access/GroupDetail.xml"/>

    <actions>
        <!-- a refusal is shown as its reason (AdminCalls.read; ignore-error would clear it, F129) -->
        <set field="called" from="ec.resource.script('component://framework/service/org/moqui/admin/AdminCalls.js').read('ironstone.admin.ContextServices.check#Record', {appRoot:appRoot, recordType:'group', recordId:userGroupId}, 'Group ' + userGroupId + ' is not available.')"/>
        <set field="record" from="called.out"/>
        <set field="failure" from="called.failure"/>
        <if condition="!failure">
            <set field="called" from="ec.resource.script('component://framework/service/org/moqui/admin/AdminCalls.js').read('org.moqui.admin.AccessServices.get#Group', {userGroupId:userGroupId, includeOptions:true}, 'Group ' + userGroupId + ' is not available.')"/>
            <set field="found" from="called.out"/>
            <set field="failure" from="called.failure"/>
        </if>
        <!-- the members named here: those of the organizations the user administers; GroupPrepare counts the others -->
        <if condition="found?.group &amp;&amp; (found.members || []).length">
            <service-call name="ironstone.admin.ContextServices.get#MemberScope" out-map="memberScope"
                    in-map="{appRoot:appRoot, userIds:found.members.map(row => row.userId)}"/>
        </if>
        <set field="memberScopeIds" from="memberScope?.inScopeUserIds || []"/>
    </actions>
    <widgets>
        <section-include name="GroupPrepare" location="component://tools/screen/System/Access/GroupDetail.xml"/>
        <section-include name="GroupMissing" location="component://tools/screen/System/Access/GroupDetail.xml"/>
        <section-include name="GroupHeader" location="component://tools/screen/System/Access/GroupDetail.xml"/>
        <section-include name="GroupProfileBox" location="component://tools/screen/System/Access/GroupDetail.xml"/>
        <section name="GroupMembersBox" condition="group">
            <widgets>
                <container-box>
                    <box-header title="Members"/>
                    <box-toolbar>
                        <container-dialog id="AddMemberDialog" button-text="Add member" icon="sym_o_person_add" width="560"
                                title="Add a member to ${group.description || userGroupId}" condition="canManage">
                            <label type="p" text="The member gets this group's permissions and app gates from the date given. Ending a membership keeps it on record."/>
                            <form-single name="AddMember" extends="component://tools/screen/System/Access/GroupDetail.xml#AddMember" transition="addMember"
                                    map="{userGroupId:userGroupId}">
                                <field name="memberUserId">
                                    <default-field title="User">
                                        <drop-down>
                                            <dynamic-options transition="choices" server-search="true" min-length="0"
                                                    parameter-map="{choice:'members'}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body-nopad>
                        <!-- the row's End dialog is repeated here: a form inside an extended form's field is the other screen's -->
                        <form-list name="GroupMembers" extends="component://tools/screen/System/Access/GroupDetail.xml#GroupMembers" list="members" skip-form="true"
                                paginate="true">
                            <field name="actions">
                                <default-field title="">
                                    <container-dialog id="EndMember_${userId}_${fromDate}" button-text="End" icon="sym_o_person_remove" width="520"
                                            title="End ${userFullName}'s membership" condition="canManage &amp;&amp; !ended">
                                        <label type="p" text="${userFullName} loses this group's permissions and app gates from the date given; the membership stays on record."/>
                                        <form-single name="EndMember" transition="endMember"
                                                map="{userGroupId:userGroupId, memberUserId:userId, memberFromDate:fromDate, expectedRevision:revision}">
                                            <field name="userGroupId"><default-field><hidden/></default-field></field>
                                            <field name="memberUserId"><default-field><hidden/></default-field></field>
                                            <field name="memberFromDate"><default-field><hidden/></default-field></field>
                                            <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                            <field name="thruDate"><default-field title="End on" tooltip="Empty ends it now"><date-time/></default-field></field>
                                            <field name="reason"><default-field title="Reason"><text-line size="50"/></default-field></field>
                                            <field name="submitButton"><default-field title="End membership"><submit type="danger"/></default-field></field>
                                        </form-single>
                                    </container-dialog>
                                </default-field>
                            </field>
                        </form-list>
                        <label type="p" style="q-pa-md m-muted" condition="!members.length" text="No members in the organizations you administer."/>
                        <label type="p" style="q-px-md q-pb-md m-muted" condition="outsideCount" text="${outsideCount} more current member(s) work for organizations you do not administer."/>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
        <section-include name="GroupCapabilitiesBox" location="component://tools/screen/System/Access/GroupDetail.xml"/>
        <section-include name="GroupPreferencesBox" location="component://tools/screen/System/Access/GroupDetail.xml"/>
    </widgets>
</screen>
