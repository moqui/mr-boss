<!-- RowRules (design-admin §5 RowRules; style-guide §3.9 Settings): the row rules in effect, read from the framework's
    org.moqui.admin.AccessServices.get#ScopeRules (ADMIN_ACCESS_VIEW). ScopeRules lists each filter set bound to a group's app
    gate (an EntityFilterSet on an ArtifactAuthz) with the records it narrows and where it comes from: a registered bundle, or
    deployed configuration. A registered app gate that lacks a row rule its bundle registers is listed first, and
    SupportedScopeBinding binds it through apply#Grants at the group's grant revision (ADMIN_ACCESS_MANAGE; registered filter
    sets only, added, never removed). A filter's expression, removing a row rule and raw entity rules stay Tools'. Insights'
    dataset row filters are separate (design-insights). For the access administrator and the administrator (BOSS_ADM_ACCESS). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Row rules" menu-image="sym_o_filter_alt" menu-image-type="icon">
    <parameter name="userGroupId"/>
    <parameter name="artifactGroupId"/>
    <parameter name="entityFilterSetId"/>
    <parameter name="state"/>
    <parameter name="pageIndex"/>

    <transition name="bindScope">
        <actions>
            <service-call name="org.moqui.admin.AccessServices.apply#Grants" out-map="applied"
                    in-map="{userGroupId:bindGroupId, expectedRevision:expectedRevision, reason:(reason || null),
                        grantList:[{action:'add', artifactGroupId:bindArtifactGroupId, entityFilterSetId:bindFilterSetId}]}"/>
            <if condition="!ec.message.hasError()">
                <script>ec.message.addMessage(applied.applied ? 'Row rule ' + bindFilterSetId + ' bound for ' + bindGroupId
                    : applied.reason, applied.applied ? 'success' : 'warning')</script>
            </if>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <set field="pageSize" from="50" type="Integer"/>
        <service-call name="org.moqui.admin.AccessServices.get#ScopeRules" out-map="found" transaction="force-new" ignore-error="true"
                in-map="{userGroupId:(userGroupId || null), artifactGroupId:(artifactGroupId || null),
                    entityFilterSetId:(entityFilterSetId || null), state:(state || null), pageIndex:(pageIndex || 0), pageSize:pageSize}"/>
        <set field="failure" from="ec.message.hasError() ? ec.message.getErrorsString() : null"/>
        <script>ec.message.clearErrors()</script>
        <set field="rules" from="(found?.ruleList || []).map(row => Object.assign({}, row, {
                stateText: row.state === 'missing' ? 'Not bound' : row.conditional ? 'Bound, by condition' : 'Bound',
                bindKey: [row.artifactAuthzId, row.entityFilterSetId].join('_')}))"/>
        <set field="filterSets" from="(found?.filterSetList || []).map(row => Object.assign({}, row, {
                recordsText: row.entityNames.map(name => name.split('.').pop()).join(', '),
                noteText: [row.registered ? 'Registered' : 'Configuration only', row.conditional ? 'applies by condition' : ''].filter(Boolean).join(', ')}))"/>
        <set field="filterSetOptions" from="filterSets.map(row => ({value: row.entityFilterSetId, label: row.description}))"/>
        <set field="listCount" from="found?.ruleCount || 0"/>
        <set field="shownCount" from="rules.length"/>
        <set field="firstRow" from="Number(pageIndex || 0) * pageSize"/>
        <set field="filtered" from="!!(userGroupId || artifactGroupId || entityFilterSetId || state)"/>
        <set field="findValues" from="{userGroupId:userGroupId, artifactGroupId:artifactGroupId, entityFilterSetId:entityFilterSetId, state:state}"/>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Row rules" type="h5"/>
                <label text="A row rule narrows the records a group's members read through an app: their organizations' records, or their own private contacts. Rules come with a registered bundle's app gate; writing a rule or removing one is done in Tools by an instance administrator."
                        type="p" style="text-caption m-muted q-mb-none"/>
            </container>
            <container style="col-auto">
                <link url="../Capabilities" text="Capabilities" icon="sym_o_rule" link-type="anchor"/>
            </container>
        </container>
        <form-single name="ScopeRuleFind" transition="." map="findValues">
            <field name="userGroupId">
                <default-field title="Group">
                    <drop-down allow-empty="true"><list-options list="found?.groupOptions || []" key="${value}" text="${label}"/></drop-down>
                </default-field>
            </field>
            <field name="artifactGroupId">
                <default-field title="App gate">
                    <drop-down allow-empty="true"><list-options list="found?.artifactGroupOptions || []" key="${value}" text="${label}"/></drop-down>
                </default-field>
            </field>
            <field name="entityFilterSetId">
                <default-field title="Row rule">
                    <drop-down allow-empty="true"><list-options list="filterSetOptions" key="${value}" text="${label}"/></drop-down>
                </default-field>
            </field>
            <field name="state">
                <default-field title="State">
                    <drop-down allow-empty="true"><option key="bound" text="Bound"/><option key="missing" text="Not bound"/></drop-down>
                </default-field>
            </field>
            <field name="submitButton"><default-field title="Find"><submit/></default-field></field>
            <field-layout>
                <field-row-big>
                    <field-ref name="userGroupId"/>
                    <field-ref name="artifactGroupId"/>
                    <field-ref name="entityFilterSetId"/>
                    <field-ref name="state"/>
                    <field-ref name="submitButton"/>
                </field-row-big>
            </field-layout>
        </form-single>
        <label type="p" style="text-negative" condition="failure" text="${failure}"/>
        <label type="p" style="text-warning" condition="found?.missingCount"
                text="${found?.missingCount} registered app gate(s) lack a row rule their bundle registers: their members read more than the bundle's own members do."/>
        <container-box>
            <box-header title="Rules in effect"/>
            <box-body-nopad>
                <form-list name="ScopeRules" list="rules" skip-form="true" paginate="false">
                    <field name="groupDescription">
                        <default-field title="Group">
                            <link url="../GroupDetail" text="${groupDescription}" link-type="anchor" parameter-map="{userGroupId:userGroupId}"/>
                        </default-field>
                    </field>
                    <field name="artifactDescription">
                        <default-field title="App gate"><display text="${artifactDescription} (${typeText})"/></default-field>
                    </field>
                    <field name="filterDescription">
                        <default-field title="Row rule">
                            <display text="${filterDescription}"/>
                            <label text="${entityFilterSetId}" style="text-caption m-muted text-mono"/>
                        </default-field>
                    </field>
                    <field name="stateText">
                        <default-field title="State">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal ${state === 'missing' ? 'text-warning' : 'text-positive'}">${WebUtilities.encodeHtml(stateText)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateText})}]]></text>
                                <text type="html">${stateText}</text>
                            </render-mode>
                        </default-field>
                    </field>
                    <field name="sourceText"><default-field title="Source"><display/></default-field></field>
                    <field name="actions">
                        <default-field title="">
                            <container-dialog id="BindScope_${bindKey}" button-text="Bind" icon="sym_o_filter_alt" width="560"
                                    title="Bind ${filterDescription} for ${groupDescription}" condition="state === 'missing' &amp;&amp; canBind">
                                <label type="p" text="Members of ${groupDescription} will read through ${artifactDescription} only what ${filterDescription} allows, as the members of ${sourceBundleGroupId} do. It takes effect at once and is removed only in Tools."/>
                                <form-single name="SupportedScopeBinding" transition="bindScope"
                                        map="{bindGroupId:userGroupId, bindArtifactGroupId:artifactGroupId, bindFilterSetId:entityFilterSetId, expectedRevision:grantRevision}">
                                    <field name="bindGroupId"><default-field><hidden/></default-field></field>
                                    <field name="bindArtifactGroupId"><default-field><hidden/></default-field></field>
                                    <field name="bindFilterSetId"><default-field><hidden/></default-field></field>
                                    <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                    <field name="reason"><default-field title="Reason"><text-line size="50"/></default-field></field>
                                    <field name="submitButton"><default-field title="Bind row rule"><submit/></default-field></field>
                                </form-single>
                            </container-dialog>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column><field-ref name="groupDescription"/><field-ref name="artifactDescription"/></column>
                        <column><field-ref name="filterDescription"/><field-ref name="stateText"/><field-ref name="actions"/></column>
                    </columns>
                </form-list>
                <label type="p" style="q-pa-md m-muted" condition="!rules.length &amp;&amp; !failure"
                        text="${filtered ? 'No row rule matches.' : 'No row rule is bound to an app gate.'}"/>
            </box-body-nopad>
        </container-box>
        <section name="Paging" condition="listCount &gt; shownCount || firstRow &gt; 0">
            <widgets>
                <container style="row items-center q-gutter-sm q-mt-xs">
                    <link url="." text="Previous" link-type="anchor" condition="firstRow &gt; 0"
                            parameter-map="Object.assign({}, findValues, {pageIndex:(Number(pageIndex || 0) - 1)})"/>
                    <label text="${firstRow + 1} to ${firstRow + shownCount} of ${listCount}" style="m-muted"/>
                    <link url="." text="Next" link-type="anchor" condition="firstRow + shownCount &lt; listCount"
                            parameter-map="Object.assign({}, findValues, {pageIndex:(Number(pageIndex || 0) + 1)})"/>
                </container>
            </widgets>
        </section>
        <container-box>
            <box-header title="Row rule sets"/>
            <box-body-nopad>
                <form-list name="FilterSets" list="filterSets" skip-form="true" paginate="false">
                    <field name="description">
                        <default-field title="Row rule">
                            <link url="." text="${description}" link-type="anchor" parameter-map="{entityFilterSetId:entityFilterSetId}"/>
                        </default-field>
                    </field>
                    <field name="entityFilterSetId"><default-field title="ID"><display style="text-mono"/></default-field></field>
                    <field name="recordsText"><default-field title="Records narrowed"><display/></default-field></field>
                    <field name="bindingCount"><default-field title="App gates bound"><display/></default-field></field>
                    <field name="noteText"><default-field title="Kind"><display/></default-field></field>
                    <columns type="mobile">
                        <column><field-ref name="description"/><field-ref name="recordsText"/></column>
                        <column><field-ref name="bindingCount"/><field-ref name="noteText"/></column>
                    </columns>
                </form-list>
            </box-body-nopad>
        </container-box>
    </widgets>
</screen>
