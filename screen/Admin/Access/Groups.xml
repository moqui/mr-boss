<!-- Groups (design-admin §5 Groups; mr-moqui plans/Admin-Screens-Down.md): the framework's System › Access groups list at
    this location, with the one transition an access administrator uses: createGroup, through
    org.moqui.admin.AccessServices.create#Group, which checks ADMIN_ACCESS_MANAGE and makes a custom group of a registered
    purpose, never privileged. The System screen's own part for the instance administrator (a group of any id and type
    created directly) is not shown under a mount and its transition is not taken in, so it does not exist on this route. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Groups" menu-image="sym_o_group" menu-image-type="icon">
    <parameter name="text"/>
    <parameter name="appName"/>
    <parameter name="kind"/>
    <parameter name="userPermissionId"/>

    <transition-include name="createGroup" location="component://tools/screen/System/Access/Groups.xml"/>

    <widgets>
        <include-screen location="component://tools/screen/System/Access/Groups.xml" share-scope="true"/>
    </widgets>
</screen>
