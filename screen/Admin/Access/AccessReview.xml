<!-- AccessReview (design-admin §16 "Access/grant review"; mr-moqui plans/Admin-Screens-Down.md): the access and grant
    review of the groups chosen in Capabilities or of one group from GroupDetail, as of a date and time, as Admin's own
    screen for what Admin adds to the framework's System › Access review: the organization scope of its members. One
    projection (ironstone.admin.CapabilityServices get#AccessReview over the framework's get#GrantReview,
    ADMIN_ACCESS_VIEW) for the screen, its print (this screen in html-print) and its CSV (the list's export): each group's
    permission grants, app gates with their row rules, and the members who work for an organization the user administers;
    members outside the user's organizations are counted, never named. The page is the System screen's (ReviewPrepare and
    ReviewPage). Sealed permissions are left out and counted; allowed IPs, preference values and filter expressions are
    never in it. For the access administrator and the administrator (BOSS_ADM_ACCESS). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Access review" default-menu-include="false">
    <parameter name="groups"/>
    <parameter name="appName"/>
    <parameter name="asOfDate"/>

    <actions>
        <set field="groupsParameter" from="typeof groups === 'string' ? groups : Array.from(groups || []).join(',')"/>
        <set field="chosen" from="!!(groupsParameter || appName)"/>
        <if condition="chosen">
            <service-call name="ironstone.admin.CapabilityServices.get#AccessReview" out-map="review" transaction="force-new" ignore-error="true"
                    in-map="{appRoot:appRoot, groups:groupsParameter, appName:(appName || null), asOfDate:(asOfDate || null)}"/>
            <!-- ignore-error clears a refusal's message: the service answers its bound as a reason, anything else reads as unavailable -->
            <set field="failure" from="review?.reviewRows ? (review.failure || null) : 'The access review is not available'"/>
            <set field="review" from="failure ? null : review"/>
        </if>
        <set field="emptyReviewText" value="These groups grant nothing and have no members you administer."/>
    </actions>
    <widgets>
        <section-include name="ReviewPrepare" location="component://tools/screen/System/Access/AccessReview.xml"/>
        <section-include name="ReviewPage" location="component://tools/screen/System/Access/AccessReview.xml"/>
    </widgets>
</screen>
