<!-- Capabilities (design-admin §5 Capabilities; style-guide §3.9 Settings): what the registered bundles and custom groups
    hold, over the capability registry. CapabilitySelection chooses an app, up to eight groups and a kind; CapabilityMatrix
    shows the app's capabilities as rows (a launcher, and each permission by its kind: view, change, export, sensitive values,
    each a row of its own, so a launcher never reads as a view or a change) with the groups as columns, and CapabilityList the
    same cells one a row, which replaces the matrix on a phone and in the terminal. A cell's Grant or End adds to the proposal
    the screen carries (the changes parameter); ProposedChanges shows its effect on each group from the framework's
    preview#Grants, and Apply writes each group's changes as one through apply#Grants at the previewed revision, naming a
    group that is refused. What a group holds that no registered bundle describes (another authorization type, an unregistered
    app gate or permission) is listed read only: it is changed in Tools. The registry describes; the framework's permissions
    and artifact authorizations decide, and a grant may still be narrowed by record policy, a deny, factor or IP rules or
    organization scope (RowRules). For the access administrator and the administrator (BOSS_ADM_ACCESS). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Capabilities" menu-image="sym_o_rule" menu-image-type="icon">
    <parameter name="appName"/>
    <parameter name="groups"/>
    <parameter name="kind"/>
    <parameter name="text"/>
    <parameter name="view"/>
    <!-- the proposal: tokens group~a|e~p:permission or group~a|e~a:artifactGroup -->
    <parameter name="changes"/>

    <transition name="applyChanges">
        <actions>
            <service-call name="ironstone.admin.CapabilityServices.apply#MatrixChanges" out-map="applied"
                    in-map="{appRoot:appRoot, changes:changes, revisions:(revisions || null), reason:(reason || null)}"/>
            <if condition="!ec.message.hasError()">
                <script>for (const row of applied.resultList) ec.message.addMessage(row.applied
                    ? row.userGroupId + ': ' + row.added + ' granted, ' + row.ended + ' ended'
                    : row.userGroupId + ' not changed: ' + row.reason, row.applied ? 'success' : 'warning')</script>
                <set field="changes" from="applied.remainingChanges"/>
            </if>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <set field="groupsParameter" from="typeof groups === 'string' ? groups : Array.from(groups || []).join(',')"/>
        <service-call name="ironstone.admin.CapabilityServices.get#MatrixContext" out-map="matrix" transaction="force-new" ignore-error="true"
                in-map="{appRoot:appRoot, appName:(appName || null), groups:groupsParameter, kind:(kind || null), text:(text || null),
                    changes:(changes || null)}"/>
        <set field="failure" from="ec.message.hasError() ? ec.message.getErrorsString() : null"/>
        <script>ec.message.clearErrors()</script>
        <set field="columns" from="matrix?.columns || []"/>
        <set field="matrixRows" from="matrix?.matrixRows || []"/>
        <set field="listRows" from="matrix?.listRows || []"/>
        <set field="unsupportedRows" from="matrix?.unsupportedRows || []"/>
        <set field="proposal" from="matrix?.proposal || null"/>
        <set field="proposalRows" from="proposal?.rows || []"/>
        <set field="groupsText" from="matrix?.groups || groupsParameter"/>
        <set field="changesText" from="matrix ? matrix.changes : (changes || '')"/>
        <set field="selection" from="{appName:(appName || ''), groups:groupsText, kind:(kind || ''), text:(text || ''), view:(view || ''),
                changes:changesText}"/>
        <set field="findValues" from="Object.assign({}, selection, {groups:(groupsText ? groupsText.split(',') : [])})"/>
        <set field="applyValues" from="Object.assign({}, selection, {revisions:(proposal?.revisions || '')})"/>
        <set field="selected" from="!!(appName || groupsText)"/>
        <set field="listOnly" from="view === 'list' || sri.getRenderMode() === 'tui'"/>
        <set field="proposalText" from="(proposal?.groups || []).map(row => row.userGroupId + ': ' + (row.allowed ? row.summary : row.reason)).join(' · ')"/>
        <set field="columnNotes" from="columns.filter(row => !row.canManage &amp;&amp; row.manageReason).map(row => row.manageReason)"/>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Capabilities" type="h5"/>
                <label text="What each group holds, by app. A launcher opens an app and grants nothing in it; view, change, export and sensitive values are each granted on their own. Service scope, record policy and row rules still apply."
                        type="p" style="text-caption m-muted q-mb-none"/>
            </container>
            <container style="col-auto">
                <link url="../AccessReview" text="Access review" icon="sym_o_fact_check" condition="selected"
                        parameter-map="{groups:groupsText, appName:(groupsText ? '' : appName)}"/>
                <link url="../RowRules" text="Row rules" icon="sym_o_filter_alt" link-type="anchor"/>
            </container>
        </container>
        <form-single name="CapabilitySelection" transition="." map="findValues">
            <field name="changes"><default-field><hidden/></default-field></field>
            <field name="appName">
                <default-field title="App">
                    <drop-down allow-empty="true"><list-options list="matrix?.appOptions || []" key="${value}" text="${label}"/></drop-down>
                </default-field>
            </field>
            <field name="groups">
                <default-field title="Groups" tooltip="Up to ${matrix?.maxGroups || 8}; empty shows the app's first groups">
                    <drop-down allow-multiple="true" allow-empty="true">
                        <list-options list="matrix?.groupOptions || []" key="${value}" text="${label}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="kind">
                <default-field title="Kind">
                    <drop-down allow-empty="true"><list-options list="matrix?.kindOptions || []" key="${value}" text="${label}"/></drop-down>
                </default-field>
            </field>
            <field name="text"><default-field title="Capability"><text-find size="20" hide-options="true"/></default-field></field>
            <field name="view">
                <default-field title="Show as">
                    <drop-down><option key="" text="Matrix"/><option key="list" text="List"/></drop-down>
                </default-field>
            </field>
            <field name="submitButton"><default-field title="Show"><submit/></default-field></field>
            <field-layout>
                <field-row-big>
                    <field-ref name="appName"/>
                    <field-ref name="groups"/>
                    <field-ref name="kind"/>
                    <field-ref name="text"/>
                    <field-ref name="view"/>
                    <field-ref name="submitButton"/>
                </field-row-big>
            </field-layout>
        </form-single>
        <label type="p" style="text-negative" condition="failure" text="${failure}"/>
        <label type="p" style="q-pa-md m-muted" condition="!selected &amp;&amp; !failure"
                text="Choose an app to see what its groups hold, or up to ${matrix?.maxGroups || 8} groups to compare."/>

        <section name="ProposedChanges" condition="proposal">
            <widgets>
                <container-box type="warning">
                    <box-header title="Proposed changes (${matrix.changeCount})"/>
                    <box-toolbar>
                        <link url="." text="Clear" icon="sym_o_close" link-type="anchor" parameter-map="Object.assign({}, selection, {changes:''})"/>
                    </box-toolbar>
                    <box-body-nopad>
                        <label type="p" style="q-px-md q-pt-md q-mb-none" text="${proposalText}"/>
                        <form-list name="ProposedChangeList" list="proposalRows" skip-form="true" paginate="false">
                            <field name="userGroupId"><default-field title="Group"><display style="text-mono"/></default-field></field>
                            <field name="actionText"><default-field title="Change"><display text="${actionText} ${kindText.toLowerCase()}"/></default-field></field>
                            <field name="id"><default-field title="Capability"><display text="${id}${label ? ' · ' + label : ''}"/></default-field></field>
                            <field name="resultText"><default-field title="Effect"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="userGroupId"/><field-ref name="id"/></column>
                                <column><field-ref name="actionText"/><field-ref name="resultText"/></column>
                            </columns>
                        </form-list>
                        <section name="ApplyAllowed" condition="proposal.canApply">
                            <widgets>
                                <container style="q-pa-md">
                                    <form-single name="ApplyChanges" transition="applyChanges" map="applyValues">
                                        <field name="appName"><default-field><hidden/></default-field></field>
                                        <field name="groups"><default-field><hidden/></default-field></field>
                                        <field name="kind"><default-field><hidden/></default-field></field>
                                        <field name="text"><default-field><hidden/></default-field></field>
                                        <field name="view"><default-field><hidden/></default-field></field>
                                        <field name="changes"><default-field><hidden/></default-field></field>
                                        <field name="revisions"><default-field><hidden/></default-field></field>
                                        <field name="reason"><default-field title="Reason"><text-line size="50"/></default-field></field>
                                        <field name="submitButton">
                                            <default-field title="Apply ${matrix.changeCount} change(s)">
                                                <submit type="primary" confirmation="Apply ${matrix.changeCount} change(s) to ${proposal.groups.length} group(s)? Their members' access changes at once."/>
                                            </default-field>
                                        </field>
                                    </form-single>
                                </container>
                            </widgets>
                            <fail-widgets>
                                <label type="p" style="q-pa-md text-warning" text="${matrix.canManage ? 'A change above is refused or changes nothing: withdraw it to apply the rest.' : 'ADMIN_ACCESS_MANAGE is required to apply changes.'}"/>
                            </fail-widgets>
                        </section>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>

        <section name="Selected" condition="selected &amp;&amp; !failure">
            <widgets>
                <label type="p" style="text-caption m-muted" condition="matrix.moreGroupCount"
                        text="Showing the app's first ${columns.length} groups; ${matrix.moreGroupCount} more. Choose groups to compare others."/>
                <label type="p" style="text-caption text-warning" condition="columnNotes.length" text="${columnNotes.join(' ')}"/>
                <section name="MatrixView" condition="!listOnly">
                    <widgets>
                        <!-- the matrix on a wide screen; below that width the list replaces it -->
                        <container style="gt-sm">
                            <container-box>
                                <box-body-nopad>
                                    <form-list name="CapabilityMatrix" list="matrixRows" skip-form="true" paginate="false">
                                        <field name="capabilityText">
                                            <default-field title="Capability">
                                                <display text="${capabilityText}"/>
                                                <label text="${id}${sealed ? ' · sealed' : ''}" style="text-caption m-muted text-mono"/>
                                            </default-field>
                                        </field>
                                        <field name="kindLabel"><default-field title="Kind"><display/></default-field></field>
                                        <field name="appName" hide="!!appName"><default-field title="App"><display/></default-field></field>
                                        <field name="scopeDependency"><default-field title="Scope still checked"><display/></default-field></field>
                                        <field name="cell0" hide="columns.length &lt; 1">
                                            <default-field title="${columns[0]?.title || ''}">
                                                <render-mode>
                                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal ${(cells[0]?.proposed) ? 'text-warning' : (cells[0]?.state) === 'granted' ? 'text-positive' : (cells[0]?.state) === 'scheduled' ? 'text-info' : 'text-grey-7'}">${WebUtilities.encodeHtml(cells[0]?.proposedText || cells[0]?.stateText || '')}</q-chip>]]></text>
                                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: cells[0]?.proposedText || cells[0]?.stateText || ''})}]]></text>
                                                <text type="html">${cells[0]?.proposedText || cells[0]?.stateText || ''}</text>
                                            </render-mode>
                                                <label text="${cells[0]?.scopeText || ''}" condition="!!cells[0]?.scopeText" style="text-caption m-muted"/>
                                                <link url="." text="${cells[0]?.actionText || ''}" link-type="anchor" condition="!!cells[0]?.actionText"
                                                        parameter-map="Object.assign({}, selection, {changes:cells[0].nextChanges})"/>
                                            </default-field>
                                        </field>
                                        <field name="cell1" hide="columns.length &lt; 2">
                                            <default-field title="${columns[1]?.title || ''}">
                                                <render-mode>
                                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal ${(cells[1]?.proposed) ? 'text-warning' : (cells[1]?.state) === 'granted' ? 'text-positive' : (cells[1]?.state) === 'scheduled' ? 'text-info' : 'text-grey-7'}">${WebUtilities.encodeHtml(cells[1]?.proposedText || cells[1]?.stateText || '')}</q-chip>]]></text>
                                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: cells[1]?.proposedText || cells[1]?.stateText || ''})}]]></text>
                                                <text type="html">${cells[1]?.proposedText || cells[1]?.stateText || ''}</text>
                                            </render-mode>
                                                <label text="${cells[1]?.scopeText || ''}" condition="!!cells[1]?.scopeText" style="text-caption m-muted"/>
                                                <link url="." text="${cells[1]?.actionText || ''}" link-type="anchor" condition="!!cells[1]?.actionText"
                                                        parameter-map="Object.assign({}, selection, {changes:cells[1].nextChanges})"/>
                                            </default-field>
                                        </field>
                                        <field name="cell2" hide="columns.length &lt; 3">
                                            <default-field title="${columns[2]?.title || ''}">
                                                <render-mode>
                                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal ${(cells[2]?.proposed) ? 'text-warning' : (cells[2]?.state) === 'granted' ? 'text-positive' : (cells[2]?.state) === 'scheduled' ? 'text-info' : 'text-grey-7'}">${WebUtilities.encodeHtml(cells[2]?.proposedText || cells[2]?.stateText || '')}</q-chip>]]></text>
                                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: cells[2]?.proposedText || cells[2]?.stateText || ''})}]]></text>
                                                <text type="html">${cells[2]?.proposedText || cells[2]?.stateText || ''}</text>
                                            </render-mode>
                                                <label text="${cells[2]?.scopeText || ''}" condition="!!cells[2]?.scopeText" style="text-caption m-muted"/>
                                                <link url="." text="${cells[2]?.actionText || ''}" link-type="anchor" condition="!!cells[2]?.actionText"
                                                        parameter-map="Object.assign({}, selection, {changes:cells[2].nextChanges})"/>
                                            </default-field>
                                        </field>
                                        <field name="cell3" hide="columns.length &lt; 4">
                                            <default-field title="${columns[3]?.title || ''}">
                                                <render-mode>
                                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal ${(cells[3]?.proposed) ? 'text-warning' : (cells[3]?.state) === 'granted' ? 'text-positive' : (cells[3]?.state) === 'scheduled' ? 'text-info' : 'text-grey-7'}">${WebUtilities.encodeHtml(cells[3]?.proposedText || cells[3]?.stateText || '')}</q-chip>]]></text>
                                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: cells[3]?.proposedText || cells[3]?.stateText || ''})}]]></text>
                                                <text type="html">${cells[3]?.proposedText || cells[3]?.stateText || ''}</text>
                                            </render-mode>
                                                <label text="${cells[3]?.scopeText || ''}" condition="!!cells[3]?.scopeText" style="text-caption m-muted"/>
                                                <link url="." text="${cells[3]?.actionText || ''}" link-type="anchor" condition="!!cells[3]?.actionText"
                                                        parameter-map="Object.assign({}, selection, {changes:cells[3].nextChanges})"/>
                                            </default-field>
                                        </field>
                                        <field name="cell4" hide="columns.length &lt; 5">
                                            <default-field title="${columns[4]?.title || ''}">
                                                <render-mode>
                                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal ${(cells[4]?.proposed) ? 'text-warning' : (cells[4]?.state) === 'granted' ? 'text-positive' : (cells[4]?.state) === 'scheduled' ? 'text-info' : 'text-grey-7'}">${WebUtilities.encodeHtml(cells[4]?.proposedText || cells[4]?.stateText || '')}</q-chip>]]></text>
                                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: cells[4]?.proposedText || cells[4]?.stateText || ''})}]]></text>
                                                <text type="html">${cells[4]?.proposedText || cells[4]?.stateText || ''}</text>
                                            </render-mode>
                                                <label text="${cells[4]?.scopeText || ''}" condition="!!cells[4]?.scopeText" style="text-caption m-muted"/>
                                                <link url="." text="${cells[4]?.actionText || ''}" link-type="anchor" condition="!!cells[4]?.actionText"
                                                        parameter-map="Object.assign({}, selection, {changes:cells[4].nextChanges})"/>
                                            </default-field>
                                        </field>
                                        <field name="cell5" hide="columns.length &lt; 6">
                                            <default-field title="${columns[5]?.title || ''}">
                                                <render-mode>
                                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal ${(cells[5]?.proposed) ? 'text-warning' : (cells[5]?.state) === 'granted' ? 'text-positive' : (cells[5]?.state) === 'scheduled' ? 'text-info' : 'text-grey-7'}">${WebUtilities.encodeHtml(cells[5]?.proposedText || cells[5]?.stateText || '')}</q-chip>]]></text>
                                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: cells[5]?.proposedText || cells[5]?.stateText || ''})}]]></text>
                                                <text type="html">${cells[5]?.proposedText || cells[5]?.stateText || ''}</text>
                                            </render-mode>
                                                <label text="${cells[5]?.scopeText || ''}" condition="!!cells[5]?.scopeText" style="text-caption m-muted"/>
                                                <link url="." text="${cells[5]?.actionText || ''}" link-type="anchor" condition="!!cells[5]?.actionText"
                                                        parameter-map="Object.assign({}, selection, {changes:cells[5].nextChanges})"/>
                                            </default-field>
                                        </field>
                                        <field name="cell6" hide="columns.length &lt; 7">
                                            <default-field title="${columns[6]?.title || ''}">
                                                <render-mode>
                                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal ${(cells[6]?.proposed) ? 'text-warning' : (cells[6]?.state) === 'granted' ? 'text-positive' : (cells[6]?.state) === 'scheduled' ? 'text-info' : 'text-grey-7'}">${WebUtilities.encodeHtml(cells[6]?.proposedText || cells[6]?.stateText || '')}</q-chip>]]></text>
                                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: cells[6]?.proposedText || cells[6]?.stateText || ''})}]]></text>
                                                <text type="html">${cells[6]?.proposedText || cells[6]?.stateText || ''}</text>
                                            </render-mode>
                                                <label text="${cells[6]?.scopeText || ''}" condition="!!cells[6]?.scopeText" style="text-caption m-muted"/>
                                                <link url="." text="${cells[6]?.actionText || ''}" link-type="anchor" condition="!!cells[6]?.actionText"
                                                        parameter-map="Object.assign({}, selection, {changes:cells[6].nextChanges})"/>
                                            </default-field>
                                        </field>
                                        <field name="cell7" hide="columns.length &lt; 8">
                                            <default-field title="${columns[7]?.title || ''}">
                                                <render-mode>
                                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal ${(cells[7]?.proposed) ? 'text-warning' : (cells[7]?.state) === 'granted' ? 'text-positive' : (cells[7]?.state) === 'scheduled' ? 'text-info' : 'text-grey-7'}">${WebUtilities.encodeHtml(cells[7]?.proposedText || cells[7]?.stateText || '')}</q-chip>]]></text>
                                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: cells[7]?.proposedText || cells[7]?.stateText || ''})}]]></text>
                                                <text type="html">${cells[7]?.proposedText || cells[7]?.stateText || ''}</text>
                                            </render-mode>
                                                <label text="${cells[7]?.scopeText || ''}" condition="!!cells[7]?.scopeText" style="text-caption m-muted"/>
                                                <link url="." text="${cells[7]?.actionText || ''}" link-type="anchor" condition="!!cells[7]?.actionText"
                                                        parameter-map="Object.assign({}, selection, {changes:cells[7].nextChanges})"/>
                                            </default-field>
                                        </field>
                                    </form-list>
                                    <label type="p" style="q-pa-md m-muted" condition="!matrixRows.length" text="No registered capability matches."/>
                                </box-body-nopad>
                            </container-box>
                        </container>
                    </widgets>
                </section>
                <container style="${listOnly ? '' : 'lt-md'}">
                    <container-box>
                        <box-body-nopad>
                            <form-list name="CapabilityList" list="listRows" skip-form="true" paginate="false">
                                <field name="capabilityText">
                                    <default-field title="Capability">
                                        <display text="${capabilityText}"/>
                                        <label text="${kindLabel}${sealed ? ' · sealed' : ''}" style="text-caption m-muted"/>
                                    </default-field>
                                </field>
                                <field name="id"><default-field title="ID"><display style="text-mono"/></default-field></field>
                                <field name="appName" hide="!!appName"><default-field title="App"><display/></default-field></field>
                                <field name="groupDescription"><default-field title="Group"><display/></default-field></field>
                                <field name="state">
                                    <default-field title="Grant">
                                        <render-mode>
                                    <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal ${proposed ? 'text-warning' : state === 'granted' ? 'text-positive' : state === 'scheduled' ? 'text-info' : 'text-grey-7'}">${WebUtilities.encodeHtml(proposedText || stateText || '')}</q-chip>]]></text>
                                    <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: proposedText || stateText || ''})}]]></text>
                                    <text type="html">${proposedText || stateText || ''}</text>
                                </render-mode>
                                    </default-field>
                                </field>
                                <field name="scopeText"><default-field title="Row rules"><display/></default-field></field>
                                <field name="actions">
                                    <default-field title="">
                                        <link url="." text="${actionText}" link-type="anchor" condition="!!actionText"
                                                parameter-map="Object.assign({}, selection, {changes:nextChanges})"/>
                                        <label text="${refusedText}" condition="!!refusedText" style="text-caption m-muted"/>
                                    </default-field>
                                </field>
                                <columns type="mobile">
                                    <column><field-ref name="capabilityText"/><field-ref name="groupDescription"/></column>
                                    <column><field-ref name="state"/><field-ref name="actions"/></column>
                                </columns>
                            </form-list>
                            <label type="p" style="q-pa-md m-muted" condition="!listRows.length" text="No registered capability matches."/>
                        </box-body-nopad>
                    </container-box>
                </container>

                <section name="UnsupportedRules" condition="unsupportedRows.length">
                    <widgets>
                        <container-box>
                            <box-header title="Advanced rules (read only)"/>
                            <box-body-nopad>
                                <label type="p" style="q-px-md q-pt-md q-mb-none text-caption m-muted"
                                        text="What these groups hold that no registered bundle describes: another authorization type, or an app gate or permission outside the registry. An instance administrator changes them in Tools System › Security."/>
                                <form-list name="UnsupportedRuleList" list="unsupportedRows" skip-form="true" paginate="true">
                                    <field name="groupDescription"><default-field title="Group"><display/></default-field></field>
                                    <field name="ruleText"><default-field title="Rule"><display/></default-field></field>
                                    <field name="id"><default-field title="On"><display text="${label &amp;&amp; label != id ? label : id}"/></default-field></field>
                                    <field name="typeText"><default-field title="Type"><display/></default-field></field>
                                    <field name="scopeText"><default-field title="Row rules"><display/></default-field></field>
                                    <field name="reason"><default-field title="Why read only"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="id"/><field-ref name="groupDescription"/></column>
                                        <column><field-ref name="typeText"/><field-ref name="ruleText"/></column>
                                    </columns>
                                </form-list>
                            </box-body-nopad>
                        </container-box>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
