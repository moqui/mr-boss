<!-- Imports (design-admin §11 Imports; style-guide §3.2 List; impl-admin P15; mr-moqui plans/archive/Admin-Screens-Down.md): the
    framework's System › Data imports list, as Admin's own screen for what Admin adds: the organization an import is for,
    as a filter (the organizations the administrator administers, ironstone.admin.ContextServices.get#Choices) and the
    name of its column. The runs and the targets are read here from org.moqui.admin.DataTransferServices.find#ImportRuns
    with the organization as the scope; the display values, the heading, the notes and the targets are the System
    screen's (ImportsPrepare, ImportsHeader, ImportNotes, ImportTargetsBox, and ImportFind and ImportList extended here).
    A run kept here, or by an owner that keeps the import contract's batch (Products' catalog), opens ImportDetail; an
    owner wizard's run (Accounting's statement imports and opening open items, Commerce's channel orders) opens its
    owner's place, and a target started here opens the shared wizard (DataImport), each by the mount's routes (Admin.js
    mountRoutes). Reading needs ADMIN_TRANSFER_VIEW or ADMIN_TRANSFER_RUN, checked by the service. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Imports" menu-image="sym_o_upload_file" menu-image-type="icon">
    <parameter name="targetId"/>
    <parameter name="organizationPartyId"/>
    <parameter name="state"/>
    <parameter name="fromDate"/>
    <parameter name="thruDate"/>
    <parameter name="pageIndex"/>

    <transition name="choices" read-only="true">
        <actions>
            <service-call name="ironstone.admin.ContextServices.get#Choices" out-map="found"
                    in-map="{appRoot:appRoot, choice:choice, term:term, selected:selected}"/>
            <script>ec.web.sendJsonResponse(found.options)</script>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <!-- a refusal is shown as its reason (AdminCalls.read; ignore-error would clear it) -->
        <set field="called" from="ec.resource.script('component://framework/service/org/moqui/admin/AdminCalls.js').read('org.moqui.admin.DataTransferServices.find#ImportRuns',
                {targetId:(targetId || null), scopeKey:(organizationPartyId || null), state:(state || null), fromDate:(fromDate || null),
                    thruDate:(thruDate || null), pageIndex:Math.max(Number(pageIndex) || 0, 0)}, 'they could not be read')"/>
        <set field="found" from="called.out"/>
        <set field="failure" from="called.failure"/>
        <set field="findValues" from="{targetId:targetId, organizationPartyId:organizationPartyId, state:state, fromDate:fromDate, thruDate:thruDate}"/>
    </actions>
    <widgets>
        <section-include name="ImportsPrepare" location="component://tools/screen/System/Data/Imports.xml"/>
        <section-include name="ImportsHeader" location="component://tools/screen/System/Data/Imports.xml"/>
        <section name="ImportsSection" condition="available">
            <widgets>
                <form-single name="ImportFind" extends="component://tools/screen/System/Data/Imports.xml#ImportFind" transition="." map="findValues">
                    <field name="organizationPartyId">
                        <default-field title="Organization">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'organizations'}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field-layout>
                        <field-row-big><field-ref name="targetId"/><field-ref name="organizationPartyId"/><field-ref name="state"/><field-ref name="fromDate"/><field-ref name="thruDate"/><field-ref name="submitButton"/></field-row-big>
                    </field-layout>
                </form-single>
                <section-include name="ImportNotes" location="component://tools/screen/System/Data/Imports.xml"/>
                <form-list name="ImportList" extends="component://tools/screen/System/Data/Imports.xml#ImportList" list="runs" skip-form="true" paginate="true">
                    <field name="scopeTitle"><default-field title="Organization"><display/></default-field></field>
                </form-list>
                <section-include name="ImportTargetsBox" location="component://tools/screen/System/Data/Imports.xml"/>
            </widgets>
        </section>
    </widgets>
</screen>
