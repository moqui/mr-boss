<!-- Exports (design-admin §11 Exports; style-guide §3.2 List; impl-admin P16): the exports made in Admin and the deliveries
    of scheduled reports and business alerts, as status, from the framework's org.moqui.admin.DataTransferServices.find#Transfers
    (direction export) through ironstone.admin.DataServices.find#ExportRuns. ExportFind: what kind, the target, the state and a
    bounded range of dates. ExportList: an export made here with its target and owner, its file's name, what it was of, its
    rows and fields and who made it; a scheduled report's or an alert rule's delivery with whose it is, its state and its
    counters. Status only: the file of an export was its exporter's answer and is not kept, and a delivery's title,
    recipients, values and content are never read here, so nothing in the list opens an output (design §11: administrative
    status visibility is not permission to download the output). ExportTargets: the registered targets, each started in
    DataExport or opened in its owner's own place (dataset and report exports are Insights'). Reading needs
    ADMIN_TRANSFER_VIEW, checked by the services. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Exports" menu-image="sym_o_file_download" menu-image-type="icon">
    <parameter name="kind"/>
    <parameter name="targetId"/>
    <parameter name="state"/>
    <parameter name="fromDate"/>
    <parameter name="thruDate"/>
    <parameter name="pageIndex"/>

    <actions>
        <service-call name="ironstone.admin.DataServices.find#ExportRuns" out-map="found" transaction="force-new" ignore-error="true"
                in-map="{kind:(kind || null), targetId:(targetId || null), state:(state || null), fromDate:(fromDate || null),
                    thruDate:(thruDate || null), pageIndex:(pageIndex || 0)}"/>
        <!-- ignore-error clears a refusal's message -->
        <set field="available" from="!!found?.transferList"/>
        <script><![CDATA[
            ec.message.clearErrors()
            const colors = {exported: 'positive', complete: 'positive', partial: 'deep-orange', failed: 'negative', uncertain: 'deep-orange', running: 'info'}
            runs = Array.from(found?.transferList || []).map(row => Object.assign({}, row, {
                stateColor: colors[row.state] || 'grey-7',
                whatText: row.targetTitle + (row.ownerApp ? ' · ' + row.ownerApp : ''),
                itemText: row.kind === 'export' ? (row.fileLabel || row.runId) : row.runId,
                scopeText: row.scopeTitle || '',
                outputText: row.kind === 'export' ? 'Not kept: it was its exporter\'s answer' : 'Not readable here: its recipients\' own'}))
            runsCount = Number(found?.transferCount || 0)
            runsPageIndex = Number(found?.pageIndex || 0)
            runsPageSize = Number(found?.pageSize || 50)
            runsPageMaxIndex = Math.max(Math.ceil(runsCount / runsPageSize) - 1, 0)
            runsPageRangeLow = runsCount ? runsPageIndex * runsPageSize + 1 : 0
            runsPageRangeHigh = Math.min((runsPageIndex + 1) * runsPageSize, runsCount)
            targets = Array.from(found?.targetList || []).map(target => Object.assign({}, target, {
                startHere: !!found.canRun && target.exportHere && target.exportAllowed,
                howText: target.exportHere
                    ? (target.exportAllowed ? (found.canRun ? 'Export data' : 'Export data, with ADMIN_TRANSFER_RUN') : 'Export data, with ' + (target.exportPermission || 'its owner\'s permission').split(',').join(' and '))
                    : 'In ' + (target.ownerApp || 'its owner\'s app')}))
            targetOptions = targets.filter(target => target.exportHere).map(target => ({value: target.targetId, label: target.title}))
            kindOptions = Array.from(found?.kindList || []).map(row => ({value: row.kind, label: row.text}))
            stateOptions = Array.from(found?.stateList || []).map(row => ({value: row.state, label: row.text}))
            unansweredText = Array.from(found?.unansweredTargetList || []).map(target => target.title).join(', ')
            findValues = {kind: kind, targetId: targetId, state: state, fromDate: fromDate, thruDate: thruDate}
        ]]></script>
    </actions>
    <widgets>
        <label text="Exports" type="h5"/>
        <label text="What was exported here, and how the deliveries of scheduled reports and business alerts went. Status only: an export's file went to who made it and is not kept, and a report or an alert is read by its own recipients, in Insights. Times are in ${found?.timeZone || 'the server time zone'}."
                type="p" style="text-caption m-muted q-mb-none"/>
        <label type="p" style="text-negative" condition="!available" text="Exports are not available to you: reading them needs ADMIN_TRANSFER_VIEW."/>
        <section name="ExportsSection" condition="available">
            <widgets>
                <form-single name="ExportFind" transition="." map="findValues">
                    <field name="kind">
                        <default-field title="Kind"><drop-down allow-empty="true"><list-options list="kindOptions" key="${value}" text="${label}"/></drop-down></default-field>
                    </field>
                    <field name="targetId">
                        <default-field title="Target" tooltip="Of the exports made here"><drop-down allow-empty="true"><list-options list="targetOptions" key="${value}" text="${label}"/></drop-down></default-field>
                    </field>
                    <field name="state">
                        <default-field title="State"><drop-down allow-empty="true"><list-options list="stateOptions" key="${value}" text="${label}"/></drop-down></default-field>
                    </field>
                    <field name="fromDate"><default-field title="From" tooltip="Empty shows the last ${found.defaultDays} days; at most ${found.rangeDays} days at a time"><date-time type="date"/></default-field></field>
                    <field name="thruDate"><default-field title="Before"><date-time type="date"/></default-field></field>
                    <field name="submitButton"><default-field title="Find"><submit/></default-field></field>
                    <field-layout>
                        <field-row-big><field-ref name="kind"/><field-ref name="targetId"/><field-ref name="state"/><field-ref name="fromDate"/><field-ref name="thruDate"/><field-ref name="submitButton"/></field-row-big>
                    </field-layout>
                </form-single>
                <label type="p" style="text-warning" condition="!!unansweredText" text="Not answered just now, so not listed: ${unansweredText}."/>
                <label type="p" style="m-muted" condition="!runs.length" text="No export or delivery matches."/>
                <form-list name="ExportList" list="runs" skip-form="true" paginate="true">
                    <field name="startedText"><default-field title="When"><display/></default-field></field>
                    <field name="whatText"><default-field title="Target"><display/></default-field></field>
                    <field name="itemText"><default-field title="Export or delivery"><display/></default-field></field>
                    <field name="scopeText"><default-field title="Of"><display/></default-field></field>
                    <field name="stateText">
                        <default-field title="State">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${stateText}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateText})}]]></text>
                                <text type="html">${stateText}</text>
                            </render-mode>
                        </default-field>
                    </field>
                    <field name="countText"><default-field title="Counts"><display/></default-field></field>
                    <field name="userName"><default-field title="By or owner"><display/></default-field></field>
                    <field name="outputText"><default-field title="Output"><display/></default-field></field>
                    <columns type="mobile">
                        <column><field-ref name="startedText"/><field-ref name="whatText"/><field-ref name="itemText"/></column>
                        <column><field-ref name="stateText"/><field-ref name="countText"/><field-ref name="userName"/></column>
                    </columns>
                </form-list>
                <container-box>
                    <box-header title="Export targets"/>
                    <box-body>
                        <label type="p" style="text-caption m-muted" text="What can be exported in a format of its owner's, each by its owner's own rules and only the fields you may read. Dataset rows and reports are exported in Insights."/>
                        <form-list name="ExportTargets" list="targets" skip-form="true" paginate="false">
                            <field name="title">
                                <conditional-field condition="startHere" title="Target">
                                    <link url="../DataExport" text="${title}" link-type="anchor" icon="sym_o_file_download" parameter-map="{targetId:targetId}"/>
                                </conditional-field>
                                <conditional-field condition="!exportHere &amp;&amp; !!ownerUrl" title="Target">
                                    <link url="${ownerUrl}" url-type="plain" text="${title}" link-type="anchor" icon="sym_o_open_in_new"/>
                                </conditional-field>
                                <default-field title="Target"><display/></default-field>
                            </field>
                            <field name="ownerApp"><default-field title="Owner"><display/></default-field></field>
                            <field name="description"><default-field title="What it exports"><display/></default-field></field>
                            <field name="howText"><default-field title="Exported in"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="title"/><field-ref name="ownerApp"/></column>
                                <column><field-ref name="howText"/></column>
                            </columns>
                        </form-list>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
