<!-- ImportDetail (design-admin §11 ImportDetail; style-guide §3.3 Detail; impl-admin P15; mr-moqui
    plans/Admin-Screens-Down.md): the framework's System › Data import detail, as Admin's own screen for what Admin adds:
    the import is read with the shared wizard's context (ironstone.shared.DataImportServices.get#ImportContext under
    Admin's mount: the same read the wizard continues from, with the organization by its name where the target's owner
    names its organizations itself, as Products' catalog does). The summary, the results, the result files and the
    retry of failed rows are the System screen's (ImportDetailView, with retry and results taken in from it:
    org.moqui.admin.DataTransferServices.retry#ImportItems, which never applies an applied row again and here needs
    ADMIN_TRANSFER_RUN, and get#ImportReport); an import still open is continued in the wizard by the mount's dataImport
    route (Admin.js mountRoutes). Read by who staged the import and those its target admits; anyone else is told it is
    not available. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Import" default-menu-include="false">
    <parameter name="targetId" required="true"/>
    <parameter name="operationKey" required="true"/>
    <parameter name="pageIndex"/>
    <parameter name="errorsOnly"/>

    <transition-include name="retry" location="component://tools/screen/System/Data/ImportDetail.xml"/>
    <transition-include name="results" location="component://tools/screen/System/Data/ImportDetail.xml"/>

    <actions>
        <service-call name="ironstone.shared.DataImportServices.get#ImportContext" out-map="found" transaction="force-new" ignore-error="true"
                in-map="{appRoot:appRoot, targetId:targetId, operationKey:operationKey, pageIndex:(pageIndex || 0),
                    errorsOnly:(errorsOnly == 'true' || errorsOnly === true)}"/>
        <!-- ignore-error clears a refusal's message: an import that is not the user's to read is not available. What the
            System screen's view reads of an import, by its names: the wizard's rows, the organization as the scope -->
        <script><![CDATA[
            ec.message.clearErrors()
            detail = found?.hasImport && found?.state
                ? Object.assign({}, found, {importRows: found.previewRows, scopeTitle: found.organizationName, scopeLabel: 'Organization'})
                : null
        ]]></script>
    </actions>
    <widgets>
        <section-include name="ImportDetailView" location="component://tools/screen/System/Data/ImportDetail.xml"/>
    </widgets>
</screen>
