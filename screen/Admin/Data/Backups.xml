<!-- Backups (design-admin §11 Backups, §15.3 "Backup scope"; impl-admin P16; mr-moqui plans/Admin-Screens-Down.md): the
    framework's System › Data backups at this location, which BOSS_ADM_DATA_BACKUPS opens to the backup operator beside
    the data operator and the administrator, with its one transition: runBackup, through
    org.moqui.admin.BackupServices.run#Backup, which checks ADMIN_BACKUP_RUN, takes a reason and nothing that names
    where, what or how, and starts one run of the instance's backup job with its stored parameters. Reading needs
    ADMIN_BACKUP_VIEW, checked by the services: the data operator, who holds neither, opens the screen and is told it is
    not available. Restoring is not done here, and there is no download. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Backups" menu-image="sym_o_backup" menu-image-type="icon">
    <parameter name="pageIndex"/>

    <transition-include name="runBackup" location="component://tools/screen/System/Data/Backups.xml"/>

    <widgets>
        <include-screen location="component://tools/screen/System/Data/Backups.xml" share-scope="true"/>
    </widgets>
</screen>
