<!-- The Data area of IronStone Admin (design-admin §1.2, §11; impl-admin P15): Imports, the runs of every registered import
    target (the default), DataImport, the shared import wizard mounted for the target a request names (Shared/DataImport), and
    ImportDetail, one import's summary and results with the retry of failed rows. For the data operator and the administrator
    (BOSS_ADM_DATA, the whole area). The area's grant opens navigation only: every read and step is the framework's
    org.moqui.admin.DataTransferServices, which checks ADMIN_TRANSFER_VIEW, each target's own permissions and its owner's
    scope, and calls an owner's service as the user. Exports and backups are added by P16. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Data" default-menu-index="9" menu-image="sym_o_swap_vert" menu-image-type="icon">
    <subscreens default-item="Imports" always-use-full-path="true">
        <subscreens-item name="Imports" location="component://mr-boss/screen/Admin/Data/Imports.xml" menu-title="Imports" menu-index="1"/>
        <subscreens-item name="DataImport" location="component://mr-boss/screen/Shared/DataImport.xml" menu-title="Import" menu-index="2"/>
        <subscreens-item name="ImportDetail" location="component://mr-boss/screen/Admin/Data/ImportDetail.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="AdminDataPanel" type="tab"/>
    </widgets>
</screen>
