<!-- The Access area of IronStone Admin (design-admin §1.2, §5): Groups, the grant bundles and their use (P3, the default), and
    GroupDetail, a group's profile, dated memberships, grants and defaults (P3, contextual); Capabilities, the registry's
    matrix and its list, RowRules, the row rules in effect, and AccessReview, the access and grant review for print and CSV
    (P9, contextual); AccessInspector later. For the access administrator and the administrator (BOSS_ADM_ACCESS; design §2 gives Groups to the
    access administrator, A); the framework's org.moqui.admin.AccessServices check ADMIN_ACCESS_VIEW and ADMIN_ACCESS_MANAGE
    and the delegation rules themselves, whatever opens the screen. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Access" default-menu-index="3" menu-image="sym_o_group" menu-image-type="icon">
    <subscreens default-item="Groups" always-use-full-path="true">
        <!-- the framework's System › Access screens (mr-moqui plans/archive/Admin-Screens-Down.md): Capabilities and RowRules by
            location, since no grant names them, they have no instance administrator's transition and Admin adds nothing;
            Groups is included in a screen at its own location here, for the one transition it takes in (the System screen
            has an instance administrator's part); GroupDetail and AccessReview are Admin's own screens around the
            framework's parts (the members of the organizations the user administers). System's ArtifactGroups and
            ArtifactGroupDetail are the instance administrator's and are not shown here -->
        <subscreens-item name="Groups" location="component://mr-boss/screen/Admin/Access/Groups.xml" menu-title="Groups" menu-index="1"/>
        <subscreens-item name="GroupDetail" location="component://mr-boss/screen/Admin/Access/GroupDetail.xml" menu-include="false"/>
        <subscreens-item name="Capabilities" location="component://tools/screen/System/Access/Capabilities.xml" menu-title="Capabilities" menu-index="2"/>
        <subscreens-item name="RowRules" location="component://tools/screen/System/Access/RowRules.xml" menu-title="Row rules" menu-index="3"/>
        <subscreens-item name="AccessReview" location="component://mr-boss/screen/Admin/Access/AccessReview.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="AdminAccessPanel" type="tab"/>
    </widgets>
</screen>
