<!-- The Security area of IronStone Admin (design-admin §1.2, §6; impl-admin P10): SignInPolicy, the sign-in policy the
    server runs with and the groups' sign-in rules (the default); IdentityProviders, the sign-in providers, and
    IdentityProviderDetail, one provider's configuration, mappings and test (contextual); Devices, the shared devices
    (P18: a registered browser that opens one route group as a display account; its services check ADMIN_ACCESS_VIEW and
    ADMIN_ACCESS_MANAGE and the caller's identity scope). For the
    access administrator, the configuration administrator, the integration administrator and the administrator
    (BOSS_ADM_SECURITY): each screen shows a viewer what the framework's services answer them, since those check
    ADMIN_SETTINGS_VIEW or ADMIN_ACCESS_VIEW (the policy), ADMIN_ACCESS_VIEW and ADMIN_ACCESS_MANAGE (the groups' rules, the
    role mappings and enabling a provider) and ADMIN_CONNECTION_VIEW and ADMIN_CONNECTION_MANAGE (a provider's configuration)
    whatever opens the screen. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Security" default-menu-index="4" menu-image="sym_o_shield_lock" menu-image-type="icon">
    <subscreens default-item="SignInPolicy" always-use-full-path="true">
        <subscreens-item name="SignInPolicy" location="component://mr-boss/screen/Admin/Security/SignInPolicy.xml" menu-title="Sign-in policy"
                menu-index="1"/>
        <subscreens-item name="IdentityProviders" location="component://mr-boss/screen/Admin/Security/IdentityProviders.xml"
                menu-title="Identity providers" menu-index="2"/>
        <subscreens-item name="IdentityProviderDetail" location="component://mr-boss/screen/Admin/Security/IdentityProviderDetail.xml"
                menu-include="false"/>
        <subscreens-item name="Devices" location="component://mr-boss/screen/Admin/Security/Devices.xml" menu-title="Devices" menu-index="3"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="AdminSecurityPanel" type="tab"/>
    </widgets>
</screen>
