<!-- SettingsHome (design-admin §7 SettingsHome, §14.2; style-guide §3 settings landing): the settings index, each app's canonical
    settings landing in Company, Applications and Instance groups (ironstone.admin.RegistryServices.find#Settings over the owners'
    SettingsEntry registrations), shown only when the user's own groups open its destination and its view permission holds; the
    owners resolve scope and make every change, and an entry grants nothing. SettingsFind searches by text, app and group; an app
    may link here with a fixed app. A BOSS user without an Admin group opens this screen alone (BOSS_ADM_SETTINGS_INDEX, a
    non-inheritable ALLOW; impl-admin F46), as a warehouse manager reaching Warehouse's settings. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Settings index" menu-image="sym_o_tune" menu-image-type="icon">
    <parameter name="text"/>
    <parameter name="ownerApp"/>
    <parameter name="settingsGroupEnumId"/>
    <actions>
        <!-- a refusal is shown as its reason (AdminCalls.read; ignore-error would clear it, F129) -->
        <set field="called" from="ec.resource.script('component://framework/service/org/moqui/admin/AdminCalls.js').read('ironstone.admin.RegistryServices.find#Settings', {text:(text || null), ownerApp:(ownerApp || null), settingsGroupEnumId:(settingsGroupEnumId || null)}, 'The settings index is not available to you.')"/>
        <set field="found" from="called.out"/>
        <set field="failure" from="called.failure"/>
        <set field="entries" from="found?.entries || []"/>
        <set field="appOptions" from="(found?.appOptions || []).map(app =&gt; ({key: app, text: app}))"/>
        <set field="groupOptions" from="found?.groupOptions || []"/>
        <set field="filtered" from="!!(text || ownerApp || settingsGroupEnumId)"/>
        <set field="findValues" from="{text:text, ownerApp:ownerApp, settingsGroupEnumId:settingsGroupEnumId}"/>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Settings" type="h5"/>
                <label text="Each app keeps its own settings; open the one you need." type="p" style="text-caption m-muted q-mb-none"/>
            </container>
        </container>
        <form-single name="SettingsFind" transition="." map="findValues">
            <field name="text"><default-field title="Find a setting"><text-line size="24"/></default-field></field>
            <field name="ownerApp">
                <default-field title="App">
                    <drop-down allow-empty="true"><list-options list="appOptions" key="${key}" text="${text}"/></drop-down>
                </default-field>
            </field>
            <field name="settingsGroupEnumId">
                <default-field title="Group">
                    <drop-down allow-empty="true"><list-options list="groupOptions" key="${key}" text="${text}"/></drop-down>
                </default-field>
            </field>
            <field name="submitButton"><default-field title="Find"><submit/></default-field></field>
            <field-layout>
                <field-row-big>
                    <field-ref name="text"/>
                    <field-ref name="ownerApp"/>
                    <field-ref name="settingsGroupEnumId"/>
                    <field-ref name="submitButton"/>
                </field-row-big>
            </field-layout>
        </form-single>
        <label type="p" style="text-negative" condition="failure" text="${failure}"/>
        <container-box>
            <box-body-nopad>
                <form-list name="SettingsIndex" list="entries" skip-form="true" paginate="false">
                    <field name="title">
                        <default-field title="Settings">
                            <link url="${url}" url-type="plain" text="${title}" link-type="anchor"/>
                        </default-field>
                    </field>
                    <field name="groupName"><default-field title="Group"><display/></default-field></field>
                    <field name="ownerApp"><default-field title="App"><display/></default-field></field>
                    <field name="description"><default-field title="What it covers"><display/></default-field></field>
                    <field name="scopeName"><default-field title="Applies to"><display/></default-field></field>
                    <field name="configuredBy"><default-field title="Configured by"><display/></default-field></field>
                    <field name="readinessUrl">
                        <default-field title="Readiness">
                            <link url="${readinessUrl}" url-type="plain" text="Readiness" link-type="anchor" condition="readinessUrl"/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column><field-ref name="title"/><field-ref name="ownerApp"/></column>
                        <column><field-ref name="groupName"/><field-ref name="readinessUrl"/></column>
                    </columns>
                </form-list>
                <label type="p" style="q-pa-md m-muted" condition="!entries.length &amp;&amp; filtered" text="No setting matches."/>
                <label type="p" style="q-pa-md m-muted" condition="!entries.length &amp;&amp; !filtered &amp;&amp; !failure"
                        text="No app's settings are open to you. Each app's administrators configure its settings."/>
            </box-body-nopad>
        </container-box>
    </widgets>
</screen>
