<!-- SettingsHome (design-admin §7 SettingsHome, §14.2; mr-moqui plans/archive/Admin-Screens-Down.md A6): the framework's System ›
    Settings settings index at this location, which BOSS_ADM_SETTINGS_INDEX opens to every BOSS user (a non-inheritable ALLOW;
    impl-admin F46), as a warehouse manager reaching Warehouse's settings, and the Settings area to every Admin user. The
    index is org.moqui.admin.ReadinessServices.find#Settings: each app's settings landing, shown only when the user's own
    groups open its screen and its view permission holds, linked by Admin's mount (Admin.js settingsRoutes; an app's settings
    as its own page). The screen has no transition. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Settings index" menu-image="sym_o_tune" menu-image-type="icon">
    <parameter name="text"/>
    <parameter name="ownerApp"/>
    <parameter name="settingsGroupEnumId"/>

    <widgets>
        <include-screen location="component://tools/screen/System/Settings/SettingsHome.xml" share-scope="true"/>
    </widgets>
</screen>
