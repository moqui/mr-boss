<!-- Organizations (design-admin §7 Organizations; style-guide §3.2 List): the internal organizations (OrgInternal parties) the user
    administers, from Mantle's mantle.party.IdentityServices.find#InternalOrganizations (ADMIN_SETTINGS_VIEW; the organization
    entity filters of the area's grant: a delegate's organization and its child organizations, the administrator's every one with
    none active). OrganizationFind narrows by name or identifier and parent; OrganizationList shows each with its parent and its
    setup checks still to do (org.moqui.admin.ReadinessServices.get#Readiness, the checks the user may read), and opens
    OrganizationDetail. CreateOrganization (create#InternalOrganization, ADMIN_SETTINGS_MANAGE) makes the party, its OrgInternal role
    and its parent, which must be one of the user's organizations unless they administer every one; it sets up no accounting,
    membership or secret (Accounting's setup is a SetupLink on OrganizationDetail). Departments and teams are People's. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Organizations" menu-image="sym_o_corporate_fare" menu-image-type="icon">
    <parameter name="text"/>
    <parameter name="parentPartyId"/>
    <parameter name="pageIndex"/>

    <transition name="choices" read-only="true">
        <actions>
            <service-call name="ironstone.admin.ContextServices.get#Choices" out-map="found"
                    in-map="{appRoot:appRoot, choice:choice, term:term, selected:selected}"/>
            <script>ec.web.sendJsonResponse(found.options)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition name="createOrganization">
        <actions>
            <service-call name="mantle.party.IdentityServices.create#InternalOrganization" out-map="created"
                    in-map="{organizationName:organizationName, pseudoId:(pseudoId || null), parentPartyId:(parentPartyId || null)}"/>
            <if condition="!ec.message.hasError()">
                <script>ec.message.addMessage(created.applied ? 'Organization created' : created.reason, created.applied ? 'success' : 'warning')</script>
            </if>
        </actions>
        <conditional-response url="../OrganizationDetail" condition="created?.applied">
            <parameter name="organizationPartyId" from="created.organizationPartyId"/></conditional-response>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <!-- a refusal is shown as its reason (AdminCalls.read; ignore-error would clear it, F129) -->
        <set field="called" from="ec.resource.script('component://framework/service/org/moqui/admin/AdminCalls.js').read('mantle.party.IdentityServices.find#InternalOrganizations', {text:(text || null), parentPartyId:(parentPartyId || null), pageIndex:(pageIndex || 0), pageSize:50}, 'The organizations are not available to you.')"/>
        <set field="found" from="called.out"/>
        <set field="failure" from="called.failure"/>
        <!-- the setup checks still to do of each organization, of those the user may read; none read when it cannot be checked -->
        <set field="readiness" from="ec.resource.script('component://mr-boss/template/AdminRegistry.js').readiness({}).out"/>
        <script><![CDATA[
            ec.message.clearErrors()
            const toDo = new Map()
            for (const check of Array.from(readiness?.checks || [])) {
                if (!check.organizationPartyId) continue
                const counts = toDo.get(check.organizationPartyId) || {open: 0, all: 0}
                counts.all++
                if (check.state !== 'ready') counts.open++
                toDo.set(check.organizationPartyId, counts)
            }
            organizations = Array.from(found?.organizationList || []).map(row => {
                const counts = toDo.get(row.organizationPartyId)
                return Object.assign({}, row, {
                    parentText: row.parentName || 'None',
                    setupText: !counts ? '' : counts.open ? counts.open + ' to check' : 'Ready'})
            })
            organizationListCount = found?.organizationListCount || 0
            canCreate = !!found?.canManage
            everyOrganization = !!found?.everyOrganization
            filtered = !!(text || parentPartyId)
            findValues = {text, parentPartyId}
        ]]></script>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Organizations" type="h5"/>
                <label text="The internal organizations you administer: the legal companies of this instance. Departments and teams are People's."
                        type="p" style="text-caption m-muted q-mb-none"/>
            </container>
            <container style="col-auto">
                <container-dialog id="CreateOrganizationDialog" button-text="New organization" icon="sym_o_domain_add" type="primary" width="560"
                        title="New internal organization" condition="canCreate">
                    <label type="p" text="Creates the organization and its place under its parent only. Accounting, members and connections are set up afterwards, each by whoever owns it."/>
                    <form-single name="CreateOrganization" transition="createOrganization" focus-field="organizationName">
                        <field name="organizationName"><default-field title="Name"><text-line size="40"/></default-field></field>
                        <field name="pseudoId"><default-field title="Identifier" tooltip="Empty makes one"><text-line size="20"/></default-field></field>
                        <field name="parentPartyId">
                            <default-field title="Belongs to" tooltip="${everyOrganization ? 'Empty makes a top-level organization' : 'One of your organizations'}">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'organizations'}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="submitButton"><default-field title="Create organization"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </container>
        </container>
        <form-single name="OrganizationFind" transition="." map="findValues">
            <field name="text"><default-field title="Name or identifier"><text-find size="20" hide-options="true"/></default-field></field>
            <field name="parentPartyId">
                <default-field title="Belongs to">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'organizations'}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="submitButton"><default-field title="Find"><submit/></default-field></field>
            <field-layout>
                <field-row-big>
                    <field-ref name="text"/>
                    <field-ref name="parentPartyId"/>
                    <field-ref name="submitButton"/>
                </field-row-big>
            </field-layout>
        </form-single>
        <label type="p" style="text-negative" condition="failure" text="${failure}"/>
        <container-box>
            <box-body-nopad>
                <form-list name="OrganizationList" list="organizations" skip-form="true" paginate="true">
                    <field name="organizationName">
                        <default-field title="Organization">
                            <link url="../OrganizationDetail" text="${organizationName}" link-type="anchor" parameter-map="{organizationPartyId:organizationPartyId}"/>
                        </default-field>
                    </field>
                    <field name="pseudoId"><default-field title="Identifier"><display/></default-field></field>
                    <field name="parentText"><default-field title="Belongs to"><display/></default-field></field>
                    <field name="childCount"><default-field title="Child organizations"><display/></default-field></field>
                    <field name="setupText"><default-field title="Setup"><display/></default-field></field>
                    <columns type="mobile">
                        <column><field-ref name="organizationName"/><field-ref name="pseudoId"/></column>
                        <column><field-ref name="parentText"/><field-ref name="setupText"/></column>
                    </columns>
                </form-list>
                <label type="p" style="q-pa-md m-muted" condition="!organizations.length &amp;&amp; filtered" text="No organization matches."/>
                <label type="p" style="q-pa-md m-muted" condition="!organizations.length &amp;&amp; !filtered &amp;&amp; !failure" text="You administer no organization."/>
                <label type="p" style="q-px-md q-pb-md m-muted" condition="organizationListCount &gt; organizations.length" text="Showing ${organizations.length} of ${organizationListCount}; narrow the search to see others."/>
            </box-body-nopad>
        </container-box>
    </widgets>
</screen>
