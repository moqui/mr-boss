<!-- Localization (design-admin §7 Localization; mr-moqui plans/Admin-Screens-Down.md): the framework's System › Settings
    localization at this location, which BOSS_ADM_ORGANIZATIONS opens to the configuration administrator and the
    administrator, with its two transitions: storeMessage and storeLabel, through org.moqui.admin.ConfigurationServices,
    which check ADMIN_SETTINGS_MANAGE, keep a translation's placeholders and translate only a registered label target.
    The System screen's own part for the instance administrator (the stored rows found, created, changed and deleted
    directly) is not shown under a mount and its transitions are not taken in, so they do not exist on this route.
    Products' own Translations screen translates product content. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Localization" menu-image="sym_o_translate" menu-image-type="icon">
    <parameter name="kind"/>
    <parameter name="locale"/>
    <parameter name="text"/>
    <parameter name="missing"/>
    <parameter name="targetKey"/>
    <parameter name="pageIndex"/>

    <transition-include name="storeMessage" location="component://tools/screen/System/Settings/Localization.xml"/>
    <transition-include name="storeLabel" location="component://tools/screen/System/Settings/Localization.xml"/>

    <widgets>
        <include-screen location="component://tools/screen/System/Settings/Localization.xml" share-scope="true"/>
    </widgets>
</screen>
