<!-- Localization (design-admin §7 Localization; style-guide §3.2 List): delegated translation for the configuration administrator,
    who is not an instance administrator (ADMIN keeps Tools System › Localization). LocalizationFind chooses messages or labels, a
    locale, text and whether to list what is missing in the locale. MessageTranslations are the message translations
    (org.moqui.admin.ConfigurationServices.find#LocalizedMessages, store#LocalizedMessage); EntityTranslations the translations of
    the registered label targets only (status, option, unit and place names: find#LocalizedEntityFields,
    store#LocalizedEntityField), never a business record's values. A translation must keep the original's ${} placeholders
    exactly and is saved at the revision read; an empty one removes it; each change is in the audit log. Reads need
    ADMIN_SETTINGS_VIEW and changes ADMIN_SETTINGS_MANAGE, checked by the framework services. Products' own Translations screen
    translates product content. For the configuration administrator and the administrator (BOSS_ADM_ORGANIZATIONS). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Localization" menu-image="sym_o_translate" menu-image-type="icon">
    <parameter name="kind"/>
    <parameter name="locale"/>
    <parameter name="text"/>
    <parameter name="missing"/>
    <parameter name="targetKey"/>
    <parameter name="pageIndex"/>

    <transition name="storeMessage">
        <actions>
            <service-call name="org.moqui.admin.ConfigurationServices.store#LocalizedMessage" out-map="stored"
                    in-map="{original:original, locale:translationLocale, localized:(localized || ''),
                        expectedRevision:(expectedRevision || ''), reason:(reason || null)}"/>
            <if condition="!ec.message.hasError()">
                <script>ec.message.addMessage(stored.applied ? 'Translation saved' : stored.reason, stored.applied ? 'success' : 'warning')</script>
            </if>
        </actions>
        <default-response url="."><parameter name="kind" value="messages"/><parameter name="locale"/><parameter name="text"/>
            <parameter name="missing"/><parameter name="pageIndex"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="storeLabel">
        <actions>
            <service-call name="org.moqui.admin.ConfigurationServices.store#LocalizedEntityField" out-map="stored"
                    in-map="{entityName:entityName, fieldName:fieldName, pkValue:pkValue, locale:translationLocale,
                        localized:(localized || ''), expectedRevision:(expectedRevision || ''), reason:(reason || null)}"/>
            <if condition="!ec.message.hasError()">
                <script>ec.message.addMessage(stored.applied ? 'Translation saved' : stored.reason, stored.applied ? 'success' : 'warning')</script>
            </if>
        </actions>
        <default-response url="."><parameter name="kind" value="labels"/><parameter name="locale"/><parameter name="text"/>
            <parameter name="missing"/><parameter name="targetKey"/><parameter name="pageIndex"/></default-response>
        <error-response url="."/>
    </transition>

    <actions>
        <set field="kind" from="kind == 'labels' ? 'labels' : 'messages'"/>
        <set field="wantMissing" from="missing == 'true' || missing == 'Y'"/>
        <set field="pageSize" from="50"/>
        <!-- a refusal is shown as its reason (AdminCalls.read; ignore-error would clear it, F129) -->
        <set field="called" from="kind == 'messages' ? ec.resource.script('component://mr-boss/service/ironstone/admin/AdminCalls.js').read('org.moqui.admin.ConfigurationServices.find#LocalizedMessages',
                {locale:(locale || null), text:(text || null), missing:wantMissing, pageIndex:(pageIndex || 0), pageSize:pageSize},
                'The translations are not available to you.')
            : ec.resource.script('component://mr-boss/service/ironstone/admin/AdminCalls.js').read('org.moqui.admin.ConfigurationServices.find#LocalizedEntityFields',
                {targetKey:(targetKey || null), locale:(locale || null), text:(text || null), missing:wantMissing, pageIndex:(pageIndex || 0),
                    pageSize:pageSize}, 'The translations are not available to you.')"/>
        <set field="found" from="called.out"/>
        <set field="failure" from="called.failure"/>
        <script><![CDATA[
            const placeholders = value => Array.from(new Set(String(value || '').match(/\$\{[^}]*\}/g) || [])).join(' ')
            messages = kind === 'messages' ? Array.from(found?.messageList || []).map((row, index) => Object.assign({}, row, {
                rowKey: 'm' + index, keepText: placeholders(row.original), translationLocale: row.locale})) : []
            labels = kind === 'labels' ? Array.from(found?.fieldList || []).map((row, index) => Object.assign({}, row, {
                rowKey: 'l' + index, keepText: placeholders(row.original), translationLocale: row.locale})) : []
            listCount = Number((kind === 'messages' ? found?.messageListCount : found?.fieldListCount) || 0)
            shownCount = messages.length + labels.length
            canManage = !!found?.canManage
            truncated = !!found?.truncated
            localeOptions = Array.from(found?.localeOptions || []).map(value => ({key: value, text: value}))
            targetOptions = Array.from(found?.targetList || []).map(row => ({key: row.targetKey, text: row.title}))
            kindOptions = [{key: 'messages', text: 'Messages'}, {key: 'labels', text: 'Labels'}]
            // missing translations are listed for one locale (and for labels one kind of label)
            missingNeeds = wantMissing && (!locale || (kind === 'labels' && !targetKey))
                ? (kind === 'labels' ? 'Choose a kind of label and a locale to list what is missing.' : 'Choose a locale to list what is missing.') : ''
            filtered = !!(locale || text || wantMissing || targetKey)
            findValues = {kind, locale, text, missing: wantMissing ? 'true' : '', targetKey}
            firstRow = Number(pageIndex || 0) * pageSize
        ]]></script>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Localization" type="h5"/>
                <label text="Translations of the messages people read and of the names of statuses, options, units and places. A translation keeps the original's \${...} values."
                        type="p" style="text-caption m-muted q-mb-none"/>
            </container>
            <container style="col-auto">
                <container-dialog id="NewMessageTranslationDialog" button-text="New translation" icon="sym_o_translate" type="primary" width="640"
                        title="Translate a message" condition="canManage &amp;&amp; kind == 'messages'">
                    <form-single name="NewMessageTranslation" transition="storeMessage" map="{translationLocale:locale}" focus-field="original">
                        <field name="original"><default-field title="Original" tooltip="The message exactly as it is shown in the default language"><text-area rows="2" cols="70" maxlength="255"/></default-field></field>
                        <field name="translationLocale"><default-field title="Locale" tooltip="A language (es) or a language and country (pt_BR)"><text-line size="8"/></default-field></field>
                        <field name="localized"><default-field title="Translation"><text-area rows="4" cols="70"/></default-field></field>
                        <field name="reason"><default-field title="Reason"><text-line size="50"/></default-field></field>
                        <field name="submitButton"><default-field title="Save translation"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </container>
        </container>
        <form-single name="LocalizationFind" transition="." map="findValues">
            <field name="kind">
                <default-field title="Translate">
                    <drop-down><list-options list="kindOptions" key="${key}" text="${text}"/></drop-down>
                </default-field>
            </field>
            <field name="targetKey">
                <default-field title="Kind of label" tooltip="For labels: status, option, unit or place names">
                    <drop-down allow-empty="true"><list-options list="targetOptions" key="${key}" text="${text}"/></drop-down>
                </default-field>
            </field>
            <field name="locale">
                <default-field title="Locale" tooltip="${localeOptions.length ? 'In use: ' + localeOptions.map(row =&gt; row.key).join(', ') : 'A language (es) or a language and country (pt_BR)'}">
                    <text-line size="8"/>
                </default-field>
            </field>
            <field name="text"><default-field title="Text"><text-line size="24"/></default-field></field>
            <field name="missing">
                <default-field title="Show">
                    <drop-down allow-empty="true"><option key="true" text="Missing in the locale"/></drop-down>
                </default-field>
            </field>
            <field name="submitButton"><default-field title="Find"><submit/></default-field></field>
            <field-layout>
                <field-row-big>
                    <field-ref name="kind"/>
                    <field-ref name="targetKey"/>
                    <field-ref name="locale"/>
                    <field-ref name="text"/>
                    <field-ref name="missing"/>
                    <field-ref name="submitButton"/>
                </field-row-big>
            </field-layout>
        </form-single>
        <label type="p" style="text-negative" condition="failure" text="${failure}"/>
        <label type="p" style="m-muted" condition="missingNeeds" text="${missingNeeds}"/>
        <section name="MessageSection" condition="kind == 'messages'">
            <widgets>
                <container-box>
                    <box-body-nopad>
                        <form-list name="MessageTranslations" list="messages" skip-form="true" paginate="false">
                            <field name="original"><default-field title="Original"><display/></default-field></field>
                            <field name="locale"><default-field title="Locale"><display/></default-field></field>
                            <field name="localized"><default-field title="Translation"><display text="${missing ? 'Not translated' : localized}"/></default-field></field>
                            <field name="actions">
                                <default-field title="">
                                    <container-dialog id="TranslateMessage_${rowKey}" button-text="${missing ? 'Translate' : 'Change'}" icon="sym_o_edit" width="640"
                                            title="${original}" condition="canManage">
                                        <label type="p" style="m-muted" condition="keepText" text="Keep exactly: ${keepText}"/>
                                        <form-single name="TranslateMessage" transition="storeMessage"
                                                map="{original:original, translationLocale:translationLocale, localized:localized, expectedRevision:revision,
                                                    locale:locale, text:text, missing:(wantMissing ? 'true' : ''), pageIndex:pageIndex}">
                                            <field name="original"><default-field><hidden/></default-field></field>
                                            <field name="translationLocale"><default-field><hidden/></default-field></field>
                                            <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                            <field name="localized"><default-field title="Translation (${translationLocale})" tooltip="Empty removes the translation"><text-area rows="4" cols="70"/></default-field></field>
                                            <field name="reason"><default-field title="Reason"><text-line size="50"/></default-field></field>
                                            <field name="submitButton"><default-field title="Save translation"><submit/></default-field></field>
                                        </form-single>
                                    </container-dialog>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="original"/><field-ref name="locale"/></column>
                                <column><field-ref name="localized"/><field-ref name="actions"/></column>
                            </columns>
                        </form-list>
                        <label type="p" style="q-pa-md m-muted" condition="!messages.length &amp;&amp; !failure &amp;&amp; !missingNeeds"
                                text="${filtered ? 'No message matches.' : 'No message is translated yet.'}"/>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
        <section name="LabelSection" condition="kind == 'labels'">
            <widgets>
                <container-box>
                    <box-body-nopad>
                        <form-list name="EntityTranslations" list="labels" skip-form="true" paginate="false">
                            <field name="targetTitle"><default-field title="Kind of label"><display/></default-field></field>
                            <field name="pkValue"><default-field title="Key"><display/></default-field></field>
                            <field name="original"><default-field title="Label"><display/></default-field></field>
                            <field name="locale"><default-field title="Locale"><display/></default-field></field>
                            <field name="localized"><default-field title="Translation"><display text="${missing ? 'Not translated' : localized}"/></default-field></field>
                            <field name="actions">
                                <default-field title="">
                                    <container-dialog id="TranslateLabel_${rowKey}" button-text="${missing ? 'Translate' : 'Change'}" icon="sym_o_edit" width="640"
                                            title="${targetTitle}: ${original || pkValue}" condition="canManage">
                                        <label type="p" style="m-muted" condition="keepText" text="Keep exactly: ${keepText}"/>
                                        <form-single name="TranslateLabel" transition="storeLabel"
                                                map="{entityName:entityName, fieldName:fieldName, pkValue:pkValue, translationLocale:translationLocale,
                                                    localized:localized, expectedRevision:revision, locale:locale, text:text,
                                                    missing:(wantMissing ? 'true' : ''), targetKey:targetKey, pageIndex:pageIndex}">
                                            <field name="entityName"><default-field><hidden/></default-field></field>
                                            <field name="fieldName"><default-field><hidden/></default-field></field>
                                            <field name="pkValue"><default-field><hidden/></default-field></field>
                                            <field name="translationLocale"><default-field><hidden/></default-field></field>
                                            <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                            <field name="targetKey"><default-field><hidden/></default-field></field>
                                            <field name="localized"><default-field title="Translation (${translationLocale})" tooltip="Empty removes the translation"><text-area rows="3" cols="70"/></default-field></field>
                                            <field name="reason"><default-field title="Reason"><text-line size="50"/></default-field></field>
                                            <field name="submitButton"><default-field title="Save translation"><submit/></default-field></field>
                                        </form-single>
                                    </container-dialog>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="original"/><field-ref name="locale"/></column>
                                <column><field-ref name="localized"/><field-ref name="actions"/></column>
                            </columns>
                        </form-list>
                        <label type="p" style="q-pa-md m-muted" condition="!labels.length &amp;&amp; !failure &amp;&amp; !missingNeeds"
                                text="${filtered ? 'No label matches.' : 'No label is translated yet. Choose a kind of label and a locale, and show what is missing, to start.'}"/>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
        <section name="Paging" condition="listCount &gt; shownCount || firstRow &gt; 0">
            <widgets>
                <container style="row items-center q-gutter-sm q-mt-xs">
                    <link url="." text="Previous" link-type="anchor" condition="firstRow &gt; 0"
                            parameter-map="{kind:kind, locale:locale, text:text, missing:(wantMissing ? 'true' : ''), targetKey:targetKey, pageIndex:(Number(pageIndex || 0) - 1)}"/>
                    <label text="${firstRow + 1} to ${firstRow + shownCount} of ${listCount}" style="m-muted"/>
                    <link url="." text="Next" link-type="anchor" condition="firstRow + shownCount &lt; listCount"
                            parameter-map="{kind:kind, locale:locale, text:text, missing:(wantMissing ? 'true' : ''), targetKey:targetKey, pageIndex:(Number(pageIndex || 0) + 1)}"/>
                </container>
            </widgets>
        </section>
        <label type="p" style="m-muted" condition="truncated" text="More than the search reads were found; add text to narrow it."/>
    </widgets>
</screen>
