<!-- InstanceSettings (design-admin §7 InstanceSettings; mr-moqui plans/Admin-Screens-Down.md): the framework's System ›
    Settings instance settings at this location, which BOSS_ADM_ORGANIZATIONS opens to the configuration administrator
    and the administrator, with its two transitions: valueOptions (the values a preference may take) and storePreference,
    through org.moqui.admin.ConfigurationServices, which check ADMIN_SETTINGS_VIEW and ADMIN_SETTINGS_MANAGE and change a
    registered preference only. The conf itself is linked for a user who opens System by their own grant. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Instance" menu-image="sym_o_tune" menu-image-type="icon">

    <transition-include name="valueOptions" location="component://tools/screen/System/Settings/InstanceSettings.xml"/>
    <transition-include name="storePreference" location="component://tools/screen/System/Settings/InstanceSettings.xml"/>

    <widgets>
        <include-screen location="component://tools/screen/System/Settings/InstanceSettings.xml" share-scope="true"/>
    </widgets>
</screen>
