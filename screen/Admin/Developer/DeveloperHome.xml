<!-- DeveloperHome (design-admin §13 DeveloperHome): ToolLinks, the framework's advanced tools the user may open
    (ironstone.admin.RegistryServices.find#ToolLinks: each checked with its app's own grant, Tools or System, and the permission
    its screen checks; the others left out). The tools keep their own checks and environment restrictions; Admin adds no raw
    shell, service-run field or database restore. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Developer tools" default-menu-include="false" menu-image="sym_o_construction" menu-image-type="icon">
    <actions>
        <service-call name="ironstone.admin.RegistryServices.find#ToolLinks" in-map="{appRoot:appRoot}" out-map="found"/>
        <set field="links" from="found.links || []"/>
    </actions>
    <widgets>
        <container-box>
            <box-header title="Developer tools"/>
            <box-body-nopad>
                <form-list name="ToolLinks" list="links" skip-form="true" paginate="false">
                    <field name="tool">
                        <default-field title="Tool">
                            <link url="${url}" url-type="plain" text="${tool}" link-type="anchor"/>
                        </default-field>
                    </field>
                    <field name="purpose"><default-field title="Purpose"><display/></default-field></field>
                    <field name="appName"><default-field title="In"><display/></default-field></field>
                    <field name="permission"><default-field title="Also needs"><display/></default-field></field>
                    <columns type="mobile">
                        <column><field-ref name="tool"/><field-ref name="purpose"/></column>
                        <column><field-ref name="appName"/></column>
                    </columns>
                </form-list>
                <label type="p" style="q-pa-md m-muted" condition="!links.length"
                        text="No developer tool is open to you. Tools and System are granted by an instance administrator."/>
            </box-body-nopad>
        </container-box>
    </widgets>
</screen>
