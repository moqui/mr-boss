<!-- IronStone Sales (design-sales §1): the root of the app for representatives, managers, approvers, commercial-change operators,
    agreement keepers, readers and administrators. The root user group BOSS_SALES and the administrator group BOSS_SALES_ADMIN open
    it (data/BossSetupSalesData.xml, data/BossSetupData.xml), as ADMIN does (impl-sales F1: the grant was live for ADMIN and
    BOSS_SALES_ADMIN before P1, whatever this comment said). The root grant opens navigation only:
    ironstone.sales.ContextServices.get#SharedContext checks the user and resolves their capabilities, organizations and links for
    every subscreen, and each Mantle sales service checks the permissions and the organization again (mantle/sales/SalesAccess.js).
    The menu of design §1.2 grows by phase: P1 builds Home (every Sales user's) and Reports (a holder of SALES_REPORT_VIEW,
    BOSS_SAL_REPORTS), P2 Settings (BOSS_SAL_SETTINGS), P3 Accounts, P4 Pipeline (Opportunities and Leads, a Sales reader's); each later
    phase adds its area, and the design's later entries stay absent. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Sales" menu-image="sym_o_handshake" menu-image-type="icon">

    <always-actions>
        <set field="appRoot" value="Sales"/>

        <!-- the search settings the party and product lookups of the reports use (template/SearchTransitions.xml) -->
        <set field="searchIndexName" value="mantle"/>
        <set field="searchLinkSets" value="boss"/>
        <set field="searchProductDocType" value="MantleProduct"/>
        <set field="searchPartyDocType" value="MantleParty"/>

        <service-call name="mantle.party.PartyServices.setup#UserOrganizationInfo" out-map="context"/>
        <service-call name="ironstone.sales.ContextServices.get#SharedContext" in-map="{appRoot:appRoot}" out-map="sales"/>
        <!-- the record panels serve Sales' own record hosts only (the People P2, Insights P12 and Maintenance P1 mount lesson): this
            root's inheritable grant would otherwise open the notes and files of any record get#RecordLinkInfo admits to a user given
            Sales without Commons. P3: a party that is an account of the user's sales scope or a contact of one (Sales.js recordKinds
            contact, as Customer360's Files and ContactDetail's Activity and Files show it); the opportunity P4, the quote and order
            P7 and P11 and the agreement P15 join with their checks. A panel request with no record (a person search, an avatar)
            names none. -->
        <script><![CDATA[
            const pathNames = Array.from(sri.getScreenUrlInfo().fullPathNameList || []).map(String)
            const panelName = pathNames[pathNames.indexOf('Sales') + 1]
            const wanted = ec.context.recordEntity
            if ((panelName === 'Chatter' || panelName === 'RecordFiles') && wanted) {
                let entityName = String(wanted)
                try { entityName = ec.entity.makeValue(entityName).getEntityName() } catch (error) { entityName = '' }
                // P4: a lead or opportunity the user sees (Sales.js recordKinds opportunity, SalesAccess.js opportunityOf)
                const panelHosts = {'mantle.party.Party': 'contact', 'mantle.sales.opportunity.SalesOpportunity': 'opportunity'}
                if (!Object.hasOwn(panelHosts, entityName))
                    throw new Error('RECORD_PANEL_UNAVAILABLE: Notes and files of this record are kept in the app that owns it')
                panelRecordType = panelHosts[entityName]
            }
        ]]></script>
        <!-- the check is a service-call of the read-only check#Record, as Maintenance's root does -->
        <if condition="panelRecordType">
            <service-call name="ironstone.sales.ContextServices.check#Record" out-map="panelRecord" ignore-error="true"
                    in-map="{appRoot:'Sales', recordType:panelRecordType, recordId:ec.context.recordId || ''}"/>
            <script>if (!ec.context.panelRecord?.recordId) throw new Error('RECORD_PANEL_UNAVAILABLE: Notes and files of this record are not available')</script>
        </if>
        <set field="sharedLinks" from="sales.sharedLinks"/>
    </always-actions>

    <subscreens default-item="Home" always-use-full-path="true">
        <!-- the record panels the chatter and record-files elements load under this app root, hidden from the menu
            (the theme values STRT_CHATTER_SCREEN and STRT_RECORD_FILES_SCREEN; impl-drawers-commons.md R5) -->
        <subscreens-item name="Chatter" location="component://mr-boss/screen/Shared/Chatter.xml" menu-include="false"/>
        <subscreens-item name="RecordFiles" location="component://mr-boss/screen/Shared/RecordFiles.xml" menu-include="false"/>
        <!-- P1: Reports (design §8), for a holder of SALES_REPORT_VIEW (BOSS_SAL_REPORTS denies the root user group and opens it to
            the manager and the reader); Mantle's SalesReportServices check the permission and the organization again -->
        <subscreens-item name="Reports" location="component://mr-boss/screen/Sales/Reports.xml" menu-index="7"
                menu-include="ec.user.hasPermission('SALES_REPORT_VIEW')"/>
        <!-- P4: Pipeline (design §3): Opportunities and Leads, OpportunityDetail and WorkItemDetail, for a user who reads Sales; Mantle's
            opportunity services scope every read to the user's organizations and assignments -->
        <subscreens-item name="Pipeline" location="component://mr-boss/screen/Sales/Pipeline.xml" menu-index="2"
                menu-include="ec.user.hasPermission('SALES_VIEW') || ec.user.hasPermission('SALES_TEAM_VIEW') || ec.user.hasPermission('SALES_REPORT_VIEW')"/>
        <!-- P3: Accounts (design §4), for a user who reads Sales (SALES_VIEW, SALES_TEAM_VIEW or SALES_REPORT_VIEW): Accounts,
            Contacts, the shared Customer360 and ContactDetail, MergeAccounts for the manager and the administrator -->
        <subscreens-item name="Accounts" location="component://mr-boss/screen/Sales/Accounts.xml" menu-index="3"
                menu-include="ec.user.hasPermission('SALES_VIEW') || ec.user.hasPermission('SALES_TEAM_VIEW') || ec.user.hasPermission('SALES_REPORT_VIEW')"/>
        <!-- P2: Settings (design §9), the administrator's (SALES_CONFIGURE) and, for Teams, the manager's (SALES_TEAM_MANAGE);
            BOSS_SAL_SETTINGS denies the root user group and opens it to the manager; Mantle's setup services check again -->
        <subscreens-item name="Settings" location="component://mr-boss/screen/Sales/Settings.xml" menu-index="8"
                menu-include="ec.user.hasPermission('SALES_CONFIGURE') || ec.user.hasPermission('SALES_TEAM_MANAGE')"/>
    </subscreens>

    <!-- P1: the sales keymap (design §1.2). The palette source (P3, P4), quick create (P6), Today (P6), the Comms providers (P5)
        and the notification topics (P9, P14) arrive with their records. -->
    <shell-providers>
        <!-- P3: the palette's Sales records, accounts first, P4 the open leads and opportunities (ironstone.sales.ContextServices.search#Records,
            Mantle's scoped finds) -->
        <palette-source group="Sales" label="Sales records" icon="sym_o_handshake"
                service="ironstone.sales.ContextServices.search#Records" sequence="51"/>
        <!-- P5: the Comms hooks (design §1.4, F64; ironstone.sales.ContextServices over SalesComms.js): a lead's or opportunity's card,
            search and links in Comms (before Comms' own, which knows no Sales link), the caller's open deals in the ring bar and the
            call, and an inquirer who is no party yet as their lead's card (after Comms' own party card). Create lead on a message is
            Comms' create-from provider's kind lead and Log call on opportunity a dialog mounted in Calls (screen-extend/basic-comms). -->
        <record-lookup name="sales.records" service="ironstone.sales.ContextServices.lookup#Records" sequence="-5"/>
        <call-context name="sales.deals" service="ironstone.sales.ContextServices.get#CallContext"/>
        <contact-card name="sales.leads" service="ironstone.sales.ContextServices.get#ContactCard" sequence="50"/>
        <keymap scope="sales">
            <key keys="g s" label="Sales home" screen="Sales/Home"/>
            <!-- P3 -->
            <key keys="g a" label="Accounts" screen="Sales/Accounts/Accounts"/>
            <key keys="g c" label="Contacts" screen="Sales/Accounts/Contacts"/>
            <!-- P4 -->
            <key keys="g o" label="Opportunities" screen="Sales/Pipeline/Opportunities"/>
            <key keys="g l" label="Leads" screen="Sales/Pipeline/Leads"/>
        </keymap>
    </shell-providers>

    <widgets><subscreens-panel id="sales-panel" type="popup"/></widgets>
</screen>
