<!-- One review item (design-forum.md ReviewDetail, §13.4): the post as its author wrote it (sanitized), the reports and staff
    notes, and claim, decide and note forms. The revision guards each change: a decision on a stale view is refused by the
    forum and the page shows the current state again. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Review" default-menu-include="false">

    <parameter name="siteId"/>
    <parameter name="reviewId"/>
    <parameter name="scope"/>

    <transition name="claimReview">
        <service-call name="ironstone.comms.ModerationServices.claim#Review" in-map="context"/>
        <default-response url="." parameter-map="{siteId:siteId, reviewId:reviewId, scope:scope}"/>
    </transition>
    <transition name="decideReview">
        <actions>
            <service-call name="ironstone.comms.ModerationServices.decide#Review" in-map="context"/>
            <if condition="!ec.message.hasError()"><message type="success">Decision recorded</message></if>
        </actions>
        <conditional-response url="../Queue" parameter-map="{scope:scope}"><condition><expression>!ec.message.hasError()</expression></condition></conditional-response>
        <default-response url="." parameter-map="{siteId:siteId, reviewId:reviewId, scope:scope}"/>
    </transition>
    <transition name="addReviewNote">
        <service-call name="ironstone.comms.ModerationServices.add#ReviewNote" in-map="context"/>
        <default-response url="." parameter-map="{siteId:siteId, reviewId:reviewId, scope:scope}"/>
    </transition>

    <actions>
        <service-call name="ironstone.comms.ModerationServices.find#Scopes" out-map="scopesOut"/>
        <script><![CDATA[
            const scopes = Array.from(scopesOut.scopeList || [])
            review = null
            post = null
            reportList = []
            noteList = []
            if (siteId && reviewId && scopes.some((s) => s.siteId === siteId)) {
                const out = ec.service.sync().name('ironstone.comms.ModerationServices.get#Review').parameters({siteId, reviewId}).call()
                if (!ec.message.hasError()) {
                    review = out.review
                    post = out.post
                    reportList = Array.from(out.reportList || [])
                    noteList = Array.from(out.noteList || [])
                } else ec.message.clearErrors()
            }
            postHtml = post?.body || ''
            postText = String(postHtml).replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim()
        ]]></script>
    </actions>
    <widgets>
        <container style="q-mb-xs">
            <link url="../Queue" link-type="anchor" text="Moderation" icon="arrow_back" parameter-map="{scope:scope}"/>
        </container>
        <section name="NoReview" condition="!review"><widgets>
            <container-box type="warning"><box-header title="Review"/><box-body>
                <label type="p" text="This item is not in a site or category you moderate, or it was already decided."/>
            </box-body></container-box>
        </widgets></section>
        <section name="ReviewDetail" condition="review"><widgets>
            <label type="h5" text="${post?.title || review.targetType}"/>
            <label type="p" text="${review.reasonFamily} · ${review.state} · revision ${review.revision}" style="m-muted"/>
            <section name="ReviewPost" condition="post"><widgets>
                <container-box><box-header title="Post"/><box-body>
                    <render-mode><text type="qvt"><![CDATA[<div class="m-post">${postHtml}</div>]]></text><text type="tui"><![CDATA[${JSON.stringify({t: "text", text: postText})}]]></text></render-mode>
                </box-body></container-box>
            </widgets></section>
            <container-box><box-header title="Reports · ${reportList.length}"/><box-body-nopad>
                <form-list name="Reports" list="reportList">
                    <field name="reason"><header-field title="Reason"/><default-field><display/></default-field></field>
                    <field name="evidence"><header-field title="Evidence"/><default-field><display/></default-field></field>
                    <field name="createdAtText"><header-field title="When"/><default-field><display/></default-field></field>
                </form-list>
            </box-body-nopad></container-box>
            <container-box><box-header title="Staff notes · ${noteList.length}"/><box-body-nopad>
                <form-list name="Notes" list="noteList">
                    <field name="noteText"><header-field title="Note"/><default-field><display/></default-field></field>
                    <field name="createdAtText"><header-field title="When"/><default-field><display/></default-field></field>
                </form-list>
            </box-body-nopad></container-box>
            <container style="row q-gutter-sm q-mt-sm">
                <form-single name="ClaimReview" transition="claimReview">
                    <field name="siteId"><default-field><hidden/></default-field></field>
                    <field name="reviewId"><default-field><hidden/></default-field></field>
                    <field name="scope"><default-field><hidden/></default-field></field>
                    <field name="expectedRevision" from="review.revision"><default-field><hidden/></default-field></field>
                    <field name="submitButton"><default-field title="Claim"><submit/></default-field></field>
                </form-single>
            </container>
            <form-single name="DecideReview" transition="decideReview">
                <field name="siteId"><default-field><hidden/></default-field></field>
                <field name="reviewId"><default-field><hidden/></default-field></field>
                <field name="scope"><default-field><hidden/></default-field></field>
                <field name="expectedRevision" from="review.revision"><default-field><hidden/></default-field></field>
                <field name="decision"><default-field title="Decision">
                    <drop-down allow-empty="false"><option key="approved" text="Approve"/><option key="rejected" text="Reject"/><option key="dismissed" text="Dismiss"/></drop-down></default-field></field>
                <field name="reason"><default-field title="Reason"><text-line size="50"/></default-field></field>
                <field name="submitButton"><default-field title="Decide"><submit/></default-field></field>
                <field-layout><field-row-big><field-ref name="decision"/><field-ref name="reason"/><field-ref name="submitButton"/></field-row-big></field-layout>
            </form-single>
            <form-single name="AddReviewNote" transition="addReviewNote">
                <field name="siteId"><default-field><hidden/></default-field></field>
                <field name="reviewId"><default-field><hidden/></default-field></field>
                <field name="scope"><default-field><hidden/></default-field></field>
                <field name="noteText"><default-field title="Staff note"><text-area rows="3" cols="60"/></default-field></field>
                <field name="submitButton"><default-field title="Add note"><submit/></default-field></field>
            </form-single>
        </widgets></section>
    </widgets>
</screen>
