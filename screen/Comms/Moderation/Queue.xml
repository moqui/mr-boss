<!-- The review queue (design-forum.md ReviewQueue, §13.4): pick a site or bound category you moderate, see its open items
    oldest first with what each concerns, open one, or decide several at once (the forum answers per item). Anyone who
    moderates nothing sees a short note; every transition is checked again by the forum. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Moderation" default-menu-include="false">

    <parameter name="scope"/>

    <transition name="decideReviews">
        <actions><script><![CDATA[
            const ids = String(selectedReviewIds || '').split(',').map((id) => id.trim()).filter((id) => id)
            if (!ids.length) { ec.message.addError(ec.l10n.localize('Select the items to decide')); return }
            const out = ec.service.sync().name('ironstone.comms.ModerationServices.decide#Reviews').parameters({
                siteId: String(scope || '').split('|')[0], reviewIdList: ids, decision, reason}).call()
            if (ec.message.hasError()) return
            const failed = (out.resultList || []).filter((r) => !r.ok).length
            ec.message.addMessage(ec.resource.expand('${done} decided${failed ? ", " + failed + " not changed" : ""}', '',
                {done: (out.resultList || []).length - failed, failed}), failed ? 'warning' : 'success')
        ]]></script></actions>
        <default-response url="." parameter-map="{scope:scope}"/>
    </transition>

    <actions>
        <service-call name="ironstone.comms.ModerationServices.find#Scopes" out-map="scopesOut"/>
        <script><![CDATA[
            scopeList = Array.from(scopesOut.scopeList || [])
            if (!scope && scopeList.length) scope = scopeList[0].key
            if (scope && !scopeList.some((s) => s.key === scope)) scope = scopeList[0]?.key || null
            reviewList = scope ? Array.from(ec.service.sync().name('ironstone.comms.ModerationServices.find#Reviews')
                .parameters({scope}).call()?.reviewList || []) : []
        ]]></script>
    </actions>
    <widgets>
        <section name="NotModerator" condition="!scopeList.length"><widgets>
            <container-box type="warning"><box-header title="Moderation"/><box-body>
                <label type="p" text="You moderate no forum site or category. Site owners name moderators in the forum's member settings."/>
                <link url="//Comms/Inbox" link-type="anchor" text="Back to the Inbox"/>
            </box-body></container-box>
        </widgets></section>
        <section name="ModerationQueue" condition="scopeList.length"><widgets>
            <label type="h5" text="Moderation"/>
            <label type="p" text="Posts and members waiting for a decision, oldest first. A decision here is the forum's decision: it is audited and the member is told." style="m-muted"/>
            <form-single name="ScopeFind" transition=".">
                <field name="scope"><default-field title="Site or category">
                    <drop-down allow-empty="false"><list-options list="scopeList" key="${key}" text="${text}"/></drop-down></default-field></field>
                <field name="findButton"><default-field title="Show"><submit icon="sym_o_search"/></default-field></field>
                <field-layout><field-row-big><field-ref name="scope"/><field-ref name="findButton"/></field-row-big></field-layout>
            </form-single>
            <container-box><box-header title="Waiting · ${reviewList.length}"/><box-body-nopad>
                <form-list name="Reviews" list="reviewList" multi="true" transition="decideReviews">
                    <row-selection id-field="reviewId" parameter="selectedReviewIds" list-mode="true">
                        <action><dialog button-text="Decide selected" button-icon="sym_o_gavel" title="Decide the selected items"/>
                            <form-single name="BulkDecide" transition="decideReviews">
                                <field name="scope"><default-field><hidden default-value="${scope}"/></default-field></field>
                                <field name="decision"><default-field title="Decision">
                                    <drop-down allow-empty="false"><option key="approved" text="Approve"/><option key="rejected" text="Reject"/><option key="dismissed" text="Dismiss"/></drop-down></default-field></field>
                                <field name="reason"><default-field title="Reason"><text-line size="50"/></default-field></field>
                                <field name="submitButton"><default-field title="Decide"><submit confirmation="Decide the selected items?"/></default-field></field>
                            </form-single></action>
                    </row-selection>
                    <field name="title"><header-field title="Concerns"/><default-field>
                        <link url="../Review" text="${title}" parameter-map="{siteId:siteId, reviewId:reviewId, scope:scope}"/></default-field></field>
                    <field name="reasonFamily"><header-field title="Reason"/><default-field><display/></default-field></field>
                    <field name="state"><header-field title="State"/><default-field><display/></default-field></field>
                    <field name="createdAtText"><header-field title="Waiting since"/><default-field><display/></default-field></field>
                    <columns type="mobile">
                        <column><field-ref name="title"/><field-ref name="reasonFamily"/></column>
                        <column><field-ref name="state"/><field-ref name="createdAtText"/></column>
                    </columns>
                </form-list>
                <section name="NoReviews" condition="!reviewList.length"><widgets>
                    <container style="q-pa-sm"><label type="p" text="Nothing is waiting here." style="m-muted q-mb-none"/></container>
                </widgets></section>
            </box-body-nopad></container-box>
        </widgets></section>
    </widgets>
</screen>
