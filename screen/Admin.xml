<!-- IronStone Admin (design-admin §1): the root of the app for system administrators and people delegated an administrative
    responsibility. The root user group BOSS_ADMIN and the administrator group BOSS_ADMIN_ADMIN open it (data/BossSetupData.xml),
    as ADMIN does; the root grant opens navigation only, and each screen and service checks its own permission
    (ironstone.admin.ContextServices.get#SharedContext resolves the organizations the user administers, the capabilities and the
    links for every subscreen). Its areas, in the menu order of design §1.2 by their menu-index: 1 Home; 2 Users (Users,
    UserDetail and Sessions in P4, Invitations and InviteStaff in P5, the identity operator's and the administrator's, BOSS_ADM_USERS); 3 Access (Groups and
    GroupDetail in P3, the access administrator's and the administrator's, BOSS_ADM_ACCESS); 5 Settings (the settings
    index in P2, every Admin user's; BOSS users without Admin are granted its SettingsHome alone, impl-admin F46; Organizations,
    OrganizationDetail and Constitution in P7, the configuration administrator's and the administrator's, BOSS_ADM_ORGANIZATIONS); 6 Integrations
    (Connections and ConnectionDetail in P11) and 7 Mail and protocols (MailRelays and MailRelayDetail in P11; ProtocolsHome,
    MailQueue and ServerConfiguration in P12, those three the operations operator's too, BOSS_ADM_PROTOCOLS_OPS), the integration
    administrator's and the administrator's (BOSS_ADM_INTEGRATIONS, BOSS_ADM_PROTOCOLS); 8 Operations
    (Health in P2, Monitoring in P1, the jobs with their phase); 11 Agents; 12 System, the framework's Tools System screens for ADMIN alone
    (impl-admin F2: BOSS_ADMIN and BOSS_ADMIN_ADMIN are denied System.xml, so Tools' SYSTEM_APP grant decides).
    Operations is the reader's, the operations operator's and the administrator's; Agents the
    administrator's (BOSS_ADM_<Area>). The framework's tools are linked at their own app (Home's Tools link), not listed here. The other areas of design §1.2 (Security, Settings, Integrations, Mail and
    protocols, Data, Audit and privacy) and Settings' other screens are added by the phases that build them. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Admin" menu-image="sym_o_admin_panel_settings" menu-image-type="icon">

    <always-actions>
        <set field="appRoot" value="Admin"/>

        <service-call name="mantle.party.PartyServices.setup#UserOrganizationInfo" out-map="context"/>
        <service-call name="ironstone.admin.ContextServices.get#SharedContext" in-map="{appRoot:appRoot}" out-map="admin"/>
        <set field="sharedLinks" from="admin.sharedLinks"/>
        <!-- the framework's administration screens shown under this root (the Tools System screens mounted or included in the
            areas; tools template/AdminMount.js): where their links go here. Set here so that their transitions read it too -->
        <set field="adminMount" from="admin.mount"/>
    </always-actions>

    <subscreens default-item="Home" always-use-full-path="true">
        <!-- the record panels the chatter and record-files elements load under this app root, hidden from the menu
            (the theme values STRT_CHATTER_SCREEN and STRT_RECORD_FILES_SCREEN; impl-drawers-commons.md R5) -->
        <subscreens-item name="Chatter" location="component://mr-boss/screen/Shared/Chatter.xml" menu-include="false"/>
        <subscreens-item name="RecordFiles" location="component://mr-boss/screen/Shared/RecordFiles.xml" menu-include="false"/>
        <!-- design §13 System: the Tools System screens (Access, Security, Settings, Operations, Data, Audit, Integrations, Print,
            Constitution, Llm and the rest), adding no grant: Tools' SYSTEM_APP authorization (ADMIN's) opens them -->
        <subscreens-item name="System" location="component://tools/screen/System.xml" menu-title="System" menu-index="12"/>
    </subscreens>

    <!-- palette types, quick create, Today sources, notification topics and Assist prompts grow with the phases that build their
        records (design §1.2): users, groups, connections and jobs in the palette; Invite users in quick create and the palette's actions (P5) -->
    <shell-providers>
        <!-- P2: Health's prompt (design §1.2), answered from the readiness tool admin_get_readiness with the user's own permissions -->
        <assist-prompt label="What is failing?" text="What is failing, and who fixes it?" screen="Admin/Operations/Health" sequence="10"/>
        <!-- P3: GroupDetail's prompt (design §1.2), answered with the user's own permissions from the page's group -->
        <assist-prompt label="What can members do?" text="Explain what this group's members can do, which grants are sealed or privileged, and who may change it"
                screen="Admin/Access/GroupDetail" entity="moqui.security.UserGroup" sequence="20"/>
        <!-- P4: UserDetail's prompt (design §1.2), answered with the user's own permissions from the page's account, and "Log as
            note", which files an Assist answer as a note on the page's user or group (Admin/LogNote) -->
        <assist-prompt label="Why can't this user sign in?" text="Why can't this user sign in? Check the account's state, sign-in lock, factor, allowed IPs and groups, and say who can fix it"
                screen="Admin/Users/UserDetail" entity="moqui.security.UserAccount" sequence="30"/>
        <response-action label="Log as note" icon="sym_o_sticky_note_2" screen="Admin/LogNote" text-parameter="noteText"
                requires-record="true" sequence="40"/>
        <!-- P3, P4: groups and users in the palette (search#Records: groups for an ADMIN_ACCESS_VIEW holder, the staff of the
            organizations administered for an ADMIN_IDENTITY_VIEW holder), each opening GroupDetail or UserDetail -->
        <!-- P5: Invite users in quick create and the palette's actions (design §1.2), each opening InviteStaff, which the Users
            area's grant opens to the identity operator and the administrator; invite#User checks ADMIN_IDENTITY_MANAGE -->
        <quick-create kind="adminInviteUsers" label="Invite users" icon="sym_o_person_add" screen="Admin/Users/InviteStaff" sequence="80"/>
        <palette-action label="Invite users" icon="sym_o_person_add" screen="Admin/Users/InviteStaff" sequence="50"/>
        <!-- P7: and the internal organizations administered, for an ADMIN_SETTINGS_VIEW holder, each opening OrganizationDetail -->
        <palette-source group="Admin" label="Admin users, groups and organizations" icon="sym_o_group" service="ironstone.admin.ContextServices.search#Records"
                sequence="60"/>
        <keymap scope="admin">
            <key keys="g a" label="Admin home" screen="Admin/Home"/>
            <key keys="g o" label="Monitoring" screen="Admin/Operations/Monitoring"/>
            <key keys="g n" label="Agents" screen="Admin/Agents/Home"/>
            <key keys="g y" label="System" screen="Admin/System"/>
        </keymap>
    </shell-providers>

    <widgets><subscreens-panel id="admin-panel" type="popup"/></widgets>
</screen>
