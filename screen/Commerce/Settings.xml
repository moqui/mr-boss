<!-- The Settings area of IronStone Commerce (design-commerce §8 CheckoutSettings): a store's checkout, recovery and
    recurring policies, linking Warehouse's Carriers and Accounting's PaymentMethods and TaxAuthorities (impl-commerce P6,
    P10, P12); for the manager (BOSS_COM_SETTINGS), who keeps them (COMMERCE_STORE_EDIT). CheckoutSettings is its one screen;
    RecoveryPolicy (P10) and RecurringPolicy (P12) are groups of it. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Settings" default-menu-index="10" menu-image="sym_o_settings" menu-image-type="icon">
    <subscreens default-item="CheckoutSettings" always-use-full-path="true">
        <subscreens-item name="CheckoutSettings" location="component://mr-boss/screen/Commerce/Settings/CheckoutSettings.xml"
                menu-title="Checkout" menu-index="1"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="CommerceSettingsPanel" type="tab"/>
    </widgets>
</screen>
