<!-- ChannelHealth (design-commerce §3 ChannelHealth; impl-commerce P14, COM-REPORTS): ReportScope (store, period) and the
    channel operator's outcomes (ironstone.commerce.ReportingServices.get#ChannelHealth over
    mantle.product.StoreChannelServices.get#ChannelHealth): channel messages by store, remote and message type (received,
    processed, errors, retried, last success; never a payload) and each current feed's state, last complete build, products,
    skips and failed builds in the period, each feed opening FeedDetail. The export holds the same rows. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Channel health" default-menu-index="5">
    <parameter name="productStoreId"/>
    <parameter name="interval"/>
    <parameter name="periodDate"/>
    <transition-include name="choices" location="component://mr-boss/template/CommerceParts.xml"/>
    <transition name="exportCsv" read-only="true" method="get">
        <actions>
            <service-call name="ironstone.commerce.ReportingServices.get#ChannelHealth" out-map="exported"
                    in-map="Object.assign({}, options, {appRoot:appRoot, output:'csv'})"/>
            <script>ec.web.sendTextResponse(exported.answer.csvText, 'text/csv', exported.answer.fileName)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <always-actions>
        <set field="options" from="{productStoreId:productStoreId || null, interval:interval || 'M', periodDate:periodDate || null}"/>
    </always-actions>
    <actions>
        <service-call name="ironstone.commerce.ReportingServices.get#ChannelHealth" out-map="found"
                in-map="Object.assign({}, options, {appRoot:appRoot})" transaction="force-new" ignore-error="true"/>
        <set field="reportError" from="ec.message.hasError() ? ec.message.getErrorsString().replace(/^[A-Z_]+: /, '') : null"/>
        <script>ec.message.clearErrors()</script>
        <set field="answer" from="found?.answer || null"/>
        <set field="reportFound" from="!!answer?.asOfText"/>
        <set field="messageRows" from="answer?.messages || []"/>
        <set field="feedRows" from="answer?.feeds || []"/>
        <set field="totals" from="answer?.totals || {}"/>
        <set field="intervalOptions" from="[{value:'d', label:'Day'}, {value:'w', label:'Week'}, {value:'M', label:'Month'},
                {value:'q', label:'Quarter'}, {value:'y', label:'Year'}]"/>
        <set field="exportParameters" from="options"/>
    </actions>
    <widgets>
        <container style="m-record-header">
            <container style="m-record-title">
                <label text="Channel health" type="h5"/>
                <label text="Channel messages and product feeds of your stores: what came in, what failed, and whether each feed is serving."
                        type="p" style="text-caption m-muted q-mb-none"/>
            </container>
            <container style="m-record-actions">
                <link url="${sharedLinks['Reports']}" text="All reports" icon="arrow_back" link-type="anchor-button"/>
            </container>
        </container>
        <form-single name="ReportScope" transition="." map="options">
            <field name="productStoreId">
                <default-field title="Store">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'stores', selected:productStoreId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="interval">
                <default-field title="Period">
                    <drop-down allow-empty="false">
                        <list-options list="intervalOptions" key="${value}" text="${label}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="periodDate">
                <default-field title="Holding the day" tooltip="Today when empty"><date-time type="date"/></default-field>
            </field>
            <field name="submit"><default-field title=""><submit text="Show report" type="primary"/></default-field></field>
            <field-layout>
                <field-row-big><field-ref name="productStoreId"/><field-ref name="interval"/><field-ref name="periodDate"/></field-row-big>
                <field-ref name="submit"/>
            </field-layout>
        </form-single>
        <section-include name="ReportFrame" location="component://mr-boss/template/CommerceReportParts.xml"/>
        <section-include name="ReportMissing" location="component://mr-boss/template/CommerceReportParts.xml"/>
        <section name="HealthSection" condition="reportFound">
            <widgets>
                <dashboard min-width="160">
                    <number-card title="Messages received" value="${totals.received ?? 0}" icon="sym_o_inbox" size="sm"/>
                    <number-card title="Message errors" value="${totals.messageErrors ?? 0}" icon="sym_o_sync_problem" size="sm"/>
                    <number-card title="Feeds failing or blocked" value="${totals.failingFeeds ?? 0}" icon="sym_o_rss_feed" size="sm"/>
                    <number-card title="Failed feed builds" value="${totals.feedFailures ?? 0}" icon="sym_o_error" size="sm"/>
                </dashboard>
                <container-box>
                    <box-header title="Channel messages"/>
                    <box-body-nopad>
                        <label text="No channel of these stores received a message in this period." type="p" style="q-pa-md m-muted"
                                condition="!messageRows.length"/>
                        <form-list name="ChannelMessages" list="messageRows" skip-form="true" paginate="false">
                            <field name="storeName"><default-field title="Store"><display/></default-field></field>
                            <field name="remoteText"><default-field title="Remote"><display/></default-field></field>
                            <field name="messageTypeText"><default-field title="Message type"><display/></default-field></field>
                            <field name="received" align="right"><default-field title="Received"><display/></default-field></field>
                            <field name="processed" align="right"><default-field title="Processed"><display/></default-field></field>
                            <field name="errors" align="right"><default-field title="Errors"><display/></default-field></field>
                            <field name="retried" align="right"><default-field title="Retried"><display/></default-field></field>
                            <field name="lastSuccessText"><default-field title="Last success"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="remoteText"/><field-ref name="storeName"/></column>
                                <column><field-ref name="received"/><field-ref name="errors"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
                <container-box>
                    <box-header title="Product feeds"/>
                    <box-body-nopad>
                        <label text="These stores have no current product feed." type="p" style="q-pa-md m-muted" condition="!feedRows.length"/>
                        <form-list name="ChannelFeeds" list="feedRows" skip-form="true" paginate="false">
                            <field name="feedName">
                                <default-field title="Feed">
                                    <link url="${sharedLinks['Integrations/FeedDetail']}" text="${feedName}" link-type="anchor"
                                            parameter-map="{productStoreFeedId:productStoreFeedId}"/>
                                </default-field>
                            </field>
                            <field name="storeName"><default-field title="Store"><display/></default-field></field>
                            <field name="stateText"><default-field title="State"><display/></default-field></field>
                            <field name="lastCompleteText"><default-field title="Last complete build"><display/></default-field></field>
                            <field name="rowsText" align="right"><default-field title="Products"><display/></default-field></field>
                            <field name="skippedText" align="right"><default-field title="Skipped"><display/></default-field></field>
                            <field name="failures" align="right"><default-field title="Failed builds"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="feedName"/><field-ref name="storeName"/></column>
                                <column><field-ref name="stateText"/><field-ref name="failures"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
