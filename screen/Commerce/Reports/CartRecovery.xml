<!-- CartRecovery (design-commerce §3 CartRecovery; impl-commerce P11, COM-REPORTS): ReportScope (store, period, currency) and
    the recovery funnel of the stores' Shop carts opened in the period (ironstone.commerce.ReportingServices.get#CartRecovery
    over mantle.order.StoreOperationsServices.get#CartRecoverySummary): carts opened, abandoned, signed in (the only carts a
    reminder may go to), recovery sends, delivered, recovered orders (the link used after the latest send and the order
    placed, F130) and their value, and placed, per store and currency and in total per currency. The export holds the same
    rows. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Cart recovery" default-menu-index="3">
    <parameter name="productStoreId"/>
    <parameter name="interval"/>
    <parameter name="periodDate"/>
    <parameter name="currencyUomId"/>
    <transition-include name="choices" location="component://mr-boss/template/CommerceParts.xml"/>
    <transition name="exportCsv" read-only="true" method="get">
        <actions>
            <service-call name="ironstone.commerce.ReportingServices.get#CartRecovery" out-map="exported"
                    in-map="Object.assign({}, options, {appRoot:appRoot, output:'csv'})"/>
            <script>ec.web.sendTextResponse(exported.answer.csvText, 'text/csv', exported.answer.fileName)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <always-actions>
        <set field="options" from="{productStoreId:productStoreId || null, interval:interval || 'M', periodDate:periodDate || null, currencyUomId:currencyUomId || null}"/>
    </always-actions>
    <actions>
        <service-call name="ironstone.commerce.ReportingServices.get#CartRecovery" out-map="found"
                in-map="Object.assign({}, options, {appRoot:appRoot})" transaction="force-new" ignore-error="true"/>
        <set field="reportError" from="ec.message.hasError() ? ec.message.getErrorsString().replace(/^[A-Z_]+: /, '') : null"/>
        <script>ec.message.clearErrors()</script>
        <set field="answer" from="found?.answer || null"/>
        <set field="reportFound" from="!!answer?.asOfText"/>
        <set field="recoveryRows" from="(answer?.rows || []).concat(answer?.totalRows || [])"/>
        <set field="intervalOptions" from="[{value:'d', label:'Day'}, {value:'w', label:'Week'}, {value:'M', label:'Month'},
                {value:'q', label:'Quarter'}, {value:'y', label:'Year'}]"/>
        <set field="currencyOptions" from="Array.from(new Set((answer?.currencies || []).concat(currencyUomId ? [currencyUomId] : []))).map(value => ({value, label:value}))"/>
        <set field="exportParameters" from="options"/>
    </actions>
    <widgets>
        <container style="m-record-header">
            <container style="m-record-title">
                <label text="Cart recovery" type="h5"/>
                <label text="The Shop carts opened in the period, each counted once; reminders go only to signed-in customers who turned cart reminders on."
                        type="p" style="text-caption m-muted q-mb-none"/>
            </container>
            <container style="m-record-actions">
                <link url="${sharedLinks['Reports']}" text="All reports" icon="arrow_back" link-type="anchor-button"/>
            </container>
        </container>
        <form-single name="ReportScope" transition="." map="options">
            <field name="productStoreId">
                <default-field title="Store">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'stores', selected:productStoreId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="interval">
                <default-field title="Period">
                    <drop-down allow-empty="false">
                        <list-options list="intervalOptions" key="${value}" text="${label}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="periodDate">
                <default-field title="Holding the day" tooltip="Today when empty"><date-time type="date"/></default-field>
            </field>
            <field name="currencyUomId">
                <default-field title="Currency" tooltip="Every currency, each apart, when empty">
                    <drop-down allow-empty="true">
                        <list-options list="currencyOptions" key="${value}" text="${label}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="submit"><default-field title=""><submit text="Show report" type="primary"/></default-field></field>
            <field-layout>
                <field-row-big><field-ref name="productStoreId"/><field-ref name="currencyUomId"/></field-row-big>
                <field-row-big><field-ref name="interval"/><field-ref name="periodDate"/></field-row-big>
                <field-ref name="submit"/>
            </field-layout>
        </form-single>
        <section-include name="ReportFrame" location="component://mr-boss/template/CommerceReportParts.xml"/>
        <section-include name="ReportMissing" location="component://mr-boss/template/CommerceReportParts.xml"/>
        <section name="RecoverySection" condition="reportFound">
            <widgets>
                <container-box>
                    <box-header title="Recovery funnel"/>
                    <box-body-nopad>
                        <label text="No cart was opened in this period." type="p" style="q-pa-md m-muted" condition="!recoveryRows.length"/>
                        <form-list name="RecoveryFunnel" list="recoveryRows" skip-form="true" paginate="false">
                            <field name="storeName"><default-field title="Store"><display/></default-field></field>
                            <field name="currencyUomId"><default-field title="Currency"><display/></default-field></field>
                            <field name="opened" align="right"><default-field title="Carts opened"><display/></default-field></field>
                            <field name="abandoned" align="right"><default-field title="Abandoned"><display/></default-field></field>
                            <field name="signedIn" align="right"><default-field title="Signed in"><display/></default-field></field>
                            <field name="sends" align="right"><default-field title="Recovery sends"><display/></default-field></field>
                            <field name="delivered" align="right"><default-field title="Delivered"><display/></default-field></field>
                            <field name="recovered" align="right"><default-field title="Recovered orders"><display/></default-field></field>
                            <field name="recoveredText" align="right"><default-field title="Recovered value"><display/></default-field></field>
                            <field name="placed" align="right"><default-field title="Placed"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="storeName"/><field-ref name="opened"/></column>
                                <column><field-ref name="abandoned"/><field-ref name="recovered"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
