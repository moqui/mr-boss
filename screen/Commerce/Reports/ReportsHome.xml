<!-- The report catalogue of IronStone Commerce (design-commerce §3; impl-commerce P11): the reports Commerce owns
    (ironstone.commerce.ReportingServices get#ReportCatalogue, the entries it registers for Insights' catalog later): each with
    what it shows, the filters it takes and its export, opening the report. Nothing is run or exported from here. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Reports" default-menu-index="1">
    <actions>
        <service-call name="ironstone.commerce.ReportingServices.get#ReportCatalogue" out-map="catalogue"
                in-map="{appRoot:appRoot}" transaction="force-new" ignore-error="true"/>
        <script>ec.message.clearErrors()</script>
        <set field="reportRows" from="catalogue?.reports || []"/>
    </actions>
    <widgets>
        <label text="Store reports" type="h5"/>
        <label text="Each report reads your stores only, as of the time it is run, with amounts per currency; its export holds the same rows."
                type="p" style="m-muted"/>
        <label text="No reports are available to you." type="p" condition="!reportRows.length"/>
        <form-list name="ReportCatalogue" list="reportRows" skip-form="true" paginate="false">
            <field name="title">
                <default-field title="Report">
                    <link url="${url}" url-type="plain" text="${title}" link-type="anchor" condition="url"/>
                </default-field>
            </field>
            <field name="description"><default-field title="What it shows"><display/></default-field></field>
            <field name="parameters"><default-field title="Filters"><display/></default-field></field>
            <field name="exportText"><default-field title="Export"><display/></default-field></field>
            <columns type="mobile">
                <column><field-ref name="title"/></column>
                <column><field-ref name="description"/></column>
            </columns>
        </form-list>
    </widgets>
</screen>
