<!-- Commerce Home (design-commerce §1.2, §3 Home; style-guide §3.1 Landing): HomeScope, the store selector (the user's stores,
    ironstone.commerce.ContextServices.get#Choices) and the period, the store checked by check#Record; WorkCards (approval,
    payment holds, fulfillment, unpaid, carts, reviews, integration errors) and PeriodStrip (orders, net sales and top product
    for the period against the previous one), each "Not configured" until the phases that measure them (P8 the work, P11 the
    strip), never zero; visits and conversion stay hidden without Marketing's tracking (impl-commerce §4). The first-use state
    (no store in the user's scope) opens Stores' NewStore for a store manager (P2). P8: the work counts
    (mantle.order.StoreOperationsServices.get#StoreWorkSummary: to approve, payment holds, to fulfill, unpaid, open carts,
    stuck placements and undelivered notices, each opening the scoped list for an order reader) and RecentOrders. P11: the
    period is a calendar day, week, month, quarter or year (this month by default) against the one before, and PeriodStrip
    reads ironstone.commerce.ReportingServices.get#HomePeriod: orders (Sales' orders.placed) and net sales (Accounting's net
    invoiced) per currency with their change, and the top product, the same totals Online sales shows for the store and
    period, each card opening it for a user of Reports; a strip that cannot be read says so and the work cards still show.
    P14: Integration errors counts a channel operator's channel message errors and failing or blocked feeds of the last 30
    days (get#ChannelHealth), opening Channel health. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Home" default-menu-index="1" menu-image="sym_o_dashboard" menu-image-type="icon">
    <parameter name="productStoreId"/>
    <parameter name="interval"/>
    <transition name="choices" read-only="true">
        <actions>
            <service-call name="ironstone.commerce.ContextServices.get#Choices" in-map="context" out-map="found"/>
            <script>ec.web.sendJsonResponse(found.options)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <actions>
        <set field="can" from="commerce.capabilities"/>
        <set field="hasStores" from="(commerce.storeOptions || []).length &gt; 0"/>
        <if condition="productStoreId">
            <service-call name="ironstone.commerce.ContextServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'store', recordId:productStoreId}"
                    out-map="store"
                    transaction="force-new"
                    ignore-error="true"/>
            <script>ec.message.clearErrors()</script>
            <set field="storeFound" from="!!store?.recordId"/>
        </if>
        <set field="periodOptions" from="[{value: 'd', label: 'Today'}, {value: 'w', label: 'This week'}, {value: 'M', label: 'This month'},
                {value: 'q', label: 'This quarter'}, {value: 'y', label: 'This year'}]"/>
        <set field="scope" from="{productStoreId: storeFound ? productStoreId : null, interval: ['d', 'w', 'M', 'q', 'y'].includes(interval) ? interval : 'M'}"/>
        <set field="scopeText" from="storeFound ? store.label : (commerce.storeLimited ? 'Your stores' : 'All your stores')"/>
        <!-- P11: the period strip of the stores in scope (a strip that cannot be read is said to be; the work still counts) -->
        <if condition="hasStores &amp;&amp; !(productStoreId &amp;&amp; !storeFound)">
            <service-call name="ironstone.commerce.ReportingServices.get#HomePeriod" out-map="strip" transaction="force-new"
                    ignore-error="true" in-map="{appRoot:appRoot, productStoreId:scope.productStoreId, interval:scope.interval}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="period" from="strip?.period || null"/>
        <set field="periodText" from="period ? period.periodText : ''"/>
        <set field="periodCards" from="period?.cards || []"/>
        <set field="salesLink" from="period?.canReports ? sharedLinks['Reports/OnlineSales'] + '?interval=' + scope.interval + (scope.productStoreId ? '&amp;productStoreId=' + encodeURIComponent(scope.productStoreId) : '') : ''"/>
        <!-- P8: the work counts and recent orders of the stores in scope (mantle.order.StoreOperationsServices.get#StoreWorkSummary;
            a count that cannot be read shows a dash, the others still count) -->
        <if condition="hasStores">
            <service-call name="mantle.order.StoreOperationsServices.get#StoreWorkSummary" out-map="work" transaction="force-new"
                    ignore-error="true" in-map="{productStoreId:scope.productStoreId}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="workCounts" from="work?.counts || {}"/>
        <set field="countText" from="Object.fromEntries(['toApprove', 'paymentHolds', 'toFulfill', 'unpaid', 'openCarts', 'stuckPlacements',
                'noticeExceptions'].map(key => [key, workCounts[key] == null ? '—' : String(workCounts[key])]))"/>
        <set field="recentOrders" from="work?.recentOrders || []"/>
        <!-- P14: the integration card, a channel operator's: channel message errors and failing or blocked feeds of the stores in
            scope over the last 30 days (mantle.product.StoreChannelServices.get#ChannelHealth), opening Channel health -->
        <if condition="hasStores &amp;&amp; can.channelOperate">
            <service-call name="mantle.product.StoreChannelServices.get#ChannelHealth" out-map="health" transaction="force-new"
                    ignore-error="true" in-map="{productStoreId:scope.productStoreId}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="integrationText" from="!can.channelOperate ? '—' : health?.totals ? String(health.totals.attention) : '—'"/>
        <set field="integrationLink" from="can.channelOperate &amp;&amp; can.reports ? sharedLinks['Reports/ChannelHealth'] + (scope.productStoreId ? '?productStoreId=' + encodeURIComponent(scope.productStoreId) : '') : ''"/>
        <set field="ordersPath" from="sharedLinks['Orders/Orders']"/>
        <set field="storeQuery" from="scope.productStoreId ? '&amp;productStoreId=' + encodeURIComponent(scope.productStoreId) : ''"/>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm">
            <container style="col"><label text="Commerce" type="h5"/></container>
        </container>
        <section name="FirstUse" condition="!hasStores">
            <widgets>
                <container-box>
                    <box-header title="No store yet"/>
                    <box-body>
                        <label text="No store of your organizations is open to you. A store manager starts one from Stores." type="p"
                                condition="!can.storeEdit"/>
                        <label text="Start with a store: its organization, warehouse, checkout and readiness checklist." type="p"
                                condition="can.storeEdit"/>
                        <link url="${sharedLinks['Stores']}" text="New store" link-type="anchor-button" btn-type="primary"
                                icon="sym_o_add" condition="can.storeEdit" parameter-map="{_openDialog:'NewStore'}"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="StoreHome" condition="hasStores">
            <widgets>
                <form-single name="HomeScope" transition="." map="scope">
                    <field name="productStoreId">
                        <default-field title="Store">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'stores', selected:scope.productStoreId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="interval">
                        <default-field title="Period">
                            <drop-down allow-empty="false">
                                <list-options list="periodOptions" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="submitButton"><default-field title="Show"><submit/></default-field></field>
                    <field-layout>
                        <field-row><field-ref name="productStoreId"/><field-ref name="interval"/></field-row>
                        <field-ref name="submitButton"/>
                    </field-layout>
                </form-single>
                <label text="Store ${productStoreId} is not available to you." type="p" style="text-negative"
                        condition="productStoreId &amp;&amp; !storeFound"/>
                <label text="${scopeText}${periodText ? ', ' + periodText : ''}" type="p" style="text-caption m-muted"/>
                <container-box>
                    <box-header title="Work to do"/>
                    <box-body>
                        <dashboard min-width="160">
                            <number-card title="To approve" value="${countText.toApprove}" icon="sym_o_approval" size="sm"
                                    link="${can.orders ? ordersPath + '?statusId=OrderPlaced' + storeQuery : ''}"/>
                            <number-card title="Payment holds" value="${countText.paymentHolds}" icon="sym_o_front_hand" size="sm"
                                    link="${can.orders ? ordersPath + '?attention=paymentHold' + storeQuery : ''}"/>
                            <number-card title="To fulfill" value="${countText.toFulfill}" icon="sym_o_local_shipping" size="sm"
                                    link="${can.orders ? ordersPath + '?statusId=OrderApproved' + storeQuery : ''}"/>
                            <number-card title="Unpaid" value="${countText.unpaid}" icon="sym_o_credit_card_off" size="sm"
                                    link="${can.orders ? ordersPath + '?payment=unpaid' + storeQuery : ''}"/>
                            <number-card title="Open carts" value="${countText.openCarts}" icon="sym_o_shopping_cart" size="sm"
                                    link="${can.orders ? sharedLinks['Orders/Carts'] + '?state=' + storeQuery : ''}"/>
                            <number-card title="Placements waiting" value="${countText.stuckPlacements}" icon="sym_o_pending_actions" size="sm"
                                    link="${can.orders ? ordersPath + '?attention=stuck' + storeQuery : ''}"/>
                            <number-card title="Notices not delivered" value="${countText.noticeExceptions}" icon="sym_o_mail_lock" size="sm"
                                    link="${can.orders ? ordersPath + '?attention=notice' + storeQuery : ''}"/>
                            <number-card title="Reviews" value="Not configured" icon="sym_o_reviews" size="sm"/>
                            <number-card title="Integration errors" value="${integrationText}" icon="sym_o_sync_problem" size="sm"
                                    link="${integrationLink}"/>
                        </dashboard>
                    </box-body>
                </container-box>
                <section name="RecentOrdersSection" condition="work?.canOrders"><widgets>
                <container-box>
                    <box-header title="Recent orders"/>
                    <box-body-nopad>
                        <form-list name="RecentOrders" list="recentOrders" skip-form="true" paginate="false">
                            <field name="orderId">
                                <default-field title="Order">
                                    <link url="${sharedLinks['Orders/OrderDetail']}" text="${orderId}" link-type="anchor" style="text-mono"
                                            parameter-map="{orderId:orderId}"/>
                                </default-field>
                            </field>
                            <field name="customerName"><default-field title="Customer"><display/></default-field></field>
                            <field name="placedText"><default-field title="Placed"><display/></default-field></field>
                            <field name="statusText"><default-field title="State"><display/></default-field></field>
                            <field name="totalText" align="right"><default-field title="Total"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="orderId"/><field-ref name="customerName"/></column>
                                <column><field-ref name="statusText"/><field-ref name="totalText"/></column>
                            </columns>
                        </form-list>
                        <label type="p" style="q-pa-md m-muted" condition="!recentOrders.length" text="No submitted order yet."/>
                    </box-body-nopad>
                </container-box>
                </widgets></section>
                <container-box>
                    <box-header title="This period against the previous one"/>
                    <box-body>
                        <label text="Sales could not be read just now; the work above still counts." type="p" style="m-muted"
                                condition="!period"/>
                        <label text="Left out: ${period.omittedText}" type="p" style="text-caption text-warning"
                                condition="period?.omittedText"/>
                        <label text="No sales in these stores yet: Orders 0, Net sales none." type="p" style="m-muted"
                                condition="period &amp;&amp; !periodCards.length"/>
                        <section-iterate name="PeriodStrip" list="periodCards" entry="card">
                            <widgets>
                                <dashboard min-width="160">
                                    <number-card title="Orders (${card.currencyUomId})" value="${card.ordersText}" icon="sym_o_receipt_long"
                                            size="sm" delta="${card.ordersDelta}" link="${salesLink}"/>
                                    <number-card title="Net sales (${card.currencyUomId})" value="${card.netText}" icon="sym_o_payments"
                                            size="sm" delta="${card.netDelta}" link="${salesLink}"/>
                                    <number-card title="Top product (${card.currencyUomId})" value="${card.topProductText}" icon="sym_o_star"
                                            size="sm" link="${salesLink}"/>
                                </dashboard>
                                <label text="${card.previousText}" type="p" style="text-caption m-muted"/>
                            </widgets>
                        </section-iterate>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
