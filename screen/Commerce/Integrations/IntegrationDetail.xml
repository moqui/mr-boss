<!-- IntegrationDetail (design-commerce §9 IntegrationDetail; style-guide §3.3 Detail; impl-commerce P13): one integration of
    the user's stores (mantle.product.StoreChannelServices get#StoreIntegration). Binding: its name and intake (enabled only
    once the operator has set its authentication and credentials in the System tools; never shown or entered here).
    Mapping: the registered mapping version and the connector's typed parameters (the customer orders are placed for, the
    sales channel). Messages: MessageFind (state, external ID) and the integration's messages (find#StoreMessages), each
    opening MessageDetail (get#StoreMessage: its outcome, the channel order's canonical fields, what its mapping finds, its
    order, the original of a replay or conflict, its errors' first lines; never the message's text). RetryMessages: the
    failed messages of the page retried with a reason (retry#StoreMessages, each its own transaction and identity, once per
    operation key), with each item's result. An EDI trading partner shows its rejected and quarantined transactions with
    the same retry; its binding is the EDI administrator's. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Integration" default-menu-include="false">
    <parameter name="systemMessageRemoteId" required="true"/>
    <parameter name="systemMessageId"/>
    <parameter name="state"/>
    <parameter name="term"/>
    <transition-include name="choices" location="component://mr-boss/template/CommerceParts.xml"/>
    <transition name="saveBinding">
        <actions>
            <service-call name="mantle.product.StoreChannelServices.store#StoreIntegration" out-map="saved"
                    in-map="{systemMessageRemoteId:systemMessageRemoteId, description:description, enabled:enabled,
                        expectedLastUpdatedStamp:(expectedLastUpdatedStamp || null)}"/>
            <if condition="!ec.message.hasError()"><message type="success">${saved.message}</message></if>
        </actions>
        <default-response url="."><parameter name="systemMessageRemoteId"/></default-response>
        <error-response url="."><parameter name="systemMessageRemoteId"/></error-response>
    </transition>
    <transition name="saveMapping">
        <actions>
            <service-call name="mantle.product.StoreChannelServices.store#StoreIntegration" out-map="saved"
                    in-map="{systemMessageRemoteId:systemMessageRemoteId, mappingVersion:(mappingVersion || null),
                        customerPartyId:(customerPartyId || ''), salesChannelEnumId:(salesChannelEnumId || ''),
                        expectedLastUpdatedStamp:(expectedLastUpdatedStamp || null)}"/>
            <if condition="!ec.message.hasError()"><message type="success">${saved.message}</message></if>
        </actions>
        <default-response url="."><parameter name="systemMessageRemoteId"/></default-response>
        <error-response url="."><parameter name="systemMessageRemoteId"/></error-response>
    </transition>
    <transition name="retryMessages">
        <actions>
            <service-call name="mantle.product.StoreChannelServices.retry#StoreMessages" out-map="retried"
                    in-map="{systemMessageRemoteId:systemMessageRemoteId, systemMessageIds:(systemMessageIds || null),
                        ediDocumentIds:(ediDocumentIds || null), reason:reason, operationKey:operationKey}"/>
            <if condition="!ec.message.hasError()">
                <message type="success">${retried.alreadyApplied ? 'Already retried: ' : ''}${retried.message}</message>
                <iterate list="retried.results" entry="result">
                    <message type="${result.ok ? 'success' : 'warning'}">${result.kind == 'ediDocument' ? 'EDI document' : 'Message'} ${result.id}: ${result.ok ? (result.stateText + (result.orderId ? ', order ' + result.orderId : '')) : (result.message || result.stateText || 'not retried')}</message>
                </iterate>
            </if>
        </actions>
        <default-response url="."><parameter name="systemMessageRemoteId"/></default-response>
        <error-response url="."><parameter name="systemMessageRemoteId"/></error-response>
    </transition>
    <actions>
        <service-call name="mantle.product.StoreChannelServices.get#StoreIntegration" out-map="found" transaction="force-new"
                ignore-error="true" in-map="{systemMessageRemoteId:systemMessageRemoteId}"/>
        <set field="failure" from="ec.message.hasError() ? ec.message.getErrorsString() : null"/>
        <script>ec.message.clearErrors()</script>
        <set field="integration" from="found?.integration || null"/>
        <set field="parameterFields" from="found?.parameterFields || []"/>
        <set field="mappingVersions" from="found?.mappingVersions || []"/>
        <set field="ediDocuments" from="found?.ediDocuments || []"/>
        <set field="ediInterchanges" from="found?.ediInterchanges || []"/>
        <set field="managed" from="!!integration?.managed"/>
        <set field="takesCustomer" from="parameterFields.some((field) =&gt; field.name == 'customerPartyId')"/>
        <if condition="integration">
            <service-call name="mantle.product.StoreChannelServices.find#StoreMessages" out-map="messagesFound" transaction="force-new"
                    ignore-error="true" in-map="{systemMessageRemoteId:systemMessageRemoteId, state:(state || null), term:(term || null),
                        pageIndex:pageIndex, pageSize:pageSize}"/>
            <set field="messagesFailure" from="ec.message.hasError() ? ec.message.getErrorsString() : null"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="messages" from="messagesFound?.messages || []"/>
        <set field="messagesCount" from="messagesFound?.messagesCount || 0"/>
        <set field="messagesPageIndex" from="messagesFound?.messagesPageIndex || 0"/>
        <set field="messagesPageSize" from="messagesFound?.messagesPageSize || 20"/>
        <set field="messagesPageMaxIndex" from="messagesFound?.messagesPageMaxIndex || 0"/>
        <set field="messagesPageRangeLow" from="messagesFound?.messagesPageRangeLow || 0"/>
        <set field="messagesPageRangeHigh" from="messagesFound?.messagesPageRangeHigh || 0"/>
        <set field="retryable" from="messages.filter((row) =&gt; row.retryable)"/>
        <set field="retryableDocuments" from="ediDocuments.filter((row) =&gt; row.retryable)"/>
        <if condition="integration &amp;&amp; systemMessageId">
            <service-call name="mantle.product.StoreChannelServices.get#StoreMessage" out-map="detail" transaction="force-new"
                    ignore-error="true" in-map="{systemMessageId:systemMessageId}"/>
            <set field="detailFailure" from="ec.message.hasError() ? ec.message.getErrorsString() : null"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="detailMessage" from="detail?.message || null"/>
        <set field="detailLines" from="detail?.summary?.lines || []"/>
        <set field="detailFindings" from="detail?.findings || []"/>
        <set field="detailChildren" from="detail?.children || []"/>
        <set field="detailErrors" from="detail?.errors || []"/>
        <set field="detailDocuments" from="detail?.ediDocuments || []"/>
        <set field="canOpenOrder" from="!!detail?.orderView"/>
        <set field="bindingValues" from="{systemMessageRemoteId:systemMessageRemoteId, description:integration?.description,
                enabled:(integration?.enabled ? 'Y' : 'N'), expectedLastUpdatedStamp:integration?.lastUpdatedStamp}"/>
        <set field="mappingValues" from="{systemMessageRemoteId:systemMessageRemoteId, mappingVersion:String(integration?.mappingVersion || ''),
                customerPartyId:integration?.customerPartyId, salesChannelEnumId:integration?.salesChannelEnumId,
                expectedLastUpdatedStamp:integration?.lastUpdatedStamp}"/>
        <set field="retryValues" from="{systemMessageRemoteId:systemMessageRemoteId, operationKey:'retry-' + ec.user.randomString(24)}"/>
        <set field="findValues" from="{systemMessageRemoteId:systemMessageRemoteId, state:state, term:term}"/>
    </actions>
    <widgets>
        <label type="p" style="text-negative" condition="failure" text="${failure}"/>
        <section name="IntegrationBody" condition="integration">
            <widgets>
                <container style="m-record-header q-mb-md">
                    <container style="row items-center q-col-gutter-sm">
                        <container style="col">
                            <label text="${integration.description}" type="h5"/>
                            <label text="${integration.connectorText} · ${integration.storeName}" type="div" style="m-muted"/>
                        </container>
                        <container style="col-auto">
                            <label text="${integration.healthText}" type="span"
                                    style="${integration.healthKey == 'failing' ? 'text-negative' : integration.healthKey == 'ok' ? 'text-positive' : 'text-warning'}"/>
                        </container>
                    </container>
                    <label type="div" style="text-caption m-muted"
                            text="Intake ${integration.enabled ? 'on' : 'stopped'} · Credentials: ${integration.credentialsText}${integration.authText ? ' · Authentication: ' + integration.authText : ''} · Last success: ${integration.lastSuccessText || 'none'} · ${integration.failureCount} failed, ${integration.conflictCount} conflicts${integration.exceptionCount ? ', ' + integration.exceptionCount + ' EDI exceptions' : ''}"/>
                </container>

                <container style="row q-col-gutter-md">
                    <container style="col-12 col-md-6">
                        <container-box>
                            <box-header title="Binding"/>
                            <box-body>
                                <label type="p" style="m-muted" condition="managed"
                                        text="An EDI trading partner's connection, profile and transport are the EDI administrator's; here its exceptions are worked and retried."/>
                                <form-single name="Binding" transition="saveBinding" map="bindingValues" condition="!managed">
                                    <field name="systemMessageRemoteId"><default-field><hidden/></default-field></field>
                                    <field name="expectedLastUpdatedStamp"><default-field><hidden/></default-field></field>
                                    <field name="description"><default-field title="Name"><text-line size="36"/></default-field></field>
                                    <field name="enabled">
                                        <default-field title="Intake" tooltip="Enabled once the operator has set the endpoint's authentication and credentials">
                                            <drop-down><option key="Y" text="On"/><option key="N" text="Stopped"/></drop-down>
                                        </default-field>
                                    </field>
                                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                                </form-single>
                                <label type="p" style="text-caption m-muted" condition="!managed"
                                        text="The endpoint, authentication and credentials are the operator's (System tools); Commerce never shows or takes them. Orders arrive at /rest/sm/StoreChannelOrders/${systemMessageRemoteId}."/>
                            </box-body>
                        </container-box>
                    </container>
                    <container style="col-12 col-md-6">
                        <container-box>
                            <box-header title="Mapping"/>
                            <box-body>
                                <form-single name="Mapping" transition="saveMapping" map="mappingValues" condition="!managed">
                                    <field name="systemMessageRemoteId"><default-field><hidden/></default-field></field>
                                    <field name="expectedLastUpdatedStamp"><default-field><hidden/></default-field></field>
                                    <field name="mappingVersion">
                                        <default-field title="Mapping version">
                                            <drop-down><list-options list="mappingVersions" key="${value}" text="${label}"/></drop-down>
                                        </default-field>
                                    </field>
                                    <field name="customerPartyId" hide="!takesCustomer">
                                        <default-field title="Customer" tooltip="The party the channel's orders are placed for">
                                            <drop-down allow-empty="true">
                                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                                        parameter-map="{choice:'customers', selected:mappingValues.customerPartyId}"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="salesChannelEnumId" hide="!takesCustomer">
                                        <default-field title="Sales channel">
                                            <drop-down allow-empty="true">
                                                <entity-options key="${enumId}" text="${description}">
                                                    <entity-find entity-name="moqui.basic.Enumeration" cache="true">
                                                        <econdition field-name="enumTypeId" value="SalesChannel"/>
                                                        <order-by field-name="description"/>
                                                    </entity-find>
                                                </entity-options>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="submitButton"><default-field title="Save mapping"><submit/></default-field></field>
                                </form-single>
                                <label type="p" condition="managed" text="EDI profile: ${integration.ediProfileId || 'none'}"/>
                            </box-body>
                        </container-box>
                    </container>
                </container>

                <section name="EdiExceptions" condition="managed">
                    <widgets>
                        <container-box>
                            <box-header title="Rejected and quarantined EDI transactions"/>
                            <box-body-nopad>
                                <form-list name="EdiDocuments" list="ediDocuments" skip-form="true">
                                    <field name="ediDocumentId"><default-field title="Document"><display/></default-field></field>
                                    <field name="transactionSetId"><default-field title="Set"><display/></default-field></field>
                                    <field name="businessKey"><default-field title="Reference"><display/></default-field></field>
                                    <field name="statusText"><default-field title="State"><display/></default-field></field>
                                    <field name="safeError"><default-field title="Reason"><display/></default-field></field>
                                    <field name="eventDateText"><default-field title="When"><display/></default-field></field>
                                </form-list>
                                <label type="p" style="q-pa-md m-muted" condition="!ediDocuments.length" text="No rejected EDI documents."/>
                                <form-list name="EdiInterchanges" list="ediInterchanges" skip-form="true" condition="ediInterchanges.length">
                                    <field name="ediInterchangeId"><default-field title="Quarantined interchange"><display/></default-field></field>
                                    <field name="controlNumber"><default-field title="Control"><display/></default-field></field>
                                    <field name="safeError"><default-field title="Reason"><display/></default-field></field>
                                    <field name="interchangeDateText"><default-field title="When"><display/></default-field></field>
                                </form-list>
                                <form-single name="RetryEdiDocuments" transition="retryMessages" map="retryValues" condition="retryableDocuments.length">
                                    <field name="systemMessageRemoteId"><default-field><hidden/></default-field></field>
                                    <field name="operationKey"><default-field><hidden/></default-field></field>
                                    <field name="ediDocumentIds">
                                        <default-field title="Retry">
                                            <check><list-options list="retryableDocuments" key="${ediDocumentId}" text="${transactionSetId} ${businessKey} (${statusText})"/></check>
                                        </default-field>
                                    </field>
                                    <field name="reason"><default-field title="Reason"><text-line size="40"/></default-field></field>
                                    <field name="submitButton"><default-field title="Retry selected"><submit confirmation="Retry the selected EDI documents with their identity?"/></default-field></field>
                                </form-single>
                            </box-body-nopad>
                        </container-box>
                    </widgets>
                </section>

                <container-box>
                    <box-header title="Messages"/>
                    <box-body>
                        <form-single name="MessageFind" transition="." map="findValues">
                            <field name="systemMessageRemoteId"><default-field><hidden/></default-field></field>
                            <field name="state">
                                <default-field title="State">
                                    <drop-down allow-empty="true">
                                        <option key="failed" text="Failed"/><option key="conflict" text="Conflicts"/>
                                        <option key="duplicate" text="Duplicates"/><option key="applied" text="Applied"/>
                                        <option key="waiting" text="Waiting"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="term"><default-field title="External or message ID"><text-line size="22"/></default-field></field>
                            <field name="submitButton"><default-field title="Find"><submit/></default-field></field>
                            <field-layout>
                                <field-row-big><field-ref name="state"/><field-ref name="term"/><field-ref name="submitButton"/></field-row-big>
                            </field-layout>
                        </form-single>
                        <label type="p" style="text-negative" condition="messagesFailure" text="${messagesFailure}"/>
                    </box-body>
                    <box-body-nopad>
                        <form-list name="Messages" list="messages" skip-form="true">
                            <field name="systemMessageId">
                                <default-field title="Message">
                                    <link url="." text="${systemMessageId}" link-type="anchor" style="text-mono"
                                            parameter-map="{systemMessageRemoteId:systemMessageRemoteId, systemMessageId:systemMessageId, state:state, term:term}"/>
                                </default-field>
                            </field>
                            <field name="kindText">
                                <default-field title="Kind">
                                    <label text="${kindText}" type="div"/>
                                    <label text="${directionText}" type="div" style="text-caption m-muted"/>
                                </default-field>
                            </field>
                            <field name="externalId"><default-field title="External ID"><display/></default-field></field>
                            <field name="stateText">
                                <default-field title="State">
                                    <label text="${stateText}" type="span"
                                            style="${stateKey == 'failed' || stateKey == 'rejected' ? 'text-negative' : stateKey == 'conflict' ? 'text-warning' : ''}"/>
                                </default-field>
                            </field>
                            <field name="attempts" align="right"><default-field title="Attempts"><display/></default-field></field>
                            <field name="receivedText"><default-field title="Received"><display/></default-field></field>
                            <field name="safeError"><default-field title="Error"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="systemMessageId"/><field-ref name="externalId"/></column>
                                <column><field-ref name="stateText"/><field-ref name="receivedText"/></column>
                            </columns>
                        </form-list>
                        <label type="p" style="q-pa-md m-muted" condition="!messages.length" text="No messages${state || term ? ' match' : ' yet'}."/>
                    </box-body-nopad>
                </container-box>

                <container-box condition="retryable.length">
                    <box-header title="Retry failed messages"/>
                    <box-body>
                        <form-single name="RetryMessages" transition="retryMessages" map="retryValues">
                            <field name="systemMessageRemoteId"><default-field><hidden/></default-field></field>
                            <field name="operationKey"><default-field><hidden/></default-field></field>
                            <field name="systemMessageIds">
                                <default-field title="Messages">
                                    <check><list-options list="retryable" key="${systemMessageId}" text="${systemMessageId} ${externalId}: ${safeError}"/></check>
                                </default-field>
                            </field>
                            <field name="reason"><default-field title="Reason"><text-line size="40"/></default-field></field>
                            <field name="submitButton">
                                <default-field title="Retry selected">
                                    <submit confirmation="Retry the selected messages? Each keeps its identity; an order already made is not made again."/>
                                </default-field>
                            </field>
                        </form-single>
                    </box-body>
                </container-box>

                <section name="MessageDetail" condition="systemMessageId">
                    <widgets>
                        <label type="p" style="text-negative" condition="detailFailure" text="${detailFailure}"/>
                        <container-box condition="detailMessage">
                            <box-header title="Message ${detailMessage.systemMessageId}: ${detailMessage.kindText} ${detailMessage.externalId}"/>
                            <box-body>
                                <label type="p" text="${detailMessage.stateText} · received ${detailMessage.receivedText}${detailMessage.processedText ? ' · processed ' + detailMessage.processedText : ''} · ${detailMessage.attempts} failed attempts"/>
                                <label type="p" style="text-negative" condition="detailMessage.safeError" text="${detailMessage.safeError}"/>
                                <section name="DetailOrder" condition="detail.order">
                                    <widgets>
                                        <link url="${sharedLinks['Orders/OrderDetail']}" condition="canOpenOrder" link-type="anchor"
                                                text="Order ${detail.order.orderId} · ${detail.order.statusText} · ${detail.order.totalText}" parameter-map="{orderId:detail.order.orderId}"/>
                                        <label type="p" condition="!canOpenOrder" text="Order ${detail.order.orderId} · ${detail.order.statusText} · ${detail.order.totalText}"/>
                                    </widgets>
                                </section>
                                <label type="p" condition="detail.original"
                                        text="Original: message ${detail.original?.systemMessageId} (${detail.original?.stateText}${detail.original?.order ? ', order ' + detail.original.order.orderId : ''})"/>
                                <label type="p" style="m-muted" condition="detail.summary"
                                        text="Channel order ${detail.summary?.externalId}${detail.summary?.placedDateText ? ', placed ' + detail.summary.placedDateText : ''} · ${detail.summary?.lineCount} lines${detail.summary?.shippingText ? ' · shipping ' + detail.summary.shippingText : ''}${detail.summary?.taxText ? ' · tax ' + detail.summary.taxText : ''}"/>
                            </box-body>
                            <box-body-nopad>
                                <form-list name="MessageLines" list="detailLines" skip-form="true" condition="detailLines.length">
                                    <field name="lineId"><default-field title="Line"><display/></default-field></field>
                                    <field name="productName"><default-field title="Product"><display/></default-field></field>
                                    <field name="quantity" align="right"><default-field title="Quantity"><display/></default-field></field>
                                    <field name="unitAmountText" align="right"><default-field title="Price"><display/></default-field></field>
                                </form-list>
                                <form-list name="MessageFindings" list="detailFindings" skip-form="true" condition="detailFindings.length">
                                    <field name="code"><default-field title="Mapping finding"><display/></default-field></field>
                                    <field name="message"><default-field title=" "><display/></default-field></field>
                                </form-list>
                                <form-list name="MessageOrders" list="detailChildren" skip-form="true" condition="detailChildren.length">
                                    <field name="systemMessageId">
                                        <default-field title="Order message">
                                            <link url="." text="${systemMessageId}" link-type="anchor" style="text-mono"
                                                    parameter-map="{systemMessageRemoteId:systemMessageRemoteId, systemMessageId:systemMessageId}"/>
                                        </default-field>
                                    </field>
                                    <field name="externalId"><default-field title="External ID"><display/></default-field></field>
                                    <field name="stateText"><default-field title="State"><display/></default-field></field>
                                    <field name="safeError"><default-field title="Error"><display/></default-field></field>
                                </form-list>
                                <form-list name="MessageDocuments" list="detailDocuments" skip-form="true" condition="detailDocuments.length">
                                    <field name="ediDocumentId"><default-field title="EDI document"><display/></default-field></field>
                                    <field name="transactionSetId"><default-field title="Set"><display/></default-field></field>
                                    <field name="statusText"><default-field title="State"><display/></default-field></field>
                                    <field name="safeError"><default-field title="Reason"><display/></default-field></field>
                                </form-list>
                                <form-list name="MessageErrors" list="detailErrors" skip-form="true" condition="detailErrors.length">
                                    <field name="errorDateText"><default-field title="Error at"><display/></default-field></field>
                                    <field name="text"><default-field title="Error"><display/></default-field></field>
                                </form-list>
                            </box-body-nopad>
                        </container-box>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
