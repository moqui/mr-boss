<!-- The Stores area of IronStone Commerce (design-commerce §3 Stores, StoreDetail, StoreGroups; impl-commerce P2): a menu group
    holding Stores (the default: StoreFind, the store list and NewStore) and Store groups, with StoreDetail (a store's
    configuration and readiness) hidden from the menu. Every Commerce user, each list and record limited to their stores
    (ironstone.commerce.ContextServices; a store-limited staff member's own) and read and saved through
    mantle.product.StoreAdminServices, which checks the permission and the store's organization again. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Stores" default-menu-index="2" menu-image="sym_o_sell" menu-image-type="icon">
    <subscreens default-item="Stores" always-use-full-path="true">
        <subscreens-item name="StoreDetail" location="component://mr-boss/screen/Commerce/Stores/StoreDetail.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="CommerceStoresPanel" type="tab"/>
    </widgets>
</screen>
