<!-- The Cases area of IronStone Customer Service (design-customer-service §1, §3; impl-customer-service P2): a menu group
    holding Cases (the default: CaseFind, CaseList and the board, the saved views and the bulk actions) and NewCase, with
    CaseDetail (the shared RequestDetail in the Customer Service context, crosscut §3.11) and WorkItemDetail (the shared
    WorkItemDetail, crosscut §3.12) hidden from the menu, with MergeCases and SplitCase (P8), opened from CaseDetail;
    ChannelSessions (P6) lists the
    calls, chats and mail of the cases and customers. Every
    Customer Service user, each list limited to the cases of their queues and those assigned to them. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Cases" default-menu-index="2" menu-image="sym_o_flag" menu-image-type="icon">
    <subscreens default-item="Cases" always-use-full-path="true">
        <subscreens-item name="CaseDetail" location="component://mr-boss/screen/Shared/RequestDetail.xml" menu-include="false"/>
        <subscreens-item name="WorkItemDetail" location="component://mr-boss/screen/Shared/WorkItemDetail.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="CustomerServiceCasesPanel" type="tab"/>
    </widgets>
</screen>
