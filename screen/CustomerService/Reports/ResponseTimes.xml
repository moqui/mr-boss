<!-- ResponseTimes (design-customer-service §7 ResponseTimes; impl-customer-service P14, CS-REPORTING): ResponseFind (organization,
    queue, team, priority band, channel, the metric: first response or resolution, the period, an as-of time, the grouping) and
    ResponseResults (ironstone.customerservice.ReportingServices.get#ResponseTimes): per group the count, median, p90 and mean in
    business time (each clock's calendar, less its pauses) and elapsed time, and the clocks still open with their median age.
    First response is an outward response the channel accepted (an acknowledgement or a note is none); each resolution episode
    counts, a reopen its own. The export holds the same rows -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Response times" default-menu-index="3">
    <parameter name="organizationPartyId"/>
    <parameter name="requestCategoryId"/>
    <parameter name="teamPartyId"/>
    <parameter name="fromDate"/>
    <parameter name="thruDate"/>
    <parameter name="asOf"/>
    <parameter name="groupBy"/>
    <parameter name="metric"/>
    <parameter name="bandEnumId"/>
    <parameter name="salesChannelEnumId"/>
    <transition-include name="choices" location="component://mr-boss/template/CustomerServiceParts.xml"/>
    <transition name="exportCsv" read-only="true" method="get">
        <actions>
            <service-call name="ironstone.customerservice.ReportingServices.get#ResponseTimes" out-map="exported"
                    in-map="Object.assign({}, options, {appRoot:appRoot, output:'csv'})"/>
            <script>ec.web.sendTextResponse(exported.answer.csvText, 'text/csv', exported.answer.fileName)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <always-actions>
        <set field="options" from="{organizationPartyId:organizationPartyId || null, requestCategoryId:requestCategoryId || null, teamPartyId:teamPartyId || null, fromDate:fromDate || null, thruDate:thruDate || null, asOf:asOf || null, groupBy:groupBy || null, metric:metric || null, bandEnumId:bandEnumId || null, salesChannelEnumId:salesChannelEnumId || null}"/>
    </always-actions>
    <actions>
        <service-call name="ironstone.customerservice.ReportingServices.get#ResponseTimes" out-map="found"
                in-map="Object.assign({}, options, {appRoot:appRoot})" transaction="force-new" ignore-error="true"/>
        <set field="reportError" from="ec.message.hasError() ? ec.message.getErrorsString().replace(/^[A-Z_]+: /, '') : null"/>
        <script>ec.message.clearErrors()</script>
        <set field="answer" from="found?.answer || null"/>
        <set field="reportFound" from="!!answer?.asOfText"/>
        <set field="groupRows" from="answer?.groupRows || []"/>
        <set field="totalRows" from="answer?.total ? [answer.total] : []"/>
        <set field="groupOptions" from="answer?.groupOptions || []"/>
        <set field="exportParameters" from="options"/>
    </actions>
    <widgets>
        <container style="m-record-header">
            <container style="m-record-title">
                <label text="Response times" type="h5"/>
                <label text="Business time counts each clock on its calendar, less its pauses; elapsed time is the clock on the wall. Median and p90 are of the clocks done in the period, with their count." type="p" style="text-caption m-muted q-mb-none"/>
            </container>
            <container style="m-record-actions">
                <link url="${sharedLinks['Reports']}" text="All reports" icon="arrow_back" link-type="anchor-button"/>
            </container>
        </container>
        <form-single name="ResponseFind" transition="." map="options">
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'organizations', selected:organizationPartyId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="requestCategoryId">
                <default-field title="Queue">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'reportQueues', selected:requestCategoryId, organizationPartyId:organizationPartyId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="teamPartyId">
                <default-field title="Team">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'reportTeams', selected:teamPartyId, organizationPartyId:organizationPartyId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="fromDate">
                <default-field title="From" tooltip="30 days before the end when empty"><date-time type="date"/></default-field>
            </field>
            <field name="thruDate">
                <default-field title="Through" tooltip="Today when empty"><date-time type="date"/></default-field>
            </field>
            <field name="asOf">
                <default-field title="As of" tooltip="Now when empty: an earlier time reads what was recorded by then"><date-time/></default-field>
            </field>
            <field name="groupBy">
                <default-field title="By">
                    <drop-down>
                        <list-options list="groupOptions" key="${value}" text="${label}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="metric">
                <default-field title="Metric">
                    <drop-down>
                        <option key="firstResponse" text="First response"/>
                        <option key="resolution" text="Resolution, each episode"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="bandEnumId">
                <default-field title="Priority">
                    <drop-down allow-empty="true">
                        <entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration" cache="true">
                                <econdition field-name="enumTypeId" value="CasePriorityBand"/>
                                <order-by field-name="description"/>
                            </entity-find>
                        </entity-options>
                    </drop-down>
                </default-field>
            </field>
            <field name="salesChannelEnumId">
                <default-field title="Channel">
                    <drop-down allow-empty="true">
                        <entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration" cache="true">
                                <econdition field-name="enumTypeId" value="SalesChannel"/>
                                <order-by field-name="description"/>
                            </entity-find>
                        </entity-options>
                    </drop-down>
                </default-field>
            </field>
            <field name="submit"><default-field title=""><submit text="Show report" type="primary"/></default-field></field>
            <field-layout>
                <field-row-big><field-ref name="organizationPartyId"/><field-ref name="requestCategoryId"/><field-ref name="teamPartyId"/></field-row-big>
                <field-row-big><field-ref name="metric"/><field-ref name="bandEnumId"/><field-ref name="salesChannelEnumId"/></field-row-big>
                <field-row-big><field-ref name="fromDate"/><field-ref name="thruDate"/><field-ref name="asOf"/><field-ref name="groupBy"/></field-row-big>
                <field-ref name="submit"/>
            </field-layout>
        </form-single>
        <section-include name="ReportFrame" location="component://mr-boss/template/CustomerServiceReportParts.xml"/>
        <section-include name="ReportMissing" location="component://mr-boss/template/CustomerServiceReportParts.xml"/>
        <section name="ResponseTotalSection" condition="reportFound">
            <widgets>
                <container-box>
                    <box-header title="${answer.metricText}"/>
                    <box-body-nopad>
                        <label text="No clock of this metric was done in the period." type="p" style="q-pa-md m-muted" condition="!totalRows.length"/>
                        <form-list name="ResponseTotal" list="totalRows" skip-form="true" paginate="false">
                        <field name="groupText"><default-field title="Scope"><display/></default-field></field>
                        <field name="count" align="right"><default-field title="Count"><display/></default-field></field>
                        <field name="businessMedianText" align="right"><default-field title="Median (business)"><display/></default-field></field>
                        <field name="businessP90Text" align="right"><default-field title="p90 (business)"><display/></default-field></field>
                        <field name="businessMeanText" align="right"><default-field title="Mean (business)"><display/></default-field></field>
                        <field name="elapsedMedianText" align="right"><default-field title="Median (elapsed)"><display/></default-field></field>
                        <field name="elapsedP90Text" align="right"><default-field title="p90 (elapsed)"><display/></default-field></field>
                        <field name="elapsedMeanText" align="right"><default-field title="Mean (elapsed)"><display/></default-field></field>
                        <field name="openCount" align="right"><default-field title="Open"><display/></default-field></field>
                        <field name="openAgeText" align="right"><default-field title="Median open age"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="count"/><field-ref name="businessMedianText"/></column>
                                <column><field-ref name="businessP90Text"/><field-ref name="elapsedMedianText"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
        <section name="ResponseResultsSection" condition="reportFound">
            <widgets>
                <container-box>
                    <box-header title="By ${answer.groupLabel.toLowerCase()}"/>
                    <box-body-nopad>
                        <label text="No clock of this metric was done in the period." type="p" style="q-pa-md m-muted" condition="!groupRows.length"/>
                        <form-list name="ResponseResults" list="groupRows" skip-form="true" paginate="false">
                        <field name="groupText"><default-field title="${answer.groupLabel}"><display/></default-field></field>
                        <field name="count" align="right"><default-field title="Count"><display/></default-field></field>
                        <field name="businessMedianText" align="right"><default-field title="Median (business)"><display/></default-field></field>
                        <field name="businessP90Text" align="right"><default-field title="p90 (business)"><display/></default-field></field>
                        <field name="businessMeanText" align="right"><default-field title="Mean (business)"><display/></default-field></field>
                        <field name="elapsedMedianText" align="right"><default-field title="Median (elapsed)"><display/></default-field></field>
                        <field name="elapsedP90Text" align="right"><default-field title="p90 (elapsed)"><display/></default-field></field>
                        <field name="elapsedMeanText" align="right"><default-field title="Mean (elapsed)"><display/></default-field></field>
                        <field name="openCount" align="right"><default-field title="Open"><display/></default-field></field>
                        <field name="openAgeText" align="right"><default-field title="Median open age"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="groupText"/><field-ref name="count"/></column>
                                <column><field-ref name="businessMedianText"/><field-ref name="businessP90Text"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
