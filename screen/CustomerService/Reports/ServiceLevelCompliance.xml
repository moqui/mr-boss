<!-- ServiceLevelCompliance (design-customer-service §7 ServiceLevelCompliance; style-guide §3.12 Report; impl-customer-service
    P14, CS-REPORTING): SlaFind (organization, queue and team among those the user reports on, priority band, policy row, channel,
    clock, the period of the clocks' start, an as-of time, the grouping) and SlaResults
    (ironstone.customerservice.ReportingServices.get#SlaCompliance): per group the clocks counted, met, missed, closed without it,
    open past due, open within target, the rate over the decided and the open past due (an open case past due counts against
    it), cancelled apart and never in the rate, and the paused business time; a queue's row opens its cases. A clock a merge
    ended is never counted (its copy on the kept case is). The export holds the same rows -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Service level compliance" default-menu-index="2">
    <parameter name="organizationPartyId"/>
    <parameter name="requestCategoryId"/>
    <parameter name="teamPartyId"/>
    <parameter name="fromDate"/>
    <parameter name="thruDate"/>
    <parameter name="asOf"/>
    <parameter name="groupBy"/>
    <parameter name="bandEnumId"/>
    <parameter name="serviceLevelPolicyId"/>
    <parameter name="salesChannelEnumId"/>
    <parameter name="clockEnumId"/>
    <transition-include name="choices" location="component://mr-boss/template/CustomerServiceParts.xml"/>
    <transition name="exportCsv" read-only="true" method="get">
        <actions>
            <service-call name="ironstone.customerservice.ReportingServices.get#SlaCompliance" out-map="exported"
                    in-map="Object.assign({}, options, {appRoot:appRoot, output:'csv'})"/>
            <script>ec.web.sendTextResponse(exported.answer.csvText, 'text/csv', exported.answer.fileName)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <always-actions>
        <set field="options" from="{organizationPartyId:organizationPartyId || null, requestCategoryId:requestCategoryId || null, teamPartyId:teamPartyId || null, fromDate:fromDate || null, thruDate:thruDate || null, asOf:asOf || null, groupBy:groupBy || null, bandEnumId:bandEnumId || null, serviceLevelPolicyId:serviceLevelPolicyId || null, salesChannelEnumId:salesChannelEnumId || null, clockEnumId:clockEnumId || null}"/>
    </always-actions>
    <actions>
        <service-call name="ironstone.customerservice.ReportingServices.get#SlaCompliance" out-map="found"
                in-map="Object.assign({}, options, {appRoot:appRoot})" transaction="force-new" ignore-error="true"/>
        <set field="reportError" from="ec.message.hasError() ? ec.message.getErrorsString().replace(/^[A-Z_]+: /, '') : null"/>
        <script>ec.message.clearErrors()</script>
        <set field="answer" from="found?.answer || null"/>
        <set field="reportFound" from="!!answer?.asOfText"/>
        <set field="groupRows" from="answer?.groupRows || []"/>
        <set field="totalRows" from="answer?.total ? [answer.total] : []"/>
        <set field="groupOptions" from="answer?.groupOptions || []"/>
        <set field="exportParameters" from="options"/>
    </actions>
    <widgets>
        <container style="m-record-header">
            <container style="m-record-title">
                <label text="Service level compliance" type="h5"/>
                <label text="Clocks started in the period, as they stood at the as-of time. The rate is met over met, missed, closed without it and open past due; cancelled cases are shown apart, never in the rate." type="p" style="text-caption m-muted q-mb-none"/>
            </container>
            <container style="m-record-actions">
                <link url="${sharedLinks['Reports']}" text="All reports" icon="arrow_back" link-type="anchor-button"/>
            </container>
        </container>
        <form-single name="SlaFind" transition="." map="options">
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'organizations', selected:organizationPartyId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="requestCategoryId">
                <default-field title="Queue">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'reportQueues', selected:requestCategoryId, organizationPartyId:organizationPartyId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="teamPartyId">
                <default-field title="Team">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'reportTeams', selected:teamPartyId, organizationPartyId:organizationPartyId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="fromDate">
                <default-field title="From" tooltip="30 days before the end when empty"><date-time type="date"/></default-field>
            </field>
            <field name="thruDate">
                <default-field title="Through" tooltip="Today when empty"><date-time type="date"/></default-field>
            </field>
            <field name="asOf">
                <default-field title="As of" tooltip="Now when empty: an earlier time reads what was recorded by then"><date-time/></default-field>
            </field>
            <field name="groupBy">
                <default-field title="By">
                    <drop-down>
                        <list-options list="groupOptions" key="${value}" text="${label}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="bandEnumId">
                <default-field title="Priority">
                    <drop-down allow-empty="true">
                        <entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration" cache="true">
                                <econdition field-name="enumTypeId" value="CasePriorityBand"/>
                                <order-by field-name="description"/>
                            </entity-find>
                        </entity-options>
                    </drop-down>
                </default-field>
            </field>
            <field name="serviceLevelPolicyId">
                <default-field title="Policy">
                    <drop-down allow-empty="true">
                        <entity-options key="${serviceLevelPolicyId}" text="${policyName}">
                            <entity-find entity-name="mantle.request.support.ServiceLevelPolicy">
                                <econdition field-name="organizationPartyId" operator="in" from="customerService.organizationPartyIds"/>
                                <econdition field-name="fromDate" operator="is-not-null"/>
                                <order-by field-name="policyName"/>
                            </entity-find>
                        </entity-options>
                    </drop-down>
                </default-field>
            </field>
            <field name="salesChannelEnumId">
                <default-field title="Channel">
                    <drop-down allow-empty="true">
                        <entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration" cache="true">
                                <econdition field-name="enumTypeId" value="SalesChannel"/>
                                <order-by field-name="description"/>
                            </entity-find>
                        </entity-options>
                    </drop-down>
                </default-field>
            </field>
            <field name="clockEnumId">
                <default-field title="Clock">
                    <drop-down allow-empty="true">
                        <entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration" cache="true">
                                <econdition field-name="enumTypeId" value="SlaClock"/>
                                <order-by field-name="description"/>
                            </entity-find>
                        </entity-options>
                    </drop-down>
                </default-field>
            </field>
            <field name="submit"><default-field title=""><submit text="Show report" type="primary"/></default-field></field>
            <field-layout>
                <field-row-big><field-ref name="organizationPartyId"/><field-ref name="requestCategoryId"/><field-ref name="teamPartyId"/></field-row-big>
                <field-row-big><field-ref name="bandEnumId"/><field-ref name="serviceLevelPolicyId"/><field-ref name="salesChannelEnumId"/><field-ref name="clockEnumId"/></field-row-big>
                <field-row-big><field-ref name="fromDate"/><field-ref name="thruDate"/><field-ref name="asOf"/><field-ref name="groupBy"/></field-row-big>
                <field-ref name="submit"/>
            </field-layout>
        </form-single>
        <section-include name="ReportFrame" location="component://mr-boss/template/CustomerServiceReportParts.xml"/>
        <section-include name="ReportMissing" location="component://mr-boss/template/CustomerServiceReportParts.xml"/>
        <section name="SlaTotalSection" condition="reportFound">
            <widgets>
                <container-box>
                    <box-header title="All clocks"/>
                    <box-body-nopad>
                        <label text="No clock started in this period." type="p" style="q-pa-md m-muted" condition="!totalRows.length"/>
                        <form-list name="SlaTotal" list="totalRows" skip-form="true" paginate="false">
                        <field name="groupText"><default-field title="Scope"><display/></default-field></field>
                        <field name="eligibleCount" align="right"><default-field title="Counted"><display/></default-field></field>
                        <field name="metCount" align="right"><default-field title="Met"><display/></default-field></field>
                        <field name="missedCount" align="right"><default-field title="Missed"><display/></default-field></field>
                        <field name="unmetCount" align="right"><default-field title="Closed without it"><display/></default-field></field>
                        <field name="openPastDueCount" align="right"><default-field title="Open past due"><display/></default-field></field>
                        <field name="openInTargetCount" align="right"><default-field title="Open within target"><display/></default-field></field>
                        <field name="rateText" align="right"><default-field title="Compliance"><display/></default-field></field>
                        <field name="denominator" align="right"><default-field title="Decided"><display/></default-field></field>
                        <field name="cancelledCount" align="right"><default-field title="Cancelled (not in the rate)"><display/></default-field></field>
                        <field name="pausedText" align="right"><default-field title="Paused"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="rateText"/><field-ref name="denominator"/></column>
                                <column><field-ref name="openPastDueCount"/><field-ref name="cancelledCount"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
        <section name="SlaResultsSection" condition="reportFound">
            <widgets>
                <container-box>
                    <box-header title="By ${answer.groupLabel.toLowerCase()}"/>
                    <box-body-nopad>
                        <label text="No clock started in this period." type="p" style="q-pa-md m-muted" condition="!groupRows.length"/>
                        <form-list name="SlaResults" list="groupRows" skip-form="true" paginate="false">
                        <field name="groupText">
                            <default-field title="${answer.groupLabel}">
                                <link url="${casesUrl}" url-type="plain" text="${groupText}" link-type="anchor" condition="casesUrl"/>
                                <label text="${groupText}" condition="!casesUrl"/>
                            </default-field>
                        </field>
                        <field name="eligibleCount" align="right"><default-field title="Counted"><display/></default-field></field>
                        <field name="metCount" align="right"><default-field title="Met"><display/></default-field></field>
                        <field name="missedCount" align="right"><default-field title="Missed"><display/></default-field></field>
                        <field name="unmetCount" align="right"><default-field title="Closed without it"><display/></default-field></field>
                        <field name="openPastDueCount" align="right"><default-field title="Open past due"><display/></default-field></field>
                        <field name="openInTargetCount" align="right"><default-field title="Open within target"><display/></default-field></field>
                        <field name="rateText" align="right"><default-field title="Compliance"><display/></default-field></field>
                        <field name="denominator" align="right"><default-field title="Decided"><display/></default-field></field>
                        <field name="cancelledCount" align="right"><default-field title="Cancelled (not in the rate)"><display/></default-field></field>
                        <field name="pausedText" align="right"><default-field title="Paused"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="groupText"/><field-ref name="rateText"/></column>
                                <column><field-ref name="openPastDueCount"/><field-ref name="cancelledCount"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
