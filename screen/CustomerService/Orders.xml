<!-- The Orders area of IronStone Customer Service (design-customer-service §1, §4; impl-customer-service P3): a menu group
    holding Orders (the default: OrderLookup and OrderResults), with OrderDetail, ShipmentDetail and InvoiceDetail (the shared
    screens in the Customer Service context, crosscut §3.6, §3.8, §3.16) hidden from the menu; the change requests follow
    (P10). Every Customer Service user, limited to their organizations' sales orders of customers they serve. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Orders" default-menu-index="4" menu-image="sym_o_receipt_long" menu-image-type="icon">
    <subscreens default-item="Orders" always-use-full-path="true">
        <subscreens-item name="OrderDetail" location="component://mr-boss/screen/Shared/OrderDetail.xml" menu-include="false"/>
        <subscreens-item name="ShipmentDetail" location="component://mr-boss/screen/Shared/ShipmentDetail.xml"
                menu-include="false"/>
        <subscreens-item name="InvoiceDetail" location="component://mr-boss/screen/Shared/InvoiceDetail.xml"
                menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="CustomerServiceOrdersPanel" type="tab"/>
    </widgets>
</screen>
