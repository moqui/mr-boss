<!-- ServiceDefaults (design-customer-service §9 ServiceDefaults ServicePolicy; impl-customer-service P2, CS-SETTINGS): the
    organization's service policy (ironstone.customerservice.ConfigurationServices.get#ServiceSettings) and its edit from now
    over mantle.request.SupportCaseServices.save#ServiceDefaults: the default queue and workflow, what an unknown sender
    makes, the reopen window, the auto-close delay, whether resolving needs a resolution, and customerImmediateCancel (off,
    for P10). The first policy turns the case rules on for the organization. P13: FeedbackDeliveryPolicy, when a resolved
    case's customer is asked for feedback (ironstone.customerservice.FeedbackServices.get#FeedbackPolicy; saved from a date
    by mantle.request.CaseFeedbackServices.save#InvitationPolicy, which ends the row it replaces): the case types and queues,
    the delay, once per case or per resolution, the feedback form, the channel, the link's days, the reminders, the low score
    and the follow-up team. No transport credentials are here: the mail goes from the organization's address. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Service defaults" default-menu-index="6">
    <parameter name="organizationPartyId"/>
    <transition name="chooseOrganization">
        <default-response url="."><parameter name="organizationPartyId"/></default-response>
    </transition>
    <transition name="saveDefaults">
        <actions>
            <service-call name="mantle.request.SupportCaseServices.save#ServiceDefaults"
                    in-map="{organizationPartyId:organizationPartyId, defaultCategoryId:(defaultCategoryId || null),
                        caseWorkflowId:(caseWorkflowId || null), unknownSenderEnumId:(unknownSenderEnumId || null),
                        reopenWindowDays:(reopenWindowDays || null), autoCloseDays:(autoCloseDays || null),
                        resolutionRequired:(resolutionRequired || 'Y'), customerImmediateCancel:(customerImmediateCancel || 'N')}"/>
            <message type="success">Saved the service defaults</message>
        </actions>
        <default-response url="."><parameter name="organizationPartyId"/></default-response>
        <error-response url="."/>
    </transition>
    <!-- P13: the feedback delivery policy from a date, or ended -->
    <transition name="saveFeedbackPolicy">
        <actions>
            <service-call name="mantle.request.CaseFeedbackServices.save#InvitationPolicy"
                    in-map="{organizationPartyId:organizationPartyId, formId:formId, requestTypeEnumIds:(requestTypeEnumIds || null),
                        requestCategoryIds:(requestCategoryIds || null), delayMinutes:delayMinutes, frequencyEnumId:frequencyEnumId,
                        channelEnumId:'FdcEmail', tokenDays:tokenDays, reminderCount:reminderCount, reminderDays:reminderDays,
                        lowScoreThreshold:lowScoreThreshold, followUpTeamPartyId:(followUpTeamPartyId || null),
                        followUpDays:followUpDays, fromDate:(fromDate || null), changeReason:(changeReason || null)}"/>
            <message type="success">Saved the feedback delivery</message>
        </actions>
        <default-response url="."><parameter name="organizationPartyId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="endFeedbackPolicy">
        <actions>
            <service-call name="mantle.request.CaseFeedbackServices.save#InvitationPolicy"
                    in-map="{organizationPartyId:organizationPartyId, end:true, changeReason:(changeReason || null)}"/>
            <message type="success">Resolved cases are no longer asked for feedback</message>
        </actions>
        <default-response url="."><parameter name="organizationPartyId"/></default-response>
        <error-response url="."/>
    </transition>
    <!-- P15: the Support mount's settings (its queues, case types and knowledge spaces) from a date -->
    <transition name="saveSupportMount">
        <actions>
            <service-call name="mantle.request.SupportCaseServices.save#SupportAppSetting"
                    in-map="{organizationPartyId:organizationPartyId, queueIds:(supportQueueIds || null),
                        typeEnumIds:(supportTypeEnumIds || null), wikiSpaceIds:(supportSpaceIds || null),
                        fromDate:(fromDate || null), changeReason:(changeReason || null)}"/>
            <message type="success">Saved the Support app's settings</message>
        </actions>
        <default-response url="."><parameter name="organizationPartyId"/></default-response>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="ironstone.customerservice.ConfigurationServices.get#ServiceSettings" out-map="settingsOut"
                transaction="force-new" ignore-error="true" in-map="{appRoot:appRoot, organizationPartyId:organizationPartyId}"/>
        <script>ec.message.clearErrors()</script>
        <set field="cfg" from="settingsOut?.settings || null"/>
        <set field="cfgOrganizations" from="cfg?.organizations || []"/>
        <set field="cfgOrganizationPartyId" from="cfg?.organizationPartyId"/>
        <set field="can" from="customerService.capabilities"/>
        <set field="policy" from="cfg?.policy || null"/>
        <set field="policyValues" from="Object.assign({organizationPartyId:cfgOrganizationPartyId, caseWorkflowId:'CwfDefault',
                unknownSenderEnumId:'SusReview', reopenWindowDays:'14', resolutionRequired:'Y', customerImmediateCancel:'N'}, policy || {})"/>
        <set field="queueOptions" from="cfg?.queueOptions || []"/>
        <set field="workflows" from="cfg?.workflows || []"/>
        <!-- P13: the feedback delivery policy -->
        <if condition="cfg">
            <service-call name="ironstone.customerservice.FeedbackServices.get#FeedbackPolicy" out-map="feedbackOut"
                    transaction="force-new" ignore-error="true" in-map="{appRoot:appRoot, organizationPartyId:cfgOrganizationPartyId}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="feedbackPolicy" from="feedbackOut?.policy || null"/>
        <set field="feedbackHistory" from="feedbackOut?.history || []"/>
        <set field="feedbackFormOptions" from="feedbackOut?.formOptions || []"/>
        <set field="feedbackTypeOptions" from="feedbackOut?.typeOptions || []"/>
        <set field="feedbackQueueOptions" from="feedbackOut?.queueOptions || []"/>
        <set field="feedbackTeamOptions" from="feedbackOut?.teamOptions || []"/>
        <set field="feedbackValues" from="Object.assign({organizationPartyId:cfgOrganizationPartyId, formId:feedbackFormOptions[0]?.value || '',
                delayMinutes:'60', frequencyEnumId:'FdfPerCase', tokenDays:'14', reminderCount:'1', reminderDays:'3',
                lowScoreThreshold:'2', followUpDays:'2'}, feedbackPolicy ? {formId:feedbackPolicy.formId,
                requestTypeEnumIds:String(feedbackPolicy.requestTypeEnumIds || '').split(',').filter(Boolean),
                requestCategoryIds:String(feedbackPolicy.requestCategoryIds || '').split(',').filter(Boolean),
                delayMinutes:feedbackPolicy.delayMinutes, frequencyEnumId:feedbackPolicy.frequencyEnumId,
                tokenDays:feedbackPolicy.tokenDays, reminderCount:feedbackPolicy.reminderCount, reminderDays:feedbackPolicy.reminderDays,
                lowScoreThreshold:feedbackPolicy.lowScoreThreshold, followUpTeamPartyId:feedbackPolicy.followUpTeamPartyId,
                followUpDays:feedbackPolicy.followUpDays} : {})"/>
        <!-- P15: the Support mount's settings -->
        <if condition="cfg">
            <service-call name="ironstone.customerservice.SupportAppServices.get#SupportMountSettings" out-map="supportMount"
                    transaction="force-new" ignore-error="true" in-map="{appRoot:appRoot, organizationPartyId:cfgOrganizationPartyId}"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="supportMountValues" from="{organizationPartyId:cfgOrganizationPartyId,
                supportQueueIds:supportMount?.setting?.queueIds || [], supportTypeEnumIds:supportMount?.setting?.typeEnumIds || [],
                supportSpaceIds:supportMount?.setting?.wikiSpaceIds || []}"/>
    </actions>
    <widgets>
        <label text="Customer Service settings are not available to you." type="p" condition="!cfg"/>
        <section name="DefaultSettings" condition="cfg">
            <widgets>
                <label text="Service defaults" type="h5"/>
                <label type="p" style="text-caption m-muted" text="${policy ? 'In effect since ' + policy.fromText + '.' :
                        'Not set: no request of the organization is a case until these are saved.'}"/>
                <section name="OrganizationPicker" condition="cfgOrganizations.length &gt; 1">
                    <widgets>
                        <form-single name="SettingsOrganization" transition="chooseOrganization" map="{organizationPartyId:cfgOrganizationPartyId}">
                            <field name="organizationPartyId">
                                <default-field title="Organization">
                                    <drop-down submit-on-select="true"><list-options list="cfgOrganizations" key="${value}" text="${label}"/></drop-down>
                                </default-field>
                            </field>
                        </form-single>
                    </widgets>
                </section>
                <container-box>
                    <box-body>
                        <form-single name="ServicePolicy" transition="saveDefaults" map="policyValues">
                            <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                            <field name="defaultCategoryId">
                                <default-field title="Default queue">
                                    <drop-down allow-empty="true"><list-options list="queueOptions" key="${value}" text="${label}"/></drop-down>
                                </default-field>
                            </field>
                            <field name="caseWorkflowId">
                                <default-field title="Case workflow">
                                    <drop-down><list-options list="workflows" key="${value}" text="${label}"/></drop-down>
                                </default-field>
                            </field>
                            <field name="unknownSenderEnumId">
                                <default-field title="A message from an unknown sender makes">
                                    <drop-down>
                                        <entity-options key="${enumId}" text="${description}">
                                            <entity-find entity-name="moqui.basic.Enumeration" cache="true">
                                                <econdition field-name="enumTypeId" value="ServiceUnknownSender"/>
                                                <order-by field-name="sequenceNum"/>
                                            </entity-find>
                                        </entity-options>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="reopenWindowDays">
                                <default-field title="Reopen within (days)" tooltip="After this a reply makes a follow-up case">
                                    <text-line size="4" input-type="number"/>
                                </default-field>
                            </field>
                            <field name="autoCloseDays">
                                <default-field title="Close resolved cases after (days)" tooltip="Empty: never">
                                    <text-line size="4" input-type="number"/>
                                </default-field>
                            </field>
                            <field name="resolutionRequired">
                                <default-field title="Resolving needs a resolution">
                                    <radio><option key="Y" text="Yes"/><option key="N" text="No"/></radio>
                                </default-field>
                            </field>
                            <field name="customerImmediateCancel">
                                <default-field title="Customers cancel unshipped orders at once">
                                    <radio><option key="N" text="No"/><option key="Y" text="Yes"/></radio>
                                </default-field>
                            </field>
                            <field name="submitButton">
                                <conditional-field title="Save from now" condition="can.policyEdit"><submit/></conditional-field>
                                <default-field><ignored/></default-field>
                            </field>
                            <field-layout>
                                <field-row><field-ref name="defaultCategoryId"/><field-ref name="caseWorkflowId"/></field-row>
                                <field-ref name="unknownSenderEnumId"/>
                                <field-row><field-ref name="reopenWindowDays"/><field-ref name="autoCloseDays"/></field-row>
                                <field-row><field-ref name="resolutionRequired"/><field-ref name="customerImmediateCancel"/></field-row>
                                <field-ref name="submitButton"/>
                            </field-layout>
                        </form-single>
                    </box-body>
                </container-box>
                <!-- P13: FeedbackDeliveryPolicy -->
                <container-box>
                    <box-header title="Feedback delivery"/>
                    <box-toolbar>
                        <container-dialog id="EndFeedbackPolicy" button-text="Stop asking" icon="sym_o_block" width="480"
                                title="Stop asking for feedback" condition="can.policyEdit &amp;&amp; feedbackPolicy">
                            <form-single name="EndFeedbackPolicyForm" transition="endFeedbackPolicy" map="{organizationPartyId:cfgOrganizationPartyId}">
                                <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                                <field name="changeReason"><default-field title="Why"><text-line size="40"/></default-field></field>
                                <field name="submitButton">
                                    <default-field title="Stop from now"><submit type="danger" confirmation="Stop asking resolved cases for feedback?"/></default-field>
                                </field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body>
                        <label type="p" style="text-caption m-muted" text="${feedbackPolicy ? 'In effect since ' + feedbackPolicy.fromText + ': ' +
                                feedbackPolicy.formText + ', ' + feedbackPolicy.typesText + ', ' + feedbackPolicy.queuesText + '.' :
                                feedbackFormOptions.length ? 'Not set: resolved cases are not asked for feedback.' :
                                'Not set: publish a feedback form first (Settings, Feedback forms).'}"/>
                        <form-single name="FeedbackDeliveryPolicy" transition="saveFeedbackPolicy" map="feedbackValues">
                            <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                            <field name="formId">
                                <default-field title="Feedback form">
                                    <drop-down><list-options list="feedbackFormOptions" key="${value}" text="${label}"/></drop-down>
                                </default-field>
                            </field>
                            <field name="requestTypeEnumIds">
                                <default-field title="Case types" tooltip="Empty: every type">
                                    <drop-down allow-multiple="true" allow-empty="true">
                                        <list-options list="feedbackTypeOptions" key="${value}" text="${label}"/></drop-down>
                                </default-field>
                            </field>
                            <field name="requestCategoryIds">
                                <default-field title="Queues" tooltip="Empty: every queue">
                                    <drop-down allow-multiple="true" allow-empty="true">
                                        <list-options list="feedbackQueueOptions" key="${value}" text="${label}"/></drop-down>
                                </default-field>
                            </field>
                            <field name="delayMinutes">
                                <default-field title="Send after resolving (minutes)"><text-line size="6" input-type="number"/></default-field>
                            </field>
                            <field name="frequencyEnumId">
                                <default-field title="Ask">
                                    <radio><option key="FdfPerCase" text="Once per case"/><option key="FdfPerResolution" text="Each time it is resolved"/></radio>
                                </default-field>
                            </field>
                            <field name="tokenDays">
                                <default-field title="The link works for (days)"><text-line size="4" input-type="number"/></default-field>
                            </field>
                            <field name="reminderCount">
                                <default-field title="Reminders" tooltip="0 to 3"><text-line size="2" input-type="number"/></default-field>
                            </field>
                            <field name="reminderDays">
                                <default-field title="Days between reminders"><text-line size="3" input-type="number"/></default-field>
                            </field>
                            <field name="lowScoreThreshold">
                                <default-field title="Follow up a score of at most" tooltip="Empty: no follow-up">
                                    <text-line size="3" input-type="number"/></default-field>
                            </field>
                            <field name="followUpTeamPartyId">
                                <default-field title="Follow-up team" tooltip="Empty: the case's queue team">
                                    <drop-down allow-empty="true"><list-options list="feedbackTeamOptions" key="${value}" text="${label}"/></drop-down>
                                </default-field>
                            </field>
                            <field name="followUpDays">
                                <default-field title="Follow up within (days)"><text-line size="3" input-type="number"/></default-field>
                            </field>
                            <field name="fromDate">
                                <default-field title="From" tooltip="Empty: now; an invitation keeps the row it was made under">
                                    <date-time/></default-field>
                            </field>
                            <field name="changeReason"><default-field title="Why"><text-line size="40"/></default-field></field>
                            <field name="submitButton">
                                <conditional-field title="Save from that date" condition="can.policyEdit &amp;&amp; feedbackFormOptions.length"><submit/></conditional-field>
                                <default-field><ignored/></default-field>
                            </field>
                            <field-layout>
                                <field-row><field-ref name="formId"/><field-ref name="frequencyEnumId"/></field-row>
                                <field-row><field-ref name="requestTypeEnumIds"/><field-ref name="requestCategoryIds"/></field-row>
                                <field-row><field-ref name="delayMinutes"/><field-ref name="tokenDays"/></field-row>
                                <field-row><field-ref name="reminderCount"/><field-ref name="reminderDays"/></field-row>
                                <field-row><field-ref name="lowScoreThreshold"/><field-ref name="followUpTeamPartyId"/></field-row>
                                <field-row><field-ref name="followUpDays"/><field-ref name="fromDate"/></field-row>
                                <field-ref name="changeReason"/>
                                <field-ref name="submitButton"/>
                            </field-layout>
                        </form-single>
                    </box-body>
                </container-box>
                <section name="SupportMountSettings" condition="!!supportMount">
                    <widgets>
                        <container-box>
                            <box-header title="Support app"/>
                            <box-body>
                                <label type="p" text="${supportMount.sites.length ? 'Customers reach the Support app at ' + supportMount.sites.map(site => site.url || site.siteId).join(', ') + '.' : 'No published site has the Support app for this organization yet (PASS site mounts).'}"/>
                                <label type="p" text="${supportMount.setting ? 'In effect since ' + supportMount.setting.fromText + '.' : 'Not set: customers file into the default queue, and the help reads every customer and public knowledge source.'}"/>
                                <form-single name="SupportMount" transition="saveSupportMount" map="supportMountValues">
                                    <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                                    <field name="supportQueueIds">
                                        <default-field title="Queues customers file into" tooltip="Empty: the default queue">
                                            <drop-down allow-multiple="true" allow-empty="true">
                                                <list-options list="supportMount.queueOptions" key="${value}" text="${label}"/></drop-down>
                                        </default-field>
                                    </field>
                                    <field name="supportTypeEnumIds">
                                        <default-field title="Case types offered" tooltip="Empty: each queue's own">
                                            <drop-down allow-multiple="true" allow-empty="true">
                                                <list-options list="supportMount.typeOptions" key="${value}" text="${label}"/></drop-down>
                                        </default-field>
                                    </field>
                                    <field name="supportSpaceIds">
                                        <default-field title="Help from" tooltip="Empty: every customer and public knowledge source">
                                            <drop-down allow-multiple="true" allow-empty="true">
                                                <list-options list="supportMount.spaceOptions" key="${value}" text="${label}"/></drop-down>
                                        </default-field>
                                    </field>
                                    <field name="fromDate"><default-field title="From" tooltip="Empty: now"><date-time/></default-field></field>
                                    <field name="changeReason"><default-field title="Why"><text-line size="40"/></default-field></field>
                                    <field name="submitButton">
                                        <conditional-field title="Save from that date" condition="can.policyEdit"><submit/></conditional-field>
                                        <default-field><ignored/></default-field>
                                    </field>
                                </form-single>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
                <section name="FeedbackPolicyHistory" condition="feedbackHistory.length">
                    <widgets>
                        <container-box>
                            <box-header title="Earlier feedback delivery"/>
                            <box-body-nopad>
                                <form-list name="FeedbackPolicyRows" list="feedbackHistory" skip-form="true" paginate="false">
                                    <field name="formText"><default-field title="Form"><display/></default-field></field>
                                    <field name="fromText"><default-field title="From"><display/></default-field></field>
                                    <field name="thruText"><default-field title="Until"><display/></default-field></field>
                                    <field name="changeReason"><default-field title="Why"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="formText"/><field-ref name="changeReason"/></column>
                                        <column><field-ref name="fromText"/><field-ref name="thruText"/></column>
                                    </columns>
                                </form-list>
                            </box-body-nopad>
                        </container-box>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
