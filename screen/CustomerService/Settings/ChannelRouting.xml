<!-- ChannelRouting (design-customer-service §9 ChannelRouting; impl-customer-service P6, CS-CHANNELS, F10, F11, F12): how mail,
    the public form, the forum and chat reach the organization's service queues (ironstone.customerservice.ChannelServices
    find#ServiceRoutes). IntakeRoutes: each queue's routes in effect, the Comms mail rules whose createRequest action names a
    queue (set in Comms' rules), each queue's public form token, and the requests held for review. RouteEdit: Add route,
    Edit (a new row from now, the old one ended) and End over mantle.request.SupportCaseServices.save#ServiceRoute
    (SUPPORT_POLICY_EDIT); Turn on or rotate and Turn off the public form over create#IntakeToken and remove#IntakeToken; the
    review's Accept and Dismiss over review#HeldRequest (SUPPORT_CASE_EDIT). RouteTest: a dry run of a message to a queue over
    preview#ServiceRoute, writing nothing. No credentials here: accounts are Comms'. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Channel routing" default-menu-index="9">
    <parameter name="organizationPartyId"/>
    <parameter name="testCategoryId"/>
    <parameter name="testFromAddress"/>
    <parameter name="testSubject"/>
    <parameter name="testInReplyTo"/>
    <parameter name="testHeaders"/>
    <transition name="chooseOrganization">
        <default-response url="."><parameter name="organizationPartyId"/></default-response>
    </transition>
    <transition-include name="choices" location="component://mr-boss/template/CustomerServiceParts.xml"/>
    <transition name="saveRoute">
        <actions>
            <service-call name="mantle.request.SupportCaseServices.save#ServiceRoute"
                    in-map="{serviceRouteId:(serviceRouteId || null), requestCategoryId:requestCategoryId, channelEnumId:channelEnumId,
                        emailAccountId:(emailAccountId || null), siteId:(siteId || null), forumContactListId:(forumContactListId || null),
                        requestTypeEnumId:(requestTypeEnumId || null), defaultPriority:(defaultPriority || null),
                        unknownSenderEnumId:(unknownSenderEnumId || null), autoGeneratedEnumId:(autoGeneratedEnumId || null),
                        acknowledge:(acknowledge || 'N'), ackTextBlockId:(ackTextBlockId || null), replyEmailIdentityId:(replyEmailIdentityId || null),
                        rateLimitPerHour:(rateLimitPerHour || null), tokenValidDays:(tokenValidDays || null), changeReason:(changeReason || null)}"/>
            <message type="success">Saved the route</message>
        </actions>
        <default-response url="."><parameter name="organizationPartyId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="endRoute">
        <actions>
            <service-call name="mantle.request.SupportCaseServices.save#ServiceRoute"
                    in-map="{serviceRouteId:serviceRouteId, end:true, changeReason:(changeReason || null)}"/>
            <message type="success">Ended the route</message>
        </actions>
        <default-response url="."><parameter name="organizationPartyId"/></default-response>
        <error-response url="."/>
    </transition>
    <!-- the public form's token is shown once, when it is made -->
    <transition name="issueToken">
        <actions>
            <service-call name="mantle.request.RequestServices.create#IntakeToken" out-map="issued" in-map="{requestCategoryId:requestCategoryId}"/>
            <script><![CDATA[if (!ec.message.hasError()) ec.message.addMessage(issued.url
                    ? ec.resource.expand('The form is on at ${url}; the earlier link no longer works', '', {url: issued.url})
                    : ec.resource.expand('The form is on with the token ${token}; the earlier link no longer works. Its page is the Support app\'s, on a site of the organization', '', {token: issued.token}),
                    'success')]]></script>
        </actions>
        <default-response url="."><parameter name="organizationPartyId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="removeToken">
        <actions>
            <service-call name="mantle.request.RequestServices.remove#IntakeToken" in-map="{requestCategoryId:requestCategoryId}"/>
            <message type="success">The public form is off: its link no longer works</message>
        </actions>
        <default-response url="."><parameter name="organizationPartyId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="reviewHeld">
        <actions>
            <service-call name="mantle.request.SupportCaseServices.review#HeldRequest" out-map="reviewed"
                    in-map="{requestId:requestId, decision:decision, customerPartyId:(customerPartyId || null), reason:(reason || null)}"/>
            <script>if (!ec.message.hasError()) ec.message.addMessage(reviewed.isCase ? 'Request ' + requestId + ' is now a case'
                    : 'Dismissed request ' + requestId, 'success')</script>
        </actions>
        <default-response url="."><parameter name="organizationPartyId"/></default-response>
        <error-response url="."/>
    </transition>
    <!-- RouteTest: the page again with the sample message -->
    <transition name="testRoute">
        <default-response url=".">
            <parameter name="organizationPartyId"/>
            <parameter name="testCategoryId"/>
            <parameter name="testFromAddress"/>
            <parameter name="testSubject"/>
            <parameter name="testInReplyTo"/>
            <parameter name="testHeaders"/>
        </default-response>
    </transition>
    <actions>
        <service-call name="ironstone.customerservice.ChannelServices.find#ServiceRoutes" out-map="routingOut"
                transaction="force-new" ignore-error="true" in-map="{appRoot:appRoot, organizationPartyId:organizationPartyId}"/>
        <script>ec.message.clearErrors()</script>
        <set field="routing" from="routingOut?.routing || null"/>
        <set field="routeRows" from="routing?.routes || []"/>
        <set field="queueOptions" from="routing?.queues || []"/>
        <set field="orgOptions" from="routing?.organizations || []"/>
        <set field="orgId" from="routing?.organizationPartyId"/>
        <set field="newRoute" from="{channelEnumId:'SrcEmail', requestCategoryId:(queueOptions[0]?.value || ''), autoGeneratedEnumId:'SagAttach',
                acknowledge:'Y'}"/>
        <!-- RouteTest's result, when a sample was given -->
        <if condition="routing &amp;&amp; testCategoryId &amp;&amp; testFromAddress">
            <service-call name="mantle.request.SupportCaseServices.preview#ServiceRoute" out-map="testOut" transaction="force-new"
                    ignore-error="true" in-map="{requestCategoryId:testCategoryId, fromAddress:testFromAddress, subject:(testSubject || null),
                        inReplyTo:(testInReplyTo || null), headersString:(testHeaders || null)}"/>
            <set field="testError" from="ec.message.hasError() ? ec.message.getErrorsString() : null"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="test" from="testOut?.preview || null"/>
    </actions>
    <widgets>
        <label text="Customer Service settings are not available to you." type="p" condition="!routing"/>
        <section name="RoutingSettings" condition="routing">
            <widgets>
                <container style="row items-center q-col-gutter-sm q-mb-sm">
                    <container style="col">
                        <label text="Channel routing" type="h5"/>
                        <label type="p" style="text-caption m-muted q-mb-none"
                                text="How mail, the public form, the forum and chat reach the queues: what a message from a customer, from staff or from an unknown sender makes, and the acknowledgement a new case gets."/>
                    </container>
                    <container style="col-auto">
                        <container-dialog id="AddRoute" button-text="Add route" icon="sym_o_add" type="primary" width="720"
                                title="Add a route" condition="routing.canEdit &amp;&amp; queueOptions.length">
                            <form-single name="AddRouteForm" transition="saveRoute" map="newRoute">
                                <field name="requestCategoryId">
                                    <default-field title="Queue">
                                        <drop-down><list-options list="queueOptions" key="${value}" text="${label}"/></drop-down>
                                    </default-field>
                                </field>
                                <field name="channelEnumId">
                                    <default-field title="Channel">
                                        <drop-down><list-options list="routing.channelOptions" key="${value}" text="${label}"/></drop-down>
                                    </default-field>
                                </field>
                                <field name="emailAccountId">
                                    <default-field title="Mail account" tooltip="For mail; empty: any account whose rule names the queue">
                                        <drop-down allow-empty="true"><list-options list="routing.accountOptions" key="${value}" text="${label}"/></drop-down>
                                    </default-field>
                                </field>
                                <field name="siteId">
                                    <default-field title="Forum site" tooltip="For the forum">
                                        <drop-down allow-empty="true"><list-options list="routing.siteOptions" key="${value}" text="${label}"/></drop-down>
                                    </default-field>
                                </field>
                                <field name="forumContactListId">
                                    <default-field title="Forum category" tooltip="Empty: every category of the site">
                                        <drop-down allow-empty="true"><list-options list="routing.forumCategoryOptions" key="${value}" text="${label}"/></drop-down>
                                    </default-field>
                                </field>
                                <field name="requestTypeEnumId">
                                    <default-field title="Type">
                                        <drop-down allow-empty="true"><list-options list="routing.typeOptions" key="${value}" text="${label}"/></drop-down>
                                    </default-field>
                                </field>
                                <field name="defaultPriority">
                                    <default-field title="Priority" tooltip="1 (highest) to 9; empty: 5"><text-line size="3" input-type="number"/></default-field>
                                </field>
                                <field name="unknownSenderEnumId">
                                    <default-field title="Unknown sender" tooltip="Empty: the service defaults' rule">
                                        <drop-down allow-empty="true"><list-options list="routing.unknownOptions" key="${value}" text="${label}"/></drop-down>
                                    </default-field>
                                </field>
                                <field name="autoGeneratedEnumId">
                                    <default-field title="Automatic mail" tooltip="An autoresponder's or a list's: never a case, never acknowledged">
                                        <drop-down><list-options list="routing.autoOptions" key="${value}" text="${label}"/></drop-down>
                                    </default-field>
                                </field>
                                <field name="acknowledge">
                                    <default-field title="Acknowledge a new case">
                                        <radio><option key="Y" text="Yes"/><option key="N" text="No"/></radio>
                                    </default-field>
                                </field>
                                <field name="ackTextBlockId">
                                    <default-field title="Acknowledgement text" tooltip="A Comms text block; it may name the case number, its subject and the queue">
                                        <drop-down allow-empty="true"><list-options list="routing.textBlockOptions" key="${value}" text="${label}"/></drop-down>
                                    </default-field>
                                </field>
                                <field name="replyEmailIdentityId">
                                    <default-field title="Reply from">
                                        <drop-down allow-empty="true"><list-options list="routing.identityOptions" key="${value}" text="${label}"/></drop-down>
                                    </default-field>
                                </field>
                                <field name="rateLimitPerHour">
                                    <default-field title="Form requests an hour" tooltip="For the public form; empty: 30"><text-line size="4" input-type="number"/></default-field>
                                </field>
                                <field name="tokenValidDays">
                                    <default-field title="Form link lasts (days)" tooltip="Empty: 60"><text-line size="4" input-type="number"/></default-field>
                                </field>
                                <field name="submitButton"><default-field title="Add from now"><submit/></default-field></field>
                                <field-layout>
                                    <field-row><field-ref name="requestCategoryId"/><field-ref name="channelEnumId"/></field-row>
                                    <field-row><field-ref name="emailAccountId"/><field-ref name="replyEmailIdentityId"/></field-row>
                                    <field-row><field-ref name="siteId"/><field-ref name="forumContactListId"/></field-row>
                                    <field-row><field-ref name="requestTypeEnumId"/><field-ref name="defaultPriority"/></field-row>
                                    <field-row><field-ref name="unknownSenderEnumId"/><field-ref name="autoGeneratedEnumId"/></field-row>
                                    <field-row><field-ref name="acknowledge"/><field-ref name="ackTextBlockId"/></field-row>
                                    <field-row><field-ref name="rateLimitPerHour"/><field-ref name="tokenValidDays"/></field-row>
                                    <field-ref name="submitButton"/>
                                </field-layout>
                            </form-single>
                        </container-dialog>
                    </container>
                </container>
                <section name="OrganizationPicker" condition="orgOptions.length &gt; 1">
                    <widgets>
                        <form-single name="SettingsOrganization" transition="chooseOrganization" map="{organizationPartyId:orgId}">
                            <field name="organizationPartyId">
                                <default-field title="Organization">
                                    <drop-down submit-on-select="true"><list-options list="orgOptions" key="${value}" text="${label}"/></drop-down>
                                </default-field>
                            </field>
                        </form-single>
                    </widgets>
                </section>
                <label type="p" style="m-muted" condition="!queueOptions.length"
                        text="The organization has no service queue yet. Make one in Queues, then route its channels here."/>

                <!-- ===== IntakeRoutes ===== -->
                <container-box>
                    <box-header title="Routes"/>
                    <box-body-nopad>
                        <form-list name="IntakeRoutes" list="routeRows" skip-form="true" paginate="false">
                            <field name="queueText">
                                <default-field title="Queue">
                                    <label text="${queueText}" type="span"/>
                                    <label text="${sourceText}" type="div" style="text-caption m-muted"/>
                                </default-field>
                            </field>
                            <field name="channelText">
                                <default-field title="Channel">
                                    <render-mode>
                                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-primary">${
                                            WebUtilities.encodeHtml(channelText)}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: channelText})}]]></text>
                                        <text type="html">${channelText}</text>
                                    </render-mode>
                                </default-field>
                            </field>
                            <field name="typeText"><default-field title="Type"><display/></default-field></field>
                            <field name="senderText"><default-field title="Unknown sender"><display/></default-field></field>
                            <field name="autoText"><default-field title="Automatic mail"><display/></default-field></field>
                            <field name="ackText"><default-field title="Acknowledgement"><display/></default-field></field>
                            <field name="fromText">
                                <default-field title="Since">
                                    <label text="${fromText}" type="span"/>
                                    <label text="${lastErrorText}" type="div" style="text-caption text-negative" condition="lastErrorText"/>
                                </default-field>
                            </field>
                            <field name="actions">
                                <default-field title="">
                                    <container-dialog id="EditRoute_${serviceRouteId}" button-text="Edit" icon="sym_o_edit" width="720"
                                            title="Edit the route of ${queueText}" condition="routing.canEdit">
                                        <form-single name="EditRouteForm" transition="saveRoute" extends="AddRouteForm"
                                                map="{serviceRouteId:serviceRouteId, requestCategoryId:requestCategoryId, channelEnumId:channelEnumId,
                                                    emailAccountId:emailAccountId, siteId:siteId, forumContactListId:forumContactListId,
                                                    requestTypeEnumId:requestTypeEnumId, defaultPriority:defaultPriority,
                                                    unknownSenderEnumId:unknownSenderEnumId, autoGeneratedEnumId:autoGeneratedEnumId,
                                                    acknowledge:acknowledge, ackTextBlockId:ackTextBlockId, replyEmailIdentityId:replyEmailIdentityId,
                                                    rateLimitPerHour:rateLimitPerHour, tokenValidDays:tokenValidDays}">
                                            <field name="serviceRouteId"><default-field><hidden/></default-field></field>
                                            <field name="changeReason"><default-field title="Why"><text-line size="40"/></default-field></field>
                                            <field name="submitButton"><default-field title="Save from now"><submit/></default-field></field>
                                            <field-layout>
                                                <field-row><field-ref name="requestCategoryId"/><field-ref name="channelEnumId"/></field-row>
                                                <field-row><field-ref name="emailAccountId"/><field-ref name="replyEmailIdentityId"/></field-row>
                                                <field-row><field-ref name="siteId"/><field-ref name="forumContactListId"/></field-row>
                                                <field-row><field-ref name="requestTypeEnumId"/><field-ref name="defaultPriority"/></field-row>
                                                <field-row><field-ref name="unknownSenderEnumId"/><field-ref name="autoGeneratedEnumId"/></field-row>
                                                <field-row><field-ref name="acknowledge"/><field-ref name="ackTextBlockId"/></field-row>
                                                <field-row><field-ref name="rateLimitPerHour"/><field-ref name="tokenValidDays"/></field-row>
                                                <field-ref name="changeReason"/>
                                                <field-ref name="submitButton"/>
                                            </field-layout>
                                        </form-single>
                                    </container-dialog>
                                    <container-dialog id="EndRoute_${serviceRouteId}" button-text="End" icon="sym_o_block" width="480"
                                            title="End the route of ${queueText}" condition="routing.canEdit">
                                        <form-single name="EndRouteForm" transition="endRoute">
                                            <field name="serviceRouteId"><default-field><hidden/></default-field></field>
                                            <field name="changeReason"><default-field title="Why"><text-line size="40"/></default-field></field>
                                            <field name="submitButton">
                                                <default-field title="End">
                                                    <submit type="danger" confirmation="End the ${channelText} route of ${queueText}? Its channel then files with the queue's defaults."/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="queueText"/><field-ref name="typeText"/></column>
                                <column><field-ref name="channelText"/><field-ref name="actions"/></column>
                            </columns>
                        </form-list>
                        <label type="p" style="q-pa-sm m-muted q-mb-none" condition="!routeRows.length"
                                text="No route yet: mail a rule files into a queue makes a case with the queue's defaults and no acknowledgement."/>
                    </box-body-nopad>
                </container-box>

                <container-box>
                    <box-header title="Mail rules"/>
                    <box-body-nopad>
                        <form-list name="IntakeMailRules" list="routing.rules" skip-form="true" paginate="false">
                            <field name="ruleName"><default-field title="Rule"><display/></default-field></field>
                            <field name="accountText"><default-field title="Account"><display/></default-field></field>
                            <field name="queueText"><default-field title="Files into"><display/></default-field></field>
                            <field name="enabledText"><default-field title="State"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="ruleName"/><field-ref name="accountText"/></column>
                                <column><field-ref name="queueText"/><field-ref name="enabledText"/></column>
                            </columns>
                        </form-list>
                        <container style="q-pa-sm">
                            <label type="span" style="m-muted" condition="!routing.rules.length"
                                    text="No mail rule files into these queues yet. "/>
                            <link url="/qapps/Comms/Settings/Rules" url-type="plain" text="Mail rules in Comms" link-type="anchor"/>
                            <label type="div" style="text-caption m-muted"
                                    text="A rule's Make a request action with a queue as its value files that queue's mail."/>
                        </container>
                    </box-body-nopad>
                </container-box>

                <container-box>
                    <box-header title="Public form"/>
                    <box-body-nopad>
                        <form-list name="IntakeTokens" list="routing.tokens" skip-form="true" paginate="false">
                            <field name="queueText"><default-field title="Queue"><display/></default-field></field>
                            <field name="stateText"><default-field title="Form"><display/></default-field></field>
                            <field name="actions">
                                <default-field title="">
                                    <link url="issueToken" text="${active ? 'New link' : 'Turn on'}" icon="sym_o_link" condition="routing.canEdit"
                                            parameter-map="{requestCategoryId:requestCategoryId, organizationPartyId:orgId}"
                                            confirmation="${active ? 'Make a new link for ' + queueText + '? The current link stops working.' : 'Turn on the public form of ' + queueText + '?'}"/>
                                    <link url="removeToken" text="Turn off" icon="sym_o_link_off" btn-type="danger" condition="routing.canEdit &amp;&amp; active"
                                            parameter-map="{requestCategoryId:requestCategoryId, organizationPartyId:orgId}"
                                            confirmation="Turn off the public form of ${queueText}? Its link stops working."/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="queueText"/></column>
                                <column><field-ref name="stateText"/><field-ref name="actions"/></column>
                            </columns>
                        </form-list>
                        <label type="p" style="q-pa-sm text-caption m-muted q-mb-none"
                                text="The form is the Support app's page on the organization's site. A project's request form stays in Projects."/>
                    </box-body-nopad>
                </container-box>

                <container-box>
                    <box-header title="Held for review"/>
                    <box-body-nopad>
                        <form-list name="HeldRequests" list="routing.held" skip-form="true" paginate="false">
                            <field name="requestName">
                                <default-field title="Request">
                                    <label text="${requestName}" type="span"/>
                                    <label text="${requestId} · ${channelText} · ${dateText}" type="div" style="text-caption m-muted"/>
                                </default-field>
                            </field>
                            <field name="fromText"><default-field title="From"><display/></default-field></field>
                            <field name="reasonText"><default-field title="Why"><display/></default-field></field>
                            <field name="queueText"><default-field title="Queue"><display/></default-field></field>
                            <field name="actions">
                                <default-field title="">
                                    <container-dialog id="AcceptHeld_${requestId}" button-text="Accept" icon="sym_o_check" width="480"
                                            title="Make request ${requestId} a case" condition="routing.canReview">
                                        <form-single name="AcceptHeldForm" transition="reviewHeld" map="{requestId:requestId, decision:'accept', organizationPartyId:orgId}">
                                            <field name="requestId"><default-field><hidden/></default-field></field>
                                            <field name="decision"><default-field><hidden/></default-field></field>
                                            <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                                            <field name="customerPartyId">
                                                <default-field title="Customer" tooltip="Empty: the sender becomes the customer">
                                                    <drop-down allow-empty="true">
                                                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'customers'}"/>
                                                    </drop-down>
                                                </default-field>
                                            </field>
                                            <field name="submitButton"><default-field title="Make it a case"><submit/></default-field></field>
                                        </form-single>
                                    </container-dialog>
                                    <container-dialog id="DismissHeld_${requestId}" button-text="Dismiss" icon="sym_o_close" width="480"
                                            title="Dismiss request ${requestId}" condition="routing.canReview">
                                        <form-single name="DismissHeldForm" transition="reviewHeld" map="{requestId:requestId, decision:'dismiss', organizationPartyId:orgId}">
                                            <field name="requestId"><default-field><hidden/></default-field></field>
                                            <field name="decision"><default-field><hidden/></default-field></field>
                                            <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                                            <field name="reason"><default-field title="Why"><text-line size="40"/></default-field></field>
                                            <field name="submitButton">
                                                <default-field title="Dismiss">
                                                    <submit type="danger" confirmation="Dismiss request ${requestId}? It is cancelled and becomes no case."/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="requestName"/><field-ref name="fromText"/></column>
                                <column><field-ref name="reasonText"/><field-ref name="actions"/></column>
                            </columns>
                        </form-list>
                        <label type="p" style="q-pa-sm m-muted q-mb-none" condition="!routing.held.length"
                                text="Nothing held: mail and forms from staff, from parties that are no customer and from unknown senders wait here."/>
                    </box-body-nopad>
                </container-box>

                <!-- ===== RouteTest ===== -->
                <container-box>
                    <box-header title="Test a message"/>
                    <box-body>
                        <form-single name="RouteTest" transition="testRoute"
                                map="{organizationPartyId:orgId, testCategoryId:(testCategoryId || queueOptions[0]?.value || ''), testFromAddress:testFromAddress,
                                    testSubject:testSubject, testInReplyTo:testInReplyTo, testHeaders:testHeaders}">
                            <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                            <field name="testCategoryId">
                                <default-field title="To the queue">
                                    <drop-down><list-options list="queueOptions" key="${value}" text="${label}"/></drop-down>
                                </default-field>
                            </field>
                            <field name="testFromAddress"><default-field title="From"><text-line size="30"/></default-field></field>
                            <field name="testSubject"><default-field title="Subject"><text-line size="40"/></default-field></field>
                            <field name="testInReplyTo">
                                <default-field title="In reply to" tooltip="A Message-ID, as &lt;id@host&gt;"><text-line size="40"/></default-field>
                            </field>
                            <field name="testHeaders">
                                <default-field title="Headers" tooltip="Such as Auto-Submitted: auto-replied"><text-area rows="2" cols="50"/></default-field>
                            </field>
                            <field name="submitButton"><default-field title="Test"><submit/></default-field></field>
                            <field-layout>
                                <field-row><field-ref name="testCategoryId"/><field-ref name="testFromAddress"/></field-row>
                                <field-row><field-ref name="testSubject"/><field-ref name="testInReplyTo"/></field-row>
                                <field-ref name="testHeaders"/>
                                <field-ref name="submitButton"/>
                            </field-layout>
                        </form-single>
                        <label type="p" style="text-negative" text="${testError}" condition="testError"/>
                        <section name="RouteTestResult" condition="test">
                            <widgets>
                                <label type="h6" text="${test.outcomeText}"/>
                                <label type="div" text="${ec.l10n.localize('Route')}: ${test.routeText}"/>
                                <label type="div" text="${ec.l10n.localize('Sender')}: ${test.senderName} (${test.senderKind})"/>
                                <label type="div" text="${ec.l10n.localize('Customer')}: ${test.customerName}" condition="test.customerName"/>
                                <label type="div" text="${ec.l10n.localize('Automatic')}: ${test.automatic}" condition="test.automatic"/>
                                <label type="div" text="${ec.l10n.localize('Joins by its')} ${test.threadBy}" condition="test.threadBy"/>
                                <label type="div" text="${test.acknowledged ? ec.l10n.localize('A new case is acknowledged') : ec.l10n.localize('No acknowledgement')}"/>
                                <label type="div" style="text-caption m-muted" text="Nothing was written or sent."/>
                            </widgets>
                        </section>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
