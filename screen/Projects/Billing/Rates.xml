<!-- Rates (design-projects.md §10 Rates; style-guide §3.2 List; impl-projects.md P8a): the versioned hour rates (RateAmount) of client
    billing and worker pay, for those who manage money (service/ironstone/projects/BillingServices.xml find#RateRows, store#Rate, end#Rate,
    get#WhichRate). The chips: Client billing (the default) and Worker pay, with their counts. The find (the list's dialog): project,
    person, work type, rate type, effective on a day, and the ended ones. Each row: the rate type, project (or any), person (or anyone),
    work type, position class, from, thru, the amount an hour, current, coming or ended; Edit (from, thru and the amount: a rate's scope
    never changes, so a change of scope is End and New rate), End. New rate (purpose, rate type, project, person, position class, work
    type, from, thru, amount). Which rate: the client and worker rates a person's time on a project or work item, of a work type, on a
    day finds (mantle.work.TimeServices.find#RateAmount), and why. A rate applies to time logged in its dates; the rates already found for
    time not invoiced are found again by the project's Update rates (ProjectTime). People P10 (impl-people P10, F57; design-projects §10
    "Context passed", owner contract): mounted under People too (People/Payroll/Rates), where payroll reads and sets the employees'
    pay rates (Worker pay, PAYROLL_VIEW and PAYROLL_EDIT; check#RateAccess) and client billing is hidden without money; and a
    third chip, Labor costing, lists the labor costing rates (RaprCost) read only, which finance administration sets in
    Accounting's Costing policies. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Rates" default-menu-index="3" menu-image="sym_o_percent" menu-image-type="icon">

    <parameter name="purpose"/>
    <parameter name="rootWorkEffortId"/>
    <parameter name="partyId"/>
    <parameter name="workTypeEnumId"/>
    <parameter name="rateTypeEnumId"/>
    <parameter name="effectiveOn"/>
    <parameter name="showEnded"/>
    <parameter name="whichPartyId"/>
    <parameter name="whichWorkEffortId"/>
    <parameter name="whichWorkTypeEnumId"/>
    <parameter name="whichDate"/>

    <transition name="saveRate">
        <actions>
            <service-call name="ironstone.projects.BillingServices.store#Rate" out-map="saveOut" in-map="{rateAmountId:(rateAmountId || null), ratePurposeEnumId:(ratePurposeEnumId || null),
                    rateTypeEnumId:(newRateTypeEnumId || null), workEffortId:(rateWorkEffortId || null), partyId:(ratePartyId || null), emplPositionClassId:(emplPositionClassId || null),
                    workTypeEnumId:(rateWorkTypeEnumId || null), fromDate:(fromDate || null), thruDate:(thruDate || null), rateAmount:(rateAmount ?? ''), rateCurrencyUomId:(rateCurrencyUomId || null)}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(saveOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="purpose"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="endRate">
        <actions>
            <service-call name="ironstone.projects.BillingServices.end#Rate" out-map="endOut" in-map="{rateAmountId:rateAmountId}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(endOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="purpose"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="whichRate">
        <default-response url=".">
            <parameter name="purpose"/><parameter name="whichPartyId"/><parameter name="whichWorkEffortId"/><parameter name="whichWorkTypeEnumId"/><parameter name="whichDate"/>
        </default-response>
    </transition>
    <!-- the people to choose: under People, the employees the user reads (People's choices); else those who keep time or have a user -->
    <transition name="people" read-only="true">
        <actions>
            <if condition="appRoot == 'People'">
                <service-call name="ironstone.people.ContextServices.get#Choices" out-map="found"
                        in-map="{appRoot:appRoot, choice:'employees', term:(term || null), selected:(selected || null)}"/>
                <script>ec.web.sendJsonResponse(found.options || [])</script>
                <else>
                    <service-call name="ironstone.projects.ResourceServices.search#AllocationPeople" in-map="{term:term}" out-map="found"/>
                    <script>ec.web.sendJsonResponse(found.optionList || [])</script>
                </else>
            </if>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <script><![CDATA[
            const L = (text) => ec.l10n.localize(text)
            // what the user reads (check#RateAccess): client billing with money, worker pay with money or payroll, labor costing read only
            rateAccess = ec.service.sync().name('ironstone.projects.BillingServices.check#RateAccess').parameters({need: 'none'}).call() || {}
            const purposes = [['RaprClient', 'Client billing', 'sym_o_request_quote', 'client'], ['RaprVendor', 'Worker pay', 'sym_o_badge', 'worker'],
                ['RaprCost', 'Labor costing', 'sym_o_calculate', 'cost']].filter((entry) => rateAccess[entry[3]])
            if (!purposes.some((entry) => entry[0] === purpose)) purpose = purposes.length ? purposes[0][0] : 'RaprClient'
            managesMoney = !!rateAccess.worker
            rateRows = []
            if (!managesMoney) return
            const out = ec.service.sync().name('ironstone.projects.BillingServices.find#RateRows').parameters({ratePurposeEnumId: purpose, rootWorkEffortId: rootWorkEffortId || null,
                partyId: partyId || null, workTypeEnumId: workTypeEnumId || null, rateTypeEnumId: rateTypeEnumId || null, effectiveOn: effectiveOn || null,
                showEnded: showEnded === 'Y'}).call() || {}
            ec.message.clearErrors()
            rateRows = Array.from(out.rowList || [])
            rateRowsCount = rateRows.length
            const counts = out.counts || {}
            const options = ec.service.sync().name('ironstone.projects.BillingServices.get#RateOptions').call() || {}
            projectOptions = Array.from(options.projectOptions || [])
            workTypeOptions = Array.from(options.workTypeOptions || [])
            positionOptions = Array.from(options.positionOptions || [])
            rateTypeOptions = Array.from(options.rateTypeOptions || [])
            const find = {rootWorkEffortId: rootWorkEffortId || null, partyId: partyId || null, workTypeEnumId: workTypeEnumId || null, rateTypeEnumId: rateTypeEnumId || null,
                effectiveOn: effectiveOn || null, showEnded: showEnded === 'Y' ? 'Y' : null}
            Object.keys(find).forEach((key) => { if (find[key] == null) delete find[key] })
            filtered = Object.keys(find).length > 0
            clearParams = Object.assign(Object.fromEntries(Object.keys(find).map((key) => [key, ''])), {purpose: purpose})
            purposeChips = purposes.map(([key, label, icon]) => ({key: key,
                label: L(label) + ' · ' + (counts[key] ?? 0), icon: icon, on: key === purpose, params: Object.assign({}, find, {purpose: key})}))
            purposeLabel = L(purposes.find((entry) => entry[0] === purpose)?.[1] || 'Client billing')
            // a labor costing rate is Accounting's; payroll without money adds an employee's pay rate only
            canAddRate = purpose !== 'RaprCost'
            payOnly = !!rateAccess.payOnly
            newRateValue = {ratePurposeEnumId: purpose, newRateTypeEnumId: 'RatpStandard', rateWorkEffortId: rootWorkEffortId || '', ratePartyId: partyId || '',
                fromDate: ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd'), rateCurrencyUomId: ec.user.getPreference('CurrencyDefault') || 'USD'}
            emptyText = filtered ? L('No rates match') : purpose === 'RaprVendor' ? L('No worker pay rates: time is paid at none')
                    : purpose === 'RaprCost' ? L('No labor costing rates: labor hours are unpriced') : L('No client rates: time is billed at none')
            // Which rate
            whichAsked = !!(whichPartyId || whichWorkEffortId || whichWorkTypeEnumId || whichDate)
            whichValue = {purpose: purpose, whichPartyId: whichPartyId || '', whichWorkEffortId: whichWorkEffortId || '', whichWorkTypeEnumId: whichWorkTypeEnumId || '',
                whichDate: whichDate || ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')}
            whichAnswer = null
            if (whichAsked && rateAccess.client) {
                whichAnswer = ec.service.sync().name('ironstone.projects.BillingServices.get#WhichRate').parameters({partyId: whichPartyId || null, workEffortId: whichWorkEffortId || null,
                    workTypeEnumId: whichWorkTypeEnumId || null, onDate: whichDate || null}).call()?.answer || null
                whichError = ec.message.hasError() ? ec.message.getErrorsString() : ''
                ec.message.clearErrors()
                const party = whichPartyId ? ec.entity.find('mantle.party.PartyDetail').condition('partyId', whichPartyId).disableAuthz().one() : null
                whichQuestion = [party ? [party.firstName, party.lastName].filter((part) => part).join(' ') || party.organizationName : L('Anyone'),
                    whichWorkEffortId || L('any project'), whichWorkTypeEnumId ? (workTypeOptions.find((type) => type.key === whichWorkTypeEnumId)?.text || whichWorkTypeEnumId) : L('any work'),
                    whichDate || L('today')].join(' · ')
            }
        ]]></script>
    </actions>

    <widgets>
        <section name="NoMoney" condition="!managesMoney"><widgets>
            <container-box type="warning"><box-header title="Not available"/><box-body>
                <label type="p" text="Rates are for those who manage money or payroll." style="q-mb-none"/>
            </box-body></container-box>
        </widgets></section>
        <section name="Rates" condition="managesMoney"><widgets>
            <container style="row items-center q-mb-sm q-gutter-y-xs">
                <label text="Rates" type="h5" style="q-my-none q-mr-sm"/>
                <container style="col"/>
                <container-dialog id="WhichRateDialog" button-text="Which rate" icon="sym_o_help" width="560" title="Which rate applies"
                        condition="rateAccess.client">
                    <form-single name="WhichRate" transition="whichRate" map="whichValue">
                        <field name="purpose"><default-field><hidden/></default-field></field>
                        <field name="whichPartyId"><default-field title="Person">
                            <drop-down allow-empty="true"><dynamic-options transition="people" server-search="true" min-length="0"/></drop-down></default-field></field>
                        <field name="whichWorkEffortId"><default-field title="Project or work item (its id, such as IRON or IRON-3)"><text-line size="20"/></default-field></field>
                        <field name="whichWorkTypeEnumId"><default-field title="Work type">
                            <drop-down allow-empty="true"><list-options list="workTypeOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                        <field name="whichDate"><default-field title="On"><date-time type="date" format="yyyy-MM-dd"/></default-field></field>
                        <field name="submitButton"><default-field title="Find the rates"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                <container-dialog id="NewRateDialog" button-text="New rate" icon="sym_o_add" width="600" title="New rate" condition="canAddRate">
                    <form-single name="NewRate" transition="saveRate" map="newRateValue">
                        <field name="ratePurposeEnumId"><conditional-field condition="!rateAccess.client"><hidden/></conditional-field>
                            <default-field title="For"><radio>
                            <option key="RaprClient" text="Client billing"/><option key="RaprVendor" text="Worker pay"/></radio></default-field></field>
                        <field name="newRateTypeEnumId"><default-field title="Rate type">
                            <drop-down><list-options list="rateTypeOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                        <field name="rateWorkEffortId"><conditional-field condition="payOnly"><hidden/></conditional-field>
                            <default-field title="Project (empty: any)">
                            <drop-down allow-empty="true"><list-options list="projectOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                        <field name="ratePartyId"><conditional-field condition="payOnly" title="Employee">
                            <drop-down><dynamic-options transition="people" server-search="true" min-length="0"/></drop-down></conditional-field>
                            <default-field title="Person (empty: anyone)">
                            <drop-down allow-empty="true"><dynamic-options transition="people" server-search="true" min-length="0"/></drop-down></default-field></field>
                        <field name="rateWorkTypeEnumId"><default-field title="Work type (empty: any)">
                            <drop-down allow-empty="true"><list-options list="workTypeOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                        <field name="emplPositionClassId"><default-field title="Position (empty: any)">
                            <drop-down allow-empty="true"><list-options list="positionOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                        <field name="fromDate"><default-field title="From"><date-time type="date" format="yyyy-MM-dd"/></default-field></field>
                        <field name="thruDate"><default-field title="Thru (empty: open)"><date-time type="date" format="yyyy-MM-dd"/></default-field></field>
                        <field name="rateAmount"><default-field title="Amount an hour"><text-line size="10" input-type="number"/></default-field></field>
                        <field name="rateCurrencyUomId"><default-field title="Currency"><text-line size="5"/></default-field></field>
                        <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                        <field-layout>
                            <field-ref name="ratePurposeEnumId"/>
                            <field-row><field-ref name="newRateTypeEnumId"/><field-ref name="rateWorkEffortId"/></field-row>
                            <field-row><field-ref name="ratePartyId"/><field-ref name="rateWorkTypeEnumId"/></field-row>
                            <field-ref name="emplPositionClassId"/>
                            <field-row><field-ref name="fromDate"/><field-ref name="thruDate"/></field-row>
                            <field-row><field-ref name="rateAmount"/><field-ref name="rateCurrencyUomId"/></field-row>
                            <field-ref name="submitButton"/>
                        </field-layout>
                    </form-single>
                </container-dialog>
            </container>

            <section name="WhichAnswer" condition="whichAsked"><widgets>
                <container-box><box-header title="Which rate · ${whichQuestion}"/><box-body>
                    <label type="p" text="${whichError}" style="text-warning" condition="whichError"/>
                    <section name="WhichFound" condition="whichAnswer"><widgets>
                        <container-row>
                            <row-col md="6">
                                <label text="Client billing" type="div" style="text-caption m-muted"/>
                                <label text="${whichAnswer.client.text}" type="div" style="text-h6"/>
                                <label text="${whichAnswer.client.why}" type="div" style="text-caption"/>
                            </row-col>
                            <row-col md="6">
                                <label text="Worker pay" type="div" style="text-caption m-muted"/>
                                <label text="${whichAnswer.worker.text}" type="div" style="text-h6"/>
                                <label text="${whichAnswer.worker.why}" type="div" style="text-caption"/>
                            </row-col>
                        </container-row>
                        <label type="p" text="${whichAnswer.note}" style="text-caption m-muted q-mt-sm q-mb-none"/>
                    </widgets></section>
                    <link url="." link-type="anchor" text="Close" parameter-map="{purpose:purpose}"/>
                </box-body></container-box>
            </widgets></section>

            <container style="row q-gutter-xs q-mb-sm">
                <section-iterate name="PurposeChip" list="purposeChips" entry="chip"><widgets>
                    <section name="PurposeChipOn" condition="chip.on"><widgets>
                        <link url="." link-type="anchor-button" btn-type="primary" text="${chip.label}" icon="${chip.icon}" parameter-map="chip.params"/>
                    </widgets><fail-widgets>
                        <link url="." link-type="anchor-button" text="${chip.label}" icon="${chip.icon}" parameter-map="chip.params"/>
                    </fail-widgets></section>
                </widgets></section-iterate>
            </container>
            <section name="ClearFilters" condition="filtered"><widgets>
                <container style="q-mb-xs"><link url="." link-type="anchor" text="Clear filters" parameter-map="clearParams"/></container>
            </widgets></section>

            <container-box><box-header title="${purposeLabel} · ${rateRowsCount}"/><box-body-nopad>
                <form-list name="RateList" list="rateRows" skip-form="true" paginate="false" header-dialog="true" select-columns="true" show-csv-button="true">
                    <!-- the find (the list's dialog) -->
                    <field name="purpose"><header-field><hidden/></header-field></field>
                    <field name="rootWorkEffortId"><header-field title="Project">
                        <drop-down allow-empty="true"><list-options list="projectOptions" key="${key}" text="${text}"/></drop-down></header-field></field>
                    <field name="partyId"><header-field title="Person">
                        <drop-down allow-empty="true"><dynamic-options transition="people" server-search="true" min-length="0"/></drop-down></header-field></field>
                    <field name="workTypeEnumId"><header-field title="Work type">
                        <drop-down allow-empty="true"><list-options list="workTypeOptions" key="${key}" text="${text}"/></drop-down></header-field></field>
                    <field name="rateTypeEnumId"><header-field title="Rate type">
                        <drop-down allow-empty="true"><list-options list="rateTypeOptions" key="${key}" text="${text}"/></drop-down></header-field></field>
                    <field name="effectiveOn"><header-field title="Effective on"><date-time type="date" format="yyyy-MM-dd"/></header-field></field>
                    <field name="showEnded"><header-field title=""><check><option key="Y" text="Show ended rates"/></check></header-field></field>

                    <!-- the columns -->
                    <field name="rateTypeText"><default-field title="Rate type"><display/></default-field></field>
                    <field name="projectName"><default-field title="Project">
                        <link url="${projectUrl}" url-type="plain" text="${projectName}" link-type="anchor" condition="projectUrl"/>
                        <label text="${projectName}" type="span" style="m-muted" condition="!projectUrl"/></default-field></field>
                    <field name="personName"><default-field title="Person"><label text="${personName}" type="span" style="${partyId ? '' : 'm-muted'}"/></default-field></field>
                    <field name="workTypeText"><default-field title="Work type"><label text="${workTypeText}" type="span" style="${workTypeEnumId ? '' : 'm-muted'}"/>
                        <label text="${positionText}" type="div" style="text-caption m-muted" condition="positionText"/></default-field></field>
                    <field name="fromText"><default-field title="From"><label text="${fromText}" type="span" style="text-no-wrap"/></default-field></field>
                    <field name="thruText"><default-field title="Thru"><label text="${thruText}" type="span" style="text-no-wrap"/></default-field></field>
                    <field name="amountText" align="right"><default-field title="Rate">
                        <label text="${amountText}" type="span" style="text-no-wrap text-weight-medium ${ended ? 'm-muted' : ''}"/></default-field></field>
                    <field name="stateText"><default-field title="">
                        <label text="${stateText}" type="span" style="text-caption ${ended ? 'm-muted' : coming ? 'text-info' : 'text-positive'}"/></default-field></field>
                    <field name="actions" align="right"><default-field title="">
                        <container style="row items-center justify-end no-wrap q-gutter-xs">
                            <container-dialog id="EditRateDialog" button-text="" icon="sym_o_edit" width="480" title="Edit the rate" condition="canChange">
                                <form-single name="EditRate" transition="saveRate">
                                    <field name="rateAmountId"><default-field><hidden/></default-field></field>
                                    <field name="purpose" from="ratePurposeEnumId"><default-field><hidden/></default-field></field>
                                    <field name="scopeText"><default-field title="Applies to">
                                        <label text="${projectName} · ${personName} · ${workTypeText}" type="span"/></default-field></field>
                                    <field name="fromDate" from="fromValue"><default-field title="From"><date-time type="date" format="yyyy-MM-dd"/></default-field></field>
                                    <field name="thruDate" from="thruValue"><default-field title="Thru (empty: open)"><date-time type="date" format="yyyy-MM-dd"/></default-field></field>
                                    <field name="rateAmount" from="amountValue"><default-field title="Amount an hour"><text-line size="10" input-type="number"/></default-field></field>
                                    <field name="scopeNote"><default-field title=""><label text="To change what the rate applies to, end it and add a new rate." type="p" style="text-caption m-muted"/></default-field></field>
                                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                                </form-single>
                            </container-dialog>
                            <link url="endRate" link-type="hidden-form-link" text="" icon="sym_o_event_busy" tooltip="End the rate now" style="m-btn-flat"
                                    confirmation="End this rate now? Time logged from now on finds another rate." parameter-map="{rateAmountId:rateAmountId, purpose:ratePurposeEnumId}" condition="canChange"/>
                        </container>
                    </default-field></field>
                    <field name="findButton"><header-field title="Find"><submit/></header-field></field>

                    <columns>
                        <column><field-ref name="rateTypeText"/><field-ref name="amountText"/></column>
                        <column><field-ref name="projectName"/><field-ref name="personName"/></column>
                        <column><field-ref name="workTypeText"/></column>
                        <column><field-ref name="fromText"/><field-ref name="thruText"/></column>
                        <column><field-ref name="stateText"/><field-ref name="actions"/></column>
                    </columns>
                    <columns type="mobile">
                        <column><field-ref name="projectName"/><field-ref name="personName"/><field-ref name="workTypeText"/></column>
                        <column><field-ref name="amountText"/><field-ref name="stateText"/><field-ref name="actions"/></column>
                    </columns>
                </form-list>
                <section name="NoRates" condition="!rateRows.length"><widgets>
                    <label type="p" text="${emptyText}" style="m-muted q-pa-sm q-mb-none"/>
                </widgets></section>
            </box-body-nopad></container-box>
            <label type="p" text="A time entry finds its rate when it is logged: a rate on its work item, else on its project, else on no project; a person's own rate when it is the greater; the closest work type and position. Rates change only the time logged in their dates." style="text-caption m-muted q-mt-sm"
                    condition="purpose != 'RaprCost'"/>
            <label type="p" text="Labor costing rates price approved hours by position and work type for cost reports, never a person's pay. Finance administration sets them in Accounting's Costing policies." style="text-caption m-muted q-mt-sm"
                    condition="purpose == 'RaprCost'"/>
        </widgets></section>
    </widgets>
</screen>
