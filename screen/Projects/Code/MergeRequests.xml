<!-- MergeRequests (design-projects.md §7 MergeRequests; style-guide §3.2 List): the merge requests of the repositories the user
    may view (org.moqui.git.GitReviewServices.find#MergeRequests through ironstone.projects.CodeServices.find#MergeRequests). Chips with
    their counts: Waiting for my review (the default when there are any), Mine, Open (with the drafts), Draft, Merged, Closed and
    All; the find in the list's dialog (text in the title, repository, project, author, reviewer, target branch), its saved finds
    the user keeps. The columns: the number and title (a link to MergeRequestDetail) with the branches, the repository, the
    author, the reviewers with their states, the head's checks, the comments, the linked work items and when it changed. New
    merge request opens Compare (of the repository when one is chosen).

    RepositoryDetail mounts this screen as its Merge requests tab (design §7 RepositoryMergeRequests): its always-actions put the
    repository's access in repoAccess, so the repository is fixed there and its column and find field are left out. Without git
    hosting in the build it says so. A client contact (clientUser; impl-projects.md P10b) sees the merge requests of the
    repositories its projects share, without reviewers, comments or New merge request. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Merge requests" default-menu-index="2" menu-image="sym_o_merge" menu-image-type="icon">

    <parameter name="list"/>
    <parameter name="text"/>
    <parameter name="repositoryId"/>
    <parameter name="projectId"/>
    <parameter name="authorUserId"/>
    <parameter name="reviewerUserId"/>
    <parameter name="targetRef"/>
    <parameter name="pageIndex"/>

    <transition name="mergeRequestDetail"><default-response url="//Projects/Code/MergeRequestDetail"/></transition>
    <transition name="compare"><default-response url="//Projects/Code/Compare"/></transition>
    <transition name="repositoryDetail"><default-response url="//Projects/Code/RepositoryDetail"/></transition>

    <actions>
        <script><![CDATA[
            const L = (text) => ec.l10n.localize(text)
            // in RepositoryDetail's tab its always-actions read the repository: the repository is fixed
            repositoryFixed = ec.context.get('repoAccess') != null
            mergeRequestRows = []; mergeRequestRowsCount = 0; mergeRequestRowsPageIndex = 0; mergeRequestRowsPageSize = 25; mergeRequestRowsPageMaxIndex = 0
            mergeRequestRowsPageRangeLow = 0; mergeRequestRowsPageRangeHigh = 0; listChips = []; repositoryOptions = []; projectOptions = []; userOptions = []
            listLabel = ''; emptyText = ''; newParams = {}
            canOpen = !clientUser && (!repositoryFixed || (ec.context.get('canPush') && !ec.context.get('isArchived')))
            if (!codeHosting || (repositoryFixed && !ec.context.get('recordFound'))) return
            const lists = [['waiting', 'Waiting for my review', 'sym_o_rate_review'], ['mine', 'Mine', 'sym_o_person'], ['open', 'Open', 'sym_o_merge'],
                ['draft', 'Draft', 'sym_o_draft'], ['merged', 'Merged', 'sym_o_call_merge'], ['closed', 'Closed', 'sym_o_cancel'], ['all', 'All', 'sym_o_select_all']]
                    .filter((entry) => !clientUser || !['waiting', 'mine'].includes(entry[0]))
            const index = Number(pageIndex || 0) || 0
            if (clientUser && (!list || ['waiting', 'mine'].includes(list))) list = 'open'
            const out = ec.service.sync().name('ironstone.projects.CodeServices.find#MergeRequests').parameters({list: list || null, text: text || null,
                repositoryId: repositoryId || null, projectId: projectId || null, authorUserId: authorUserId || null, reviewerUserId: reviewerUserId || null,
                targetRef: targetRef || null, pageIndex: index, pageSize: 25}).call() || {}
            ec.message.clearErrors()
            list = out.list || 'open'
            mergeRequestRows = Array.from(out.rowList || [])
            mergeRequestRowsCount = out.rowCount || 0
            mergeRequestRowsPageIndex = index
            mergeRequestRowsPageMaxIndex = Math.max(0, Math.ceil(mergeRequestRowsCount / 25) - 1)
            mergeRequestRowsPageRangeLow = mergeRequestRowsCount ? index * 25 + 1 : 0
            mergeRequestRowsPageRangeHigh = Math.min(mergeRequestRowsCount, (index + 1) * 25)
            const counts = out.counts || {}
            // the find narrows every chip; a chip keeps it
            const kept = {}
            for (const [key, value] of [['text', text], ['projectId', projectId], ['authorUserId', authorUserId], ['reviewerUserId', reviewerUserId], ['targetRef', targetRef],
                    ['repositoryId', repositoryId]]) if (value) kept[key] = value
            listChips = lists.map(([key, label, icon]) => ({label: L(label) + ' · ' + (counts[key] || 0), icon: icon, on: key === list,
                params: Object.assign({list: key}, kept)}))
            listLabel = L(lists.find((entry) => entry[0] === list)[1])
            const options = ec.service.sync().name('ironstone.projects.CodeServices.get#MergeRequestFindOptions').call() || {}
            // in a repository's tab the find stays in it
            repositoryOptions = repositoryFixed ? [{key: repositoryId, text: repositoryId}] : (options.repositoryOptions || [])
            projectOptions = options.projectOptions || []
            userOptions = options.userOptions || []
            newParams = repositoryId ? {repositoryId: repositoryId} : (repositoryOptions.length === 1 ? {repositoryId: repositoryOptions[0].key} : {})
            const empty = {waiting: 'No review is waiting for you', mine: 'You have no open merge request', open: 'No open merge requests',
                draft: 'No drafts', merged: 'Nothing merged yet', closed: 'No closed merge requests', all: 'No merge requests yet'}
            emptyText = Object.keys(kept).filter((key) => key !== 'repositoryId').length ? L('No merge requests match') : L(empty[list])
        ]]></script>
    </actions>

    <widgets>
        <section name="MergeRequestsTitle" condition="!repositoryFixed"><widgets>
            <container style="row items-center q-mb-sm q-gutter-y-xs">
                <label text="Merge requests" type="h5" style="q-my-none q-mr-sm"/>
                <container style="col"/>
                <section name="NewMergeRequestRepo" condition="codeHosting &amp;&amp; newParams.repositoryId &amp;&amp; canOpen"><widgets>
                    <link url="compare" text="New merge request" icon="sym_o_merge" btn-type="primary" parameter-map="newParams"/>
                </widgets><fail-widgets>
                    <container-dialog id="NewMergeRequestDialog" button-text="New merge request" icon="sym_o_merge" width="480" title="New merge request in"
                            condition="codeHosting &amp;&amp; repositoryOptions.length &amp;&amp; canOpen">
                        <form-single name="NewMergeRequestPick" transition="compare">
                            <field name="repositoryId"><default-field title="Repository">
                                <drop-down><list-options list="repositoryOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                            <field name="submitButton"><default-field title="Compare branches"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                </fail-widgets></section>
            </container>
        </widgets><fail-widgets>
            <container style="row items-center q-mb-sm">
                <container style="col"/>
                <link url="compare" text="New merge request" icon="sym_o_merge" parameter-map="{repositoryId:repositoryId}" condition="canOpen"/>
            </container>
        </fail-widgets></section>

        <section name="NoCodeHosting" condition="!codeHosting"><widgets>
            <container-box type="warning"><box-header title="Code hosting is not in this build"/><box-body>
                <label type="p" text="This server was built without git hosting. Repositories, merge requests and git access need a build with the git feature." style="q-mb-none"/>
            </box-body></container-box>
        </widgets><fail-widgets>
            <container style="row q-gutter-xs q-mb-sm m-task-chips">
                <section-iterate name="MergeRequestChip" list="listChips" entry="chip"><widgets>
                    <section name="MergeRequestChipOn" condition="chip.on"><widgets>
                        <link url="." link-type="anchor-button" btn-type="primary" text="${chip.label}" icon="${chip.icon}" parameter-map="chip.params"/>
                    </widgets><fail-widgets>
                        <link url="." link-type="anchor-button" text="${chip.label}" icon="${chip.icon}" parameter-map="chip.params"/>
                    </fail-widgets></section>
                </widgets></section-iterate>
            </container>

            <container-box><box-header title="${listLabel} · ${mergeRequestRowsCount}"/><box-body-nopad>
                <form-list name="MergeRequestList" list="mergeRequestRows" skip-form="true" paginate="true" show-page-size="false" header-dialog="true" saved-finds="true">
                    <field name="list"><header-field><hidden/></header-field></field>
                    <field name="text"><header-field title="Text in the title"><text-line size="20"/></header-field></field>
                    <field name="mergeRequestId"><header-field title="Merge request"/><default-field>
                        <container style="row items-center no-wrap">
                            <render-mode><text type="qvt"><![CDATA[<q-icon name="${statusIcon}" size="xs" class="q-mr-xs text-${statusColor}"><q-tooltip>${WebUtilities.encodeHtml(statusLabel ?? '')}</q-tooltip></q-icon>]]></text>
                                <text type="tui" template="false">[]</text></render-mode>
                            <link url="mergeRequestDetail" text="${numText} ${title}" parameter-map="{mergeRequestId:mergeRequestId}" link-type="anchor" style="text-weight-medium"/>
                        </container>
                        <label text="${branchText}${conflict ? ' · ' + ec.l10n.localize('Conflicts') : ''}" type="div" style="text-caption text-mono m-muted"/>
                    </default-field></field>
                    <field name="statusLabel"><default-field title="Status">
                        <render-mode><text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${statusColor}">${WebUtilities.encodeHtml(statusLabel ?? '')}</q-chip>]]></text>
                            <text type="tui"><![CDATA[{"t": "text", "style": "strong", "text": ${JSON.stringify(statusLabel ?? "")}}]]></text></render-mode>
                    </default-field></field>
                    <field name="repositoryId"><header-field title="Repository"><drop-down allow-empty="true"><list-options list="repositoryOptions" key="${key}" text="${text}"/></drop-down></header-field>
                        <conditional-field condition="!repositoryFixed" title="Repository">
                            <link url="repositoryDetail" text="${repositoryId}" parameter-map="{repositoryId:repositoryId}" link-type="anchor" style="text-mono"/>
                        </conditional-field><default-field title=""><label text="" type="span"/></default-field></field>
                    <field name="projectId"><header-field title="Project"><drop-down allow-empty="true"><list-options list="projectOptions" key="${key}" text="${text}"/></drop-down></header-field></field>
                    <field name="authorUserId"><header-field title="Author"><drop-down allow-empty="true"><list-options list="userOptions" key="${key}" text="${text}"/></drop-down></header-field>
                        <default-field title="Author">
                            <render-mode><text type="qvt"><![CDATA[<span class="row inline no-wrap items-center"><m-avatar name="${WebUtilities.encodeHtml(authorName ?? '')}" user-id="${WebUtilities.encodeHtml(authorUserId ?? '')}" size="22px" class="q-mr-xs"></m-avatar><span>${WebUtilities.encodeHtml(authorName ?? '')}</span></span>]]></text>
                                <text type="tui"><![CDATA[{"t": "text", "text": ${JSON.stringify(authorName ?? "")}}]]></text></render-mode>
                        </default-field></field>
                    <field name="reviewerUserId"><header-field title="Reviewer"><drop-down allow-empty="true"><list-options list="userOptions" key="${key}" text="${text}"/></drop-down></header-field>
                        <default-field title="Reviewers">
                            <section-iterate name="MergeRequestReviewer" list="reviewerList" entry="reviewer"><widgets>
                                <render-mode><text type="qvt"><![CDATA[<div class="row no-wrap items-center text-no-wrap"><q-icon name="${reviewer.stateIcon}" size="xs" class="q-mr-xs text-${reviewer.stateColor}"><q-tooltip>${WebUtilities.encodeHtml(reviewer.stateLabel ?? '')}</q-tooltip></q-icon><span>${WebUtilities.encodeHtml(reviewer.name ?? '')}</span></div>]]></text>
                                    <text type="tui"><![CDATA[{"t": "text", "text": ${JSON.stringify((reviewer.name ?? "") + " (" + (reviewer.stateLabel ?? "") + ")")}}]]></text></render-mode>
                            </widgets></section-iterate>
                        </default-field></field>
                    <field name="targetRef"><header-field title="Target branch"><text-line size="20"/></header-field></field>
                    <field name="checkLabel"><default-field title="Checks">
                        <render-mode><text type="qvt"><![CDATA[${checkLabel ? '<q-chip dense square class="q-ma-none m-tonal text-' + checkColor + '" data-check="' + WebUtilities.encodeHtml(checkState ?? '') + '">' + WebUtilities.encodeHtml(checkLabel) + '</q-chip>' : ''}]]></text>
                            <text type="tui"><![CDATA[{"t": "text", "text": ${JSON.stringify(checkLabel ?? "")}}]]></text></render-mode>
                    </default-field></field>
                    <field name="commentCount" align="right"><default-field title="Comments">
                        <render-mode><text type="qvt"><![CDATA[${commentCount ? '<span class="row inline no-wrap items-center m-muted"><q-icon name="sym_o_chat_bubble" size="xs" class="q-mr-xs"></q-icon>' + commentCount + '</span>' : ''}]]></text>
                            <text type="tui"><![CDATA[{"t": "text", "text": ${JSON.stringify(commentCount ? String(commentCount) : "")}}]]></text></render-mode>
                    </default-field></field>
                    <field name="itemsText"><default-field title="Work items">
                        <section-iterate name="MergeRequestItem" list="itemList" entry="item"><widgets>
                            <link url="/qapps/Projects/WorkItems/WorkItemDetail" url-type="plain" text="${item.workEffortId}" link-type="anchor" parameter-map="{workEffortId:item.workEffortId}"
                                    tooltip="${item.workEffortName}" style="text-mono q-mr-sm"/>
                        </widgets></section-iterate></default-field></field>
                    <field name="updatedText"><default-field title="Updated"><label text="${updatedText}" type="span" style="text-no-wrap"/></default-field></field>
                    <field name="findButton"><header-field title="Find"><submit/></header-field></field>

                    <columns>
                        <column><field-ref name="mergeRequestId"/></column>
                        <column><field-ref name="statusLabel"/><field-ref name="checkLabel"/></column>
                        <column><field-ref name="repositoryId"/><field-ref name="authorUserId"/></column>
                        <column><field-ref name="reviewerUserId"/><field-ref name="itemsText"/></column>
                        <column><field-ref name="commentCount"/><field-ref name="updatedText"/></column>
                    </columns>
                    <columns type="mobile">
                        <column><field-ref name="mergeRequestId"/></column>
                        <column><field-ref name="statusLabel"/><field-ref name="checkLabel"/></column>
                    </columns>
                </form-list>
                <section name="NoMergeRequests" condition="!mergeRequestRows.length"><widgets>
                    <container style="q-pa-sm">
                        <label type="p" text="${emptyText}" style="m-muted q-mb-xs"/>
                        <section name="NoMergeRequestsOpen" condition="list == 'waiting'"><widgets>
                            <link url="." link-type="anchor" text="See the open merge requests" parameter-map="{list:'open', repositoryId:repositoryId}"/>
                        </widgets></section>
                    </container>
                </widgets></section>
            </box-body-nopad></container-box>
        </fail-widgets></section>
    </widgets>
</screen>
