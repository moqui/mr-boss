<!-- MergeRequestChanges (design-projects.md §7 MergeRequestChanges), the component Changes.xml serves in the qvue render mode. From
    1024 px the changed files as a tree on the side (each with its insertions, deletions, open threads and a viewed mark kept in
    this browser for the head commit), the diffs in the main pane: unified, or side by side (the choice kept in this browser).
    A line shows + on hover (always on a touch screen) to start a comment on it; a thread shows under its line with its
    comments, Reply and Resolve (or Reopen), and "outdated" when a later push changed the line; a thread whose line is no longer
    in the diff shows at the top of its file. Submit review opens the review dialog (approve, request changes or comment, with
    a summary; an author does not approve their own); review=true opens it at once. A merged or closed merge request is read
    only. The diff's lines are text, never html (impl-projects.md F32); a comment of a public conversation (bodyFormat html, a post
    of a repository Smithy keeps) is its cleaned html with no image (a remote one would be fetched by a staff browser), cleaned again by DOMPurify, which the component loads, and shown only once that is loaded; any other comment is markdown, shown through m-markdown (which
    sanitizes). Keys: j and k the next and previous file, v marks the file viewed. -->
<template><div class="boss-mr-changes">
    <div v-if="loading && !changes" class="q-pa-md">
        <q-skeleton type="text" width="30%"></q-skeleton>
        <q-skeleton type="rect" height="240px" class="q-mt-md"></q-skeleton>
    </div>
    <div v-else-if="notFound" class="q-pa-lg text-center">
        <q-icon name="sym_o_visibility_off" size="48px" class="m-muted"></q-icon>
        <div class="text-h6 q-mt-sm">{{t('These changes are not available')}}</div>
        <div class="text-body2 m-muted">{{t('The merge request is gone, or you may not view its repository.')}}</div>
    </div>
    <template v-else-if="changes">
        <!-- the toolbar -->
        <div class="row items-center q-gutter-sm q-mb-sm">
            <div class="text-body2">
                <span class="text-weight-medium">{{changes.fileList.length}} {{changes.fileList.length === 1 ? t('file') : t('files')}}</span>
                <span class="text-positive q-ml-sm">+{{changes.insertions}}</span><span class="text-negative q-ml-xs">−{{changes.deletions}}</span>
                <span v-if="openThreadCount" class="m-muted q-ml-sm">· {{openThreadCount}} {{openThreadCount === 1 ? t('open thread') : t('open threads')}}</span>
                <span class="m-muted q-ml-sm">· {{viewedCount}}/{{changes.fileList.length}} {{t('viewed')}}</span>
            </div>
            <div class="col"></div>
            <q-btn-toggle v-model="layout" dense no-caps unelevated toggle-color="primary" size="sm" class="m-btn-tonal"
                    :options="[{label: t('Unified'), value: 'unified'}, {label: t('Side by side'), value: 'split'}]"></q-btn-toggle>
            <q-btn v-if="changes.canReview" unelevated no-caps color="primary" icon="sym_o_rate_review" :label="t('Submit review')" @click="openReview"></q-btn>
            <q-chip v-else dense square class="m-tonal text-grey-8">{{changes.isOpen ? t('Read only') : t('Read only: merged or closed')}}</q-chip>
        </div>

        <div class="row no-wrap items-start">
            <!-- ===== the file tree ===== -->
            <div v-if="wide" class="col-auto q-pr-md" :style="{width: '300px', position: 'sticky', top: '58px', maxHeight: 'calc(100vh - 66px)', overflowY: 'auto'}">
                <q-tree :nodes="treeNodes" node-key="key" dense default-expand-all no-connectors :selected="selectedPath" @update:selected="goToFile">
                    <template v-slot:default-header="prop">
                        <div class="row items-center no-wrap full-width" style="min-width:0">
                            <q-icon :name="prop.node.icon" size="xs" class="q-mr-xs" :class="prop.node.iconClass"></q-icon>
                            <span class="ellipsis col" :class="prop.node.file && viewed[prop.node.file.path] ? 'm-muted' : ''" :title="prop.node.key">{{prop.node.label}}</span>
                            <template v-if="prop.node.file">
                                <q-badge v-if="openThreadsOf(prop.node.file.path)" rounded color="primary" class="q-ml-xs">{{openThreadsOf(prop.node.file.path)}}</q-badge>
                                <span class="text-caption text-positive q-ml-xs">+{{prop.node.file.insertions}}</span>
                                <span class="text-caption text-negative q-ml-xs">−{{prop.node.file.deletions}}</span>
                                <q-icon v-if="viewed[prop.node.file.path]" name="sym_o_check" size="xs" class="q-ml-xs text-positive"></q-icon>
                            </template>
                        </div>
                    </template>
                </q-tree>
            </div>

            <!-- ===== the diffs ===== -->
            <div class="col" style="min-width:0">
                <div v-if="!changes.fileList.length" class="q-pa-lg text-center m-muted">{{t('No changes: the source has nothing the target lacks.')}}</div>
                <q-card v-for="file in files" :key="file.path" flat bordered class="q-mb-md" :id="fileDomId(file.path)">
                    <div class="row items-center no-wrap q-px-sm q-py-xs" :class="dark ? 'bg-grey-9' : 'bg-grey-2'" style="position: sticky; top: 50px; z-index: 2">
                        <q-btn flat dense round size="sm" :icon="collapsed[file.path] ? 'sym_o_chevron_right' : 'sym_o_expand_more'"
                                :aria-label="(collapsed[file.path] ? t('Expand') : t('Collapse')) + ' ' + file.path" :aria-expanded="!collapsed[file.path]" @click="toggleCollapsed(file.path)"></q-btn>
                        <span class="text-mono text-weight-medium ellipsis col" :title="file.path">{{file.oldPath && file.oldPath !== file.path ? file.oldPath + ' → ' : ''}}{{file.path}}</span>
                        <q-chip dense square class="q-my-none m-tonal text-grey-8">{{file.changeLabel}}</q-chip>
                        <span class="text-caption text-positive q-mx-xs">+{{file.insertions}}</span><span class="text-caption text-negative q-mr-sm">−{{file.deletions}}</span>
                        <q-checkbox dense size="sm" :model-value="!!viewed[file.path]" :label="t('Viewed')" @update:model-value="setViewed(file.path, $event)"></q-checkbox>
                    </div>
                    <template v-if="!collapsed[file.path]">
                        <!-- threads not on a line of this diff: outdated, or on a line a later push took away -->
                        <div v-for="thread in file.orphanThreads" :key="'o' + thread.communicationEventId" class="q-pa-sm">
                            <div class="text-caption m-muted q-mb-xs text-mono">{{t('On line')}} {{thread.newLine != null ? thread.newLine : thread.oldLine}}: {{thread.lineText}}</div>
                            <div class="boss-mr-thread q-pa-sm rounded-borders" :class="threadClass(thread)">
                                <div class="row items-center q-gutter-xs q-mb-xs">
                                    <q-chip v-if="thread.outdated" dense square class="q-ma-none m-tonal text-warning" icon="sym_o_history">{{t('outdated')}}</q-chip>
                                    <q-chip v-if="thread.resolved" dense square class="q-ma-none m-tonal text-positive" icon="sym_o_check_circle">{{t('Resolved')}}</q-chip>
                                </div>
                                <div v-for="comment in thread.commentList" :key="comment.communicationEventId" class="row no-wrap items-start q-mb-sm">
                                    <m-avatar :name="comment.authorName" :user-id="comment.userId || undefined" size="26px" class="q-mr-sm"></m-avatar>
                                    <div class="col" style="min-width:0">
                                        <div class="text-caption"><span class="text-weight-medium">{{comment.authorName}}</span> <span class="m-muted">{{comment.whenText}}</span></div>
                                        <div v-if="comment.bodyFormat === 'html'" class="m-markdown"><div v-if="purifyReady" class="m-markdown-body" v-html="cleanBody(comment.body)"></div></div>
                                        <m-markdown v-else :text="comment.body"></m-markdown>
                                    </div>
                                </div>
                                <div class="row items-center q-gutter-sm">
                                    <q-btn v-if="changes.canComment" flat dense no-caps size="sm" color="primary" icon="sym_o_reply" :label="t('Reply')" @click="startReply(thread)"></q-btn>
                                    <q-btn v-if="changes.canComment" flat dense no-caps size="sm" :icon="thread.resolved ? 'sym_o_undo' : 'sym_o_check'"
                                            :label="thread.resolved ? t('Reopen') : t('Resolve')" @click="resolve(thread, !thread.resolved)"></q-btn>
                                </div>
                                <div v-if="replyTo === thread.communicationEventId" class="q-mt-sm">
                                    <m-text-area :id="'boss-mr-reply-' + thread.communicationEventId" name="replyBody" v-model="replyBody" editor-type="md" rows="3" :label="t('Reply (markdown)')"></m-text-area>
                                    <div class="row justify-end q-gutter-sm q-mt-xs">
                                        <q-btn flat dense no-caps :label="t('Cancel')" @click="replyTo = null"></q-btn>
                                        <q-btn unelevated dense no-caps color="primary" :label="t('Reply')" :loading="busy" :disable="!String(replyBody || '').trim()" @click="sendReply(thread)"></q-btn>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div v-if="file.binary" class="q-pa-md m-muted">{{t('A binary file')}}</div>
                        <div v-else-if="file.tooLarge" class="q-pa-md m-muted">{{t('Too large to show')}}</div>
                        <div v-else-if="!file.hunkList.length" class="q-pa-md m-muted">{{t('No lines changed')}}</div>
                        <div v-else class="overflow-auto">
                            <table class="moqui-diff boss-mr-diff" :style="{minWidth: layout === 'split' ? '900px' : (wide ? '640px' : '0')}">
                                <tbody>
                                    <template v-for="(row, index) in file.rows" :key="row.key">
                                        <!-- a hunk's header -->
                                        <tr v-if="row.kind === 'hunk'" class="diff-hunk"><td :colspan="layout === 'split' ? 6 : 4" class="code">{{row.text}}</td></tr>
                                        <!-- a line, unified -->
                                        <tr v-else-if="row.kind === 'line' && layout === 'unified'" :class="lineClass(row.line)" @mouseenter="hoverKey = file.path + row.lineKey" @mouseleave="hoverKey = null">
                                            <td class="ln">{{row.line.oldNo != null ? row.line.oldNo : ''}}</td>
                                            <td class="ln" style="position: relative">
                                                <q-btn v-if="changes.canComment" round unelevated dense size="xs" color="primary" icon="add"
                                                        :style="commentStyle(file.path + row.lineKey)" :aria-label="t('Comment on this line')"
                                                        @focus="focusKey = file.path + row.lineKey" @blur="focusKey = null" @click="startComment(file, row.line)"></q-btn>
                                                {{row.line.newNo != null ? row.line.newNo : ''}}</td>
                                            <td class="sign">{{row.line.tag === 'insert' ? '+' : row.line.tag === 'delete' ? '−' : ' '}}</td>
                                            <td class="code">{{row.line.text}}</td>
                                        </tr>
                                        <!-- a pair of lines, side by side -->
                                        <tr v-else-if="row.kind === 'line'" @mouseenter="hoverKey = file.path + row.key" @mouseleave="hoverKey = null">
                                            <td class="ln" :style="Object.assign({position: 'relative'}, sideStyle(row.left))">
                                                <q-btn v-if="row.left && changes.canComment" round unelevated dense size="xs" color="primary" icon="add"
                                                        :style="commentStyle(file.path + row.key)" :aria-label="t('Comment on this line')"
                                                        @focus="focusKey = file.path + row.key" @blur="focusKey = null" @click="startComment(file, row.left)"></q-btn>
                                                {{row.left && row.left.oldNo != null ? row.left.oldNo : ''}}</td>
                                            <td class="sign" :style="sideStyle(row.left)">{{row.left && row.left.tag === 'delete' ? '−' : ' '}}</td>
                                            <td class="code" :style="Object.assign({width: '50%'}, sideStyle(row.left))">{{row.left ? row.left.text : ''}}</td>
                                            <td class="ln" :style="Object.assign({position: 'relative'}, sideStyle(row.right))">
                                                <q-btn v-if="row.right && row.right !== row.left && changes.canComment" round unelevated dense size="xs" color="primary" icon="add"
                                                        :style="commentStyle(file.path + row.key)" :aria-label="t('Comment on this line')"
                                                        @focus="focusKey = file.path + row.key" @blur="focusKey = null" @click="startComment(file, row.right)"></q-btn>
                                                {{row.right && row.right.newNo != null ? row.right.newNo : ''}}</td>
                                            <td class="sign" :style="sideStyle(row.right)">{{row.right && row.right.tag === 'insert' ? '+' : ' '}}</td>
                                            <td class="code" :style="Object.assign({width: '50%'}, sideStyle(row.right))">{{row.right ? row.right.text : ''}}</td>
                                        </tr>
                                        <!-- the threads of the line(s) above, and the new comment's form -->
                                        <tr v-if="row.kind === 'line' && (row.threads.length || composerOn(file, row))">
                                            <td :colspan="layout === 'split' ? 6 : 4" class="q-pa-sm text-body2" :style="threadCellStyle">
                                                <div v-for="thread in row.threads" :key="thread.communicationEventId" class="boss-mr-thread q-pa-sm q-mb-sm rounded-borders" :class="threadClass(thread)"
                                                        :id="'boss-mr-thread-' + thread.communicationEventId" style="max-width: 820px">
                                                    <div class="row items-center q-gutter-xs q-mb-xs" v-if="thread.outdated || thread.resolved">
                                                        <q-chip v-if="thread.outdated" dense square class="q-ma-none m-tonal text-warning" icon="sym_o_history">{{t('outdated')}}</q-chip>
                                                        <q-chip v-if="thread.resolved" dense square class="q-ma-none m-tonal text-positive" icon="sym_o_check_circle">{{t('Resolved')}}</q-chip>
                                                        <q-btn v-if="thread.resolved && !expanded[thread.communicationEventId]" flat dense no-caps size="sm" :label="t('Show')"
                                                                @click="expanded[thread.communicationEventId] = true"></q-btn>
                                                    </div>
                                                    <template v-if="!thread.resolved || expanded[thread.communicationEventId]">
                                                        <div v-for="comment in thread.commentList" :key="comment.communicationEventId" class="row no-wrap items-start q-mb-sm">
                                                            <m-avatar :name="comment.authorName" :user-id="comment.userId || undefined" size="26px" class="q-mr-sm"></m-avatar>
                                                            <div class="col" style="min-width:0">
                                                                <div class="text-caption"><span class="text-weight-medium">{{comment.authorName}}</span> <span class="m-muted">{{comment.whenText}}</span></div>
                                                                <div v-if="comment.bodyFormat === 'html'" class="m-markdown"><div v-if="purifyReady" class="m-markdown-body" v-html="cleanBody(comment.body)"></div></div>
                                                                <m-markdown v-else :text="comment.body"></m-markdown>
                                                            </div>
                                                        </div>
                                                        <div class="row items-center q-gutter-sm">
                                                            <q-btn v-if="changes.canComment" flat dense no-caps size="sm" color="primary" icon="sym_o_reply" :label="t('Reply')" @click="startReply(thread)"></q-btn>
                                                            <q-btn v-if="changes.canComment" flat dense no-caps size="sm" :icon="thread.resolved ? 'sym_o_undo' : 'sym_o_check'"
                                                                    :label="thread.resolved ? t('Reopen') : t('Resolve')" @click="resolve(thread, !thread.resolved)"></q-btn>
                                                        </div>
                                                        <div v-if="replyTo === thread.communicationEventId" class="q-mt-sm">
                                                            <m-text-area :id="'boss-mr-reply-' + thread.communicationEventId" name="replyBody" v-model="replyBody" editor-type="md" rows="3" :label="t('Reply (markdown)')"></m-text-area>
                                                            <div class="row justify-end q-gutter-sm q-mt-xs">
                                                                <q-btn flat dense no-caps :label="t('Cancel')" @click="replyTo = null"></q-btn>
                                                                <q-btn unelevated dense no-caps color="primary" :label="t('Reply')" :loading="busy" :disable="!String(replyBody || '').trim()" @click="sendReply(thread)"></q-btn>
                                                            </div>
                                                        </div>
                                                    </template>
                                                </div>
                                                <div v-if="composerOn(file, row)" style="max-width: 820px">
                                                    <div class="text-caption m-muted q-mb-xs">{{t('Comment on line')}} {{composer.newLine != null ? composer.newLine : composer.oldLine}}</div>
                                                    <m-text-area id="boss-mr-comment" name="commentBody" v-model="composer.body" editor-type="md" rows="3" :label="t('Comment (markdown)')"></m-text-area>
                                                    <div class="row justify-end q-gutter-sm q-mt-xs">
                                                        <q-btn flat dense no-caps :label="t('Cancel')" @click="composer.key = null"></q-btn>
                                                        <q-btn unelevated dense no-caps color="primary" :label="t('Comment')" :loading="busy" :disable="!String(composer.body || '').trim()" @click="sendComment"></q-btn>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </template>
                                </tbody>
                            </table>
                        </div>
                    </template>
                </q-card>
            </div>
        </div>
    </template>

    <!-- ===== the review dialog ===== -->
    <m-dialog v-model="review.open" :title="t('Submit review')" width="560">
        <div class="q-gutter-y-sm">
            <q-option-group v-model="review.decision" type="radio" :options="decisionOptions"></q-option-group>
            <m-text-area id="boss-mr-review-note" name="note" v-model="review.note" editor-type="md" rows="5" :label="t('Summary (markdown)')"></m-text-area>
            <div v-if="openThreadCount" class="text-caption m-muted">{{openThreadCount}} {{openThreadCount === 1 ? t('thread is still open') : t('threads are still open')}}</div>
            <div class="row justify-end q-gutter-sm">
                <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
                <q-btn unelevated no-caps color="primary" :label="t('Submit review')" :loading="review.busy" @click="submitReview"></q-btn>
            </div>
        </div>
    </m-dialog>
</div></template>
<script>
module.exports = {
    name: 'BossMergeRequestChanges',
    data() {
        return {
            loading: false, notFound: false, changes: null, seq: 0, contextSeq: 0, disposed: false, purifyReady: false,
            layout: 'unified', viewed: {}, collapsed: {}, expanded: {}, hoverKey: null, focusKey: null,
            composer: { key: null, path: null, oldLine: null, newLine: null, lineText: '', body: '' }, replyTo: null, replyBody: '', busy: false,
            review: { open: false, decision: 'comment', note: '', busy: false }, selectedPath: null, reviewAsked: false
        };
    },
    computed: {
        wide() { return this.$q.screen.gt.sm; },
        dark() { return this.$q.dark.isActive; },
        touch() { return !!(this.$q.platform && this.$q.platform.has && this.$q.platform.has.touch); },
        pathList() { return this.$root.currentPathList || []; },
        cIndex() { return this.pathList.indexOf('Changes'); },
        screenPath() { return this.$root.basePath + '/' + (this.cIndex >= 0 ? this.pathList.slice(0, this.cIndex + 1) : ['Projects', 'Code', 'MergeRequestDetail', 'Changes']).join('/'); },
        params() { return this.$root.currentParameters || {}; },
        mergeRequestId() { return this.params.mergeRequestId || null; },
        contextKey() { return this.screenPath + '\n' + (this.mergeRequestId || ''); },
        storeKey() { return this.changes ? 'boss.mr.viewed.' + this.changes.mergeRequestId + '.' + (this.changes.headCommitId || '') : null; },
        decisionOptions() {
            const options = [{ label: this.t('Comment: feedback without a decision'), value: 'comment' }];
            if (this.changes && this.changes.canApprove) options.push({ label: this.t('Approve: ready to merge'), value: 'approve' });
            options.push({ label: this.t('Request changes: to be fixed before it merges'), value: 'request_changes' });
            return options;
        },
        // a thread reads in the page's font, not the diff's
        threadCellStyle() { return { fontFamily: 'Roboto, -apple-system, "Helvetica Neue", Helvetica, Arial, sans-serif', fontSize: '14px', whiteSpace: 'normal' }; },
        openThreadCount() { return this.changes ? this.changes.threadList.filter((thread) => !thread.resolved).length : 0; },
        viewedCount() { return this.changes ? this.changes.fileList.filter((file) => this.viewed[file.path]).length : 0; },
        // each file with its rows (hunk headers, lines or pairs of lines, each with the threads on it) and the threads not on any line
        files() {
            if (!this.changes) return [];
            const split = this.layout === 'split';
            return this.changes.fileList.map((file) => {
                const threads = this.changes.threadList.filter((thread) => thread.path === file.path);
                const placed = new Set();
                const keyOf = (line) => line ? (line.tag === 'delete' ? 'o' + line.oldNo : 'n' + line.newNo) : null;
                const lineKeys = new Set();
                file.hunkList.forEach((hunk) => hunk.lineList.forEach((line) => lineKeys.add(keyOf(line))));
                const threadKey = (thread) => {
                    if (thread.outdated) return null;
                    if (thread.newLine != null && lineKeys.has('n' + thread.newLine)) return 'n' + thread.newLine;
                    if (thread.oldLine != null && lineKeys.has('o' + thread.oldLine)) return 'o' + thread.oldLine;
                    return null;
                };
                const byKey = {};
                threads.forEach((thread) => { const key = threadKey(thread); if (key) { (byKey[key] = byKey[key] || []).push(thread); placed.add(thread); } });
                const rows = [];
                file.hunkList.forEach((hunk, h) => {
                    rows.push({ kind: 'hunk', key: 'h' + h, text: '@@ −' + hunk.oldStart + ',' + hunk.oldLines + ' +' + hunk.newStart + ',' + hunk.newLines + ' @@' });
                    if (!split) {
                        hunk.lineList.forEach((line) => { const key = keyOf(line); rows.push({ kind: 'line', key: 'l' + h + key, lineKey: key, line, threads: byKey[key] || [], keys: [key] }); });
                        return;
                    }
                    // side by side: equal lines on both sides; a run of deletions beside the insertions after it
                    const lines = hunk.lineList;
                    let i = 0;
                    while (i < lines.length) {
                        if (lines[i].tag === 'equal') { const key = keyOf(lines[i]); rows.push({ kind: 'line', key: 'p' + h + key, left: lines[i], right: lines[i], threads: byKey[key] || [], keys: [key] }); i++; continue; }
                        const dels = []; const ins = [];
                        while (i < lines.length && lines[i].tag === 'delete') dels.push(lines[i++]);
                        while (i < lines.length && lines[i].tag === 'insert') ins.push(lines[i++]);
                        for (let j = 0; j < Math.max(dels.length, ins.length); j++) {
                            const left = dels[j] || null; const right = ins[j] || null;
                            const keys = [keyOf(left), keyOf(right)].filter((key) => key);
                            rows.push({ kind: 'line', key: 'p' + h + keys.join('-'), left, right, keys, threads: keys.flatMap((key) => byKey[key] || []) });
                        }
                    }
                });
                return Object.assign({}, file, { rows, orphanThreads: threads.filter((thread) => !placed.has(thread)) });
            });
        },
        // the file tree: directories (folded to one node while they hold one directory) and files
        treeNodes() {
            if (!this.changes) return [];
            const root = { children: [], dirs: {} };
            this.changes.fileList.forEach((file) => {
                const parts = file.path.split('/');
                let node = root;
                parts.slice(0, -1).forEach((part, index) => {
                    const key = parts.slice(0, index + 1).join('/') + '/';
                    if (!node.dirs[part]) { const dir = { key, label: part, icon: 'sym_o_folder', iconClass: 'm-muted', children: [], dirs: {} }; node.dirs[part] = dir; node.children.push(dir); }
                    node = node.dirs[part];
                });
                const icons = { added: ['sym_o_add_box', 'text-positive'], deleted: ['sym_o_disabled_by_default', 'text-negative'], renamed: ['sym_o_drive_file_rename_outline', 'text-info'] };
                const icon = icons[file.changeType] || ['sym_o_draft', 'text-warning'];
                node.children.push({ key: file.path, label: parts[parts.length - 1], icon: icon[0], iconClass: icon[1], file });
            });
            const fold = (node) => {
                (node.children || []).forEach(fold);
                while (node.children && node.children.length === 1 && node.children[0].children && node.key) {
                    const only = node.children[0];
                    node.label = node.label + '/' + only.label; node.key = only.key; node.children = only.children;
                }
                return node;
            };
            return root.children.map(fold);
        }
    },
    watch: {
        layout(value) { try { localStorage.setItem('boss.mr.layout', value); } catch (err) { /* private mode */ } },
        contextKey() {
            this.contextSeq++;
            this.changes = null; this.notFound = false; this.loading = false;
            this.viewed = {}; this.collapsed = {}; this.expanded = {}; this.hoverKey = null; this.focusKey = null;
            this.composer = { key: null, path: null, oldLine: null, newLine: null, lineText: '', body: '' };
            this.replyTo = null; this.replyBody = ''; this.busy = false;
            this.review = { open: false, decision: 'comment', note: '', busy: false };
            this.selectedPath = null; this.reviewAsked = false;
            this.load();
        }
    },
    methods: {
        t(text) { return moqui.l10n && moqui.l10n.localize ? moqui.l10n.localize(text) : text; },
        context() { return { key: this.contextKey, seq: this.contextSeq, path: this.screenPath, mergeRequestId: this.mergeRequestId }; },
        isCurrent(context) { return !this.disposed && context.key === this.contextKey && context.seq === this.contextSeq; },
        request(name, params, method, context) {
            return moqui.request(context.path + '/' + name, { method: method || 'GET', params: Object.assign({}, params || {}, { mergeRequestId: context.mergeRequestId }) }).then((result) => {
                if (!this.isCurrent(context)) return null;
                const json = result.json || {};
                if (json.messageInfos && json.messageInfos.length) moqui.notifyMessages(json.messageInfos);
                return json;
            // A comment or review that fails after switching requests still says so; a read's error belongs to its request.
            }, (err) => { if (this.isCurrent(context) || (method || 'GET') !== 'GET') moqui.handleAjaxError(err); throw err; });
        },
        post(name, params, context) { return this.request(name, params, 'POST', context); },
        load() {
            const seq = ++this.seq;
            const context = this.context();
            if (!context.mergeRequestId) { this.loading = false; this.changes = null; this.notFound = true; return; }
            this.loading = true;
            return moqui.request(context.path + '/changes', { params: { mergeRequestId: context.mergeRequestId } }).then((result) => {
                if (seq !== this.seq || !this.isCurrent(context)) return;
                const changes = (result.json || {}).changes;
                this.loading = false;
                if (!changes) { this.notFound = true; this.changes = null; return; }
                this.notFound = false;
                this.changes = changes;
                this.readViewed();
                if (!this.reviewAsked && String(this.params.review) === 'true' && changes.canReview) { this.reviewAsked = true; this.openReview(); }
            }, () => { if (seq !== this.seq || !this.isCurrent(context)) return; this.loading = false; this.changes = null; this.notFound = true; });
        },
        readViewed() {
            let map = {};
            try { map = JSON.parse(localStorage.getItem(this.storeKey) || '{}') || {}; } catch (err) { map = {}; }
            this.viewed = map;
        },
        setViewed(path, on) {
            const map = Object.assign({}, this.viewed);
            if (on) map[path] = true; else delete map[path];
            this.viewed = map;
            if (on) this.collapsed = Object.assign({}, this.collapsed, { [path]: true });
            try { localStorage.setItem(this.storeKey, JSON.stringify(map)); } catch (err) { /* private mode */ }
        },
        toggleCollapsed(path) { this.collapsed = Object.assign({}, this.collapsed, { [path]: !this.collapsed[path] }); },
        fileDomId(path) { return 'boss-mr-file-' + String(path).replace(/[^A-Za-z0-9_-]/g, '_'); },
        goToFile(key) {
            if (!key) return;
            const file = this.changes.fileList.find((one) => one.path === key);
            if (!file) return;
            this.selectedPath = key;
            if (this.collapsed[key]) this.toggleCollapsed(key);
            this.$nextTick(() => { const el = document.getElementById(this.fileDomId(key)); if (el && el.scrollIntoView) el.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
        },
        stepFile(step) {
            const paths = this.changes ? this.changes.fileList.map((file) => file.path) : [];
            if (!paths.length) return;
            const at = paths.indexOf(this.selectedPath);
            this.goToFile(paths[Math.min(paths.length - 1, Math.max(0, at + step))]);
        },
        openThreadsOf(path) { return this.changes.threadList.filter((thread) => thread.path === path && !thread.resolved).length; },
        lineClass(line) { return line.tag === 'insert' ? 'diff-ins' : line.tag === 'delete' ? 'diff-del' : ''; },
        // the moqui-diff colors, per side (translucent, so the same in light and dark)
        sideStyle(line) { return !line ? { background: 'rgba(127, 127, 127, .08)' } : line.tag === 'insert' ? { background: 'rgba(40, 167, 69, .12)' }
            : line.tag === 'delete' ? { background: 'rgba(220, 53, 69, .12)' } : {}; },
        threadClass(thread) { return (this.dark ? 'bg-grey-9' : 'bg-blue-grey-1') + (thread.resolved ? ' m-muted' : ''); },
        commentStyle(key) { return { position: 'absolute', left: '-10px', top: 0, opacity: this.touch || this.hoverKey === key || this.focusKey === key ? 1 : 0 }; },
        composerOn(file, row) { return this.composer.key && this.composer.path === file.path && row.keys.includes(this.composer.key); },
        // a post's body: html the server cleaned (Mantle, then CodeServices, which also takes its images out); cleaned here
        // once more, and shown only once the cleaner is loaded (purifyReady)
        cleanBody(html) { return window.DOMPurify.sanitize(String(html || ''), { FORBID_TAGS: ['img', 'picture', 'source', 'video', 'audio', 'style', 'form', 'input', 'button', 'textarea', 'select'], FORBID_ATTR: ['style'] }); },
        startComment(file, line) {
            this.replyTo = null;
            this.composer = { key: line.tag === 'delete' ? 'o' + line.oldNo : 'n' + line.newNo, path: file.path, oldLine: line.tag === 'delete' ? line.oldNo : null,
                newLine: line.tag === 'delete' ? null : line.newNo, lineText: String(line.text || '').substring(0, 255), body: '' };
            this.$nextTick(() => { const el = document.getElementById('boss-mr-comment'); if (el && el.focus) el.focus(); });
        },
        sendComment() {
            const body = String(this.composer.body || '').trim();
            if (!body || this.busy) return;
            const context = this.context();
            const draft = this.composer;
            const snapshot = Object.assign({}, draft);
            this.busy = true;
            this.post('comment', { body, path: snapshot.path, oldLine: snapshot.oldLine == null ? '' : snapshot.oldLine,
                newLine: snapshot.newLine == null ? '' : snapshot.newLine, lineText: snapshot.lineText }, context).then((json) => {
                if (!this.isCurrent(context)) return;
                this.busy = false;
                if (!json.communicationEventId) return;
                if (this.composer === draft && Object.keys(snapshot).every((key) => this.composer[key] === snapshot[key]))
                    this.composer = { key: null, path: null, oldLine: null, newLine: null, lineText: '', body: '' };
                this.load();
            }, () => { if (this.isCurrent(context)) this.busy = false; });
        },
        startReply(thread) {
            this.composer.key = null;
            this.replyTo = thread.communicationEventId;
            this.replyBody = '';
            this.$nextTick(() => { const el = document.getElementById('boss-mr-reply-' + thread.communicationEventId); if (el && el.focus) el.focus(); });
        },
        sendReply(thread) {
            const body = String(this.replyBody || '').trim();
            if (!body || this.busy) return;
            const context = this.context();
            const replyTo = this.replyTo;
            const snapshot = this.replyBody;
            this.busy = true;
            this.post('comment', { body, parentCommEventId: thread.communicationEventId }, context).then((json) => {
                if (!this.isCurrent(context)) return;
                this.busy = false;
                if (!json.communicationEventId) return;
                if (this.replyTo === replyTo && this.replyBody === snapshot) { this.replyTo = null; this.replyBody = ''; }
                this.load();
            }, () => { if (this.isCurrent(context)) this.busy = false; });
        },
        resolve(thread, resolved) {
            const context = this.context();
            this.post('resolveThread', { communicationEventId: thread.communicationEventId, resolved: resolved ? 'true' : 'false' }, context).then((json) => {
                if (!this.isCurrent(context) || json.resolved == null) return;
                thread.resolved = resolved;
                if (resolved) this.expanded = Object.assign({}, this.expanded, { [thread.communicationEventId]: false });
            }, () => {});
        },
        openReview() {
            if (!this.changes || !this.changes.canReview) return;
            this.review = { open: true, decision: 'comment', note: '', busy: false };
        },
        submitReview() {
            if (this.review.busy) return;
            const context = this.context();
            const draft = this.review;
            const decision = draft.decision;
            const note = draft.note;
            draft.busy = true;
            this.post('submitReview', { decision, note: note || '' }, context).then((json) => {
                if (!this.isCurrent(context) || this.review !== draft) return;
                draft.busy = false;
                if (!json.statusId || !draft.open) return;
                if (draft.decision !== decision || draft.note !== note) return;
                draft.open = false;
                // the header's status and the reviewers change: show the merge request again
                if (this.$root.setUrl) this.$root.setUrl(this.$root.linkBasePath + '/Projects/Code/MergeRequestDetail?' + moqui.objToSearch({ mergeRequestId: context.mergeRequestId }));
            }, () => { if (this.isCurrent(context) && this.review === draft) draft.busy = false; });
        },
        keyBindings() {
            const quiet = () => !this.review.open && !this.composer.key && !this.replyTo;
            return [
                { keys: 'j', label: this.t('Changes: next file'), action: 'mrNextFile', when: quiet, run: () => { this.stepFile(1); return true; } },
                { keys: 'k', label: this.t('Changes: previous file'), action: 'mrPreviousFile', when: quiet, run: () => { this.stepFile(-1); return true; } },
                { keys: 'v', label: this.t('Changes: mark the file viewed'), action: 'mrViewed', when: () => quiet() && !!this.selectedPath,
                    run: () => { this.setViewed(this.selectedPath, !this.viewed[this.selectedPath]); return true; } }
            ];
        }
    },
    mounted() {
        // the cleaner of a post's html body, as WebrootChat loads it; such a body is not shown before it is there
        moqui.loadScript('/libs/dompurify/purify.min.js', null, () => !!window.DOMPurify).then(() => { if (!this.disposed) this.purifyReady = true; }, () => { /* the bodies stay hidden */ });
        try { const saved = localStorage.getItem('boss.mr.layout'); if (saved === 'split' || saved === 'unified') this.layout = saved; } catch (err) { /* private mode */ }
        if (moqui.keymap && moqui.keymap.registerScope) this.keysOff = moqui.keymap.registerScope('mrChanges', this.keyBindings());
        this.load();
    },
    beforeUnmount() { this.disposed = true; this.contextSeq++; this.seq++; if (this.keysOff) this.keysOff(); }
};
</script>
