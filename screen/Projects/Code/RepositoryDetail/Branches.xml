<!-- RepositoryBranches (design-projects.md §7 RepositoryBranches): the branches, the default first; each with its last commit,
    ahead and behind the default (the 20 most recently changed), its work item, its open merge request and its CI state;
    Compare and New merge request (Compare with the branch as the source), Delete for those with the delete right (not the
    default branch; its branch rules still apply), and New branch for those who may push. A client contact (impl-projects.md P10b)
    reads the list only: no Compare or New merge request (Compare is refused it). Services: ironstone.projects.CodeServices
    get#RepositoryBranches; org.moqui.git.GitServices create#GitRef, delete#GitRef. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Branches" default-menu-index="3" menu-image="sym_o_call_split" menu-image-type="icon">

    <transition name="compare"><default-response url="../../Compare"/></transition>
    <transition name="commitDetail"><default-response url="../../CommitDetail"/></transition>
    <transition name="createBranch">
        <actions>
            <service-call name="org.moqui.git.GitServices.create#GitRef" out-map="refOut" in-map="{repositoryId:repositoryId, refName:refName, refType:'branch',
                    revision:(revision || null)}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(ec.resource.expand('Branch ${name} made', '', {name: refName}), 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="repositoryId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="deleteBranch">
        <actions>
            <service-call name="org.moqui.git.GitServices.delete#GitRef" in-map="{repositoryId:repositoryId, refName:refName, refType:'branch'}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(ec.resource.expand('Branch ${name} deleted', '', {name: refName}), 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="repositoryId"/></default-response>
        <error-response url="."/>
    </transition>

    <actions>
        <script><![CDATA[
            if (!recordFound) return
            const out = ec.service.sync().name('ironstone.projects.CodeServices.get#RepositoryBranches').parameters({repositoryId: repositoryId}).call() || {}
            const L = (text) => ec.l10n.localize(text)
            const checkColors = {success: 'positive', failure: 'negative', error: 'negative', pending: 'warning'}
            const checkLabels = {success: 'Passed', failure: 'Failed', error: 'Error', pending: 'Pending'}
            branchList = Array.from(out.branchList || []).map((row) => Object.assign(row, {checkColor: checkColors[row.checkState] || '',
                checkLabel: row.checkState ? L(checkLabels[row.checkState] || row.checkState) : '', mayDelete: canDelete && !row.isDefault && !isArchived,
                mrText: row.mergeRequest ? '!' + row.mergeRequest.mergeRequestNum + ' ' + row.mergeRequest.title : ''}))
            refOptions = ec.service.sync().name('ironstone.projects.CodeServices.get#RefOptions').parameters({repositoryId: repositoryId}).call()?.optionList || []
        ]]></script>
    </actions>

    <widgets>
        <section name="BranchesFound" condition="recordFound"><widgets>
            <container style="row items-center q-mb-sm">
                <label text="Branches · ${branchList.length}" type="div" style="text-subtitle1"/>
                <container style="col"/>
                <container-dialog id="NewBranchDialog" button-text="New branch" icon="sym_o_add" width="480" title="A new branch of ${repositoryId}"
                        condition="canCreate &amp;&amp; !isArchived">
                    <form-single name="NewBranch" transition="createBranch" focus-field="refName">
                        <field name="repositoryId"><default-field><hidden/></default-field></field>
                        <field name="refName"><default-field title="Name"><text-line size="40"/></default-field></field>
                        <field name="revision" from="repo.branch"><default-field title="From"><drop-down><list-options list="refOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Make branch"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </container>
            <container-box><box-body-nopad>
                <form-list name="BranchList" list="branchList" skip-form="true" paginate="false">
                    <field name="name"><default-field title="Branch">
                        <link url="../Files" text="${name}" link-type="anchor" parameter-map="{repositoryId:repositoryId, ref:name}" style="text-mono text-weight-medium"/>
                        <label text="default" type="span" style="text-caption m-muted q-ml-xs" condition="isDefault"/>
                    </default-field></field>
                    <field name="summary"><default-field title="Last commit">
                        <link url="commitDetail" text="${summary}" link-type="anchor" parameter-map="{repositoryId:repositoryId, commitId:commitId}" condition="commitId"/>
                        <label text="${authorName} · ${dateText}" type="div" style="text-caption m-muted"/>
                    </default-field></field>
                    <field name="aheadText"><default-field title="Ahead · behind">
                        <label text="${aheadText}" type="span" style="text-no-wrap text-caption"/></default-field></field>
                    <field name="item"><default-field title="Work item">
                        <link url="/qapps/Projects/WorkItems/WorkItemDetail" url-type="plain" text="${item.workEffortId}" link-type="anchor" condition="item"
                                parameter-map="{workEffortId:item.workEffortId}" tooltip="${item.workEffortName}" style="text-mono"/></default-field></field>
                    <field name="mrText"><default-field title="Merge request">
                        <link url="/qapps/Projects/Code/MergeRequestDetail" url-type="plain" text="${mrText}" link-type="anchor" condition="mergeRequest"
                                parameter-map="{mergeRequestId:mergeRequest.mergeRequestId}"/></default-field></field>
                    <field name="checkState"><default-field title="CI">
                        <render-mode><text type="qvt"><![CDATA[${checkState ? '<q-chip dense square class="q-ma-none m-tonal text-' + checkColor + '" data-check="' + WebUtilities.encodeHtml(checkState) + '">' + WebUtilities.encodeHtml(checkLabel) + '</q-chip>' : ''}]]></text>
                            <text type="tui"><![CDATA[{"t": "text", "text": ${JSON.stringify(checkLabel ?? "")}}]]></text></render-mode>
                    </default-field></field>
                    <field name="actions"><default-field title="">
                        <link url="compare" text="${mergeRequest ? 'Compare' : 'New merge request'}" icon="${mergeRequest ? 'sym_o_compare_arrows' : 'sym_o_merge'}" condition="!isDefault &amp;&amp; !clientUser"
                                parameter-map="{repositoryId:repositoryId, head:name}"/>
                        <link url="deleteBranch" link-type="hidden-form-link" text="Delete" icon="sym_o_delete" btn-type="danger" condition="mayDelete"
                                confirmation="Delete the branch ${name}?" parameter-map="{repositoryId:repositoryId, refName:name}"/>
                    </default-field></field>
                </form-list>
            </box-body-nopad></container-box>
        </widgets></section>
    </widgets>
</screen>
