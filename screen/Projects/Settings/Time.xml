<!-- TimeSettings (design-projects.md §12 TimeSettings; style-guide §3.9 Settings; impl-projects.md P6b), for the Projects managers: the
    organization's timesheet policy (PartySetting ProjTimesheetPolicy through mantle.work.TimesheetServices store#TimesheetPolicy,
    its short keys under 255 characters, impl-projects.md F9): the week's first day, who approves (the projects' managers, the
    person's line manager, or any holder of TIMESHEET_APPROVE), the lock on submit, a work item required, a comment required (an
    approver's flag), the smallest entry (the rounding of the grid, quick time and the import), future days, the hours of a working
    day and the working days (the working hours until Capacity), the missing-time reminder's day and hour, and whether every employee
    keeps a weekly timesheet (People P10: a line manager's missing lists and My team count each report); and the work types
    offered (PartySetting ProjWorkTypes through get# and store#WorkTypes: offered in order, Offer or Stop offering, Up and Down,
    Rename of the organization's own) with NewWorkType (an Enumeration of WorkType, WktpOrg and a number). MyTime, QuickTime,
    TimeEntries and the import offer these. Service: ironstone.projects.TimeServices get# and store#TimeSettings, change#WorkTypes,
    create#WorkType. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Time" default-menu-index="5" server-static="qvt" menu-image="sym_o_work_history" menu-image-type="icon">

    <transition name="savePolicy">
        <service-call name="ironstone.projects.TimeServices.store#TimeSettings" out-map="saveOut" in-map="{weekStart:weekStart, approvers:approvers, lock:(lock || 'N'),
                needItem:(needItem || 'N'), needComment:(needComment || 'N'), minHours:minHours, future:(future || 'N'), dayHours:dayHours, workDays:workDays,
                remindDay:remindDay, remindHour:remindHour, required:(required || 'N')}"/>
        <actions><if condition="!ec.message.hasError()"><script>ec.message.addMessage(saveOut.message, 'success')</script></if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="changeType">
        <service-call name="ironstone.projects.TimeServices.change#WorkTypes" out-map="typeOut" in-map="{enumId:enumId, change:change, label:label}"/>
        <actions><if condition="!ec.message.hasError()"><script>ec.message.addMessage(typeOut.message, 'success')</script></if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="createType">
        <service-call name="ironstone.projects.TimeServices.create#WorkType" out-map="typeOut" in-map="{label:label}"/>
        <actions><if condition="!ec.message.hasError()"><script>ec.message.addMessage(typeOut.message, 'success')</script></if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <script><![CDATA[
            const info = ec.service.sync().name('ironstone.projects.TimeServices.get#TimeSettings').call() || {}
            hasOrganization = !!info.organizationPartyId
            organizationName = info.organizationName || ''
            policyValue = Object.assign({}, info.policy || {})
            typeList = Array.from(info.typeList || [])
            offeredCount = typeList.filter((row) => row.offered).length
        ]]></script>
    </actions>

    <widgets>
        <container style="row items-center q-mb-sm">
            <label type="h5" text="Time" style="q-my-none"/>
            <container style="col"/>
            <container-dialog id="NewWorkTypeDialog" button-text="New work type" icon="sym_o_add" width="420" title="A work type of your own" condition="hasOrganization">
                <form-single name="NewWorkType" transition="createType" focus-field="label">
                    <field name="label"><default-field title="Label"><text-line size="30"/></default-field></field>
                    <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>
        <label type="p" text="How time is kept and approved${organizationName ? ' at ' + organizationName : ''}, and the work types people log." style="m-muted"/>
        <section name="NoOrganization" condition="!hasOrganization"><widgets>
            <label type="p" text="You belong to no organization, so there is nowhere to keep these settings." style="text-warning"/>
        </widgets></section>
        <container-row>
            <row-col md="7">
                <container-box><box-header title="Timesheet policy"/><box-body>
                    <form-single name="TimesheetPolicy" transition="savePolicy" map="policyValue">
                        <field name="weekStart"><default-field title="The week starts on"><drop-down>
                            <option key="1" text="Monday"/><option key="2" text="Tuesday"/><option key="3" text="Wednesday"/><option key="4" text="Thursday"/>
                            <option key="5" text="Friday"/><option key="6" text="Saturday"/><option key="7" text="Sunday"/></drop-down></default-field></field>
                        <field name="approvers"><default-field title="Who approves a week"><radio>
                            <option key="project" text="The managers of the projects the week's time is on"/>
                            <option key="line" text="The person's line manager (else the projects' managers)"/>
                            <option key="any" text="Any project manager (the Time approve permission)"/></radio></default-field></field>
                        <field name="lock"><default-field title=" "><check><option key="Y" text="Lock a week's time when it is submitted (rates may still change)"/></check></default-field></field>
                        <field name="needItem"><default-field title=" "><check><option key="Y" text="Every entry is on a work item"/></check></default-field></field>
                        <field name="needComment"><default-field title=" "><check><option key="Y" text="Flag entries without a comment to the approver"/></check></default-field></field>
                        <field name="future"><default-field title=" "><check><option key="Y" text="Time may be logged on future days"/></check></default-field></field>
                        <!-- People P10 (the user's call of Nov 11, 2026): a line manager's missing lists count every report -->
                        <field name="required"><default-field title=" "><check><option key="Y" text="Every employee keeps a weekly timesheet (managers see each report's week)"/></check></default-field></field>
                        <field name="minHours"><default-field title="Smallest entry, hours are rounded to it"><drop-down>
                            <option key="0.1" text="6 minutes (0.1 h)"/><option key="0.25" text="15 minutes (0.25 h)"/><option key="0.5" text="30 minutes (0.5 h)"/>
                            <option key="1" text="An hour"/></drop-down></default-field></field>
                        <field name="dayHours"><default-field title="Hours of a working day"><text-line size="5" input-type="number"/></default-field></field>
                        <field name="workDays"><default-field title="Working days"><check>
                            <option key="1" text="Mon"/><option key="2" text="Tue"/><option key="3" text="Wed"/><option key="4" text="Thu"/>
                            <option key="5" text="Fri"/><option key="6" text="Sat"/><option key="7" text="Sun"/></check></default-field></field>
                        <field name="remindDay"><default-field title="Remind of a missing week on"><drop-down>
                            <option key="1" text="Monday"/><option key="2" text="Tuesday"/><option key="3" text="Wednesday"/><option key="4" text="Thursday"/>
                            <option key="5" text="Friday"/><option key="6" text="Saturday"/><option key="7" text="Sunday"/></drop-down></default-field></field>
                        <field name="remindHour"><default-field title="At (hour, 0 to 23)"><text-line size="4" input-type="number"/></default-field></field>
                        <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                        <field-layout>
                            <field-ref name="weekStart"/>
                            <field-ref name="approvers"/>
                            <field-ref name="lock"/><field-ref name="needItem"/><field-ref name="needComment"/><field-ref name="future"/><field-ref name="required"/>
                            <field-row><field-ref name="minHours"/><field-ref name="dayHours"/></field-row>
                            <field-ref name="workDays"/>
                            <field-row><field-ref name="remindDay"/><field-ref name="remindHour"/></field-row>
                            <field-ref name="submitButton"/>
                        </field-layout>
                    </form-single>
                    <label type="p" text="The working days and hours set the expected hours of a week until people's own schedules are kept; holidays come off them." style="text-caption m-muted q-mb-none"/>
                </box-body></container-box>
            </row-col>
            <row-col md="5">
                <container-box><box-header title="Work types"/><box-body-nopad>
                    <label type="p" text="The work types offered when time is logged, in this order. ${offeredCount} offered." style="text-caption m-muted q-pa-sm q-mb-none"/>
                    <form-list name="WorkTypeList" list="typeList" skip-form="true" paginate="false">
                        <field name="label"><default-field title="Work type">
                            <label text="${label}" type="span" style="${offered ? 'text-weight-medium' : 'm-muted'}"/></default-field></field>
                        <field name="sequence" align="right"><default-field title="Order"><display text="${sequence ?? ''}"/></default-field></field>
                        <field name="offered"><default-field title="Offered">
                            <section name="WorkTypeOffered" condition="offered"><widgets>
                                <link url="changeType" link-type="hidden-form-link" text="Stop offering" parameter-map="{enumId:enumId, change:'stop'}"/>
                            </widgets><fail-widgets>
                                <link url="changeType" link-type="hidden-form-link" text="Offer" parameter-map="{enumId:enumId, change:'offer'}"/>
                            </fail-widgets></section></default-field></field>
                        <field name="move"><default-field title="">
                            <link url="changeType" link-type="hidden-form-link" text="Up" condition="offered &amp;&amp; !isFirst" parameter-map="{enumId:enumId, change:'up'}"/>
                            <link url="changeType" link-type="hidden-form-link" text="Down" condition="offered &amp;&amp; !isLast" parameter-map="{enumId:enumId, change:'down'}"/></default-field></field>
                        <field name="rename"><default-field title="">
                            <section name="WorkTypeOwn" condition="isOwn"><widgets>
                                <container-dialog id="RenameWorkTypeDialog" button-text="Rename" icon="sym_o_edit" width="420" title="Rename ${label}">
                                    <form-single name="RenameWorkType" transition="changeType">
                                        <field name="enumId"><default-field><hidden/></default-field></field>
                                        <field name="change" from="'rename'"><default-field><hidden/></default-field></field>
                                        <field name="label"><default-field title="Label"><text-line size="30"/></default-field></field>
                                        <field name="submitButton"><default-field title="Rename"><submit/></default-field></field>
                                    </form-single>
                                </container-dialog>
                            </widgets></section></default-field></field>
                    </form-list>
                </box-body-nopad></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
