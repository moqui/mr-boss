<!-- NewProject step 4, ProjectMoneyStep (design-projects.md §4 NewProject): how it is paid for: the billing basis, the hours budget
    and the client budget (ironstone.projects.ProjectServices.save#ProjectMoney), and the project's rates (Add rate: client billing or
    worker pay for a person, a work type or everyone, mantle.humanres.RateServices.create#RateAmount scoped to the project; End), and
    for those who manage money the order line it fulfils (impl-projects.md P8b: a line of a sales order to the project's client,
    ironstone.projects.BillingServices.search#OrderLines and link#OrderLine; milestones take their shares of it later, on MilestoneDetail). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Money" default-menu-index="4" menu-image="sym_o_account_balance_wallet" menu-image-type="icon">

    <parameter name="workEffortId"/>

    <transition name="saveMoney">
        <actions>
            <!-- a project past planning (a bookmarked step) is changed on its page, not by the wizard (PR-UI-038) -->
            <if condition="startedProject"><return error="true" message="PROJECT_NOT_PLANNING: ${startedProject.workEffortName || workEffortId} is ${startedProject.statusText}; the new-project steps are for a project in planning, change it from its page"/></if>
            <service-call name="ironstone.projects.ProjectServices.save#ProjectMoney" out-map="saveOut" in-map="{workEffortId:workEffortId, billingBasis:billingBasis,
                    totalTimeAllowed:totalTimeAllowed, totalClientCostAllowed:totalClientCostAllowed}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(saveOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="addRate">
        <actions>
            <!-- a project past planning (a bookmarked step) is changed on its page, not by the wizard (PR-UI-038) -->
            <if condition="startedProject"><return error="true" message="PROJECT_NOT_PLANNING: ${startedProject.workEffortName || workEffortId} is ${startedProject.statusText}; the new-project steps are for a project in planning, change it from its page"/></if>
            <service-call name="ironstone.projects.ProjectServices.add#ProjectRate" out-map="rateOut" in-map="{workEffortId:workEffortId, ratePurposeEnumId:ratePurposeEnumId,
                    partyId:partyId, workTypeEnumId:workTypeEnumId, rateAmount:rateAmount}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(rateOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="endRate">
        <actions>
            <!-- a project past planning (a bookmarked step) is changed on its page, not by the wizard (PR-UI-038) -->
            <if condition="startedProject"><return error="true" message="PROJECT_NOT_PLANNING: ${startedProject.workEffortName || workEffortId} is ${startedProject.statusText}; the new-project steps are for a project in planning, change it from its page"/></if>
            <service-call name="ironstone.projects.ProjectServices.end#ProjectRate" out-map="rateOut" in-map="{workEffortId:workEffortId, rateAmountId:rateAmountId}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(rateOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="linkOrderLine">
        <actions>
            <!-- a project past planning (a bookmarked step) is changed on its page, not by the wizard (PR-UI-038) -->
            <if condition="startedProject"><return error="true" message="PROJECT_NOT_PLANNING: ${startedProject.workEffortName || workEffortId} is ${startedProject.statusText}; the new-project steps are for a project in planning, change it from its page"/></if>
            <service-call name="ironstone.projects.BillingServices.link#OrderLine" out-map="linkOut" in-map="{workEffortId:workEffortId, orderLine:orderLine, orderId:orderId,
                    orderItemSeqId:orderItemSeqId, remove:(remove == 'Y')}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(linkOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="orderLineSearch" read-only="true">
        <actions><script><![CDATA[
            const out = ec.service.sync().name('ironstone.projects.BillingServices.search#OrderLines').parameters({workEffortId: workEffortId || '', term: term || ''}).call() || {}
            ec.message.clearErrors()
            ec.web.sendJsonResponse(out.optionList || [])
        ]]></script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="peopleSearch" read-only="true">
        <actions>
            <service-call name="ironstone.commons.TaskServices.search#Assignees" in-map="{term:term}" out-map="found"/>
            <script>ec.web.sendJsonResponse(found.optionList || [])</script>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <script><![CDATA[
            if (!draftProject) return
            const settings = ec.service.sync().name('mantle.work.ProjectServices.get#ProjectSettings').parameters({workEffortId: workEffortId}).call()?.settings || {}
            const num = (value) => value == null ? '' : String(Number(String(value)))
            moneyValue = {workEffortId: workEffortId, billingBasis: settings.WstBillingBasis || 'TimeAndMaterials', totalTimeAllowed: num(draftProject.totalTimeAllowed),
                totalClientCostAllowed: num(draftProject.totalClientCostAllowed)}
            rateList = Array.from(ec.service.sync().name('ironstone.projects.ProjectServices.get#ProjectRates').parameters({workEffortId: workEffortId}).call()?.rateList || [])
            // the order line it fulfils (impl-projects.md P8b), for those who manage money
            managesMoney = !!ec.service.sync().name('ironstone.projects.BillingServices.check#Money').parameters({need: 'none'}).call()?.managesMoney
            orderLineRows = []
            hasClient = false
            if (managesMoney) {
                const billing = ec.service.sync().name('mantle.work.ProjectServices.get#MilestoneBilling').parameters({rootWorkEffortId: workEffortId}).call() || {}
                ec.message.clearErrors()
                orderLineRows = Array.from(billing.lineList || []).map((line) => ({orderId: line.orderId, orderItemSeqId: line.orderItemSeqId,
                    text: line.orderId + ' ' + line.orderItemSeqId + ' · ' + (line.description || ''), totalText: ec.l10n.formatCurrency(line.total, line.currencyUomId)}))
                hasClient = ec.entity.find('mantle.work.effort.WorkEffortParty').condition('workEffortId', workEffortId).condition('roleTypeId', 'in', ['Customer', 'CustomerBillTo'])
                        .conditionDate('fromDate', 'thruDate', null).disableAuthz().count() > 0
            }
        ]]></script>
    </actions>

    <widgets>
        <section name="NotStarted" condition="!draftProject &amp;&amp; !startedProject"><widgets>
            <container-box type="warning"><box-body>
                <label type="p" text="Start the project first: this step works on the project the Start step makes." style="q-mb-xs"/>
                <link url="../Start" link-type="anchor" text="Back to Start"/>
            </box-body></container-box>
        </widgets></section>
        <section name="MoneyStep" condition="draftProject"><widgets>
            <container-row>
                <row-col md="6">
                    <container-box><box-header title="How it is paid for"/><box-body>
                        <form-single name="ProjectMoneyStep" transition="saveMoney" map="moneyValue">
                            <field name="workEffortId"><default-field><hidden/></default-field></field>
                            <field name="billingBasis"><default-field title="Billing basis">
                                <radio><option key="TimeAndMaterials" text="Time and materials"/><option key="FixedPrice" text="Fixed price"/>
                                    <option key="Milestones" text="By milestones"/><option key="NotBilled" text="Not billed"/></radio></default-field></field>
                            <field name="totalTimeAllowed"><default-field title="Hours budget"><text-line size="8" input-type="number"/></default-field></field>
                            <field name="totalClientCostAllowed"><default-field title="Client budget"><text-line size="10" input-type="number"/></default-field></field>
                        </form-single>
                    </box-body></container-box>
                    <section name="OrderLineBox" condition="managesMoney"><widgets>
                        <container-box><box-header title="The order line it fulfils"/>
                            <box-toolbar>
                                <container-dialog id="NewProjectOrderLine" button-text="Link an order line" icon="sym_o_add_link" width="560" title="An order line this project fulfils"
                                        condition="hasClient">
                                    <form-single name="NewProjectLinkOrderLine" transition="linkOrderLine">
                                        <field name="workEffortId"><default-field><hidden/></default-field></field>
                                        <field name="orderLine"><default-field title="Order line (the client's sales orders)">
                                            <drop-down><dynamic-options transition="orderLineSearch" server-search="true" min-length="0" parameter-map="{workEffortId:workEffortId}"/></drop-down></default-field></field>
                                        <field name="submitButton"><default-field title="Link"><submit/></default-field></field>
                                    </form-single>
                                </container-dialog>
                            </box-toolbar>
                            <box-body-nopad>
                                <form-list name="NewProjectOrderLines" list="orderLineRows" skip-form="true" skip-header="true" paginate="false">
                                    <field name="text"><default-field><display/></default-field></field>
                                    <field name="totalText" align="right"><default-field><display/></default-field></field>
                                    <field name="unlink" align="right"><default-field>
                                        <link url="linkOrderLine" link-type="hidden-form-link" text="Unlink" parameter-map="{workEffortId:workEffortId, orderId:orderId, orderItemSeqId:orderItemSeqId, remove:'Y'}"/></default-field></field>
                                </form-list>
                                <label type="p" text="${hasClient ? 'No order line: a project billed by milestones takes its shares of the sales order line it fulfils.' : 'Choose the client (Start) to link its sales order line.'}"
                                        style="m-muted q-pa-sm q-mb-none" condition="!orderLineRows.length"/>
                            </box-body-nopad>
                        </container-box>
                    </widgets></section>
                </row-col>
                <row-col md="6">
                    <container-box><box-header title="Rates on this project"/>
                        <box-toolbar>
                            <container-dialog id="NewProjectAddRate" button-text="Add rate" icon="sym_o_payments" width="520" title="A rate on this project">
                                <form-single name="AddRate" transition="addRate">
                                    <field name="workEffortId"><default-field><hidden/></default-field></field>
                                    <field name="ratePurposeEnumId" from="'RaprClient'"><default-field title="For">
                                        <radio><option key="RaprClient" text="Client billing"/><option key="RaprVendor" text="Worker pay"/></radio></default-field></field>
                                    <field name="partyId"><default-field title="Person (empty: everyone)">
                                        <drop-down allow-empty="true"><dynamic-options transition="peopleSearch" server-search="true" min-length="0"/></drop-down></default-field></field>
                                    <field name="workTypeEnumId"><default-field title="Work type (empty: any)">
                                        <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                                            <entity-find entity-name="moqui.basic.Enumeration" cache="true"><econdition field-name="enumTypeId" value="WorkType"/>
                                                <order-by field-name="description"/></entity-find></entity-options></drop-down></default-field></field>
                                    <field name="rateAmount"><default-field title="Rate per hour"><text-line size="8" input-type="number"/></default-field></field>
                                    <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                                </form-single>
                            </container-dialog>
                        </box-toolbar>
                        <box-body-nopad>
                        <form-list name="ProjectRates" list="rateList" skip-form="true" paginate="false">
                            <field name="purposeText"><default-field title="For"><display/></default-field></field>
                            <field name="appliesText"><default-field title="Applies to"><display/></default-field></field>
                            <field name="amountText" align="right"><default-field title="Rate"><display/></default-field></field>
                            <field name="fromText"><default-field title="From"><display/></default-field></field>
                            <field name="endLink"><default-field title="">
                                <link url="endRate" link-type="hidden-form-link" text="End" parameter-map="{workEffortId:workEffortId, rateAmountId:rateAmountId}"/></default-field></field>
                        </form-list>
                        <section name="NoRates" condition="!rateList.length"><widgets>
                            <label type="p" text="No rates of its own: the organization's and the people's rates apply." style="m-muted q-pa-sm q-mb-none"/>
                        </widgets></section>
                    </box-body-nopad></container-box>
                </row-col>
            </container-row>
        </widgets></section>
    </widgets>
</screen>
