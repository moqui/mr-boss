<!-- ProjectDetail (design-projects.md §4 ProjectDetail; style-guide §3.3 Detail): the project hub, which the palette and
    notification links of a project open (ironstone.commons.PaletteServices.get#RecordLink). The title row: the key as a mono chip, the
    name, the stages of the Default flow (read only: the moves are the actions), the health chip with the date of the latest
    update, the client and the manager; the number cards (open items, overdue, the next milestone, the hours of the budget or
    the estimate, and for managers the client budget used); the primary action by status (Approve, Begin, Resume, Close,
    Re-open), Post update beside it (the primary in progress), and the More menu (the other moves of the flow, Follow, Clone,
    Save as template, Print status report). New work item is the Work items tab's and the shell's +, which takes the project
    from the screen context. A template shows its banner, a closed or cancelled project is read only but for
    Re-open (service/ironstone/projects/ProjectServices.xml get#ProjectHeader).

    The tabs are subscreens, each with the project as its context: Overview (1), Work items (2, WorkItems/List with the project
    fixed), Backlog (3, WorkItems/Backlog with the project fixed), Plan (4, ProjectDetail/Plan: WorkItems/Timeline with the project
    fixed and the project's Calendar, a toggle between them), Roadmap (5, Projects/Roadmap with the project fixed), Requests (6,
    Requests/List with the project fixed and its Intake box for the managers), Code (7),
    Docs (8, Commons/Knowledge with the project's documentation space fixed), Team (9), Time (10, Time/TimeEntries with the project fixed and
    its totals, impl-projects.md P6b), Money (11, ProjectDetail/Money: the budget, billing, milestone shares, invoices and order of the
    project for those who manage money, impl-projects.md P8b), Files (12) and Settings (13, managers, BOSS_PROJECTS_MANAGERS); the
    Modules box of Settings keeps which are on (WstModules). A project the user may not see is "not available". -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Project" default-menu-include="false">

    <parameter name="workEffortId" required="true"/>

    <!-- the project for the tabs, which the client loads on their own (their actions run without this screen's): visible and
        managed by the user, cheap enough for every transition (a task's id in a Work items transition is not a project) -->
    <always-actions><script><![CDATA[
        const projectAccess = ec.service.sync().name('ironstone.projects.ProjectServices.get#ProjectAccess').parameters({workEffortId: workEffortId || '', need: 'none'}).call() || {}
        recordFound = !!projectAccess.canView
        project = projectAccess.project || null
        projectTabId = recordFound ? workEffortId : null
        canManage = !!projectAccess.canManage
        canChange = !!projectAccess.canChange
        // a tab mounted from elsewhere (Commons Knowledge as Docs) knows it is in a project
        inProjectDetail = true
    ]]></script></always-actions>

    <subscreens default-item="Overview">
        <subscreens-item name="WorkItems" location="component://mr-boss/screen/Projects/WorkItems/List.xml" menu-title="Work items" menu-index="2"/>
        <!-- the backlog and sprints with the project fixed (design-projects.md §4 ProjectBacklog); always there (impl-projects.md F24):
            without the Backlog and sprints module it ranks the backlog only, with Plan in sprints for the managers -->
        <subscreens-item name="Backlog" location="component://mr-boss/screen/Projects/WorkItems/Backlog.xml" menu-title="Backlog" menu-index="3"/>
        <!-- the milestones, releases and sprints with the project fixed (design-projects.md §4 ProjectRoadmap); Plan (4) is
            ProjectDetail/Plan.xml beside this file -->
        <subscreens-item name="Roadmap" location="component://mr-boss/screen/Projects/Projects/Roadmap.xml" menu-title="Roadmap" menu-index="5"/>
        <!-- the project's requests (design-projects.md §4 ProjectRequests): Requests/List with the project fixed; always there
            (impl-projects.md F24): without the Requests module the project still takes requests linked to it -->
        <subscreens-item name="Requests" location="component://mr-boss/screen/Projects/Requests/List.xml" menu-title="Requests" menu-index="6"/>
        <!-- the project's documentation space in Commons Knowledge with the space fixed, and its linked pages (design-projects.md §4
            ProjectDocs); always there (impl-projects.md F24): without a space it offers Set up documentation -->
        <subscreens-item name="Docs" location="component://mr-boss/screen/Commons/Knowledge.xml" menu-title="Docs" menu-index="8"/>
        <!-- the Docs tab's terminal twin (Knowledge.xml's tui text names ../KnowledgeTui): Commons' KnowledgeTui in its project mode
            (impl-projects.md P11) -->
        <subscreens-item name="KnowledgeTui" location="component://mr-boss/screen/Commons/KnowledgeTui.xml" menu-include="false"/>
        <!-- the project's time (design-projects.md §4 ProjectTime): Time/TimeEntries with the project fixed and its totals box; always
            there (impl-projects.md F24): without the Time module the project's time is still logged and found here -->
        <subscreens-item name="Time" location="component://mr-boss/screen/Projects/Time/TimeEntries.xml" menu-title="Time" menu-index="10"/>
    </subscreens>

    <transition name="projects"><default-response url="../List"/></transition>
    <transition name="changeStatus">
        <actions>
            <service-call name="ironstone.projects.ProjectServices.set#ProjectStatus" out-map="statusOut" in-map="{workEffortId:workEffortId, statusId:statusId}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(statusOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="postUpdate">
        <actions>
            <service-call name="ironstone.projects.ProjectServices.post#ProjectUpdate" out-map="updateOut" in-map="{workEffortId:workEffortId, healthEnumId:healthEnumId,
                    percentComplete:percentComplete, body:body, clientVisible:clientVisible}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(updateOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="follow">
        <actions>
            <service-call name="ironstone.shared.ChatterServices.follow#Record" out-map="followOut" in-map="{recordEntityName:'mantle.work.effort.WorkEffort', recordId:workEffortId}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(followOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="unfollow">
        <actions>
            <service-call name="ironstone.shared.ChatterServices.unfollow#Record" out-map="followOut" in-map="{recordEntityName:'mantle.work.effort.WorkEffort', recordId:workEffortId}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(followOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="cloneProject">
        <actions>
            <service-call name="ironstone.projects.ProjectServices.create#NewProject" out-map="cloneOut" in-map="{workEffortId:newWorkEffortId, workEffortName:newWorkEffortName,
                    templateWorkEffortId:(isTemplate == 'Y' ? workEffortId : null), cloneFromWorkEffortId:(isTemplate == 'Y' ? null : workEffortId),
                    clientPartyId:null}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(cloneOut.message, 'success'); workEffortId = cloneOut.projectId</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="saveAsTemplate">
        <actions>
            <service-call name="ironstone.projects.ProjectServices.save#ProjectAsTemplate" out-map="templateOut" in-map="{baseWorkEffortId:workEffortId,
                    workEffortId:templateWorkEffortId, workEffortName:templateName}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(templateOut.message, 'success'); workEffortId = templateOut.templateId</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>

    <actions>
        <service-call name="ironstone.projects.ProjectServices.get#ProjectHeader" in-map="{workEffortId:workEffortId}" out-map="headerOut"/>
        <script><![CDATA[
            if (!recordFound || !headerOut.visible) return
            const L = (text) => ec.l10n.localize(text)
            const enc = (text) => String(text == null ? '' : text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;')
            header = headerOut.header
            // a client contact (impl-projects.md P10b): no moves, follow, clone or print, and the hours only when the project shares them
            clientView = !!clientUser
            hoursShown = !clientView || Array.from(ec.user.context.clientShareHoursProjectIds || []).includes(workEffortId)
            isProjectsManager = ec.user.isInGroup('BOSS_PROJECT_MANAGER') || ec.user.isInGroup('ADMIN')
            primaryAction = canManage ? header.primaryAction : null
            // the other moves of the flow, in the More menu
            moveIds = canManage ? Array.from(header.otherMoves || []).map((move) => move.statusId) : []
            isFollower = ec.entity.find('mantle.party.communication.RecordFollower').condition('recordEntityName', 'mantle.work.effort.WorkEffort')
                    .condition('recordId', workEffortId).condition('userId', ec.user.userId).count() > 0
            // the chips of the title row: health with the date of its update, the client, the manager
            const chip = (text, cls, icon) => '<q-chip dense square class="q-my-none q-ml-none q-mr-sm ' + cls + '"' + (icon ? ' icon="' + icon + '"' : '') + '>' + enc(text) + '</q-chip>'
            chipsHtml = '<div class="row items-center m-project-chips">'
                + (header.healthLabel ? chip(header.healthLabel + (header.healthDateText ? ' · ' + header.healthDateText : ''), 'm-tonal text-' + header.healthColor, 'sym_o_monitor_heart') : '')
                + (header.clientName ? chip(header.clientName, 'm-tonal text-grey-8', 'sym_o_domain') : '')
                + (header.managerName ? '<span class="row inline items-center no-wrap q-mr-sm text-body2"><m-avatar name="' + enc(header.managerName) + '"'
                    + (header.managerUserId ? ' user-id="' + enc(header.managerUserId) + '"' : '') + ' size="22px" class="q-mr-xs"></m-avatar>' + enc(header.managerName) + '</span>' : '')
                + (header.purposeLabel ? '<span class="text-caption m-muted">' + enc(header.purposeLabel) + '</span>' : '') + '</div>'
            chipsTui = {t: 'text', id: 'ProjectChips', text: [header.healthLabel ? L('Health') + ': ' + header.healthLabel : '', header.clientName ? L('Client') + ': ' + header.clientName : '',
                header.managerName ? L('Manager') + ': ' + header.managerName : ''].filter((part) => part).join(' · ')}
            const tabBase = '/qapps/Projects/Projects/ProjectDetail/WorkItems?workEffortId=' + encodeURIComponent(workEffortId)
            openItemsLink = tabBase + '&list=open'
            overdueLink = tabBase + '&list=overdue'
            nextMilestoneLink = header.nextMilestoneId ? '/qapps/Projects/Projects/MilestoneDetail?workEffortId=' + encodeURIComponent(header.nextMilestoneId) : ''
            printUrl = '/apps/Projects/Projects/StatusReport?renderMode=html-print&workEffortId=' + encodeURIComponent(workEffortId)
            healthToday = header.healthEnumId || 'WehOnTrack'
        ]]></script>
    </actions>

    <widgets>
        <section name="ProjectNotFound" condition="!recordFound"><widgets>
            <container-box type="warning"><box-header title="Not available"/><box-body>
                <label type="p" text="Project ${workEffortId} is not available: it does not exist, or it is a Work group project you are not on."/>
                <link url="projects" text="Back to Projects" link-type="anchor"/>
            </box-body></container-box>
        </widgets></section>

        <section name="ProjectFound" condition="recordFound"><widgets>
            <!-- the record for the shell: quick create's link chip and project, Chatter, Assist -->
            <context record-entity="mantle.work.effort.WorkEffort" record-id="${workEffortId}" title="${header.workEffortName}"/>

            <section name="TemplateBanner" condition="header.isTemplate"><widgets>
                <container-box type="info"><box-body>
                    <label type="p" text="Template: changes here shape the new projects made from it. It is left out of the project lists; Settings, Templates lists it." style="q-mb-none"/>
                </box-body></container-box>
            </widgets></section>

            <!-- the header card (style-guide §3.3): the key and name with the status-bar at their right, then the chips with the actions at their right -->
            <container style="m-record-header m-project-header">
                <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                    <container style="col-12 col-md m-record-title">
                        <container style="row items-center no-wrap">
                            <render-mode><text type="qvt"><![CDATA[${header.colorName ? '<span class="q-mr-sm bg-' + WebUtilities.encodeHtml(header.colorName) + '" style="display:inline-block;width:12px;height:12px;border-radius:50%"></span>' : ''}<q-chip dense square class="q-ma-none q-mr-sm text-mono m-project-key">${WebUtilities.encodeHtml(workEffortId)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", id: "ProjectKey", style: "strong", text: workEffortId})}]]></text></render-mode>
                            <label text="${header.workEffortName}" type="h5" style="${header.isEnded ? 'm-muted' : ''}"/>
                        </container>
                    </container>
                    <container style="col-12 col-md-auto m-record-status">
                        <status-bar id="ProjectStatusBar" status-id="${header.statusId}" status-flow-id="Default" stages="${header.stageStatusIds}" read-only="true"/>
                    </container>
                </container>
                <container style="row items-center q-col-gutter-x-md q-col-gutter-y-sm m-record-foot">
                    <container style="col-12 col-md">
                        <render-mode><text type="qvt"><![CDATA[${chipsHtml}]]></text><text type="tui"><![CDATA[${JSON.stringify(chipsTui)}]]></text></render-mode>
                    </container>
                    <container style="col-12 col-md-auto row items-center q-gutter-y-xs m-record-actions m-project-actions">
                        <!-- the primary action: a move along the flow, or in progress the status update -->
                        <section name="PrimaryMove" condition="primaryAction &amp;&amp; primaryAction.kind == 'status'"><widgets>
                            <link url="changeStatus" link-type="hidden-form" text="${primaryAction.label}" btn-type="primary" icon="sym_o_arrow_forward"
                                    confirmation="${primaryAction.label}: ${header.workEffortName}?" parameter-map="{workEffortId:workEffortId, statusId:primaryAction.statusId}"/>
                        </widgets></section>
                        <container-dialog id="ProjectPostUpdateDialog" button-text="Post update" icon="sym_o_campaign" width="640" title="Status update of ${header.workEffortName}"
                                condition="canChange">
                            <form-single name="PostUpdate" transition="postUpdate" focus-field="body">
                                <field name="workEffortId"><default-field><hidden/></default-field></field>
                                <field name="healthEnumId" from="healthToday"><default-field title="Health">
                                    <radio><option key="WehOnTrack" text="On track"/><option key="WehAtRisk" text="At risk"/><option key="WehOffTrack" text="Off track"/></radio></default-field></field>
                                <field name="percentComplete"><default-field title="Progress (%)"><text-line size="5" input-type="number"/></default-field></field>
                                <field name="body"><default-field title="Summary (markdown): what was done, what comes next, what is in the way">
                                    <text-area rows="7" cols="70" editor-type="md"/></default-field></field>
                                <field name="clientVisible"><default-field title=" "><check><option key="Y" text="Shown to the client"/></check></default-field></field>
                                <field name="submitButton"><default-field title="Post update"><submit/></default-field></field>
                                <field-layout><field-row><field-ref name="healthEnumId"/><field-ref name="percentComplete"/></field-row>
                                    <field-ref name="body"/><field-ref name="clientVisible"/><field-ref name="submitButton"/></field-layout>
                            </form-single>
                        </container-dialog>
                        <button-menu text="More" icon="more_horiz" style="q-ml-xs" condition="!clientView">
                            <link url="changeStatus" link-type="hidden-form-link" text="Approve" icon="sym_o_thumb_up" condition="moveIds.includes('WeApproved')"
                                    confirmation="Approve: ${header.workEffortName}?" parameter-map="{workEffortId:workEffortId, statusId:'WeApproved'}"/>
                            <link url="changeStatus" link-type="hidden-form-link" text="${header.statusId == 'WeInPlanning' || header.statusId == 'WeApproved' ? 'Begin' : 'Resume'}" icon="sym_o_play_arrow" condition="moveIds.includes('WeInProgress')"
                                    confirmation="${header.statusId == 'WeInPlanning' || header.statusId == 'WeApproved' ? 'Begin' : 'Resume'}: ${header.workEffortName}?" parameter-map="{workEffortId:workEffortId, statusId:'WeInProgress'}"/>
                            <link url="changeStatus" link-type="hidden-form-link" text="Hold" icon="sym_o_pause" condition="moveIds.includes('WeOnHold')"
                                    confirmation="Hold: ${header.workEffortName}?" parameter-map="{workEffortId:workEffortId, statusId:'WeOnHold'}"/>
                            <link url="changeStatus" link-type="hidden-form-link" text="Complete" icon="sym_o_task_alt" condition="moveIds.includes('WeComplete')"
                                    confirmation="Complete: ${header.workEffortName}?" parameter-map="{workEffortId:workEffortId, statusId:'WeComplete'}"/>
                            <link url="changeStatus" link-type="hidden-form-link" text="Close" icon="sym_o_archive" condition="moveIds.includes('WeClosed')"
                                    confirmation="Close: ${header.workEffortName}?" parameter-map="{workEffortId:workEffortId, statusId:'WeClosed'}"/>
                            <link url="changeStatus" link-type="hidden-form-link" text="Re-open" icon="sym_o_undo" condition="moveIds.includes('WeInPlanning')"
                                    confirmation="Re-open: ${header.workEffortName}?" parameter-map="{workEffortId:workEffortId, statusId:'WeInPlanning'}"/>
                            <link url="changeStatus" link-type="hidden-form-link" text="Cancel" icon="sym_o_cancel" btn-type="danger" condition="moveIds.includes('WeCancelled')"
                                    confirmation="Cancel: ${header.workEffortName}?" parameter-map="{workEffortId:workEffortId, statusId:'WeCancelled'}"/>
                            <link url="follow" link-type="hidden-form-link" text="Follow" icon="sym_o_visibility" condition="!isFollower" parameter-map="{workEffortId:workEffortId}"/>
                            <link url="unfollow" link-type="hidden-form-link" text="Unfollow" icon="sym_o_visibility_off" condition="isFollower" parameter-map="{workEffortId:workEffortId}"/>
                            <container-dialog id="ProjectCloneDialog" button-text="Clone" icon="sym_o_content_copy" width="520" title="A copy of ${header.workEffortName}" condition="isProjectsManager">
                                <form-single name="CloneProject" transition="cloneProject" focus-field="newWorkEffortName">
                                    <field name="workEffortId"><default-field><hidden/></default-field></field>
                                    <field name="isTemplate" from="header.isTemplate ? 'Y' : 'N'"><default-field><hidden/></default-field></field>
                                    <field name="newWorkEffortName" from="header.workEffortName + ' (copy)'"><default-field title="Name"><text-line size="40"/></default-field></field>
                                    <field name="newWorkEffortId"><default-field title="Key (1 to 8 letters or digits)"><text-line size="10"/></default-field></field>
                                    <field name="submitButton"><default-field title="Clone"><submit/></default-field></field>
                                </form-single>
                                <label type="p" text="The copy has the work items, members and settings, its items back in planning and without dates." style="text-caption m-muted"/>
                            </container-dialog>
                            <container-dialog id="ProjectTemplateDialog" button-text="Save as template" icon="sym_o_content_paste" width="520" title="A template from ${header.workEffortName}"
                                    condition="isProjectsManager &amp;&amp; !header.isTemplate">
                                <form-single name="SaveAsTemplate" transition="saveAsTemplate" focus-field="templateName">
                                    <field name="workEffortId"><default-field><hidden/></default-field></field>
                                    <field name="templateName" from="header.workEffortName + ' template'"><default-field title="Template name"><text-line size="40"/></default-field></field>
                                    <field name="templateWorkEffortId"><default-field title="Key (1 to 8 letters or digits)"><text-line size="10"/></default-field></field>
                                    <field name="submitButton"><default-field title="Save as template"><submit/></default-field></field>
                                </form-single>
                            </container-dialog>
                            <link url="${printUrl}" url-type="plain" text="Print status report" icon="sym_o_print" target-window="_blank"/>
                        </button-menu>
                    </container>
                </container>
            </container>

            <!-- the numbers, each a link into the Work items tab -->
            <dashboard min-width="150" style="q-mb-sm">
                <number-card title="Open items" value="${ec.l10n.format(header.openItems || 0, '#,##0')}" icon="sym_o_checklist" size="sm" link="${openItemsLink}"/>
                <number-card title="Overdue" value="${ec.l10n.format(header.overdueItems || 0, '#,##0')}" icon="sym_o_assignment_late" size="sm" link="${overdueLink}"/>
                <number-card title="Next milestone" value="${header.nextMilestoneText || '—'}" icon="sym_o_flag_circle" size="sm" link="${nextMilestoneLink}"/>
                <number-card title="Hours" value="${header.hoursText}" icon="sym_o_schedule" size="sm" condition="hoursShown"/>
                <number-card title="Budget used" value="${header.budgetUsedText}" icon="sym_o_account_balance_wallet" size="sm" condition="canManage &amp;&amp; header.budgetUsedText"/>
                <number-card title="Unbilled" value="${header.unbilledText}" icon="sym_o_request_quote" size="sm" link="/qapps/Projects/Billing/Unbilled?rootWorkEffortId=${workEffortId}"
                        condition="canManage &amp;&amp; header.unbilledText"/>
            </dashboard>

            <subscreens-panel id="ProjectTabs" type="tab"/>
        </widgets></section>
    </widgets>
</screen>
