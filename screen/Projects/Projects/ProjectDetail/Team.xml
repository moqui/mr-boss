<!-- ProjectTeam (design-projects.md §4 ProjectTeam): boxes of the members and their roles (Add member, End for those who manage
    the project), the teams on it (OrgTeam) and the client contacts (Customer, ClientManager, ClientBilling, CustomerBillTo) with
    their email and whether they have a user; client sign-in itself is impl-projects.md P10 (ProjectSettings keeps the choice).
    The Allocations box (impl-projects.md P7): who is planned on it, a person or a placeholder role, from, thru, hours a week (or the
    percent), the status chip; Request allocation for its managers and the Projects managers (allocated at once by the latter unless they
    ask for approval), Approve and Cancel on a row, and the team planner on the project. Services: ironstone.projects.ProjectServices
    get#ProjectTeam, add#ProjectMember, end#ProjectMember; ironstone.projects.ResourceServices get#ProjectAllocations, save#, decide#Allocation. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Team" default-menu-index="9" menu-image="sym_o_groups" menu-image-type="icon">

    <transition name="addMember">
        <actions>
            <service-call name="ironstone.projects.ProjectServices.add#ProjectMember" out-map="addOut" in-map="{workEffortId:workEffortId, partyId:partyId, roleTypeId:roleTypeId}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(addOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="endMember">
        <actions>
            <service-call name="ironstone.projects.ProjectServices.end#ProjectMember" out-map="endOut" in-map="{workEffortId:workEffortId, partyId:partyId, roleTypeId:roleTypeId}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(endOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="requestAllocation">
        <actions>
            <service-call name="ironstone.projects.ResourceServices.save#Allocation" out-map="allocOut" in-map="{workEffortId:workEffortId, partyId:(allocPartyId || null),
                    roleTypeId:(allocRoleTypeId || null), skillTypeEnumId:(allocSkillTypeEnumId || null), fromDate:allocFromDate, thruDate:allocThruDate, amount:amount,
                    unit:(unit || 'h'), comments:(comments || null), request:(request || null)}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(allocOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="decideAllocation">
        <actions>
            <service-call name="ironstone.projects.ResourceServices.decide#Allocation" out-map="decideOut" in-map="{workEffortAllocationId:workEffortAllocationId, action:action}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(decideOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="allocationPeople" read-only="true">
        <actions>
            <service-call name="ironstone.projects.ResourceServices.search#AllocationPeople" in-map="{term:term}" out-map="found"/>
            <script>ec.web.sendJsonResponse(found.optionList || [])</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition name="peopleSearch" read-only="true">
        <actions>
            <service-call name="ironstone.commons.TaskServices.search#Assignees" in-map="{term:term}" out-map="found"/>
            <script>ec.web.sendJsonResponse(found.optionList || [])</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <!-- organizations (a team, a client) or people (a client contact), not another user's personal contacts -->
    <transition name="partySearch" read-only="true">
        <actions>
            <entity-find entity-name="mantle.party.PartyDetail" list="partyList" limit="20">
                <econdition field-name="partyTypeEnumId" from="kind == 'person' ? 'PtyPerson' : 'PtyOrganization'"/>
                <econditions combine="or">
                    <econdition field-name="organizationName" operator="like" value="%${term}%" ignore-case="true" ignore="!term"/>
                    <econdition field-name="firstName" operator="like" value="%${term}%" ignore-case="true" ignore="!term"/>
                    <econdition field-name="lastName" operator="like" value="%${term}%" ignore-case="true" ignore="!term"/>
                </econditions>
                <econdition field-name="disabled" operator="not-equals" value="Y" or-null="true"/>
                <econdition field-name="privateOwnerUserId" from="ec.user.userId" or-null="true"/>
                <order-by field-name="^organizationName,^firstName,^lastName"/>
            </entity-find>
            <script>ec.web.sendJsonResponse(Array.from(partyList).map((party) => ({value: party.partyId,
                label: party.organizationName || [party.firstName, party.lastName].filter((part) => part).join(' ') || party.partyId})))</script>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <script><![CDATA[
            if (!recordFound) return
            const team = ec.service.sync().name('ironstone.projects.ProjectServices.get#ProjectTeam').parameters({workEffortId: workEffortId}).call() || {}
            memberList = Array.from(team.memberList || [])
            teamList = Array.from(team.teamList || [])
            clientList = Array.from(team.clientList || [])
            roleOptions = Array.from(team.roleOptions || [])
            canManage = !!team.canManage
            const allocations = ec.service.sync().name('ironstone.projects.ResourceServices.get#ProjectAllocations').parameters({workEffortId: workEffortId}).call() || {}
            ec.message.clearErrors()
            allocationList = Array.from(allocations.allocationList || [])
            canRequestAllocation = !!allocations.canRequest
            canApproveAllocation = !!allocations.canApprove
            const allocOptions = ec.service.sync().name('ironstone.projects.ResourceServices.get#AllocationRoleOptions').call() || {}
            allocRoleOptions = Array.from(allocOptions.roleOptions || []).map((one) => ({key: one.value, text: one.label}))
            allocSkillOptions = Array.from(allocOptions.skillOptions || []).map((one) => ({key: one.value, text: one.label}))
            const today = ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')
            const js = new Date(today + 'T12:00:00Z').getUTCDay()
            allocFromDefault = new Date(Date.parse(today + 'T12:00:00Z') - ((js + 6) % 7) * 86400000).toISOString().slice(0, 10)
            allocThruDefault = new Date(Date.parse(allocFromDefault + 'T12:00:00Z') + 27 * 86400000).toISOString().slice(0, 10)
            plannerUrl = '/qapps/Projects/Resources/TeamPlanner?rootWorkEffortId=' + encodeURIComponent(workEffortId)
        ]]></script>
    </actions>

    <widgets>
        <section name="TeamFound" condition="recordFound"><widgets>
        <container-box><box-header title="Members · ${memberList.length}"/>
            <box-toolbar>
                <container-dialog id="TeamAddMemberDialog" button-text="Add member" icon="sym_o_person_add" width="520" title="Add a member to ${project.workEffortName}" disable-condition="!canManage" disable-message="Needs project management access, which an administrator can grant.">
                    <form-single name="AddMember" transition="addMember">
                        <field name="workEffortId"><default-field><hidden/></default-field></field>
                        <field name="partyId"><default-field title="Person">
                            <drop-down><dynamic-options transition="peopleSearch" server-search="true" min-length="0"/></drop-down></default-field></field>
                        <field name="roleTypeId" from="'Programmer'"><default-field title="Role">
                            <drop-down><list-options list="roleOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body-nopad>
            <form-list name="TeamMembers" list="memberList" skip-form="true" paginate="false">
                <field name="name"><default-field title="Person">
                    <render-mode><text type="qvt"><![CDATA[<span class="row inline no-wrap items-center"><m-avatar name="${WebUtilities.encodeHtml(name ?? '')}"${userId ? ' user-id="' + WebUtilities.encodeHtml(userId) + '"' : ''} size="24px" class="q-mr-sm"></m-avatar>${WebUtilities.encodeHtml(name ?? '')}</span>]]></text>
                        <text type="tui"><![CDATA[{"t": "text", "text": ${JSON.stringify(name ?? "")}}]]></text></render-mode></default-field></field>
                <field name="roleText"><default-field title="Role"><display/></default-field></field>
                <field name="fromText"><default-field title="From"><display/></default-field></field>
                <field name="statusText"><default-field title="Status"><display/></default-field></field>
                <field name="endLink"><conditional-field condition="canManage" title="">
                    <link url="endMember" link-type="hidden-form-link" text="End" confirmation="Take ${name} off ${project.workEffortName} as ${roleText}?"
                            parameter-map="{workEffortId:workEffortId, partyId:partyId, roleTypeId:roleTypeId}"/></conditional-field>
                    <default-field><ignored/></default-field></field>
            </form-list>
            <section name="NoMembers" condition="!memberList.length"><widgets>
                <label type="p" text="No members yet" style="m-muted q-pa-sm q-mb-none"/>
            </widgets></section>
        </box-body-nopad></container-box>

        <container-row>
            <row-col md="6">
                <container-box><box-header title="Teams"/>
                    <box-toolbar>
                        <container-dialog id="TeamAddTeamDialog" button-text="Add team" icon="sym_o_groups" width="520" title="Add a team to ${project.workEffortName}" disable-condition="!canManage" disable-message="Needs project management access, which an administrator can grant.">
                            <form-single name="AddTeam" transition="addMember">
                                <field name="workEffortId"><default-field><hidden/></default-field></field>
                                <field name="roleTypeId" from="'OrgTeam'"><default-field><hidden/></default-field></field>
                                <field name="partyId"><default-field title="Team">
                                    <drop-down><dynamic-options transition="partySearch" server-search="true" min-length="0" parameter-map="{kind:'organization'}"/></drop-down></default-field></field>
                                <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body-nopad>
                    <form-list name="TeamGroups" list="teamList" skip-form="true" skip-header="true" paginate="false">
                        <field name="name"><default-field><display/></default-field></field>
                        <field name="fromText"><default-field><label text="${fromText}" type="span" style="text-caption m-muted"/></default-field></field>
                        <field name="endLink"><conditional-field condition="canManage" title="">
                            <link url="endMember" link-type="hidden-form-link" text="End" confirmation="Take ${name} off ${project.workEffortName}?"
                                    parameter-map="{workEffortId:workEffortId, partyId:partyId, roleTypeId:roleTypeId}"/></conditional-field>
                            <default-field><ignored/></default-field></field>
                    </form-list>
                    <section name="NoTeams" condition="!teamList.length"><widgets>
                        <label type="p" text="No teams on it" style="m-muted q-pa-sm q-mb-none"/>
                    </widgets></section>
                </box-body-nopad></container-box>
            </row-col>
            <row-col md="6">
                <container-box><box-header title="Client contacts"/>
                    <box-toolbar>
                        <container-dialog id="TeamAddClientDialog" button-text="Add contact" icon="sym_o_contact_mail" width="520" title="Add a client contact to ${project.workEffortName}" disable-condition="!canManage" disable-message="Needs project management access, which an administrator can grant.">
                            <form-single name="AddClientContact" transition="addMember">
                                <field name="workEffortId"><default-field><hidden/></default-field></field>
                                <field name="partyId"><default-field title="Person">
                                    <drop-down><dynamic-options transition="partySearch" server-search="true" min-length="0" parameter-map="{kind:'person'}"/></drop-down></default-field></field>
                                <field name="roleTypeId" from="'ClientManager'"><default-field title="Role">
                                    <drop-down><option key="ClientManager" text="Client manager"/><option key="ClientBilling" text="Client billing"/>
                                        <option key="Customer" text="Customer"/></drop-down></default-field></field>
                                <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body-nopad>
                    <form-list name="ClientContacts" list="clientList" skip-form="true" paginate="false">
                        <field name="name"><default-field title="Contact"><display/></default-field></field>
                        <field name="roleText"><default-field title="Role"><display/></default-field></field>
                        <field name="email"><default-field title="Email"><display/></default-field></field>
                        <field name="signInText"><default-field title="Sign-in"><display/></default-field></field>
                        <field name="endLink"><conditional-field condition="canManage" title="">
                            <link url="endMember" link-type="hidden-form-link" text="End" confirmation="Take ${name} off ${project.workEffortName} as ${roleText}?"
                                    parameter-map="{workEffortId:workEffortId, partyId:partyId, roleTypeId:roleTypeId}"/></conditional-field>
                            <default-field><ignored/></default-field></field>
                    </form-list>
                    <section name="NoClients" condition="!clientList.length"><widgets>
                        <label type="p" text="No client contacts: an internal project" style="m-muted q-pa-sm q-mb-none"/>
                    </widgets></section>
                </box-body-nopad></container-box>
            </row-col>
        </container-row>
        <container-box><box-header title="Allocations · ${allocationList.length}"/>
            <box-toolbar>
                <link url="${plannerUrl}" url-type="plain" link-type="anchor" text="Team planner" icon="sym_o_group_work"/>
                <container-dialog id="TeamRequestAllocationDialog" button-text="Request allocation" icon="sym_o_event_available" width="600"
                        title="An allocation on ${project.workEffortName}" disable-condition="!canRequestAllocation"
                        disable-message="Needs resource allocation access, which an administrator can grant.">
                    <form-single name="RequestAllocation" transition="requestAllocation">
                        <field name="workEffortId"><default-field><hidden/></default-field></field>
                        <field name="allocPartyId"><default-field title="Person (empty: a role to staff)">
                            <drop-down allow-empty="true"><dynamic-options transition="allocationPeople" server-search="true" min-length="0"/></drop-down></default-field></field>
                        <field name="allocRoleTypeId" from="'Programmer'"><default-field title="Project role">
                            <drop-down allow-empty="true"><list-options list="allocRoleOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                        <field name="allocSkillTypeEnumId"><default-field title="Skill">
                            <drop-down allow-empty="true"><list-options list="allocSkillOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                        <field name="allocFromDate" from="allocFromDefault"><default-field title="From"><date-time type="date" format="yyyy-MM-dd"/></default-field></field>
                        <field name="allocThruDate" from="allocThruDefault"><default-field title="Thru"><date-time type="date" format="yyyy-MM-dd"/></default-field></field>
                        <field name="amount" from="'8'"><default-field title="Amount"><text-line size="6" input-type="number"/></default-field></field>
                        <field name="unit" from="'h'"><default-field title="As">
                            <radio><option key="h" text="Hours a week"/><option key="pct" text="Percent of capacity"/></radio></default-field></field>
                        <field name="comments"><default-field title="Note"><text-area rows="2" cols="50"/></default-field></field>
                        <field name="request"><conditional-field condition="canApproveAllocation" title="">
                                <check><option key="Y" text="Request it for approval instead of allocating now"/></check></conditional-field>
                            <default-field><hidden/></default-field></field>
                        <field name="submitButton"><default-field title="${canApproveAllocation ? 'Allocate' : 'Request'}"><submit/></default-field></field>
                        <field-layout>
                            <field-ref name="workEffortId"/>
                            <field-ref name="allocPartyId"/>
                            <field-row><field-ref name="allocRoleTypeId"/><field-ref name="allocSkillTypeEnumId"/></field-row>
                            <field-row><field-ref name="allocFromDate"/><field-ref name="allocThruDate"/></field-row>
                            <field-row><field-ref name="amount"/><field-ref name="unit"/></field-row>
                            <field-ref name="comments"/>
                            <field-ref name="request"/>
                            <field-ref name="submitButton"/>
                        </field-layout>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body-nopad>
            <form-list name="ProjectAllocations" list="allocationList" skip-form="true" paginate="false">
                <field name="whoText"><default-field title="Person or role">
                    <render-mode><text type="qvt"><![CDATA[<div class="row items-center no-wrap">${isPlaceholder ? '<q-icon name="sym_o_person_search" size="24px" class="q-mr-sm m-muted"></q-icon>' : '<m-avatar name="' + WebUtilities.encodeHtml(personName ?? '') + '" size="24px" class="q-mr-sm"></m-avatar>'}<div>${isPlaceholder ? WebUtilities.encodeHtml(whoText ?? '') : '<a href="' + WebUtilities.encodeHtml(personUrl ?? '') + '">' + WebUtilities.encodeHtml(personName ?? '') + '</a>'}<div class="text-caption m-muted">${WebUtilities.encodeHtml(isPlaceholder ? ec.l10n.localize('To staff') : (roleSkillText ?? ''))}</div></div></div>]]></text>
                        <text type="tui"><![CDATA[{"t": "text", "text": ${JSON.stringify((whoText ?? "") + (isPlaceholder ? " (to staff)" : ""))}}]]></text></render-mode></default-field></field>
                <field name="fromText"><default-field title="From"><display/></default-field></field>
                <field name="thruText"><default-field title="Thru"><display/></default-field></field>
                <field name="amountText" align="right"><default-field title="Hours"><display/></default-field></field>
                <field name="statusLabel"><default-field title="Status">
                    <render-mode><text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${statusColor}">${WebUtilities.encodeHtml(statusLabel ?? '')}</q-chip>]]></text>
                        <text type="tui"><![CDATA[{"t": "text", "style": "strong", "text": ${JSON.stringify(statusLabel ?? "")}}]]></text></render-mode></default-field></field>
                <field name="actions" align="right"><default-field title="">
                    <container style="row no-wrap items-center justify-end q-gutter-xs">
                        <link url="decideAllocation" link-type="hidden-form-link" text="Approve" parameter-map="{workEffortId:workEffortId, workEffortAllocationId:workEffortAllocationId, action:'approve'}"
                                condition="canApprove"/>
                        <link url="/qapps/Projects/Resources/Allocations" url-type="plain" text="Staff" link-type="anchor" parameter-map="{list:'unstaffed', rootWorkEffortId:rootWorkEffortId}"
                                condition="isPlaceholder &amp;&amp; canChange"/>
                        <link url="decideAllocation" link-type="hidden-form-link" text="Cancel" confirmation="Cancel this allocation of ${whoText}?"
                                parameter-map="{workEffortId:workEffortId, workEffortAllocationId:workEffortAllocationId, action:'cancel'}" condition="canChange"/>
                    </container></default-field></field>
                <columns type="mobile">
                    <column><field-ref name="whoText"/><field-ref name="fromText"/></column>
                    <column><field-ref name="statusLabel"/><field-ref name="amountText"/></column>
                    <column><field-ref name="actions"/></column>
                </columns>
            </form-list>
            <section name="NoAllocations" condition="!allocationList.length"><widgets>
                <label type="p" text="No one is planned on it yet" style="m-muted q-pa-sm q-mb-none"/>
            </widgets></section>
        </box-body-nopad></container-box>
        </widgets></section>
    </widgets>
</screen>
