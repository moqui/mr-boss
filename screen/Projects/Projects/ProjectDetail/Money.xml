<!-- ProjectMoney (design-projects.md §4 ProjectMoney; style-guide §3.3 Detail; impl-projects.md P8b): the project's money, for those who
    manage money (ironstone.projects.BillingServices.check#Money: TIME_ENTRY_RATE holders and ADMIN); anyone else sees that it is theirs. Always
    there (impl-projects.md F24): without the Money module the project's money is still here. The number cards: value at the client
    rates, budget used, invoiced, unbilled, milestone shares due. The boxes (service/ironstone/projects/BillingServices.xml get#ProjectMoney over
    mantle.work.ProjectServices.get#ProjectMoneySummary): Budget and actuals (the billing basis and the caps against the hours and their
    value and cost, Edit for those who manage the project: ironstone.projects.ProjectServices.save#ProjectMoney), Unbilled (the time ready and
    waiting, the expenses, the milestone shares due; Create invoice: Unbilled's dialog for the project, mounted here), Milestone billing
    (each share of the order lines its milestones release, billed, due or waiting), Invoices (the client invoices), Expenses (the
    expense invoices on the project, read only: capture is People's), Commercial (the order lines it fulfils, linked to OrderDetail; Link
    an order line, Unlink), Rates (the project's own, ironstone.projects.ProjectServices.get#ProjectRates). Print estimate (Projects/EstimatePrint)
    and Send estimate for approval (ironstone.projects.BillingServices.send#Estimate: a file of the Estimate milestone, its gate asked of the
    client). The project of a transition is the tab's (projectTabId), else workEffortId (impl-projects.md F43). Material estimates and
    the agreement and opportunity behind the project are later (impl-projects.md §7). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Money" default-menu-index="11" menu-image="sym_o_account_balance_wallet" menu-image-type="icon">

    <subscreens>
        <subscreens-item name="CreateInvoice" location="component://mr-boss/screen/Projects/Billing/Unbilled/CreateInvoice.xml" menu-include="false"/>
    </subscreens>

    <transition name="saveBudget">
        <actions>
            <service-call name="ironstone.projects.ProjectServices.save#ProjectMoney" out-map="saveOut" in-map="{workEffortId:(ec.context.get('projectTabId') || workEffortId || ''),
                    billingBasis:billingBasis, totalTimeAllowed:totalTimeAllowed, totalClientCostAllowed:totalClientCostAllowed}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(saveOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="linkOrderLine">
        <actions>
            <service-call name="ironstone.projects.BillingServices.link#OrderLine" out-map="linkOut" in-map="{workEffortId:(ec.context.get('projectTabId') || workEffortId || ''),
                    orderLine:orderLine, orderId:orderId, orderItemSeqId:orderItemSeqId, remove:(remove == 'Y')}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(linkOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="sendEstimate">
        <actions>
            <service-call name="ironstone.projects.BillingServices.send#Estimate" out-map="sendOut" in-map="{workEffortId:(ec.context.get('projectTabId') || workEffortId || ''),
                    depth:(depth ? Number(depth) : 2), comments:comments}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(sendOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="orderLineSearch" read-only="true">
        <actions><script><![CDATA[
            const out = ec.service.sync().name('ironstone.projects.BillingServices.search#OrderLines').parameters({workEffortId: ec.context.get('projectTabId') || workEffortId || '', term: term || ''}).call() || {}
            ec.message.clearErrors()
            ec.web.sendJsonResponse(out.optionList || [])
        ]]></script></actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <script><![CDATA[
            if (!recordFound) return
            const L = (text) => ec.l10n.localize(text)
            const out = ec.service.sync().name('ironstone.projects.BillingServices.get#ProjectMoney').parameters({workEffortId: workEffortId}).call() || {}
            ec.message.clearErrors()
            money = out.money || null
            managesMoney = !!money
            if (!money) return
            budgetRows = money.budgetRows
            shareRows = money.shareRows
            invoiceRows = money.invoiceRows
            expenseRows = money.expenseRows
            lineRows = money.lineRows
            rateRows = []
            if (money.canManage) {
                rateRows = Array.from(ec.service.sync().name('ironstone.projects.ProjectServices.get#ProjectRates').parameters({workEffortId: workEffortId}).call()?.rateList || [])
                ec.message.clearErrors()
            }
            const settings = ec.service.sync().name('mantle.work.ProjectServices.get#ProjectSettings').parameters({workEffortId: workEffortId}).call()?.settings || {}
            const num = (value) => value == null ? '' : String(Number(String(value)))
            budgetValue = {workEffortId: workEffortId, billingBasis: settings.WstBillingBasis || 'TimeAndMaterials', totalTimeAllowed: num(project?.totalTimeAllowed),
                totalClientCostAllowed: num(project?.totalClientCostAllowed)}
            unbilledLines = [[L('Ready to invoice'), money.readyText + ' · ' + money.readyHoursText + ' h ' + L('approved')],
                [L('Waiting for approval'), money.waitingHoursText + ' h'], [L('All unbilled time'), money.unbilledText + ' · ' + money.unbilledHoursText + ' h'],
                [L('Expenses to bill'), money.expensesUnbilledText], [L('Milestone shares due'), money.hasShares ? money.sharesDueText : '']]
                    .filter((pair) => pair[1]).map((pair) => ({label: pair[0], value: pair[1]}))
            ratesUrl = '/qapps/Projects/Billing/Rates?rootWorkEffortId=' + encodeURIComponent(workEffortId)
        ]]></script>
    </actions>

    <widgets>
        <section name="MoneyFound" condition="recordFound"><widgets>
        <section name="NoMoney" condition="!managesMoney"><widgets>
            <container-box type="info"><box-body>
                <label type="p" text="The project's money (budget, billing and invoices) is for those who manage money." style="q-mb-none"/>
            </box-body></container-box>
        </widgets></section>
        <section name="Money" condition="managesMoney"><widgets>
            <container style="row items-center q-mb-sm q-gutter-y-xs">
                <label text="Money" type="h6" style="q-my-none q-mr-sm"/>
                <label text="${money.clientName ? 'Billed to ' + money.clientName : 'No client: nothing is billed'}" type="span" style="text-body2 m-muted"/>
                <container style="col"/>
                <container style="row q-gutter-xs">
                    <link url="${money.estimateUrl}" url-type="plain" text="Print estimate" icon="sym_o_print" link-type="anchor-button" target-window="_blank"/>
                    <container-dialog id="SendEstimateDialog" button-text="Send estimate for approval" icon="sym_o_send" width="560" title="Send the estimate for approval"
                            condition="money.canManage &amp;&amp; money.hasClient">
                        <form-single name="SendEstimate" transition="sendEstimate">
                            <field name="workEffortId"><default-field><hidden/></default-field></field>
                            <field name="depth" from="'2'"><default-field title="Work breakdown to">
                                <radio><option key="1" text="Top-level items"/><option key="2" text="Two levels"/><option key="3" text="Three levels"/></radio></default-field></field>
                            <field name="comments"><default-field title="Message to the client"><text-area rows="3" cols="50"/></default-field></field>
                            <field name="submitButton"><default-field title="Send for approval"><submit/></default-field></field>
                        </form-single>
                        <label type="p" text="The estimate is kept as a file of the project's Estimate milestone, and its approval is asked of the client's manager (else the client). The client approves it on that milestone; until clients sign in, record their decision there. Approved, the project moves from In Planning to Approved and its open order is approved."
                                style="text-caption m-muted"/>
                    </container-dialog>
                </container>
            </container>

            <dashboard min-width="150" style="q-mb-sm">
                <number-card title="Value" value="${money.actualValueText}" icon="sym_o_payments" size="sm"/>
                <number-card title="Budget used" value="${money.budgetUsedText}" icon="sym_o_account_balance_wallet" size="sm"/>
                <number-card title="Invoiced" value="${money.invoicedText}" icon="sym_o_receipt_long" size="sm"/>
                <number-card title="Unbilled" value="${money.unbilledText}" icon="sym_o_request_quote" size="sm" link="${money.unbilledUrl}"/>
                <number-card title="Shares due" value="${money.sharesDueText}" icon="sym_o_flag_check" size="sm" condition="money.hasShares"/>
            </dashboard>

            <container-row>
                <row-col lg="6">
                    <container-box><box-header title="Budget and actuals"/>
                        <box-toolbar>
                            <container-dialog id="EditBudgetDialog" button-text="Edit" icon="sym_o_edit" width="520" title="Budget of the project" condition="money.canManage &amp;&amp; canChange">
                                <form-single name="EditBudget" transition="saveBudget" map="budgetValue">
                                    <field name="workEffortId"><default-field><hidden/></default-field></field>
                                    <field name="billingBasis"><default-field title="Billing basis">
                                        <radio><option key="TimeAndMaterials" text="Time and materials"/><option key="FixedPrice" text="Fixed price"/>
                                            <option key="Milestones" text="By milestones"/><option key="NotBilled" text="Not billed"/></radio></default-field></field>
                                    <field name="totalTimeAllowed"><default-field title="Hours budget"><text-line size="8" input-type="number"/></default-field></field>
                                    <field name="totalClientCostAllowed"><default-field title="Client budget"><text-line size="10" input-type="number"/></default-field></field>
                                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                                </form-single>
                            </container-dialog>
                        </box-toolbar>
                        <box-body-nopad>
                            <form-list name="BudgetActuals" list="budgetRows" skip-form="true" skip-header="true" paginate="false">
                                <field name="label"><default-field><label text="${label}" type="span" style="m-muted text-no-wrap"/></default-field></field>
                                <field name="value" align="right"><default-field><label text="${value}" type="span" style="text-weight-medium ${style}"/></default-field></field>
                            </form-list>
                        </box-body-nopad>
                    </container-box>
                </row-col>
                <row-col lg="6">
                    <container-box><box-header title="Unbilled"/>
                        <box-toolbar>
                            <dynamic-dialog id="MoneyCreateInvoiceDialog" button-text="Create invoice" icon="sym_o_receipt_long" transition="CreateInvoice" width="720"
                                    title="Invoice ${project?.workEffortName || workEffortId}" parameter-map="{workEffortId:workEffortId}" condition="money.canManage &amp;&amp; money.canInvoice"/>
                            <link url="${money.timeUrl}" url-type="plain" text="Review time" icon="sym_o_schedule" link-type="anchor-button"/>
                        </box-toolbar>
                        <box-body-nopad>
                            <form-list name="UnbilledBox" list="unbilledLines" skip-form="true" skip-header="true" paginate="false">
                                <field name="label"><default-field><label text="${label}" type="span" style="m-muted text-no-wrap"/></default-field></field>
                                <field name="value" align="right"><default-field><label text="${value}" type="span" style="text-weight-medium"/></default-field></field>
                            </form-list>
                            <label type="p" text="${money.cannotReason}" style="text-caption m-muted q-pa-sm q-mb-none" condition="!money.canInvoice &amp;&amp; money.cannotReason"/>
                        </box-body-nopad>
                    </container-box>
                    <container-box><box-header title="Commercial · ${lineRows.length}"/>
                        <box-toolbar>
                            <container-dialog id="LinkOrderLineDialog" button-text="Link an order line" icon="sym_o_add_link" width="560" title="An order line this project fulfils"
                                    condition="money.canManage &amp;&amp; money.hasClient">
                                <form-single name="LinkOrderLine" transition="linkOrderLine">
                                    <field name="workEffortId"><default-field><hidden/></default-field></field>
                                    <field name="orderLine"><default-field title="Order line (the client's sales orders)">
                                        <drop-down><dynamic-options transition="orderLineSearch" server-search="true" min-length="0" parameter-map="{workEffortId:workEffortId}"/></drop-down></default-field></field>
                                    <field name="submitButton"><default-field title="Link"><submit/></default-field></field>
                                </form-single>
                            </container-dialog>
                        </box-toolbar>
                        <box-body-nopad>
                            <form-list name="CommercialLines" list="lineRows" skip-form="true" paginate="false">
                                <field name="description"><default-field title="Order line">
                                    <link url="${url}" url-type="plain" text="${orderId} ${orderItemSeqId} · ${description}" link-type="anchor"/>
                                    <label text="${statusText} · ${sharedText}" type="div" style="text-caption m-muted"/></default-field></field>
                                <field name="totalText" align="right"><default-field title="Amount"><label text="${totalText}" type="span" style="text-no-wrap text-weight-medium"/></default-field></field>
                                <field name="billedText" align="right"><default-field title="Billed by milestones"><label text="${billedText}" type="span" style="text-no-wrap"/></default-field></field>
                                <field name="unlink" align="right"><default-field title="">
                                    <link url="linkOrderLine" link-type="hidden-form-link" text="" icon="sym_o_link_off" tooltip="Unlink the line" style="m-btn-flat"
                                            parameter-map="{workEffortId:workEffortId, orderId:orderId, orderItemSeqId:orderItemSeqId, remove:'Y'}" condition="money.canManage"
                                            confirmation="Unlink order line ${orderId} ${orderItemSeqId} from the project? Its milestone shares go with it."/></default-field></field>
                                <columns type="mobile">
                                    <column><field-ref name="description"/></column>
                                    <column><field-ref name="totalText"/><field-ref name="unlink"/></column>
                                </columns>
                            </form-list>
                            <label type="p" text="No order line: link the sales order line this project fulfils to bill it by milestones." style="m-muted q-pa-sm q-mb-none" condition="!lineRows.length"/>
                        </box-body-nopad>
                    </container-box>
                </row-col>
            </container-row>

            <container-box><box-header title="Milestone billing · ${shareRows.length}"/><box-body-nopad>
                <form-list name="MilestoneBilling" list="shareRows" skip-form="true" paginate="false">
                    <field name="milestoneName"><default-field title="Milestone">
                        <link url="${milestoneUrl}" url-type="plain" text="${milestoneName}" link-type="anchor"/>
                        <label text="${dueText ? 'Due ' + dueText : ''}" type="div" style="text-caption m-muted" condition="dueText"/></default-field></field>
                    <field name="lineText"><default-field title="Order line"><link url="${orderUrl}" url-type="plain" text="${lineText}" link-type="anchor"/></default-field></field>
                    <field name="shareText" align="right"><default-field title="Share"><display/></default-field></field>
                    <field name="amountText" align="right"><default-field title="Amount"><label text="${amountText}" type="span" style="text-no-wrap text-weight-medium"/></default-field></field>
                    <field name="statusText"><default-field title="Status">
                        <link url="${invoiceUrl}" url-type="plain" text="${statusText}" link-type="anchor" condition="invoiceUrl"/>
                        <label text="${statusText}" type="span" style="text-${statusColor}" condition="!invoiceUrl"/></default-field></field>
                    <columns type="mobile">
                        <column><field-ref name="milestoneName"/><field-ref name="statusText"/></column>
                        <column><field-ref name="amountText"/><field-ref name="shareText"/></column>
                    </columns>
                </form-list>
                <label type="p" text="No milestone releases a share of the order: set shares on a milestone (its Billing box) to bill by milestones." style="m-muted q-pa-sm q-mb-none" condition="!shareRows.length"/>
            </box-body-nopad></container-box>

            <container-row>
                <row-col lg="6">
                    <container-box><box-header title="Invoices · ${invoiceRows.length} · ${money.invoicedText}"/><box-body-nopad>
                        <form-list name="ProjectInvoices" list="invoiceRows" skip-form="true" paginate="false">
                            <field name="invoiceId"><default-field title="Invoice"><link url="${url}" url-type="plain" text="${invoiceId}" link-type="anchor" style="text-mono"/></default-field></field>
                            <field name="dateText"><default-field title="Date"><label text="${dateText}" type="span" style="text-no-wrap"/></default-field></field>
                            <field name="statusText"><default-field title="Status"><display/></default-field></field>
                            <field name="totalText" align="right"><default-field title="Total"><label text="${totalText}" type="span" style="text-no-wrap"/></default-field></field>
                            <field name="unpaidText" align="right"><default-field title="Unpaid"><label text="${unpaidText}" type="span" style="text-no-wrap"/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="invoiceId"/><field-ref name="statusText"/></column>
                                <column><field-ref name="totalText"/><field-ref name="dateText"/></column>
                            </columns>
                        </form-list>
                        <label type="p" text="Not invoiced yet." style="m-muted q-pa-sm q-mb-none" condition="!invoiceRows.length"/>
                    </box-body-nopad></container-box>
                </row-col>
                <row-col lg="6">
                    <container-box><box-header title="Expenses · ${expenseRows.length} · ${money.expenseTotalText}"/><box-body-nopad>
                        <form-list name="ProjectExpenses" list="expenseRows" skip-form="true" paginate="false">
                            <field name="invoiceId"><default-field title="Invoice"><link url="${url}" url-type="plain" text="${invoiceId}" link-type="anchor" style="text-mono"/></default-field></field>
                            <field name="partyName"><default-field title="From"><display/></default-field></field>
                            <field name="dateText"><default-field title="Date"><label text="${dateText}" type="span" style="text-no-wrap"/></default-field></field>
                            <field name="statusText"><default-field title="Status"><display/></default-field></field>
                            <field name="totalText" align="right"><default-field title="Amount"><label text="${totalText}" type="span" style="text-no-wrap"/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="invoiceId"/><field-ref name="partyName"/></column>
                                <column><field-ref name="totalText"/><field-ref name="statusText"/></column>
                            </columns>
                        </form-list>
                        <label type="p" text="No expenses on the project." style="m-muted q-pa-sm q-mb-none" condition="!expenseRows.length"/>
                    </box-body-nopad></container-box>
                    <container-box><box-header title="Rates on this project"/>
                        <box-toolbar><link url="${ratesUrl}" url-type="plain" text="All rates" icon="sym_o_sell" link-type="anchor-button"/></box-toolbar>
                        <box-body-nopad>
                            <form-list name="ProjectMoneyRates" list="rateRows" skip-form="true" paginate="false">
                                <field name="purposeText"><default-field title="For"><display/></default-field></field>
                                <field name="appliesText"><default-field title="Applies to"><display/></default-field></field>
                                <field name="amountText" align="right"><default-field title="Rate"><label text="${amountText}" type="span" style="text-no-wrap"/></default-field></field>
                                <field name="fromText"><default-field title="From"><label text="${fromText}" type="span" style="text-no-wrap"/></default-field></field>
                                <columns type="mobile">
                                    <column><field-ref name="purposeText"/><field-ref name="appliesText"/></column>
                                    <column><field-ref name="amountText"/><field-ref name="fromText"/></column>
                                </columns>
                            </form-list>
                            <label type="p" text="No rates of its own: the organization's and the people's rates apply." style="m-muted q-pa-sm q-mb-none" condition="!rateRows.length"/>
                        </box-body-nopad>
                    </container-box>
                </row-col>
            </container-row>
        </widgets></section>
        </widgets></section>
    </widgets>
</screen>
