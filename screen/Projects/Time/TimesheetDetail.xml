<!-- TimesheetDetail (design-projects.md §8 TimesheetDetail; style-guide §3.3 Detail): one person's week
    (service/ironstone/projects/TimeServices.xml get#TimesheetDetail over mantle.work.TimesheetServices.get#TimesheetSummary), for its person,
    its approvers and ADMIN; anyone else gets "not available". The title row: the person, the week, the status-bar (Open,
    Submitted, Approved; read only, the moves are the actions), the return reason or who approved; Approve (primary for its
    approver), Return and Reopen (each with a reason), Submit (its person), Open the week (MyTime, where its person or approver
    changes the time) and Print (TimesheetPrint, impl-projects.md P9). The number cards: Hours, Billable, Working hours, Difference. The boxes: Entries by day (a day's header with
    its total, then its entries: from, to, work item, project, hours, work type, billable, comment), By project, Flags (no comment
    where the policy needs one, time on no work item, a day off, a closed item, over 12 hours a day) and History (the status
    changes, by whom and when); Chatter, where a return's reason and the answers live, as the right column from 1440 px. Mounted
    under People too (People/Time/TimesheetDetail, impl-people P10): the links and Print follow the mount (appRoot). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Timesheet" default-menu-include="false">

    <parameter name="timesheetId" required="true"/>

    <transition name="decide">
        <actions>
            <service-call name="ironstone.projects.TimeServices.decide#Week" out-map="decideOut" in-map="{action:action, timesheetId:timesheetId, reason:(reason || null)}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(decideOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="timesheetId"/></default-response>
        <error-response url="."/>
    </transition>

    <actions><script><![CDATA[
        const out = ec.service.sync().name('ironstone.projects.TimeServices.get#TimesheetDetail').parameters({timesheetId: timesheetId || '', appRoot: appRoot || null}).call() || {}
        ec.message.clearErrors()
        recordFound = !!out.detail
        if (!recordFound) return
        const L = (text) => ec.l10n.localize(text)
        sheet = out.detail
        access = sheet.access || {}
        stageStatusIds = ['TmshInProcess', 'TmshCompleted', 'TmshApproved']
        entryRows = sheet.entryRows
        entryRowsCount = entryRows.filter((row) => !row.isDay).length
        projectRows = sheet.byProject
        flagRows = sheet.flagList
        historyRows = sheet.history
        stateText = sheet.returned ? L('Returned') + ': ' + (sheet.reason || '') : sheet.statusId === 'TmshApproved'
                ? L('Approved') + (sheet.approvedByName ? ' ' + L('by') + ' ' + sheet.approvedByName : '') + (sheet.approvedText ? ' · ' + sheet.approvedText : '')
                : sheet.statusId === 'TmshCompleted' ? L('Submitted') + (sheet.submittedText ? ' ' + sheet.submittedText : '') + ', ' + L('waiting for approval') : ''
        printUrl = '/apps/' + (appRoot === 'People' ? 'People' : 'Projects') + '/Time/TimesheetPrint?renderMode=html-print&timesheetId=' + encodeURIComponent(timesheetId)
        stateStyle = sheet.returned ? 'text-warning' : sheet.statusId === 'TmshApproved' ? 'text-positive' : 'm-muted'
    ]]></script></actions>

    <widgets>
        <section name="TimesheetNotFound" condition="!recordFound"><widgets>
            <container-box type="warning"><box-header title="Not available"/><box-body>
                <label type="p" text="Timesheet ${timesheetId} is not available: it does not exist, or it is not yours or one you approve."/>
                <link url="../Timesheets" link-type="anchor" text="Back to the timesheets"/>
            </box-body></container-box>
        </widgets></section>

        <section name="TimesheetFound" condition="recordFound"><widgets>
            <context record-entity="mantle.work.time.Timesheet" record-id="${timesheetId}" title="${sheet.personName} · ${sheet.weekText}"/>
            <!-- the header card (style-guide §3.3): the person, the week and its state with the status-bar at their right, then the actions -->
            <container style="m-record-header">
                <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                    <container style="col-12 col-md m-record-title">
                        <container style="row items-center no-wrap">
                            <render-mode><text type="qvt"><![CDATA[<m-avatar name="${WebUtilities.encodeHtml(sheet.personName ?? '')}" size="32px" class="q-mr-sm"></m-avatar>]]></text><text type="tui" template="false">[]</text></render-mode>
                            <label text="${sheet.personName} · ${sheet.weekText}" type="h5"/>
                        </container>
                        <label text="${stateText}" type="div" style="text-caption ${stateStyle}" condition="stateText"/>
                        <!-- impl-people P24 (owner contract): a week a finalized pay input paid is not reopened -->
                        <label text="Paid by payroll: this week stays approved, and a correction pays any difference." type="div"
                                style="text-caption m-muted" condition="access.payrollPaid"/>
                    </container>
                    <container style="col-12 col-md-auto m-record-status">
                        <status-bar id="TimesheetStatusBar" status-id="${sheet.statusId}" status-flow-id="Default" stages="${stageStatusIds}" read-only="true"/>
                    </container>
                </container>
                <container style="row items-center q-col-gutter-x-md q-col-gutter-y-sm m-record-foot">
                    <container style="col-12 row items-center q-gutter-x-xs q-gutter-y-xs m-record-actions">
                        <link url="decide" link-type="hidden-form" btn-type="primary" text="Approve" icon="sym_o_task_alt" parameter-map="{timesheetId:timesheetId, action:'approve'}"
                                condition="access.canApprove"/>
                        <container-dialog id="TimesheetReturnDialog" button-text="Return" icon="sym_o_undo" width="480" title="Return the week" condition="access.canReturn">
                            <form-single name="ReturnWeek" transition="decide" focus-field="reason">
                                <field name="timesheetId"><default-field><hidden/></default-field></field>
                                <field name="action" from="'return'"><default-field><hidden/></default-field></field>
                                <field name="reason"><default-field title="What to change"><text-area rows="3" cols="50"/></default-field></field>
                                <field name="submitButton"><default-field title="Return"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                        <container-dialog id="TimesheetReopenDialog" button-text="Reopen" icon="sym_o_lock_open" width="480" title="Reopen the week" condition="access.canReopen">
                            <form-single name="ReopenWeek" transition="decide" focus-field="reason">
                                <field name="timesheetId"><default-field><hidden/></default-field></field>
                                <field name="action" from="'reopen'"><default-field><hidden/></default-field></field>
                                <field name="reason"><default-field title="Why (optional)"><text-area rows="3" cols="50"/></default-field></field>
                                <field name="submitButton"><default-field title="Reopen"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                        <link url="decide" link-type="hidden-form" btn-type="primary" text="Submit week" icon="sym_o_send" parameter-map="{timesheetId:timesheetId, action:'submit'}"
                                condition="access.canSubmit" confirmation="Submit the week? It is locked until its approver returns it."/>
                        <link url="${sheet.weekUrl}" url-type="plain" text="Open the week" icon="sym_o_calendar_view_week" link-type="anchor-button"/>
                        <link url="${printUrl}" url-type="plain" text="Print" icon="sym_o_print" target-window="_blank" link-type="anchor-button"/>
                    </container>
                </container>
            </container>

            <dashboard min-width="150" style="q-mb-sm">
                <number-card title="Hours" value="${sheet.hoursText}" icon="sym_o_schedule" size="sm"/>
                <number-card title="Billable" value="${sheet.billableText}" icon="sym_o_payments" size="sm"/>
                <number-card title="Working hours" value="${sheet.expectedText}" icon="sym_o_work_history" size="sm"/>
                <number-card title="Difference" value="${sheet.differenceText}" icon="sym_o_difference" size="sm"/>
            </dashboard>

            <container style="row q-col-gutter-sm">
                <container style="col-12 col-lg-8">
                    <container-box><box-header title="Entries by day · ${entryRowsCount}"/><box-body-nopad>
                        <form-list name="TimesheetEntries" list="entryRows" skip-form="true" paginate="false">
                            <field name="span"><default-field title="Day / time">
                                <label text="${isDay ? dayText : fromText + ' – ' + thruText}" type="span" style="${isDay ? 'text-weight-medium' : 'text-no-wrap text-caption'}"/></default-field></field>
                            <field name="workEffortName"><default-field title="Work item">
                                <section name="EntryItem" condition="!isDay"><widgets>
                                    <link url="${url}" url-type="plain" text="${workEffortId ? workEffortId + ' ' : ''}${workEffortName}" link-type="anchor" condition="url"/>
                                    <label text="${workEffortName}" type="span" condition="!url"/>
                                    <label text="${projectName}" type="div" style="text-caption m-muted" condition="projectName"/>
                                </widgets><fail-widgets>
                                    <label text="${holiday}" type="span" style="text-caption m-muted" condition="holiday"/>
                                    <label text="Below its hours" type="span" style="text-caption text-warning" condition="below"/>
                                </fail-widgets></section></default-field></field>
                            <field name="hoursText" align="right"><default-field title="Hours">
                                <label text="${hoursText}" type="span" style="${isDay ? 'text-weight-medium' : ''}"/></default-field></field>
                            <field name="workTypeLabel"><default-field title="Work type"><display/></default-field></field>
                            <field name="billableText"><default-field title="Billable">
                                <label text="${isDay ? '' : billableText}" type="span" style="${billable ? '' : 'm-muted'}"/></default-field></field>
                            <field name="comments"><default-field title="Comment"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="span"/><field-ref name="workEffortName"/></column>
                                <column><field-ref name="hoursText"/></column>
                            </columns>
                        </form-list>
                        <label type="p" text="No time this week." style="m-muted q-pa-sm q-mb-none" condition="!entryRows.length"/>
                    </box-body-nopad></container-box>

                    <container-row>
                        <row-col md="6">
                            <container-box><box-header title="By project"/><box-body-nopad>
                                <form-list name="TimesheetByProject" list="projectRows" skip-form="true" paginate="false">
                                    <field name="workEffortName"><default-field title="Work item">
                                        <label text="${workEffortId ? workEffortId + ' ' : ''}${workEffortName}" type="span"/>
                                        <label text="${projectName}" type="div" style="text-caption m-muted" condition="projectName &amp;&amp; workEffortId != rootWorkEffortId"/></default-field></field>
                                    <field name="hoursText" align="right"><default-field title="Hours"><display/></default-field></field>
                                    <field name="billableText" align="right"><default-field title="Billable"><display/></default-field></field>
                                </form-list>
                                <label type="p" text="No time this week." style="m-muted q-pa-sm q-mb-none" condition="!projectRows.length"/>
                            </box-body-nopad></container-box>
                        </row-col>
                        <row-col md="6">
                            <container-box><box-header title="Flags · ${flagRows.length}"/><box-body-nopad>
                                <form-list name="TimesheetFlags" list="flagRows" skip-form="true" skip-header="true" paginate="false">
                                    <field name="text"><default-field>
                                        <render-mode><text type="qvt"><![CDATA[<q-icon name="${icon}" size="xs" class="q-mr-sm text-warning"></q-icon>]]></text><text type="tui" template="false">[]</text></render-mode>
                                        <label text="${text}" type="span"/>
                                        <label text="${dayText}" type="div" style="text-caption m-muted" condition="dayText"/></default-field></field>
                                </form-list>
                                <label type="p" text="Nothing to look at." style="m-muted q-pa-sm q-mb-none" condition="!flagRows.length"/>
                            </box-body-nopad></container-box>
                            <container-box><box-header title="History"/><box-body-nopad>
                                <form-list name="TimesheetHistory" list="historyRows" skip-form="true" skip-header="true" paginate="false">
                                    <field name="change"><default-field><display/></default-field></field>
                                    <field name="byText"><default-field><display/></default-field></field>
                                    <field name="whenText" align="right"><default-field><display/></default-field></field>
                                </form-list>
                                <label type="p" text="Not submitted yet." style="m-muted q-pa-sm q-mb-none" condition="!historyRows.length"/>
                            </box-body-nopad></container-box>
                        </row-col>
                    </container-row>
                </container>
                <!-- Chatter, the return reasons and the answers, beside the boxes from 1440 px -->
                <container style="col-12 col-lg-4">
                    <chatter id="TimesheetChatter" record-entity="mantle.work.time.Timesheet" record-id="${timesheetId}" default-tab="log"/>
                </container>
            </container>
        </widgets></section>
    </widgets>
</screen>
