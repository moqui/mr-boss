<!-- IronStone Insights (design-insights §1): the root of the app for owners, management and authorized analysts. The root user
    group BOSS_INSIGHTS and the administrator group BOSS_INSIGHTS_ADMIN open it (data/BossSetupData.xml), as ADMIN does; the root
    grant opens navigation only, and each screen and service checks its own permission (ironstone.insights.ContextServices.get#Context
    resolves the organizations, capabilities, safe defaults and links for every subscreen) while the report engine checks its own
    artifacts. The menu of design §1.2 grows by phase: P1 builds Home's frame and P5 its panels, attention board and pins; P2 the dashboards (Dashboards, Library
    panels, Wall display, with Dashboard, DashboardEditor and PanelDetail hidden) and Report builder › Explore, each a mount of the
    framework's report screens (INS-04) whose links the reportLinks map here sends to Insights' own screens; Reports, Delivery and
    alerts, Business flows and Settings come with the phases that build their entries; P3 the business datasets under Report builder
    (Datasets, DatasetDetail, DatasetFields, DatasetView); P4 Reports (the report catalog) and Saved reports.
    P6 adds Report builder › Analysis (the author's), the hidden Drill (each panel's menu, reportLinks.drill) and the hidden
    Records mounts of the shared record screens, read only (design §10). P7 adds Delivery and alerts: Scheduled reports (the
    list, with the hidden ScheduledReportDetail and ReportDelivery: the framework's, by location, each transition reaching
    the report engine's operations as the viewer, which are granted to who may schedule, deliver to others and read
    deliveries) and Management digest (each transition reaching a service that checks the INSIGHTS_* permissions itself),
    every Insights user's to open; they replace the last copied screen (impl-insights F20). P8 adds Business alerts (the list, with the hidden AlertDetail: the framework's alert screens, each included at Insights' own location with the
    transitions Insights offers), every Insights user's to open for the alerts they receive, each change refused unless the
    policy below lets the user set an alert (INSIGHTS_AUTHOR or INSIGHTS_DISTRIBUTE: features.alert); a rule opens in
    AlertDetail (reportLinks.alertRule), never Tools' AlertRule with its contact points, and a panel's New alert rule is
    offered by the same feature. P9 adds Business flows: Flow map
    and Maps, with the hidden FlowMapEditor and ProcessStory, every Insights user's to open, each transition reaching
    ironstone.insights.FlowMapServices, which checks INSIGHTS_VIEW or INSIGHTS_FLOW_EDIT, the map's organization and its owner
    itself; ProcessStory serves Commons Knowledge only to a user whose own grants open it. P10 adds Settings (Settings, the
    organization's analytics defaults, and Data readiness, over Admin's readiness registry), every Insights user's to open, each
    transition reaching a service that checks its own permission (INSIGHTS_SETTINGS_EDIT; a refresh registration's own), and
    Assist: the prompts and the response action below, the insights-analyst skill (skill/insights-analyst.md) and the read tools
    of ironstone.insights.AssistServices (data/BossSetupData.xml), each run as the signed-in user. P11 adds the hidden WallDisplay,
    the page a registered wall display plays its playlist on (the INSIGHTS_PLAYLISTS route group admits it alone), whose
    request runs as the device's display account: get#Context is not called for it (below). The framework's report screens that
    need nothing of Insights' own are mounted by location (mr-moqui plans/archive/Admin-Screens-Down.md, Track I): Library panels here,
    Explore and Compare under Report builder, the three screens of Scheduled reports; they read the links and Insights' policy (reportPolicy: the default range, who may
    set an alert or share, the fixed parts of a dataset, a schedule and an alert) that the always-actions below set. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Insights" menu-image="sym_o_insights" menu-image-type="icon">

    <always-actions>
        <set field="appRoot" value="Insights"/>

        <service-call name="mantle.party.PartyServices.setup#UserOrganizationInfo" out-map="context"/>
        <!-- P11: a shared device's request (a wall display; its route group admits WallDisplay alone) runs as a display account,
            which is no Insights user and holds no root grant: it gets the defaults only, and no links -->
        <if condition="UserSecurityChecks.currentDevice()"><then>
            <set field="insights" from="{defaults: {from: 'now-30d', thru: 'now', currencyMode: 'native'}, sharedLinks: {}, reportLinks: {},
                    reportPolicy: {range: {from: 'now-30d', thru: 'now'}}}"/>
        </then><else>
            <service-call name="ironstone.insights.ContextServices.get#Context" in-map="{appRoot:appRoot}" out-map="insights"/>
            <!-- P12 (the P6 mount lesson): the Chatter and RecordFiles mounts below are served only to a user whose own grants
                open Commons, who reaches the same panels there under the same filters; this root's inheritable grant would
                otherwise open their notes, messages and files to a user given Insights without Commons. No Insights screen shows
                either panel but ProcessStory's Knowledge pages, which are themselves a Commons user's. -->
            <script><![CDATA[
                const pathNames = Array.from(sri.getScreenUrlInfo().fullPathNameList || []).map(String)
                const panelName = pathNames[pathNames.indexOf('Insights') + 1]
                if ((panelName === 'Chatter' || panelName === 'RecordFiles') &&
                        ec.service.sync().name('ironstone.insights.DrillServices.get#RecordPanelAccess').call()?.opens !== true)
                    throw new Error('RECORD_PANEL_UNAVAILABLE: Notes and files are kept in Commons, which is not available to you')
            ]]></script>
        </else></if>
        <set field="sharedLinks" from="insights.sharedLinks"/>
        <!-- where the framework report screens' links go under Insights (mr-moqui docs/tools/Monitoring.md, "Mounting the report
            screens"); in always-actions, so the mounted screens' transitions read it too -->
        <set field="reportLinks" from="insights.reportLinks"/>
        <!-- and Insights' policy for them, data only: a screen still asks its service, which decides -->
        <set field="reportPolicy" from="insights.reportPolicy"/>
        <!-- Tools' telemetry dashboards, which no Insights group reads, are not listed (design §4 Dashboards) -->
        <set field="reportHiddenComponents" from="['tools']"/>
    </always-actions>

    <subscreens default-item="Home" always-use-full-path="true">
        <!-- the record panels the chatter and record-files elements load under this app root, hidden from the menu
            (the theme values STRT_CHATTER_SCREEN and STRT_RECORD_FILES_SCREEN; impl-drawers-commons.md R5), served only to a
            user whose own grants open Commons (always-actions above, P12) -->
        <subscreens-item name="Chatter" location="component://mr-boss/screen/Shared/Chatter.xml" menu-include="false"/>
        <subscreens-item name="RecordFiles" location="component://mr-boss/screen/Shared/RecordFiles.xml" menu-include="false"/>
        <!-- the framework's Library panels (a preview of a panel as the viewer, over the dashboard list with the type fixed to
            panel), by location: no grant names it, it has no transition of an instance administrator's and Insights adds
            nothing. Its links go by reportLinks: a panel opens in PanelDetail, offered to authors only -->
        <subscreens-item name="Panels" location="component://tools/screen/Dashboards/Panels.xml" menu-title="Library panels" menu-index="3"/>
        <!-- the framework's CalcGrid (mr-moqui docs/tools/Database.md, CalcGrid and access profiles): spreadsheets over the
            relational database, by location: no grant names it and Insights adds nothing. What a viewer reads there is the
            access profile they hold (the sales profile for the Sales administrators: BossSetupData.xml), never this root's
            grant: the engine enters the profile before it reads, and a viewer who holds none is told so -->
        <subscreens-item name="CalcGrid" location="component://tools/screen/Dashboards/CalcGrid.xml" menu-title="CalcGrid" menu-index="13"/>
    </subscreens>

    <!-- the palette's dashboards, saved reports and flow maps (P4, P9, design §1.2), and Assist's prompts and response action
        (P10) -->
    <shell-providers>
        <palette-source group="Insights" label="Dashboards, saved reports and flow maps" icon="sym_o_insights"
                service="ironstone.insights.ContextServices.search#Records" sequence="62"/>
        <!-- g s: g i is Comms' global Inbox key, which a scope key would shadow under Insights -->
        <keymap scope="insights">
            <key keys="g s" label="Insights home" screen="Insights/Home"/>
            <key keys="g m" label="Flow map" screen="Insights/Flows/FlowMap"/>
        </keymap>
        <!-- P10 (design §1.2 "Assist and MCP analytics"): the insights-analyst skill answers each from the same authorized
            query as the page, as the user; "Add to my dashboard" saves an answer's query as the user's own library panel
            (Insights/AddToDashboard, an author's) -->
        <assist-prompt label="Explain this number" text="Explain this number: what it measures, its basis and scope, and what it leaves out"
                screen="Insights/Dashboard" sequence="10"/>
        <assist-prompt label="Compare with last period" text="Compare this with the period before, keeping currencies apart"
                screen="Insights" sequence="20"/>
        <assist-prompt label="Which source is stale?" text="Which source is stale, how far behind is it, and who can refresh it?"
                screen="Insights" sequence="30"/>
        <response-action label="Add to my dashboard" icon="sym_o_dashboard_customize" screen="Insights/AddToDashboard"
                text-parameter="answerText" sequence="40"/>
    </shell-providers>

    <widgets><subscreens-panel id="insights-panel" type="popup"/></widgets>
</screen>
