<!-- IronStone Insights (design-insights §1): the root of the app for owners, management and authorized analysts. The root user
    group BOSS_INSIGHTS and the administrator group BOSS_INSIGHTS_ADMIN open it (data/BossSetupData.xml), as ADMIN does; the root
    grant opens navigation only, and each screen and service checks its own permission (ironstone.insights.ContextServices.get#Context
    resolves the organizations, capabilities, safe defaults and links for every subscreen) while the report engine checks its own
    artifacts. The menu of design §1.2 grows by phase: P1 builds Home (a frame until P5); P2 the dashboards (Dashboards, Library
    panels, Wall display, with Dashboard, DashboardEditor and PanelDetail hidden) and Report builder › Explore, each a mount of the
    framework's report screens (INS-04) whose links the reportLinks map here sends to Insights' own screens; Reports, Delivery and
    alerts, Business flows and Settings come with the phases that build their entries; P3 the business datasets under Report builder
    (Datasets, DatasetDetail, DatasetFields, DatasetView); P4 Reports (the report catalog) and Saved reports. Until P7 replaces it,
    the copied ScheduledReports screen stays open only to BOSS_INSIGHTS_ADMIN and ADMIN (impl-insights F20; BOSS_INS_LEGACY denies
    it to the root user group). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Insights" menu-image="sym_o_insights" menu-image-type="icon">

    <always-actions>
        <set field="appRoot" value="Insights"/>

        <service-call name="mantle.party.PartyServices.setup#UserOrganizationInfo" out-map="context"/>
        <service-call name="ironstone.insights.ContextServices.get#Context" in-map="{appRoot:appRoot}" out-map="insights"/>
        <set field="sharedLinks" from="insights.sharedLinks"/>
        <!-- where the framework report screens' links go under Insights (mr-moqui docs/tools/Monitoring.md, "Mounting the report
            screens"); in always-actions, so the mounted screens' transitions read it too -->
        <set field="reportLinks" from="insights.reportLinks"/>
        <!-- Tools' telemetry dashboards, which no Insights group reads, are not listed (design §4 Dashboards) -->
        <set field="reportHiddenComponents" from="['tools']"/>
    </always-actions>

    <subscreens default-item="Home" always-use-full-path="true">
        <!-- the record panels the chatter and record-files elements load under this app root, hidden from the menu
            (the theme values STRT_CHATTER_SCREEN and STRT_RECORD_FILES_SCREEN; impl-drawers-commons.md R5) -->
        <subscreens-item name="Chatter" location="component://mr-boss/screen/Shared/Chatter.xml" menu-include="false"/>
        <subscreens-item name="RecordFiles" location="component://mr-boss/screen/Shared/RecordFiles.xml" menu-include="false"/>
    </subscreens>

    <!-- the palette's dashboards and saved reports (P4, design §1.2); flow maps, quick create (Dashboard, Analysis, Schedule by
        capability), the Assist prompts and response action arrive with their records and screens (P7, P9, P10) -->
    <shell-providers>
        <palette-source group="Insights" label="Dashboards and saved reports" icon="sym_o_insights"
                service="ironstone.insights.ContextServices.search#Records" sequence="62"/>
        <!-- g s: g i is Comms' global Inbox key, which a scope key would shadow under Insights -->
        <keymap scope="insights">
            <key keys="g s" label="Insights home" screen="Insights/Home"/>
        </keymap>
    </shell-providers>

    <widgets><subscreens-panel id="insights-panel" type="popup"/></widgets>
</screen>
