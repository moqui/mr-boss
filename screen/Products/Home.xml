<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Home" default-menu-index="1" menu-image="sym_o_dashboard" menu-image-type="icon">
    <!-- the catalog landing (style-guide §3.1, design-products Home): counts that open their filtered lists, the shortcuts,
        recent products and the user's catalog tasks -->
    <actions>
        <service-call name="ironstone.products.CatalogServices.get#CatalogSummary" out-map="context"/>
        <service-call name="ironstone.products.CatalogServices.get#CatalogAccess" out-map="access"/>
        <set field="canImport" from="access.capabilities.catalogEdit || access.capabilities.priceEdit || access.capabilities.supplierPriceEdit"/>
        <set field="emptyCatalog" from="!summary.total"/>
        <set field="catalogTimeZone" from="String(ec.user.timeZone?.getID?.() || ec.user.timeZone || 'UTC')"/>
        <script><![CDATA[
            const count = value => (value == null ? '—' : ec.l10n.format(value, '#,##0'))
            counts = {active: count(summary.active), variants: count(summary.variants), missingPrice: count(summary.missingPrice),
                discontinuingSoon: count(summary.discontinuingSoon), incomplete: count(summary.incomplete)}
        ]]></script>
    </actions>
    <widgets>
        <section name="EmptyCatalog" condition="emptyCatalog">
            <widgets>
                <container-box type="info">
                    <box-header title="No products yet"/>
                    <box-body>
                        <label text="Create the first product, or import a catalog from a spreadsheet." type="p"/>
                        <container style="row q-gutter-sm">
                            <link url="../Products/NewProduct" text="Create product" link-type="anchor-button" btn-type="primary" icon="sym_o_add" condition="access.capabilities.catalogEdit"/>
                            <link url="../ProductImport" text="Import catalog" link-type="anchor-button" icon="sym_o_upload_file" condition="canImport"/>
                        </container>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <dashboard min-width="150" style="q-mb-sm">
            <number-card title="Active SKUs" value="${counts.active}" icon="sym_o_inventory_2" size="sm" link="/qapps/Products/Products?list=activeSkus"/>
            <number-card title="Variants" value="${counts.variants}" icon="sym_o_style" size="sm" link="/qapps/Products/Products?list=variants"/>
            <number-card title="Missing price" value="${counts.missingPrice}" icon="sym_o_sell" size="sm" link="/qapps/Products/Products?list=missingPrice"
                    condition="summary.missingPrice != null"/>
            <number-card title="Ending soon" value="${counts.discontinuingSoon}" icon="sym_o_event_busy" size="sm"
                    link="/qapps/Products/Products?list=discontinuingSoon"/>
            <number-card title="Incomplete" value="${counts.incomplete}" icon="sym_o_rule" size="sm"
                    link="/qapps/Products/CatalogChecks?runChecks=true&amp;checkIds=requiredFields&amp;severity=error"/>
        </dashboard>
        <label text="As of ${summary.asOf} (${catalogTimeZone}). Ending soon: sales discontinuation within 30 days." type="p" style="text-caption m-muted"/>
        <container-row>
            <row-col lg="8" md="7">
                <container-box>
                    <box-header title="Recently changed"/>
                    <box-body-nopad>
                        <form-list name="RecentProducts" list="recentProducts" skip-form="true" skip-header="true" paginate="false">
                            <field name="productId">
                                <default-field>
                                    <link url="../Products/Product360" text="${productName || productId}" parameter-map="{productId:productId}" link-type="anchor"/>
                                </default-field>
                            </field>
                            <field name="productTypeEnumId">
                                <default-field>
                                    <display-entity entity-name="moqui.basic.Enumeration"/>
                                </default-field>
                            </field>
                            <field name="lastUpdatedStamp">
                                <default-field>
                                    <display text="${lastUpdatedStampText || ''}" style="m-muted"/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="productId"/></column>
                                <column><field-ref name="lastUpdatedStamp"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </row-col>
            <row-col lg="4" md="5">
                <container-box>
                    <box-header title="Shortcuts"/>
                    <box-body>
                        <container style="row q-gutter-sm">
                            <link url="../Products/NewProduct" text="Create product" link-type="anchor-button" btn-type="primary" icon="sym_o_add" condition="access.capabilities.catalogEdit"/>
                            <link url="../ProductImport" text="Import catalog" link-type="anchor-button" icon="sym_o_upload_file" condition="canImport"/>
                            <link url="../Products" text="Products" link-type="anchor-button" icon="sym_o_inventory_2"/>
                            <link url="../Categories" text="Categories" link-type="anchor-button" icon="sym_o_category"/>
                            <link url="../Features" text="Features" link-type="anchor-button" icon="sym_o_style"/>
                            <link url="../Prices/PriceLists" text="Price lists" link-type="anchor-button" icon="sym_o_list_alt" condition="access.capabilities.priceRead || access.capabilities.supplierPriceRead"/>
                            <link url="../SupplierPrices" text="Supplier prices" link-type="anchor-button" icon="sym_o_local_shipping" condition="access.capabilities.supplierPriceRead"/>
                        </container>
                    </box-body>
                </container-box>
                <container-box>
                    <box-header title="My catalog tasks"/>
                    <box-body-nopad>
                        <form-list name="MyActivities" list="activityRows" skip-form="true" skip-header="true" paginate="false">
                            <field name="workEffortId">
                                <default-field>
                                    <link url="//Commons/Tasks/TaskDetail" text="${workEffortName || workEffortId}" parameter-map="{workEffortId:workEffortId}" link-type="anchor"/>
                                </default-field>
                            </field>
                            <field name="estimatedCompletionDate">
                                <default-field>
                                    <display format="yyyy-MM-dd" style="m-muted"/>
                                </default-field>
                            </field>
                        </form-list>
                        <label text="No catalog tasks are assigned to you." type="p" style="q-pa-md m-muted" condition="!activityRows?.length"/>
                    </box-body-nopad>
                </container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
