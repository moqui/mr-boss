<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Variant settings" default-menu-index="2">
    <parameter name="organizationPartyId"/>
    <parameter name="asOfDate"/>
    <transition name="save">
        <actions>
            <service-call name="mantle.product.ProductServices.store#VariantSettings" in-map="{organizationPartyId:organizationPartyId,expectedFromDate:expectedFromDate,fromDate:effectiveFromDate,changeReason:changeReason,settings:{batchLimit:batchLimit,copyFields:copyFields,copyCategoryMembers:copyCategoryMembers,identifierPattern:identifierPattern}}"/>
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId"/>
            <parameter name="asOfDate" from="''"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="ironstone.products.CatalogServices.get#CatalogAccess" out-map="access"/>
        <service-call name="mantle.product.ProductServices.get#VariantSettings" in-map="context" out-map="context"/>
        <set field="expectedFromDate" from="fromDate"/>
        <set field="copyFields" from="settings.copyFields"/>
        <set field="batchLimit" from="String(settings.batchLimit)"/>
        <set field="copyCategoryMembers" from="settings.copyCategoryMembers ? 'Y' : 'N'"/>
        <set field="identifierPattern" from="settings.identifierPattern"/>
        <entity-find-one entity-name="mantle.party.Organization" value-field="organization" cache="true">
            <field-map field-name="partyId" from="organizationPartyId"/>
        </entity-find-one>
        <set field="organizationName" from="organization?.organizationName || organizationPartyId || ''"/>
    </actions>
    <widgets>
        <container-box>
            <box-header title="Variant policy"/>
            <box-body>
                <label text="${organizationName}" type="p"/>
                <label text="Changes take effect on their start date. Each save ends the prior policy and preserves its history." type="p"/>
                <section name="Administrator" condition="access.capabilities.catalogAdmin">
                    <widgets>
                        <form-single name="VariantPolicy" transition="save">
                            <field name="organizationPartyId">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="expectedFromDate">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="effectiveFromDate">
                                <default-field title="Effective from" tooltip="Leave empty to start now">
                                    <date-time/>
                                </default-field>
                            </field>
                            <field name="batchLimit">
                                <default-field title="Interactive batch limit" tooltip="1–1000">
                                    <text-line input-type="number"/>
                                </default-field>
                            </field>
                            <field name="copyFields">
                                <default-field title="Allowed copy fields">
                                    <check>
                                        <list-options list="copyFieldOptions" key="${value}" text="${label}"/>
                                    </check>
                                </default-field>
                            </field>
                            <field name="copyCategoryMembers">
                                <default-field title="Permit category copying">
                                    <drop-down>
                                        <option key="Y" text="Yes"/>
                                        <option key="N" text="No"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="identifierPattern">
                                <default-field title="Identifier pattern">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="changeReason">
                                <default-field title="Reason">
                                    <text-line/>
                                </default-field>
                            </field>
                            <field name="submitButton">
                                <default-field title="Save policy">
                                    <submit/>
                                </default-field>
                            </field>
                        </form-single>
                    </widgets>
                    <fail-widgets>
                        <label text="Only a catalog administrator changes the variant policy." type="p"/>
                    </fail-widgets>
                </section>
                <label text="Identity, prices, costs and transaction data cannot be copied. Existing variants keep their overrides." type="p"/>
            </box-body>
        </container-box>
        <container-box>
            <box-header title="Policy history"/>
            <box-body>
                <form-list name="VariantPolicyHistory" list="history" skip-form="true" paginate="false">
                    <field name="fromDate">
                        <default-field title="Effective from">
                            <display/>
                        </default-field>
                    </field>
                    <field name="thruDate">
                        <default-field title="Through">
                            <display/>
                        </default-field>
                    </field>
                    <field name="batchLimit">
                        <default-field title="Batch limit">
                            <display/>
                        </default-field>
                    </field>
                    <field name="copyFields">
                        <default-field title="Copy fields">
                            <display/>
                        </default-field>
                    </field>
                    <field name="changeReason">
                        <default-field title="Reason">
                            <display/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column><field-ref name="fromDate"/></column>
                        <column><field-ref name="thruDate"/></column>
                    </columns>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
