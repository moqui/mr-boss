<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Pricing settings" default-menu-index="3">
    <parameter name="organizationPartyId"/>
    <parameter name="asOfDate"/>
    <transition name="save">
        <actions>
            <service-call name="mantle.product.PriceServices.store#PricingSettings" in-map="context"/>
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId"/>
            <parameter name="asOfDate" from="''"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="ironstone.products.PriceListServices.get#PriceListOptions" out-map="context"/>
        <service-call name="mantle.product.PriceServices.get#PricingSettings" in-map="context" out-map="policy"/>
        <set field="organizationPartyId" from="policy.organizationPartyId"/>
        <set field="settings" from="Object.assign({},policy.settings,{organizationPartyId:policy.organizationPartyId,expectedFromDate:policy.fromDate,fromDate:null})"/>
        <set field="settings.roundingIncrement" from="settings.roundingIncrement == null ? null : String(settings.roundingIncrement)"/>
    </actions>
    <widgets>
        <container-box>
            <box-header title="Organization pricing defaults"/>
            <box-body>
                <label text="Defaults suggest values for new prices. Dated changes preserve the earlier policy. Valuation and posting settings are maintained in Accounting." type="p"/>
                <form-single name="PricingPolicy" transition="save" map="settings">
                    <field name="organizationPartyId">
                        <default-field title="Organization">
                            <drop-down allow-empty="false">
                                <list-options list="pricingOptions.organizations" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="expectedFromDate">
                        <default-field>
                            <hidden/>
                        </default-field>
                    </field>
                    <field name="defaultPriceListId">
                        <default-field title="Default sales list">
                            <drop-down allow-empty="true">
                                <list-options list="pricingOptions.lists" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="defaultCurrencyUomId">
                        <default-field title="Default currency">
                            <drop-down allow-empty="false">
                                <list-options list="pricingOptions.currencies" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="defaultPurposeEnumId">
                        <default-field title="Default purpose">
                            <drop-down allow-empty="false">
                                <list-options list="pricingOptions.purposes" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="allowedPurposeIds">
                        <default-field title="Permitted purpose IDs" tooltip="Separate several with commas">
                            <text-line/>
                        </default-field>
                    </field>
                    <field name="roundingIncrement">
                        <default-field title="Default rounding increment">
                            <text-line input-type="number"/>
                        </default-field>
                    </field>
                    <field name="fromDate">
                        <default-field title="Effective from" tooltip="Leave empty to start now">
                            <date-time/>
                        </default-field>
                    </field>
                    <field name="changeReason">
                        <default-field title="Reason">
                            <text-line/>
                        </default-field>
                    </field>
                    <field name="submitButton">
                        <default-field title="Save dated pricing policy">
                            <submit/>
                        </default-field>
                    </field>
                </form-single>
            </box-body>
        </container-box>
    </widgets>
</screen>
