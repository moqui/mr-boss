<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Price history" default-menu-index="4">
    <parameter name="productId"/>
    <parameter name="productPriceId"/>
    <parameter name="organizationPartyId"/>
    <parameter name="direction"/>
    <parameter name="priceUomId"/>
    <parameter name="fromDate"/>
    <parameter name="thruDate"/>
    <actions>
        <service-call name="ironstone.products.CatalogServices.get#CatalogAccess" out-map="access"/>
        <service-call name="ironstone.products.CatalogServices.get#PriceOptions" out-map="context"/>
        <set field="auditRows" from="[]"/>
        <set field="statisticsRows" from="[]"/>
        <set field="statisticsMessage" value="Choose a product, organization, currency and direction to see transaction statistics."/>
        <set field="organizationPartyId" from="organizationPartyId || defaultOrganizationPartyId"/>
        <set field="direction" from="direction || (access.capabilities.priceRead ? 'sales' : access.capabilities.supplierPriceRead ? 'purchase' : 'sales')"/>
        <if condition="access.capabilities.priceRead || access.capabilities.supplierPriceRead">
            <service-call name="mantle.product.PriceServices.get#PricingSettings" in-map="{organizationPartyId:organizationPartyId}" out-map="historyPricingPolicy"/>
        </if>
        <set field="priceUomId" from="priceUomId || historyPricingPolicy?.settings?.defaultCurrencyUomId || ec.user.userAccount?.currencyUomId || null"/>
        <if condition="productId">
            <service-call name="ironstone.products.CatalogServices.get#PriceAudit" in-map="context" out-map="context"/>
            <if condition="direction === 'sales' ? access.capabilities.priceRead : access.capabilities.supplierPriceRead">
                <service-call name="ironstone.products.CatalogServices.get#TransactionPriceStatistics" in-map="context" out-map="context"/>
            </if>
        </if>
        <if condition="statisticsRows.length">
            <service-call name="ironstone.projects.ReportServices.get#ChartConfig" disable-authz="true" in-map="{id:'PriceStatisticsChart',labels:['Minimum','Weighted average','Maximum'],series:[{name:'Unit price',data:[statisticsRows[0].unitAmountMin,statisticsRows[0].weightedAmountAvg,statisticsRows[0].unitAmountMax]}],yTitle:priceUomId}" out-map="priceChart"/>
            <set field="chartHtml" from="priceChart.html"/>
            <set field="chartTui" from="priceChart.tui"/>
        </if>
    </actions>
    <widgets>
        <container-box>
            <box-header title="History scope"/>
            <box-body>
                <form-single name="PriceHistoryFind" transition=".">
                    <field name="productId">
                        <default-field title="Product ID">
                            <text-line/>
                        </default-field>
                    </field>
                    <field name="productPriceId">
                        <default-field title="Price row ID">
                            <text-line/>
                        </default-field>
                    </field>
                    <field name="organizationPartyId">
                        <default-field title="Organization">
                            <drop-down allow-empty="false">
                                <list-options list="priceOptions.organizations" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="direction">
                        <default-field title="Direction">
                            <drop-down>
                                <option key="sales" text="Sales"/>
                                <option key="purchase" text="Supplier offers"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="priceUomId">
                        <default-field title="Currency">
                            <drop-down allow-empty="false">
                                <list-options list="priceOptions.currencies" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="fromDate">
                        <default-field title="From">
                            <date-time/>
                        </default-field>
                    </field>
                    <field name="thruDate">
                        <default-field title="Through">
                            <date-time/>
                        </default-field>
                    </field>
                    <field name="submitButton">
                        <default-field title="Find history">
                            <submit/>
                        </default-field>
                    </field>
                    <field-layout>
                        <field-row-big><field-ref name="productId"/><field-ref name="productPriceId"/><field-ref name="organizationPartyId"/><field-ref name="direction"/><field-ref name="priceUomId"/><field-ref name="fromDate"/><field-ref name="thruDate"/><field-ref name="submitButton"/></field-row-big>
                        <fields-not-referenced/>
                    </field-layout>
                </form-single>
            </box-body>
        </container-box>
        <container-box>
            <box-header title="Price changes"/>
            <box-body>
                <section name="RestrictedEarlierPriceHistory" condition="historyRestricted">
                    <widgets>
                        <label text="Some earlier changes are outside your current permissions." type="p"/>
                    </widgets>
                </section>
                <form-list name="PriceChanges" list="auditRows" skip-form="true" paginate="false">
                    <field name="changedDateText">
                        <default-field title="When">
                            <display/>
                        </default-field>
                    </field>
                    <field name="changedByUserId">
                        <default-field title="Actor">
                            <display/>
                        </default-field>
                    </field>
                    <field name="productPriceId">
                        <default-field title="Price row">
                            <display/>
                        </default-field>
                    </field>
                    <field name="direction">
                        <default-field title="Direction">
                            <display/>
                        </default-field>
                    </field>
                    <field name="fieldLabel">
                        <default-field title="Field">
                            <display/>
                        </default-field>
                    </field>
                    <field name="oldDisplay">
                        <default-field title="Before">
                            <display/>
                        </default-field>
                    </field>
                    <field name="newDisplay">
                        <default-field title="After">
                            <display/>
                        </default-field>
                    </field>
                    <field name="changeReason">
                        <default-field title="Reason">
                            <display/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column><field-ref name="changedDateText"/></column>
                        <column><field-ref name="changedByUserId"/></column>
                    </columns>
                </form-list>
            </box-body>
        </container-box>
        <container-box>
            <box-header title="Transacted order prices"/>
            <box-body>
                <label text="${statisticsMessage}" type="p"/>
                <section name="PriceStatisticsChart" condition="statisticsRows.length">
                    <widgets>
                        <render-mode>
                            <text type="qvt"><![CDATA[${chartHtml}]]></text>
                            <text type="tui"><![CDATA[${JSON.stringify(chartTui)}]]></text>
                        </render-mode>
                    </widgets>
                </section>
                <form-list name="TransactionPriceStatistics" list="statisticsRows" skip-form="true" paginate="false">
                    <field name="productId">
                        <default-field title="Product">
                            <display/>
                        </default-field>
                    </field>
                    <field name="organizationPartyId">
                        <default-field title="Organization">
                            <display-entity entity-name="mantle.party.PartyDetail" text="PartyNameTemplate"/>
                        </default-field>
                    </field>
                    <field name="direction">
                        <default-field title="Direction">
                            <display/>
                        </default-field>
                    </field>
                    <field name="priceUomId">
                        <default-field title="Currency">
                            <display/>
                        </default-field>
                    </field>
                    <field name="orderQuantitySum">
                        <default-field title="Quantity">
                            <display/>
                        </default-field>
                    </field>
                    <field name="unitAmountMin">
                        <default-field title="Minimum unit price">
                            <display/>
                        </default-field>
                    </field>
                    <field name="unitAmountMax">
                        <default-field title="Maximum unit price">
                            <display/>
                        </default-field>
                    </field>
                    <field name="weightedAmountAvg">
                        <default-field title="Weighted unit price">
                            <display/>
                        </default-field>
                    </field>
                    <field name="weightedAmountSum">
                        <default-field title="Total amount">
                            <display/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column><field-ref name="productId"/></column>
                        <column><field-ref name="organizationPartyId"/></column>
                    </columns>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
