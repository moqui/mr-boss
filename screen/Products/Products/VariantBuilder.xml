<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Build variants" default-menu-include="false" render-modes="vue,qvue,tui,html" server-static="vue,qvue">
    <parameter name="productId"/>
    <transition name="preview" method="get" read-only="true">
        <actions>
            <script>const answer = ec.service.sync().name('ironstone.products.VariantServices.preview#VariantProducts').parameters(context).call() || {}
                ec.web.sendJsonResponse(ec.message.hasError() ? {} : answer)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition name="generate" method="post">
        <actions>
            <script>const answer = ec.service.sync().name('ironstone.products.VariantServices.create#VariantProducts').parameters(context).call() || {}
                ec.web.sendJsonResponse(ec.message.hasError() ? {} : answer)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition name="queue" method="post">
        <actions>
            <script>const answer = ec.service.sync().name('ironstone.products.VariantServices.start#VariantBatch').parameters(context).call() || {}
                ec.web.sendJsonResponse(ec.message.hasError() ? {} : answer)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition name="batch" method="get" read-only="true">
        <actions>
            <script>const answer = ec.service.sync().name('ironstone.products.VariantServices.get#VariantBatch').parameters(context).call() || {}
                ec.web.sendJsonResponse(ec.message.hasError() ? {} : answer)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition name="run" method="post">
        <actions>
            <script>const answer = ec.service.sync().name('ironstone.products.VariantServices.run#VariantBatch').parameters(context).call() || {}
                ec.web.sendJsonResponse(ec.message.hasError() ? {} : answer)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition-include name="choices" location="component://mr-boss/template/CatalogChoiceTransitions.xml"/>
    <widgets>
        <render-mode>
            <text type="qvue" location="component://mr-boss/screen/Products/Products/VariantBuilder.qvue" template="false"/>
            <text type="tui"><![CDATA[${JSON.stringify([{t:'dynamicContainer',id:'VariantBuilderTui',url:sri.buildUrl('../VariantBuilderTui').addParameters({productId:productId||null}).getUrlWithParams()}])}]]></text>
            <text type="html,qvt"><![CDATA[<p><a href="${sri.buildUrl('../VariantBuilderTui').addParameters({productId:productId||null}).getUrlWithParams()}">Open variant setup and combination list</a></p>]]></text>
        </render-mode>
    </widgets>
</screen>
