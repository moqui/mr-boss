<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Products" default-menu-include="false">
    <parameter name="text"/>
    <parameter name="keyword"/>
    <parameter name="ownerPartyId"/>
    <parameter name="pageIndex"/>
    <parameter name="pageSize"/>
    <parameter name="list"/>
    <parameter name="productTypeEnumId"/>
    <parameter name="productClassEnumId"/>
    <parameter name="statusId"/>
    <parameter name="categoryIds"/>
    <parameter name="tagIds"/>
    <parameter name="categoryOperator"/>
    <parameter name="productFeatureId"/>
    <parameter name="idValue"/>
    <parameter name="partyItemId"/>
    <transition name="productDetail">
        <default-response url="../Product360"/>
    </transition>
    <!-- the selected products open the price change review, which previews before anything changes. The action makes
        this a posted form (a transition with none is a link), so the selected rows go with it. -->
    <transition name="bulkPrice">
        <actions>
            <set field="productIds" from="Array.isArray(productIds) ? productIds.join(',') : productIds"/>
        </actions>
        <default-response url="../BulkPrice">
            <parameter name="productIds"/>
            <parameter name="direction"/>
        </default-response>
    </transition>
    <transition name="bulk">
        <actions>
            <service-call name="ironstone.products.CatalogServices.bulk#Products" in-map="context" out-map="bulkOut"/>
            <script><![CDATA[
            // The outcome survives the redirect as messages: one summary and one line per product that failed.
            const failed = (bulkOut.results || []).filter(row => row.status === 'error')
            ec.message.addMessage(ec.resource.expand(ec.l10n.localize('${successCount} products updated, ${failedCount} failed'), '', bulkOut), failed.length ? 'warning' : 'success')
            for (const row of failed) ec.message.addMessage(row.productId + ': ' + row.error, 'warning')
            ]]></script>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="ironstone.products.CatalogServices.get#CatalogAccess" out-map="access"/>
        <service-call name="ironstone.products.CategoryServices.get#CategoryOptions" out-map="context"/>
        <if condition="['csv','xlsx'].includes(sri.getRenderMode())">
            <then><script><![CDATA[
                const found = ec.service.sync().name('ironstone.products.CatalogServices.find#Products').parameters(context).call() || {}
                if (ec.message.hasError()) {
                    if (sri.getRenderMode() === 'xlsx') ec.web.sendJsonResponse({})
                    else ec.web.response.setStatus(500)
                    ec.context.putAll({productList: [], productListCount: 0})
                }
                else ec.context.putAll(found)
            ]]></script></then>
            <else><service-call name="ironstone.products.CatalogServices.find#Products" in-map="context" out-map="context"/></else>
        </if>
        <set field="productListPageIndex" from="pageIndex"/>
        <set field="productListPageSize" from="pageSize"/>
        <set field="productListPageMaxIndex" from="Math.max(0, Math.ceil(productListCount / pageSize) - 1)"/>
        <set field="productListPageRangeLow" from="productList.length ? pageIndex * pageSize + 1 : 0"/>
        <set field="productListPageRangeHigh" from="productList.length ? pageIndex * pageSize + productList.length : 0"/>
        <!-- the curated finds as chips, the one in force highlighted (a Home card opens one of them) -->
        <script><![CDATA[
            const lists = [['', 'All'], ['activeSkus', 'Active'], ['virtual', 'Virtual'], ['variants', 'Variants'], ['services', 'Services'],
                ['stocked', 'Stocked'], ['discontinuingSoon', 'Discontinuing soon'], ['discontinued', 'Discontinued'], ['missingPrice', 'Missing price']]
            listChips = lists.map(([key, label]) => ({label: ec.l10n.localize(label), on: (list || '') === key, params: {list: key}}))
            bulkPriceDirections = []
            if (access.capabilities.priceEdit) bulkPriceDirections.push({value: 'sales', label: 'Sales prices'})
            if (access.capabilities.supplierPriceEdit) bulkPriceDirections.push({value: 'purchase', label: 'Supplier offers'})
        ]]></script>
    </actions>
    <widgets>
        <context title="Products" selection-form="ProductList"/>
        <container style="row items-center q-gutter-sm">
            <link url="../NewProduct" text="Create product" link-type="anchor-button" btn-type="primary" icon="sym_o_add" condition="access.capabilities.catalogEdit"/>
            <section-iterate name="ListChip" list="listChips" entry="chip">
                <widgets>
                    <section name="ListChipOn" condition="chip.on">
                        <widgets>
                            <link url="." link-type="anchor-button" btn-type="primary" text="${chip.label}" parameter-map="chip.params"/>
                        </widgets>
                        <fail-widgets>
                            <link url="." link-type="anchor-button" text="${chip.label}" parameter-map="chip.params"/>
                        </fail-widgets>
                    </section>
                </widgets>
            </section-iterate>
        </container>
        <section name="SearchMessage" condition="searchMessage">
            <widgets>
                <label text="${searchMessage}" type="p"/>
            </widgets>
        </section>
        <container-box>
            <box-header title="Products"/>
            <box-body-nopad>
                <form-list name="ProductList" list="productList" skip-form="true" paginate="true" header-dialog="true" saved-finds="true" views="list,board" show-csv-button="true" show-xlsx-button="true" select-columns="true">
                    <row-selection id-field="productId" parameter="productIds" list-mode="true" condition="access.capabilities.catalogEdit || access.capabilities.priceEdit || access.capabilities.supplierPriceEdit">
                        <action condition="access.capabilities.catalogEdit">
                            <dialog button-text="Category" title="Update selected product IDs"/>
                            <form-single name="BulkCategory" transition="bulk">
                                <field name="kind" from="'category'">
                                    <default-field>
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="operation">
                                    <default-field title="Action">
                                        <drop-down allow-empty="true">
                                            <option key="store" text="Apply"/>
                                            <option key="expire" text="End existing row"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="productCategoryId">
                                    <default-field title="Category">
                                        <drop-down allow-empty="true">
                                            <list-options list="options.categories" key="${value}" text="${label}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="fromDate">
                                    <default-field title="Existing start" tooltip="Required to end a row">
                                        <date-time/>
                                    </default-field>
                                </field>
                                <field name="thruDate">
                                    <default-field title="Through">
                                        <date-time/>
                                    </default-field>
                                </field>
                                <field name="submitButton">
                                    <default-field title="Save">
                                        <submit/>
                                    </default-field>
                                </field>
                            </form-single>
                        </action>
                        <action condition="access.capabilities.catalogEdit">
                            <dialog button-text="Feature" title="Update selected product IDs"/>
                            <form-single name="BulkFeature" transition="bulk">
                                <field name="kind" from="'feature'">
                                    <default-field>
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="operation">
                                    <default-field title="Action">
                                        <drop-down allow-empty="true">
                                            <option key="store" text="Apply"/>
                                            <option key="expire" text="End existing row"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="productFeatureId">
                                    <default-field title="Feature">
                                        <drop-down allow-empty="true">
                                            <list-options list="options.features" key="${value}" text="${label}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="applTypeEnumId">
                                    <default-field title="Application">
                                        <drop-down allow-empty="true">
                                            <option key="PfatStandard" text="Standard"/>
                                            <option key="PfatSelectable" text="Selectable"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="fromDate">
                                    <default-field title="Existing start" tooltip="Required to end a row">
                                        <date-time/>
                                    </default-field>
                                </field>
                                <field name="thruDate">
                                    <default-field title="Through">
                                        <date-time/>
                                    </default-field>
                                </field>
                                <field name="submitButton">
                                    <default-field title="Save">
                                        <submit/>
                                    </default-field>
                                </field>
                            </form-single>
                        </action>
                        <action condition="access.capabilities.priceEdit || access.capabilities.supplierPriceEdit">
                            <dialog button-text="Prices" button-icon="sym_o_sell" title="Change prices of the selected products"/>
                            <form-single name="BulkPriceStart" transition="bulkPrice">
                                <field name="direction">
                                    <default-field title="Prices to change">
                                        <drop-down allow-empty="false">
                                            <list-options list="bulkPriceDirections" key="${value}" text="${label}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="note">
                                    <default-field title="">
                                        <label text="The next page previews every change before any price is saved." type="p" style="m-muted"/>
                                    </default-field>
                                </field>
                                <field name="submitButton">
                                    <default-field title="Review price changes">
                                        <submit/>
                                    </default-field>
                                </field>
                            </form-single>
                        </action>
                    </row-selection>
                    <field name="findButton">
                        <header-field title="Find"><submit/></header-field>
                        <default-field><ignored/></default-field>
                    </field>
                    <field name="text">
                        <header-field title="ID or name">
                            <text-line/>
                        </header-field>
                        <default-field>
                            <ignored/>
                        </default-field>
                    </field>
                    <field name="keyword">
                        <header-field title="Keyword">
                            <text-line/>
                        </header-field>
                        <default-field>
                            <ignored/>
                        </default-field>
                    </field>
                    <field name="partyItemId">
                        <header-field title="Party item code">
                            <text-line/>
                        </header-field>
                        <default-field>
                            <ignored/>
                        </default-field>
                    </field>
                    <field name="idValue">
                        <header-field title="Exact identifier">
                            <text-line/>
                        </header-field>
                        <default-field>
                            <ignored/>
                        </default-field>
                    </field>
                    <field name="tagIds">
                        <header-field title="Tags">
                            <drop-down allow-empty="true" allow-multiple="true">
                                <list-options list="options.tags" key="${value}" text="${label}"/>
                            </drop-down>
                        </header-field>
                        <default-field>
                            <ignored/>
                        </default-field>
                    </field>
                    <field name="categoryIds">
                        <header-field title="Categories">
                            <drop-down allow-empty="true" allow-multiple="true">
                                <list-options list="options.categories" key="${value}" text="${label}"/>
                            </drop-down>
                        </header-field>
                        <default-field>
                            <ignored/>
                        </default-field>
                    </field>
                    <field name="categoryOperator">
                        <header-field title="Category match">
                            <drop-down allow-empty="true">
                                <option key="AND" text="All categories"/>
                                <option key="OR" text="Any category"/>
                            </drop-down>
                        </header-field>
                        <default-field>
                            <ignored/>
                        </default-field>
                    </field>
                    <field name="productFeatureId">
                        <header-field title="Feature">
                            <drop-down allow-empty="true">
                                <list-options list="options.features" key="${value}" text="${label}"/>
                            </drop-down>
                        </header-field>
                        <default-field>
                            <ignored/>
                        </default-field>
                    </field>
                    <field name="productId">
                        <header-field title="Product ID"/>
                        <default-field>
                            <link url="productDetail" text="${productId}" parameter-map="{productId:productId}" link-type="anchor"/>
                        </default-field>
                    </field>
                    <field name="productName">
                        <header-field title="Name"/>
                        <default-field>
                            <display/>
                        </default-field>
                    </field>
                    <field name="productTypeEnumId">
                        <header-field title="Product type">
                            <drop-down allow-empty="true">
                                <list-options list="options.productTypes" key="${value}" text="${label}"/>
                            </drop-down>
                        </header-field>
                        <default-field>
                            <display-entity entity-name="moqui.basic.Enumeration"/>
                        </default-field>
                    </field>
                    <field name="ownerPartyId">
                        <header-field title="Owner">
                            <drop-down allow-empty="true">
                                <list-options list="options.owners" key="${value}" text="${label}"/>
                            </drop-down>
                        </header-field>
                        <default-field>
                            <display-entity entity-name="mantle.party.PartyDetail" text="PartyNameTemplate"/>
                        </default-field>
                    </field>
                    <field name="statusId">
                        <header-field title="Lifecycle">
                            <drop-down allow-empty="true">
                                <option key="PrdDraft" text="Draft"/>
                                <option key="PrdActive" text="Active"/>
                                <option key="PrdDiscontinued" text="Discontinued"/>
                                <option key="PrdObsolete" text="Obsolete"/>
                            </drop-down>
                        </header-field>
                        <default-field>
                            <display-entity entity-name="moqui.basic.StatusItem"/>
                        </default-field>
                    </field>
                    <field name="lastUpdatedStamp">
                        <header-field title="Modified"/>
                        <default-field>
                            <display text="${lastUpdatedStampText || ''}"/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="productId"/>
                            <field-ref name="productName"/>
                        </column>
                        <column><field-ref name="statusId"/></column>
                    </columns>
                    <view-board group-field="statusId" group-fields="productTypeEnumId" card-title-field="productName" card-fields="productId,ownerPartyId" key-fields="productId" status-type-id="Product" status-flow-id="Default" column-order="PrdDraft,PrdActive,PrdDiscontinued,PrdObsolete"/>
                </form-list>
            </box-body-nopad>
        </container-box>
    </widgets>
</screen>
