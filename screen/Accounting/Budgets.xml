<!-- Budgets (design-accounting §12; AC-14): the organization's budgets with their revisions, and the controls that hold
    spending against them (policies, exceptions and commitments). The Budget variance report is in Reports. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Budgets"
        menu-image="sym_o_pie_chart"
        menu-image-type="icon"
        default-menu-index="11"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <subscreens default-item="Budgets" always-use-full-path="true"/>
    <widgets>
        <subscreens-panel id="BudgetsPanel" type="tab"/>
    </widgets>
</screen>
