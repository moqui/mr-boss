<!-- InvoiceDetail's Conversation tab: the invoice's messages and activity log. It reads the invoice when the client
    loads the tab alone. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Conversation"
        default-menu-index="9"
        server-static="qvt">
    <parameter name="organizationPartyId"/>
    <parameter name="recordId"/>
    <parameter name="invoiceId"/>
    <actions>
        <!-- InvoiceDetail's actions read the invoice when it renders with the tab -->
        <if condition="receivable == null">
            <service-call name="ironstone.accounting.ReceivableServices.get#InvoiceContext"
                    in-map="context"
                    out-map="context"
                    transaction="force-new"
                    ignore-error="true"/>
        </if>
    </actions>
    <widgets>
        <section name="InvoiceConversation" condition="recordFound">
            <widgets>
                <label text="Conversation" type="h6"/>
                <chatter id="AccountingInvoiceConversation"
                        record-entity="mantle.account.invoice.Invoice"
                        record-id="${invoiceId}"
                        default-tab="log"/>
            </widgets>
        </section>
    </widgets>
</screen>
