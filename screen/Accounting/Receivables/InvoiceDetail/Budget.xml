<!-- InvoiceDetail's Budget details tab: the budget commitments of the invoice (a bill's actual against its budget, and the
    purchase order commitment it converted), from get#InvoiceFinanceDetail. It reads the invoice when the client loads the
    tab alone. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Budget details"
        default-menu-index="6">
    <parameter name="organizationPartyId"/>
    <parameter name="recordId"/>
    <parameter name="invoiceId"/>
    <actions>
        <!-- InvoiceDetail's actions read the invoice when it renders with the tab -->
        <if condition="receivable == null">
            <service-call name="ironstone.accounting.ReceivableServices.get#InvoiceContext"
                    in-map="context"
                    out-map="context"
                    transaction="force-new"
                    ignore-error="true"/>
        </if>
    </actions>
    <widgets>
        <section name="InvoiceBudget" condition="recordFound">
            <widgets>
                <container-box>
                    <box-header title="Budget details"/>
                    <box-body>
                        <form-list name="FinanceInvoiceBudgets" list="receivable.budgets" skip-form="true" paginate="false">
                            <field name="budgetText">
                                <header-field title="Budget"/>
                                <default-field>
                                    <link url="${sharedLinks['Budgets/BudgetDetail']}"
                                            text="${budgetText || budgetId}"
                                            link-type="anchor"
                                            condition="budgetId"
                                            parameter-map="{budgetId:budgetId, organizationPartyId:organizationPartyId}"/>
                                    <label text="No budget" condition="!budgetId"/>
                                </default-field>
                            </field>
                            <field name="accountText">
                                <header-field title="Account"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="amount" align="right">
                                <header-field title="Amount"/>
                                <default-field>
                                    <display currency-unit-field="currencyUomId"/>
                                </default-field>
                            </field>
                            <field name="convertedFromText">
                                <header-field title="Converted from"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="decisionText">
                                <header-field title="Decision"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="overrideReason">
                                <header-field title="Override reason"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="budgetText"/>
                                    <field-ref name="accountText"/>
                                </column>
                                <column>
                                    <field-ref name="amount"/>
                                    <field-ref name="decisionText"/>
                                </column>
                            </columns>
                        </form-list>
                        <label text="The budget allocations of this invoice are not available."
                                type="p"
                                style="m-muted"
                                condition="!receivable.budgetAvailable"/>
                        <label text="No budget commitment is recorded for this invoice."
                                type="p"
                                style="m-muted"
                                condition="receivable.budgetAvailable &amp;&amp; !receivable.budgets.length"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
