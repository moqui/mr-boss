<!-- Fixed assets (design-accounting §10; AC-07): the organization's asset books, its asset class versions and depreciation
    by fiscal month, and EquipmentDetail, the shared equipment screen with the Accounting context. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Fixed assets"
        menu-image="sym_o_domain"
        menu-image-type="icon"
        default-menu-index="8"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <subscreens default-item="FixedAssets" always-use-full-path="true">
        <subscreens-item name="EquipmentDetail"
                location="component://mr-boss/screen/Shared/EquipmentDetail.xml"
                menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="FixedAssetsPanel" type="tab"/>
    </widgets>
</screen>
