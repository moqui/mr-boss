<!-- Income statement (design-accounting §13): revenue, cost of sales and expenses of the organization's fiscal
    period to gross profit and net income, from mantle.ledger.LedgerReportServices.run#IncomeStatement, comparing
    another period of the organization when one is chosen. Each account opens the general ledger with the report's
    organization, period and currency. The rows are template/AccountingReports.xml's StatementReport. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Income statement"
        default-menu-index="6"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <parameter name="timePeriodId"/>
    <parameter name="compareTimePeriodId"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <actions>
        <set field="statement" value="incomeStatement"/>
        <set field="reportTitle" value="Income statement"/>
        <set field="reportScreen" value="IncomeStatement"/>
    </actions>
    <widgets>
        <section-include name="StatementReport" location="component://mr-boss/template/AccountingReports.xml"/>
    </widgets>
</screen>
