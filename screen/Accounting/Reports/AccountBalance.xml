<!-- Account balances (design-accounting §13): each month of the fiscal year holding the chosen period, with its
    assets, liabilities and equity at the month's end and its revenue, expenses and net income, from
    mantle.ledger.LedgerReportServices.get#PeriodSeriesSummary; a month opens its trial balance. The rows are
    template/AccountingReports.xml's StatementReport. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Account balances"
        default-menu-index="10"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <parameter name="timePeriodId"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <actions>
        <set field="statement" value="accountBalance"/>
        <set field="reportTitle" value="Account balances"/>
        <set field="reportScreen" value="AccountBalance"/>
    </actions>
    <widgets>
        <section-include name="StatementReport" location="component://mr-boss/template/AccountingReports.xml"/>
    </widgets>
</screen>
