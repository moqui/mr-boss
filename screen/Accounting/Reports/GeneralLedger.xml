<!-- General ledger (design-accounting §13): the posted lines of each account by currency with a running balance, and with
    comparison dates the same for the comparison period. An account or entry opens its detail with the report's options,
    and comes back to the report. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="General ledger"
        default-menu-index="3"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <parameter name="glAccountId"/>
    <parameter name="timePeriodId"/>
    <parameter name="fromDate"/>
    <parameter name="thruDate"/>
    <parameter name="amountUomId"/>
    <parameter name="facilityId"/>
    <parameter name="costCenterId"/>
    <parameter name="compareFromDate"/>
    <parameter name="compareThruDate"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <actions>
        <set field="reportOptions"
                from="{organizationPartyId, glAccountId, timePeriodId, fromDate, thruDate, amountUomId, facilityId,
                    costCenterId, compareFromDate, compareThruDate}"/>
        <set field="reportRows" from="[]"/>
        <set field="comparisonRows" from="[]"/>
        <if condition="organizationPartyId">
            <service-call name="mantle.ledger.FinanceReportServices.run#GeneralLedger" in-map="reportOptions" out-map="context"/>
        </if>
        <set field="printUrl"
                from="'/apps/Accounting/Reports/GeneralLedger?'
                    + Object.entries(Object.assign({renderMode: 'html-print'},
                    reportOptions)).filter(entry =&gt; entry[1]).map(entry =&gt; entry[0] + '='
                    + encodeURIComponent(entry[1])).join('&amp;')"/>
        <set field="hasComparison" from="!!(compareFromDate || compareThruDate)"/>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm">
            <container style="col">
                <label text="General ledger" type="h5"/>
            </container>
            <container style="col-auto">
                <link url="${printUrl}"
                        url-type="plain"
                        text="Print"
                        icon="sym_o_print"
                        target-window="_blank"
                        condition="organizationPartyId"/>
            </container>
        </container>
        <section-include name="ReportOptions" location="component://mr-boss/template/AccountingParts.xml"/>
        <label text="Choose an organization and run the report." type="p" condition="!organizationPartyId"/>
        <section name="Results" condition="organizationPartyId">
            <widgets>
                <label text="No posted entries match these options." type="p" condition="!reportRows.length"/>
                <form-list name="ReportRows"
                        list="reportRows"
                        skip-form="true"
                        paginate="false"
                        select-columns="true"
                        show-csv-button="true"
                        show-xlsx-button="true"
                        saved-finds="true">
                    <field name="glAccountId">
                        <default-field title="Account">
                            <link url="//Accounting/GeneralLedger/AccountDetail"
                                    text="${accountName || glAccountId}"
                                    link-type="anchor"
                                    parameter-map="Object.assign({recordId: glAccountId,
                                        reportReturn: 'GeneralLedger'}, reportOptions)"/>
                        </default-field>
                    </field>
                    <field name="transactionDate">
                        <default-field title="Date">
                            <display text="${transactionDateText}"/>
                        </default-field>
                    </field>
                    <field name="acctgTransId">
                        <!-- People P27 review (AC-23): an account's payroll-origin lines, folded for a reader without PAYROLL_VIEW -->
                        <conditional-field condition="!acctgTransId" title="Entry">
                            <display text="${description || ''}"/>
                        </conditional-field>
                        <default-field title="Entry">
                            <link url="//Accounting/GeneralLedger/JournalEntryDetail"
                                    text="${acctgTransId}"
                                    link-type="anchor"
                                    parameter-map="Object.assign({recordId: acctgTransId,
                                        reportReturn: 'GeneralLedger'}, reportOptions)"/>
                        </default-field>
                    </field>
                    <field name="amountUomId">
                        <default-field title="Currency">
                            <display/>
                        </default-field>
                    </field>
                    <field name="debits" align="right">
                        <default-field title="Debits">
                            <display currency-unit-field="amountUomId"/>
                        </default-field>
                    </field>
                    <field name="credits" align="right">
                        <default-field title="Credits">
                            <display currency-unit-field="amountUomId"/>
                        </default-field>
                    </field>
                    <field name="ending" align="right">
                        <default-field title="Balance">
                            <display currency-unit-field="amountUomId"/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="glAccountId"/>
                            <field-ref name="transactionDate"/>
                        </column>
                        <column>
                            <field-ref name="debits"/>
                            <field-ref name="credits"/>
                            <field-ref name="ending"/>
                        </column>
                    </columns>
                </form-list>
                <section name="Comparison" condition="hasComparison">
                    <widgets>
                        <label text="Comparison period" type="h6"/>
                        <label text="No posted entries in the comparison period." type="p" condition="!comparisonRows.length"/>
                        <form-list name="ComparisonRows"
                                list="comparisonRows"
                                extends="ReportRows"
                                skip-form="true"
                                paginate="false"
                                select-columns="true"
                                show-csv-button="true"
                                saved-finds="false"/>
                    </widgets>
                </section>
                <label text="As of ${asOf}" type="p" style="text-caption m-muted"/>
            </widgets>
        </section>
    </widgets>
</screen>
