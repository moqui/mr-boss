<!-- Financial ratios (design-accounting §13): each ratio with its formula, numerator and denominator; a zero
    denominator shows the ratio unavailable. From mantle.ledger.LedgerReportServices.run#FinancialRatios, comparing
    another period of the organization when one is chosen. Each account opens the general ledger with the report's
    organization, period and currency. The rows are template/AccountingReports.xml's StatementReport. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Financial ratios"
        default-menu-index="9"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <parameter name="timePeriodId"/>
    <parameter name="compareTimePeriodId"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <actions>
        <set field="statement" value="financialRatios"/>
        <set field="reportTitle" value="Financial ratios"/>
        <set field="reportScreen" value="FinancialRatios"/>
    </actions>
    <widgets>
        <section-include name="StatementReport" location="component://mr-boss/template/AccountingReports.xml"/>
    </widgets>
</screen>
