<!-- The Accounting reports (design-accounting §13): the built reports, each with what it answers. P16 adds the rest. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Overview"
        default-menu-index="1"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <widgets>
        <label text="Accounting reports" type="h5"/>
        <container-row>
            <row-col md="6">
                <container-box>
                    <box-header title="Trial balance"/>
                    <box-body>
                        <label text="Each account's beginning balance, debits, credits and ending balance for a period."
                                type="p"/>
                        <link url="../TrialBalance" text="Open trial balance" link-type="anchor-button" btn-type="primary"/>
                    </box-body>
                </container-box>
            </row-col>
            <row-col md="6">
                <container-box>
                    <box-header title="General ledger"/>
                    <box-body>
                        <label text="The posted lines of each account, with a running balance." type="p"/>
                        <link url="../GeneralLedger" text="Open general ledger" link-type="anchor-button"/>
                    </box-body>
                </container-box>
            </row-col>
            <row-col md="6">
                <container-box>
                    <box-header title="Invoice reconciliation"/>
                    <box-body>
                        <label text="Invoices, payments and postings of a period whose amounts disagree with the ledger."
                                type="p"/>
                        <link url="../InvoiceReconciliation" text="Open invoice reconciliation" link-type="anchor-button"/>
                    </box-body>
                </container-box>
            </row-col>
            <row-col md="6">
                <container-box>
                    <box-header title="Stock transactions"/>
                    <box-body>
                        <label text="The receipts, issues and count variances of a period, with their cost and posting."
                                type="p"/>
                        <link url="../StockTransactions" text="Open stock transactions" link-type="anchor-button"/>
                    </box-body>
                </container-box>
            </row-col>
            <row-col md="6">
                <container-box>
                    <box-header title="Budget variance"/>
                    <box-body>
                        <label text="Each account's budget, what is committed, the actual and what remains, as of a revision."
                                type="p"/>
                        <link url="../BudgetVariance" text="Open budget variance" link-type="anchor-button"/>
                    </box-body>
                </container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
