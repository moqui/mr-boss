<!-- Tax (design-accounting §11; AC-08): authorities and rates for finance administrators, statements for tax users. The
    first release has local sales tax and the US 1099 data. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Tax"
        menu-image="sym_o_percent"
        menu-image-type="icon"
        default-menu-index="10"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <subscreens default-item="TaxStatements" always-use-full-path="true"/>
    <widgets>
        <subscreens-panel id="TaxPanel" type="tab"/>
    </widgets>
</screen>
