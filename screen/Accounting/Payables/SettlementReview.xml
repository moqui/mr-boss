<!-- A retained settlement review (ironstone.accounting.SettlementScreenServices.get#SettlementReviewContext): the supplier's
    allocations and adjustments on one settlement date, the balances before and after and the postings it plans, and Confirm
    settlement (mantle.account.PaymentServices.apply#Settlement). Once applied it shows the applications, adjustments,
    remaining balances and posted transactions. Back to selection returns to the workbench with the user's draft. A
    review that expired or is another user's is "not available". The sections are template/AccountingWorkbench.xml's,
    with direction payable. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Settlement review"
        default-menu-include="false">
    <parameter name="organizationPartyId"/>
    <parameter name="previewId"/>
    <parameter name="draftId"/>
    <transition-include name="confirmSettlement" location="component://mr-boss/template/AccountingWorkbench.xml"/>
    <actions>
        <set field="direction" value="payable"/>
        <!-- the labels the not-available state reads when the review cannot be read -->
        <set field="workbenchLabels"
                from="{workbench:'Payables/PayablesWorkbench', sourceLabel:'', targetLabel:'', kinds:{}}"/>
        <service-call name="ironstone.accounting.SettlementScreenServices.get#SettlementReviewContext"
                in-map="context"
                out-map="context"
                transaction="force-new"
                ignore-error="true"/>
        <set field="review" from="settlementReview"/>
        <set field="workbenchParameters" from="selectionParameters || {organizationPartyId:organizationPartyId}"/>
    </actions>
    <widgets>
        <link url="${sharedLinks['Payables/PayablesWorkbench']}"
                text="Payables workbench"
                link-type="anchor"
                icon="arrow_back"
                parameter-map="workbenchParameters"/>
        <section-include name="SettlementReviewNotAvailable" location="component://mr-boss/template/AccountingWorkbench.xml"/>
        <section-include name="SettlementReview" location="component://mr-boss/template/AccountingWorkbench.xml"/>
    </widgets>
</screen>
