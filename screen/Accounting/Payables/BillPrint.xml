<!-- The printed supplier bill or debit note (design-accounting §17; mantle.account.InvoiceServices.get#InvoiceOutput, with
    the supplier as the issuer): with renderMode=html-print or in the html webapp the print itself, and under /fop the same as
    a PDF; in the browser and terminal clients a link to the printed page. AccountingDocuments.xml's DocumentPrint, as
    Receivables/InvoicePrint. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Bill print"
        default-menu-include="false">
    <parameter name="organizationPartyId"/>
    <parameter name="invoiceId"/>
    <parameter name="recordId"/>
    <actions>
        <set field="documentKind" value="bills"/>
        <set field="printScreen" value="Payables/BillPrint"/>
        <set field="listPath" value="Payables/Bills"/>
    </actions>
    <widgets>
        <section-include name="DocumentPrint" location="component://mr-boss/template/AccountingDocuments.xml"/>
    </widgets>
</screen>
