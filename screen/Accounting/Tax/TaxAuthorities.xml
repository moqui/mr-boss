<!-- Tax authorities (design-accounting §11 TaxAuthorities): the authorities, each with the organization's nexus,
    registration, tax account and current rates. A finance administrator adds and edits them through
    mantle.other.TaxServices.store#Authority; tax users read them. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Authorities"
        default-menu-index="1"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <parameter name="text"/>
    <parameter name="pageIndex"/>
    <parameter name="pageSize"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition name="storeAuthority">
        <actions>
            <service-call name="mantle.other.TaxServices.store#Authority" in-map="context" out-map="stored"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="ironstone.accounting.TaxServices.find#Authorities"
                in-map="{organizationPartyId:organizationPartyId, text:text, pageIndex:pageIndex, pageSize:pageSize}"
                out-map="context"/>
        <set field="newAuthority" from="{organizationPartyId:organizationPartyId, isNexus:'Y'}"/>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm">
            <container style="col">
                <label text="Tax authorities" type="h5"/>
            </container>
            <container style="col-auto">
                <container-dialog id="AddAuthorityDialog"
                        button-text="Add authority"
                        type="primary"
                        icon="sym_o_add"
                        title="Add a tax authority"
                        width="760"
                        condition="canEdit">
                    <form-single name="TaxAuthority" transition="storeAuthority" map="newAuthority">
                        <field name="organizationPartyId">
                            <default-field>
                                <hidden/>
                            </default-field>
                        </field>
                        <field name="description">
                            <default-field title="Name">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="taxAuthorityTypeEnumId">
                            <default-field title="Level">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices"
                                            server-search="true"
                                            min-length="0"
                                            parameter-map="{choice:'enum:TaxAuthorityType',
                                                organizationPartyId:organizationPartyId, selected:taxAuthorityTypeEnumId}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="taxAuthGeoId">
                            <default-field title="Region" tooltip="Sales delivered to this region are taxed by the authority">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices"
                                            server-search="true"
                                            min-length="0"
                                            parameter-map="{choice:'taxGeos',
                                                organizationPartyId:organizationPartyId, selected:taxAuthGeoId}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="taxAuthPartyId">
                            <default-field title="Authority party" tooltip="The organization the tax is paid to">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices"
                                            server-search="true"
                                            min-length="0"
                                            parameter-map="{choice:'parties',
                                                organizationPartyId:organizationPartyId, selected:taxAuthPartyId}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="isNexus">
                            <default-field title="Collects tax here" tooltip="The organization has nexus with the authority">
                                <radio>
                                    <option key="Y" text="Yes"/>
                                    <option key="N" text="No"/>
                                </radio>
                            </default-field>
                        </field>
                        <field name="partyTaxId">
                            <default-field title="Registration number">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="glAccountId">
                            <default-field title="Tax account" tooltip="Where this authority's tax on sales posts">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices"
                                            server-search="true"
                                            min-length="0"
                                            parameter-map="{choice:'accounts',
                                                organizationPartyId:organizationPartyId, selected:glAccountId}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="taxIdFormatPattern">
                            <default-field title="Registration format" tooltip="A pattern customer registrations must match">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="changeReason">
                            <default-field title="Reason">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="submit">
                            <default-field title="">
                                <submit text="Save authority"/>
                            </default-field>
                        </field>
                        <field-layout>
                            <field-row>
                                <field-ref name="description"/>
                                <field-ref name="taxAuthorityTypeEnumId"/>
                            </field-row>
                            <field-row>
                                <field-ref name="taxAuthGeoId"/>
                                <field-ref name="taxAuthPartyId"/>
                            </field-row>
                            <field-row>
                                <field-ref name="isNexus"/>
                                <field-ref name="partyTaxId"/>
                            </field-row>
                            <field-row>
                                <field-ref name="glAccountId"/>
                                <field-ref name="taxIdFormatPattern"/>
                            </field-row>
                            <field-ref name="changeReason"/>
                            <field-ref name="submit"/>
                        </field-layout>
                    </form-single>
                </container-dialog>
            </container>
        </container>
        <section-include name="FindRecords" location="component://mr-boss/template/AccountingParts.xml"/>
        <form-list name="Authorities"
                list="records"
                skip-form="true"
                paginate="true"
                select-columns="true"
                show-csv-button="true">
            <field name="description">
                <default-field title="Authority">
                    <display/>
                </default-field>
            </field>
            <field name="geoName">
                <default-field title="Region">
                    <display/>
                </default-field>
            </field>
            <field name="partyName">
                <default-field title="Paid to">
                    <display/>
                </default-field>
            </field>
            <field name="isNexus">
                <default-field title="Collects">
                    <render-mode>
                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${isNexus == 'Y' ?
                            'positive' : 'grey'}">${isNexus == 'Y' ? 'Collects' : 'No nexus'}</q-chip>]]></text>
                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong", text: isNexus == 'Y' ?
                            'Collects' : 'No nexus'})}]]></text>
                        <text type="html">${isNexus == 'Y' ? 'Collects' : 'No nexus'}</text>
                    </render-mode>
                </default-field>
            </field>
            <field name="partyTaxId">
                <default-field title="Registration">
                    <display/>
                </default-field>
            </field>
            <field name="glAccountText">
                <default-field title="Tax account">
                    <display/>
                </default-field>
            </field>
            <field name="currentRateCount">
                <default-field title="Current rates">
                    <link url="${sharedLinks['Tax/TaxRates']}"
                            text="${currentRateCount}"
                            link-type="anchor"
                            parameter-map="{organizationPartyId:organizationPartyId, taxAuthorityId:taxAuthorityId,
                                state:'current'}"/>
                </default-field>
            </field>
            <field name="authorityActions">
                <default-field title="">
                    <container-dialog id="EditAuthority_${taxAuthorityId}"
                            button-text="Edit"
                            icon="sym_o_edit"
                            title="Edit ${description}"
                            width="760"
                            condition="canEdit">
                        <form-single name="EditAuthority" transition="storeAuthority" extends="TaxAuthority">
                            <field name="taxAuthorityId" from="taxAuthorityId">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="changeReason" from="''">
                                <default-field title="Reason">
                                    <text-line/>
                                </default-field>
                            </field>
                        </form-single>
                    </container-dialog>
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="description"/>
                    <field-ref name="geoName"/>
                </column>
                <column>
                    <field-ref name="isNexus"/>
                    <field-ref name="authorityActions"/>
                </column>
            </columns>
        </form-list>
        <label text="No tax authorities yet. A finance administrator adds the authorities the organization collects for."
                type="p"
                condition="!records.length"/>
    </widgets>
</screen>
