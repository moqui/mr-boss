<!-- The Accounting settings index (design-accounting §15 Settings): the organization's setup readiness, each finding with
    the screen that fixes it (mantle.ledger.SetupServices.get#Preferences), and the way to Setup, the activation wizard.
    The settings themselves are the other tabs. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Overview"
        default-menu-index="1"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition-include name="selectOrganization" location="component://mr-boss/template/AccountingParts.xml"/>
    <actions>
        <service-call name="mantle.ledger.SetupServices.get#Preferences"
                in-map="{organizationPartyId:organizationPartyId}"
                out-map="readiness"/>
        <set field="findings" from="readiness?.findings || []"/>
        <set field="fixPaths"
                from="{PREFERENCES: '../AccountingPreferences', BASE_CURRENCY: '../AccountingPreferences',
                    ERROR_JOURNAL: '../AccountingPreferences', PERIODS: '//Accounting/PeriodClose/Periods',
                    FISCAL_PERIODS: '//Accounting/PeriodClose/Periods', CHART: '//Accounting/GeneralLedger/ChartOfAccounts'}"/>
    </actions>
    <widgets>
        <label text="Accounting settings" type="h5"/>
        <section-include name="OrganizationPicker" location="component://mr-boss/template/AccountingParts.xml"/>
        <section name="Readiness" condition="organizationPartyId">
            <widgets>
                <link url="../Setup"
                        text="Accounting setup"
                        link-type="anchor-button"
                        icon="sym_o_rocket_launch"
                        parameter-map="{organizationPartyId:organizationPartyId}"/>
                <section name="Findings" condition="findings.length">
                    <widgets>
                        <container-box type="warning">
                            <box-header title="Setup needs attention"/>
                            <box-body>
                                <form-list name="Readiness" list="findings" skip-form="true" paginate="false">
                                    <field name="message">
                                        <default-field title="To do">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="fix">
                                        <default-field title="">
                                            <link url="${fixPaths[code]}"
                                                    text="Fix"
                                                    icon="sym_o_arrow_forward"
                                                    condition="fixPaths[code]"
                                                    parameter-map="{organizationPartyId:organizationPartyId}"/>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column>
                                            <field-ref name="message"/>
                                        </column>
                                        <column>
                                            <field-ref name="fix"/>
                                        </column>
                                    </columns>
                                </form-list>
                            </box-body>
                        </container-box>
                    </widgets>
                    <fail-widgets>
                        <label text="The organization's accounting setup is complete." type="p"/>
                    </fail-widgets>
                </section>
            </widgets>
            <fail-widgets>
                <label text="Choose an organization to check its accounting setup." type="p"/>
            </fail-widgets>
        </section>
    </widgets>
</screen>
