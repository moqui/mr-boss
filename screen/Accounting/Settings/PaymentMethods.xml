<!-- Payment methods (design-accounting §15 PaymentMethods): the organization's own methods with masked identifiers, and
    the gateway each may use among those Admin permitted the organization (PaymentGatewayOrganization; impl-accounting
    F59). Credentials and gateway services stay in Admin; bank details are P9's. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Payment methods"
        default-menu-index="6"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition-include name="selectOrganization" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition name="save">
        <actions>
            <service-call name="mantle.ledger.SetupServices.store#PaymentMethod" in-map="context" out-map="result"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="mantle.ledger.SetupServices.get#PaymentMethods"
                in-map="{organizationPartyId:organizationPartyId}"
                out-map="context"/>
        <set field="gatewayNames"
                from="Object.fromEntries((gateways || []).map(gateway =&gt; [gateway.paymentGatewayConfigId,
                    gateway.description || gateway.paymentGatewayConfigId]))"/>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm">
            <container style="col">
                <label text="Payment methods" type="h5"/>
            </container>
            <container style="col-auto">
                <container-dialog id="NewMethodDialog"
                        button-text="New payment method"
                        type="primary"
                        icon="sym_o_add"
                        title="New payment method"
                        condition="organizationPartyId">
                    <form-single name="NewMethod" transition="save">
                        <field name="organizationPartyId" from="organizationPartyId">
                            <default-field>
                                <hidden/>
                            </default-field>
                        </field>
                        <field name="description">
                            <default-field title="Name">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="currencyUomId">
                            <default-field title="Currency">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices"
                                            server-search="true"
                                            min-length="0"
                                            parameter-map="{choice:'currencies',
                                                organizationPartyId:organizationPartyId, selected:currencyUomId}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="paymentGatewayConfigId">
                            <default-field title="Gateway" tooltip="Only the gateways Admin permitted this organization">
                                <drop-down allow-empty="true">
                                    <list-options list="gateways" key="${paymentGatewayConfigId}" text="${description}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="fromDate">
                            <default-field title="Starts">
                                <date-time/>
                            </default-field>
                        </field>
                        <field name="thruDate">
                            <default-field title="Expires">
                                <date-time/>
                            </default-field>
                        </field>
                        <field name="changeReason">
                            <default-field title="Reason">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="submit">
                            <default-field title="">
                                <submit text="Save method"/>
                            </default-field>
                        </field>
                    </form-single>
                </container-dialog>
            </container>
        </container>
        <section-include name="OrganizationPicker" location="component://mr-boss/template/AccountingParts.xml"/>
        <section name="Methods" condition="organizationPartyId">
            <widgets>
                <label text="Identifiers are masked; gateway credentials stay in Admin." type="p" style="text-caption m-muted"/>
                <form-list name="PaymentMethodList"
                        list="methods"
                        skip-form="true"
                        paginate="false"
                        select-columns="true"
                        show-csv-button="true"
                        show-xlsx-button="true">
                    <field name="description">
                        <default-field title="Method">
                            <display text="${description || paymentMethodId}"/>
                        </default-field>
                    </field>
                    <field name="paymentMethodTypeEnumId">
                        <default-field title="Type">
                            <display-entity entity-name="moqui.basic.Enumeration"/>
                        </default-field>
                    </field>
                    <field name="maskedIdentifier">
                        <default-field title="Identifier">
                            <display/>
                        </default-field>
                    </field>
                    <field name="paymentGatewayConfigId">
                        <default-field title="Gateway">
                            <display text="${gatewayNames[paymentGatewayConfigId] || paymentGatewayConfigId || 'None'}"/>
                        </default-field>
                    </field>
                    <field name="thruDate">
                        <default-field title="Expires">
                            <display text="${thruDateText || 'Open'}"/>
                        </default-field>
                    </field>
                    <field name="methodActions">
                        <default-field title="">
                            <container-dialog id="EditMethod_${paymentMethodId}"
                                    button-text="Edit"
                                    icon="sym_o_edit"
                                    title="${ec.l10n.localize('Edit')} ${description || paymentMethodId}">
                                <form-single name="EditMethod" transition="save" extends="NewMethod">
                                    <field name="paymentMethodId" from="paymentMethodId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="lastUpdatedStamp" from="lastUpdatedStamp">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </container-dialog>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="description"/>
                            <field-ref name="maskedIdentifier"/>
                        </column>
                        <column>
                            <field-ref name="thruDate"/>
                            <field-ref name="methodActions"/>
                        </column>
                    </columns>
                </form-list>
                <label text="No payment methods yet. Add one with New payment method." type="p" condition="!methods.length"/>
            </widgets>
            <fail-widgets>
                <label text="Choose an organization to see and change its payment methods." type="p"/>
            </fail-widgets>
        </section>
    </widgets>
</screen>
