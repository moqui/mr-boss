<!-- Costing policies (style-guide §3.10 Settings; design-accounting §15 CostingPolicies; impl-manufacturing P15): the
    organization's production allocation policy as effective-dated rows (mantle.ledger.ProductionCostServices
    get#AllocationPolicies, store#AllocationPolicy): the overhead basis (a rate per work-center hour from each center's
    overhead rate, else the policy's; a percentage of direct labor; none), the co-product method (quantity in a common
    unit, fixed shares on the BOM's output lines, relative sales value), explicit output weights, where the scrap of issued
    material goes, and the variance account. A change ends the row in effect and starts the next; a posted cost close keeps
    the row it applied. Finance administration changes it; Manufacturing's ProductionSettings links here.
    Labor costing rates (design-accounting §15 LaborCostingRates; impl-people P10, owner contract, F34): the cost of an hour by
    position class and work type, the one labor costing purpose RaprCost that production's labor events, Maintenance and the cost
    reports read (mantle.humanres.RateServices get#CostingRate), never a person's pay. A rate is the chosen organization's, which the
    lookup prefers for its employees, or shared by every organization (the user's call of Nov 11, 2026): the box lists the chosen
    organization's rows and the shared ones (every row the user reads with none chosen); find#CostingRates for Accounting's
    readers, store#CostingRate (a change ends the rate in effect and starts the next, from now or a later date) and
    end#CostingRate for finance administration (ACCOUNTING_ADMIN) of the row's organization, a shared row only working for every
    organization (no organization chosen), as the services decide (canChange). People's Rates shows them read only. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Costing policies"
        default-menu-index="8"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition-include name="selectOrganization" location="component://mr-boss/template/AccountingParts.xml"/>
    <!-- the labor costing rates: start one (or change one, ending the rate in effect), and end one -->
    <transition name="saveCostingRate">
        <actions>
            <service-call name="mantle.humanres.RateServices.store#CostingRate" in-map="{organizationPartyId:(rateOrganizationPartyId || null),
                    emplPositionClassId:(emplPositionClassId || null),
                    workTypeEnumId:(workTypeEnumId || null), rateTypeEnumId:(rateTypeEnumId || null), rateAmount:(rateAmount ?? ''),
                    rateCurrencyUomId:(rateCurrencyUomId || null), fromDate:(fromDate || null), expectedRateAmountId:(expectedRateAmountId || null)}"/>
            <if condition="!ec.message.hasError()">
                <message type="success">Labor costing rate saved</message>
            </if>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="endCostingRate">
        <actions>
            <service-call name="mantle.humanres.RateServices.end#CostingRate" in-map="{rateAmountId:rateAmountId}"/>
            <if condition="!ec.message.hasError()">
                <message type="success">Labor costing rate ended</message>
            </if>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="savePolicy">
        <actions>
            <service-call name="mantle.ledger.ProductionCostServices.store#AllocationPolicy" in-map="context"/>
            <if condition="!ec.message.hasError()">
                <message type="success">Costing policy saved</message>
            </if>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <actions>
        <set field="policies" from="null"/>
        <if condition="organizationPartyId">
            <service-call name="mantle.ledger.ProductionCostServices.get#AllocationPolicies" out-map="policies"
                    transaction="force-new" ignore-error="true" in-map="{organizationPartyId:organizationPartyId}"/>
        </if>
        <set field="current" from="policies?.policy || {}"/>
        <set field="policyRows" from="policies?.policyRows || []"/>
        <set field="policyForm" from="{organizationPartyId:organizationPartyId, expectedFromDate:policies?.expectedFromDate,
                overheadBasisEnumId:current.overheadBasisEnumId, overheadRate:current.overheadRate,
                overheadPercent:current.overheadPercent, coproductMethodEnumId:current.coproductMethodEnumId,
                allowOutputWeights:current.allowOutputWeights ? 'Y' : 'N', scrapToVariance:current.scrapToVariance ? 'Y' : 'N',
                varianceGlAccountId:current.varianceGlAccountId}"/>
        <set field="currentText" from="current.overheadBasisText ? 'Overhead ' + current.overheadBasisText
                + (current.overheadRate ? ' (' + current.overheadRate + ' ' + (current.rateUomId || '') + ' an hour where a work center has no overhead rate)' : '')
                + (current.overheadPercent ? ' (' + current.overheadPercent + '%)' : '')
                + '; co-products by ' + current.coproductMethodText
                + (current.allowOutputWeights ? '; explicit output weights allowed' : '')
                + (current.scrapToVariance ? '; scrap to variance' : '; scrap to the scrap account') : ''"/>
        <!-- the labor costing rates, the chosen organization's and the shared ones (a reader without an Accounting or payroll grant
            gets none) -->
        <service-call name="mantle.humanres.RateServices.find#CostingRates" out-map="laborFound" transaction="force-new"
                ignore-error="true" in-map="{organizationPartyId:(organizationPartyId || null)}"/>
        <script><![CDATA[
            ec.message.clearErrors()
            laborAvailable = laborFound?.rateList != null
            // each row's organization as its own key (a shared row's empty, never the page's organization)
            laborRows = Array.from(laborFound?.rateList || []).map(row => Object.assign({}, row, {rateOrgId: row.organizationPartyId || ''}))
            // New rate: for the chosen organization, or shared by every organization, as the user may change them
            const organizationText = organizationPartyId ? (ec.entity.find('mantle.party.Organization').condition('partyId', organizationPartyId)
                    .disableAuthz().one()?.organizationName || organizationPartyId) : null
            laborScopeOptions = []
            if (organizationPartyId && laborFound?.canEditOrganization) laborScopeOptions.push({key: organizationPartyId, text: organizationText})
            if (laborFound?.canEditShared) laborScopeOptions.push({key: '', text: ec.l10n.localize('Every organization (shared)')})
            laborCanEdit = laborScopeOptions.length > 0
            laborSharedNote = laborRows.some(row => !row.organizationPartyId) && !laborFound?.canEditShared && laborFound?.canEdit
            const already = ec.artifactExecution.disableAuthz()
            try {
                positionClassOptions = Array.from(ec.entity.find('mantle.humanres.position.EmplPositionClass').orderBy('title').limit(200).list())
                        .map(row => ({key: row.emplPositionClassId, text: row.title || row.emplPositionClassId}))
                workTypeOptions = Array.from(ec.entity.find('moqui.basic.Enumeration').condition('enumTypeId', 'WorkType').orderBy('sequenceNum')
                        .orderBy('description').list()).map(row => ({key: row.enumId, text: row.description || row.enumId}))
                rateTypeOptions = Array.from(ec.entity.find('moqui.basic.Enumeration').condition('enumTypeId', 'RateType').orderBy('sequenceNum')
                        .orderBy('description').list()).map(row => ({key: row.enumId, text: row.description || row.enumId}))
            } finally { if (!already) ec.artifactExecution.enableAuthz() }
            newLaborRate = {rateTypeEnumId: 'RatpStandard', rateCurrencyUomId: ec.user.getPreference('CurrencyDefault') || '',
                rateOrganizationPartyId: laborScopeOptions.length ? laborScopeOptions[0].key : ''}
        ]]></script>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm">
            <container style="col">
                <label text="Costing policies" type="h5"/>
            </container>
            <container style="col-auto row items-center q-gutter-sm">
                <container-dialog id="ChangeCostingPolicy" button-text="Change policy" type="primary" icon="sym_o_edit"
                        title="Change the production costing policy" width="760"
                        condition="organizationPartyId &amp;&amp; policies?.canEdit">
                    <form-single name="CostingPolicy" transition="savePolicy" map="policyForm">
                        <field name="organizationPartyId">
                            <default-field>
                                <hidden/>
                            </default-field>
                        </field>
                        <field name="expectedFromDate">
                            <default-field>
                                <hidden/>
                            </default-field>
                        </field>
                        <field name="overheadBasisEnumId">
                            <default-field title="Overhead basis">
                                <drop-down>
                                    <dynamic-options transition="choices" server-search="true" min-length="0"
                                            parameter-map="{choice:'enum:ProductionOverheadBasis',
                                                organizationPartyId:organizationPartyId, selected:overheadBasisEnumId}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="overheadRate">
                            <default-field title="Rate an hour" tooltip="For a work center with no overhead rate of its own">
                                <text-line size="8"/>
                            </default-field>
                        </field>
                        <field name="overheadPercent">
                            <default-field title="Percentage of labor" tooltip="With the percentage of direct labor basis">
                                <text-line size="6"/>
                            </default-field>
                        </field>
                        <field name="coproductMethodEnumId">
                            <default-field title="Co-products by">
                                <drop-down>
                                    <dynamic-options transition="choices" server-search="true" min-length="0"
                                            parameter-map="{choice:'enum:ProductionCoproductMethod',
                                                organizationPartyId:organizationPartyId, selected:coproductMethodEnumId}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="allowOutputWeights">
                            <default-field title="Explicit output weights" tooltip="Whether a cost close may weigh the outputs by hand">
                                <drop-down>
                                    <option key="N" text="Not allowed"/>
                                    <option key="Y" text="Allowed"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="scrapToVariance">
                            <default-field title="Scrap of issued material">
                                <drop-down>
                                    <option key="N" text="To the scrap account"/>
                                    <option key="Y" text="To production variance"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="varianceGlAccountId">
                            <default-field title="Variance account" tooltip="The organization's production variance account when empty">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0"
                                            parameter-map="{choice:'accounts', organizationPartyId:organizationPartyId,
                                                selected:varianceGlAccountId}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="fromDate">
                            <default-field title="From" tooltip="Now when empty">
                                <date-time type="timestamp"/>
                            </default-field>
                        </field>
                        <field name="changeReason">
                            <default-field title="Reason">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="submit">
                            <default-field title="">
                                <submit text="Save policy" confirmation="Start this costing policy row?"/>
                            </default-field>
                        </field>
                        <field-layout>
                            <field-ref name="organizationPartyId"/>
                            <field-ref name="expectedFromDate"/>
                            <field-row>
                                <field-ref name="overheadBasisEnumId"/>
                                <field-ref name="coproductMethodEnumId"/>
                            </field-row>
                            <field-row>
                                <field-ref name="overheadRate"/>
                                <field-ref name="overheadPercent"/>
                            </field-row>
                            <field-row>
                                <field-ref name="allowOutputWeights"/>
                                <field-ref name="scrapToVariance"/>
                            </field-row>
                            <field-ref name="varianceGlAccountId"/>
                            <field-row>
                                <field-ref name="fromDate"/>
                                <field-ref name="changeReason"/>
                            </field-row>
                            <field-ref name="submit"/>
                        </field-layout>
                    </form-single>
                </container-dialog>
            </container>
        </container>
        <section-include name="OrganizationPicker" location="component://mr-boss/template/AccountingParts.xml"/>
        <section name="Policies" condition="organizationPartyId &amp;&amp; policies">
            <widgets>
                <container-box>
                    <box-header title="In effect"/>
                    <box-body>
                        <label text="${currentText}." type="p"/>
                        <label text="${current.stateText == 'Default' ? 'No row yet: the default applies, overhead at each work center overhead rate times the actual hours and co-products by quantity.' : 'From ' + current.fromDateText + (current.changeReason ? ': ' + current.changeReason : '')}"
                                type="p" style="text-caption m-muted"/>
                        <label text="Work-center overhead rates are the centers' overhead cost component, kept with the work centers' rates in Manufacturing."
                                type="p" style="text-caption m-muted"/>
                    </box-body>
                </container-box>
                <section name="History" condition="policyRows.length">
                    <widgets>
                        <form-list name="CostingPolicyRows" list="policyRows" skip-form="true" paginate="false">
                            <field name="fromDateText">
                                <default-field title="From">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="overheadBasisText">
                                <default-field title="Overhead">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="coproductMethodText">
                                <default-field title="Co-products">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="stateText">
                                <default-field title="State">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="changeReason">
                                <default-field title="Reason">
                                    <display/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="fromDateText"/>
                                    <field-ref name="overheadBasisText"/>
                                </column>
                                <column>
                                    <field-ref name="stateText"/>
                                    <field-ref name="coproductMethodText"/>
                                </column>
                            </columns>
                        </form-list>
                    </widgets>
                </section>
            </widgets>
            <fail-widgets>
                <label text="Choose an organization to see and change its production costing policy." type="p"/>
            </fail-widgets>
        </section>
        <section name="LaborCostingRates" condition="laborAvailable">
            <widgets>
                <container-box>
                    <box-header title="Labor costing rates"/>
                    <box-toolbar>
                        <container-dialog id="NewLaborCostingRate" button-text="New rate" icon="sym_o_add" title="New labor costing rate" width="600"
                                condition="laborCanEdit">
                            <form-single name="NewLaborRate" transition="saveCostingRate" map="newLaborRate">
                                <field name="rateOrganizationPartyId">
                                    <default-field title="For"><radio><list-options list="laborScopeOptions" key="${key}" text="${text}"/></radio></default-field>
                                </field>
                                <field name="emplPositionClassId">
                                    <default-field title="Position class" tooltip="Any position when empty">
                                        <drop-down allow-empty="true"><list-options list="positionClassOptions" key="${key}" text="${text}"/></drop-down>
                                    </default-field>
                                </field>
                                <field name="workTypeEnumId">
                                    <default-field title="Work type" tooltip="Any work when empty">
                                        <drop-down allow-empty="true"><list-options list="workTypeOptions" key="${key}" text="${text}"/></drop-down>
                                    </default-field>
                                </field>
                                <field name="rateTypeEnumId">
                                    <default-field title="Rate type">
                                        <drop-down><list-options list="rateTypeOptions" key="${key}" text="${text}"/></drop-down>
                                    </default-field>
                                </field>
                                <field name="rateAmount"><default-field title="Cost an hour"><text-line size="10"/></default-field></field>
                                <field name="rateCurrencyUomId">
                                    <default-field title="Currency">
                                        <drop-down><dynamic-options transition="choices" server-search="true" min-length="0"
                                                parameter-map="{choice:'currencies', organizationPartyId:organizationPartyId, selected:rateCurrencyUomId}"/></drop-down>
                                    </default-field>
                                </field>
                                <field name="fromDate"><default-field title="From" tooltip="Now when empty"><date-time type="timestamp"/></default-field></field>
                                <field name="submit"><default-field title=""><submit text="Start rate"/></default-field></field>
                                <field-layout>
                                    <field-ref name="rateOrganizationPartyId"/>
                                    <field-row><field-ref name="emplPositionClassId"/><field-ref name="workTypeEnumId"/></field-row>
                                    <field-row><field-ref name="rateAmount"/><field-ref name="rateCurrencyUomId"/></field-row>
                                    <field-row><field-ref name="rateTypeEnumId"/><field-ref name="fromDate"/></field-row>
                                    <field-ref name="submit"/>
                                </field-layout>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body-nopad>
                        <form-list name="LaborCostingRateRows" list="laborRows" skip-form="true" paginate="false" condition="laborRows.length">
                            <field name="organizationText"><default-field title="Organization"><display/></default-field></field>
                            <field name="positionText"><default-field title="Position class"><display/></default-field></field>
                            <field name="workTypeText"><default-field title="Work type"><display/></default-field></field>
                            <field name="rateTypeText"><default-field title="Rate type"><display/></default-field></field>
                            <field name="amountText" align="right"><default-field title="Cost an hour"><display/></default-field></field>
                            <field name="fromText"><default-field title="From"><display/></default-field></field>
                            <field name="thruText"><default-field title="Thru"><display/></default-field></field>
                            <field name="stateText">
                                <default-field title="State">
                                    <render-mode>
                                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${ended ? 'grey-8' : coming ? 'info' : 'positive'}">${
                                            WebUtilities.encodeHtml(stateText ?? '')}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateText ?? ""})}]]></text>
                                        <text type="html">${stateText}</text>
                                    </render-mode>
                                </default-field>
                            </field>
                            <field name="actions" align="right">
                                <default-field title="">
                                    <container style="row items-center justify-end no-wrap q-gutter-xs">
                                        <container-dialog id="ChangeLaborRate_${rateAmountId}" button-text="Change" icon="sym_o_edit"
                                                title="Change the labor costing rate" width="480" condition="canChange &amp;&amp; !coming">
                                            <form-single name="ChangeLaborRate" transition="saveCostingRate">
                                                <field name="rateOrganizationPartyId" from="rateOrgId"><default-field><hidden/></default-field></field>
                                                <field name="emplPositionClassId"><default-field><hidden/></default-field></field>
                                                <field name="workTypeEnumId"><default-field><hidden/></default-field></field>
                                                <field name="rateTypeEnumId"><default-field><hidden/></default-field></field>
                                                <field name="rateCurrencyUomId"><default-field><hidden/></default-field></field>
                                                <field name="expectedRateAmountId" from="rateAmountId"><default-field><hidden/></default-field></field>
                                                <field name="scopeText"><default-field title="Applies to">
                                                    <label text="${organizationText} · ${positionText} · ${workTypeText}" type="span"/></default-field></field>
                                                <field name="rateAmount" from="null"><default-field title="New cost an hour"><text-line size="10"/></default-field></field>
                                                <field name="fromDate" from="null"><default-field title="From" tooltip="Now when empty"><date-time type="timestamp"/></default-field></field>
                                                <field name="submit"><default-field title=""><submit text="Start the new rate"
                                                        confirmation="End the rate in effect and start the new one?"/></default-field></field>
                                            </form-single>
                                        </container-dialog>
                                        <link url="endCostingRate" link-type="hidden-form-link" text="End" icon="sym_o_event_busy" btn-type="danger"
                                                confirmation="End this labor costing rate now? Labor from now on finds another rate, or is unpriced."
                                                parameter-map="{rateAmountId:rateAmountId}" condition="canChange"/>
                                    </container>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="positionText"/><field-ref name="workTypeText"/><field-ref name="organizationText"/></column>
                                <column><field-ref name="amountText"/><field-ref name="stateText"/><field-ref name="actions"/></column>
                            </columns>
                        </form-list>
                        <label text="The shared rates are every organization's: change them with no organization chosen." type="p"
                                style="m-muted q-px-md q-pt-sm text-caption" condition="laborSharedNote"/>
                        <label text="No labor costing rates: labor hours are unpriced in production, maintenance and cost reports until a rate covers them."
                                type="p" style="m-muted q-pa-md" condition="!laborRows.length"/>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
