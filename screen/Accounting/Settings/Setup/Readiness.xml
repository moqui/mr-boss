<!-- Setup step 4 (design-accounting §15 Setup, Readiness): every check activation needs, each with its state (ready, check,
    blocks activation), what it found and the screen that fixes it (mantle.ledger.SetupServices.check#Readiness):
    preferences, chart, periods, the posting guard, the migration and control accounts, mappings to summary accounts and
    to accounts not in the chart, the WIP and transfer accounts, the exchange rates of open documents in other currencies,
    sales tax,
    bank accounts, the paused past due email job, the balanced opening balances and the open items' tie-out. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Readiness"
        default-menu-index="4"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <actions>
        <service-call name="mantle.ledger.SetupServices.check#Readiness"
                in-map="{organizationPartyId:organizationPartyId}"
                out-map="readiness"/>
        <set field="fixPaths" from="{BASIS:'../Basis', PERIODS:'//Accounting/PeriodClose/Periods',
                POSTING_GUARD:'../../AccountingPreferences', EXCHANGE_RATES:'../../Currencies',
                TAX_METHOD:'../../AccountingPreferences', MIGRATION_ACCOUNT:'../Basis',
                CHART:'//Accounting/GeneralLedger/ChartOfAccounts',
                MAPPINGS_UNASSIGNED:'//Accounting/GeneralLedger/ChartOfAccounts',
                CONTROL_ACCOUNTS:'../../PostingDefaults', MAPPINGS_NOT_POSTABLE:'../../PostingDefaults',
                WIP_TRANSFER:'../../PostingDefaults', BANK_METHODS:'//Accounting/Banking/BankAccounts',
                OPENING_BALANCED:'../OpeningBalances', OPEN_ITEM_TIE:'../OpeningBalances'}"/>
        <set field="statusColors" from="{ok:'positive', warning:'warning', blocker:'negative'}"/>
        <set field="readinessRows" from="(readiness.readinessRows || []).map(row =&gt; Object.assign({}, row,
                {statusColor:statusColors[row.status], fixPath:(row.status === 'ok' ? null : fixPaths[row.code] || null)}))"/>
        <set field="summaryText" from="readiness.activated ? 'Accounting is active.'
                : readiness.ready ? 'Ready to activate' + (readiness.warningCount ? ': check ' + readiness.warningCount
                    + (readiness.warningCount == 1 ? ' item first.' : ' items first.') : '.')
                : readiness.blockerCount + (readiness.blockerCount == 1 ? ' check blocks' : ' checks block') + ' activation.'"/>
    </actions>
    <widgets>
        <container-box>
            <box-header title="Readiness"/>
            <box-body-nopad>
                <label text="${summaryText}" type="p" style="q-pa-md text-weight-medium"/>
                <form-list name="SetupReadiness" list="readinessRows" skip-form="true" paginate="false">
                    <field name="label">
                        <default-field title="Check">
                            <display/>
                        </default-field>
                    </field>
                    <field name="statusText">
                        <default-field title="State">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                                    statusColor}">${WebUtilities.encodeHtml(statusText)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: statusText})}]]></text>
                                <text type="html">${statusText}</text>
                                <text type="html-print">${statusText}</text>
                            </render-mode>
                        </default-field>
                    </field>
                    <field name="message">
                        <default-field title="Found">
                            <display/>
                        </default-field>
                    </field>
                    <field name="detailText">
                        <default-field title="Items">
                            <display/>
                        </default-field>
                    </field>
                    <field name="fix">
                        <default-field title="">
                            <link url="${fixPath}"
                                    text="Fix"
                                    icon="sym_o_arrow_forward"
                                    condition="fixPath"
                                    parameter-map="{organizationPartyId:organizationPartyId}"/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="label"/>
                            <field-ref name="message"/>
                        </column>
                        <column>
                            <field-ref name="statusText"/>
                            <field-ref name="fix"/>
                        </column>
                    </columns>
                </form-list>
            </box-body-nopad>
        </container-box>
    </widgets>
</screen>
