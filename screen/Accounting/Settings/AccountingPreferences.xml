<!-- Accounting preferences (design-accounting §15 AccountingPreferences): an organization's base currency, fiscal year,
    default due term, error journal and the opt-in controls, and the copy of another organization's missing configuration
    with its conflict preview (mantle.ledger.SetupServices.clone#Preferences). A change to the basis of posted history is
    refused. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Preferences"
        default-menu-index="2"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <parameter name="sourceOrganizationPartyId"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition-include name="selectOrganization" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition name="save">
        <actions>
            <service-call name="mantle.ledger.SetupServices.store#Preferences"
                    in-map="Object.assign({}, context, {settings:context})"
                    out-map="result"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="clone">
        <actions>
            <service-call name="mantle.ledger.SetupServices.clone#Preferences"
                    in-map="{organizationPartyId:organizationPartyId, sourceOrganizationPartyId:sourceOrganizationPartyId}"
                    out-map="result"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="applyClone">
        <actions>
            <service-call name="mantle.ledger.SetupServices.clone#Preferences"
                    in-map="Object.assign({}, context, {apply:true})"
                    out-map="result"/>
            <set field="sourceOrganizationPartyId" from="null"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="mantle.ledger.SetupServices.get#Context"
                in-map="{organizationPartyId:organizationPartyId}"
                out-map="context"/>
        <if condition="organizationPartyId &amp;&amp; sourceOrganizationPartyId">
            <service-call name="mantle.ledger.SetupServices.clone#Preferences"
                    in-map="{organizationPartyId:organizationPartyId, sourceOrganizationPartyId:sourceOrganizationPartyId}"
                    out-map="clonePreview"/>
        </if>
        <set field="cloneConflicts" from="clonePreview?.conflicts || []"/>
        <set field="cloneConfirmation"
                from="'Copy the missing setup? ' + cloneConflicts.length + ' existing entries stay as they are.'"/>
    </actions>
    <widgets>
        <label text="Accounting preferences" type="h5"/>
        <section-include name="OrganizationPicker" location="component://mr-boss/template/AccountingParts.xml"/>
        <section name="Preferences" condition="organizationPartyId">
            <widgets>
                <form-single name="Preferences" transition="save" map="settings">
                    <field name="organizationPartyId" from="organizationPartyId">
                        <default-field>
                            <hidden/>
                        </default-field>
                    </field>
                    <field name="lastUpdatedStamp">
                        <default-field>
                            <hidden/>
                        </default-field>
                    </field>
                    <field name="baseCurrencyUomId">
                        <default-field title="Base currency">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices"
                                        server-search="true"
                                        min-length="0"
                                        parameter-map="{choice:'currencies',
                                            organizationPartyId:organizationPartyId, selected:baseCurrencyUomId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="fiscalYearStartMonth">
                        <default-field title="Fiscal year starts in">
                            <drop-down allow-empty="true">
                                <option key="1" text="January"/>
                                <option key="2" text="February"/>
                                <option key="3" text="March"/>
                                <option key="4" text="April"/>
                                <option key="5" text="May"/>
                                <option key="6" text="June"/>
                                <option key="7" text="July"/>
                                <option key="8" text="August"/>
                                <option key="9" text="September"/>
                                <option key="10" text="October"/>
                                <option key="11" text="November"/>
                                <option key="12" text="December"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="fiscalYearStartDay">
                        <default-field title="On day">
                            <text-line size="3"/>
                        </default-field>
                    </field>
                    <field name="settlementTermId">
                        <default-field title="Default due term">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices"
                                        server-search="true"
                                        min-length="0"
                                        parameter-map="{choice:'terms',
                                            organizationPartyId:organizationPartyId, selected:settlementTermId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="taxGatewayConfigId">
                        <default-field title="Sales tax gateway"
                                tooltip="Calculates the tax of invoices without a store, or whose store has no gateway">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices"
                                        server-search="true"
                                        min-length="0"
                                        parameter-map="{choice:'taxGateways',
                                            organizationPartyId:organizationPartyId, selected:taxGatewayConfigId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="errorGlJournalId">
                        <default-field title="Error journal" tooltip="Where an automatic posting that fails waits for review">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices"
                                        server-search="true"
                                        min-length="0"
                                        parameter-map="{choice:'batches',
                                            organizationPartyId:organizationPartyId, selected:errorGlJournalId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="postingGuardEnabled">
                        <default-field title="Posting guard"
                                tooltip="Check locks, the organization and dimensions on every posting">
                            <radio>
                                <option key="N" text="Off"/>
                                <option key="Y" text="On"/>
                            </radio>
                        </default-field>
                    </field>
                    <field name="requiredLedgerDimensionsEnabled">
                        <default-field title="Required dimensions"
                                tooltip="Refuse a posting that lacks a facility or cost centre its account requires">
                            <radio>
                                <option key="N" text="Off"/>
                                <option key="Y" text="On"/>
                            </radio>
                        </default-field>
                    </field>
                    <field name="forwardIssuanceRepostEnabled">
                        <default-field title="Forward issuance adjustments"
                                tooltip="Post a dated adjustment for a changed issuance instead of reposting it">
                            <radio>
                                <option key="N" text="Off"/>
                                <option key="Y" text="On"/>
                            </radio>
                        </default-field>
                    </field>
                    <field name="allowAccountingSelfApproval">
                        <default-field title="Self approval"
                                tooltip="Let the person who drafted a record approve it; each such approval is marked">
                            <radio>
                                <option key="N" text="Off"/>
                                <option key="Y" text="On"/>
                            </radio>
                        </default-field>
                    </field>
                    <field name="singleCurrencyDocumentsOnly">
                        <default-field title="Base currency documents"
                                tooltip="Require invoices and bills to use the organization's base currency">
                            <radio>
                                <option key="N" text="Off"/>
                                <option key="Y" text="On"/>
                            </radio>
                        </default-field>
                    </field>
                    <field name="invoiceApprovalRequired">
                        <default-field title="Invoice approval"
                                tooltip="Require a finance approver to approve an invoice before it is finalized or sent">
                            <radio>
                                <option key="N" text="Off"/>
                                <option key="Y" text="On"/>
                            </radio>
                        </default-field>
                    </field>
                    <field name="inventoryRevaluationEnabled">
                        <default-field title="Inventory revaluation">
                            <radio>
                                <option key="N" text="Off"/>
                                <option key="Y" text="On"/>
                            </radio>
                        </default-field>
                    </field>
                    <field name="receiptInvoiceSelfBilledOnly">
                        <default-field title="Receipt bills"
                                tooltip="On: a delivered receipt bills itself only for a self-billing supplier, for the
                                    accepted quantity; other suppliers send their bills">
                            <radio>
                                <option key="N" text="Every receipt"/>
                                <option key="Y" text="Self-billing suppliers only"/>
                            </radio>
                        </default-field>
                    </field>
                    <field name="returnSettlementRequired">
                        <default-field title="Return settlement"
                                tooltip="On: approving or receiving a return credits nothing; finance settles what was
                                    received from the return">
                            <radio>
                                <option key="N" text="At approval and receipt"/>
                                <option key="Y" text="Settled by finance"/>
                            </radio>
                        </default-field>
                    </field>
                    <field name="salesInvoiceFinalizedAtShip">
                        <default-field title="Shipment invoices"
                                tooltip="On: the invoice made at pack stays a draft, with no payment applied, until the
                                    shipment ships">
                            <radio>
                                <option key="N" text="Finalized at pack"/>
                                <option key="Y" text="Finalized at ship"/>
                            </radio>
                        </default-field>
                    </field>
                    <field name="changeReason" from="''">
                        <default-field title="Reason">
                            <text-line/>
                        </default-field>
                    </field>
                    <field name="submit">
                        <default-field title="">
                            <submit text="Save preferences" type="primary"/>
                        </default-field>
                    </field>
                    <field-layout>
                        <field-row>
                            <field-ref name="baseCurrencyUomId"/>
                            <field-ref name="settlementTermId"/>
                        </field-row>
                        <field-row>
                            <field-ref name="fiscalYearStartMonth"/>
                            <field-ref name="fiscalYearStartDay"/>
                        </field-row>
                        <field-row>
                            <field-ref name="errorGlJournalId"/>
                            <field-ref name="taxGatewayConfigId"/>
                        </field-row>
                        <field-row>
                            <field-ref name="postingGuardEnabled"/>
                            <field-ref name="requiredLedgerDimensionsEnabled"/>
                        </field-row>
                        <field-row>
                            <field-ref name="forwardIssuanceRepostEnabled"/>
                            <field-ref name="allowAccountingSelfApproval"/>
                        </field-row>
                        <field-row>
                            <field-ref name="singleCurrencyDocumentsOnly"/>
                            <field-ref name="invoiceApprovalRequired"/>
                        </field-row>
                        <field-row>
                            <field-ref name="inventoryRevaluationEnabled"/>
                            <field-ref name="receiptInvoiceSelfBilledOnly"/>
                        </field-row>
                        <field-row>
                            <field-ref name="returnSettlementRequired"/>
                            <field-ref name="salesInvoiceFinalizedAtShip"/>
                        </field-row>
                        <field-ref name="changeReason"/>
                        <field-ref name="submit"/>
                    </field-layout>
                </form-single>
                <container-box type="info">
                    <box-body>
                        <label text="${costingMessage}" type="p" style="q-mb-none"/>
                    </box-body>
                </container-box>
                <label text="Copy from another organization" type="h6"/>
                <form-single name="ClonePreferences" transition="clone">
                    <field name="organizationPartyId" from="organizationPartyId">
                        <default-field>
                            <hidden/>
                        </default-field>
                    </field>
                    <field name="sourceOrganizationPartyId">
                        <default-field title="Copy the missing configuration of">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices"
                                        server-search="true"
                                        min-length="0"
                                        parameter-map="{choice:'organizations',
                                            organizationPartyId:organizationPartyId, selected:sourceOrganizationPartyId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="submit">
                        <default-field title="">
                            <submit text="Preview the copy"/>
                        </default-field>
                    </field>
                    <field-layout>
                        <field-row>
                            <field-ref name="sourceOrganizationPartyId"/>
                            <field-ref name="submit"/>
                        </field-row>
                    </field-layout>
                </form-single>
                <section name="CloneReview" condition="sourceOrganizationPartyId &amp;&amp; clonePreview">
                    <widgets>
                        <container-box>
                            <box-header title="${cloneConflicts.length ? cloneConflicts.length
                                        + ' existing entries stay as they are' : 'Nothing here conflicts'}"/>
                            <box-body>
                                <form-list name="CloneConflicts" list="cloneConflicts" skip-form="true" paginate="false">
                                    <field name="kind">
                                        <default-field title="Kind">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="key">
                                        <default-field title="Existing entry">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column>
                                            <field-ref name="kind"/>
                                        </column>
                                        <column>
                                            <field-ref name="key"/>
                                        </column>
                                    </columns>
                                </form-list>
                                <form-single name="ApplyClone" transition="applyClone">
                                    <field name="organizationPartyId" from="organizationPartyId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="sourceOrganizationPartyId" from="sourceOrganizationPartyId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="inputFingerprint" from="clonePreview.inputFingerprint">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="changeReason">
                                        <default-field title="Reason">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="submit">
                                        <default-field title="">
                                            <submit text="Copy missing configuration"
                                                    confirmation="${cloneConfirmation}"/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
            </widgets>
            <fail-widgets>
                <label text="Choose an organization to see and change its preferences." type="p"/>
            </fail-widgets>
        </section>
    </widgets>
</screen>
