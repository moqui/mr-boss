<!-- Currencies (design-accounting §15 Currencies; D17, AC-16, AC-19): the currency units and the dated exchange rates,
    entered one at a time, imported from CSV (each row stored or refused on its own, the result of each kept), or fetched
    from the organization's rate provider as proposals a finance administrator accepts or rejects
    (mantle.ledger.CurrencyServices). This is the only writer of either; postings convert to the base currency at these
    rates. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Currencies"
        default-menu-index="5"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <parameter name="importId"/>
    <parameter name="pageIndex"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition-include name="selectOrganization" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition name="rate">
        <actions>
            <service-call name="mantle.ledger.CurrencyServices.store#Rate" in-map="context" out-map="result"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="currency">
        <actions>
            <service-call name="mantle.ledger.CurrencyServices.store#Currency" in-map="context" out-map="result"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="fetchRates">
        <actions>
            <set field="chosenUomIds"
                    from="(Array.isArray(uomIdList) ? uomIdList : String(uomIdList || '').split(',')).filter(id =&gt; id)"/>
            <service-call name="mantle.ledger.CurrencyServices.refresh#Rates" out-map="result"
                    in-map="{organizationPartyId:organizationPartyId, sourceText:sourceText || null, uomIdList:chosenUomIds}"/>
            <if condition="result?.skippedUomIds?.length">
                <message type="warning">The provider has no rate for ${result.skippedUomIds.join(', ')}</message>
            </if>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="acceptRates">
        <actions>
            <service-call name="mantle.ledger.CurrencyServices.accept#RateProposals" out-map="result"
                    in-map="{organizationPartyId:organizationPartyId, rateProposalIdList:rateProposalIdList,
                        changeReason:changeReason}"/>
            <iterate list="(result?.results || []).filter(row =&gt; !row.success)" entry="failure">
                <message type="warning">${failure.message}</message>
            </iterate>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="rejectRates">
        <actions>
            <service-call name="mantle.ledger.CurrencyServices.reject#RateProposals" out-map="result"
                    in-map="{organizationPartyId:organizationPartyId, rateProposalIdList:rateProposalIdList}"/>
            <iterate list="(result?.results || []).filter(row =&gt; !row.success)" entry="failure">
                <message type="warning">${failure.message}</message>
            </iterate>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="import">
        <actions>
            <service-call name="mantle.ledger.CurrencyServices.import#Rates" in-map="context" out-map="result"/>
            <set field="importId" from="result.importId"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="mantle.ledger.SetupServices.get#Context"
                in-map="{organizationPartyId:organizationPartyId, pageIndex:pageIndex}"
                out-map="context"/>
        <if condition="importId">
            <service-call name="mantle.ledger.CurrencyServices.get#ImportResult"
                    in-map="{organizationPartyId:organizationPartyId, importId:importId}"
                    out-map="rateImport"/>
        </if>
        <set field="importResults" from="rateImport?.results || []"/>
        <set field="rateProviderName" from="settings?.rateProviderServiceName || null"/>
        <set field="proposals" from="[]"/>
        <if condition="organizationPartyId">
            <service-call name="mantle.ledger.CurrencyServices.get#RateProposals"
                    in-map="{organizationPartyId:organizationPartyId}" out-map="proposalOut"/>
            <set field="proposals" from="proposalOut.proposals || []"/>
        </if>
    </actions>
    <widgets>
        <label text="Currencies" type="h5"/>
        <section-include name="OrganizationPicker" location="component://mr-boss/template/AccountingParts.xml"/>
        <section name="Currencies" condition="organizationPartyId">
            <widgets>
                <container style="row q-gutter-sm q-mb-md">
                    <container-dialog id="AddRateDialog"
                            button-text="Add exchange rate"
                            type="primary"
                            icon="sym_o_add"
                            title="Add a dated exchange rate">
                        <form-single name="ExchangeRate" transition="rate">
                            <field name="organizationPartyId" from="organizationPartyId">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="uomId">
                                <default-field title="From currency">
                                    <drop-down allow-empty="true">
                                        <dynamic-options transition="choices"
                                                server-search="true"
                                                min-length="0"
                                                parameter-map="{choice:'currencies',
                                                    organizationPartyId:organizationPartyId, selected:uomId}"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="toUomId">
                                <default-field title="To currency">
                                    <drop-down allow-empty="true">
                                        <dynamic-options transition="choices"
                                                server-search="true"
                                                min-length="0"
                                                parameter-map="{choice:'currencies',
                                                    organizationPartyId:organizationPartyId, selected:toUomId}"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="fromDate">
                                <default-field title="Effective from">
                                    <date-time/>
                                </default-field>
                            </field>
                            <field name="thruDate">
                                <default-field title="Through">
                                    <date-time/>
                                </default-field>
                            </field>
                            <field name="conversionFactor">
                                <default-field title="Rate">
                                    <text-line size="12"/>
                                </default-field>
                            </field>
                            <field name="rateSource">
                                <default-field title="Source">
                                    <text-line/>
                                </default-field>
                            </field>
                            <field name="changeReason">
                                <default-field title="Reason">
                                    <text-line/>
                                </default-field>
                            </field>
                            <field name="submit">
                                <default-field title="">
                                    <submit text="Save dated rate"/>
                                </default-field>
                            </field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="NewCurrencyDialog" button-text="New currency" icon="sym_o_add" title="New currency">
                        <form-single name="Currency" transition="currency">
                            <field name="organizationPartyId" from="organizationPartyId">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="uomId">
                                <default-field title="Currency code">
                                    <text-line size="5"/>
                                </default-field>
                            </field>
                            <field name="description">
                                <default-field title="Name">
                                    <text-line/>
                                </default-field>
                            </field>
                            <field name="fractionDigits">
                                <default-field title="Decimals">
                                    <text-line size="2"/>
                                </default-field>
                            </field>
                            <field name="changeReason">
                                <default-field title="Reason">
                                    <text-line/>
                                </default-field>
                            </field>
                            <field name="submit">
                                <default-field title="">
                                    <submit text="Save currency"/>
                                </default-field>
                            </field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="FetchRatesDialog"
                            button-text="Fetch rates"
                            icon="sym_o_sync"
                            title="Fetch the day's rates from the provider"
                            condition="rateProviderName">
                        <form-single name="FetchRates" transition="fetchRates">
                            <field name="organizationPartyId" from="organizationPartyId">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="uomIdList">
                                <default-field title="Currencies"
                                        tooltip="Leave empty for the currencies of the organization's invoices and payments">
                                    <drop-down allow-empty="true" allow-multiple="true">
                                        <dynamic-options transition="choices"
                                                server-search="true"
                                                min-length="0"
                                                parameter-map="{choice:'currencies', organizationPartyId:organizationPartyId}"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="sourceText">
                                <default-field title="Provider's file"
                                        tooltip="Paste the provider's daily file when the server cannot reach the provider">
                                    <text-area rows="6" cols="70"/>
                                </default-field>
                            </field>
                            <field name="submit">
                                <default-field title="">
                                    <submit text="Propose rates"/>
                                </default-field>
                            </field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="ImportRatesDialog"
                            button-text="Import rates"
                            icon="sym_o_add"
                            title="Import exchange rates from CSV">
                        <form-single name="ImportRates" transition="import">
                            <field name="organizationPartyId" from="organizationPartyId">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="csvText">
                                <default-field title="CSV rows"
                                        tooltip="Columns: uomId, toUomId, fromDate, thruDate, conversionFactor, rateSource">
                                    <text-area rows="8" cols="70"/>
                                </default-field>
                            </field>
                            <field name="changeReason">
                                <default-field title="Reason">
                                    <text-line/>
                                </default-field>
                            </field>
                            <field name="submit">
                                <default-field title="">
                                    <submit text="Import rate rows"/>
                                </default-field>
                            </field>
                        </form-single>
                    </container-dialog>
                </container>
                <section name="ImportResults" condition="importId">
                    <widgets>
                        <container-box>
                            <box-header title="Rate import: ${importResults.filter(row =&gt;
                                        row.success).length} stored, ${importResults.filter(row =&gt;
                                        !row.success).length} refused"/>
                            <box-body>
                                <form-list name="RateImportResults"
                                        list="importResults"
                                        skip-form="true"
                                        paginate="false"
                                        show-csv-button="true">
                                    <field name="rowNumber">
                                        <default-field title="Row">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="success">
                                        <default-field title="Result">
                                            <render-mode>
                                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                                                    success ? 'positive' : 'negative'}">${success ? 'Stored'
                                                    : 'Refused'}</q-chip>]]></text>
                                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong",
                                                    text: success ? 'Stored' : 'Refused'})}]]></text>
                                            </render-mode>
                                        </default-field>
                                    </field>
                                    <field name="message">
                                        <default-field title="Detail">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column>
                                            <field-ref name="rowNumber"/>
                                            <field-ref name="message"/>
                                        </column>
                                        <column>
                                            <field-ref name="success"/>
                                        </column>
                                    </columns>
                                </form-list>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
                <section name="ProposedRates" condition="proposals.length">
                    <widgets>
                        <container-box>
                            <box-header title="Proposed rates: ${proposals.length} to accept or reject"/>
                            <box-body-nopad>
                                <form-list name="RateProposals"
                                        list="proposals"
                                        skip-form="true"
                                        paginate="false"
                                        header-dialog="true">
                                    <row-selection id-field="rateProposalId" parameter="rateProposalIdList" list-mode="true">
                                        <action>
                                            <dialog button-text="Accept selected" title="Make the selected rates active"/>
                                            <form-single name="AcceptRates" transition="acceptRates">
                                                <field name="organizationPartyId" from="organizationPartyId">
                                                    <default-field>
                                                        <hidden/>
                                                    </default-field>
                                                </field>
                                                <field name="changeReason">
                                                    <default-field title="Reason">
                                                        <text-line/>
                                                    </default-field>
                                                </field>
                                                <field name="submit">
                                                    <default-field title="">
                                                        <submit text="Accept selected rates"/>
                                                    </default-field>
                                                </field>
                                            </form-single>
                                        </action>
                                        <action>
                                            <dialog button-text="Reject selected" title="Reject the selected rates"/>
                                            <form-single name="RejectRates" transition="rejectRates">
                                                <field name="organizationPartyId" from="organizationPartyId">
                                                    <default-field>
                                                        <hidden/>
                                                    </default-field>
                                                </field>
                                                <field name="submit">
                                                    <default-field title="">
                                                        <submit text="Reject selected rates" btn-type="danger"/>
                                                    </default-field>
                                                </field>
                                            </form-single>
                                        </action>
                                    </row-selection>
                                    <field name="uomId">
                                        <default-field title="From">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="toUomId">
                                        <default-field title="To">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="conversionFactor" align="right">
                                        <default-field title="Rate">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="rateDate">
                                        <default-field title="For">
                                            <display text="${rateDateText}"/>
                                        </default-field>
                                    </field>
                                    <field name="rateSource">
                                        <default-field title="Source">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column>
                                            <field-ref name="uomId"/>
                                            <field-ref name="toUomId"/>
                                        </column>
                                        <column>
                                            <field-ref name="conversionFactor"/>
                                            <field-ref name="rateDate"/>
                                        </column>
                                    </columns>
                                </form-list>
                            </box-body-nopad>
                        </container-box>
                    </widgets>
                </section>
                <label text="Exchange rates" type="h6"/>
                <label text="No exchange rates yet. Add one, or import them from CSV." type="p" condition="!rates.length"/>
                <form-list name="ExchangeRates"
                        list="rates"
                        skip-form="true"
                        paginate="false"
                        select-columns="true"
                        show-csv-button="true"
                        show-xlsx-button="true">
                    <field name="uomId">
                        <default-field title="From">
                            <display/>
                        </default-field>
                    </field>
                    <field name="toUomId">
                        <default-field title="To">
                            <display/>
                        </default-field>
                    </field>
                    <field name="conversionFactor" align="right">
                        <default-field title="Rate">
                            <display/>
                        </default-field>
                    </field>
                    <field name="fromDate">
                        <default-field title="Effective from">
                            <display text="${fromDateText}"/>
                        </default-field>
                    </field>
                    <field name="rateSource">
                        <default-field title="Source">
                            <display/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="uomId"/>
                            <field-ref name="toUomId"/>
                        </column>
                        <column>
                            <field-ref name="conversionFactor"/>
                            <field-ref name="fromDate"/>
                        </column>
                    </columns>
                </form-list>
                <label text="Currency units" type="h6"/>
                <form-list name="CurrencyList"
                        list="currencies"
                        skip-form="true"
                        paginate="true"
                        select-columns="true"
                        show-csv-button="true">
                    <field name="description">
                        <default-field title="Currency">
                            <display text="${description || uomId}"/>
                        </default-field>
                    </field>
                    <field name="uomId">
                        <default-field title="Code">
                            <display/>
                        </default-field>
                    </field>
                    <field name="fractionDigits" align="right">
                        <default-field title="Decimals">
                            <display/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="description"/>
                        </column>
                        <column>
                            <field-ref name="uomId"/>
                        </column>
                    </columns>
                </form-list>
            </widgets>
            <fail-widgets>
                <label text="Choose an organization to see and change its currencies and rates." type="p"/>
            </fail-widgets>
        </section>
    </widgets>
</screen>
