<!-- Banking: the organization's bank accounts and their statements. Bank lines are imported (StatementImport), matched
    with payments, deposits or ledger entries on a bank account (BankAccountDetail) or by rules (BankRules), and a
    statement session clears them to a zero difference (Reconciliations, ReconciliationDetail). Stored-value accounts
    are FinancialAccounts. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Banking"
        menu-image="sym_o_account_balance_wallet"
        menu-image-type="icon"
        default-menu-index="5"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <subscreens default-item="BankAccounts" always-use-full-path="true"/>
    <widgets>
        <subscreens-panel id="BankingPanel" type="tab"/>
    </widgets>
</screen>
