<!-- A stored-value account (style-guide §3.3 Detail): the header with the account, its type, owner and currency, its
    status chip, Deposit as the primary action and Withdraw and Adjust under More; its balance and available balance;
    and its transactions, newest first (ironstone.accounting.BankServices.get#FinancialAccount). Each movement goes
    through mantle.account.FinancialAccountServices.record#FinancialAccountMovement (payment edit authority in the
    account's organization), which refuses one that cannot post, and answers the balance before and after. An account
    the user may not see is "not available". -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Stored-value account"
        default-menu-include="false">
    <parameter name="organizationPartyId"/>
    <parameter name="finAccountId"/>
    <parameter name="pageIndex"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition name="depositValue">
        <actions>
            <!-- the user's own movement: refused, not sent to the error journal, when it cannot post -->
            <service-call name="mantle.account.FinancialAccountServices.record#FinancialAccountMovement" out-map="moved"
                    in-map="{finAccountId:finAccountId, movement:'deposit', amount:amount, reasonEnumId:reasonEnumId || null,
                        transactionDate:transactionDate || null}"/>
            <message>The balance went from ${moved.preBalance} to ${moved.postBalance}.</message>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="withdrawValue">
        <actions>
            <!-- the user's own movement: refused, not sent to the error journal, when it cannot post -->
            <service-call name="mantle.account.FinancialAccountServices.record#FinancialAccountMovement" out-map="moved"
                    in-map="{finAccountId:finAccountId, movement:'withdraw', amount:amount, reasonEnumId:reasonEnumId || null,
                        transactionDate:transactionDate || null}"/>
            <message>The balance went from ${moved.preBalance} to ${moved.postBalance}.</message>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="adjustValue">
        <actions>
            <!-- the user's own movement: refused, not sent to the error journal, when it cannot post -->
            <service-call name="mantle.account.FinancialAccountServices.record#FinancialAccountMovement" out-map="moved"
                    in-map="{finAccountId:finAccountId, movement:'adjust', amount:amount, reasonEnumId:reasonEnumId || null,
                        transactionDate:transactionDate || null}"/>
            <message>The balance went from ${moved.preBalance} to ${moved.postBalance}.</message>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <actions>
        <set field="financialAccount" from="{}"/>
        <set field="records" from="[]"/>
        <set field="canEdit" from="false"/>
        <service-call name="ironstone.accounting.BankServices.get#FinancialAccount"
                in-map="{finAccountId:finAccountId, pageIndex:pageIndex || 0}"
                out-map="context"
                transaction="force-new"
                ignore-error="true"/>
        <set field="recordFound" from="!!financialAccount?.finAccountId"/>
        <set field="organizationPartyId" from="financialAccount.organizationPartyId || organizationPartyId"/>
        <!-- the printed record, its evidence (design-accounting §17): this screen in html-print -->
        <set field="printScreen" value="Banking/FinancialAccountDetail"/>
        <set field="printOptions" from="{finAccountId:finAccountId, organizationPartyId:organizationPartyId}"/>
    </actions>
    <widgets>
        <section name="FinancialAccountNotAvailable" condition="!recordFound">
            <widgets>
                <container-box type="warning">
                    <box-body>
                        <label text="This stored-value account is not available." type="p"/>
                        <link url="${sharedLinks['Banking/FinancialAccounts']}"
                                text="Stored-value accounts"
                                link-type="anchor"
                                icon="arrow_back"
                                parameter-map="{organizationPartyId:organizationPartyId}"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="FinancialAccountFound" condition="recordFound">
            <widgets>
                <link url="${sharedLinks['Banking/FinancialAccounts']}"
                        text="Stored-value accounts"
                        link-type="anchor"
                        icon="arrow_back"
                        parameter-map="{organizationPartyId:organizationPartyId}"/>
                <container style="m-record-header">
                    <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                        <container style="col-12 col-md m-record-title">
                            <container style="row items-center no-wrap">
                                <render-mode>
                                    <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none q-mr-sm text-mono">${
                                        WebUtilities.encodeHtml(finAccountId)}</q-chip>]]></text>
                                    <text type="tui"><![CDATA[${JSON.stringify({t: "text", id: "FinancialAccountKey",
                                        style: "strong", text: finAccountId})}]]></text>
                                </render-mode>
                                <label text="${financialAccount.finAccountName || finAccountId}" type="h5"/>
                            </container>
                        </container>
                        <container style="col-12 col-md-auto m-record-status">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                                    financialAccount.statusColor}">${WebUtilities.encodeHtml(financialAccount.statusText)
                                    }</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", id: "FinancialAccountStatus",
                                    style: "strong", text: financialAccount.statusText})}]]></text>
                                <text type="html">${financialAccount.statusText}</text>
                            </render-mode>
                        </container>
                    </container>
                    <container style="row items-center q-col-gutter-x-md q-col-gutter-y-sm m-record-foot">
                        <container style="col-12 col-md">
                            <label text="${[financialAccount.typeText, financialAccount.ownerName, financialAccount.currencyUomId]
                                    .filter(Boolean).join(' · ')}"
                                    type="p"
                                    style="q-mb-none"/>
                        </container>
                        <container style="col-12 col-md-auto row items-center q-gutter-sm m-record-actions">
                            <container-dialog id="DepositValue"
                                    button-text="Deposit"
                                    title="Deposit into ${financialAccount.finAccountName}"
                                    width="560"
                                    type="primary"
                                    condition="canEdit">
                                <form-single name="DepositValueForm" transition="depositValue">
                                    <field name="finAccountId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="amount">
                                        <default-field title="Amount">
                                            <text-line required="true"/>
                                        </default-field>
                                    </field>
                                    <field name="reasonEnumId">
                                        <default-field title="Reason">
                                            <drop-down allow-empty="true">
                                                <dynamic-options transition="choices"
                                                        server-search="true"
                                                        min-length="0"
                                                        parameter-map="{choice:'enum:FinancialAccountTransReason',
                                                            organizationPartyId:organizationPartyId}"/>
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="transactionDate">
                                        <default-field title="Date">
                                            <date-time type="date"/>
                                        </default-field>
                                    </field>
                                    <field name="submit">
                                        <default-field title="">
                                            <submit text="Deposit"
                                                    confirmation="Deposit this amount into ${financialAccount.finAccountName}?"/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </container-dialog>
                            <section-include name="RecordPrint"
                                    location="component://mr-boss/template/AccountingReportParts.xml"/>
                            <button-menu text="More" icon="more_horiz" condition="canEdit">
                                <container-dialog id="WithdrawValue"
                                        button-text="Withdraw"
                                        title="Withdraw from ${financialAccount.finAccountName}"
                                        width="560"
                                        type="default">
                                    <form-single name="WithdrawValueForm" transition="withdrawValue" extends="DepositValueForm">
                                        <field name="submit">
                                            <default-field title="">
                                                <submit text="Withdraw"
                                                        confirmation="Withdraw this amount from ${
                                                            financialAccount.finAccountName}?"/>
                                            </default-field>
                                        </field>
                                    </form-single>
                                </container-dialog>
                                <container-dialog id="AdjustValue"
                                        button-text="Adjust"
                                        title="Adjust ${financialAccount.finAccountName}"
                                        width="560"
                                        type="default">
                                    <form-single name="AdjustValueForm" transition="adjustValue" extends="DepositValueForm">
                                        <field name="submit">
                                            <default-field title="">
                                                <submit text="Adjust"
                                                        confirmation="Adjust ${financialAccount.finAccountName} by this amount?"/>
                                            </default-field>
                                        </field>
                                    </form-single>
                                </container-dialog>
                            </button-menu>
                        </container>
                    </container>
                </container>
                <dashboard min-width="180">
                    <number-card title="Balance"
                            value="${ec.l10n.formatCurrency(financialAccount.actualBalance ?? 0,
                                financialAccount.currencyUomId)}"/>
                    <number-card title="Available"
                            value="${ec.l10n.formatCurrency(financialAccount.availableBalance ?? 0,
                                financialAccount.currencyUomId)}"/>
                </dashboard>
                <container-box>
                    <box-header title="Transactions"/>
                    <box-body-nopad>
                        <label text="No transactions yet." type="p" style="q-pa-md m-muted" condition="!records.length"/>
                        <form-list name="FinancialTransactions" list="records" skip-form="true" paginate="true">
                            <field name="transactionDateText">
                                <default-field title="Date">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="typeText">
                                <default-field title="Type">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="reasonText">
                                <default-field title="Reason">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="amount" align="right">
                                <default-field title="Amount">
                                    <display currency-unit-field="currencyUomId"/>
                                </default-field>
                            </field>
                            <field name="postBalance" align="right">
                                <default-field title="Balance after">
                                    <display currency-unit-field="currencyUomId"/>
                                </default-field>
                            </field>
                            <field name="paymentId">
                                <default-field title="Payment">
                                    <link url="${sharedLinks['Payments/PaymentDetail']}"
                                            text="${paymentId}"
                                            link-type="anchor"
                                            condition="paymentId"
                                            parameter-map="{recordId:paymentId, organizationPartyId:organizationPartyId}"/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="transactionDateText"/>
                                    <field-ref name="typeText"/>
                                </column>
                                <column>
                                    <field-ref name="amount"/>
                                    <field-ref name="postBalance"/>
                                </column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
