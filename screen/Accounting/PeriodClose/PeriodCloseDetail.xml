<!-- Close a fiscal period (design-accounting §9 PeriodCloseDetail): the header with the period, its state chip, Close
    period as the primary action while nothing blocks it and Reopen period under More once closed; the checklist of
    mantle.ledger.CloseServices.get#Checklist, each row with its count and its items, each item linked to the screen that
    resolves it; the period's reports; and the close history. close#Period and reopen#Period check FISCAL_CLOSE and
    FISCAL_REOPEN and run the checklist again under the period's lock. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Close period"
        default-menu-include="false">
    <parameter name="organizationPartyId"/>
    <parameter name="timePeriodId"/>
    <transition name="closePeriod" begin-transaction="false">
        <actions>
            <service-call name="mantle.ledger.CloseServices.close#Period"
                    in-map="{organizationPartyId:organizationPartyId, timePeriodId:timePeriodId, changeReason:changeReason,
                        operationKey:operationKey}"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="reopenPeriod">
        <actions>
            <service-call name="mantle.ledger.CloseServices.reopen#Period"
                    in-map="{organizationPartyId:organizationPartyId, timePeriodId:timePeriodId, changeReason:changeReason}"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="mantle.ledger.CloseServices.get#Checklist"
                in-map="{organizationPartyId:organizationPartyId, timePeriodId:timePeriodId}"
                out-map="closeContext"
                transaction="force-new"
                ignore-error="true"/>
        <set field="recordFound" from="!!closeContext?.period"/>
        <set field="period" from="closeContext?.period || {}"/>
        <set field="isClosed" from="period.isClosed == 'Y'"/>
        <set field="periodTitle" from="period.periodName || period.timePeriodId || timePeriodId"/>
        <!-- the screen that resolves an item, by the kind of record it names -->
        <set field="itemRoutes" from="{invoices:['Receivables/InvoiceDetail', 'recordId'],
                bills:['Payables/BillDetail', 'recordId'],
                payments:['Payments/PaymentDetail', 'recordId'], journals:['GeneralLedger/JournalEntryDetail', 'recordId'],
                banks:['Banking/BankAccountDetail', 'paymentMethodId'],
                periods:['PeriodClose/PeriodCloseDetail', 'timePeriodId']}"/>
        <set field="statusLabels" from="{clear:['Clear', 'positive'], blocked:['Blocks the close', 'negative'],
                warning:['Review', 'warning'], unavailable:['Unavailable', 'negative']}"/>
        <set field="checkRows" from="Array.from(closeContext?.checkRows || []).map((row) =&gt; Object.assign({}, row, {
                statusText: statusLabels[row.status][0], statusColor: statusLabels[row.status][1],
                countText: row.count == null ? '' : String(row.count),
                moreText: row.count &gt; row.items.length ? (row.count - row.items.length) + ' more' : '',
                items: Array.from(row.items).map((item) =&gt; Object.assign({}, item, {
                    linkUrl: itemRoutes[item.recordKind] ? sharedLinks[itemRoutes[item.recordKind][0]] : null,
                    linkField: itemRoutes[item.recordKind] ? itemRoutes[item.recordKind][1] : 'recordId'}))}))"/>
        <set field="openRows" from="checkRows.filter((row) =&gt; row.status != 'clear')"/>
        <set field="clearCount" from="checkRows.length - openRows.length"/>
        <set field="closeRuns" from="Array.from(closeContext?.closeRuns || [])"/>
        <set field="reportParameters" from="{organizationPartyId:organizationPartyId, timePeriodId:timePeriodId}"/>
        <set field="closeKey" from="ec.resource.script('component://mr-boss/service/ironstone/accounting/AccountingLib.js')
                .operationKey('close')"/>
    </actions>
    <widgets>
        <section name="PeriodNotAvailable" condition="!recordFound">
            <widgets>
                <container-box type="warning">
                    <box-body>
                        <label text="This fiscal period is not available." type="p"/>
                        <link url="${sharedLinks['PeriodClose/Periods']}"
                                text="Fiscal periods"
                                link-type="anchor"
                                icon="arrow_back"
                                parameter-map="{organizationPartyId:organizationPartyId}"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="PeriodFound" condition="recordFound">
            <widgets>
                <link url="${sharedLinks['PeriodClose/Periods']}"
                        text="Fiscal periods"
                        link-type="anchor"
                        icon="arrow_back"
                        parameter-map="{organizationPartyId:organizationPartyId}"/>
                <container style="m-record-header">
                    <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                        <container style="col-12 col-md m-record-title">
                            <container style="row items-center no-wrap">
                                <render-mode>
                                    <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none q-mr-sm text-mono">${
                                        WebUtilities.encodeHtml(period.timePeriodId)}</q-chip>]]></text>
                                    <text type="tui"><![CDATA[${JSON.stringify({t: "text", id: "PeriodKey", style: "strong",
                                        text: period.timePeriodId})}]]></text>
                                </render-mode>
                                <label text="${periodTitle}" type="h5"/>
                            </container>
                        </container>
                        <container style="col-12 col-md-auto m-record-status">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${isClosed
                                    ? 'grey-8' : 'positive'}">${isClosed ? 'Closed' : 'Open'}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", id: "PeriodState", style: "strong",
                                    text: isClosed ? 'Closed' : 'Open'})}]]></text>
                                <text type="html">${isClosed ? 'Closed' : 'Open'}</text>
                            </render-mode>
                        </container>
                    </container>
                    <container style="row items-center q-col-gutter-x-md q-col-gutter-y-sm m-record-foot">
                        <container style="col-12 col-md">
                            <label text="${period.fromDay} – ${period.thruDay}" type="p" style="q-mb-none"/>
                        </container>
                        <container style="col-12 col-md-auto row items-center q-gutter-sm m-record-actions">
                            <container-dialog id="ClosePeriodDialog"
                                    button-text="Close period"
                                    title="Close ${periodTitle}"
                                    width="640"
                                    type="primary"
                                    condition="closeContext.canClose">
                                <label text="Closing posts no more entries into ${periodTitle}, stores its account summaries
                                    and, for a fiscal year, posts its closing entries."
                                        type="p"/>
                                <form-single name="ClosePeriod" transition="closePeriod">
                                    <field name="organizationPartyId" from="organizationPartyId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="timePeriodId" from="timePeriodId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="operationKey" from="closeKey">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="changeReason">
                                        <default-field title="Reason">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="submit">
                                        <default-field title="">
                                            <submit text="Close period" confirmation="Close ${periodTitle}?"/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </container-dialog>
                            <link url="."
                                    text="Check again"
                                    icon="sym_o_refresh"
                                    link-type="anchor-button"
                                    condition="!isClosed"
                                    parameter-map="reportParameters"/>
                            <button-menu text="More" icon="more_horiz" condition="closeContext.canReopen">
                                <container-dialog id="ReopenPeriodDialog"
                                        button-text="Reopen period"
                                        title="Reopen ${periodTitle}"
                                        width="640"
                                        type="danger">
                                    <label text="Reopening lets entries post into the period again. Its close stays in the
                                        history, marked reopened."
                                            type="p"/>
                                    <form-single name="ReopenPeriod" transition="reopenPeriod">
                                        <field name="organizationPartyId" from="organizationPartyId">
                                            <default-field>
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="timePeriodId" from="timePeriodId">
                                            <default-field>
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="changeReason">
                                            <default-field title="Reason">
                                                <text-line required="true"/>
                                            </default-field>
                                        </field>
                                        <field name="submit">
                                            <default-field title="">
                                                <submit text="Reopen period" type="danger"
                                                        confirmation="Reopen ${periodTitle}?"/>
                                            </default-field>
                                        </field>
                                    </form-single>
                                </container-dialog>
                            </button-menu>
                        </container>
                    </container>
                </container>
                <section name="ClosedNote" condition="isClosed">
                    <widgets>
                        <container-box type="info">
                            <box-body>
                                <label text="This period is closed: postings dated in it are refused." type="p"
                                        style="q-mb-none"/>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
                <section name="Checklist" condition="!isClosed">
                    <widgets>
                        <label text="${closeContext.blockerCount} checks keep the period from closing. Resolve each item,
                            then check again."
                                type="p"
                                style="text-negative"
                                condition="closeContext.blockerCount &gt; 0"/>
                        <label text="Nothing keeps the period from closing." type="p" style="text-positive"
                                condition="closeContext.blockerCount == 0"/>
                        <section-iterate name="CheckRows" list="openRows" entry="checkRow">
                            <widgets>
                                <container-box>
                                    <box-header title="${checkRow.title} (${checkRow.countText || 'unavailable'})"/>
                                    <box-toolbar>
                                        <render-mode>
                                            <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                                                checkRow.statusColor}">${WebUtilities.encodeHtml(checkRow.statusText)
                                                }</q-chip>]]></text>
                                            <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong",
                                                text: checkRow.statusText})}]]></text>
                                            <text type="html">${checkRow.statusText}</text>
                                        </render-mode>
                                    </box-toolbar>
                                    <box-body>
                                        <label text="${checkRow.message}" type="p" condition="checkRow.message"/>
                                        <section-iterate name="CheckItems" list="checkRow.items" entry="checkItem">
                                            <widgets>
                                                <container style="row items-center q-col-gutter-sm">
                                                    <container style="col-12 col-md">
                                                        <link url="${checkItem.linkUrl}"
                                                                text="${checkItem.text}"
                                                                link-type="anchor"
                                                                condition="checkItem.linkUrl"
                                                                parameter-map="{[checkItem.linkField]:checkItem.recordId,
                                                                    organizationPartyId:organizationPartyId}"/>
                                                        <label text="${checkItem.text}" type="span"
                                                                condition="!checkItem.linkUrl"/>
                                                    </container>
                                                    <container style="col-12 col-md-auto">
                                                        <label text="${checkItem.detail}" type="span" style="m-muted"
                                                                condition="checkItem.detail"/>
                                                    </container>
                                                </container>
                                            </widgets>
                                        </section-iterate>
                                        <label text="${checkRow.moreText}" type="p" style="text-caption m-muted"
                                                condition="checkRow.moreText"/>
                                    </box-body>
                                </container-box>
                            </widgets>
                        </section-iterate>
                        <label text="${clearCount} other checks are clear." type="p" style="text-caption m-muted"/>
                    </widgets>
                </section>
                <container-box>
                    <box-header title="Reports of the period"/>
                    <box-body>
                        <container style="row q-gutter-sm">
                            <link url="${sharedLinks['Reports/TrialBalance']}"
                                    text="Trial balance"
                                    link-type="anchor-button"
                                    parameter-map="reportParameters"/>
                            <link url="${sharedLinks['Reports/InvoiceReconciliation']}"
                                    text="Invoice reconciliation"
                                    link-type="anchor-button"
                                    parameter-map="reportParameters"/>
                            <link url="${sharedLinks['PeriodClose/PeriodRuns']}"
                                    text="Period runs"
                                    link-type="anchor-button"
                                    parameter-map="reportParameters"/>
                        </container>
                    </box-body>
                </container-box>
                <section name="CloseHistory" condition="closeRuns.length">
                    <widgets>
                        <container-box>
                            <box-header title="Close history"/>
                            <box-body-nopad>
                                <form-list name="CloseRuns" list="closeRuns" skip-form="true" paginate="false">
                                    <field name="closedDateText">
                                        <default-field title="Closed">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="closedByUserId">
                                        <default-field title="By">
                                            <display-entity entity-name="moqui.security.UserAccount"
                                                    text="${userFullName || username}"/>
                                        </default-field>
                                    </field>
                                    <field name="closeReason">
                                        <default-field title="Reason">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="statusId">
                                        <default-field title="State">
                                            <render-mode>
                                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                                                    statusId == 'CrnClosed' ? 'grey-8' : 'warning'}">${statusId == 'CrnClosed'
                                                    ? 'Closed' : 'Reopened'}</q-chip>]]></text>
                                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong",
                                                    text: statusId == 'CrnClosed' ? 'Closed' : 'Reopened'})}]]></text>
                                                <text type="html">${statusId == 'CrnClosed' ? 'Closed' : 'Reopened'}</text>
                                            </render-mode>
                                        </default-field>
                                    </field>
                                    <field name="reopenReason">
                                        <default-field title="Reopened because">
                                            <display text="${reopenReason ? reopenReason + ' (' + reopenedDateText + ')' : ''}"/>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column>
                                            <field-ref name="closedDateText"/>
                                            <field-ref name="closeReason"/>
                                        </column>
                                        <column>
                                            <field-ref name="statusId"/>
                                        </column>
                                    </columns>
                                </form-list>
                            </box-body-nopad>
                        </container-box>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
