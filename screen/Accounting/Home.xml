<!-- The Accounting landing (design-accounting §3; style-guide §3.1): the active organization, the counts and amounts the
    user may read, each a link to the list or report behind it (ironstone.accounting.HomeServices.get#Summary; a figure
    that fails is named as unavailable, never shown as zero), the setup findings, the work waiting for the user
    (MyFinanceWork) and shortcuts to what the user may create. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Home"
        menu-image="sym_o_dashboard"
        menu-image-type="icon"
        default-menu-index="1"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition-include name="selectOrganization" location="component://mr-boss/template/AccountingParts.xml"/>
    <actions>
        <service-call name="ironstone.accounting.HomeServices.get#Summary"
                in-map="{organizationPartyId:organizationPartyId}"
                out-map="context"/>
        <set field="capabilities" from="accounting.capabilities"/>
        <set field="ledgerReader" from="capabilities.reportRead || capabilities.glPost"/>
        <set field="organizationQuery"
                from="organizationPartyId ? '&amp;organizationPartyId=' + encodeURIComponent(organizationPartyId) : ''"/>
        <set field="counts"
                from="Object.fromEntries(['unposted', 'posted', 'accounts', 'periods', 'unmatched', 'unpostedDocuments']
                    .map(name =&gt; [name, summary[name] == null ? 'Unavailable' : String(summary[name])]))"/>
        <set field="amounts"
                from="Object.fromEntries(['arDue', 'arOverdue', 'apDue', 'bankBalance'].map(name =&gt; [name,
                    summary[name] == null ? 'Unavailable' : ec.l10n.formatCurrency(summary[name], summary.currencyUomId)]))"/>
        <set field="arReader" from="capabilities.reportRead || capabilities.arRead || capabilities.admin"/>
        <set field="apReader" from="capabilities.reportRead || capabilities.apRead || capabilities.admin"/>
        <set field="bankReader" from="capabilities.reportRead || capabilities.bankReconcile || capabilities.admin"/>
        <set field="closeWorker" from="capabilities.glPost || capabilities.fiscalClose || capabilities.admin"/>
        <set field="unpostedPeriodId" from="encodeURIComponent(summary.unpostedPeriodId || '')"/>
    </actions>
    <widgets>
        <label text="Accounting" type="h5"/>
        <section-include name="OrganizationPicker" location="component://mr-boss/template/AccountingParts.xml"/>
        <dashboard min-width="150">
            <number-card title="Draft entries"
                    value="${counts.unposted}"
                    link="//Accounting/GeneralLedger/JournalEntries?isPosted=N${organizationQuery}"
                    condition="ledgerReader"/>
            <number-card title="Posted entries"
                    value="${counts.posted}"
                    link="//Accounting/GeneralLedger/JournalEntries?isPosted=Y${organizationQuery}"
                    condition="ledgerReader"/>
            <number-card title="Chart accounts"
                    value="${counts.accounts}"
                    link="//Accounting/GeneralLedger/ChartOfAccounts?${organizationQuery.slice(1)}"
                    condition="ledgerReader"/>
            <number-card title="Fiscal periods"
                    value="${counts.periods}"
                    link="//Accounting/PeriodClose/Periods?${organizationQuery.slice(1)}"
                    condition="capabilities.glPost || capabilities.fiscalClose"/>
            <number-card title="Receivables due"
                    value="${amounts.arDue}"
                    link="//Accounting/Reports/Aging?invoiceType=receivable${organizationQuery}"
                    condition="organizationPartyId &amp;&amp; arReader"/>
            <number-card title="Receivables overdue"
                    value="${amounts.arOverdue}"
                    link="//Accounting/Receivables/Collections?${organizationQuery.slice(1)}"
                    condition="organizationPartyId &amp;&amp; arReader"/>
            <number-card title="Payables due"
                    value="${amounts.apDue}"
                    link="//Accounting/Reports/Aging?invoiceType=payable${organizationQuery}"
                    condition="organizationPartyId &amp;&amp; apReader"/>
            <number-card title="Bank balance"
                    value="${amounts.bankBalance}"
                    link="//Accounting/Banking/BankAccounts?${organizationQuery.slice(1)}"
                    condition="organizationPartyId &amp;&amp; bankReader"/>
            <number-card title="Open bank lines"
                    value="${counts.unmatched}"
                    link="//Accounting/Banking/UnmatchedTransactions?${organizationQuery.slice(1)}"
                    condition="organizationPartyId &amp;&amp; bankReader"/>
            <number-card title="Unposted documents this year"
                    value="${counts.unpostedDocuments}"
                    link="//Accounting/PeriodClose/PeriodCloseDetail?timePeriodId=${unpostedPeriodId}${organizationQuery}"
                    condition="organizationPartyId &amp;&amp; closeWorker"/>
        </dashboard>
        <label text="As of ${summary.asOf}" type="p" style="text-caption m-muted"/>
        <section name="MyFinanceWork" condition="organizationPartyId">
            <widgets>
                <container-box>
                    <box-header title="Your work"/>
                    <box-body>
                        <label text="Nothing is waiting for you." type="p" condition="!workRows.length"/>
                        <form-list name="WorkRows" list="workRows" skip-form="true" paginate="false">
                            <field name="title">
                                <default-field title="Waiting">
                                    <link url="${path}" text="${title}" link-type="anchor" parameter-map="linkParameters"/>
                                </default-field>
                            </field>
                            <field name="countText" align="right">
                                <default-field title="Count">
                                    <display/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="title"/>
                                </column>
                                <column>
                                    <field-ref name="countText"/>
                                </column>
                            </columns>
                        </form-list>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="SetupFindings" condition="findings.length">
            <widgets>
                <container-box type="warning">
                    <box-header title="Setup needs attention"/>
                    <box-body>
                        <section-iterate name="SetupFinding" list="findings" entry="finding">
                            <widgets>
                                <label text="${finding}" type="p" style="q-mb-xs"/>
                            </widgets>
                        </section-iterate>
                        <link url="//Accounting/Settings/Settings"
                                text="Review accounting setup"
                                link-type="anchor-button"
                                btn-type="primary"
                                condition="capabilities.admin"
                                parameter-map="{organizationPartyId:organizationPartyId}"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <label text="Shortcuts" type="h6"/>
        <container style="row q-gutter-sm">
            <link url="//Accounting/QuickCreate/NewInvoice"
                    text="New invoice"
                    link-type="anchor-button"
                    icon="sym_o_request_quote"
                    condition="capabilities.arEdit"
                    parameter-map="{organizationPartyId:organizationPartyId}"/>
            <link url="//Accounting/QuickCreate/NewBill"
                    text="New bill"
                    link-type="anchor-button"
                    icon="sym_o_receipt"
                    condition="capabilities.apEdit"
                    parameter-map="{organizationPartyId:organizationPartyId}"/>
            <link url="${sharedLinks['Receivables/ReceivablesWorkbench']}"
                    text="Allocate receipts"
                    link-type="anchor-button"
                    icon="sym_o_payments"
                    condition="capabilities.arRead || capabilities.paymentRead || capabilities.reportRead || capabilities.admin"
                    parameter-map="{organizationPartyId:organizationPartyId}"/>
            <link url="//Accounting/QuickCreate/NewPayment"
                    text="New payment"
                    link-type="anchor-button"
                    icon="sym_o_payments"
                    condition="capabilities.paymentEdit"
                    parameter-map="{organizationPartyId:organizationPartyId}"/>
            <link url="//Accounting/QuickCreate/NewEntry"
                    text="New journal entry"
                    link-type="anchor-button"
                    icon="sym_o_edit_note"
                    condition="capabilities.glPost"
                    parameter-map="{organizationPartyId:organizationPartyId}"/>
            <link url="//Accounting/Reports/TrialBalance"
                    text="Trial balance"
                    link-type="anchor-button"
                    icon="sym_o_table_chart"
                    condition="ledgerReader"
                    parameter-map="{organizationPartyId:organizationPartyId}"/>
            <link url="//Accounting/Reports/Reports"
                    text="Reports"
                    link-type="anchor-button"
                    icon="sym_o_summarize"
                    condition="ledgerReader"
                    parameter-map="{organizationPartyId:organizationPartyId}"/>
        </container>
    </widgets>
</screen>
