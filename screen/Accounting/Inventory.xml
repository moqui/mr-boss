<!-- Inventory (design-accounting §10): the stock valuation beside the inventory and WIP accounts, with its exceptions,
    revaluation and cost data repair (Shared/InventoryValuation with the Accounting context). Manufacturing's
    ProductionCostClose joins it when it is built. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Inventory"
        menu-image="sym_o_inventory_2"
        menu-image-type="icon"
        default-menu-index="9"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <subscreens default-item="InventoryValuation" always-use-full-path="true">
        <subscreens-item name="InventoryValuation"
                location="component://mr-boss/screen/Shared/InventoryValuation.xml"
                menu-title="Valuation"
                menu-index="1"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="InventoryPanel" type="tab"/>
    </widgets>
</screen>
