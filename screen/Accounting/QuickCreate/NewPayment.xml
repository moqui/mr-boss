<!-- Quick create's New payment: the payment list's draft form (template/AccountingPayments.xml PaymentDraftForm), which
    opens the new payment. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="New payment"
        default-menu-index="1"
        default-menu-include="false"
        server-static="qvt">
    <parameter name="organizationPartyId"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition-include name="savePaymentDraft" location="component://mr-boss/template/AccountingPayments.xml"/>
    <actions>
        <service-call name="ironstone.accounting.PaymentScreenServices.get#PaymentListContext"
                in-map="{organizationPartyId:organizationPartyId, pageSize:1}"
                out-map="listContext"/>
        <set field="paymentDraftValue" from="listContext.paymentDraftValue"/>
    </actions>
    <widgets>
        <section-include name="PaymentDraftForm" location="component://mr-boss/template/AccountingPayments.xml"/>
    </widgets>
</screen>
