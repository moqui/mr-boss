<!-- RequestIntake (design-projects.md §6 RequestIntake; style-guide §3.5 Task), the component RequestIntake.xml serves in the qvue
    render mode in the public shell (WebrootPublic.qvt.js): a visitor who is not signed in, at /r/<token>, sends a request to a
    project. What the route's token check answered is $root.context (the project's name, the request types offered, whether files
    are taken and their limits, the CAPTCHA's site key); the transition is under $root.basePath. The form: first and last name,
    email, organization, type, subject, description, files (picked or dropped, checked for count and size before they go), the
    CAPTCHA when one is on; a hidden website field a person leaves empty. A refused send keeps the values and says why. Once
    sent: the request's number and a conditional explanation of email replies. Brand color names and Quasar classes only (style-guide
    §4.8, §5). -->
<template><div class="boss-request-intake q-py-md q-mx-auto" style="max-width:680px">
    <div class="row items-center no-wrap q-gutter-x-md q-mb-md">
        <q-avatar size="48px" color="primary" text-color="white" icon="sym_o_support"></q-avatar>
        <div class="col" style="min-width:0">
            <div v-if="info.projectName" class="text-caption m-muted ellipsis">{{info.projectName}}</div>
            <div class="text-h6">{{t('Send a request')}}</div>
        </div>
    </div>

    <!-- sent -->
    <q-card v-if="state === 'sent'" flat bordered data-state="sent">
        <q-card-section class="row no-wrap q-gutter-x-md">
            <q-icon name="sym_o_check_circle" size="32px" color="positive"></q-icon>
            <div class="col">
                <div class="text-subtitle1 text-weight-medium">{{t('Thank you, we have your request')}}</div>
                <div v-if="requestId" class="text-body1 q-mt-xs">{{t('Its number is')}} <span class="text-weight-medium text-mono" data-request-id>{{requestId}}</span></div>
                <div class="text-body2 m-muted q-mt-xs">{{t('If we email you about your request, you can reply to that message.')}}</div>
            </div>
        </q-card-section>
        <q-card-actions class="q-px-md q-pb-md">
            <q-btn flat no-caps color="primary" icon="sym_o_add" :label="t('Send another request')" @click="another"></q-btn>
        </q-card-actions>
    </q-card>

    <!-- the form -->
    <q-card v-else flat bordered data-state="form">
        <q-card-section>
            <div class="text-body2 m-muted q-mb-md">{{t('Tell us what you need.')}}</div>
            <div class="row q-col-gutter-sm">
                <div class="col-12 col-sm-6"><m-text-line id="boss-intake-first" name="firstName" v-model="form.firstName" :label="t('First name')"></m-text-line></div>
                <div class="col-12 col-sm-6"><m-text-line id="boss-intake-last" name="lastName" v-model="form.lastName" :label="t('Last name')"></m-text-line></div>
                <div class="col-12 col-sm-6"><m-text-line id="boss-intake-email" name="emailAddress" v-model="form.emailAddress" :label="t('Email')" type="email"></m-text-line></div>
                <div class="col-12 col-sm-6"><m-text-line id="boss-intake-org" name="organizationName" v-model="form.organizationName" :label="t('Organization (optional)')"></m-text-line></div>
                <div v-if="typeOptions.length > 1" class="col-12"><m-drop-down id="boss-intake-type" name="requestTypeEnumId" v-model="form.requestTypeEnumId" :options="typeOptions" :label="t('What kind of request')"></m-drop-down></div>
                <div class="col-12"><m-text-line id="boss-intake-subject" name="requestName" v-model="form.requestName" :label="t('Subject')" maxlength="255"></m-text-line></div>
                <div class="col-12"><m-text-area id="boss-intake-description" name="description" v-model="form.description" rows="7" :label="t('Description')"></m-text-area></div>
            </div>
            <!-- a person leaves it empty -->
            <div aria-hidden="true" style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden">
                <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" v-model="form.website"></label>
            </div>

            <!-- files -->
            <div v-if="info.filesAllowed" class="q-mt-md">
                <div class="text-subtitle2">{{t('Files (optional)')}}</div>
                <div class="text-caption m-muted q-mb-xs">{{limitsText}}</div>
                <div class="row items-center no-wrap rounded-borders q-pa-sm" :class="dragOver ? 'm-tonal text-primary' : ''" style="border:1px dashed rgba(127,127,127,.5)"
                        @dragover.prevent="dragOver = true" @dragleave.prevent="dragOver = false" @drop.prevent="onDrop">
                    <q-icon name="sym_o_upload_file" size="24px" class="m-muted q-mr-sm"></q-icon>
                    <div class="col text-body2 m-muted">{{t('Drop files here, or')}}</div>
                    <q-btn flat dense no-caps color="primary" icon="sym_o_attach_file" :label="t('Choose files')" @click="pick"></q-btn>
                    <input ref="picker" type="file" multiple style="display:none" @change="onPicked">
                </div>
                <q-list v-if="files.length" dense class="q-mt-xs">
                    <q-item v-for="(file, index) in files" :key="index + file.name" data-file>
                        <q-item-section avatar><q-icon name="sym_o_draft" size="xs"></q-icon></q-item-section>
                        <q-item-section><q-item-label class="ellipsis">{{file.name}}</q-item-label><q-item-label caption>{{sizeText(file.size)}}</q-item-label></q-item-section>
                        <q-item-section side><q-btn flat round dense icon="sym_o_close" :aria-label="t('Remove')" @click="files.splice(index, 1)"></q-btn></q-item-section>
                    </q-item>
                </q-list>
            </div>

            <div v-if="info.captchaSiteKey" class="q-mt-md"><div ref="captcha" data-captcha></div></div>

            <q-banner v-if="error" rounded class="m-tonal text-negative q-mt-md" data-error>
                <template v-slot:avatar><q-icon name="sym_o_error"></q-icon></template>
                {{error}}
            </q-banner>
        </q-card-section>
        <q-card-actions class="q-px-md q-pb-md">
            <q-btn unelevated no-caps color="primary" icon="sym_o_send" :label="t('Send')" :loading="busy" @click="send" data-send></q-btn>
            <q-linear-progress v-if="busy && total" :value="total ? loaded / total : 0" rounded size="6px" color="primary" class="col q-ml-md"></q-linear-progress>
        </q-card-actions>
    </q-card>
    <div class="text-caption m-muted q-mt-md text-center">{{t('Only the people of this project see what you send.')}}</div>
</div></template>

<script>
const t = (text) => (moqui.l10n && moqui.l10n.localize ? moqui.l10n.localize(text) : text);
const blank = (type) => ({ firstName: '', lastName: '', emailAddress: '', organizationName: '', requestTypeEnumId: type || '', requestName: '', description: '', website: '' });
module.exports = {
    name: 'BossRequestIntake',
    data() {
        const info = this.$root.context || {};
        return { state: 'form', form: blank(info.defaultType), files: [], dragOver: false, busy: false, loaded: 0, total: 0, error: null, requestId: null,
            captchaWidget: null };
    },
    computed: {
        base() { return this.$root.basePath || ''; },
        info() { return this.$root.context || {}; },
        typeOptions() { return (this.info.typeList || []).map((type) => ({ value: type.enumId, label: type.label })); },
        limitsText() { return t('At most') + ' ' + (this.info.maxFiles || 5) + ' ' + t('files of') + ' ' + (this.info.maxMb || 10) + ' MB ' + t('each: pictures, PDF, text, office documents or archives'); }
    },
    methods: {
        t,
        pick() { if (this.$refs.picker) this.$refs.picker.click(); },
        onPicked(event) { this.add(Array.from((event.target && event.target.files) || [])); event.target.value = ''; },
        onDrop(event) { this.dragOver = false; this.add(Array.from((event.dataTransfer && event.dataTransfer.files) || [])); },
        add(list) {
            this.error = null;
            const max = this.info.maxFiles || 5, maxBytes = (this.info.maxMb || 10) * 1048576;
            for (const file of list) {
                if (this.files.length >= max) { this.error = t('At most') + ' ' + max + ' ' + t('files'); break; }
                if (file.size > maxBytes) { this.error = file.name + ': ' + t('larger than') + ' ' + (this.info.maxMb || 10) + ' MB'; continue; }
                this.files.push(file);
            }
        },
        check() {
            const f = this.form;
            if (!f.firstName.trim() || !f.lastName.trim()) return t('Your first and last name, please');
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(f.emailAddress.trim())) return t('An email address we can answer, please');
            if (!f.requestName.trim()) return t('A subject, please');
            if (!f.description.trim()) return t('Tell us what you need in the description, please');
            return null;
        },
        send() {
            if (this.busy) return;
            this.error = this.check();
            if (this.error) return;
            const form = new FormData();
            Object.keys(this.form).forEach((key) => form.append(key, this.form[key] || ''));
            if (!this.form.requestTypeEnumId && this.typeOptions.length) form.set('requestTypeEnumId', this.typeOptions[0].value);
            if (this.info.captchaSiteKey && window.grecaptcha && this.captchaWidget != null) form.append('reCaptchaToken', window.grecaptcha.getResponse(this.captchaWidget) || '');
            this.files.forEach((file) => form.append('contentFile', file, file.name));
            this.busy = true;
            this.loaded = 0;
            this.total = this.files.reduce((sum, file) => sum + (file.size || 0), 0);
            const xhr = new XMLHttpRequest();
            xhr.open('POST', this.base + '/submit');
            xhr.setRequestHeader('Accept', 'application/json');
            xhr.upload.onprogress = (event) => { if (event.lengthComputable) { this.loaded = event.loaded; this.total = event.total; } };
            xhr.onload = () => {
                this.busy = false;
                let json = {};
                try { json = JSON.parse(xhr.responseText || '{}'); } catch (err) { json = {}; }
                if (xhr.status >= 200 && xhr.status < 300 && json.received) {
                    this.requestId = json.requestId || null;
                    this.state = 'sent';
                    window.scrollTo && window.scrollTo(0, 0);
                } else {
                    const text = json.errors || (xhr.status === 429 ? t('Too many requests just now; try again in a minute') : t('Your request was not sent; try again'));
                    this.error = String(text).split('\n')[0];
                    if (this.info.captchaSiteKey && window.grecaptcha && this.captchaWidget != null) window.grecaptcha.reset(this.captchaWidget);
                }
            };
            xhr.onerror = () => { this.busy = false; this.error = t('Your request was not sent: no connection'); };
            xhr.send(form);
        },
        another() {
            this.form = blank(this.info.defaultType);
            this.files = [];
            this.requestId = null;
            this.error = null;
            this.state = 'form';
            this.$nextTick(() => this.renderCaptcha());
        },
        renderCaptcha() {
            const key = this.info.captchaSiteKey;
            if (!key || !this.$refs.captcha) return;
            const draw = () => { try { this.captchaWidget = window.grecaptcha.render(this.$refs.captcha, { sitekey: key }); } catch (err) { this.captchaWidget = null; } };
            if (window.grecaptcha && window.grecaptcha.render) { draw(); return; }
            window.bossIntakeCaptcha = () => draw();
            const script = document.createElement('script');
            script.src = 'https://www.google.com/recaptcha/api.js?onload=bossIntakeCaptcha&render=explicit';
            script.async = true;
            script.onerror = () => { this.error = t('The robot check did not load; the request may be refused'); };
            document.head.appendChild(script);
        },
        sizeText(size) {
            const n = Number(size) || 0;
            if (n >= 1048576) return (n / 1048576).toFixed(1) + ' MB';
            if (n >= 1024) return Math.round(n / 1024) + ' KB';
            return n + ' B';
        }
    },
    mounted() {
        // dark when the visitor's system is, as the public shell has no preference to read
        if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches && this.$q.dark && !this.$q.dark.isActive) this.$q.dark.set(true);
        this.renderCaptcha();
    }
};
</script>
