<!-- PublicShare (design-drawers-commons.md §9 PublicShare; impl-drawers-commons.md R16, M8): the page of a file or folder shared
    by link, for a visitor who is not signed in, at /s/<token>: the token-route "s" of MoquiConf.xml renders it in the public
    shell (no header, drawers or session user) after org.moqui.resource.FileServices.check#PublicShareToken accepted the token, so
    an expired, revoked or unknown link never reaches this screen. The component is PublicShare.qvue next to this file: the
    item's name, the sharer and the note, the expiry, a password prompt when the link has one, then the file (preview,
    download) or the folder (its files with breadcrumbs, picture previews, a file or the whole folder as a zip) and, for a
    link that takes files, the file drop with the uploader's name. Every transition below calls the public-share service,
    which checks the token again (the route gives it as the token parameter, whatever the request says) and the grant
    open#PublicShare made after the password, before it reads anything; nothing else is read here. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-include="false" default-menu-title="Shared files" render-modes="vue,qvue,tui" server-static="vue,qvue">

    <!-- the password (when the link has one), the opening counted, the grant for the calls below -->
    <transition name="open" require-session-token="false">
        <actions><script><![CDATA[
            const out = ec.service.sync().name('org.moqui.resource.FileServices.open#PublicShare').parameters({token: token || '', password: password || null}).call()
            ec.web.sendJsonResponse(ec.message.hasError() ? {} : {valid: out.valid, passwordOk: out.passwordOk, grant: out.grant ?? null, share: out.share})
        ]]></script></actions>
        <default-response type="none"/>
    </transition>
    <!-- the files of the shared folder (path below it), or the shared file -->
    <transition name="files" method="get" read-only="true">
        <actions><script><![CDATA[
            const out = ec.service.sync().name('org.moqui.resource.FileServices.list#PublicShare').parameters({token: token || '', grant: grant || null,
                path: path || null}).call()
            ec.web.sendJsonResponse(ec.message.hasError() ? {} : {fileList: out.fileList || [], uploadOnly: out.uploadOnly === true})
        ]]></script></actions>
        <default-response type="none"/>
    </transition>
    <!-- a file (inline only a picture or a PDF), or the folder (path empty) or a folder below it as a zip: download#PublicShare
        sends it itself (sendResponse) after its token and grant checks, under its own anonymous authorization, named by the
        file (a folder as name.zip); after an error it sends nothing and the answer here is the error -->
    <transition name="download" method="get" read-only="true">
        <actions><script><![CDATA[
            ec.service.sync().name('org.moqui.resource.FileServices.download#PublicShare').parameters({token: token || '', grant: grant || null,
                path: path || null, sendResponse: true, inline: String(inline) === 'true'}).call()
            if (ec.message.hasError()) ec.web.sendJsonResponse({})
        ]]></script></actions>
        <default-response type="none"/>
    </transition>
    <!-- the file drop: files into the shared folder (or a folder below it for an edit link), the uploader's name in the version note -->
    <transition name="upload" require-session-token="false">
        <actions><script><![CDATA[
            const out = ec.service.sync().name('org.moqui.resource.FileServices.upload#PublicShare').parameters({token: token || '', grant: grant || null,
                path: path || null, fileList: contentFile == null ? null : (Array.isArray(contentFile) ? contentFile : [contentFile]),
                uploaderName: uploaderName || null}).call()
            ec.web.sendJsonResponse(ec.message.hasError() ? {} : {uploadedList: out.uploadedList || []})
        ]]></script></actions>
        <default-response type="none"/>
    </transition>

    <widgets>
        <render-mode>
            <text type="qvue" location="component://mr-boss/screen/PublicShare.qvue" template="false"/><text type="tui" location="component://mr-boss/screen/PublicShare.tui.json" template="false"/>
            <text type="html,qvt"><![CDATA[<p>This shared item opens in a browser with JavaScript.</p>]]></text>
        </render-mode>
    </widgets>
</screen>
