<!-- The Receiving area of IronStone Purchasing (design-purchasing §1, §9; impl-purchasing P5), for the buying lists' groups
    (BOSS_PUR_LISTS): Receipts (the default: ReceiptFind, ExpectedReceipts and PrepareReceipt, "Expected receipt (ASN)"),
    Inspections (InspectionFind and InspectionList), and hidden from the menu the shared ShipmentDetail (crosscut §3.8
    Purchasing row: a receiver receives through Warehouse's receive guard, others see progress), QualityInspection and
    InspectionTemplates (crosscut §3.19 Purchasing row; InspectionTemplates' menu entry is in Settings, design §1).
    Purchasing posts no stock: the Mantle receiving and quality services do. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Receiving" default-menu-index="9" menu-image="sym_o_local_shipping" menu-image-type="icon">
    <subscreens default-item="Receipts" always-use-full-path="true">
        <subscreens-item name="ShipmentDetail" location="component://mr-boss/screen/Shared/ShipmentDetail.xml"
                menu-include="false"/>
        <subscreens-item name="QualityInspection" location="component://mr-boss/screen/Shared/QualityInspection.xml"
                menu-include="false"/>
        <subscreens-item name="InspectionTemplates" location="component://mr-boss/screen/Shared/InspectionTemplates.xml"
                menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="PurchasingReceivingPanel" type="tab"/>
    </widgets>
</screen>
