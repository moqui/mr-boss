<!-- The Agreements area of IronStone Purchasing (design-purchasing §1, §7; impl-purchasing P13), for the buying lists' groups
    (BOSS_PUR_LISTS): AgreementList (the default: AgreementFind, AgreementList with its views and NewAgreement, from a
    template too) and AgreementDetail (hidden from the menu: the header, terms, items, releases with ReleaseAgreement, the
    approval, history and files of one agreement). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Agreements" default-menu-index="7" menu-image="sym_o_handshake" menu-image-type="icon">
    <subscreens default-item="AgreementList" always-use-full-path="true">
        <subscreens-item name="AgreementDetail" location="component://mr-boss/screen/Purchasing/Agreements/AgreementDetail.xml"
                menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
