<!-- The Approvals area of IronStone Purchasing (design-purchasing §1, §6 Approvals; crosscut §3.15; impl-purchasing P4): the
    Commons Notifications list mounted with Purchasing's approval topics and the current recipient, for the purchase approver
    and the administrator only (BOSS_PUR_APPROVALS). Its rows are the pending decision steps: a purchase order's
    (PurchaseOrderApproval) and a supplier's (PurchaseSupplierApproval), one per approver of the step waiting, titled with the
    source, its revision, supplier, amount and step. Approve and refuse call the topics' handlers through the framework
    (mantle.order.PurchaseServices approve#PurchaseSource and refuse#PurchaseSource, which refuse a superseded revision naming
    the current one); opening a row opens the order or Supplier360, whose approval shows the steps and the budget. P10 adds
    PurchaseRequestApproval and P12 PurchaseAwardApproval to the list. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Approvals" default-menu-index="6" menu-image="sym_o_approval" menu-image-type="icon">
    <always-actions>
        <set field="notificationTopics" from="['PurchaseOrderApproval', 'PurchaseSupplierApproval']"/>
        <set field="notificationsTitle" value="Approvals"/>
    </always-actions>
    <subscreens default-item="Notifications" always-use-full-path="true">
        <subscreens-item name="Notifications" location="component://mr-boss/screen/Commons/Notifications.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
