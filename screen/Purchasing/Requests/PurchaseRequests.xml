<!-- PurchaseRequests (design-purchasing §4 Requests; style-guide §3.2 List; impl-purchasing P10): RequestFind and RequestList
    over ironstone.purchasing.RequestServices.find#PurchaseRequests (the purchase requests of the user's organizations, a
    requester's own and assigned ones only, by view: My requests, Awaiting sourcing, Due, All; each with its requester,
    organization, facility, due date, approval and the approved, sourced and remaining quantities), with saved finds;
    NewPurchaseRequest (New purchase request: mantle.request.RequestServices.create#PurchaseRequest, for the groups that file
    requests; it opens the draft in RequestDetail to add its lines); and, for a buyer, Source the selected requests, which
    opens RequestSourcing with them. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Purchase requests" default-menu-index="1">
    <parameter name="view"/>
    <parameter name="statusId"/>
    <parameter name="facilityId"/>
    <parameter name="organizationPartyId"/>
    <parameter name="text"/>
    <parameter name="pageIndex"/>
    <parameter name="pageSize"/>
    <transition-include name="choices" location="component://mr-boss/template/PurchasingParts.xml"/>
    <transition name="createRequest">
        <actions>
            <service-call name="mantle.request.RequestServices.create#PurchaseRequest" out-map="created"
                    in-map="{organizationPartyId:organizationPartyId, requestName:requestName, facilityId:(facilityId || null),
                        responseRequiredDate:(responseRequiredDate || null), description:(description || null)}"/>
            <set field="requestId" from="created.requestId"/>
        </actions>
        <default-response url="../RequestDetail"><parameter name="requestId"/></default-response>
        <error-response url="."/>
    </transition>
    <!-- the selected requests to RequestSourcing (a transition with an action, so the row selection posts its ids) -->
    <transition name="sourceRequests">
        <actions>
            <set field="requestIds" from="(Array.isArray(selectedIds) ? selectedIds : String(selectedIds || '').split(','))
                    .filter((id) =&gt; id).join(',')"/>
        </actions>
        <default-response url="../RequestSourcing"><parameter name="requestIds"/></default-response>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="ironstone.purchasing.RequestServices.find#PurchaseRequests" out-map="found" transaction="force-new"
                ignore-error="true"
                in-map="{appRoot:appRoot, view:view, statusId:statusId, facilityId:facilityId,
                    organizationPartyId:organizationPartyId, text:text, pageIndex:pageIndex, pageSize:pageSize}"/>
        <set field="requestRows" from="found?.requestRows || []"/>
        <set field="requestRowsCount" from="found?.requestRowsCount"/>
        <set field="requestRowsPageIndex" from="found?.requestRowsPageIndex"/>
        <set field="requestRowsPageSize" from="found?.requestRowsPageSize"/>
        <set field="requestRowsPageMaxIndex" from="found?.requestRowsPageMaxIndex"/>
        <set field="requestRowsPageRangeLow" from="found?.requestRowsPageRangeLow"/>
        <set field="requestRowsPageRangeHigh" from="found?.requestRowsPageRangeHigh"/>
        <set field="viewLabel" from="found?.viewLabel || 'All'"/>
        <set field="can" from="purchasing.capabilities"/>
        <set field="newRequest" from="{organizationPartyId:purchasing.activeOrganizationPartyId
                || purchasing.organizationPartyIds[0] || ''}"/>
        <set field="viewLinks" from="(can.listRead ? [['', 'All'], ['mine', 'My requests'], ['sourcing', 'Awaiting sourcing'],
                ['due', 'Due']] : [['', 'My requests'], ['sourcing', 'Awaiting sourcing'], ['due', 'Due']])
                .map(([key, label]) =&gt; ({key, label, current: (view || '') == key}))"/>
        <set field="filtered" from="!!(view || statusId || facilityId || text)"/>
        <set field="emptyText" from="filtered ? 'No purchase request matches these filters.' : can.requestCreate
                ? 'No purchase request yet. Ask for what you need with New purchase request.'
                : 'Your organizations have no purchase request yet.'"/>
    </actions>
    <widgets>
        <context title="Purchase requests" selection-form="PurchaseRequestList"/>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Purchase requests" type="h5"/>
                <label text="${viewLabel}" type="p" style="text-caption m-muted q-mb-none"/>
            </container>
            <container style="col-auto row items-center q-gutter-xs">
                <container-dialog id="NewPurchaseRequestDialog" button-text="New purchase request" type="primary" icon="sym_o_add"
                        title="New purchase request" width="720" condition="can.requestCreate">
                    <form-single name="CreatePurchaseRequest" transition="createRequest" map="newRequest">
                        <field name="organizationPartyId">
                            <default-field title="Buying organization">
                                <drop-down allow-empty="false">
                                    <dynamic-options transition="choices" server-search="true" min-length="0"
                                            parameter-map="{choice:'organizations', selected:organizationPartyId}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="requestName">
                            <default-field title="What is it for"><text-line/></default-field>
                        </field>
                        <field name="facilityId">
                            <default-field title="Deliver to">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0"
                                            parameter-map="{choice:'planFacilities'}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="responseRequiredDate">
                            <default-field title="Wanted by"><date-time type="date"/></default-field>
                        </field>
                        <field name="description">
                            <default-field title="Details"><text-area rows="3"/></default-field>
                        </field>
                        <field name="submitButton">
                            <default-field title="Create draft"><submit/></default-field>
                        </field>
                        <field-layout>
                            <field-row><field-ref name="organizationPartyId"/><field-ref name="requestName"/></field-row>
                            <field-row><field-ref name="facilityId"/><field-ref name="responseRequiredDate"/></field-row>
                            <field-ref name="description"/>
                            <field-ref name="submitButton"/>
                        </field-layout>
                    </form-single>
                </container-dialog>
            </container>
        </container>
        <container style="row q-gutter-xs q-mb-sm">
            <section-iterate name="RequestViews" list="viewLinks" entry="viewLink">
                <widgets>
                    <link url="." text="${viewLink.label}" link-type="anchor-button" icon="sym_o_check"
                            parameter-map="{view:viewLink.key}" condition="viewLink.current"/>
                    <link url="." text="${viewLink.label}" link-type="anchor-button" parameter-map="{view:viewLink.key}"
                            condition="!viewLink.current"/>
                </widgets>
            </section-iterate>
        </container>
        <container-box>
            <box-body-nopad>
                <form-list name="PurchaseRequestList" list="requestRows" skip-form="true" paginate="true" header-dialog="true"
                        saved-finds="true" select-columns="true">
                    <row-selection id-field="requestId" parameter="selectedIds" list-mode="true" condition="can.buy">
                        <action>
                            <dialog button-text="Source" button-icon="sym_o_receipt_long"
                                    title="Source the selected purchase requests"/>
                            <form-single name="SourceRequests" transition="sourceRequests">
                                <field name="submitButton">
                                    <default-field title="Review their lines"><submit/></default-field>
                                </field>
                            </form-single>
                        </action>
                    </row-selection>
                    <field name="requestId">
                        <header-field title="Request" show-order-by="true"/>
                        <default-field title="Request">
                            <link url="../RequestDetail" text="${requestId}" link-type="anchor" parameter-map="{requestId:requestId}"/>
                            <label text="${requestName}" type="div" style="text-caption m-muted"/>
                        </default-field>
                    </field>
                    <field name="text">
                        <header-field title="Request or name"><text-find hide-options="true"/></header-field>
                    </field>
                    <field name="requesterName">
                        <default-field title="Requester"><display/></default-field>
                    </field>
                    <field name="organizationPartyId">
                        <header-field title="Buying organization">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'organizations', selected:organizationPartyId}"/>
                            </drop-down>
                        </header-field>
                        <default-field title="Organization"><display text="${organizationName}"/></default-field>
                    </field>
                    <field name="facilityId">
                        <header-field title="Facility">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'planFacilities', selected:facilityId}"/>
                            </drop-down>
                        </header-field>
                        <default-field title="Facility"><display text="${facilityName}"/></default-field>
                    </field>
                    <field name="dueText">
                        <default-field title="Due">
                            <label text="${dueText}" type="span" style="${overdue ? 'text-negative' : ''}"/>
                        </default-field>
                    </field>
                    <field name="statusId">
                        <header-field title="Status">
                            <drop-down allow-empty="true">
                                <entity-options key="${statusId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.StatusItem">
                                        <econdition field-name="statusTypeId" value="Request"/>
                                        <order-by field-name="sequenceNum"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </header-field>
                        <default-field title="Status">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${statusColor}">${
                                    WebUtilities.encodeHtml(statusText)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: statusText})}]]></text>
                                <text type="html">${statusText}</text>
                            </render-mode>
                        </default-field>
                    </field>
                    <field name="approvalText">
                        <default-field title="Approval"><display/></default-field>
                    </field>
                    <field name="linesText" align="right">
                        <default-field title="Lines"><display/></default-field>
                    </field>
                    <field name="sourcedText" align="right">
                        <default-field title="Sourced"><display/></default-field>
                    </field>
                    <field name="remainingText" align="right">
                        <default-field title="To source">
                            <label text="${remainingText}" type="span" style="text-weight-medium"/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="requestId"/>
                            <field-ref name="requesterName"/>
                        </column>
                        <column>
                            <field-ref name="statusId"/>
                            <field-ref name="remainingText"/>
                        </column>
                    </columns>
                </form-list>
                <label text="${emptyText}" type="p" style="q-pa-md m-muted" condition="!requestRows.length"/>
            </box-body-nopad>
        </container-box>
    </widgets>
</screen>
