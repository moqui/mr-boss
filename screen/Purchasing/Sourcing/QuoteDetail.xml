<!-- QuoteDetail (design-purchasing §5 QuoteDetail; style-guide §3.3 Detail; impl-purchasing P11): a supplier's quote, a purchase
    order of the user's organizations in the quote statuses (or declined), over ironstone.purchasing.SourcingServices
    get#SupplierQuote. QuoteHeader: the supplier, its reference, quote date, validity (an expired quote shows but cannot be
    placed), the channel it came by, the status and the actions: Record the answer (a requested quote's answer, entered on the
    supplier's behalf with its reference, validity, how it came and its evidence: mantle.order.SourcingServices
    store#SupplierQuote, which moves it to Quoted) or Edit quote for a quoted one. QuoteLines: each line's RFQ item, product,
    the supplier's item code, quantity, price and promise, with its history from the audit log, Edit price and, for a
    supplier-price editor, Publish price (PublishPrice: publish#SupplierQuotePrice, a quantity tier a supplier price with the
    quote's dates). QuoteTerms: the payment term, Incoterm and delivery, with their history. Evidence: the supplier's files and
    how it came. QuoteAwards: the parts of the quote an award placed (none until it is awarded). Prices are withheld from a user
    who may not see them; every write checks the order with the buy capability (the publish, the price edit capability). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Quote" default-menu-include="false">
    <parameter name="orderId" required="true"/>
    <transition-include name="choices" location="component://mr-boss/template/PurchasingParts.xml"/>
    <transition name="storeQuote">
        <actions>
            <service-call name="ironstone.purchasing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'quote', recordId:orderId, capability:'buy'}"/>
            <set field="quoteValues" from="Object.fromEntries(['otherPartyOrderId', 'validFromDate',
                    'validThruDate', 'estimatedDeliveryDate', 'settlementTermId', 'tradeTermEnumId', 'salesChannelEnumId',
                    'evidenceText', 'changeReason'].filter((name) =&gt; context[name] !== undefined).map((name) =&gt;
                    [name, context[name] === '' ? null : context[name]]))"/>
            <service-call name="mantle.order.SourcingServices.store#SupplierQuote" out-map="stored"
                    in-map="Object.assign({orderId:orderId, contentFile:(contentFile || null)}, quoteValues)"/>
            <message type="success">Saved quote ${orderId}</message>
        </actions>
        <default-response url="."><parameter name="orderId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="storeQuoteItem">
        <actions>
            <service-call name="ironstone.purchasing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'quote', recordId:orderId, capability:'buy'}"/>
            <set field="lineValues" from="Object.fromEntries(['orderItemSeqId', 'productId', 'unitAmount', 'quantity',
                    'promisedDate', 'otherPartyProductId', 'changeReason'].filter((name) =&gt; context[name] != null
                    &amp;&amp; context[name] !== '').map((name) =&gt; [name, context[name]]))"/>
            <service-call name="mantle.order.SourcingServices.store#SupplierQuoteItem"
                    in-map="Object.assign({orderId:orderId}, lineValues)"/>
            <message type="success">Saved the line of quote ${orderId}</message>
        </actions>
        <default-response url="."><parameter name="orderId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="publishPrice">
        <actions>
            <service-call name="ironstone.purchasing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'quote', recordId:orderId, capability:'supplierPriceEdit'}"/>
            <service-call name="mantle.order.SourcingServices.publish#SupplierQuotePrice" out-map="published"
                    in-map="{orderId:orderId, orderItemSeqId:orderItemSeqId, minQuantity:(minQuantity || null),
                        price:(price || null), thruDate:(thruDate || null)}"/>
            <script>if (!ec.message.hasError()) ec.message.addMessage('Published supplier price ' + published.productPriceId
                + (published.endedPriceIds?.length ? '; it ends ' + published.endedPriceIds.join(', ') : ''), 'success')</script>
        </actions>
        <default-response url="."><parameter name="orderId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="quoteContent" read-only="true" method="get">
        <actions>
            <service-call name="ironstone.purchasing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'quote', recordId:orderId}"/>
            <entity-find-one entity-name="mantle.order.OrderContent" value-field="content" disable-authz="true"/>
            <if condition="content?.orderId != orderId || !content?.contentLocation">
                <return error="true" message="The file is not on quote ${orderId}"/></if>
            <!-- the supplier's quote shows its prices: only to a user who sees them (§2) -->
            <set field="can" from="purchasing.capabilities"/>
            <if condition="!(can.buy || can.approve || can.orderApprove || can.supplierPriceRead || can.financialRead)">
                <return error="true" message="PERMISSION_DENIED: The supplier's quote shows its prices, which are withheld from you"/></if>
            <script>ec.web.sendResourceResponse(content.contentLocation, true)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <actions>
        <service-call name="ironstone.purchasing.SourcingServices.get#SupplierQuote" out-map="detail"
                in-map="{appRoot:appRoot, orderId:orderId}" transaction="force-new" ignore-error="true"/>
        <set field="quote" from="detail?.quote || null"/>
        <script>ec.message.clearErrors()</script>
        <set field="found" from="!!quote"/>
        <if condition="found">
            <set field="answerValue" from="{orderId:orderId, otherPartyOrderId:quote.reference, validFromDate:quote.validFromDate,
                    validThruDate:quote.validThruDate, salesChannelEnumId:quote.salesChannelEnumId || 'ScEmail',
                    estimatedDeliveryDate:quote.estimatedDeliveryDate, settlementTermId:quote.settlementTermId,
                    tradeTermEnumId:quote.tradeTermEnumId}"/>
            <set field="contentUrl" from="sri.buildUrl('quoteContent').path + '?orderId=' + encodeURIComponent(orderId)
                    + '&amp;orderContentId='"/>
            <set field="primaryAction" from="quote.canAnswer ? 'answer' : quote.canEdit ? 'edit' : null"/>
        </if>
    </actions>
    <widgets>
        <section name="QuoteMissing" condition="!found">
            <widgets>
                <context title="Quote ${orderId}"/>
                <container-box type="warning">
                    <box-header title="Not available"/>
                    <box-body>
                        <label type="p" text="Quote ${orderId} is not available: it does not exist or it is not a supplier quote
                                of your organizations."/>
                        <link url="${sharedLinks['Sourcing/Quotes']}" text="Back to quotes" link-type="anchor"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="QuoteFound" condition="found">
            <widgets>
                <context record-entity="mantle.order.OrderHeader" record-id="${orderId}"
                        title="Quote ${orderId} · ${quote.supplierName}"/>
                <container style="q-mb-xs">
                    <link url="${sharedLinks['Sourcing/Quotes']}" link-type="anchor" text="Quotes" icon="arrow_back"/>
                    <link url="${sharedLinks['Sourcing/QuoteRequestDetail']}" link-type="anchor" text="RFQ ${quote.rfqId}"
                            parameter-map="{requestId:quote.rfqId}" condition="quote.rfqId" style="q-ml-md"/>
                </container>
                <container style="m-record-header">
                    <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                        <container style="col-12 col-md m-record-title">
                            <container style="row items-baseline">
                                <label text="${orderId}" type="span" style="text-mono text-caption m-muted q-mr-sm"/>
                                <label text="${quote.supplierName}" type="h5"/>
                            </container>
                            <label text="${[quote.organizationName, quote.reference ? 'their reference ' + quote.reference : '',
                                    quote.quoteDateText ? 'quoted ' + quote.quoteDateText : '', quote.validityText ? 'valid '
                                    + quote.validityText : '', quote.channelText ? 'by ' + quote.channelText : '', quote.currencyUomId,
                                    'total ' + quote.totalText].filter(Boolean).join(' · ')}" type="div" style="text-caption m-muted"/>
                        </container>
                        <container style="col-12 col-md-auto m-record-status">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${quote.statusColor}">${
                                    WebUtilities.encodeHtml(quote.statusText)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", id: "SupplierQuoteStatus", style: "strong",
                                    text: quote.statusText})}]]></text>
                                <text type="html">${quote.statusText}</text>
                            </render-mode>
                        </container>
                    </container>
                    <container style="row items-center q-gutter-sm m-record-foot m-record-actions">
                        <container-dialog id="QuoteAnswer" button-text="${primaryAction == 'answer' ? 'Record the answer' : 'Edit quote'}"
                                icon="sym_o_edit_note" type="primary" width="720" title="Quote ${orderId} from ${quote.supplierName}"
                                condition="primaryAction">
                            <form-single name="QuoteHeaderForm" transition="storeQuote" map="answerValue">
                                <field name="orderId"><default-field><hidden/></default-field></field>
                                <field name="otherPartyOrderId"><default-field title="Their reference"><text-line/></default-field></field>
                                <field name="validFromDate"><default-field title="Valid from"><date-time type="date"/></default-field></field>
                                <field name="validThruDate"><default-field title="Valid through"><date-time type="date"/></default-field></field>
                                <field name="estimatedDeliveryDate">
                                    <default-field title="Delivery by"><date-time type="date"/></default-field>
                                </field>
                                <field name="settlementTermId">
                                    <default-field title="Payment term">
                                        <drop-down allow-empty="true">
                                            <dynamic-options transition="choices" min-length="0" parameter-map="{choice:'settlementTerms'}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="tradeTermEnumId">
                                    <default-field title="Incoterm">
                                        <drop-down allow-empty="true">
                                            <entity-options key="${enumId}" text="${description}">
                                                <entity-find entity-name="moqui.basic.Enumeration">
                                                    <econdition field-name="parentEnumId" value="TtInco"/>
                                                    <order-by field-name="description"/>
                                                </entity-find>
                                            </entity-options>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="salesChannelEnumId">
                                    <default-field title="Received by">
                                        <drop-down allow-empty="false">
                                            <dynamic-options transition="choices" min-length="0" parameter-map="{choice:'quoteChannels'}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="evidenceText">
                                    <default-field title="How it came" tooltip="A call with whom, an email's subject"><text-line/></default-field>
                                </field>
                                <field name="contentFile"><default-field title="The supplier's file"><file/></default-field></field>
                                <field name="changeReason">
                                    <default-field title="Reason for the change" tooltip="For an amendment of a quote already recorded">
                                        <text-line/>
                                    </default-field>
                                </field>
                                <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                                <field-layout>
                                    <field-row><field-ref name="otherPartyOrderId"/><field-ref name="salesChannelEnumId"/></field-row>
                                    <field-row><field-ref name="validFromDate"/><field-ref name="validThruDate"/></field-row>
                                    <field-row><field-ref name="settlementTermId"/><field-ref name="tradeTermEnumId"/></field-row>
                                    <field-row><field-ref name="estimatedDeliveryDate"/><field-ref name="changeReason"/></field-row>
                                    <field-row><field-ref name="evidenceText"/><field-ref name="contentFile"/></field-row>
                                    <field-ref name="submitButton"/>
                                </field-layout>
                            </form-single>
                            <label type="p" style="text-caption m-muted" condition="primaryAction == 'answer'"
                                    text="Enter the prices on the lines; saving the answer marks the quote quoted by the supplier."/>
                        </container-dialog>
                    </container>
                </container>
                <label type="p" style="text-negative" condition="quote.expired"
                        text="This quote expired: it shows here but cannot be placed without the supplier's new validity."/>
                <!-- QuoteLines -->
                <container-box>
                    <box-header title="Lines · ${quote.lineRows.length}"/>
                    <box-toolbar>
                        <container-dialog id="QuoteAddLine" button-text="Add line" icon="sym_o_add" width="560"
                                title="Add a line to quote ${orderId}" condition="quote.canEdit &amp;&amp; !quote.rfqId">
                            <form-single name="AddQuoteLine" transition="storeQuoteItem" map="{orderId:orderId}">
                                <field name="orderId"><default-field><hidden/></default-field></field>
                                <field name="productId">
                                    <default-field title="Product">
                                        <drop-down allow-empty="false">
                                            <dynamic-options transition="choices" server-search="true" min-length="0"
                                                    parameter-map="{choice:'orderProducts'}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="quantity"><default-field title="Quantity"><text-line size="8"/></default-field></field>
                                <field name="unitAmount"><default-field title="Unit price"><text-line size="10"/></default-field></field>
                                <field name="otherPartyProductId"><default-field title="Their item code"><text-line/></default-field></field>
                                <field name="submitButton"><default-field title="Add line"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body-nopad>
                        <form-list name="QuoteLines" list="quote.lineRows" skip-form="true" paginate="false">
                            <field name="orderItemSeqId">
                                <default-field title="Line">
                                    <label text="${orderItemSeqId}" type="span" style="text-mono"/>
                                    <label text="RFQ ${rfqLineText}" type="div" style="text-caption m-muted" condition="rfqLineText"/>
                                </default-field>
                            </field>
                            <field name="productText">
                                <default-field title="Product">
                                    <label text="${productText}" type="div"/>
                                    <label text="Their code ${otherPartyProductId}" type="div" style="text-caption m-muted"
                                            condition="otherPartyProductId"/>
                                </default-field>
                            </field>
                            <field name="quantityText" align="right">
                                <default-field title="Quantity"><label text="${quantityText} ${uomText}" type="span"/></default-field>
                            </field>
                            <field name="priceText" align="right"><default-field title="Unit price"><display/></default-field></field>
                            <field name="amountText" align="right"><default-field title="Amount"><display/></default-field></field>
                            <field name="promisedText"><default-field title="Promised"><display/></default-field></field>
                            <field name="historyText"><default-field title="Changes"><display/></default-field></field>
                            <field name="actions">
                                <default-field title="">
                                    <container-dialog id="QuoteLine_${orderItemSeqId}" button-text="Edit price" icon="sym_o_edit"
                                            width="560" title="Line ${orderItemSeqId} of quote ${orderId}" condition="quote.canEdit">
                                        <form-single name="EditQuoteLine" transition="storeQuoteItem"
                                                map="{orderId:orderId, orderItemSeqId:orderItemSeqId, unitAmount:unitAmount, quantity:quantity,
                                                    promisedDate:promisedDate, otherPartyProductId:otherPartyProductId}">
                                            <field name="orderId"><default-field><hidden/></default-field></field>
                                            <field name="orderItemSeqId"><default-field><hidden/></default-field></field>
                                            <field name="unitAmount"><default-field title="Unit price"><text-line size="10"/></default-field></field>
                                            <field name="quantity"><default-field title="Quantity"><text-line size="8"/></default-field></field>
                                            <field name="promisedDate">
                                                <default-field title="Promised by"><date-time type="date"/></default-field>
                                            </field>
                                            <field name="otherPartyProductId">
                                                <default-field title="Their item code"><text-line/></default-field>
                                            </field>
                                            <field name="changeReason">
                                                <default-field title="Reason for the change"><text-line/></default-field>
                                            </field>
                                            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                                        </form-single>
                                    </container-dialog>
                                    <container-dialog id="QuotePublish_${orderItemSeqId}" button-text="Publish price"
                                            icon="sym_o_sell" width="520" title="Publish the price of line ${orderItemSeqId}"
                                            condition="quote.canPublish &amp;&amp; productId">
                                        <form-single name="PublishPrice" transition="publishPrice"
                                                map="{orderId:orderId, orderItemSeqId:orderItemSeqId, price:unitAmount, minQuantity:'0'}">
                                            <field name="orderId"><default-field><hidden/></default-field></field>
                                            <field name="orderItemSeqId"><default-field><hidden/></default-field></field>
                                            <field name="minQuantity">
                                                <default-field title="From quantity" tooltip="A quantity tier: the price from this quantity up">
                                                    <text-line size="8"/>
                                                </default-field>
                                            </field>
                                            <field name="price"><default-field title="Unit price"><text-line size="10"/></default-field></field>
                                            <field name="thruDate">
                                                <default-field title="Through" tooltip="Empty: the end of the quote's validity">
                                                    <date-time type="date"/>
                                                </default-field>
                                            </field>
                                            <field name="submitButton">
                                                <default-field title="Publish">
                                                    <submit confirmation="Make this ${quote.supplierName} price effective for ${quote.organizationName}?
                                                            A price of the same tier in effect ends where it starts."/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="productText"/><field-ref name="quantityText"/></column>
                                <column><field-ref name="priceText"/><field-ref name="actions"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
                <!-- QuoteTerms -->
                <container-box>
                    <box-header title="Terms"/>
                    <box-body>
                        <container style="row q-col-gutter-md">
                            <label text="Payment term: ${quote.termText || 'not given'}" type="div" style="col-12 col-md-4"/>
                            <label text="Incoterm: ${quote.incotermText || 'not given'}" type="div" style="col-12 col-md-4"/>
                            <label text="Delivery by: ${quote.deliveryText || 'not given'}" type="div" style="col-12 col-md-4"/>
                        </container>
                    </box-body>
                </container-box>
                <section name="QuoteTermHistory" condition="quote.termHistoryRows.length">
                    <widgets>
                        <container-box>
                            <box-header title="Amendments"/>
                            <box-body-nopad>
                                <form-list name="QuoteTermHistoryList" list="quote.termHistoryRows" skip-form="true" paginate="false">
                                    <field name="dateText"><default-field title="When"><display/></default-field></field>
                                    <field name="whatText"><default-field title="Change"><display/></default-field></field>
                                    <field name="fromText"><default-field title="From"><display/></default-field></field>
                                    <field name="toText"><default-field title="To"><display/></default-field></field>
                                    <field name="byText"><default-field title="By"><display/></default-field></field>
                                    <field name="reason"><default-field title="Reason"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="whatText"/><field-ref name="dateText"/></column>
                                        <column><field-ref name="toText"/></column>
                                    </columns>
                                </form-list>
                            </box-body-nopad>
                        </container-box>
                    </widgets>
                </section>
                <!-- the evidence -->
                <container-box>
                    <box-header title="Evidence"/>
                    <box-body-nopad>
                        <form-list name="QuoteEvidence" list="quote.evidenceRows" skip-form="true" paginate="false">
                            <field name="dateText"><default-field title="Received"><display/></default-field></field>
                            <field name="description">
                                <default-field title="What">
                                    <link url="${contentUrl}${orderContentId}" url-type="plain" text="${description}"
                                            link-type="anchor" target-window="_blank" condition="hasFile"/>
                                    <label text="${description}" type="span" condition="!hasFile"/>
                                </default-field>
                            </field>
                            <field name="byText"><default-field title="Entered by"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="description"/></column>
                                <column><field-ref name="dateText"/></column>
                            </columns>
                        </form-list>
                        <label type="p" style="m-muted q-pa-sm q-mb-none" condition="!quote.evidenceRows.length"
                                text="No evidence yet: record how the quote came, or attach the supplier's file."/>
                    </box-body-nopad>
                </container-box>
                <!-- QuoteAwards: what an award placed of this quote -->
                <container-box>
                    <box-header title="Awards"/>
                    <box-body>
                        <label type="p" style="m-muted q-mb-none" text="No part of this quote is awarded."/>
                    </box-body>
                </container-box>
                <container-row>
                    <row-col md="6">
                        <container-box>
                            <box-header title="Conversation"/>
                            <box-body>
                                <chatter id="SupplierQuoteChatter" record-entity="mantle.order.OrderHeader" record-id="${orderId}"/>
                            </box-body>
                        </container-box>
                    </row-col>
                </container-row>
            </widgets>
        </section>
    </widgets>
</screen>
