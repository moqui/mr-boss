<!-- QuoteRequests (design-purchasing §5 QuoteRequests; style-guide §3.2 List; impl-purchasing P11): QuoteRequestFind and
    QuoteRequestList over ironstone.purchasing.SourcingServices.find#QuoteRequests (the RFQs of the user's organizations by
    view: Open, Drafts, Responses due, Changed since sent, Closed, All; each with its response date, revision, items and its
    suppliers invited and answered), with saved finds; NewQuoteRequest (New RFQ: mantle.order.SourcingServices
    create#QuoteRequest, for a buyer; it opens the draft in QuoteRequestDetail to add its items and invite suppliers). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="RFQs" default-menu-index="1">
    <parameter name="view"/>
    <parameter name="statusId"/>
    <parameter name="organizationPartyId"/>
    <parameter name="vendorPartyId"/>
    <parameter name="text"/>
    <parameter name="pageIndex"/>
    <parameter name="pageSize"/>
    <transition-include name="choices" location="component://mr-boss/template/PurchasingParts.xml"/>
    <transition name="createRfq">
        <actions>
            <service-call name="mantle.order.SourcingServices.create#QuoteRequest" out-map="created"
                    in-map="{organizationPartyId:organizationPartyId, requestName:requestName, facilityId:(facilityId || null),
                        responseRequiredDate:(responseRequiredDate || null), description:(description || null)}"/>
            <set field="requestId" from="created.requestId"/>
        </actions>
        <default-response url="../QuoteRequestDetail"><parameter name="requestId"/></default-response>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="ironstone.purchasing.SourcingServices.find#QuoteRequests" out-map="found" transaction="force-new"
                ignore-error="true"
                in-map="{appRoot:appRoot, view:view, statusId:statusId, organizationPartyId:organizationPartyId,
                    vendorPartyId:vendorPartyId, text:text, pageIndex:pageIndex, pageSize:pageSize}"/>
        <set field="rfqRows" from="found?.rfqRows || []"/>
        <set field="rfqRowsCount" from="found?.rfqRowsCount"/>
        <set field="rfqRowsPageIndex" from="found?.rfqRowsPageIndex"/>
        <set field="rfqRowsPageSize" from="found?.rfqRowsPageSize"/>
        <set field="rfqRowsPageMaxIndex" from="found?.rfqRowsPageMaxIndex"/>
        <set field="rfqRowsPageRangeLow" from="found?.rfqRowsPageRangeLow"/>
        <set field="rfqRowsPageRangeHigh" from="found?.rfqRowsPageRangeHigh"/>
        <set field="viewLabel" from="found?.viewLabel || 'Open'"/>
        <set field="can" from="purchasing.capabilities"/>
        <set field="newRfq" from="{organizationPartyId:purchasing.activeOrganizationPartyId || purchasing.organizationPartyIds[0] || ''}"/>
        <set field="viewLinks" from="[['', 'Open'], ['draft', 'Drafts'], ['due', 'Responses due'], ['changed', 'Changed since sent'],
                ['closed', 'Closed'], ['all', 'All']].map(([key, label]) =&gt; ({key, label, current: (view || '') == key}))"/>
        <set field="filtered" from="!!(view || statusId || organizationPartyId || vendorPartyId || text)"/>
        <set field="emptyText" from="filtered ? 'No RFQ matches these filters.' : can.buy
                ? 'No open RFQ. Ask suppliers for prices with New RFQ, or from the sourcing of a purchase request.'
                : 'Your organizations have no open RFQ.'"/>
    </actions>
    <widgets>
        <context title="RFQs" selection-form="QuoteRequestList"/>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Requests for quotation" type="h5"/>
                <label text="${viewLabel}" type="p" style="text-caption m-muted q-mb-none"/>
            </container>
            <container style="col-auto row items-center q-gutter-xs">
                <container-dialog id="NewQuoteRequestDialog" button-text="New RFQ" type="primary" icon="sym_o_add"
                        title="New request for quotation" width="720" condition="can.buy &amp;&amp; can.rfqCreate">
                    <form-single name="NewQuoteRequest" transition="createRfq" map="newRfq">
                        <field name="organizationPartyId">
                            <default-field title="Buying organization">
                                <drop-down allow-empty="false">
                                    <dynamic-options transition="choices" server-search="true" min-length="0"
                                            parameter-map="{choice:'organizations', selected:organizationPartyId}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="requestName"><default-field title="Name"><text-line/></default-field></field>
                        <field name="facilityId">
                            <default-field title="Deliver to">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0"
                                            parameter-map="{choice:'planFacilities'}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="responseRequiredDate">
                            <default-field title="Respond by" tooltip="Empty: the buying policy's response days from today">
                                <date-time type="date"/>
                            </default-field>
                        </field>
                        <field name="description">
                            <default-field title="Specification"><text-area rows="3"/></default-field>
                        </field>
                        <field name="submitButton"><default-field title="Create draft"><submit/></default-field></field>
                        <field-layout>
                            <field-row><field-ref name="organizationPartyId"/><field-ref name="requestName"/></field-row>
                            <field-row><field-ref name="facilityId"/><field-ref name="responseRequiredDate"/></field-row>
                            <field-ref name="description"/>
                            <field-ref name="submitButton"/>
                        </field-layout>
                    </form-single>
                </container-dialog>
            </container>
        </container>
        <container style="row q-gutter-xs q-mb-sm">
            <section-iterate name="RfqViews" list="viewLinks" entry="viewLink">
                <widgets>
                    <link url="." text="${viewLink.label}" link-type="anchor-button" icon="sym_o_check"
                            parameter-map="{view:viewLink.key}" condition="viewLink.current"/>
                    <link url="." text="${viewLink.label}" link-type="anchor-button" parameter-map="{view:viewLink.key}"
                            condition="!viewLink.current"/>
                </widgets>
            </section-iterate>
        </container>
        <container-box>
            <box-body-nopad>
                <form-list name="QuoteRequestList" list="rfqRows" skip-form="true" paginate="true" header-dialog="true"
                        saved-finds="true" select-columns="true">
                    <field name="requestId">
                        <header-field title="RFQ" show-order-by="true"/>
                        <default-field title="RFQ">
                            <link url="../QuoteRequestDetail" text="${requestId}" link-type="anchor" parameter-map="{requestId:requestId}"/>
                            <label text="${requestName}" type="div" style="text-caption m-muted"/>
                        </default-field>
                    </field>
                    <field name="text">
                        <header-field title="RFQ or name"><text-find hide-options="true"/></header-field>
                    </field>
                    <field name="organizationPartyId">
                        <header-field title="Buying organization">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'organizations', selected:organizationPartyId}"/>
                            </drop-down>
                        </header-field>
                        <default-field title="Organization"><display text="${organizationName}"/></default-field>
                    </field>
                    <field name="vendorPartyId">
                        <header-field title="Supplier invited">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'suppliers', selected:vendorPartyId}"/>
                            </drop-down>
                        </header-field>
                    </field>
                    <field name="dueText">
                        <default-field title="Respond by">
                            <label text="${dueText}" type="span" style="${overdue ? 'text-negative' : ''}"/>
                        </default-field>
                    </field>
                    <field name="statusId">
                        <header-field title="Status">
                            <drop-down allow-empty="true">
                                <option key="ReqDraft" text="Draft"/>
                                <option key="ReqSubmitted" text="Sent"/>
                                <option key="ReqCompleted" text="Completed"/>
                                <option key="ReqCancelled" text="Cancelled"/>
                            </drop-down>
                        </header-field>
                        <default-field title="Status">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${statusColor}">${
                                    WebUtilities.encodeHtml(statusText)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: statusText})}]]></text>
                                <text type="html">${statusText}</text>
                            </render-mode>
                            <label text="${sendText}" type="div" style="text-caption text-warning" condition="sendText"/>
                        </default-field>
                    </field>
                    <field name="itemsText" align="right"><default-field title="Items"><display/></default-field></field>
                    <field name="respondedText" align="right"><default-field title="Answered"><display/></default-field></field>
                    <field name="revisionText"><default-field title="Revision of"><display/></default-field></field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="requestId"/>
                            <field-ref name="dueText"/>
                        </column>
                        <column>
                            <field-ref name="statusId"/>
                            <field-ref name="respondedText"/>
                        </column>
                    </columns>
                </form-list>
                <label text="${emptyText}" type="p" style="q-pa-md m-muted" condition="!rfqRows.length"/>
            </box-body-nopad>
        </container-box>
    </widgets>
</screen>
