<!-- A new draft RFQ from the shell's quick create (design-purchasing §1 PUR-SHELL, §5 NewQuoteRequest; impl-purchasing P11):
    the buying organization, its name, where it is delivered and by when suppliers respond (empty: the buying policy's response
    days), through mantle.order.SourcingServices.create#QuoteRequest; it opens the draft in QuoteRequestDetail to add its items
    and invite suppliers. For the buyers and the administrator (BOSS_PUR_NEW_RFQ), at the root and out of the menu, as
    NewPurchaseOrder. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="New RFQ" default-menu-include="false">
    <transition-include name="choices" location="component://mr-boss/template/PurchasingParts.xml"/>
    <transition name="createRfq">
        <actions>
            <service-call name="mantle.order.SourcingServices.create#QuoteRequest" out-map="created"
                    in-map="{organizationPartyId:organizationPartyId, requestName:requestName, facilityId:(facilityId || null),
                        responseRequiredDate:(responseRequiredDate || null)}"/>
            <set field="requestId" from="created.requestId"/>
        </actions>
        <default-response url="//Purchasing/Sourcing/QuoteRequestDetail">
            <parameter name="requestId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <actions>
        <set field="draftValue" from="{organizationPartyId:purchasing.activeOrganizationPartyId
                || purchasing.organizationPartyIds[0] || ''}"/>
    </actions>
    <widgets>
        <label text="New RFQ" type="h5"/>
        <label text="A draft request for quotation; add its items and invite suppliers on it, then send it." type="p"
                style="text-caption m-muted"/>
        <form-single name="QuickQuoteRequest" transition="createRfq" map="draftValue">
            <field name="organizationPartyId">
                <default-field title="Buying organization">
                    <drop-down allow-empty="false">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'organizations', selected:organizationPartyId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="requestName"><default-field title="Name"><text-line/></default-field></field>
            <field name="facilityId">
                <default-field title="Deliver to">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0"
                                parameter-map="{choice:'planFacilities'}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="responseRequiredDate">
                <default-field title="Respond by"><date-time type="date"/></default-field>
            </field>
            <field name="submit">
                <default-field title=""><submit text="Create draft" type="primary"/></default-field>
            </field>
        </form-single>
    </widgets>
</screen>
