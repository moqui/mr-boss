<!-- SupplierReturns (design-purchasing §9 Returns; style-guide §3.2 List; impl-purchasing P8): ReturnFind and SupplierReturnList
    over ironstone.purchasing.ReturnServices.find#SupplierReturns (the supplier returns of the user's organizations by view:
    Open, To authorize, To dispatch, Awaiting credit or replacement, Completed, Cancelled; with the supplier's RMA, what was
    authorized and sent back, the physical state and the credit and replacement state apart; a credit's amount for a finance
    reader only), with saved finds, and NewSupplierReturn: a buyer's (PURCHASE_ORDER_EDIT) return to the supplier of a purchase
    order, from one of its receipts chosen by receipt and lot with what it still allows (find#ReturnableReceipts), through
    mantle.order.ReturnServices.create#ReturnFromOrder and add#ReceiptToReturn, which counts the eligibility again under
    lock; it opens the return in ReturnDetail to add more and authorize it. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Supplier returns" default-menu-index="1">
    <parameter name="view"/>
    <parameter name="vendorPartyId"/>
    <parameter name="orderId"/>
    <parameter name="assetReceiptId"/>
    <parameter name="statusId"/>
    <parameter name="organizationPartyId"/>
    <parameter name="text"/>
    <parameter name="pageIndex"/>
    <parameter name="pageSize"/>
    <!-- the order a new return comes from, when opened from OrderDetail's Returns -->
    <parameter name="newOrderId"/>
    <transition-include name="choices" location="component://mr-boss/template/PurchasingParts.xml"/>
    <transition name="newSupplierReturn">
        <actions>
            <!-- the order is one the user may buy on; create#ReturnFromOrder takes its approved, sent or completed part, and
                add#ReceiptToReturn checks PURCHASE_ORDER_EDIT, the organization, the supplier and the eligibility again -->
            <service-call name="ironstone.purchasing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'order', recordId:orderId, capability:'buy'}"/>
            <set field="orderPartSeqId" from="ec.entity.find('mantle.order.OrderPart').condition('orderId', orderId)
                    .orderBy('orderPartSeqId').disableAuthz().one()?.orderPartSeqId"/>
            <service-call name="mantle.order.ReturnServices.create#ReturnFromOrder" out-map="created"
                    in-map="{orderId:orderId, orderPartSeqId:orderPartSeqId, supplierRmaId:supplierRmaId || null,
                        displayId:displayId || null}"/>
            <set field="returnId" from="created.returnId"/>
            <if condition="assetReceiptId">
                <service-call name="mantle.order.ReturnServices.add#ReceiptToReturn" out-map="added"
                        in-map="{returnId:returnId, assetReceiptId:assetReceiptId, returnQuantity:returnQuantity,
                            returnReasonEnumId:returnReasonEnumId || null, returnResponseEnumId:returnResponseEnumId || null,
                            description:description || null}"/>
            </if>
            <message type="success">Created supplier return ${returnId}: add what else goes back, then authorize it</message>
        </actions>
        <default-response url="../ReturnDetail">
            <parameter name="returnId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="ironstone.purchasing.ReturnServices.find#SupplierReturns" out-map="found" transaction="force-new"
                ignore-error="true"
                in-map="{appRoot:appRoot, view:view, vendorPartyId:vendorPartyId, orderId:orderId, assetReceiptId:assetReceiptId,
                    statusId:statusId, organizationPartyId:organizationPartyId, text:text, pageIndex:pageIndex,
                    pageSize:pageSize}"/>
        <set field="returnRows" from="found?.returnRows || []"/>
        <set field="returnRowsCount" from="found?.returnRowsCount"/>
        <set field="returnRowsPageIndex" from="found?.returnRowsPageIndex"/>
        <set field="returnRowsPageSize" from="found?.returnRowsPageSize"/>
        <set field="returnRowsPageMaxIndex" from="found?.returnRowsPageMaxIndex"/>
        <set field="returnRowsPageRangeLow" from="found?.returnRowsPageRangeLow"/>
        <set field="returnRowsPageRangeHigh" from="found?.returnRowsPageRangeHigh"/>
        <set field="viewLabel" from="found?.viewLabel || 'All'"/>
        <set field="can" from="purchasing.capabilities"/>
        <set field="newReturn" from="{orderId:newOrderId || '', returnQuantity:'1', returnReasonEnumId:'RrsnDefective',
                returnResponseEnumId:'RrspCredit'}"/>
        <set field="viewLinks" from="[['', 'All'], ['open', 'Open'], ['authorize', 'To authorize'], ['dispatch', 'To dispatch'],
                ['settle', 'Awaiting credit or replacement'], ['completed', 'Completed'], ['cancelled', 'Cancelled']]
                .map(([key, label]) =&gt; ({key, label, current: (view || '') == key}))"/>
        <set field="filtered" from="!!(view || statusId || vendorPartyId || orderId || assetReceiptId || text)"/>
        <set field="emptyText" from="filtered ? 'No supplier return matches these filters.' : (can.buy
                ? 'No supplier return yet. Send goods back with New supplier return.'
                : 'Your organizations have no supplier return yet.')"/>
    </actions>
    <widgets>
        <context title="Supplier returns"/>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="Supplier returns" type="h5"/>
                <label text="${viewLabel}" type="p" style="text-caption m-muted q-mb-none"/>
            </container>
            <container style="col-auto row items-center q-gutter-xs">
                <container-dialog id="NewSupplierReturnDialog" button-text="New supplier return" type="primary"
                        icon="sym_o_assignment_return" title="Return goods to a supplier" width="720" condition="can.buy">
                    <form-single name="NewSupplierReturn" transition="newSupplierReturn" map="newReturn">
                        <field name="vendorPartyId">
                            <default-field title="Supplier" tooltip="Narrows the purchase orders to this supplier's">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0"
                                            parameter-map="{choice:'suppliers'}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="orderId">
                            <default-field title="Purchase order">
                                <drop-down allow-empty="false">
                                    <dynamic-options transition="choices" server-search="true" min-length="0"
                                            depends-optional="true"
                                            parameter-map="{choice:'returnOrders', selected:newReturn.orderId}">
                                        <depends-on field="vendorPartyId" parameter="partyId"/>
                                    </dynamic-options>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="assetReceiptId">
                            <default-field title="Receipt and lot" tooltip="What each receipt still allows to go back">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="false" min-length="0"
                                            parameter-map="{choice:'returnReceipts'}">
                                        <depends-on field="orderId"/>
                                    </dynamic-options>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="returnQuantity">
                            <default-field title="Quantity">
                                <text-line size="8"/>
                            </default-field>
                        </field>
                        <field name="returnReasonEnumId">
                            <default-field title="Reason">
                                <drop-down allow-empty="false">
                                    <dynamic-options transition="choices" min-length="0"
                                            parameter-map="{choice:'returnReasons'}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="returnResponseEnumId">
                            <default-field title="Asked for">
                                <drop-down allow-empty="false">
                                    <dynamic-options transition="choices" min-length="0"
                                            parameter-map="{choice:'returnResponses'}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="supplierRmaId">
                            <default-field title="Supplier's RMA" tooltip="The supplier's return authorization number">
                                <text-line size="20"/>
                            </default-field>
                        </field>
                        <field name="displayId">
                            <default-field title="Our reference">
                                <text-line size="20"/>
                            </default-field>
                        </field>
                        <field name="submitButton">
                            <default-field title="Create return">
                                <submit/>
                            </default-field>
                        </field>
                        <field-layout>
                            <field-row>
                                <field-ref name="vendorPartyId"/>
                                <field-ref name="orderId"/>
                            </field-row>
                            <field-row>
                                <field-ref name="assetReceiptId"/>
                                <field-ref name="returnQuantity"/>
                            </field-row>
                            <field-row>
                                <field-ref name="returnReasonEnumId"/>
                                <field-ref name="returnResponseEnumId"/>
                            </field-row>
                            <field-row>
                                <field-ref name="supplierRmaId"/>
                                <field-ref name="displayId"/>
                            </field-row>
                            <field-ref name="submitButton"/>
                        </field-layout>
                    </form-single>
                    <label type="p" style="text-caption m-muted"
                            text="A receipt allows what it accepted less what earlier returns took, no more than is on hand;
                                rejected stock goes back once its inspection's disposition is Return to supplier."/>
                </container-dialog>
            </container>
        </container>
        <container style="row q-gutter-xs q-mb-sm">
            <section-iterate name="ReturnViews" list="viewLinks" entry="viewLink">
                <widgets>
                    <link url="." text="${viewLink.label}" link-type="anchor-button" icon="sym_o_check"
                            parameter-map="{view:viewLink.key}" condition="viewLink.current"/>
                    <link url="." text="${viewLink.label}" link-type="anchor-button" parameter-map="{view:viewLink.key}"
                            condition="!viewLink.current"/>
                </widgets>
            </section-iterate>
        </container>
        <container-box>
            <box-body-nopad>
                <form-list name="SupplierReturnList" list="returnRows" skip-form="true" paginate="true" header-dialog="true"
                        saved-finds="true" select-columns="true">
                    <field name="returnId">
                        <header-field title="Return" show-order-by="false"/>
                        <default-field title="Return">
                            <link url="../ReturnDetail" text="${returnId}" link-type="anchor"
                                    parameter-map="{returnId:returnId}"/>
                            <label text="RMA ${supplierRmaId}" type="div" style="text-caption m-muted" condition="supplierRmaId"/>
                        </default-field>
                    </field>
                    <field name="text">
                        <header-field title="Return, supplier's RMA or reference">
                            <text-find hide-options="true"/>
                        </header-field>
                    </field>
                    <field name="vendorPartyId">
                        <header-field title="Supplier">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'suppliers', selected:vendorPartyId}"/>
                            </drop-down>
                        </header-field>
                        <default-field title="Supplier">
                            <display text="${supplierName}"/>
                        </default-field>
                    </field>
                    <field name="orderId">
                        <header-field title="Purchase order">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'returnOrders', selected:orderId}"/>
                            </drop-down>
                        </header-field>
                        <default-field title="Orders">
                            <display text="${orderText}"/>
                        </default-field>
                    </field>
                    <field name="assetReceiptId">
                        <header-field title="Receipt">
                            <text-line size="12"/>
                        </header-field>
                    </field>
                    <field name="organizationPartyId">
                        <header-field title="Buying organization">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'organizations', selected:organizationPartyId}"/>
                            </drop-down>
                        </header-field>
                        <default-field title="Buyer">
                            <display text="${organizationName}"/>
                        </default-field>
                    </field>
                    <field name="statusId">
                        <header-field title="Status">
                            <drop-down allow-empty="true">
                                <entity-options key="${statusId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.StatusItem">
                                        <econdition field-name="statusTypeId" value="Return"/>
                                        <order-by field-name="sequenceNum"/>
                                    </entity-find>
                                </entity-options>
                            </drop-down>
                        </header-field>
                        <default-field title="Status">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${statusColor}">${
                                    WebUtilities.encodeHtml(statusText)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: statusText})}]]></text>
                                <text type="html">${statusText}</text>
                            </render-mode>
                        </default-field>
                    </field>
                    <field name="authorizedText" align="right">
                        <default-field title="Quantity">
                            <display/>
                        </default-field>
                    </field>
                    <field name="physicalText">
                        <default-field title="Dispatch">
                            <display/>
                        </default-field>
                    </field>
                    <field name="settlementText">
                        <default-field title="Credit and replacement">
                            <display/>
                            <label text="Replacement ${replacementText}" type="div" style="text-caption m-muted"
                                    condition="replacementText"/>
                        </default-field>
                    </field>
                    <field name="entryText">
                        <default-field title="Entered">
                            <display/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="returnId"/>
                            <field-ref name="vendorPartyId"/>
                        </column>
                        <column>
                            <field-ref name="statusId"/>
                            <field-ref name="settlementText"/>
                        </column>
                    </columns>
                </form-list>
                <label text="${emptyText}" type="p" style="q-pa-md m-muted" condition="!returnRows.length"/>
            </box-body-nopad>
        </container-box>
    </widgets>
</screen>
