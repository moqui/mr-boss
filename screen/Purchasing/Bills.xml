<!-- The Bills and matching area of IronStone Purchasing (design-purchasing §1, §10; impl-purchasing P6), for the buying lists'
    groups (BOSS_PUR_LISTS): BillList (the default: the buying organizations' supplier bills, find and views, Upload supplier
    bill through Accounting's import#Bill for a buyer with PAYABLE_IMPORT), MatchExceptions (held bills, match variances,
    received not billed and billed not received, the bulk re-evaluation and the hold release request), LegacyMatches
    (Accounting's legacy match backfill, for a match operator), and Projects' shared InvoiceDetail and Accounting's shared
    InvoiceMatch in the Purchasing context (crosscut §3.16, §3.22; hidden from the menu). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Bills &amp; matching" default-menu-index="11" menu-image="sym_o_receipt" menu-image-type="icon">
    <subscreens default-item="BillList" always-use-full-path="true">
        <subscreens-item name="InvoiceDetail" location="component://mr-boss/screen/Shared/InvoiceDetail.xml" menu-include="false"/>
        <subscreens-item name="InvoiceMatch" location="component://mr-boss/screen/Shared/InvoiceMatch.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-menu id="PurchasingBillTabs" type="tab"/>
        <subscreens-active/>
    </widgets>
</screen>
