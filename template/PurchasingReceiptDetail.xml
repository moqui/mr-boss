<!-- Purchasing's receiving parts (impl-purchasing P5; design-purchasing §9; crosscut §3.8 Purchasing row). A screen includes
    each transition it uses by name (transition-include) and each section (section-include), so a form here posts to the
    screen it is on. Purchasing posts no stock: every write checks the record through
    ironstone.purchasing.AccessServices.check#Record, then calls the Mantle service, which checks its permission and the
    organization again.
    - purchaseReceiptChoices: the receiving drop-downs (get#Choices: receiptParts, rejectionReasons, receiptLocations);
    - prepareReceipt: PrepareReceipt, "Expected receipt (ASN)": the order part's one open receipt
      (mantle.shipment.WarehouseTaskServices.ensure#PurchaseReceipt, for a buyer or a receiver), then ShipmentDetail;
    - purchaseReceive: receive one line through Warehouse's receive guard (receive#ShipmentStock: the receipt step, the
      tracking policy and, where an inspection applies, quarantine and the inspection), for a holder of STOCK_RECEIVE;
    - purchaseFinishReceipt: a short receipt's remainder closed or backordered, then the receipt delivered
      (close#ReceiptRemainder);
    - purchaseReceiveAll: "Receive all as expected", confirmed (receive#ExpectedShipment);
    - purchaseBillReceipt: AP intake's draft bill of a delivered receipt on its accepted quantity
      (mantle.account.InvoiceServices.create#InvoiceFromSource, basis received, PAYABLE_EDIT);
    - sections PrepareReceiptDialog (Receipts' header) and PurchasingReceipt (Shared/ShipmentDetail's Purchasing branch). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <transition name="purchaseReceiptChoices" read-only="true">
        <actions>
            <service-call name="ironstone.purchasing.AccessServices.get#Choices" in-map="context" out-map="found"/>
            <script>ec.web.sendJsonResponse(found.options)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition name="prepareReceipt">
        <actions>
            <set field="partKey" from="String(orderPart || '').split(':')"/>
            <if condition="!partKey[0]">
                <return error="true" message="Choose the purchase order"/>
            </if>
            <service-call name="ironstone.purchasing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'order', recordId:partKey[0]}"/>
            <service-call name="mantle.shipment.WarehouseTaskServices.ensure#PurchaseReceipt" out-map="ensured"
                    in-map="{operationKey:operationKey, orderId:partKey[0], orderPartSeqId:partKey[1] || '01',
                        estimatedArrivalDate:estimatedArrivalDate || null}"/>
            <set field="shipmentId" from="ensured.result.shipmentId"/>
            <message type="success">${ensured.result.resultCode == 'EXISTING' ? 'Opened the expected receipt'
                    : 'Expected receipt created:'} ${shipmentId} for order ${partKey[0]}</message>
        </actions>
        <default-response url="${sharedLinks['Receiving/ShipmentDetail']}">
            <parameter name="shipmentId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="purchaseReceive">
        <actions>
            <service-call name="ironstone.purchasing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'receipt', recordId:shipmentId, capability:'receive'}"/>
            <service-call name="mantle.shipment.WarehouseTaskServices.receive#ShipmentStock" out-map="received"
                    in-map="{operationKey:operationKey, shipmentId:shipmentId, productId:productId,
                        quantityAccepted:quantityAccepted || null, quantityRejected:quantityRejected || null,
                        rejectionReasonEnumId:rejectionReasonEnumId || null, lotNumber:lotNumber || null,
                        expirationDate:expirationDate || null, locationSeqId:locationSeqId || null}"/>
            <set field="inspectionText" from="received.result.qualityInspectionIds?.length ? '; held for inspection '
                    + received.result.qualityInspectionIds.join(', ') : ''"/>
            <message type="success">Received ${received.result.quantityAccepted} accepted and ${
                    received.result.quantityRejected} rejected of ${productId}${inspectionText}</message>
        </actions>
        <default-response url=".">
            <parameter name="shipmentId"/>
        </default-response>
        <error-response url=".">
            <parameter name="shipmentId"/>
        </error-response>
    </transition>
    <transition name="purchaseFinishReceipt">
        <actions>
            <service-call name="ironstone.purchasing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'receipt', recordId:shipmentId, capability:'receive'}"/>
            <service-call name="mantle.shipment.WarehouseTaskServices.close#ReceiptRemainder" out-map="closed"
                    in-map="{operationKey:operationKey, shipmentId:shipmentId, choice:choice, reason:reason}"/>
            <set field="closedText" from="closed.result.resultCode == 'CLOSED' ? 'The remainder is closed on the order'
                    : 'The remainder is backordered on ' + (closed.result.backorders || []).map(row =&gt; row.shipmentId)
                        .join(', ')"/>
            <message type="success">${closedText}; receipt ${shipmentId} is ${closed.result.delivered ? 'delivered'
                    : 'cancelled'}</message>
        </actions>
        <default-response url=".">
            <parameter name="shipmentId"/>
        </default-response>
        <error-response url=".">
            <parameter name="shipmentId"/>
        </error-response>
    </transition>
    <transition name="purchaseReceiveAll">
        <actions>
            <service-call name="ironstone.purchasing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'receipt', recordId:shipmentId, capability:'receive'}"/>
            <service-call name="mantle.shipment.WarehouseTaskServices.receive#ExpectedShipment" out-map="receivedAll"
                    in-map="{operationKey:operationKey, shipmentId:shipmentId, confirmed:confirmed == 'Y'}"/>
            <message type="success">Received ${receivedAll.result.lines.length} lines as expected; receipt ${shipmentId}
                is delivered</message>
        </actions>
        <default-response url=".">
            <parameter name="shipmentId"/>
        </default-response>
        <error-response url=".">
            <parameter name="shipmentId"/>
        </error-response>
    </transition>
    <transition name="purchaseBillReceipt">
        <actions>
            <service-call name="ironstone.purchasing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'receipt', recordId:shipmentId, capability:'payableEdit'}"/>
            <!-- the receipt's purchase order part (a purchase receipt is one part's, ensure#PurchaseReceipt) -->
            <set field="billSource" from="ec.entity.find('mantle.shipment.ShipmentItemSource').condition('shipmentId', shipmentId)
                    .condition('orderId', 'is-not-null', null).disableAuthz().list()[0]"/>
            <set field="billPart" from="billSource ? ec.entity.find('mantle.order.OrderItem').condition({orderId:
                    billSource.orderId, orderItemSeqId: billSource.orderItemSeqId}).disableAuthz().one() : null"/>
            <if condition="!billPart">
                <return error="true" message="Receipt ${shipmentId} names no purchase order line"/>
            </if>
            <service-call name="mantle.account.InvoiceServices.create#InvoiceFromSource" out-map="sourced"
                    in-map="{orderId:billPart.orderId, orderPartSeqId:billPart.orderPartSeqId, basis:'received',
                        shipmentId:shipmentId, operationKey:operationKey}"/>
            <message type="success">Draft bill ${sourced.invoiceId} created from the accepted quantity of receipt
                ${shipmentId}</message>
        </actions>
        <default-response url=".">
            <parameter name="shipmentId"/>
        </default-response>
        <error-response url=".">
            <parameter name="shipmentId"/>
        </error-response>
    </transition>
    <widgets>
        <!-- PrepareReceipt (design §9): "Expected receipt (ASN)", the order part's one open receipt; for a buyer or a receiver -->
        <section name="PrepareReceiptDialog" condition="purchasing.capabilities.buy || purchasing.capabilities.receive">
            <actions>
                <set field="prepareValue" from="{operationKey:'asn-' + ec.user.randomString(24), orderPart:prepareOrderPart || ''}"/>
            </actions>
            <widgets>
                <container-dialog id="PrepareReceiptDialog" button-text="Expected receipt (ASN)" icon="sym_o_local_shipping"
                        title="Expected receipt (ASN)" width="640">
                    <label text="Records the receipt the supplier is sending. A purchase order has one open receipt: a second
                            request opens the same one." type="p"/>
                    <form-single name="PrepareReceipt" transition="prepareReceipt" map="prepareValue">
                        <field name="operationKey">
                            <default-field>
                                <hidden/>
                            </default-field>
                        </field>
                        <field name="orderPart">
                            <conditional-field condition="prepareOrderPart" title="">
                                <hidden/>
                            </conditional-field>
                            <default-field title="Purchase order" tooltip="An approved or sent purchase order">
                                <drop-down allow-empty="false">
                                    <dynamic-options transition="purchaseReceiptChoices" server-search="true" min-length="0"
                                            parameter-map="{choice:'receiptParts'}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="estimatedArrivalDate">
                            <default-field title="Expected arrival">
                                <date-time type="date"/>
                            </default-field>
                        </field>
                        <field name="submitButton">
                            <default-field title="">
                                <submit text="Open the expected receipt"/>
                            </default-field>
                        </field>
                    </form-single>
                </container-dialog>
            </widgets>
        </section>

        <!-- ShipmentDetail's Purchasing branch (crosscut §3.8 Purchasing row): a purchase receipt of the user's orders -->
        <section name="PurchasingReceipt" condition="appRoot == 'Purchasing'">
            <actions>
                <set field="rc" from="purchaseReceipt?.receipt || null"/>
                <if condition="rc">
                    <set field="finishKey" from="'pur-finish-' + ec.user.randomString(24)"/>
                    <set field="receiveAllKey" from="'pur-receive-all-' + ec.user.randomString(24)"/>
                    <set field="billKey" from="'pur-bill-' + ec.user.randomString(24)"/>
                    <set field="purchaseLineRows" from="purchaseReceipt.lineRows"/>
                    <set field="purchaseReceiptRows" from="purchaseReceipt.receiptRows"/>
                    <set field="purchaseInspectionRows" from="purchaseReceipt.inspectionRows"/>
                    <set field="primaryOrderId" from="rc.orderIds[0] || null"/>
                </if>
            </actions>
            <widgets>
                <section name="PurchasingReceiptMissing" condition="!rc">
                    <widgets>
                        <container-box type="warning">
                            <box-header title="Not available"/>
                            <box-body>
                                <label type="p" text="Shipment ${shipmentId} is not available: it does not exist, or it is not a
                                        receipt of your organizations' purchase orders from a supplier you work with."/>
                                <link url="${sharedLinks['Receiving/Receipts']}" text="Back to receipts" link-type="anchor"/>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
                <section name="PurchasingReceiptFound" condition="rc">
                    <widgets>
                        <context record-entity="mantle.shipment.Shipment" record-id="${shipmentId}"
                                title="Receipt ${shipmentId} · ${rc.supplierName}"/>
                        <container style="m-record-header">
                            <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                                <container style="col-12 col-md m-record-title">
                                    <label text="Receipt ${shipmentId}" type="h5"/>
                                    <label text="${['From ' + rc.supplierName, rc.facilityName ? 'to ' + rc.facilityName : '',
                                            'expected ' + rc.expectedText, rc.orderIds.length ? 'order ' + rc.orderIds.join(', ')
                                            : ''].filter(Boolean).join(' · ')}" type="p" style="text-caption m-muted"/>
                                </container>
                                <container style="col-12 col-md-auto m-record-status">
                                    <render-mode>
                                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                                            rc.statusColor}">${WebUtilities.encodeHtml(rc.statusText)}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", id: "PurchaseReceiptStatus",
                                            style: "strong", text: rc.statusText})}]]></text>
                                        <text type="html">${rc.statusText}</text>
                                        <text type="html-print">${rc.statusText}</text>
                                    </render-mode>
                                    <label text="Overdue" type="span" style="text-negative q-ml-sm" condition="rc.overdue"/>
                                </container>
                            </container>
                            <container style="row items-center q-col-gutter-x-md q-col-gutter-y-sm m-record-foot">
                                <container style="col-12 row items-center q-gutter-sm m-record-actions">
                                    <!-- Finish receipt: a short receipt's remainder closed or backordered, then delivered -->
                                    <container-dialog id="PurchaseFinishReceiptDialog" button-text="Finish receipt"
                                            title="Finish receipt ${shipmentId}: ${rc.dueQuantity} not received" width="640"
                                            condition="rc.canFinish">
                                        <label text="Only what was received stays on this receipt; it is then delivered."
                                                type="p"/>
                                        <form-single name="PurchaseFinishReceipt" transition="purchaseFinishReceipt"
                                                map="{shipmentId:shipmentId, operationKey:finishKey, choice:'backorder'}">
                                            <field name="shipmentId"><default-field><hidden/></default-field></field>
                                            <field name="operationKey"><default-field><hidden/></default-field></field>
                                            <field name="choice">
                                                <default-field title="What did not arrive">
                                                    <radio no-current-selected-key="backorder">
                                                        <option key="backorder" text="Backorder it on a new receipt"/>
                                                        <option key="close" text="Close it on the order"/>
                                                    </radio>
                                                </default-field>
                                            </field>
                                            <field name="reason">
                                                <default-field title="Reason">
                                                    <text-line size="50"/>
                                                </default-field>
                                            </field>
                                            <field name="submitButton">
                                                <default-field title="">
                                                    <submit text="Finish receipt" confirmation="Finish receipt ${shipmentId}
                                                            with what was received, and deliver it?"/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                    <!-- Receive all as expected: every remaining unit accepted, then delivered; confirmed -->
                                    <container-dialog id="PurchaseReceiveAllDialog" button-text="Receive all as expected"
                                            title="Receive every remaining unit of ${shipmentId} as expected" width="560"
                                            condition="rc.canReceiveAll">
                                        <label text="Use this only when everything that remains arrived: every due unit is
                                                accepted, then the receipt is delivered. Lot and serial-tracked lines are
                                                received one by one." type="p"/>
                                        <form-single name="PurchaseReceiveAll" transition="purchaseReceiveAll"
                                                map="{shipmentId:shipmentId, operationKey:receiveAllKey}">
                                            <field name="shipmentId"><default-field><hidden/></default-field></field>
                                            <field name="operationKey"><default-field><hidden/></default-field></field>
                                            <field name="confirmed">
                                                <default-field title="">
                                                    <check>
                                                        <option key="Y" text="All ${rc.dueQuantity} remaining units arrived"/>
                                                    </check>
                                                </default-field>
                                            </field>
                                            <field name="submitButton">
                                                <default-field title="">
                                                    <submit text="Receive all" confirmation="Accept every remaining unit of
                                                            ${shipmentId} and deliver it?"/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                    <!-- AP intake: a draft bill from the receipt's accepted quantity (crosscut §3.8, D2) -->
                                    <container-dialog id="PurchaseBillReceiptDialog" button-text="Create draft bill"
                                            icon="sym_o_request_quote" title="Draft bill from receipt ${shipmentId}" width="560"
                                            condition="rc.canBill">
                                        <label text="Bills the accepted quantity of this receipt with no open inspection, at the
                                                order's prices; a quantity already billed is not billed again." type="p"/>
                                        <form-single name="PurchaseBillReceipt" transition="purchaseBillReceipt"
                                                map="{shipmentId:shipmentId, operationKey:billKey}">
                                            <field name="shipmentId"><default-field><hidden/></default-field></field>
                                            <field name="operationKey"><default-field><hidden/></default-field></field>
                                            <field name="submitButton">
                                                <default-field title="">
                                                    <submit text="Create draft bill"
                                                            confirmation="Create a draft bill from receipt ${shipmentId}?"/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                    <button-menu text="More" icon="more_horiz">
                                        <link url="${sharedLinks['Orders/OrderDetail']}" text="Purchase order"
                                                icon="sym_o_receipt_long" condition="primaryOrderId"
                                                parameter-map="{orderId:primaryOrderId}"/>
                                        <link url="${sharedLinks['Suppliers/Supplier360']}" text="Supplier"
                                                icon="sym_o_storefront" condition="rc.supplierPartyId"
                                                parameter-map="{vendorPartyId:rc.supplierPartyId}"/>
                                        <link url="${sharedLinks['Receiving/Receipts']}" text="Receipts" icon="sym_o_inbox"/>
                                    </button-menu>
                                </container>
                            </container>
                            <label text="Receiving is done by the warehouse's receivers; you see its progress here." type="p"
                                    style="text-caption m-muted q-mt-sm q-mb-none" condition="rc.progressOnly &amp;&amp; rc.open"/>
                        </container>
                        <container-box>
                            <box-header title="Items and sources"/>
                            <box-body-nopad>
                                <form-list name="PurchaseReceiptLines" list="purchaseLineRows" skip-form="true" paginate="false">
                                    <field name="lineText">
                                        <default-field title="Order line">
                                            <link url="${sharedLinks['Orders/OrderDetail']}" text="${lineText}"
                                                    link-type="anchor" parameter-map="{orderId:orderId}"/>
                                        </default-field>
                                    </field>
                                    <field name="productName"><default-field title="Product"><display/></default-field></field>
                                    <field name="expectedQuantity" align="right">
                                        <default-field title="Expected"><display/></default-field></field>
                                    <field name="receivedQuantity" align="right">
                                        <default-field title="Received"><display/></default-field></field>
                                    <field name="acceptedQuantity" align="right">
                                        <default-field title="Accepted"><display/></default-field></field>
                                    <field name="rejectedQuantity" align="right">
                                        <default-field title="Rejected"><display/></default-field></field>
                                    <field name="heldQuantity" align="right">
                                        <default-field title="Held"><display/></default-field></field>
                                    <field name="dueQuantity" align="right">
                                        <default-field title="Due"><display/></default-field></field>
                                    <field name="unitText"><default-field title="Unit"><display/></default-field></field>
                                    <field name="actions">
                                        <default-field title="">
                                            <container-dialog id="PurchaseReceive_${shipmentItemSourceId}" button-text="Receive"
                                                    icon="sym_o_move_to_inbox" width="640"
                                                    title="Receive ${productName} on ${shipmentId}"
                                                    condition="rc.canReceive &amp;&amp; dueValue != '0'">
                                                <form-single name="PurchaseReceiveLine" transition="purchaseReceive"
                                                        map="{shipmentId:shipmentId, productId:productId, quantityAccepted:dueValue,
                                                            operationKey:'pur-receive-' + ec.user.randomString(24)}">
                                                    <field name="shipmentId"><default-field><hidden/></default-field></field>
                                                    <field name="productId"><default-field><hidden/></default-field></field>
                                                    <field name="operationKey"><default-field><hidden/></default-field></field>
                                                    <field name="quantityAccepted">
                                                        <default-field title="Accepted" tooltip="In the stock unit">
                                                            <text-line size="8"/></default-field>
                                                    </field>
                                                    <field name="quantityRejected">
                                                        <default-field title="Rejected"><text-line size="8"/></default-field>
                                                    </field>
                                                    <field name="rejectionReasonEnumId">
                                                        <default-field title="Rejection reason">
                                                            <drop-down allow-empty="true">
                                                                <dynamic-options transition="purchaseReceiptChoices"
                                                                        parameter-map="{choice:'rejectionReasons'}"/>
                                                            </drop-down>
                                                        </default-field>
                                                    </field>
                                                    <field name="lotNumber">
                                                        <default-field title="Lot" tooltip="For a lot-tracked product">
                                                            <text-line size="20"/></default-field>
                                                    </field>
                                                    <field name="expirationDate">
                                                        <default-field title="Expires"><date-time type="date"/></default-field>
                                                    </field>
                                                    <field name="locationSeqId">
                                                        <default-field title="Location"
                                                                tooltip="Empty takes the receipt step's destination">
                                                            <drop-down allow-empty="true">
                                                                <dynamic-options transition="purchaseReceiptChoices"
                                                                        server-search="true" min-length="0"
                                                                        parameter-map="{choice:'receiptLocations', shipmentId:shipmentId}"/>
                                                            </drop-down>
                                                        </default-field>
                                                    </field>
                                                    <field name="submitButton">
                                                        <default-field title="">
                                                            <submit text="Receive" confirmation="Receive these units of
                                                                    ${productName} on ${shipmentId}?"/>
                                                        </default-field>
                                                    </field>
                                                    <field-layout>
                                                        <field-row>
                                                            <field-ref name="quantityAccepted"/>
                                                            <field-ref name="quantityRejected"/>
                                                        </field-row>
                                                        <field-ref name="rejectionReasonEnumId"/>
                                                        <field-row>
                                                            <field-ref name="lotNumber"/>
                                                            <field-ref name="expirationDate"/>
                                                        </field-row>
                                                        <field-ref name="locationSeqId"/>
                                                        <field-ref name="submitButton"/>
                                                    </field-layout>
                                                </form-single>
                                            </container-dialog>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column><field-ref name="lineText"/><field-ref name="productName"/></column>
                                        <column><field-ref name="acceptedQuantity"/><field-ref name="dueQuantity"/>
                                            <field-ref name="actions"/></column>
                                    </columns>
                                </form-list>
                                <label text="This receipt has no lines." type="p" style="q-pa-md m-muted"
                                        condition="!purchaseLineRows.length"/>
                            </box-body-nopad>
                        </container-box>
                        <container-box>
                            <box-header title="Receipts"/>
                            <box-body-nopad>
                                <form-list name="PurchaseReceiptRows" list="purchaseReceiptRows" skip-form="true"
                                        paginate="false">
                                    <field name="receivedText"><default-field title="Received"><display/></default-field></field>
                                    <field name="lineText"><default-field title="Order line"><display/></default-field></field>
                                    <field name="productName"><default-field title="Product"><display/></default-field></field>
                                    <field name="acceptedQuantity" align="right">
                                        <default-field title="Accepted"><display/></default-field></field>
                                    <field name="rejectedQuantity" align="right">
                                        <default-field title="Rejected"><display/></default-field></field>
                                    <field name="rejectionText"><default-field title="Reason"><display/></default-field></field>
                                    <field name="receivedBy"><default-field title="By"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="productName"/><field-ref name="receivedText"/></column>
                                        <column><field-ref name="acceptedQuantity"/><field-ref name="rejectedQuantity"/></column>
                                    </columns>
                                </form-list>
                                <label text="Nothing is received on this receipt yet." type="p" style="q-pa-md m-muted"
                                        condition="!purchaseReceiptRows.length"/>
                            </box-body-nopad>
                        </container-box>
                        <!-- P14b: the customer order lines its lines were bought for, with Reserve (R-PUR-37) -->
                        <section-include name="PurchasingReceiptPegs"
                                location="component://mr-boss/template/PurchasingReceiptPegs.xml"/>
                        <section name="PurchaseReceiptInspections" condition="purchaseInspectionRows.length">
                            <widgets>
                                <container-box>
                                    <box-header title="Inspection"/>
                                    <box-body-nopad>
                                        <form-list name="PurchaseReceiptInspectionList" list="purchaseInspectionRows"
                                                skip-form="true" paginate="false">
                                            <field name="qualityInspectionId">
                                                <default-field title="Inspection">
                                                    <link url="${sharedLinks['Receiving/QualityInspection']}"
                                                            text="${qualityInspectionId}" link-type="anchor"
                                                            parameter-map="{qualityInspectionId:qualityInspectionId}"/>
                                                </default-field>
                                            </field>
                                            <field name="productName"><default-field title="Product"><display/></default-field></field>
                                            <field name="statusText">
                                                <default-field title="Status">
                                                    <render-mode>
                                                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${
                                                            statusColor}">${WebUtilities.encodeHtml(statusText)}</q-chip>]]></text>
                                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: statusText})}]]></text>
                                                        <text type="html">${statusText}</text>
                                                    </render-mode>
                                                </default-field>
                                            </field>
                                            <field name="quantityText" align="right">
                                                <default-field title="Inspected"><display/></default-field></field>
                                            <field name="heldText" align="right">
                                                <default-field title="Held"><display/></default-field></field>
                                            <field name="outcomeText"><default-field title="Outcome"><display/></default-field></field>
                                            <columns type="mobile">
                                                <column><field-ref name="qualityInspectionId"/><field-ref name="productName"/></column>
                                                <column><field-ref name="statusText"/><field-ref name="heldText"/></column>
                                            </columns>
                                        </form-list>
                                    </box-body-nopad>
                                </container-box>
                            </widgets>
                        </section>
                        <container style="row q-col-gutter-md">
