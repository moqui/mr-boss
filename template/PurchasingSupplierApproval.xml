<!-- Supplier360's supplier approval for Purchasing (design-purchasing Supplier360, R-PUR-15; impl-purchasing P4): the Approval
    menu of the header, beside the approval chip, from get#SupplierContext's profile and capabilities. A buyer submits a
    supplier that is not approved (mantle.order.PurchaseServices.submit#SupplierApproval: Pending, and a PurchaseSupplierApproval
    notice to its approvers) and suspends one with a dated block and its reason (suspend#Supplier); a purchase approver
    approves or refuses a Pending one at its revision, the count of its profile rows (decide#SupplierApproval). Each
    transition checks the supplier with AccessServices.check#Record, included by name in Shared/Supplier360.xml. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <transition name="submitSupplier">
        <actions>
            <script>if (appRoot !== 'Purchasing') throw new Error('Supplier approval actions require the Purchasing context')</script>
            <service-call name="ironstone.purchasing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'supplier', recordId:vendorPartyId, capability:'profileEdit'}"/>
            <service-call name="mantle.order.PurchaseServices.submit#SupplierApproval" out-map="submitted"
                    in-map="{organizationPartyId:organizationPartyId, supplierPartyId:vendorPartyId, reason:reason}"/>
            <message type="success">Submitted for approval to ${submitted.notifiedCount} approvers</message>
        </actions>
        <default-response url=".">
            <parameter name="vendorPartyId"/>
            <parameter name="organizationPartyId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="decideSupplier">
        <actions>
            <script>if (appRoot !== 'Purchasing') throw new Error('Supplier approval actions require the Purchasing context')</script>
            <service-call name="ironstone.purchasing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'supplier', recordId:vendorPartyId, capability:'approve'}"/>
            <service-call name="mantle.order.PurchaseServices.decide#SupplierApproval" out-map="decided"
                    in-map="{organizationPartyId:organizationPartyId, supplierPartyId:vendorPartyId,
                        sourceRevision:sourceRevision || null, decision:decision, reason:reason}"/>
            <message type="success">${decided.approvalStatusId == 'SupaApproved' ? 'Approved'
                    : decided.approvalStatusId == 'SupaRejected' ? 'Refused' : 'Approved; waiting for the next step'}</message>
        </actions>
        <default-response url=".">
            <parameter name="vendorPartyId"/>
            <parameter name="organizationPartyId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="suspendSupplier">
        <actions>
            <script>if (appRoot !== 'Purchasing') throw new Error('Supplier approval actions require the Purchasing context')</script>
            <service-call name="ironstone.purchasing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'supplier', recordId:vendorPartyId, capability:'profileEdit'}"/>
            <service-call name="mantle.order.PurchaseServices.suspend#Supplier"
                    in-map="{organizationPartyId:organizationPartyId, supplierPartyId:vendorPartyId, reason:reason,
                        fromDate:suspendFromDate || null, thruDate:suspendThruDate || null}"/>
            <message type="success">Suspended</message>
        </actions>
        <default-response url=".">
            <parameter name="vendorPartyId"/>
            <parameter name="organizationPartyId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <widgets>
        <section name="PurchasingSupplierApproval" condition="appRoot == 'Purchasing'">
            <actions>
                <set field="approvalStatusId" from="profile?.approvalStatusId || null"/>
                <set field="canSubmit" from="!!purchasingCapabilities?.profileEdit &amp;&amp; approvalStatusId != 'SupaApproved'
                        &amp;&amp; approvalStatusId != 'SupaPending'"/>
                <set field="canSuspend" from="!!purchasingCapabilities?.profileEdit &amp;&amp; approvalStatusId != 'SupaSuspended'"/>
                <set field="canDecide" from="!!purchasingCapabilities?.approve &amp;&amp; approvalStatusId == 'SupaPending'"/>
                <set field="decideValue" from="{vendorPartyId:vendorPartyId, organizationPartyId:organizationPartyId,
                        sourceRevision:String((profileRows || []).length)}"/>
                <set field="approvalScope" from="{vendorPartyId:vendorPartyId, organizationPartyId:organizationPartyId}"/>
            </actions>
            <widgets>
                <button-menu text="Approval" icon="sym_o_approval" condition="canSubmit || canSuspend || canDecide">
                    <container-dialog id="SupplierApprove" button-text="Approve" icon="sym_o_check" width="520"
                            title="Approve ${supplier.supplierName} for ${organizationName}" condition="canDecide">
                        <form-single name="ApproveSupplier" transition="decideSupplier" map="decideValue">
                            <field name="vendorPartyId"><default-field><hidden/></default-field></field>
                            <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                            <field name="sourceRevision"><default-field><hidden/></default-field></field>
                            <field name="decision" from="'approve'"><default-field><hidden/></default-field></field>
                            <field name="reason"><default-field title="Note"><text-area rows="2"/></default-field></field>
                            <field name="submitButton"><default-field title="Approve"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="SupplierRefuse" button-text="Refuse" icon="sym_o_block" width="520"
                            title="Refuse ${supplier.supplierName} for ${organizationName}" condition="canDecide">
                        <form-single name="RefuseSupplier" transition="decideSupplier" map="decideValue">
                            <field name="vendorPartyId"><default-field><hidden/></default-field></field>
                            <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                            <field name="sourceRevision"><default-field><hidden/></default-field></field>
                            <field name="decision" from="'refuse'"><default-field><hidden/></default-field></field>
                            <field name="reason">
                                <default-field title="Reason"><text-area rows="2" required="true"/></default-field>
                            </field>
                            <field name="submitButton">
                                <default-field title="Refuse">
                                    <submit type="danger" confirmation="Refuse ${supplier.supplierName}? It is set Rejected."/>
                                </default-field>
                            </field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="SupplierSubmit" button-text="Submit for approval" icon="sym_o_send" width="520"
                            title="Submit ${supplier.supplierName} for approval" condition="canSubmit">
                        <form-single name="SubmitSupplier" transition="submitSupplier" map="approvalScope">
                            <field name="vendorPartyId"><default-field><hidden/></default-field></field>
                            <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                            <field name="reason"><default-field title="Note to the approvers"><text-area rows="2"/></default-field></field>
                            <field name="submitButton"><default-field title="Submit"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="SupplierSuspend" button-text="Suspend" icon="sym_o_pause_circle" width="560"
                            title="Suspend ${supplier.supplierName}" condition="canSuspend">
                        <form-single name="SuspendSupplier" transition="suspendSupplier" map="approvalScope">
                            <field name="vendorPartyId"><default-field><hidden/></default-field></field>
                            <field name="organizationPartyId"><default-field><hidden/></default-field></field>
                            <field name="reason"><default-field title="Reason"><text-line required="true"/></default-field></field>
                            <field name="suspendFromDate">
                                <default-field title="From" tooltip="Leave empty to suspend now"><date-time/></default-field>
                            </field>
                            <field name="suspendThruDate">
                                <default-field title="Through" tooltip="Leave empty until it is approved again"><date-time/></default-field>
                            </field>
                            <field name="submitButton">
                                <default-field title="Suspend">
                                    <submit type="danger"
                                            confirmation="Suspend ${supplier.supplierName}? Purchase orders and RFQs to it are stopped; open orders stay."/>
                                </default-field>
                            </field>
                            <field-layout>
                                <field-ref name="reason"/>
                                <field-row>
                                    <field-ref name="suspendFromDate"/>
                                    <field-ref name="suspendThruDate"/>
                                </field-row>
                                <field-ref name="submitButton"/>
                            </field-layout>
                        </form-single>
                    </container-dialog>
                </button-menu>
            </widgets>
        </section>
    </widgets>
</screen>
