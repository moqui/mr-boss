<!-- Customer360's Commerce branch (crosscut §3.2; design-commerce §10 Customer360; impl-commerce P8): the section
    Shared/Customer360 includes when appRoot is Commerce, over mantle.order.StoreOperationsServices.get#StoreCustomer (read in
    its always-actions: a customer with an order or a signed-in cart in the user's stores; anyone else is "not available").
    The header (name, stores, PASS account state) with the customer's orders, carts, returns and cases in Commerce's lists
    and Open in Customer Service; the key numbers; its account (verified email, self access), current addresses and payment
    methods (type and last four only), and its orders, carts, cases and returns in those stores, each opening Commerce's
    detail, and (P12) its subscriptions in those stores, billing and access apart, each opening SubscriptionDetail. Order again
    is on a past order's OrderDetail. No password editing or impersonation. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <widgets>
        <section name="CommerceCustomer" condition="appRoot == 'Commerce'">
            <widgets>
                <section name="CommerceCustomerMissing" condition="!commerceCustomer">
                    <widgets>
                        <container-box type="warning">
                            <box-header title="Customer not available"/>
                            <box-body>
                                <label type="p" text="The customer does not exist, or has no order or cart in a store you work."/>
                                <link url="${sharedLinks['Customers/Customers']}" text="Back to customers" link-type="anchor"/>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
                <section name="CommerceCustomerFound" condition="commerceCustomer">
                    <actions>
                        <set field="cc" from="commerceCustomer.customer"/>
                        <set field="customerQuery" from="{customerPartyId:customerPartyId}"/>
                    </actions>
                    <widgets>
                        <context record-entity="mantle.party.Party" record-id="${customerPartyId}" title="${cc.customerName}"/>
                        <container style="m-record-header">
                            <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                                <container style="col-12 col-md m-record-title">
                                    <label text="${cc.customerName}" type="h5"/>
                                    <label text="${[cc.pseudoId, cc.storeText, cc.accountText].filter(Boolean).join(' · ')}" type="p"
                                            style="text-caption m-muted"/>
                                </container>
                                <container style="col-12 col-md-auto row items-center q-gutter-sm m-record-actions">
                                    <link url="${operationLinks.serviceCustomer}${customerPartyId}" url-type="plain" text="Open in Customer Service"
                                            link-type="anchor-button" icon="sym_o_open_in_new" condition="operationLinks.serviceCustomer"/>
                                    <button-menu text="More" icon="more_horiz">
                                        <link url="${sharedLinks['Orders/Orders']}" text="Orders" parameter-map="customerQuery"/>
                                        <link url="${sharedLinks['Orders/Carts']}" text="Carts" parameter-map="customerQuery"/>
                                        <link url="${sharedLinks['Orders/Returns']}" text="Returns" parameter-map="customerQuery"/>
                                        <link url="${sharedLinks['Customers/Requests']}" text="Requests" parameter-map="customerQuery"/>
                                    </button-menu>
                                </container>
                            </container>
                        </container>
                        <dashboard min-width="160">
                            <number-card title="Orders" value="${commerceCustomer.orders.length}" icon="sym_o_receipt_long" size="sm"/>
                            <number-card title="Open carts" value="${commerceCustomer.carts.length}" icon="sym_o_shopping_cart" size="sm"/>
                            <number-card title="Cases" value="${commerceCustomer.requests.filter(row => row.open).length}" icon="sym_o_support_agent" size="sm"/>
                            <number-card title="Returns" value="${commerceCustomer.returns.length}" icon="sym_o_assignment_return" size="sm"/>
                        </dashboard>
                        <container-row>
                            <row-col md="6">
                                <container-box>
                                    <box-header title="Account"/>
                                    <box-body>
                                        <label type="p" text="${cc.accountText}${cc.emailText ? ' · ' + cc.emailText : ''}"/>
                                        <label type="p" style="text-caption m-muted q-mb-none"
                                                text="${cc.selfAccess ? 'Sees its own orders, invoices and cases on the site.' : cc.emailVerified ? 'No self access: the account is staff or disabled.' : 'No self access until its email is verified.'}"/>
                                    </box-body>
                                </container-box>
                                <container-box>
                                    <box-header title="Addresses · ${commerceCustomer.addresses.length}"/>
                                    <box-body-nopad>
                                        <form-list name="CommerceCustomerAddresses" list="commerceCustomer.addresses" skip-form="true" paginate="false">
                                            <field name="purposeText"><default-field title="Use"><display/></default-field></field>
                                            <field name="addressText"><default-field title="Address"><display/></default-field></field>
                                        </form-list>
                                        <label type="p" style="m-muted q-pa-sm q-mb-none" text="No current address." condition="!commerceCustomer.addresses.length"/>
                                    </box-body-nopad>
                                </container-box>
                                <container-box>
                                    <box-header title="Payment methods · ${commerceCustomer.methods.length}"/>
                                    <box-body-nopad>
                                        <form-list name="CommerceCustomerMethods" list="commerceCustomer.methods" skip-form="true" paginate="false">
                                            <field name="label"><default-field title="Method"><display/></default-field></field>
                                        </form-list>
                                        <label type="p" style="m-muted q-pa-sm q-mb-none" text="No kept payment method." condition="!commerceCustomer.methods.length"/>
                                    </box-body-nopad>
                                </container-box>
                            </row-col>
                            <row-col md="6">
                                <container-box>
                                    <box-header title="Orders · ${commerceCustomer.orders.length}"/>
                                    <box-body-nopad>
                                        <form-list name="CommerceCustomerOrders" list="commerceCustomer.orders" skip-form="true" paginate="false">
                                            <field name="orderId">
                                                <default-field title="Order">
                                                    <link url="${sharedLinks['Orders/OrderDetail']}" text="${orderId}" link-type="anchor"
                                                            style="text-mono" parameter-map="{orderId:orderId}"/>
                                                </default-field>
                                            </field>
                                            <field name="placedText"><default-field title="Placed"><display/></default-field></field>
                                            <field name="statusText"><default-field title="Status"><display/></default-field></field>
                                            <field name="totalText" align="right"><default-field title="Total"><display/></default-field></field>
                                        </form-list>
                                        <label type="p" style="m-muted q-pa-sm q-mb-none" text="No submitted order." condition="!commerceCustomer.orders.length"/>
                                    </box-body-nopad>
                                </container-box>
                                <container-box>
                                    <box-header title="Carts · ${commerceCustomer.carts.length}"/>
                                    <box-body-nopad>
                                        <form-list name="CommerceCustomerCarts" list="commerceCustomer.carts" skip-form="true" paginate="false">
                                            <field name="orderId">
                                                <default-field title="Cart">
                                                    <link url="${sharedLinks['Orders/CartDetail']}" text="${orderId}" link-type="anchor"
                                                            style="text-mono" parameter-map="{orderId:orderId}"/>
                                                </default-field>
                                            </field>
                                            <field name="stateText"><default-field title="State"><display/></default-field></field>
                                            <field name="totalText" align="right"><default-field title="Value"><display/></default-field></field>
                                        </form-list>
                                        <label type="p" style="m-muted q-pa-sm q-mb-none" text="No open cart." condition="!commerceCustomer.carts.length"/>
                                    </box-body-nopad>
                                </container-box>
                                <container-box>
                                    <box-header title="Cases · ${commerceCustomer.requests.length}"/>
                                    <box-body-nopad>
                                        <form-list name="CommerceCustomerCases" list="commerceCustomer.requests" skip-form="true" paginate="false">
                                            <field name="requestId">
                                                <default-field title="Case">
                                                    <link url="${sharedLinks['Customers/RequestDetail']}" text="${requestId} · ${requestName}"
                                                            link-type="anchor" parameter-map="{requestId:requestId}"/>
                                                </default-field>
                                            </field>
                                            <field name="statusText"><default-field title="Status"><display/></default-field></field>
                                        </form-list>
                                        <label type="p" style="m-muted q-pa-sm q-mb-none" text="No case about these stores." condition="!commerceCustomer.requests.length"/>
                                    </box-body-nopad>
                                </container-box>
                                <container-box>
                                    <box-header title="Returns · ${commerceCustomer.returns.length}"/>
                                    <box-body-nopad>
                                        <form-list name="CommerceCustomerReturns" list="commerceCustomer.returns" skip-form="true" paginate="false">
                                            <field name="returnId">
                                                <default-field title="Return">
                                                    <link url="${sharedLinks['Orders/ReturnDetail']}" text="${returnId}" link-type="anchor"
                                                            parameter-map="{returnId:returnId}"/>
                                                </default-field>
                                            </field>
                                            <field name="statusText"><default-field title="Status"><display/></default-field></field>
                                        </form-list>
                                        <label type="p" style="m-muted q-pa-sm q-mb-none" text="No return." condition="!commerceCustomer.returns.length"/>
                                    </box-body-nopad>
                                </container-box>
                                <container-box>
                                    <box-header title="Subscriptions · ${(commerceCustomer.subscriptions || []).length}"/>
                                    <box-body-nopad>
                                        <form-list name="CommerceCustomerSubscriptions" list="commerceCustomer.subscriptions" skip-form="true" paginate="false">
                                            <field name="contractId">
                                                <default-field title="Subscription">
                                                    <link url="${sharedLinks['Customers/SubscriptionDetail']}" text="${productName}" link-type="anchor"
                                                            parameter-map="{contractId:contractId}"/>
                                                </default-field>
                                            </field>
                                            <field name="billingText"><default-field title="Billing"><display/></default-field></field>
                                            <field name="accessText"><default-field title="Access"><display/></default-field></field>
                                            <field name="paidThroughText"><default-field title="Paid through"><display/></default-field></field>
                                        </form-list>
                                        <label type="p" style="m-muted q-pa-sm q-mb-none" text="No subscription." condition="!(commerceCustomer.subscriptions || []).length"/>
                                    </box-body-nopad>
                                </container-box>
                            </row-col>
                        </container-row>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
