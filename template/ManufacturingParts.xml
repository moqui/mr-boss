<!-- Parts of the IronStone Manufacturing screens. A screen includes each transition it uses by name (transition-include) and
    each section (section-include), so a form here posts to the screen it is on.
    - choices: the server-search drop-downs (ironstone.manufacturing.AccessServices.get#Choices);
    - selectPlant: the selected plant, a user preference that never widens the scope, with the PlantPicker
      section (manufacturing is the root's get#SharedContext answer). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <transition name="choices" read-only="true">
        <actions>
            <service-call name="ironstone.manufacturing.AccessServices.get#Choices" in-map="context" out-map="found"/>
            <script>ec.web.sendJsonResponse(found.options)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition name="selectPlant">
        <actions>
            <service-call name="ironstone.manufacturing.AccessServices.select#Plant"
                    in-map="{plantId:plantId}"
                    out-map="context"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <widgets>
        <section name="PlantPicker">
            <actions>
                <set field="selectedPlantId" from="manufacturing.plantId"/>
            </actions>
            <widgets>
                <form-single name="Plant" transition="selectPlant" map="{plantId:selectedPlantId}">
                    <field name="plantId">
                        <default-field title="Plant" tooltip="Kept for your next visit; it never adds a plant">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices"
                                        server-search="true"
                                        min-length="0"
                                        parameter-map="{choice:'plants', selected:selectedPlantId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="submit">
                        <default-field title="">
                            <submit text="Choose plant"/>
                        </default-field>
                    </field>
                    <field-layout>
                        <field-row>
                            <field-ref name="plantId"/>
                            <field-ref name="submit"/>
                        </field-row>
                    </field-layout>
                </form-single>
            </widgets>
        </section>
    </widgets>
</screen>
