<!-- Parts of the Warehouse Inventory screens (impl-warehouse P4). A screen includes each transition it uses by name.
    - inventoryChoices: the Inventory drop-downs (ironstone.warehouse.InventoryServices.get#InventoryChoices): products,
      lots, locations of a facility, container types, variance reasons and asset statuses. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <transition name="inventoryChoices" read-only="true">
        <actions>
            <service-call name="ironstone.warehouse.InventoryServices.get#InventoryChoices" in-map="context" out-map="found"/>
            <script>ec.web.sendJsonResponse(found.options)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <widgets/>
</screen>
