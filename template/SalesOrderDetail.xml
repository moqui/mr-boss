<!-- OrderDetail's Sales quote context (crosscut §3.6's Sales row; design-sales §5 OrderDetail — Quote context; impl-sales P7, F34,
    F68): the section Shared/OrderDetail includes when appRoot is Sales, over mantle.order.SalesQuoteServices.get#Quote (a quote the
    user sees: of a seller of their sales scope, theirs or their team's, or the organization's for SALES_TEAM_VIEW; another's and a
    missing one are "not available" alike). The header (the quote, its customer, seller, store or none, opportunity, state) with Add
    line (the primary of a draft) and More (Add shipping charge, Edit quote, the customer, the opportunity); the totals (products,
    shipping, tax by the store's or the seller's gateway, X1); Overview; Items, each line with its price's source, an entered price's
    basis and reason, its tax, and Edit, Explain price (PriceExplain's Sales branch), Availability (InventoryAvailability, read only)
    and Remove; Terms (validity on the part, the customer's reference); History (the audited fields); Chatter and Files (the root
    admits a quote the user sees). No cost or margin. Issue, send, the customer's response, revise and clone are P10's, approvals
    P9's, the sales-order context P11's. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <transition name="salesChoices" read-only="true">
        <actions>
            <service-call name="ironstone.sales.ContextServices.get#Choices" out-map="found"
                    in-map="{appRoot:appRoot, choice:choice, term:(term || null), selected:(selected || null),
                        organizationPartyId:(organizationPartyId || null)}"/>
            <script>ec.web.sendJsonResponse(found.options)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <widgets>
        <section name="SalesOrder" condition="appRoot == 'Sales'">
            <widgets>
                <section name="SalesQuoteMissing" condition="!salesQuote">
                    <widgets>
                        <container-box type="warning">
                            <box-header title="Quote not available"/>
                            <box-body>
                                <label type="p" text="Quote ${orderId} is not available: it does not exist, it is not a quote, or it is not yours, your team's or your organization's to see."/>
                                <link url="${sharedLinks['Quotes/Quotes']}" text="Back to quotes" link-type="anchor"/>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
                <section name="SalesQuoteFound" condition="salesQuote">
                    <actions>
                        <set field="sq" from="salesQuote.quote"/>
                        <set field="customerUrl" from="sq.customerPartyId &amp;&amp; sharedLinks['Accounts/Customer360'] ? sharedLinks['Accounts/Customer360'] : null"/>
                        <set field="opportunityUrl" from="sq.salesOpportunityId &amp;&amp; sharedLinks['Pipeline/OpportunityDetail'] ? sharedLinks['Pipeline/OpportunityDetail'] : null"/>
                        <set field="productUrl" from="sharedLinks['Products/Product360']"/>
                        <set field="explainUrl" from="sharedLinks['Products/PriceExplain']"/>
                        <set field="availabilityUrl" from="sharedLinks['Products/InventoryAvailability']"/>
                        <set field="quoteLines" from="salesQuote.lines"/>
                        <set field="quoteHistory" from="salesQuote.history"/>
                        <set field="lineDefaults" from="{orderId:orderId, orderRevision:sq.orderRevision, quantity:'1'}"/>
                        <set field="shippingDefaults" from="{orderId:orderId, orderRevision:sq.orderRevision, itemTypeEnumId:'ItemShipping',
                                itemDescription:ec.l10n.localize('Shipping')}"/>
                        <set field="quoteValues" from="{orderId:orderId, orderRevision:sq.orderRevision, orderName:sq.orderName,
                                validFromDate:sq.validFromDate, validThruDate:sq.validThruDate, otherPartyOrderId:sq.otherPartyOrderId,
                                postalContactMechId:sq.postalContactMechId}"/>
                        <set field="addressOptions" from="salesQuote.addresses"/>
                        <set field="overviewRows" from="[['Customer', sq.customerName], ['Contact', sq.contactName], ['Seller', sq.organizationName],
                                ['Store', sq.storeless ? ec.l10n.localize('None: taxed through the seller') : sq.storeName], ['Owner', sq.ownerName],
                                ['Team', sq.teamName], ['Opportunity', sq.opportunityName], ['Entered', sq.entryText], ['Ship to', sq.addressText],
                                ['Currency', sq.currencyUomId], ['Revision', String(sq.orderRevision)]]
                                .filter(pair =&gt; pair[1]).map(pair =&gt; ({label: ec.l10n.localize(pair[0]), value: pair[1]}))"/>
                    </actions>
                    <widgets>
                        <context record-entity="mantle.order.OrderHeader" record-id="${orderId}" title="Quote ${orderId} · ${sq.customerName}"/>
                        <container style="m-record-header">
                            <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                                <container style="col-12 col-md m-record-title">
                                    <container style="row items-center q-gutter-x-sm">
                                        <label text="${ec.l10n.localize('Quote')} ${orderId}" type="h5"/>
                                        <label text="${sq.orderName}" type="span" style="text-subtitle1" condition="sq.orderName"/>
                                    </container>
                                    <container style="row items-center q-gutter-x-sm">
                                        <link url="${customerUrl}" url-type="plain" text="${sq.customerName}" link-type="anchor"
                                                parameter-map="{customerPartyId:sq.customerPartyId}" condition="customerUrl"/>
                                        <label text="${sq.customerName}" type="span" condition="!customerUrl"/>
                                        <label text="${[sq.organizationName, sq.storeless ? ec.l10n.localize('no store') : sq.storeName,
                                                sq.validThruText ? ec.l10n.localize('valid through') + ' ' + sq.validThruText : ''].filter(Boolean).join(' · ')}"
                                                type="span" style="text-caption m-muted"/>
                                    </container>
                                </container>
                                <container style="col-12 col-md-auto m-record-status">
                                    <label text="${sq.statusText}${sq.expired ? ' · ' + ec.l10n.localize('Expired') : ''}" type="span"
                                            style="text-weight-medium ${sq.expired ? 'text-negative' : ''}"/>
                                </container>
                            </container>
                            <container style="row items-center q-gutter-xs m-record-actions">
                                <container-dialog id="SalesQuoteAddLine" button-text="Add line" icon="sym_o_add" width="640" type="primary"
                                        title="Add a line to quote ${orderId}" condition="sq.canEdit">
                                    <form-single name="SalesQuoteAddLineForm" transition="salesStoreLine" map="lineDefaults">
                                        <field name="orderId"><default-field><hidden/></default-field></field>
                                        <field name="orderRevision"><default-field><hidden/></default-field></field>
                                        <field name="productId">
                                            <default-field title="Product">
                                                <drop-down allow-empty="false" required-manual-select="true">
                                                    <dynamic-options transition="salesChoices" server-search="true" min-length="0"
                                                            parameter-map="{choice:'products', organizationPartyId:sq.organizationPartyId, selected:productId}"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="quantity"><default-field title="Quantity"><text-line size="8"/></default-field></field>
                                        <field name="unitAmount">
                                            <default-field title="Price" tooltip="Leave empty for the customer's price; an entered price needs its reason">
                                                <text-line size="10"/></default-field>
                                        </field>
                                        <field name="overrideReason"><default-field title="Reason for the entered price"><text-line/></default-field></field>
                                        <field name="freeLine">
                                            <conditional-field title="Free line" condition="sq.canFreeLine">
                                                <check><option key="Y" text="Free of charge (needs its reason)"/></check></conditional-field>
                                            <default-field><ignored/></default-field>
                                        </field>
                                        <field name="requiredByDate"><default-field title="Required by"><date-time type="date"/></default-field></field>
                                        <field name="itemDescription"><default-field title="Description" tooltip="The product's name when empty"><text-line/></default-field></field>
                                        <field name="submitButton"><default-field title="Add line"><submit/></default-field></field>
                                    </form-single>
                                </container-dialog>
                                <button-menu text="More" icon="more_horiz">
                                    <container-dialog id="SalesQuoteAddShipping" button-text="Add shipping charge" icon="sym_o_local_shipping"
                                            width="520" title="Add a shipping charge to quote ${orderId}" condition="sq.canEdit">
                                        <form-single name="SalesQuoteAddShippingForm" transition="salesStoreLine" map="shippingDefaults">
                                            <field name="orderId"><default-field><hidden/></default-field></field>
                                            <field name="orderRevision"><default-field><hidden/></default-field></field>
                                            <field name="itemTypeEnumId"><default-field><hidden/></default-field></field>
                                            <field name="unitAmount"><default-field title="Amount"><text-line size="10"/></default-field></field>
                                            <field name="itemDescription"><default-field title="Description"><text-line/></default-field></field>
                                            <field name="submitButton"><default-field title="Add shipping charge"><submit/></default-field></field>
                                        </form-single>
                                        <label type="p" style="text-caption m-muted"
                                                text="Freight is a charge you enter; it is taxed with the quote where the seller's tax gateway taxes shipping."/>
                                    </container-dialog>
                                    <container-dialog id="SalesQuoteEdit" button-text="Edit quote" icon="sym_o_edit" width="640"
                                            title="Edit quote ${orderId}" condition="sq.canEdit">
                                        <form-single name="SalesQuoteEditForm" transition="salesUpdateQuote" map="quoteValues">
                                            <field name="orderId"><default-field><hidden/></default-field></field>
                                            <field name="orderRevision"><default-field><hidden/></default-field></field>
                                            <field name="orderName"><default-field title="Name"><text-line/></default-field></field>
                                            <field name="validFromDate"><default-field title="Valid from"><date-time type="date"/></default-field></field>
                                            <field name="validThruDate"><default-field title="Valid through"><date-time type="date"/></default-field></field>
                                            <field name="otherPartyOrderId"><default-field title="Customer reference"><text-line/></default-field></field>
                                            <field name="postalContactMechId">
                                                <default-field title="Ship to">
                                                    <drop-down allow-empty="true">
                                                        <list-options list="addressOptions" key="${value}" text="${label}"/>
                                                    </drop-down>
                                                </default-field>
                                            </field>
                                            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                                        </form-single>
                                    </container-dialog>
                                    <link url="${customerUrl}" url-type="plain" text="Customer" parameter-map="{customerPartyId:sq.customerPartyId}"
                                            condition="customerUrl"/>
                                    <link url="${opportunityUrl}" url-type="plain" text="Opportunity"
                                            parameter-map="{salesOpportunityId:sq.salesOpportunityId}" condition="opportunityUrl"/>
                                </button-menu>
                            </container>
                        </container>
                        <dashboard min-width="150" style="q-mb-sm">
                            <number-card title="Total" value="${sq.totalText}" icon="sym_o_request_quote" size="sm"/>
                            <number-card title="Products" value="${sq.productsText}" icon="sym_o_inventory_2" size="sm"/>
                            <number-card title="Shipping" value="${sq.shippingText}" icon="sym_o_local_shipping" size="sm"/>
                            <number-card title="Tax" value="${sq.taxTotalText}" icon="sym_o_percent" size="sm"/>
                        </dashboard>
                        <label text="${sq.taxNote}" type="p" style="text-caption m-muted"/>
                        <container-row>
                            <row-col md="6">
                                <container-box>
                                    <box-header title="Overview"/>
                                    <box-body-nopad>
                                        <form-list name="SalesQuoteOverview" list="overviewRows" skip-form="true" skip-header="true" paginate="false">
                                            <field name="label"><default-field><label text="${label}" type="span" style="m-muted text-no-wrap"/></default-field></field>
                                            <field name="value"><default-field><display/></default-field></field>
                                        </form-list>
                                    </box-body-nopad>
                                </container-box>
                            </row-col>
                            <row-col md="6">
                                <container-box>
                                    <box-header title="Terms"/>
                                    <box-body>
                                        <label type="p" text="Valid from ${sq.validFromText || 'now'}${sq.validThruText ? ' through ' + sq.validThruText : ', with no end set'}."/>
                                        <label type="p" style="text-negative" text="This quote has expired." condition="sq.expired"/>
                                        <label type="p" text="Customer reference: ${sq.otherPartyOrderId}" condition="sq.otherPartyOrderId"/>
                                        <label type="p" style="text-caption m-muted"
                                                text="Availability is evidence at the time you look, not a reservation; nothing is reserved until the order is placed."/>
                                    </box-body>
                                </container-box>
                            </row-col>
                        </container-row>
                        <container-box>
                            <box-header title="Items · ${quoteLines.length}"/>
                            <box-body-nopad>
                                <form-list name="SalesQuoteLines" list="quoteLines" skip-form="true" paginate="false">
                                    <field name="orderItemSeqId"><default-field title="#"><display/></default-field></field>
                                    <field name="description">
                                        <default-field title="Item">
                                            <link url="${productUrl}" text="${description}" link-type="anchor" parameter-map="{productId:productId}"
                                                    condition="productId &amp;&amp; productUrl"/>
                                            <label text="${description}" type="div" condition="!productId || !productUrl"/>
                                            <label text="${productId}" type="div" style="text-caption m-muted" condition="productId"/>
                                            <label text="${priceSourceText}${overridden ? ': ' + overrideReason : ''}${overrideText ? ' · ' + overrideText : ''}"
                                                    type="div" style="text-caption ${overridden ? 'text-warning' : 'm-muted'}"/>
                                        </default-field>
                                    </field>
                                    <field name="quantityText" align="right"><default-field title="Quantity"><display/></default-field></field>
                                    <field name="unitText" align="right">
                                        <default-field title="Price">
                                            <label text="${unitText}" type="span" style="text-no-wrap"/>
                                            <label text="${ec.l10n.localize('Calculated')} ${calculatedText}" type="div" style="text-caption m-muted"
                                                    condition="overridden || (productId &amp;&amp; !priceAvailable)"/>
                                        </default-field>
                                    </field>
                                    <field name="taxText" align="right"><default-field title="Tax"><display/></default-field></field>
                                    <field name="amountText" align="right">
                                        <default-field title="Amount"><label text="${amountText}" type="span" style="text-no-wrap text-weight-medium"/></default-field>
                                    </field>
                                    <field name="actions">
                                        <default-field title="">
                                            <container-dialog id="SalesEditLine_${orderItemSeqId}" button-text="Edit" icon="sym_o_edit"
                                                    width="560" title="Edit line ${orderItemSeqId}" condition="sq.canEdit">
                                                <form-single name="SalesQuoteEditLine" transition="salesStoreLine">
                                                    <field name="orderId" from="orderId"><default-field><hidden/></default-field></field>
                                                    <field name="orderRevision" from="sq.orderRevision"><default-field><hidden/></default-field></field>
                                                    <field name="orderItemSeqId"><default-field><hidden/></default-field></field>
                                                    <field name="quantity" from="quantityText">
                                                        <conditional-field title="Quantity" condition="!shipping"><text-line size="8"/></conditional-field>
                                                        <default-field><ignored/></default-field>
                                                    </field>
                                                    <field name="unitAmount" from="overridden || shipping ? String(unitAmount ?? '') : ''">
                                                        <default-field title="${shipping ? 'Amount' : 'Entered price'}" tooltip="Leave empty to keep the price; an entered price needs its reason"><text-line size="10"/></default-field>
                                                    </field>
                                                    <field name="overrideReason">
                                                        <conditional-field title="Reason for the entered price" condition="!shipping"><text-line/></conditional-field>
                                                        <default-field><ignored/></default-field>
                                                    </field>
                                                    <field name="useCalculatedPrice">
                                                        <conditional-field title="Price" condition="overridden &amp;&amp; priceAvailable">
                                                            <check><option key="Y" text="Back to the calculated price"/></check></conditional-field>
                                                        <default-field><ignored/></default-field>
                                                    </field>
                                                    <field name="itemDescription" from="description"><default-field title="Description"><text-line/></default-field></field>
                                                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                                                </form-single>
                                            </container-dialog>
                                            <link url="${explainUrl}" text="Explain price" icon="sym_o_help" link-type="anchor-button"
                                                    parameter-map="{orderId:orderId, orderItemSeqId:orderItemSeqId}" condition="productId &amp;&amp; explainUrl"/>
                                            <link url="${availabilityUrl}" text="Availability" icon="sym_o_inventory" link-type="anchor-button"
                                                    parameter-map="{productId:productId, organizationPartyId:sq.organizationPartyId}"
                                                    condition="productId &amp;&amp; availabilityUrl"/>
                                            <link url="salesDeleteLine" link-type="hidden-form" text="Remove" icon="sym_o_delete" btn-type="danger"
                                                    condition="sq.canEdit" parameter-map="{orderId:orderId, orderRevision:sq.orderRevision, orderItemSeqId:orderItemSeqId}"
                                                    confirmation="Remove line ${orderItemSeqId} of quote ${orderId}?"/>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column><field-ref name="description"/></column>
                                        <column><field-ref name="amountText"/><field-ref name="actions"/></column>
                                    </columns>
                                </form-list>
                                <label type="p" style="m-muted q-pa-sm q-mb-none" condition="!quoteLines.length"
                                        text="${sq.canEdit ? 'No lines yet · Add the first with Add line' : 'No lines'}"/>
                                <container style="row justify-end q-pa-sm">
                                    <label text="Total ${sq.totalText}" type="span" style="text-subtitle1 text-weight-medium"/>
                                </container>
                            </box-body-nopad>
                        </container-box>
                        <container-box>
                            <box-header title="History · ${quoteHistory.length}"/>
                            <box-body-nopad>
                                <form-list name="SalesQuoteHistory" list="quoteHistory" skip-form="true" paginate="false">
                                    <field name="changedText"><default-field title="When"><display/></default-field></field>
                                    <field name="fieldText">
                                        <default-field title="Change">
                                            <label text="${fieldText}${lineText ? ' · ' + ec.l10n.localize('line') + ' ' + lineText : ''}" type="span"/>
                                        </default-field>
                                    </field>
                                    <field name="newText">
                                        <default-field title="From and to">
                                            <label text="${oldText || '—'} → ${newText || '—'}" type="span"/>
                                            <label text="${reason}" type="div" style="text-caption m-muted" condition="reason"/>
                                        </default-field>
                                    </field>
                                    <field name="userName"><default-field title="By"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="fieldText"/><field-ref name="changedText"/></column>
                                        <column><field-ref name="newText"/></column>
                                    </columns>
                                </form-list>
                                <label type="p" style="m-muted q-pa-sm q-mb-none" text="No changes recorded yet." condition="!quoteHistory.length"/>
                            </box-body-nopad>
                        </container-box>
                        <container-row>
                            <row-col md="6">
                                <container-box>
                                    <box-header title="Conversation"/>
                                    <box-body><chatter id="SalesQuoteChatter" record-entity="mantle.order.OrderHeader" record-id="${orderId}"/></box-body>
                                </container-box>
                            </row-col>
                            <row-col md="6">
                                <container-box>
                                    <box-header title="Files"/>
                                    <box-body><record-files id="SalesQuoteFiles" record-entity="mantle.order.OrderHeader" record-id="${orderId}"/></box-body>
                                </container-box>
                            </row-col>
                        </container-row>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
