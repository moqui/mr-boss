<!-- The finance details of a customer or supplier (design-accounting D26), shared by Customer360's and Supplier360's
    Finance details tabs, each of which sets financeDetail (the lists, capabilities and partyName), financePartyId,
    financeSide (customer or supplier) and financeFound: the bank accounts, masked, for treasury, the identifications and
    the tax registrations, each added or changed through Mantle's CustomerFinanceServices writers with the side, which
    decide the permission.
    - saveIdentification, saveTaxRegistration, saveFinanceBank: the writers' transitions;
    - FinanceDetails: the three boxes. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <transition name="saveIdentification">
        <actions>
            <service-call name="mantle.account.CustomerFinanceServices.store#CustomerIdentification"
                    in-map="context"
                    out-map="financeResult"/>
        </actions>
        <default-response url=".">
            <parameter name="customerPartyId"/>
            <parameter name="supplierPartyId"/>
            <parameter name="organizationPartyId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="saveTaxRegistration">
        <actions>
            <service-call name="mantle.account.CustomerFinanceServices.store#CustomerTaxRegistration"
                    in-map="context"
                    out-map="financeResult"/>
        </actions>
        <default-response url=".">
            <parameter name="customerPartyId"/>
            <parameter name="supplierPartyId"/>
            <parameter name="organizationPartyId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="saveFinanceBank">
        <actions>
            <!-- an account or routing number left empty keeps the stored one -->
            <set field="bankFields"
                    from="Object.assign({organizationPartyId:organizationPartyId,
                        customerPartyId:customerPartyId, side:side, paymentMethodId:paymentMethodId || null,
                        bankName:bankName, description:description, typeEnumId:typeEnumId
                        || null, lastUpdatedStamp:lastUpdatedStamp || null, fromDate:fromDate || null, thruDate:thruDate
                        || null}, accountNumber ? {accountNumber:accountNumber} : {}, routingNumber
                        ? {routingNumber:routingNumber} : {})"/>
            <service-call name="mantle.account.CustomerFinanceServices.store#CustomerBankAccount"
                    in-map="bankFields"
                    out-map="financeResult"/>
        </actions>
        <default-response url=".">
            <parameter name="customerPartyId"/>
            <parameter name="supplierPartyId"/>
            <parameter name="organizationPartyId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <widgets>
        <section name="FinanceDetails" condition="financeFound">
            <widgets>
                <label text="Finance details" type="h6"/>
                <container-box>
                    <box-header title="Payment details"/>
                    <box-body>
                        <container-dialog id="FinanceNewBank"
                                button-text="Add bank account"
                                title="Add a bank account of ${financeDetail.partyName}"
                                width="720"
                                condition="financeDetail.capabilities.bankEdit || financeDetail.capabilities.paymentEdit">
                            <form-single name="FinanceBankAccount" transition="saveFinanceBank">
                                <field name="organizationPartyId" from="organizationPartyId">
                                    <default-field title="">
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="customerPartyId" from="financePartyId">
                                    <default-field title="">
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="supplierPartyId" from="supplierPartyId">
                                    <default-field title="">
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="side" from="financeSide">
                                    <default-field title="">
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="bankName">
                                    <default-field title="Bank">
                                        <text-line/>
                                    </default-field>
                                </field>
                                <field name="description">
                                    <default-field title="Description">
                                        <text-line/>
                                    </default-field>
                                </field>
                                <field name="typeEnumId">
                                    <default-field title="Account type">
                                        <drop-down allow-empty="true">
                                            <dynamic-options transition="choices"
                                                    server-search="true"
                                                    min-length="0"
                                                    parameter-map="{choice:'bankAccountTypes',
                                                        organizationPartyId:organizationPartyId, selected:typeEnumId}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="accountNumber">
                                    <default-field title="Account number">
                                        <password/>
                                    </default-field>
                                </field>
                                <field name="routingNumber">
                                    <default-field title="Routing number">
                                        <password/>
                                    </default-field>
                                </field>
                                <field name="fromDate">
                                    <default-field title="From">
                                        <date-time type="date"/>
                                    </default-field>
                                </field>
                                <field name="thruDate">
                                    <default-field title="Through">
                                        <date-time type="date"/>
                                    </default-field>
                                </field>
                                <field name="submit">
                                    <default-field title="">
                                        <submit text="Save bank account"/>
                                    </default-field>
                                </field>
                            </form-single>
                        </container-dialog>
                        <form-list name="FinanceBankAccounts"
                                list="financeDetail.paymentMethods"
                                skip-form="true"
                                paginate="false">
                            <field name="paymentMethodId">
                                <header-field title="Method"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="description">
                                <header-field title="Description"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="bankName">
                                <header-field title="Bank"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="maskedAccountNumber">
                                <header-field title="Account"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="thruDate">
                                <header-field title="Through"/>
                                <default-field>
                                    <display text="${thruDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="actions">
                                <default-field title="">
                                    <container-dialog id="EditFinanceBank_${paymentMethodId}"
                                            button-text="Edit"
                                            title="Edit a bank account of ${financeDetail.partyName}"
                                            width="720"
                                            condition="financeDetail.capabilities.bankEdit">
                                        <form-single name="FinanceBankForm" transition="saveFinanceBank">
                                            <field name="organizationPartyId" from="organizationPartyId">
                                                <default-field title="">
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="customerPartyId" from="financePartyId">
                                                <default-field title="">
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="supplierPartyId" from="supplierPartyId">
                                                <default-field title="">
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="side" from="financeSide">
                                                <default-field title="">
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="lastUpdatedStamp" from="lastUpdatedStamp">
                                                <default-field title="">
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="paymentMethodId" from="paymentMethodId">
                                                <default-field title="">
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="bankName">
                                                <default-field title="Bank">
                                                    <text-line/>
                                                </default-field>
                                            </field>
                                            <field name="description">
                                                <default-field title="Description">
                                                    <text-line/>
                                                </default-field>
                                            </field>
                                            <field name="accountNumber" from="''">
                                                <default-field title="New account number">
                                                    <password/>
                                                </default-field>
                                            </field>
                                            <field name="routingNumber" from="''">
                                                <default-field title="New routing number">
                                                    <password/>
                                                </default-field>
                                            </field>
                                            <field name="thruDate">
                                                <default-field title="Through">
                                                    <date-time type="date"/>
                                                </default-field>
                                            </field>
                                            <field name="submit">
                                                <default-field title="">
                                                    <submit text="Save bank account"/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="paymentMethodId"/>
                                    <field-ref name="description"/>
                                </column>
                                <column>
                                    <field-ref name="maskedAccountNumber"/>
                                    <field-ref name="bankName"/>
                                    <field-ref name="actions"/>
                                </column>
                            </columns>
                        </form-list>
                        <label text="No permitted payment methods are recorded."
                                type="p"
                                style="m-muted"
                                condition="!financeDetail.paymentMethods.length"/>
                    </box-body>
                </container-box>
                <container-box>
                    <box-header title="Identifications"/>
                    <box-body>
                        <container-dialog id="FinanceIdentification"
                                button-text="Add identification"
                                title="Add an identification of ${financeDetail.partyName}"
                                width="720"
                                condition="financeDetail.capabilities.identificationEdit
                                    || financeDetail.capabilities.partyEdit">
                            <form-single name="FinanceIdentification" transition="saveIdentification">
                                <field name="organizationPartyId" from="organizationPartyId">
                                    <default-field title="">
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="customerPartyId" from="financePartyId">
                                    <default-field title="">
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="supplierPartyId" from="supplierPartyId">
                                    <default-field title="">
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="side" from="financeSide">
                                    <default-field title="">
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="partyIdTypeEnumId">
                                    <default-field title="Identification type">
                                        <drop-down allow-empty="true">
                                            <dynamic-options transition="choices"
                                                    server-search="true"
                                                    min-length="0"
                                                    parameter-map="{choice:'identificationTypes',
                                                        organizationPartyId:organizationPartyId, selected:partyIdTypeEnumId}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="idValue">
                                    <default-field title="Identification">
                                        <text-line/>
                                    </default-field>
                                </field>
                                <field name="issuedBy">
                                    <default-field title="Issued by">
                                        <text-line/>
                                    </default-field>
                                </field>
                                <field name="expireDate">
                                    <default-field title="Expires">
                                        <date-time type="date"/>
                                    </default-field>
                                </field>
                                <field name="submit">
                                    <default-field title="">
                                        <submit text="Save identification"/>
                                    </default-field>
                                </field>
                            </form-single>
                        </container-dialog>
                        <form-list name="FinanceIdentifications"
                                list="financeDetail.identifications"
                                skip-form="true"
                                paginate="false">
                            <field name="partyIdTypeEnumId">
                                <header-field title="Type"/>
                                <default-field>
                                    <display-entity entity-name="moqui.basic.Enumeration"/>
                                </default-field>
                            </field>
                            <field name="idValue">
                                <header-field title="Identification"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="issuedBy">
                                <header-field title="Issued by"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="expireDate">
                                <header-field title="Expires"/>
                                <default-field>
                                    <display text="${expireDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="actions">
                                <default-field title="">
                                    <container-dialog id="EditFinanceIdentification_${partyIdTypeEnumId}"
                                            button-text="Edit"
                                            title="Edit identification"
                                            width="720"
                                            condition="financeDetail.capabilities.identificationEdit">
                                        <form-single name="FinanceIdentificationForm" transition="saveIdentification">
                                            <field name="organizationPartyId" from="organizationPartyId">
                                                <default-field title="">
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="customerPartyId" from="financePartyId">
                                                <default-field title="">
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="supplierPartyId" from="supplierPartyId">
                                                <default-field title="">
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="side" from="financeSide">
                                                <default-field title="">
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="lastUpdatedStamp" from="lastUpdatedStamp">
                                                <default-field title="">
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="partyIdTypeEnumId" from="partyIdTypeEnumId">
                                                <default-field title="">
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="idValue">
                                                <default-field title="Identification">
                                                    <text-line/>
                                                </default-field>
                                            </field>
                                            <field name="issuedBy">
                                                <default-field title="Issued by">
                                                    <text-line/>
                                                </default-field>
                                            </field>
                                            <field name="expireDate">
                                                <default-field title="Expires">
                                                    <date-time type="date"/>
                                                </default-field>
                                            </field>
                                            <field name="submit">
                                                <default-field title="">
                                                    <submit text="Save identification"/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="partyIdTypeEnumId"/>
                                    <field-ref name="issuedBy"/>
                                </column>
                                <column>
                                    <field-ref name="idValue"/>
                                    <field-ref name="expireDate"/>
                                    <field-ref name="actions"/>
                                </column>
                            </columns>
                        </form-list>
                        <label text="No permitted identifications are recorded."
                                type="p"
                                style="m-muted"
                                condition="!financeDetail.identifications.length"/>
                    </box-body>
                </container-box>
                <container-box>
                    <box-header title="Tax registrations"/>
                    <box-body>
                        <container-dialog id="FinanceTaxRegistration"
                                button-text="Add tax registration"
                                title="Add a tax registration of ${financeDetail.partyName}"
                                width="720"
                                condition="financeDetail.capabilities.taxEdit">
                            <form-single name="FinanceTaxRegistration" transition="saveTaxRegistration">
                                <field name="organizationPartyId" from="organizationPartyId">
                                    <default-field title="">
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="customerPartyId" from="financePartyId">
                                    <default-field title="">
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="supplierPartyId" from="supplierPartyId">
                                    <default-field title="">
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="side" from="financeSide">
                                    <default-field title="">
                                        <hidden/>
                                    </default-field>
                                </field>
                                <field name="taxAuthorityId">
                                    <default-field title="Tax authority">
                                        <drop-down allow-empty="true">
                                            <dynamic-options transition="choices"
                                                    server-search="true"
                                                    min-length="0"
                                                    parameter-map="{choice:'taxAuthorities',
                                                        organizationPartyId:organizationPartyId, selected:taxAuthorityId}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="partyTaxId">
                                    <default-field title="Tax ID">
                                        <text-line/>
                                    </default-field>
                                </field>
                                <field name="isExempt">
                                    <default-field title="Exemption">
                                        <check>
                                            <option key="Y" text="Tax exempt"/>
                                        </check>
                                    </default-field>
                                </field>
                                <field name="isNexus">
                                    <default-field title="Nexus">
                                        <check>
                                            <option key="Y" text="Has tax nexus"/>
                                        </check>
                                    </default-field>
                                </field>
                                <field name="fromDate">
                                    <default-field title="From">
                                        <date-time type="date"/>
                                    </default-field>
                                </field>
                                <field name="thruDate">
                                    <default-field title="Through">
                                        <date-time type="date"/>
                                    </default-field>
                                </field>
                                <field name="submit">
                                    <default-field title="">
                                        <submit text="Save tax registration"/>
                                    </default-field>
                                </field>
                            </form-single>
                        </container-dialog>
                        <form-list name="FinanceTaxRegistrations"
                                list="financeDetail.taxRegistrations"
                                skip-form="true"
                                paginate="false">
                            <field name="taxAuthorityId">
                                <header-field title="Authority"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="partyTaxId">
                                <header-field title="Tax ID"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="isExempt">
                                <header-field title="Exempt"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="isNexus">
                                <header-field title="Nexus"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="fromDate">
                                <header-field title="From"/>
                                <default-field>
                                    <display text="${fromDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="thruDate">
                                <header-field title="Through"/>
                                <default-field>
                                    <display text="${thruDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="actions">
                                <default-field title="">
                                    <container-dialog id="EditFinanceTax_${taxAuthorityId}_${fromDate}"
                                            button-text="Edit"
                                            title="Edit tax registration"
                                            width="720"
                                            condition="financeDetail.capabilities.taxEdit">
                                        <form-single name="FinanceTaxForm" transition="saveTaxRegistration">
                                            <field name="organizationPartyId" from="organizationPartyId">
                                                <default-field title="">
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="customerPartyId" from="financePartyId">
                                                <default-field title="">
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="supplierPartyId" from="supplierPartyId">
                                                <default-field title="">
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="side" from="financeSide">
                                                <default-field title="">
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="lastUpdatedStamp" from="lastUpdatedStamp">
                                                <default-field title="">
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="taxAuthorityId" from="taxAuthorityId">
                                                <default-field title="">
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="fromDate" from="fromDate">
                                                <default-field title="">
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="partyTaxId">
                                                <default-field title="Tax ID">
                                                    <text-line/>
                                                </default-field>
                                            </field>
                                            <field name="isExempt">
                                                <default-field title="Exemption">
                                                    <check>
                                                        <option key="Y" text="Tax exempt"/>
                                                    </check>
                                                </default-field>
                                            </field>
                                            <field name="isNexus">
                                                <default-field title="Nexus">
                                                    <check>
                                                        <option key="Y" text="Has tax nexus"/>
                                                    </check>
                                                </default-field>
                                            </field>
                                            <field name="thruDate">
                                                <default-field title="Through">
                                                    <date-time type="date"/>
                                                </default-field>
                                            </field>
                                            <field name="submit">
                                                <default-field title="">
                                                    <submit text="Save tax registration"/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="taxAuthorityId"/>
                                    <field-ref name="partyTaxId"/>
                                </column>
                                <column>
                                    <field-ref name="isExempt"/>
                                    <field-ref name="thruDate"/>
                                    <field-ref name="actions"/>
                                </column>
                            </columns>
                        </form-list>
                        <label text="No permitted tax registrations are recorded."
                                type="p"
                                style="m-muted"
                                condition="!financeDetail.taxRegistrations.length"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
