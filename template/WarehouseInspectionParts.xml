<!-- Parts of the Warehouse inspection screens (impl-warehouse P8). A screen includes each transition it uses by name. Every
    write transition checks the inspection (or template's) record through ironstone.warehouse.AccessServices.check#Record,
    with its capability where one capability is needed, then calls Mantle's mantle.product.QualityServices, which checks the
    permission and organization again:
    - inspectionChoices: the inspection drop-downs (ironstone.warehouse.InspectionServices.get#InspectionChoices);
    - assignInspection: an inspector and due date (work only, never the status);
    - moveInspection: a board card moved to another inspector assigns it; moved to another status it goes back with the
      reason (statuses change only through the inspection);
    - reassignInspections: the selected inspections to one inspector, each on its own with its result named;
    - saveReading, submitInspection (inspect), verifyInspection (qualityVerify), disposeInspection (qualityDispose, the
      page's operation key);
    - reinspectInspection (inspect): a disposed inspection's still-held stock inspected again; cancelInspection: a draft
      or submitted inspection, with the reason;
    - storeTemplate: a template's header, a characteristic, publish or retire (qualityTemplateEdit). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <transition name="inspectionChoices" read-only="true">
        <actions>
            <service-call name="ironstone.warehouse.InspectionServices.get#InspectionChoices" in-map="context" out-map="found"/>
            <script>ec.web.sendJsonResponse(found.options)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition name="assignInspection">
        <actions>
            <service-call name="ironstone.warehouse.AccessServices.check#Record"
                    in-map="{recordType:'inspection', recordId:qualityInspectionId}"/>
            <service-call name="mantle.product.QualityServices.assign#Inspection"
                    in-map="{qualityInspectionId:qualityInspectionId, inspectorPartyId:inspectorPartyId || '',
                        dueDate:dueDate || null, inspectionTemplateId:inspectionTemplateId || null}"/>
            <message type="success">Inspection ${qualityInspectionId} assigned</message>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="moveInspection">
        <actions>
            <if condition="groupField != 'inspectorPartyId' &amp;&amp; groupField">
                <set field="moveRefused" value="A card moves between inspectors: the status changes only by submitting,
                        verifying or disposing the inspection"/>
                <return error="true" message="${moveRefused}"/>
            </if>
            <service-call name="ironstone.warehouse.AccessServices.check#Record"
                    in-map="{recordType:'inspection', recordId:qualityInspectionId}"/>
            <service-call name="mantle.product.QualityServices.assign#Inspection"
                    in-map="{qualityInspectionId:qualityInspectionId, inspectorPartyId:inspectorPartyId || ''}"/>
            <message type="success">Inspection ${qualityInspectionId} assigned</message>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="reassignInspections">
        <actions>
            <iterate list="Array.from(qualityInspectionIdList || []).map(String)" entry="rowInspectionId">
                <service-call name="ironstone.warehouse.AccessServices.check#Record" out-map="checked"
                        out-map-add-to-existing="false" transaction="force-new" ignore-error="true"
                        in-map="{recordType:'inspection', recordId:rowInspectionId}"/>
                <set field="assigned" from="null"/>
                <if condition="checked?.recordId">
                    <service-call name="mantle.product.QualityServices.assign#Inspection" out-map="assigned"
                            out-map-add-to-existing="false" transaction="force-new" ignore-error="true"
                            in-map="{qualityInspectionId:rowInspectionId, inspectorPartyId:inspectorPartyId || ''}"/>
                </if>
                <if condition="assigned?.qualityInspectionId">
                    <then><message type="success">Inspection ${rowInspectionId} assigned</message></then>
                    <else><message type="warning">Inspection ${rowInspectionId}: not assigned</message></else>
                </if>
            </iterate>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="saveReading">
        <actions>
            <service-call name="ironstone.warehouse.AccessServices.check#Record"
                    in-map="{recordType:'inspection', recordId:qualityInspectionId, capability:'inspect'}"/>
            <service-call name="mantle.product.QualityServices.save#InspectionReading" out-map="saved"
                    in-map="{qualityInspectionId:qualityInspectionId, inspectionTemplateItemId:inspectionTemplateItemId,
                        sampleNumber:sampleNumber || null, numericValue:numericValue || null,
                        passIndicator:passIndicator || null, textValue:textValue || null, comments:comments || null}"/>
            <message type="success">Reading saved${saved.passIndicator == 'N' ? ': out of limits' : ''}</message>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="submitInspection">
        <actions>
            <service-call name="ironstone.warehouse.AccessServices.check#Record"
                    in-map="{recordType:'inspection', recordId:qualityInspectionId, capability:'inspect'}"/>
            <service-call name="mantle.product.QualityServices.submit#Inspection"
                    in-map="{qualityInspectionId:qualityInspectionId, quantityAccepted:quantityAccepted,
                        quantityRejected:quantityRejected, resultReason:resultReason || null}"/>
            <message type="success">Inspection ${qualityInspectionId} submitted for verification</message>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="verifyInspection">
        <actions>
            <service-call name="ironstone.warehouse.AccessServices.check#Record"
                    in-map="{recordType:'inspection', recordId:qualityInspectionId, capability:'qualityVerify'}"/>
            <service-call name="mantle.product.QualityServices.verify#Inspection" out-map="verified"
                    in-map="{qualityInspectionId:qualityInspectionId, approve:approve || 'true',
                        verificationComments:verificationComments || null}"/>
            <message type="success">Inspection ${qualityInspectionId} ${verified.statusId == 'QiVerified' ? 'verified'
                : 'returned to its inspector'}</message>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="disposeInspection">
        <actions>
            <service-call name="ironstone.warehouse.AccessServices.check#Record"
                    in-map="{recordType:'inspection', recordId:qualityInspectionId, capability:'qualityDispose'}"/>
            <service-call name="mantle.product.QualityServices.dispose#Inspection" out-map="disposed"
                    in-map="{operationKey:operationKey, qualityInspectionId:qualityInspectionId,
                        dispositionEnumId:dispositionEnumId, quantity:quantity, toLocationSeqId:toLocationSeqId || null,
                        varianceReasonEnumId:varianceReasonEnumId || null, reason:reason || null}"/>
            <message type="success">${disposed.result.quantity} of inspection ${qualityInspectionId} disposed:
                ${disposed.result.statusId == 'AstAvailable' ? 'released' : disposed.result.statusId == 'AstMorgue'
                    ? 'scrapped' : 'kept in quarantine'}${disposed.result.reservedOrderId ? ', reserved to order '
                    + disposed.result.reservedOrderId : ''}</message>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <!-- a disposed inspection's still-held stock inspected again (a new inspection of the same receipt and asset) -->
    <transition name="reinspectInspection">
        <actions>
            <service-call name="ironstone.warehouse.AccessServices.check#Record"
                    in-map="{recordType:'inspection', recordId:qualityInspectionId, capability:'inspect'}"/>
            <service-call name="mantle.product.QualityServices.create#Inspection" out-map="reinspection"
                    in-map="{reinspectQualityInspectionId:qualityInspectionId}"/>
            <message type="success">Inspection ${reinspection.qualityInspectionId} opened for the held stock</message>
            <set field="qualityInspectionId" from="reinspection.qualityInspectionId"/>
        </actions>
        <default-response url=".">
            <parameter name="qualityInspectionId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="cancelInspection">
        <actions>
            <service-call name="ironstone.warehouse.AccessServices.check#Record"
                    in-map="{recordType:'inspection', recordId:qualityInspectionId}"/>
            <service-call name="mantle.product.QualityServices.cancel#Inspection"
                    in-map="{qualityInspectionId:qualityInspectionId, reason:reason || null}"/>
            <message type="success">Inspection ${qualityInspectionId} cancelled</message>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="storeTemplate">
        <actions>
            <set field="itemChange" from="characteristicName || inspectionTemplateItemId ? [{inspectionTemplateItemId:
                    inspectionTemplateItemId || null, characteristicName:characteristicName || null,
                    readingTypeEnumId:readingTypeEnumId || null, lowerLimit:lowerLimit ?? '',
                    upperLimit:upperLimit ?? '', targetValue:targetValue ?? '', mandatory:mandatory || 'Y',
                    sequenceNum:sequenceNum || null, remove:removeItem == 'Y'}] : []"/>
            <service-call name="mantle.product.QualityServices.store#InspectionTemplate" out-map="stored"
                    in-map="{inspectionTemplateId:inspectionTemplateId || null, templateName:templateName || null,
                        description:description || null, inspectionContextEnumId:inspectionContextEnumId || null,
                        productId:productId || null, productCategoryId:productCategoryId || null,
                        facilityId:templateFacilityId || null, samplePolicyEnumId:samplePolicyEnumId || null,
                        sampleSize:sampleSize || null, samplePercent:samplePercent || null, itemList:itemChange,
                        action:templateAction || null, changeReason:changeReason || null}"/>
            <set field="inspectionTemplateId" from="stored.inspectionTemplateId"/>
            <message type="success">Template ${inspectionTemplateId} saved${templateAction == 'publish' ? ' and published'
                : templateAction == 'retire' ? ' and retired' : ''}</message>
        </actions>
        <default-response url=".">
            <parameter name="inspectionTemplateId"/>
        </default-response>
        <error-response url="."/>
    </transition>
</screen>
