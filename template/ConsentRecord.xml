<!-- One contact's consent (design-drawers-commons.md §16 EditConsent and ConsentHistory, §6 ContactDetail's Consent tab): the
    ConsentRecordSection and its transitions, shown by Comms/Consent/Contact (with the history and the export of a data request)
    and by the Consent tab of the contact record (template/ContactRecord.xml, without them). Each including screen includes
    every transition below by name (transition-include) and the section (section-include), so a form here posts to the screen
    it is on and its answer (url=".") shows that screen again. The including screen sets consentPartyId (the party) and
    consentFull (true for the history).

    The parts: the addresses and numbers with whether each allows contact and the current state of each purpose, with Change
    (granted or withdrawn with its source and evidence; allowSolicitation follows a marketing purpose); the lists with the
    status, Subscribe and Unsubscribe with a note of where the request came from, and Add to a list; the consent of the
    contact as a whole (data processing); Record consent; and the history. Everyone who may see the contact reads the state;
    the changes, the history and the export are for contact admins (ironstone.comms.ConsentServices). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-include="false">

    <transition name="consentRecord">
        <actions>
            <service-call name="ironstone.comms.ConsentServices.record#Consent" in-map="context"/>
            <if condition="!ec.message.hasError()"><message type="success">Consent recorded</message></if>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="consentListSet">
        <actions>
            <service-call name="ironstone.comms.ConsentServices.set#ListSubscription" out-map="setOut"
                    in-map="{partyId:partyId, contactListId:contactListId, subscribe:(subscribe == 'Y'), contactMechId:(contactMechId || null), evidenceText:evidenceText}"/>
            <if condition="!ec.message.hasError()"><message type="success">${subscribe == 'Y' ? 'Subscribed' : 'Unsubscribed'}${setOut.changed ? '' : ' (no change)'}</message></if>
        </actions>
        <default-response url="."/>
    </transition>
    <!-- the contact's whole history as CSV, for a data request -->
    <transition name="consentHistoryExport">
        <actions><script><![CDATA[
            const out = ec.service.sync().name('ironstone.comms.ConsentServices.export#ConsentHistory').parameters({partyId: partyId}).call()
            if (!ec.message.hasError() && out?.csvText) ec.web.sendTextResponse(out.csvText, 'text/csv', out.fileName)
            else ec.web.sendJsonResponse({})
        ]]></script></actions>
        <default-response type="none"/>
    </transition>

    <widgets>
        <section name="ConsentRecordSection">
            <actions>
                <script><![CDATA[
                    // a contact the user may not see is "not available", with no error left for the page
                    ec.message.pushErrors()
                    let found = null
                    try {
                        found = ec.service.sync().name('ironstone.comms.ConsentServices.get#ContactConsent').parameters({partyId: consentPartyId,
                            includeHistory: !!consentFull, historyPageIndex: Number(pageIndex || 0) || 0}).call()
                        if (ec.message.hasError()) found = null
                    } finally {
                        ec.message.clearErrors()
                        ec.message.popErrors()
                    }
                    cons = found || {found: false}
                    consFound = !!cons.found
                    consCanEdit = consFound && !!cons.canEdit
                    // The browser chips carry escaped labels and hidden tooltips; other modes need the labels alone.
                    const plainConsent = (html) => String(html || '').replace(/<q-tooltip\b[^>]*>[\s\S]*?<\/q-tooltip>/gi, '')
                            .replace(/<\/q-chip>/gi, ' · ').replace(/<[^>]*>/g, '').replace(/ · $/, '').trim()
                            .replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&')
                    consAddressList = Array.from(cons.addressList || []).map(address => Object.assign({}, address, {consentText: plainConsent(address.consentHtml)}))
                    consListList = Array.from(cons.listList || [])
                    consPartyList = Array.from(cons.partyConsentList || [])
                    consHistoryList = Array.from(cons.historyList || [])
                    consHistoryListCount = cons.historyListCount || 0
                    consHistoryListPageIndex = cons.historyListPageIndex || 0
                    consHistoryListPageSize = cons.historyListPageSize || 20
                    consHistoryListPageMaxIndex = cons.historyListPageMaxIndex || 0
                    consHistoryListPageRangeLow = cons.historyListPageRangeLow || 0
                    consHistoryListPageRangeHigh = cons.historyListPageRangeHigh || 0
                    consAddListOptions = Array.from(cons.addListOptions || [])
                    consAddressOptions = Array.from(cons.addressOptions || [])
                    consEmailOptions = consAddressList.filter((address) => address.isCurrent && address.kind === 'email')
                            .map((address) => ({key: address.contactMechId, text: address.addressText}))
                    consPurposeOptions = Array.from(cons.purposeOptions || [])
                    consSourceOptions = Array.from(cons.sourceOptions || [])
                    consStatusOptions = [{key: 'PconGranted', text: ec.l10n.localize('Granted')}, {key: 'PconWithdrawn', text: ec.l10n.localize('Withdrawn')}]
                ]]></script>
            </actions>
            <widgets>
                <section name="ConsentNotFound" condition="!consFound"><widgets>
                    <container-box type="warning"><box-header title="Not available"/><box-body>
                        <label type="p" text="Contact ${consentPartyId || ''} is not available: it does not exist, or it is someone else's personal contact."/>
                    </box-body></container-box>
                </widgets></section>
                <section name="ConsentFound" condition="consFound"><widgets>
                    <section name="ConsentGranted" condition="cons.grantedText"><widgets>
                        <label type="p" text="Granted now: ${cons.grantedText}" style="text-body2 q-mb-sm"/>
                    </widgets></section>

                    <!-- ===== addresses and numbers ===== -->
                    <container-box><box-header title="Addresses and numbers"/>
                        <box-toolbar>
                            <container-dialog id="ConsentRecordDialog" button-text="Record consent" icon="sym_o_verified" width="600" title="Record consent for ${cons.partyName}"
                                    condition="consCanEdit">
                                <label type="p" text="A grant or withdrawal with what shows it: the form and its wording, the email or call it came in, the file it was imported from." style="m-muted"/>
                                <form-single name="ConsentRecordForm" transition="consentRecord" focus-field="purposeEnumId">
                                    <field name="partyId" from="consentPartyId"><default-field><hidden/></default-field></field>
                                    <field name="purposeEnumId"><default-field title="Purpose">
                                        <drop-down no-current-selected-key="PcpMarketingEmail"><list-options list="consPurposeOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                                    <field name="statusId"><default-field title="Consent">
                                        <radio no-current-selected-key="PconGranted"><list-options list="consStatusOptions" key="${key}" text="${text}"/></radio></default-field></field>
                                    <field name="contactMechId"><default-field title="Address or number (empty: the primary one, or the contact as a whole)">
                                        <drop-down allow-empty="true"><list-options list="consAddressOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                                    <field name="sourceEnumId"><default-field title="Source">
                                        <drop-down no-current-selected-key="PcsStaff"><list-options list="consSourceOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                                    <field name="consentDate"><default-field title="When (empty: now)"><date-time type="date-time"/></default-field></field>
                                    <field name="evidenceText"><default-field title="Evidence"><text-area rows="3" cols="60"/></default-field></field>
                                    <field name="comments"><default-field title="Note"><text-line size="60"/></default-field></field>
                                    <field name="submitButton"><default-field title="Record"><submit/></default-field></field>
                                    <field-layout>
                                        <field-row><field-ref name="purposeEnumId"/><field-ref name="statusId"/></field-row>
                                        <field-ref name="contactMechId"/>
                                        <field-row><field-ref name="sourceEnumId"/><field-ref name="consentDate"/></field-row>
                                        <field-ref name="evidenceText"/><field-ref name="comments"/><field-ref name="submitButton"/>
                                    </field-layout>
                                </form-single>
                            </container-dialog>
                        </box-toolbar>
                        <box-body-nopad>
                            <form-list name="ConsentAddresses" list="consAddressList" skip-form="true" paginate="false">
                                <field name="addressText"><default-field title="Address or number"><display style="${isCurrent ? '' : 'text-strike m-muted'}"/></default-field></field>
                                <field name="kindText"><default-field title="Kind"><display style="text-caption m-muted"/></default-field></field>
                                <field name="allowText"><default-field title="Contact">
                                    <render-mode><text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal ${allowColor}" data-allow="${allowSolicitation ?? ''}">${WebUtilities.encodeHtml(allowText ?? '')}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: String(allowText ?? '')})}]]></text>
                                        <text type="html,html-print"><![CDATA[${WebUtilities.encodeHtml(allowText ?? '')}]]></text></render-mode>
                                </default-field></field>
                                <field name="consentHtml"><default-field title="Consent">
                                    <render-mode><text type="qvt"><![CDATA[${consentHtml}]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: String(consentText ?? '')})}]]></text>
                                        <text type="html,html-print"><![CDATA[${WebUtilities.encodeHtml(consentText ?? '')}]]></text></render-mode>
                                </default-field></field>
                                <field name="rowActions" align="right"><conditional-field condition="consCanEdit &amp;&amp; isCurrent &amp;&amp; purposeEnumId" title="">
                                    <container-dialog id="ConsentAddressDialog" button-text="Change" icon="sym_o_edit" width="560" title="Consent for ${addressText}">
                                        <form-single name="ConsentAddressForm" transition="consentRecord">
                                            <field name="partyId" from="consentPartyId"><default-field><hidden/></default-field></field>
                                            <field name="contactMechId"><default-field><hidden/></default-field></field>
                                            <field name="purposeEnumId"><default-field title="Purpose">
                                                <drop-down><list-options list="purposeChoices" key="${key}" text="${text}"/></drop-down></default-field></field>
                                            <field name="statusId" from="allowSolicitation == 'Y' ? 'PconWithdrawn' : 'PconGranted'"><default-field title="Consent">
                                                <radio><list-options list="consStatusOptions" key="${key}" text="${text}"/></radio></default-field></field>
                                            <field name="sourceEnumId"><default-field title="Source">
                                                <drop-down no-current-selected-key="PcsStaff"><list-options list="consSourceOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                                            <field name="evidenceText"><default-field title="Reason or evidence"><text-area rows="2" cols="50"/></default-field></field>
                                            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                                        </form-single>
                                    </container-dialog>
                                </conditional-field><default-field title=""><display text=""/></default-field></field>
                                <columns type="mobile">
                                    <column><field-ref name="addressText"/><field-ref name="kindText"/></column>
                                    <column><field-ref name="allowText"/><field-ref name="consentHtml"/></column>
                                    <column><field-ref name="rowActions"/></column>
                                </columns>
                            </form-list>
                            <section name="NoConsentAddresses" condition="!consAddressList.length"><widgets>
                                <label type="p" text="No email address or phone number" style="m-muted q-pa-sm q-mb-none"/>
                            </widgets></section>
                        </box-body-nopad>
                    </container-box>

                    <!-- ===== lists ===== -->
                    <container-box><box-header title="Lists"/>
                        <box-toolbar>
                            <container-dialog id="ConsentListAddDialog" button-text="Add to a list" icon="sym_o_playlist_add" width="560" title="Add ${cons.partyName} to a list"
                                    condition="consCanEdit &amp;&amp; consAddListOptions.length">
                                <form-single name="ConsentListAdd" transition="consentListSet">
                                    <field name="partyId" from="consentPartyId"><default-field><hidden/></default-field></field>
                                    <field name="subscribe" from="'Y'"><default-field><hidden/></default-field></field>
                                    <field name="contactListId"><default-field title="List">
                                        <drop-down><list-options list="consAddListOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                                    <field name="contactMechId"><default-field title="Send to">
                                        <drop-down allow-empty="true"><list-options list="consEmailOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                                    <field name="evidenceText"><default-field title="Where the request came from"><text-line size="50"/></default-field></field>
                                    <field name="submitButton"><default-field title="Subscribe"><submit/></default-field></field>
                                </form-single>
                            </container-dialog>
                        </box-toolbar>
                        <box-body-nopad>
                            <form-list name="ConsentLists" list="consListList" skip-form="true" paginate="false">
                                <field name="contactListName"><default-field title="List"><display style="${isArchived ? 'm-muted' : ''}"/></default-field></field>
                                <field name="typeText"><default-field title="Type"><display style="text-caption m-muted"/></default-field></field>
                                <field name="statusText"><default-field title="Status">
                                    <render-mode><text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal ${statusColor}" data-status="${statusId ?? ''}">${WebUtilities.encodeHtml(statusText ?? '')}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: String(statusText ?? '')})}]]></text>
                                        <text type="html,html-print"><![CDATA[${WebUtilities.encodeHtml(statusText ?? '')}]]></text></render-mode>
                                </default-field></field>
                                <field name="lastChangeText"><default-field title="Last change"><display style="text-caption"/></default-field></field>
                                <field name="rowActions" align="right"><conditional-field condition="canSubscribe || canUnsubscribe" title="">
                                    <container style="row no-wrap justify-end items-center q-gutter-x-xs">
                                        <container-dialog id="ConsentUnsubscribeDialog" button-text="Unsubscribe" icon="sym_o_unsubscribe" width="520" title="Unsubscribe from ${contactListName}"
                                                condition="canUnsubscribe">
                                            <form-single name="ConsentUnsubscribeForm" transition="consentListSet">
                                                <field name="partyId" from="consentPartyId"><default-field><hidden/></default-field></field>
                                                <field name="contactListId"><default-field><hidden/></default-field></field>
                                                <field name="subscribe" from="'N'"><default-field><hidden/></default-field></field>
                                                <field name="evidenceText"><default-field title="Where the request came from"><text-line size="50"/></default-field></field>
                                                <field name="submitButton"><default-field title="Unsubscribe"><submit type="danger"/></default-field></field>
                                            </form-single>
                                        </container-dialog>
                                        <container-dialog id="ConsentSubscribeDialog" button-text="Subscribe" icon="sym_o_mark_email_unread" width="520" title="Subscribe to ${contactListName}"
                                                condition="canSubscribe">
                                            <form-single name="ConsentSubscribeForm" transition="consentListSet">
                                                <field name="partyId" from="consentPartyId"><default-field><hidden/></default-field></field>
                                                <field name="contactListId"><default-field><hidden/></default-field></field>
                                                <field name="subscribe" from="'Y'"><default-field><hidden/></default-field></field>
                                                <field name="evidenceText"><default-field title="Where the request came from"><text-line size="50"/></default-field></field>
                                                <field name="submitButton"><default-field title="Subscribe"><submit/></default-field></field>
                                            </form-single>
                                        </container-dialog>
                                    </container>
                                </conditional-field><default-field title=""><display text=""/></default-field></field>
                                <columns type="mobile">
                                    <column><field-ref name="contactListName"/><field-ref name="typeText"/></column>
                                    <column><field-ref name="statusText"/><field-ref name="lastChangeText"/></column>
                                    <column><field-ref name="rowActions"/></column>
                                </columns>
                            </form-list>
                            <section name="NoConsentLists" condition="!consListList.length"><widgets>
                                <label type="p" text="Not on any list" style="m-muted q-pa-sm q-mb-none"/>
                            </widgets></section>
                        </box-body-nopad>
                    </container-box>

                    <!-- ===== the contact as a whole ===== -->
                    <section name="ConsentParty" condition="consPartyList.length"><widgets>
                        <container-box><box-header title="The contact as a whole"/><box-body-nopad>
                            <form-list name="ConsentPartyList" list="consPartyList" skip-form="true" paginate="false">
                                <field name="purposeText"><default-field title="Purpose"><display/></default-field></field>
                                <field name="statusText"><default-field title="Consent">
                                    <render-mode><text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal ${statusColor}">${WebUtilities.encodeHtml(statusText ?? '')}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: String(statusText ?? '')})}]]></text>
                                        <text type="html,html-print"><![CDATA[${WebUtilities.encodeHtml(statusText ?? '')}]]></text></render-mode>
                                </default-field></field>
                                <field name="whenText"><default-field title="When"><display style="text-caption"/></default-field></field>
                                <field name="sourceText"><default-field title="Source"><display style="text-caption"/></default-field></field>
                                <field name="evidenceText"><default-field title="Evidence"><display style="text-caption"/></default-field></field>
                            </form-list>
                        </box-body-nopad></container-box>
                    </widgets></section>

                    <!-- ===== the history, with the export of a data request ===== -->
                    <section name="ConsentHistory" condition="consentFull &amp;&amp; consCanEdit"><widgets>
                        <container-box><box-header title="History · ${consHistoryListCount}"/>
                            <box-toolbar>
                                <link url="consentHistoryExport" link-type="hidden-form-link" text="Export for a data request" icon="sym_o_download"
                                        parameter-map="{partyId:consentPartyId}" tooltip="The whole consent history of the contact as CSV"/>
                            </box-toolbar>
                            <box-body-nopad>
                                <form-list name="ConsentHistoryList" list="consHistoryList" skip-form="true" paginate="true" show-page-size="false">
                                    <field name="whenText"><default-field title="When"><display style="text-no-wrap"/></default-field></field>
                                    <field name="whatText"><default-field title="What"><display/></default-field></field>
                                    <field name="statusDescription"><default-field title="Consent">
                                        <render-mode><text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal ${statusColor}">${WebUtilities.encodeHtml(statusDescription ?? '')}</q-chip>]]></text>
                                            <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: String(statusDescription ?? '')})}]]></text>
                                            <text type="html,html-print"><![CDATA[${WebUtilities.encodeHtml(statusDescription ?? '')}]]></text></render-mode>
                                    </default-field></field>
                                    <field name="addressText"><default-field title="Address"><display style="text-caption"/></default-field></field>
                                    <field name="sourceDescription"><default-field title="Source"><display style="text-caption"/></default-field></field>
                                    <field name="evidenceText"><default-field title="Evidence"><display text="${evidenceText || ''}${comments ? ' · ' + comments : ''}" style="text-caption"/></default-field></field>
                                    <field name="byText"><default-field title="By"><display style="text-caption"/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="whenText"/><field-ref name="whatText"/></column>
                                        <column><field-ref name="statusDescription"/><field-ref name="sourceDescription"/></column>
                                        <column><field-ref name="evidenceText"/></column>
                                    </columns>
                                </form-list>
                                <section name="NoConsentHistory" condition="!consHistoryList.length"><widgets>
                                    <label type="p" text="No consent recorded yet" style="m-muted q-pa-sm q-mb-none"/>
                                </widgets></section>
                            </box-body-nopad>
                        </container-box>
                    </widgets></section>
                </widgets></section>
            </widgets>
        </section>
    </widgets>
</screen>
