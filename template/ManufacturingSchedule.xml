<!-- The schedule's Move form for the XML screens (impl-manufacturing P12; design-manufacturing ProductionSchedule's Terminal and
    Move, Operations' Reschedule): ProductionScheduleTui and WorkOrderDetail's Operations include each transition by name and the
    MovePreview section. A move is previewed first: previewMove answers the screen with the move's parameters (moveOperationId,
    moveFacilityId, moveStart, moveEnd, moveReason, which the including screen declares), and MovePreview shows where it would go
    with its refusals and conflicts (mantle.work.ProductionPlanningServices.schedule#ProductionOperation preview). Its forms then
    apply it (applyMove: with an override for a supervisor), ask a supervisor for an override (requestOverride) or take the
    operation off the schedule (unscheduleOperation); a supervisor decides a request (decideOverride). Each checks the record
    through ironstone.manufacturing.AccessServices.check#Record first, with the schedule capability (supervise to decide), and
    Mantle checks again. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <transition name="previewMove">
        <actions>
            <service-call name="ironstone.manufacturing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'operation', recordId:moveOperationId}"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="applyMove">
        <actions>
            <service-call name="ironstone.manufacturing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'operation', recordId:moveOperationId, capability:'schedule'}"/>
            <service-call name="mantle.work.ProductionPlanningServices.schedule#ProductionOperation" out-map="moved"
                    in-map="{action:'apply', workEffortId:moveOperationId, facilityId:moveFacilityId, startDate:moveStart,
                        endDate:moveEnd, reason:moveReason, override:moveOverride == 'Y', expectedRevision:expectedRevision,
                        expectedRunRevision:expectedRunRevision, operationKey:operationKey}"/>
            <message type="success">${moved.result?.message}</message>
            <set field="moveOperationId" from="null"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="requestOverride">
        <actions>
            <service-call name="ironstone.manufacturing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'operation', recordId:moveOperationId, capability:'schedule'}"/>
            <service-call name="mantle.work.ProductionPlanningServices.schedule#ProductionOperation" out-map="requested"
                    in-map="{action:'request', workEffortId:moveOperationId, facilityId:moveFacilityId, startDate:moveStart,
                        endDate:moveEnd, reason:moveReason, expectedRevision:expectedRevision,
                        expectedRunRevision:expectedRunRevision, operationKey:operationKey}"/>
            <message type="info">${requested.result?.message}</message>
            <set field="moveOperationId" from="null"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="unscheduleOperation">
        <actions>
            <service-call name="ironstone.manufacturing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'operation', recordId:moveOperationId, capability:'schedule'}"/>
            <service-call name="mantle.work.ProductionPlanningServices.schedule#ProductionOperation" out-map="unscheduled"
                    in-map="{action:'unschedule', workEffortId:moveOperationId, reason:moveReason, expectedRevision:expectedRevision,
                        expectedRunRevision:expectedRunRevision, operationKey:operationKey}"/>
            <message type="success">${unscheduled.result?.message}</message>
            <set field="moveOperationId" from="null"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="decideOverride">
        <actions>
            <service-call name="ironstone.manufacturing.AccessServices.check#Record"
                    in-map="{appRoot:appRoot, recordType:'scheduleChange', recordId:scheduleChangeId, capability:'supervise'}"/>
            <service-call name="mantle.work.ProductionPlanningServices.schedule#ProductionOperation" out-map="decided"
                    in-map="{action:decision == 'approve' ? 'approve' : 'refuse', scheduleChangeId:scheduleChangeId,
                        reason:decisionReason, operationKey:operationKey}"/>
            <message type="success">${decided.result?.message}</message>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <widgets>
        <!-- the move given by the screen's parameters, previewed; its Apply, Request override and Cancel -->
        <section name="MovePreview" condition="moveOperationId">
            <actions>
                <service-call name="mantle.work.ProductionPlanningServices.schedule#ProductionOperation" out-map="previewed"
                        transaction="force-new" ignore-error="true"
                        in-map="{action:'preview', workEffortId:moveOperationId, facilityId:moveFacilityId || null,
                            startDate:moveStart || null, endDate:moveEnd || null}"/>
                <set field="movePreview" from="previewed?.result || null"/>
                <set field="moveFindings" from="movePreview ? movePreview.refusals.map((row) =&gt; ({kind: 'Refused', message: row.message,
                        color: 'negative'})).concat(movePreview.conflicts.map((row) =&gt; ({kind: 'Conflict', message: row.message,
                        color: 'warning'}))) : []"/>
                <set field="moveValues" from="movePreview ? {moveOperationId: moveOperationId, moveFacilityId: movePreview.facilityId,
                        moveStart: movePreview.startText, moveEnd: movePreview.endText, moveReason: moveReason,
                        expectedRevision: movePreview.expectedRevision, expectedRunRevision: movePreview.expectedRunRevision,
                        operationKey: 'move-' + moveOperationId + '-' + movePreview.expectedRevision + '-' + ec.l10n.format(ec.user.nowTimestamp, 'HHmmssSSS'),
                        moveOverride: 'N'} : {}"/>
                <set field="moveApplyText" from="movePreview?.needsOverride ? 'Apply with override' : 'Apply'"/>
                <set field="moveUnschedulable" from="!!movePreview?.fromStartText &amp;&amp; !!manufacturing.capabilities.schedule &amp;&amp;
                        !movePreview.refusals.some((row) =&gt; row.code == 'OPERATION_LOCKED')"/>
            </actions>
            <widgets>
                <container-box>
                    <box-header title="Move preview"/>
                    <box-body>
                        <label text="The move could not be previewed: the operation is not available." type="p" style="m-muted"
                                condition="!movePreview"/>
                        <section name="MovePreviewShown" condition="movePreview">
                            <widgets>
                                <label text="${movePreview.operationName} of ${movePreview.runName}: ${movePreview.fromFacilityName} ${movePreview.fromStartText} to ${movePreview.fromEndText}"
                                        type="p" style="m-muted"/>
                                <label text="Preview: ${movePreview.facilityName} ${movePreview.startText} to ${movePreview.endText}${movePreview.endComputed ? ' (end from its hours)' : ''}"
                                        type="p" style="text-weight-medium"/>
                                <form-list name="MoveFindings" list="moveFindings" skip-form="true" paginate="false">
                                    <field name="kind">
                                        <default-field title="">
                                            <render-mode>
                                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${color}">${kind}</q-chip>]]></text>
                                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: kind})}]]></text>
                                                <text type="html">${kind}</text>
                                            </render-mode>
                                        </default-field>
                                    </field>
                                    <field name="message"><default-field title="Finding"><display/></default-field></field>
                                </form-list>
                                <label text="No conflict." type="p" style="text-positive" condition="!moveFindings.length"/>
                                <form-single name="ApplyMove" transition="applyMove" map="moveValues"
                                        condition="movePreview.canApply || (movePreview.needsOverride &amp;&amp; movePreview.canOverride &amp;&amp; !!manufacturing.capabilities.schedule)">
                                    <field name="moveOperationId"><default-field><hidden/></default-field></field>
                                    <field name="moveFacilityId"><default-field><hidden/></default-field></field>
                                    <field name="moveStart"><default-field><hidden/></default-field></field>
                                    <field name="moveEnd"><default-field><hidden/></default-field></field>
                                    <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                    <field name="expectedRunRevision"><default-field><hidden/></default-field></field>
                                    <field name="operationKey"><default-field><hidden/></default-field></field>
                                    <field name="moveOverride">
                                        <conditional-field condition="movePreview.needsOverride" title="Override the conflicts">
                                            <drop-down><option key="N" text="No"/><option key="Y" text="Yes, a supervisor exception"/></drop-down>
                                        </conditional-field>
                                        <default-field><hidden/></default-field>
                                    </field>
                                    <field name="moveReason">
                                        <default-field title="Reason"><text-line/></default-field>
                                    </field>
                                    <field name="submit"><default-field title=""><submit text="${moveApplyText}"/></default-field></field>
                                </form-single>
                                <form-single name="RequestOverride" transition="requestOverride" map="moveValues"
                                        condition="movePreview.canRequestOverride">
                                    <field name="moveOperationId"><default-field><hidden/></default-field></field>
                                    <field name="moveFacilityId"><default-field><hidden/></default-field></field>
                                    <field name="moveStart"><default-field><hidden/></default-field></field>
                                    <field name="moveEnd"><default-field><hidden/></default-field></field>
                                    <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                    <field name="expectedRunRevision"><default-field><hidden/></default-field></field>
                                    <field name="operationKey"><default-field><hidden/></default-field></field>
                                    <field name="moveReason">
                                        <default-field title="Reason for the override"><text-line required="true"/></default-field>
                                    </field>
                                    <field name="submit"><default-field title=""><submit text="Request override"/></default-field></field>
                                </form-single>
                                <form-single name="UnscheduleOperation" transition="unscheduleOperation" map="moveValues"
                                        condition="moveUnschedulable">
                                    <field name="moveOperationId"><default-field><hidden/></default-field></field>
                                    <field name="expectedRevision"><default-field><hidden/></default-field></field>
                                    <field name="expectedRunRevision"><default-field><hidden/></default-field></field>
                                    <field name="operationKey"><default-field><hidden/></default-field></field>
                                    <field name="submit">
                                        <default-field title="">
                                            <submit text="Unschedule" btn-type="danger" confirmation="Take ${movePreview.operationName} off the schedule?"/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </widgets>
                        </section>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
