<!-- Sales' contexts of the shared ShipmentDetail and InvoiceDetail (design-sales §6 ShipmentDetail and InvoiceDetail; crosscut §3.8 and
    §3.16 Sales rows; impl-sales P14), each included by its shared screen when appRoot is Sales:
    - SalesShipment: a shipment of a sales order the user sees in Sales (mantle.order.SalesOrderServices.get#SalesShipment), read
      only: the header with its state, customer, destination and dates, the items and sources of those orders, packages and
      tracking; pick, pack and ship are Warehouse's and absent here; shipment notices stay Warehouse's;
    - SalesInvoice: an invoice of a sales order the user sees, for a receivable reader (check#SalesInvoice, then Accounting's
      get#InvoiceFinanceDetail), read only: the overview, the lines and the payments; Send with the PASS Billing pay link
      (Accounting's send#Invoice, which issues the link on the organization's published Billing site) for a receivables editor
      (the invoice's canSend). No finalize, credit or payment action: those stay Accounting's. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd">
    <transition name="salesInvoiceSend">
        <actions>
            <service-call name="ironstone.sales.ContextServices.check#Record" in-map="{appRoot:appRoot, recordType:'invoice', recordId:invoiceId}"/>
            <service-call name="mantle.account.InvoiceServices.send#Invoice" out-map="sent"
                    in-map="{invoiceId:invoiceId, operationKey:operationKey, toAddresses:(toAddresses || null), note:(note || null)}"/>
            <script>if (!ec.message.hasError()) ec.message.addMessage('Invoice ' + invoiceId + ' went to '
                    + (sent.successCount || 0) + ' of ' + Array.from(sent.recipientResults || []).length + ' recipients',
                    sent.failureCount ? 'warning' : 'success')</script>
        </actions>
        <default-response url="."><parameter name="invoiceId"/></default-response>
        <error-response url="."/>
    </transition>
    <widgets>
        <section name="SalesShipment" condition="appRoot == 'Sales'">
            <widgets>
                <section name="SalesShipmentMissing" condition="!salesShipment">
                    <widgets>
                        <container-box type="warning">
                            <box-header title="Shipment not available"/>
                            <box-body>
                                <label type="p" text="Shipment ${shipmentId} is not available: it does not exist, or it carries no order you see in Sales."/>
                                <link url="${sharedLinks['Orders/Orders']}" text="Back to orders" link-type="anchor"/>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
                <section name="SalesShipmentFound" condition="salesShipment">
                    <actions>
                        <set field="ssh" from="salesShipment.shipment"/>
                        <set field="ssOrders" from="salesShipment.orderIds.map(orderId =&gt; ({orderId}))"/>
                        <set field="ssOrderPath" from="sharedLinks['Orders/OrderDetail'] || null"/>
                    </actions>
                    <widgets>
                        <context record-entity="mantle.shipment.Shipment" record-id="${shipmentId}" title="Shipment ${shipmentId} · ${ssh.customerName}"/>
                        <container style="m-record-header">
                            <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                                <container style="col-12 col-md m-record-title">
                                    <label text="${ec.l10n.localize('Shipment')} ${shipmentId}" type="h5"/>
                                    <label text="${[ssh.customerName, ssh.destinationText, ssh.estimatedShipText ? 'ships ' + ssh.estimatedShipText : '',
                                            ssh.estimatedArrivalText ? 'arrives ' + ssh.estimatedArrivalText : ''].filter(Boolean).join(' · ')}"
                                            type="p" style="text-caption m-muted"/>
                                </container>
                                <container style="col-12 col-md-auto m-record-status">
                                    <label text="${ssh.statusText}" type="span" style="text-weight-medium"/>
                                </container>
                            </container>
                            <container style="row items-center q-gutter-xs m-record-actions">
                                <section-iterate name="SalesShipmentOrders" list="ssOrders" entry="ssOrder">
                                    <widgets>
                                        <link url="${ssOrderPath}" url-type="plain" text="${ec.l10n.localize('Order')} ${ssOrder.orderId}"
                                                link-type="anchor-button" parameter-map="{orderId:ssOrder.orderId}" condition="ssOrderPath"/>
                                    </widgets>
                                </section-iterate>
                            </container>
                        </container>
                        <label type="p" style="text-caption m-muted" condition="ssh.otherOrdersHidden"
                                text="This shipment also carries lines of orders you do not see in Sales; they are left out."/>
                        <container-box>
                            <box-header title="Items and sources"/>
                            <box-body-nopad>
                                <form-list name="SalesShipmentItems" list="salesShipment.itemRows" skip-form="true" paginate="false">
                                    <field name="orderId"><default-field title="Order"><display text="${orderId} · ${orderItemSeqId}"/></default-field></field>
                                    <field name="productText"><default-field title="Product"><display/></default-field></field>
                                    <field name="orderedText" align="right"><default-field title="Ordered"><display/></default-field></field>
                                    <field name="quantityText" align="right"><default-field title="On shipment"><display/></default-field></field>
                                    <field name="pickedText" align="right"><default-field title="Picked"><display/></default-field></field>
                                    <field name="packedText" align="right"><default-field title="Packed"><display/></default-field></field>
                                    <field name="statusText"><default-field title="State"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="productText"/><field-ref name="orderId"/></column>
                                        <column><field-ref name="quantityText"/><field-ref name="statusText"/></column>
                                    </columns>
                                </form-list>
                            </box-body-nopad>
                        </container-box>
                        <container-row>
                            <row-col md="6">
                                <container-box>
                                    <box-header title="Packages"/>
                                    <box-body-nopad>
                                        <form-list name="SalesShipmentPackages" list="salesShipment.packageRows" skip-form="true" paginate="false">
                                            <field name="packageSeqId"><default-field title="Package"><display/></default-field></field>
                                            <field name="contentsText"><default-field title="Contents"><display/></default-field></field>
                                            <field name="weightText"><default-field title="Weight"><display/></default-field></field>
                                        </form-list>
                                        <label type="p" style="m-muted q-pa-sm q-mb-none" text="Not packed yet."
                                                condition="!salesShipment.packageRows.length"/>
                                    </box-body-nopad>
                                </container-box>
                            </row-col>
                            <row-col md="6">
                                <container-box>
                                    <box-header title="Tracking"/>
                                    <box-body-nopad>
                                        <form-list name="SalesShipmentTracking" list="salesShipment.trackingRows" skip-form="true" paginate="false">
                                            <field name="carrierName"><default-field title="Carrier"><display/></default-field></field>
                                            <field name="methodText"><default-field title="Method"><display/></default-field></field>
                                            <field name="trackingText">
                                                <default-field title="Tracking">
                                                    <link url="${trackingUrl}" url-type="plain" text="${trackingText}" link-type="anchor"
                                                            target-window="_blank" condition="trackingUrl"/>
                                                    <label text="${trackingText}" type="span" condition="!trackingUrl"/>
                                                </default-field>
                                            </field>
                                            <field name="stateText"><default-field title="State"><display/></default-field></field>
                                        </form-list>
                                        <label type="p" style="m-muted q-pa-sm q-mb-none" text="No tracking yet."
                                                condition="!salesShipment.trackingRows.length"/>
                                    </box-body-nopad>
                                </container-box>
                            </row-col>
                        </container-row>
                    </widgets>
                </section>
            </widgets>
        </section>

        <section name="SalesInvoice" condition="appRoot == 'Sales'">
            <widgets>
                <section name="SalesInvoiceMissing" condition="!salesInvoice">
                    <widgets>
                        <container-box type="warning">
                            <box-header title="Invoice not available"/>
                            <box-body>
                                <label type="p" text="Invoice ${invoiceId} is not available: it does not exist, it bills no order you see in
                                        Sales, or you do not read receivables."/>
                                <link url="${sharedLinks['Orders/Orders']}" text="Back to orders" link-type="anchor"/>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
                <section name="SalesInvoiceFound" condition="salesInvoice">
                    <actions>
                        <set field="si" from="salesInvoice.invoice"/>
                        <set field="siTotals" from="salesInvoice.totals || {}"/>
                        <set field="siCurrency" from="si.currencyUomId"/>
                        <set field="siTotalText" from="siTotals.invoiceTotal == null ? '' : ec.l10n.formatCurrency(siTotals.invoiceTotal, siCurrency)"/>
                        <set field="siUnpaidText" from="siTotals.unpaidTotal == null ? '' : ec.l10n.formatCurrency(siTotals.unpaidTotal, siCurrency)"/>
                        <set field="siLines" from="Array.from(salesInvoice.lines || []).map(line =&gt; ({description: line.description || line.itemTypeDescription,
                                quantityText: ec.l10n.format(line.quantity ?? 1, '#,##0.###'), amountText: ec.l10n.formatCurrency(line.amount ?? 0, siCurrency),
                                totalText: ec.l10n.formatCurrency(line.lineTotal ?? 0, siCurrency)}))"/>
                        <set field="siPayments" from="Array.from(salesInvoice.paymentRows || []).map(row =&gt; ({paymentId: row.paymentId || row.toPaymentId || '',
                                amountText: ec.l10n.formatCurrency(row.amountApplied ?? 0, siCurrency)}))"/>
                        <set field="siSendValue" from="{invoiceId: invoiceId, toAddresses: salesInvoice.sendTo || '', note: '',
                                operationKey: 'invoice-send-' + ec.user.randomString(24)}"/>
                    </actions>
                    <widgets>
                        <context record-entity="mantle.account.invoice.Invoice" record-id="${invoiceId}" title="Invoice ${invoiceId} · ${si.toName}"/>
                        <container style="m-record-header">
                            <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                                <container style="col-12 col-md m-record-title">
                                    <label text="${ec.l10n.localize('Invoice')} ${invoiceId}" type="h5"/>
                                    <label text="${[si.toName, si.fromName, siTotalText, siUnpaidText ? 'unpaid ' + siUnpaidText : ''].filter(Boolean).join(' · ')}"
                                            type="p" style="text-caption m-muted"/>
                                </container>
                                <container style="col-12 col-md-auto m-record-status">
                                    <label text="${si.statusDescription}" type="span" style="text-weight-medium"/>
                                </container>
                            </container>
                            <container style="row items-center q-gutter-xs m-record-actions">
                                <container-dialog id="SalesInvoiceSend" button-text="Send with pay link" icon="sym_o_forward_to_inbox" type="primary"
                                        title="Send invoice ${invoiceId}" width="560" condition="salesInvoice.capabilities?.canSend">
                                    <form-single name="SalesInvoiceSendForm" transition="salesInvoiceSend" map="siSendValue">
                                        <field name="invoiceId"><default-field><hidden/></default-field></field>
                                        <field name="operationKey"><default-field><hidden/></default-field></field>
                                        <field name="toAddresses"><default-field title="To"><text-line size="50"/></default-field></field>
                                        <field name="note"><default-field title="Message"><text-area rows="3" cols="50"/></default-field></field>
                                        <field name="submitButton">
                                            <default-field title="Send"><submit confirmation="Send invoice ${invoiceId} with its pay link?"/></default-field>
                                        </field>
                                    </form-single>
                                    <label type="p" style="text-caption m-muted" text="The email carries the pay link of your organization's Billing site when it has one."/>
                                </container-dialog>
                            </container>
                        </container>
                        <container-row>
                            <row-col md="7">
                                <container-box>
                                    <box-header title="Items"/>
                                    <box-body-nopad>
                                        <form-list name="SalesInvoiceLines" list="siLines" skip-form="true" paginate="false">
                                            <field name="description"><default-field title="Item"><display/></default-field></field>
                                            <field name="quantityText" align="right"><default-field title="Quantity"><display/></default-field></field>
                                            <field name="amountText" align="right"><default-field title="Price"><display/></default-field></field>
                                            <field name="totalText" align="right"><default-field title="Total"><display/></default-field></field>
                                            <columns type="mobile">
                                                <column><field-ref name="description"/></column>
                                                <column><field-ref name="totalText"/></column>
                                            </columns>
                                        </form-list>
                                    </box-body-nopad>
                                </container-box>
                            </row-col>
                            <row-col md="5">
                                <container-box>
                                    <box-header title="Payments and settlement"/>
                                    <box-body-nopad>
                                        <form-list name="SalesInvoicePayments" list="siPayments" skip-form="true" paginate="false">
                                            <field name="paymentId"><default-field title="Payment"><display/></default-field></field>
                                            <field name="amountText" align="right"><default-field title="Applied"><display/></default-field></field>
                                        </form-list>
                                        <label type="p" style="m-muted q-pa-sm q-mb-none" text="No payment applied yet." condition="!siPayments.length"/>
                                    </box-body-nopad>
                                </container-box>
                            </row-col>
                        </container-row>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
