<!-- ShipmentDetail's Customer Service branch (crosscut §3.8 Customer Service row; design-customer-service §4 ShipmentDetail;
    impl-customer-service P3): the section Shared/ShipmentDetail includes when appRoot is CustomerService, over
    ironstone.customerservice.OrderServices.get#ShipmentDetail: a shipment to, or a return from, a customer the user serves,
    of their organization ("not available" otherwise, a missing one alike). Its items, tracking with the carrier's link to
    copy, packages, the orders and returns it carries, the linked cases, and a delivery update to copy into the case's reply
    (the reply is sent from CaseDetail, on the case's conversation). No pick, pack, ship or receive here: a return's receipt
    is ReturnDetail's (P9). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <widgets>
        <section name="CustomerServiceShipment" condition="appRoot == 'CustomerService'">
            <widgets>
                <section name="ServiceShipmentMissing" condition="!serviceShipment">
                    <widgets>
                        <container-box type="warning">
                            <box-header title="Shipment not available"/>
                            <box-body>
                                <label type="p" text="Shipment ${shipmentId} is not available: it does not exist, or it is not a
                                        shipment of a customer you serve."/>
                                <link url="${sharedLinks['Orders/Orders']}" text="Back to orders" link-type="anchor"/>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
                <section name="ServiceShipmentFound" condition="serviceShipment">
                    <actions>
                        <set field="sh" from="serviceShipment.shipment"/>
                        <set field="updateValue" from="{updateText:serviceShipment.updateText}"/>
                    </actions>
                    <widgets>
                        <context record-entity="mantle.shipment.Shipment" record-id="${shipmentId}"
                                title="Shipment ${shipmentId} · ${sh.customerName}"/>
                        <container style="m-record-header">
                            <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                                <container style="col-12 col-md m-record-title">
                                    <container style="row items-center q-gutter-x-sm">
                                        <label text="Shipment ${shipmentId}" type="h5"/>
                                        <link url="${sh.customerUrl}" url-type="plain" text="${sh.customerName}" link-type="anchor"
                                                condition="sh.customerUrl"/>
                                    </container>
                                    <label text="${[sh.kindText, sh.arrivalText ? 'expected ' + sh.arrivalText : '',
                                            sh.trackingText ? 'tracking ' + sh.trackingText : ''].filter(Boolean).join(' · ')}"
                                            type="p" style="text-caption m-muted"/>
                                </container>
                                <container style="col-12 col-md-auto m-record-status">
                                    <label text="${sh.statusText}" type="span" style="text-weight-medium"/>
                                </container>
                            </container>
                            <container style="row items-center q-gutter-xs m-record-actions">
                                <link url="${sh.trackingUrl}" url-type="plain" text="Tracking link" icon="sym_o_open_in_new"
                                        link-type="anchor-button" target-window="_blank" condition="sh.trackingUrl"/>
                            </container>
                        </container>
                        <container-row>
                            <row-col md="6">
                                <container-box>
                                    <box-header title="Items"/>
                                    <box-body-nopad>
                                        <form-list name="ServiceShipmentItems" list="serviceShipment.itemRows" skip-form="true"
                                                paginate="false">
                                            <field name="productName"><default-field title="Product"><display/></default-field></field>
                                            <field name="quantityText" align="right"><default-field title="Quantity"><display/></default-field></field>
                                            <columns type="mobile">
                                                <column><field-ref name="productName"/></column>
                                                <column><field-ref name="quantityText"/></column>
                                            </columns>
                                        </form-list>
                                    </box-body-nopad>
                                </container-box>
                                <container-box>
                                    <box-header title="Tracking"/>
                                    <box-body-nopad>
                                        <form-list name="ServiceShipmentTracking" list="serviceShipment.trackingRows" skip-form="true"
                                                paginate="false">
                                            <field name="carrierName"><default-field title="Carrier"><display/></default-field></field>
                                            <field name="methodText"><default-field title="Method"><display/></default-field></field>
                                            <field name="trackingText">
                                                <default-field title="Tracking">
                                                    <link url="${trackingUrl}" url-type="plain" text="${trackingText}" link-type="anchor"
                                                            target-window="_blank" condition="trackingUrl"/>
                                                    <label text="${trackingText}" type="span" condition="!trackingUrl"/>
                                                </default-field>
                                            </field>
                                            <field name="arrivalText"><default-field title="Arrival"><display/></default-field></field>
                                            <columns type="mobile">
                                                <column><field-ref name="carrierName"/><field-ref name="trackingText"/></column>
                                                <column><field-ref name="arrivalText"/></column>
                                            </columns>
                                        </form-list>
                                        <label type="p" style="m-muted q-pa-sm q-mb-none" text="No tracking yet."
                                                condition="!serviceShipment.trackingRows.length"/>
                                    </box-body-nopad>
                                </container-box>
                            </row-col>
                            <row-col md="6">
                                <container-box>
                                    <box-header title="Orders, returns and cases"/>
                                    <box-body>
                                        <section-iterate name="ServiceShipmentOrders" list="serviceShipment.orderRows" entry="orderRow">
                                            <widgets>
                                                <link url="${orderRow.url}" url-type="plain" text="Order ${orderRow.orderId}"
                                                        link-type="anchor" condition="orderRow.url"/>
                                            </widgets>
                                        </section-iterate>
                                        <section-iterate name="ServiceShipmentReturns" list="serviceShipment.returnRows" entry="returnRow">
                                            <widgets>
                                                <label text="Return ${returnRow.returnId} · ${returnRow.statusText}" type="div"/>
                                            </widgets>
                                        </section-iterate>
                                        <section-iterate name="ServiceShipmentCases" list="serviceShipment.caseRows" entry="caseRow">
                                            <widgets>
                                                <link url="${caseRow.url}" url-type="plain"
                                                        text="Case ${caseRow.requestId} · ${caseRow.requestName}" link-type="anchor"/>
                                            </widgets>
                                        </section-iterate>
                                    </box-body>
                                </container-box>
                                <container-box>
                                    <box-header title="Delivery update"/>
                                    <box-body>
                                        <form-single name="ServiceShipmentUpdate" map="updateValue" transition=".">
                                            <field name="updateText">
                                                <default-field title="To copy into the case's reply"><display/></default-field>
                                            </field>
                                        </form-single>
                                    </box-body>
                                </container-box>
                            </row-col>
                        </container-row>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
